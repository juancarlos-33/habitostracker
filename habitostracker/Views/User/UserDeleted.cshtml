@{
    ViewData["Title"] = "Usuario no disponible";
    Layout = "_Layout";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.deleted-page {
    max-width: 520px; margin: 60px auto; padding: 20px;
    font-family: 'Plus Jakarta Sans', sans-serif;
}

.deleted-card {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-radius: 32px; padding: 52px 40px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 40px 80px rgba(0,0,0,0.4);
    text-align: center; position: relative; overflow: hidden;
}

.deleted-card::before {
    content:''; position:absolute; top:-60px; right:-60px;
    width:220px; height:220px;
    background: radial-gradient(circle, rgba(99,102,241,0.15), transparent 70%);
    border-radius:50%;
}
.deleted-card::after {
    content:''; position:absolute; bottom:-40px; left:-40px;
    width:180px; height:180px;
    background: radial-gradient(circle, rgba(239,68,68,0.1), transparent 70%);
    border-radius:50%;
}

.deleted-ghost {
    font-size: 80px;
    display: block;
    margin-bottom: 8px;
    animation: float 3s ease-in-out infinite;
    position: relative; z-index:1;
}

@@keyframes float {
    0%,100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-14px) rotate(3deg); }
}

.deleted-particles {
    position: absolute; inset: 0; pointer-events: none; overflow: hidden;
}
.deleted-particle {
    position: absolute; width: 4px; height: 4px; border-radius: 50%;
    background: rgba(99,102,241,0.4);
    animation: particleFloat linear infinite;
}

@@keyframes particleFloat {
    0% { transform: translateY(100%) scale(0); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(-100vh) scale(1.5); opacity: 0; }
}

.deleted-title {
    color: white; font-size: 24px; font-weight: 800;
    margin: 0 0 12px; position: relative; z-index:1;
    line-height: 1.3;
}

.deleted-sub {
    color: rgba(255,255,255,0.4); font-size: 14px;
    line-height: 1.8; margin: 0 0 32px; position: relative; z-index:1;
}

.deleted-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
    margin: 0 0 28px; position: relative; z-index:1;
}

.deleted-stats {
    display: flex; gap: 0; margin-bottom: 32px;
    background: rgba(255,255,255,0.04); border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.06); overflow: hidden;
    position: relative; z-index:1;
}
.deleted-stat { flex: 1; padding: 16px 12px; text-align: center; position: relative; }
.deleted-stat:not(:last-child)::after {
    content:''; position:absolute; right:0; top:20%; height:60%;
    width:1px; background: rgba(255,255,255,0.08);
}
.deleted-stat-icon { font-size: 22px; margin-bottom: 6px; display: block; }
.deleted-stat-label { font-size: 11px; color: rgba(255,255,255,0.3); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }

.deleted-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    color: white; text-decoration: none;
    padding: 14px 32px; border-radius: 16px;
    font-weight: 700; font-size: 14px;
    box-shadow: 0 8px 24px rgba(99,102,241,0.4);
    transition: 0.2s; position: relative; z-index:1;
    border: none; cursor: pointer; font-family: inherit;
}
.deleted-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(99,102,241,0.55); color: white; }

.deleted-btn-sec {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.5); text-decoration: none;
    padding: 14px 24px; border-radius: 16px;
    font-weight: 700; font-size: 14px;
    border: 1px solid rgba(255,255,255,0.08);
    transition: 0.2s; position: relative; z-index:1;
}
.deleted-btn-sec:hover { background: rgba(255,255,255,0.1); color: white; }

.deleted-btns { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

.deleted-quote {
    background: rgba(99,102,241,0.08);
    border-left: 3px solid #6366f1;
    border-radius: 0 14px 14px 0;
    padding: 14px 18px; margin-bottom: 28px;
    text-align: left; position: relative; z-index:1;
}
.deleted-quote p {
    color: #818cf8; font-size: 13px; font-style: italic;
    margin: 0; line-height: 1.7;
}

@@media (max-width: 500px) {
    .deleted-card { padding: 36px 24px; }
    .deleted-title { font-size: 20px; }
    .deleted-ghost { font-size: 64px; }
}
</style>

<div class="deleted-page">
    <div class="deleted-card" id="deletedCard">

        <!-- Partículas flotantes -->
        <div class="deleted-particles" id="particles"></div>

        <span class="deleted-ghost" id="ghostEmoji">👻</span>

        <h2 class="deleted-title">Esta persona ya no<br>forma parte de nosotros</h2>

        <p class="deleted-sub">
            El usuario que buscas ha eliminado su cuenta<br>
            o ya no está disponible en HabitTracker.
        </p>

        <div class="deleted-stats">
            <div class="deleted-stat">
                <span class="deleted-stat-icon">🌫️</span>
                <span class="deleted-stat-label">Partió</span>
            </div>
            <div class="deleted-stat">
                <span class="deleted-stat-icon">💨</span>
                <span class="deleted-stat-label">Se fue</span>
            </div>
            <div class="deleted-stat">
                <span class="deleted-stat-icon">✨</span>
                <span class="deleted-stat-label">Al más allá</span>
            </div>
        </div>

        <div class="deleted-quote">
            <p>"Cada persona que pasa por nuestra vida deja una huella. Aunque ya no estén, su paso importó." 💙</p>
        </div>

        <div class="deleted-divider"></div>

        <div class="deleted-btns">
            <a href="/Habit/Index" class="deleted-btn">🏠 Volver al inicio</a>
            <a href="/Habit/Community" class="deleted-btn-sec">🌍 Comunidad</a>
        </div>

    </div>
</div>

<script>
// ── PARTÍCULAS ──
const container = document.getElementById('particles');
const colors = ['rgba(99,102,241,0.5)', 'rgba(139,92,246,0.4)', 'rgba(59,130,246,0.4)', 'rgba(255,255,255,0.15)'];

for (let i = 0; i < 18; i++) {
    const p = document.createElement('div');
    p.className = 'deleted-particle';
    p.style.left = Math.random() * 100 + '%';
    p.style.width = (Math.random() * 4 + 2) + 'px';
    p.style.height = p.style.width;
    p.style.background = colors[Math.floor(Math.random() * colors.length)];
    p.style.animationDuration = (Math.random() * 8 + 6) + 's';
    p.style.animationDelay = (Math.random() * 6) + 's';
    container.appendChild(p);
}

// ── GHOST EMOJI ALEATORIO ──
const ghosts = ['👻', '💨', '🌫️', '✨', '🌙'];
let gi = 0;
setInterval(() => {
    gi = (gi + 1) % ghosts.length;
    const ghost = document.getElementById('ghostEmoji');
    ghost.style.opacity = '0';
    setTimeout(() => {
        ghost.textContent = ghosts[gi];
        ghost.style.opacity = '1';
        ghost.style.transition = 'opacity 0.4s';
    }, 300);
}, 3000);
</script>