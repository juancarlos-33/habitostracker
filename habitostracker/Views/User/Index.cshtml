@model List<HabitTrackerApp.Models.User>
@{
    ViewData["Title"] = "Usuarios";
    var myId = int.Parse(User.FindFirst("UserId").Value);
    var sentList = ViewBag.SentRequests as List<int> ?? new List<int>();
    var friendList = ViewBag.Friends as List<int> ?? new List<int>();
}

<div class="discover-page">

    <div class="discover-header">
        <h2 class="discover-title">🔎 Descubrir amigos</h2>
        <p class="discover-subtitle">Conecta con personas que comparten tus hábitos</p>
    </div>

    <div class="search-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" id="userSearch" placeholder="Buscar usuarios..." class="search-input" />
    </div>

    <div class="user-grid" id="userGrid">
        @foreach (var user in Model)
        {
            if (user.Id == myId) continue;

            <div class="user-card" id="user-@user.Id" data-username="@user.Username.ToLower()">

                <div class="card-top">
                    <div class="avatar-wrap">
                        @if (!string.IsNullOrEmpty(user.ProfileImage))
                        {
                            <img src="@user.ProfileImage" class="user-avatar-img" id="avatar-@user.Id" />
                        }
                        else
                        {
                            <div class="avatar-placeholder" id="avatar-@user.Id">
                                @user.Username.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <span class="status-dot offline" id="status-@user.Id"></span>
                    </div>

                    <div class="user-info">
                        <div class="user-name">@user.Username</div>
                        @if (user.Role == "Admin")
                        {
                            <span class="role-badge admin">Administrador</span>
                        }
                        @if (user.Role == "SuperAdmin")
                        {
                            <span class="role-badge owner">👑 Propietario</span>
                        }
                        <div class="active-label" id="active-@user.Id" style="display:none;">
                            <span class="active-dot"></span> Activo ahora
                        </div>
                    </div>
                </div>

                <div class="card-actions">
                    <a href="/User/Profile/@user.Id" class="card-btn view guest-block">👁 Ver perfil</a>

                    @if (friendList.Contains(user.Id))
                    {
                        <button class="card-btn friends" disabled>✅ Amigos</button>
                    }
                    else if (sentList.Contains(user.Id))
                    {
                        <button class="card-btn sent" disabled>✔ Enviada</button>
                    }
                    else
                    {
                        <button class="card-btn add guest-block"
                                data-user="@user.Id"
                                data-no-loader="true"
                                onclick="sendFriendRequest(this)">
                            + Agregar
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
.discover-page { max-width: 1100px; margin: 0 auto; }
.discover-header { margin-bottom: 24px; }
.discover-title { font-size: 24px; font-weight: 800; color: #111827; margin: 0 0 4px; }
.discover-subtitle { font-size: 14px; color: #9ca3af; margin: 0; }

.search-wrap { position: relative; margin-bottom: 28px; max-width: 420px; }
.search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 16px; }
.search-input {
    width: 100%; padding: 12px 16px 12px 42px;
    border: 1px solid #e5e7eb; border-radius: 50px;
    font-size: 14px; background: white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    outline: none; transition: 0.2s; box-sizing: border-box;
}
.search-input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }

.user-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }

.user-card {
    background: white; border-radius: 18px; padding: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04); transition: 0.2s;
}
.user-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }

.card-top { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
.avatar-wrap { position: relative; flex-shrink: 0; }

.user-avatar-img {
    width: 56px; height: 56px; border-radius: 50%;
    object-fit: cover; border: 3px solid #e5e7eb;
}

.avatar-placeholder {
    width: 56px; height: 56px; border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white; display: flex; align-items: center;
    justify-content: center; font-size: 22px; font-weight: 800;
    border: 3px solid #e5e7eb;
}

.status-dot {
    position: absolute; bottom: 2px; right: 2px;
    width: 12px; height: 12px; border-radius: 50%; border: 2px solid white;
}
.status-dot.online { background: #22c55e; }
.status-dot.offline { background: #d1d5db; }

.user-info { flex: 1; min-width: 0; }
.user-name { font-size: 15px; font-weight: 700; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.role-badge { display: inline-block; font-size: 10px; padding: 2px 8px; border-radius: 20px; margin-top: 4px; font-weight: 600; }
.role-badge.admin { background: #fef3c7; color: #d97706; }
.role-badge.owner { background: #111827; color: white; }

.active-label { display: flex; align-items: center; gap: 5px; font-size: 12px; color: #22c55e; font-weight: 600; margin-top: 4px; }
.active-dot { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; animation: pulse 1.5s infinite; }

@@keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.7); }
    70% { box-shadow: 0 0 0 6px rgba(34,197,94,0); }
    100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}

.card-actions { display: flex; gap: 8px; }

.card-btn {
    flex: 1; padding: 9px 12px; border-radius: 10px;
    font-size: 13px; font-weight: 600; cursor: pointer; border: none;
    text-decoration: none; text-align: center; transition: 0.2s;
    display: inline-flex; align-items: center; justify-content: center;
}
.card-btn.view { background: #2563eb; color: white; }
.card-btn.view:hover { background: #1d4ed8; color: white; }
.card-btn.add { background: #f0fdf4; color: #16a34a; border: 1px solid #86efac; }
.card-btn.add:hover { background: #22c55e; color: white; }
.card-btn.friends { background: #f0fdf4; color: #16a34a; }
.card-btn.sent { background: #fef3c7; color: #d97706; }
.online-avatar { border-color: #22c55e !important; }

/* DARK MODE */
body.bg-dark .discover-title { color: #f1f5f9 !important; }
body.bg-dark .search-input { background: #1e1e2e !important; border-color: #2d2d3d !important; color: #f1f5f9 !important; }
body.bg-dark .user-card { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .user-name { color: #f1f5f9 !important; }
body.bg-dark .status-dot { border-color: #1e1e2e !important; }
body.bg-dark .card-btn.view { background: #2563eb !important; color: white !important; }
body.bg-dark .card-btn.add { background: #14532d !important; color: #86efac !important; border-color: #166534 !important; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const connectionGlobal = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub").build();

connectionGlobal.start().then(function () {
    const myId = '@User.FindFirst("UserId")?.Value';
    connectionGlobal.invoke("JoinUserGroup", myId);
}).catch(err => console.error(err));

connectionGlobal.on("UserOnline", function(userId) {
    const dot = document.getElementById("status-" + userId);
    if (dot) { dot.classList.remove("offline"); dot.classList.add("online"); }
    const avatar = document.getElementById("avatar-" + userId);
    if (avatar) avatar.classList.add("online-avatar");
    const activeLabel = document.getElementById("active-" + userId);
    if (activeLabel) activeLabel.style.display = "flex";
    const card = document.getElementById("user-" + userId);
    if (card) document.getElementById("userGrid").prepend(card);
});

connectionGlobal.on("UserOffline", function(userId) {
    const dot = document.getElementById("status-" + userId);
    if (dot) { dot.classList.remove("online"); dot.classList.add("offline"); }
    const avatar = document.getElementById("avatar-" + userId);
    if (avatar) avatar.classList.remove("online-avatar");
    const activeLabel = document.getElementById("active-" + userId);
    if (activeLabel) activeLabel.style.display = "none";
});

fetch("/User/GetOnlineUsers")
    .then(r => r.json())
    .then(users => {
        users.forEach(id => {
            const dot = document.getElementById("status-" + id);
            if (dot) { dot.classList.remove("offline"); dot.classList.add("online"); }
            const activeLabel = document.getElementById("active-" + id);
            if (activeLabel) activeLabel.style.display = "flex";
        });
    });

document.getElementById("userSearch").addEventListener("keyup", function() {
    const value = this.value.toLowerCase();
    document.querySelectorAll(".user-card").forEach(card => {
        card.style.display = card.dataset.username.includes(value) ? "block" : "none";
    });
});

function sendFriendRequest(btn) {
    if (typeof isGuest !== "undefined" && isGuest) {
        new bootstrap.Modal(document.getElementById('guestModal')).show();
        return;
    }
    const userId = btn.dataset.user;
    btn.innerHTML = "⏳";
    btn.disabled = true;
    fetch("/User/SendFriendRequest", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: "receiverId=" + userId
    }).then(() => {
        btn.innerHTML = "✔";
        btn.classList.remove("add");
        btn.classList.add("sent");
    }).catch(() => {
        btn.innerHTML = "❌";
        btn.disabled = false;
    });
}
</script>