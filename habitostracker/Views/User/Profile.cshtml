.msg-req-cancel { flex:1; padding:12px; border-radius:13px; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.04); color:rgba(255,255,255,0.4); font-size:13px; font-weight:700; cursor:pointer; font-family:inherit; transition:0.2s; }
.msg-req-cancel:hover { background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.7); }
.msg-req-send { flex:1; padding:12px; border-radius:13px; border:none; background:linear-gradient(135deg,#6366f1,#2563eb); color:white; font-size:13px; font-weight:700; cursor:pointer; font-family:inherit; transition:0.2s; box-shadow:0 4px 14px rgba(99,102,241,0.4); }
.msg-req-send:hover { transform:translateY(-1px); }
.msg-req-send:disabled { background:#334155; box-shadow:none; cursor:not-allowed; transform:none; }
.prof-toast { position:fixed; bottom:90px; left:50%; transform:translateX(-50%); background:rgba(15,23,42,0.97); color:white; padding:12px 24px; border-radius:24px; font-size:13px; font-weight:600; z-index:99999; box-shadow:0 8px 32px rgba(0,0,0,0.5); backdrop-filter:blur(12px); border:1px solid rgba(255,255,255,0.08); animation:toastIn 0.3s ease; white-space:nowrap; }
@@keyframes toastIn { from{opacity:0;transform:translateX(-50%) translateY(10px);} to{opacity:1;transform:translateX(-50%) translateY(0);} }
@@media(max-width:768px){
    .prof-username { font-size:19px; }
    .prof-stats-row { width:100%; border-radius:14px; }
    .prof-tab { font-size:12px; padding:12px 8px; }
    .prof-tabs { top:60px; border-radius:14px; }
    .prof-habit-strip { gap:6px; }
    .prof-habit-chip { font-size:11px; padding:6px 10px; }
}
</style>

<!-- MODAL MENSAJE -->
<div class="msg-req-modal" id="msgReqModal">
    <div class="msg-req-card">
        <div style="text-align:center;margin-bottom:16px;font-size:36px;">💬</div>
        <div class="msg-req-title">Enviar mensaje</div>
        <div class="msg-req-sub">
            Escribe a <strong style="color:#818cf8;">@Model.Username</strong>.<br>
            Cuando lo acepte podrán chatear libremente.
        </div>
        <textarea class="msg-req-input" id="msgReqText" rows="3"
                  placeholder="Hola, me gustaría conectar contigo..."
                  maxlength="200" oninput="updateReqChars()"></textarea>
        <div class="msg-req-chars"><span id="reqCharsCount">0</span>/200</div>
        <div class="msg-req-btns">
            <button class="msg-req-cancel" onclick="closeMsgReqModal()">Cancelar</button>
            <button class="msg-req-send" id="msgReqSendBtn" onclick="sendMsgReq()" disabled>Enviar →</button>
        </div>
    </div>
</div>

<div class="prof-wrap">

    <!-- COVER -->
    <div class="prof-cover">
        @if (!string.IsNullOrEmpty(Model.CoverImage))
        { <img src="@Model.CoverImage" alt="portada" /> }
        else
        { <div class="prof-cover-dots"></div> }
        <div class="prof-cover-overlay"></div>
    </div>

    <!-- PROFILE CARD -->
    <div class="prof-card">
        <div class="prof-avatar-zone">
            <div class="prof-avatar-wrap">
                @if (!string.IsNullOrEmpty(profilePic))
                {
                    <img src="@profilePic" class="prof-avatar" style="cursor:pointer;"
                         onclick="abrirFotoPerfil('@profilePic')"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="prof-avatar-letter" style="display:none;">@Model.Username.Substring(0,1).ToUpper()</div>
                }
                else
                { <div class="prof-avatar-letter">@Model.Username.Substring(0,1).ToUpper()</div> }
            </div>

            @if (!isMe && !isSystemAccount)
            {
                <div class="prof-actions" style="padding-top:16px;">
                    @if (isFollowing)
                    {
                        <form asp-controller="User" asp-action="Unfollow" method="post">
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <button class="prof-btn secondary">✓ Siguiendo</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="User" asp-action="Follow" method="post">
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <button class="prof-btn primary">+ Seguir</button>
                        </form>
                    }
                    @if (isFriend)
                    {
                        <button class="prof-btn ghost-green" disabled>✅ Amigos</button>
                        <button class="prof-btn ghost-red" onclick="confirmarEliminarAmigo()" id="removeFriendBtn">👋 Eliminar</button>
                    }
                    else if (friendStatus == "Pending")
                    { <button class="prof-btn ghost-yellow" disabled>⏳ Pendiente</button> }
                    else
                    {
                        <form asp-action="SendFriendRequest" method="post">
                            <input type="hidden" name="receiverId" value="@Model.Id" />
                            <button class="prof-btn success">👤 Agregar</button>
                        </form>
                    }
                    @if (canChat)
                    { <a href="/Message/Chat?userId=@Model.Id" class="prof-btn secondary">💬 Mensaje</a> }
                    else if (msgStatus == "Pending")
                    { <button class="prof-btn ghost-yellow" disabled>⏳ Mensaje enviado</button> }
                    else if (msgStatus == "Rejected")
                    { <button class="prof-btn ghost-red" disabled>🚫 Rechazado</button> }
                    else
                    { <button class="prof-btn secondary" onclick="document.getElementById('msgReqModal').style.display='flex'">💬 Mensaje</button> }
                </div>
            }
        </div>

        <!-- INFO -->
        <div class="prof-username-row">
            <h1 class="prof-username">@Model.Username</h1>
            @if (Model.IsPremium)
            { <span class="prof-premium-icon" title="Premium">👑</span> }
            @if (isSystemAccount)
            { <span class="prof-verified-system" title="Cuenta oficial verificada de HabitTracker">✦</span> }
        </div>

        @if (!string.IsNullOrEmpty(Model.FullName) && !isSystemAccount)
        { <p class="prof-fullname">@Model.FullName</p> }

        @if (canSeeProfile)
        {
            @if (!string.IsNullOrEmpty(Model.Bio))
            { <p class="prof-bio">@Model.Bio</p> }

            <div class="prof-meta">
                @if (Model.CreatedAt.HasValue && !isSystemAccount)
                { <span class="prof-meta-item">📅 Se unió en @Model.CreatedAt.Value.ToString("MMM yyyy", culture)</span> }
                @if (Model.IsPremium)
                { <span class="prof-meta-item" style="color:#fbbf24;">⭐ Premium</span> }
            </div>
            @if (!string.IsNullOrEmpty(Model.Country))
            {
                <div style="margin-bottom:14px;">
                    <span class="prof-meta-item">🌍 @Model.Country</span>
                </div>
            }

            <div class="prof-stats-row">
                @if (isSystemAccount)
                {
                    <div class="prof-stat">
                        <span class="prof-stat-num" style="color:rgba(255,255,255,0.3);">—</span>
                        <span class="prof-stat-label">Seguidores</span>
                    </div>
                    <div class="prof-stat">
                        <span class="prof-stat-num" style="color:rgba(255,255,255,0.3);">—</span>
                        <span class="prof-stat-label">Siguiendo</span>
                    </div>
                }
                else
                {
                    <div class="prof-stat" onclick="openModal('followers')">
                        <span class="prof-stat-num">@followersCount</span>
                        <span class="prof-stat-label">Seguidores</span>
                    </div>
                    <div class="prof-stat" onclick="openModal('following')">
                        <span class="prof-stat-num">@followingCount</span>
                        <span class="prof-stat-label">Siguiendo</span>
                    </div>
                }
                <div class="prof-stat">
                    <span class="prof-stat-num">@(isSystemAccount ? "—" : userPosts.Count.ToString())</span>
                    <span class="prof-stat-label">Posts</span>
                </div>
            </div>

            @if (canSeeProfile && totalHabits > 0 && isMe)
            {
                <div class="prof-habit-strip">
                    <div class="prof-habit-chip habit">📋 @totalHabits hábitos</div>
                    @if (bestStreak > 0)
                    { <div class="prof-habit-chip fire">🔥 @bestStreak días de racha</div> }
                    @if (isFriend)
                    { <div class="prof-habit-chip trophy">🤝 Amigos</div> }
                </div>
            }
        }
        else
        {
            <p style="font-size:13px;color:rgba(255,255,255,0.25);font-style:italic;margin:10px 0 0;">
                🔒 Esta cuenta es privada
            </p>
        }
    </div>

    @if (canSeeProfile)
    {
        @if (!isSystemAccount)
        {
            <div class="prof-tabs">
                <button class="prof-tab active" onclick="switchTab(this)">📸 Publicaciones</button>
            </div>
        }

        <div class="prof-content" id="tab-posts">
            @{
                var misPosts = ViewBag.UserPosts as List<Post> ?? new List<Post>();
                var postLikes = ViewBag.PostLikes as Dictionary<int, int> ?? new Dictionary<int, int>();
                var commentCounts = ViewBag.CommentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
                var myLikes = ViewBag.MyLikes as HashSet<int> ?? new HashSet<int>();
            }
            @if (!misPosts.Any())
            {
                <div class="prof-empty">
                    @if (isSystemAccount)
                    {
                        <div class="prof-empty-icon">🤖</div>
                        <div class="prof-empty-title">Cuenta oficial</div>
                        <div class="prof-empty-sub">Esta es la cuenta oficial de HabitTracker. Aquí compartimos actualizaciones, novedades y anuncios importantes de la plataforma. ✦</div>
                    }
                    else
                    {
                        <div class="prof-empty-icon">📭</div>
                        <div class="prof-empty-title">Sin publicaciones</div>
                        <div class="prof-empty-sub">@Model.Username aún no ha compartido nada.</div>
                    }
                </div>
            }
            else
            {
                <div class="feed-container" style="max-width:100%; margin:0;">
                    @foreach (var post in misPosts)
                    {
                        var isVideo = !string.IsNullOrEmpty(post.ImagePath) &&
                                      (post.ImagePath.Contains("/video/upload/") ||
                                       post.ImagePath.EndsWith(".mp4") ||
                                       post.ImagePath.EndsWith(".mov") ||
                                       post.ImagePath.EndsWith(".webm"));
                        var likeCount = postLikes.ContainsKey(post.Id) ? postLikes[post.Id] : 0;
                        var isLiked = myLikes.Contains(post.Id);
                        var comentarios = commentCounts.ContainsKey(post.Id) ? commentCounts[post.Id] : 0;

                        <article class="post-card" id="post-@post.Id">
                            <!-- HEADER -->
                            <div class="post-header">
                                <div class="post-header-left">
                                    <a asp-controller="User" asp-action="Profile" asp-route-id="@post.UserId" class="avatar-link">
                                        @{
                                            var postPic = !string.IsNullOrEmpty(post.User?.ProfileImage) ? post.User.ProfileImage : post.User?.ProfilePicture;
                                        }
                                        @if (!string.IsNullOrEmpty(postPic))
                                        {
                                            <img src="@postPic" class="post-avatar" />
                                        }
                                        else
                                        {
                                            <div class="post-avatar-placeholder">@post.DisplayUsername.Substring(0,1).ToUpper()</div>
                                        }
                                    </a>
                                    <div class="post-meta">
                                        <div class="post-username">
                                            <a href="/User/Profile/@post.UserId" style="text-decoration:none;color:inherit;">@post.DisplayUsername</a>
                                        </div>
                                        <div class="post-time-wrap">
                                            <span class="post-time">@post.CreatedAt.ToString("dd MMM yyyy · hh:mm tt", new System.Globalization.CultureInfo("es-CO"))</span>
                                            @if (post.UserId == myId)
                                            {
                                                if (post.Privacy == "Friends")
                                                { <span class="post-privacy-badge friends">👥 Amigos</span> }
                                                else if (post.Privacy == "Private")
                                                { <span class="post-privacy-badge private">🔒 Solo yo</span> }
                                                else
                                                { <span class="post-privacy-badge public">🌐 Público</span> }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="post-header-right">
                                    @if (post.IsSensitive)
                                    {
                                        <span class="sensitive-badge">⚠️ Sensible</span>
                                    }
                                </div>
                            </div>

                            <!-- DESCRIPCIÓN -->
                            @if (!string.IsNullOrEmpty(post.Description))
                            {
                                <p class="post-description">@post.Description</p>
                            }

                            <!-- MEDIA -->
                            @if (!string.IsNullOrEmpty(post.ImagePath))
                            {
                                <div class="post-media-wrap @(isVideo ? "video-wrap" : "") @(post.IsSensitive ? "sensitive-wrap" : "")">
                                    @if (isVideo)
                                    {
                                        <video controls class="post-media" preload="metadata">
                                            <source src="@post.ImagePath" />
                                        </video>
                                        <div class="video-badge">▶ Video</div>
                                    }
                                    else if (post.IsSensitive)
                                    {
                                        <img src="@post.ImagePath" class="post-media sensitive-blurred" id="img-@post.Id" />
                                        <div class="sensitive-overlay" id="overlay-@post.Id">
                                            <div class="sensitive-overlay-content">
                                                <span class="sensitive-icon">⚠️</span>
                                                <p>Contenido sensible</p>
                                                <button class="reveal-btn" onclick="revealSensitive(@post.Id)">Ver imagen</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@post.ImagePath" class="post-media" onclick="abrirFotoPost(this.src)" />
                                    }
                                </div>
                            }

                            <!-- STATS -->
                            <div class="post-stats">
                                <span id="like-summary-@post.Id">
                                    @if (likeCount > 0)
                                    {
                                        <span>❤️ @likeCount @(likeCount == 1 ? "like" : "likes")</span>
                                    }
                                </span>
                                <span>
                                    @if (comentarios > 0)
                                    {
                                        <span>@comentarios @(comentarios == 1 ? "comentario" : "comentarios")</span>
                                    }
                                </span>
                            </div>

                            <div class="post-divider"></div>

                            <!-- ACCIONES -->
                            <div class="post-actions">
                                <button class="action-btn like-btn" data-post-id="@post.Id" data-no-loader="true">
                                    <span class="action-icon like-icon" id="like-icon-@post.Id">@(isLiked ? "❤️" : "🤍")</span>
                                    <span class="action-label">Me gusta</span>
                                </button>

                                <a asp-controller="Post" asp-action="Comments" asp-route-postId="@post.Id" class="action-btn">
                                    <span class="action-icon">💬</span>
                                    <span class="action-label">Comentar</span>
                                </a>

                                <button class="action-btn" data-no-loader="true" onclick="openShare(@post.Id)">
                                    <span class="action-icon">↪️</span>
                                    <span class="action-label">Compartir</span>
                                </button>

                                <button class="action-btn save-btn" data-no-loader="true" onclick="savePost(@post.Id, this)">
                                    <span class="action-icon">🔖</span>
                                    <span class="action-label">Guardar</span>
                                </button>

                                <a asp-controller="Post" asp-action="Report" asp-route-postId="@post.Id" class="action-btn report-btn">
                                    <span class="action-icon">🚩</span>
                                    <span class="action-label">Reportar</span>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="private-wall">
            <div class="private-wall-lock">🔒</div>
            <div class="private-wall-title">Esta cuenta es privada</div>
            <div class="private-wall-sub">
                Solo los amigos de <strong style="color:white;">@Model.Username</strong> pueden ver sus publicaciones.
            </div>
            @if (friendStatus == null || friendStatus == "")
            {
                <div class="private-wall-hint">👤 Agrégalo como amigo para ver su contenido</div>
            }
            else if (friendStatus == "Pending")
            {
                <div class="private-wall-hint" style="color:#fbbf24;border-color:rgba(251,191,36,0.2);background:rgba(251,191,36,0.08);">⏳ Solicitud enviada — esperando respuesta</div>
            }
            <div class="private-wall-notice">🔒 Esta cuenta es privada</div>
        </div>
    }

    <!-- SHARE MENU, LIKE EXPLOSION, COPY ALERT (ubicados correctamente al final de prof-wrap) -->
    <div id="shareOverlay" class="share-overlay" onclick="closeShare()"></div>
    <div id="shareMenu" class="share-menu">
        <div class="share-handle"></div>
        <div class="share-title">Compartir publicación</div>
        <div class="share-options">
            <div class="share-option" onclick="shareWhatsApp()"><span class="share-option-icon">📱</span><span>WhatsApp</span></div>
            <div class="share-option" onclick="shareTelegram()"><span class="share-option-icon">✈️</span><span>Telegram</span></div>
            <div class="share-option" onclick="shareFacebook()"><span class="share-option-icon">📘</span><span>Facebook</span></div>
            <div class="share-option" onclick="copyLink()"><span class="share-option-icon">📋</span><span>Copiar link</span></div>
        </div>
        <div class="share-option cancel" onclick="closeShare()">✕ Cancelar</div>
    </div>
    <div id="likeExplosion" class="like-explosion" style="display:none;">❤️</div>
    <div id="copyAlert" class="copy-alert">↪ Link copiado</div>

</div> <!-- cierre de prof-wrap -->

<!-- MODAL SEGUIDORES -->
<div id="followModal" class="follow-modal" style="display:none;">
    <div class="follow-content">
        <div class="follow-header">
            <span id="modalTitle">Usuarios</span>
            <button class="close-btn" onclick="closeModal()">✕</button>
        </div>
        <div id="followList"><div style="text-align:center;padding:20px;color:rgba(255,255,255,0.3);">Cargando...</div></div>
    </div>
</div>

<script>
// ========== FUNCIONES DE LIKES, SHARE, SAVE ==========
function revealSensitive(postId) {
    const img = document.getElementById('img-' + postId);
    const overlay = document.getElementById('overlay-' + postId);
    if (img) img.classList.remove('sensitive-blurred');
    if (overlay) overlay.style.display = 'none';
}

function toggleLike(btnElement, postId) {
    const icon = btnElement.querySelector('.like-icon');
    const isLiked = icon.textContent === '❤️';
    // Animación local
    icon.classList.remove('like-pop');
    void icon.offsetWidth;
    icon.classList.add('like-pop');
    if (!isLiked) {
        const explosion = document.getElementById('likeExplosion');
        const rect = icon.getBoundingClientRect();
        explosion.style.left = (rect.left + rect.width / 2) + 'px';
        explosion.style.top = (rect.top + rect.height / 2) + 'px';
        explosion.style.display = 'block';
        explosion.classList.remove('animate');
        void explosion.offsetWidth;
        explosion.classList.add('animate');
        setTimeout(() => { explosion.style.display = 'none'; explosion.classList.remove('animate'); }, 700);
    }
    fetch('/Post/ToggleLike?postId=' + postId, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            icon.textContent = data.liked ? '❤️' : '🤍';
            const summary = document.getElementById('like-summary-' + postId);
            if (summary) {
                summary.innerHTML = data.count > 0 ? `<span>❤️ ${data.count} ${data.count === 1 ? 'like' : 'likes'}</span>` : '';
            }
        });
}

function savePost(postId, btn) {
    fetch('/Post/SavePost', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(postId)
    }).then(() => {
        const icon = btn.querySelector('.action-icon');
        icon.textContent = '🔖';
        icon.style.filter = 'drop-shadow(0 0 4px rgba(99,102,241,0.6))';
        showAlert('🔖 Publicación guardada');
        setTimeout(() => icon.style.filter = '', 1000);
    });
}

let currentPost = null;
function openShare(postId) {
    currentPost = postId;
    document.getElementById('shareMenu').style.display = 'block';
    document.getElementById('shareOverlay').style.display = 'block';
}
function closeShare() {
    document.getElementById('shareMenu').style.display = 'none';
    document.getElementById('shareOverlay').style.display = 'none';
}
function shareWhatsApp() {
    window.open('https://wa.me/?text=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}
function shareTelegram() {
    window.open('https://t.me/share/url?url=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}
function shareFacebook() {
    window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}
function copyLink() {
    navigator.clipboard.writeText(window.location.origin + '/Post/Comments?postId=' + currentPost);
    closeShare();
    showAlert('↪ Link copiado');
}
function showAlert(msg) {
    const el = document.getElementById('copyAlert');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 2500);
}

// Asignar eventos a botones de like después de cargar la página
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.like-btn').forEach(btn => {
        const postId = btn.getAttribute('data-post-id');
        if (postId) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                toggleLike(this, postId);
            });
        }
    });
});

// ========== FUNCIONES EXISTENTES DEL PERFIL ==========
const targetUserId = @Model.Id;

function switchTab(btn) {
    document.querySelectorAll('.prof-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
}

function openModal(type) {
    const modal = document.getElementById("followModal");
    const list = document.getElementById("followList");
    document.getElementById("modalTitle").innerText = type === "followers" ? "Seguidores" : "Siguiendo";
    modal.style.display = "flex";
    list.innerHTML = "<div style='text-align:center;padding:20px;color:rgba(255,255,255,0.3);'>Cargando...</div>";
    fetch('/User/' + (type === "followers" ? "GetFollowers" : "GetFollowing") + '?userId=' + targetUserId)
        .then(r => r.text()).then(data => list.innerHTML = data);
}

function closeModal() { document.getElementById("followModal").style.display = "none"; }
document.getElementById("followModal").addEventListener("click", function(e) { if(e.target===this) closeModal(); });

function closeMsgReqModal() { document.getElementById("msgReqModal").style.display = "none"; }
function updateReqChars() {
    const len = document.getElementById("msgReqText").value.length;
    document.getElementById("reqCharsCount").textContent = len;
    document.getElementById("msgReqSendBtn").disabled = len === 0;
}

function abrirFotoPerfil(src) {
    const overlay = document.createElement('div');
    overlay.id = 'photoOverlay';
    overlay.style.cssText = `
        position:fixed;inset:0;z-index:999999;
        background:rgba(0,0,0,0.85);backdrop-filter:blur(12px);
        display:flex;align-items:center;justify-content:center;
        animation:fadeInPhoto 0.25s ease;cursor:pointer;
    `;
    overlay.innerHTML = `
        <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:16px;">
            <img src="${src}" style="
                width:280px;height:280px;border-radius:50%;object-fit:cover;
                border:4px solid rgba(255,255,255,0.15);
                box-shadow:0 20px 60px rgba(0,0,0,0.6);
                animation:scaleInPhoto 0.3s cubic-bezier(0.34,1.56,0.64,1);
            "/>
            <button onclick="cerrarFotoPerfil()" style="
                background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);
                color:white;padding:8px 24px;border-radius:20px;
                font-size:13px;font-weight:700;cursor:pointer;
                font-family:inherit;transition:0.2s;
            " onmouseover="this.style.background='rgba(255,255,255,0.2)'"
               onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                ✕ Cerrar
            </button>
        </div>
    `;
    overlay.addEventListener('click', function(e) {
        if (e.target === this) cerrarFotoPerfil();
    });
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
}
function cerrarFotoPerfil() {
    const overlay = document.getElementById('photoOverlay');
    if (overlay) {
        overlay.style.opacity = '0';
        overlay.style.transition = 'opacity 0.2s';
        setTimeout(() => { overlay.remove(); document.body.style.overflow = ''; }, 200);
    }
}
function abrirFotoPost(src) {
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;z-index:999999;background:rgba(0,0,0,0.85);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:center;cursor:pointer;';
    overlay.innerHTML = `<div><img src="${src}" style="max-width:90vw;max-height:90vh;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,0.6);" /></div>`;
    overlay.addEventListener('click', () => overlay.remove());
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
    overlay.addEventListener('click', () => { overlay.remove(); document.body.style.overflow = ''; });
}
async function sendMsgReq() {
    const msg = document.getElementById("msgReqText").value.trim();
    if (!msg) return;
    const btn = document.getElementById("msgReqSendBtn");
    btn.disabled = true; btn.textContent = "⏳ Enviando...";
    try {
        const res = await fetch("/Message/SendMessageRequest", {
            method:"POST", headers:{"Content-Type":"application/json"},
            body: JSON.stringify({ receiverId: targetUserId, message: msg })
        });
        const data = await res.json();
        if (data.success) {
            closeMsgReqModal();
            document.querySelectorAll(".prof-btn.secondary").forEach(b => {
                if (b.textContent.includes("Mensaje") && !b.href)
                    b.outerHTML = '<button class="prof-btn ghost-yellow" disabled>⏳ Mensaje enviado</button>';
            });
            showToast("✅ Solicitud enviada");
        } else {
            showToast("⚠️ " + (data.error ?? "Error al enviar"));
            btn.disabled = false; btn.textContent = "Enviar →";
        }
    } catch {
        showToast("❌ Error de conexión");
        btn.disabled = false; btn.textContent = "Enviar →";
    }
}
document.getElementById("msgReqModal").addEventListener("click", function(e) { if(e.target===this) closeMsgReqModal(); });
function confirmarEliminarAmigo() {
    if (!confirm("¿Eliminar a @Model.Username de tus amigos?")) return;
    fetch("/User/RemoveFriend", {
        method:"POST", headers:{"Content-Type":"application/json"},
        body: JSON.stringify({ blockedId: targetUserId })
    }).then(r => r.json()).then(data => {
        if (data.success) {
            showToast("✅ Amigo eliminado");
            const fb = document.querySelector(".prof-btn.ghost-green");
            const rb = document.getElementById("removeFriendBtn");
            if (fb) fb.outerHTML = '<form action="/User/SendFriendRequest" method="post" style="display:inline;"><input type="hidden" name="receiverId" value="'+targetUserId+'"/><button class="prof-btn success">👤 Agregar</button></form>';
            if (rb) rb.remove();
        } else { showToast("❌ No se pudo eliminar"); }
    }).catch(() => showToast("❌ Error"));
}
function showToast(msg) {
    document.querySelectorAll('.prof-toast').forEach(t => t.remove());
    const t = document.createElement("div");
    t.className = "prof-toast"; t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => { t.style.opacity="0"; t.style.transition="opacity 0.3s"; setTimeout(() => t.remove(), 300); }, 3000);
}
</script>