@model HabitTrackerApp.Models.User
@{
    ViewData["Title"] = "Perfil de usuario";
    var myId = int.Parse(User.FindFirst("UserId").Value);
    var db = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>();
    var isFollowing = db.Follows.Any(f => f.FollowerId == myId && f.FollowingId == Model.Id);
    var friendStatus = db.FriendRequests
        .Where(f => (f.SenderId == myId && f.ReceiverId == Model.Id) ||
                    (f.SenderId == Model.Id && f.ReceiverId == myId))
        .Select(f => f.Status)
        .FirstOrDefault();

    var userPosts = db.Posts
        .Where(p => p.UserId == Model.Id)
        .OrderByDescending(p => p.CreatedAt)
        .ToList();
}

<!-- COVER + AVATAR -->
<div class="profile-page">

    <div class="profile-cover">
       <div class="cover-gradient" style="opacity:0.6;"></div>
    </div>

 <div class="profile-main">
    <div class="profile-avatar-wrap">
            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Model.ProfileImage" class="profile-avatar" />
            }
            else
            {
                <div class="profile-avatar-letter">
                    @Model.Username.Substring(0, 1).ToUpper()
                </div>
            }
        </div>

        <!-- INFO -->
        <div class="profile-info">
            <div class="profile-top">
                <div>
                    <h2 class="profile-username">@Model.Username</h2>
                    @if (!string.IsNullOrEmpty(Model.FullName))
                    {
                        <p class="profile-fullname">@Model.FullName</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <p class="profile-bio">@Model.Bio</p>
                    }
                    <p class="profile-joined">📅 Se unió el @Model.CreatedAt?.ToString("dd MMM yyyy")</p>
                </div>

                <!-- ACCIONES -->
                @if (Model.Id != myId)
                {
                    <div class="profile-actions">
                        @if (isFollowing)
                        {
                            <form asp-controller="User" asp-action="Unfollow" method="post">
                                <input type="hidden" name="userId" value="@Model.Id" />
                                <button class="action-btn following">✓ Siguiendo</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="User" asp-action="Follow" method="post">
                                <input type="hidden" name="userId" value="@Model.Id" />
                                <button class="action-btn follow">+ Seguir</button>
                            </form>
                        }

                        @if (friendStatus == "Accepted")
                        {
                            <button class="action-btn friends" disabled>✅ Amigos</button>
                        }
                        else if (friendStatus == "Pending")
                        {
                            <button class="action-btn pending" disabled>⏳ Pendiente</button>
                        }
                        else
                        {
                            <form asp-action="SendFriendRequest" method="post">
                                <input type="hidden" name="receiverId" value="@Model.Id" />
                                <button class="action-btn add">👤 Agregar</button>
                            </form>
                        }

                        <a asp-controller="Message" asp-action="Chat" asp-route-userId="@Model.Id" class="action-btn message">
                            💬 Mensaje
                        </a>
                    </div>
                }
            </div>

            <!-- STATS -->
            <div class="profile-stats">
                <div class="stat-item" onclick="if(@ViewBag.Followers > 0) openModal('followers')">
                  <span class="stat-num">@ViewBag.Followers</span>
                    <span class="stat-label">Seguidores</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item"onclick="if(@ViewBag.Following > 0) openModal('following')" >
              <span class="stat-num">@ViewBag.Following</span>
                    <span class="stat-label">Siguiendo</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-num">@userPosts.Count</span>
                    <span class="stat-label">Publicaciones</span>
                </div>
            </div>
        </div>
    </div>

    <!-- PUBLICACIONES -->
    <div class="posts-section">
        <h4 class="posts-title">📸 Publicaciones</h4>

        @if (!userPosts.Any())
        {
            <div class="no-posts">
                <div class="no-posts-icon">📭</div>
                <p>@Model.Username aún no ha subido publicaciones.</p>
            </div>
        }
        else
        {
            <div class="posts-grid">
                @foreach (var post in userPosts)
                {
                    <a href="/Post/Comments?postId=@post.Id" class="post-tile">
                        @if (!string.IsNullOrEmpty(post.ImagePath))
{
    <img src="@post.ImagePath" class="post-tile-img" onerror="this.style.display='none'" />
}
@if (string.IsNullOrEmpty(post.ImagePath) || string.IsNullOrEmpty(post.Description))
{
    <div class="post-tile-text">
        <span>📝</span>
        <p>@(post.Description?.Length > 60 ? post.Description.Substring(0, 60) + "..." : post.Description ?? "Sin descripción")</p>
        <small>@post.CreatedAt.ToString("dd MMM yyyy")</small>
    </div>
}
else
{
    <div class="post-tile-date">@post.CreatedAt.ToString("dd MMM · hh:mm tt")</div>
}
                        <div class="post-tile-overlay">
                            <span>💬 Ver post</span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- MODAL -->
<div id="followModal" class="follow-modal" style="display:none;">
    <div class="follow-content">
        <div class="follow-header">
            <span id="modalTitle">Usuarios</span>
            <span class="close-btn" onclick="closeModal()">✖</span>
        </div>
        <div id="followList"></div>
    </div>
</div>

<style>
.profile-page {
    max-width: 900px;
    margin: 0 auto;
}

/* COVER */
.profile-cover {
    display: none;
}

.cover-gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0f172a, #1e3a5f, #312e81);
}

/* MAIN */
.profile-main {
    display: flex;
    gap: 20px;
    padding: 0 24px;
    margin-bottom: 24px;
    align-items: flex-end;
}

.profile-avatar-wrap {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
}

.profile-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.profile-avatar-letter {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    font-weight: 800;
    border: 5px solid white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.profile-info {
    flex: 1;
    padding-bottom: 8px;
}

.profile-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
}

.profile-username {
    font-size: 24px;
    font-weight: 800;
    color: #111827;
    margin-top: 8px;
}

.profile-fullname {
    font-size: 15px;
    color: #6b7280;
    margin: 0 0 4px;
}

.profile-bio {
    font-size: 14px;
    color: #4b5563;
    margin: 0 0 4px;
    max-width: 400px;
}

.profile-joined {
    font-size: 12px;
    color: #9ca3af;
    margin: 0;
}

/* ACCIONES */
.profile-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.action-btn {
    padding: 9px 18px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: 0.2s;
}

.action-btn.follow { background: #2563eb; color: white; }
.action-btn.follow:hover { background: #1d4ed8; }
.action-btn.following { background: #f3f4f6; color: #374151; }
.action-btn.following:hover { background: #fee2e2; color: #dc2626; }
.action-btn.add { background: #22c55e; color: white; }
.action-btn.add:hover { background: #16a34a; }
.action-btn.message { background: #f3f4f6; color: #374151; }
.action-btn.message:hover { background: #e5e7eb; }
.action-btn.friends { background: #dcfce7; color: #16a34a; }
.action-btn.pending { background: #fef3c7; color: #d97706; }

/* STATS */
.profile-stats {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 16px;
    padding: 14px 18px;
    background: white;
    border-radius: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
    width: fit-content;
}

.stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: 0.2s;
}

.post-tile-date {
    position: absolute;
    bottom: 6px;
    right: 8px;
    font-size: 10px;
    color: white;
    background: rgba(0,0,0,0.5);
    padding: 2px 6px;
    border-radius: 6px;
    font-weight: 500;
}

.stat-item:hover .stat-num { color: #2563eb; }
.stat-num { font-size: 20px; font-weight: 800; color: #111827; }
.stat-label { font-size: 11px; color: #9ca3af; font-weight: 600; text-transform: uppercase; }
.stat-divider { width: 1px; height: 28px; background: #e5e7eb; }

/* POSTS */
.posts-section {
    background: white;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
}

.posts-title {
    font-size: 17px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid #f3f4f6;
}

.no-posts {
    text-align: center;
    padding: 40px;
    color: #9ca3af;
}

.no-posts-icon { font-size: 48px; margin-bottom: 12px; }
.no-posts p { font-size: 15px; font-weight: 500; margin: 0; }

.posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
}

@@media (max-width: 600px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
    .profile-main { flex-direction: column; align-items: center; }
}

.post-tile {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    display: block;
    background: #f3f4f6;
}

.post-tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: 0.3s;
}

.post-tile:hover .post-tile-img { transform: scale(1.05); }

.post-tile-text {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 14px;
    background: linear-gradient(135deg, #eff6ff, #e0e7ff);
    gap: 6px;
}

.post-tile-text span { font-size: 24px; }
.post-tile-text small { font-size: 10px; color: #9ca3af; }

.post-tile-text p {
    font-size: 13px;
    color: #4b5563;
    text-align: center;
    margin: 0;
    line-height: 1.4;
}

.post-tile-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: 0.2s;
    border-radius: 8px;
}

.post-tile-overlay span { color: white; font-weight: 600; font-size: 14px; }
.post-tile:hover .post-tile-overlay { opacity: 1; }

/* MODAL */
.follow-modal {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.follow-content {
    background: white;
    border-radius: 20px;
    padding: 24px;
    width: 360px;
    max-height: 500px;
    overflow-y: auto;
}

.follow-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 16px;
    color: #111827;
}

.close-btn { cursor: pointer; color: #9ca3af; font-size: 18px; }
.close-btn:hover { color: #111827; }

/* DARK MODE */
body.bg-dark .profile-username { color: #f1f5f9 !important; }
body.bg-dark .profile-stats,
body.bg-dark .posts-section {
    background: #1e1e2e !important;
    border-color: #2d2d3d !important;
}
body.bg-dark .stat-num { color: #f1f5f9 !important; }
body.bg-dark .posts-title { color: #f1f5f9 !important; border-color: #2d2d3d !important; }
body.bg-dark .profile-avatar { border-color: #1e1e2e !important; }
body.bg-dark .profile-avatar-letter { border-color: #1e1e2e !important; }
body.bg-dark .action-btn.message,
body.bg-dark .action-btn.following { background: #2d2d3d !important; color: #f1f5f9 !important; }
body.bg-dark .follow-content { background: #1e1e2e !important; }
body.bg-dark .follow-header { color: #f1f5f9 !important; }
body.bg-dark .post-tile-text { background: #2d2d3d !important; }
body.bg-dark .post-tile-text p { color: #94a3b8 !important; }
body.bg-dark .profile-bio { color: #94a3b8 !important; }
body.bg-dark .profile-fullname { color: #64748b !important; }
</style>

<script>
function openModal(type) {
    const modal = document.getElementById("followModal");
    const list = document.getElementById("followList");
    const title = document.getElementById("modalTitle");
    modal.style.display = "flex";
    list.innerHTML = "Cargando...";
    title.innerText = type === "followers" ? "Seguidores" : "Siguiendo";
    fetch(`/User/${type === "followers" ? "GetFollowers" : "GetFollowing"}?userId=@Model.Id`)
        .then(r => r.text())
        .then(data => list.innerHTML = data);
}

function closeModal() {
    document.getElementById("followModal").style.display = "none";
}
</script>