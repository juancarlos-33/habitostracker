@model HabitTrackerApp.Models.User
@{
    ViewData["Title"] = "Perfil de usuario";
    var myId = int.Parse(User.FindFirst("UserId").Value);
    var db = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>();
    var isFollowing = db.Follows.Any(f => f.FollowerId == myId && f.FollowingId == Model.Id);
    var friendStatus = db.FriendRequests
        .Where(f => (f.SenderId == myId && f.ReceiverId == Model.Id) ||
                    (f.SenderId == Model.Id && f.ReceiverId == myId))
        .Select(f => f.Status)
        .FirstOrDefault();

    var userPosts = db.Posts
        .Where(p => p.UserId == Model.Id)
        .OrderByDescending(p => p.CreatedAt)
        .ToList();
}

<div class="profile-page">

    <div class="profile-main">
        <div class="profile-avatar-wrap">
            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Model.ProfileImage" class="profile-avatar" />
            }
            else
            {
                <div class="profile-avatar-letter">
                    @Model.Username.Substring(0, 1).ToUpper()
                </div>
            }
        </div>

        <div class="profile-info">
            <div class="profile-top">
                <div>
                    <h2 class="profile-username">@Model.Username</h2>
                    @if (!string.IsNullOrEmpty(Model.FullName))
                    {
                        <p class="profile-fullname">@Model.FullName</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <p class="profile-bio">@Model.Bio</p>
                    }
                    <p class="profile-joined">📅 Se unió el @Model.CreatedAt?.ToString("dd MMM yyyy")</p>
                </div>

                @if (Model.Id != myId)
                {
                    <div class="profile-actions">
                        @if (isFollowing)
                        {
                            <form asp-controller="User" asp-action="Unfollow" method="post">
                                <input type="hidden" name="userId" value="@Model.Id" />
                                <button class="action-btn following">✓ Siguiendo</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="User" asp-action="Follow" method="post">
                                <input type="hidden" name="userId" value="@Model.Id" />
                                <button class="action-btn follow">+ Seguir</button>
                            </form>
                        }

                        @if (friendStatus == "Accepted")
                        {
                            <button class="action-btn friends" disabled>✅ Amigos</button>
                        }
                        else if (friendStatus == "Pending")
                        {
                            <button class="action-btn pending" disabled>⏳ Pendiente</button>
                        }
                        else
                        {
                            <form asp-action="SendFriendRequest" method="post">
                                <input type="hidden" name="receiverId" value="@Model.Id" />
                                <button class="action-btn add">👤 Agregar</button>
                            </form>
                        }

                        <a asp-controller="Message" asp-action="Chat" asp-route-userId="@Model.Id" class="action-btn message">
                            💬 Mensaje
                        </a>
                    </div>
                }
            </div>

            <div class="profile-stats">
                <div class="stat-item" onclick="if(@ViewBag.Followers > 0) openModal('followers')">
                    <span class="stat-num">@ViewBag.Followers</span>
                    <span class="stat-label">Seguidores</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item" onclick="if(@ViewBag.Following > 0) openModal('following')">
                    <span class="stat-num">@ViewBag.Following</span>
                    <span class="stat-label">Siguiendo</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-num">@userPosts.Count</span>
                    <span class="stat-label">Publicaciones</span>
                </div>
            </div>
        </div>
    </div>

    <div class="posts-section">
        <h4 class="posts-title">📸 Publicaciones</h4>

        @if (!userPosts.Any())
        {
            <div class="no-posts">
                <div class="no-posts-icon">📭</div>
                <p>@Model.Username aún no ha subido publicaciones.</p>
            </div>
        }
        else
        {
            <div class="posts-grid">
                @foreach (var post in userPosts)
                {
                    var isVideo = !string.IsNullOrEmpty(post.ImagePath) &&
                                  (post.ImagePath.Contains("/video/upload/") ||
                                   post.ImagePath.EndsWith(".mp4") ||
                                   post.ImagePath.EndsWith(".mov") ||
                                   post.ImagePath.EndsWith(".webm"));

                    <a href="/Post/Index" class="post-tile">
                        @if (isVideo)
                        {
                            <div class="post-tile-video">
                                <video class="post-tile-img" muted preload="metadata">
                                    <source src="@post.ImagePath" />
                                </video>
                                <div class="post-tile-video-badge">▶ Video</div>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(post.ImagePath))
                        {
                            <img src="@post.ImagePath" class="post-tile-img" />
                        }
                        else
                        {
                            <div class="post-tile-noimg">📝</div>
                        }
                        <div class="post-tile-info">
                            <p class="post-tile-desc">@(post.Description?.Length > 50 ? post.Description.Substring(0, 50) + "..." : post.Description ?? "")</p>
                            <small class="post-tile-date2">@post.CreatedAt.ToString("dd MMM yyyy · hh:mm tt")</small>
                        </div>
                        <div class="post-tile-overlay">
                            <span>@(isVideo ? "▶ Ver video" : "👁 Ver post")</span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

<div id="followModal" class="follow-modal" style="display:none;">
    <div class="follow-content">
        <div class="follow-header">
            <span id="modalTitle">Usuarios</span>
            <span class="close-btn" onclick="closeModal()">✖</span>
        </div>
        <div id="followList"></div>
    </div>
</div>

<style>
.profile-page { max-width: 900px; margin: 0 auto; }

.profile-main {
    display: flex;
    gap: 20px;
    padding: 0 24px;
    margin-bottom: 24px;
    align-items: flex-start;
}

.profile-avatar-wrap { flex-shrink: 0; }

.profile-avatar {
    width: 120px; height: 120px;
    border-radius: 50%; object-fit: cover;
    border: 5px solid white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.profile-avatar-letter {
    width: 120px; height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 48px; font-weight: 800;
    border: 5px solid white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.profile-info { flex: 1; min-width: 0; }

.profile-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
}

.profile-username { font-size: 24px; font-weight: 800; color: #111827; margin: 0 0 4px; }
.profile-fullname { font-size: 15px; color: #6b7280; margin: 0 0 4px; }
.profile-bio { font-size: 14px; color: #4b5563; margin: 0 0 4px; max-width: 400px; line-height: 1.5; }
.profile-joined { font-size: 12px; color: #9ca3af; margin: 0; }

.profile-actions { display: flex; gap: 8px; flex-wrap: wrap; }

.action-btn {
    padding: 9px 18px; border-radius: 10px;
    font-size: 13px; font-weight: 600;
    cursor: pointer; border: none;
    text-decoration: none;
    display: inline-flex; align-items: center;
    transition: 0.2s;
}

.action-btn.follow { background: #2563eb; color: white; }
.action-btn.follow:hover { background: #1d4ed8; }
.action-btn.following { background: #f3f4f6; color: #374151; }
.action-btn.following:hover { background: #fee2e2; color: #dc2626; }
.action-btn.add { background: #22c55e; color: white; }
.action-btn.add:hover { background: #16a34a; }
.action-btn.message { background: #f3f4f6; color: #374151; }
.action-btn.message:hover { background: #e5e7eb; }
.action-btn.friends { background: #dcfce7; color: #16a34a; }
.action-btn.pending { background: #fef3c7; color: #d97706; }

.profile-stats {
    display: flex; align-items: center; gap: 20px;
    padding: 14px 18px;
    background: white; border-radius: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
    width: fit-content;
    flex-wrap: wrap;
}

.stat-item { display: flex; flex-direction: column; align-items: center; cursor: pointer; transition: 0.2s; }
.stat-item:hover .stat-num { color: #2563eb; }
.stat-num { font-size: 20px; font-weight: 800; color: #111827; }
.stat-label { font-size: 11px; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
.stat-divider { width: 1px; height: 28px; background: #e5e7eb; }

.posts-section {
    background: white; border-radius: 20px; padding: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
}

.posts-title {
    font-size: 17px; font-weight: 700; color: #111827;
    margin-bottom: 18px; padding-bottom: 14px;
    border-bottom: 1px solid #f3f4f6;
}

.no-posts { text-align: center; padding: 40px; color: #9ca3af; }
.no-posts-icon { font-size: 48px; margin-bottom: 12px; }
.no-posts p { font-size: 15px; font-weight: 500; margin: 0; }

.posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

@@media (max-width: 768px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
    .profile-main { flex-direction: column; align-items: center; text-align: center; }
    .profile-top { justify-content: center; }
    .profile-actions { justify-content: center; }
    .profile-stats { margin: 0 auto; }
    .profile-bio { max-width: 100%; }
}

.post-tile {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    display: block;
    background: #f3f4f6;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: 0.2s;
}

.post-tile:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }

.post-tile-img {
    width: 100%; height: 180px;
    object-fit: cover; display: block;
    transition: 0.3s;
}

.post-tile:hover .post-tile-img { transform: scale(1.04); }

.post-tile-video {
    position: relative;
    width: 100%; height: 180px;
    overflow: hidden;
    background: #000;
}

.post-tile-video .post-tile-img {
    width: 100%; height: 180px;
    object-fit: cover;
}

.post-tile-video-badge {
    position: absolute;
    bottom: 8px; left: 8px;
    background: rgba(0,0,0,0.7);
    color: white;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
}

.post-tile-noimg {
    width: 100%; height: 120px;
    display: flex; align-items: center; justify-content: center;
    font-size: 32px;
    background: linear-gradient(135deg, #eff6ff, #e0e7ff);
}

.post-tile-info { padding: 10px 12px; background: white; }

.post-tile-desc {
    font-size: 12px; color: #374151;
    margin: 0 0 4px; line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.post-tile-date2 { font-size: 10px; color: #9ca3af; }

.post-tile-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: 0.2s; border-radius: 14px;
}

.post-tile-overlay span { color: white; font-weight: 700; font-size: 14px; }
.post-tile:hover .post-tile-overlay { opacity: 1; }

.follow-modal {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: flex; justify-content: center; align-items: center;
    z-index: 9999; backdrop-filter: blur(4px);
}

.follow-content {
    background: white; border-radius: 20px; padding: 24px;
    width: 360px; max-height: 500px; overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

.follow-header {
    display: flex; justify-content: space-between; align-items: center;
    font-weight: 700; font-size: 16px; margin-bottom: 16px; color: #111827;
}

.close-btn { cursor: pointer; color: #9ca3af; font-size: 18px; transition: 0.2s; }
.close-btn:hover { color: #111827; }

/* DARK MODE */
body.bg-dark .profile-username { color: #f1f5f9 !important; }
body.bg-dark .profile-bio { color: #94a3b8 !important; }
body.bg-dark .profile-fullname { color: #64748b !important; }
body.bg-dark .profile-stats,
body.bg-dark .posts-section { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .stat-num { color: #f1f5f9 !important; }
body.bg-dark .stat-divider { background: #2d2d3d !important; }
body.bg-dark .posts-title { color: #f1f5f9 !important; border-color: #2d2d3d !important; }
body.bg-dark .profile-avatar { border-color: #1e1e2e !important; }
body.bg-dark .profile-avatar-letter { border-color: #1e1e2e !important; }
body.bg-dark .action-btn.message,
body.bg-dark .action-btn.following { background: #2d2d3d !important; color: #f1f5f9 !important; }
body.bg-dark .follow-content { background: #1e1e2e !important; }
body.bg-dark .follow-header { color: #f1f5f9 !important; }
body.bg-dark .post-tile-info { background: #2d2d3d !important; }
body.bg-dark .post-tile-desc { color: #cbd5e1 !important; }
body.bg-dark .post-tile-noimg { background: linear-gradient(135deg, #1e3a5f, #2d2d4d) !important; }
</style>

<script>
function openModal(type) {
    const modal = document.getElementById("followModal");
    const list = document.getElementById("followList");
    const title = document.getElementById("modalTitle");
    modal.style.display = "flex";
    list.innerHTML = "<div style='text-align:center;padding:20px;color:#9ca3af;'>Cargando...</div>";
    title.innerText = type === "followers" ? "Seguidores" : "Siguiendo";
    fetch(`/User/${type === "followers" ? "GetFollowers" : "GetFollowing"}?userId=@Model.Id`)
        .then(r => r.text())
        .then(data => list.innerHTML = data);
}

function closeModal() {
    document.getElementById("followModal").style.display = "none";
}

document.getElementById("followModal").addEventListener("click", function(e) {
    if (e.target === this) closeModal();
});
</script>