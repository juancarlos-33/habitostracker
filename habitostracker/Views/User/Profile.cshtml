@model HabitTrackerApp.Models.User
@{
    ViewData["Title"] = "Perfil de " + Model.Username;
    var myId = int.Parse(User.FindFirst("UserId").Value);
    var db = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>();
    var culture = new System.Globalization.CultureInfo("es-ES");
    var isFollowing = db.Follows.Any(f => f.FollowerId == myId && f.FollowingId == Model.Id);
    var friendStatus = db.FriendRequests
        .Where(f => (f.SenderId == myId && f.ReceiverId == Model.Id) ||
                    (f.SenderId == Model.Id && f.ReceiverId == myId))
        .Select(f => f.Status).FirstOrDefault();
    var userPosts = db.Posts.Where(p => p.UserId == Model.Id).OrderByDescending(p => p.CreatedAt).ToList();
    var profilePic = !string.IsNullOrEmpty(Model.ProfileImage) ? Model.ProfileImage : Model.ProfilePicture;
    bool isMe = Model.Id == myId;
    bool isFriend = friendStatus == "Accepted";
 bool isSystemAccount = Model.Role == "System";
 bool canSeeProfile = !Model.IsPrivate || isFriend || isMe;
    var msgRequest = db.MessageRequests.FirstOrDefault(r =>
        (r.SenderId == myId && r.ReceiverId == Model.Id) ||
        (r.SenderId == Model.Id && r.ReceiverId == myId));
    var msgStatus = msgRequest?.Status ?? "None";
    bool canChat = isFriend || msgStatus == "Accepted";
    var followersCount = db.Follows.Count(f => f.FollowingId == Model.Id);
    var followingCount = db.Follows.Count(f => f.FollowerId == Model.Id);
    var totalHabits = db.Habits.Count(h => h.UserId == Model.Id);
    var bestStreak = db.Habits.Where(h => h.UserId == Model.Id).Any()
        ? db.Habits.Where(h => h.UserId == Model.Id).Max(h => h.MaxStreak) : 0;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
* { box-sizing: border-box; }
.prof-wrap { max-width: 960px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; padding-bottom: 60px; }

/* ══ COVER ══ */
.prof-cover {
    position: relative; height: 240px; border-radius: 24px; overflow: hidden;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 30%, #4c1d95 60%, #6d28d9 100%);
    box-shadow: 0 24px 64px rgba(0,0,0,0.5);
}
.prof-verified-system {
    font-size:18px; color:#6366f1;
    filter:drop-shadow(0 0 6px rgba(99,102,241,0.8));
    cursor:default; user-select:none; font-weight:900;
}
.prof-cover img { width:100%; height:100%; object-fit:cover; display:block; }
.prof-cover-overlay { position:absolute; inset:0; background:linear-gradient(to bottom, transparent 30%, rgba(0,0,0,0.6) 100%); }
.prof-cover-dots { position:absolute; inset:0; opacity:0.05; background-image:radial-gradient(circle,white 1px,transparent 1px); background-size:24px 24px; }
@@media(max-width:768px){ .prof-cover { height:160px; border-radius:20px; } }

/* ══ PROFILE CARD ══ */
.prof-card {
    background: linear-gradient(180deg,#161b2e 0%,#0f1623 100%);
    border-radius: 0 0 28px 28px;
    border: 1px solid rgba(255,255,255,0.06); border-top:none;
    padding: 0 32px 28px; margin-bottom: 16px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.35);
}
@@media(max-width:768px){ .prof-card { padding: 0 16px 20px; } }

/* ══ AVATAR ══ */
.prof-avatar-zone { display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:18px; }
.prof-avatar-wrap { position:relative; margin-top:-56px; flex-shrink:0; }
.prof-avatar {
    width:110px; height:110px; border-radius:50%; object-fit:cover;
    border:4px solid #0f1623; box-shadow:0 8px 32px rgba(0,0,0,0.6); display:block; transition:0.3s;
}
.prof-avatar:hover { transform:scale(1.04); box-shadow:0 12px 40px rgba(99,102,241,0.3); }
.prof-avatar-letter {
    width:110px; height:110px; border-radius:50%;
    background:linear-gradient(135deg,#6366f1,#7c3aed);
    color:white; display:flex; align-items:center; justify-content:center;
    font-size:44px; font-weight:900; border:4px solid #0f1623;
    box-shadow:0 8px 32px rgba(0,0,0,0.6);
}
.prof-online-dot {
    position:absolute; bottom:6px; right:6px;
    width:16px; height:16px; border-radius:50%;
    background:#22c55e; border:3px solid #0f1623;
    box-shadow:0 0 8px rgba(34,197,94,0.6);
}
@@media(max-width:768px){ .prof-avatar,.prof-avatar-letter { width:88px; height:88px; font-size:34px; } .prof-avatar-wrap { margin-top:-44px; } }

/* ══ INFO ══ */
.prof-username-row { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px; }
.prof-username { font-size:24px; font-weight:900; color:white; margin:0; letter-spacing:-0.5px; }
.prof-premium-icon { font-size:18px; filter:drop-shadow(0 2px 6px rgba(251,191,36,0.5)); }
.prof-fullname { font-size:14px; color:rgba(255,255,255,0.4); margin:0 0 10px; font-weight:500; }
.prof-bio { font-size:14px; color:rgba(255,255,255,0.75); line-height:1.7; margin:0 0 14px; max-width:520px; }
.prof-meta { display:flex; flex-wrap:wrap; gap:14px; margin-bottom:16px; }
.prof-meta-item { display:flex; align-items:center; gap:5px; font-size:12px; color:rgba(255,255,255,0.35); font-weight:600; }

/* ══ STATS ══ */
.prof-stats-row {
    display:flex; gap:0; margin-bottom:0;
    background:rgba(255,255,255,0.04); border-radius:18px;
    border:1px solid rgba(255,255,255,0.07); overflow:hidden; width:fit-content;
}
.prof-stat { display:flex; flex-direction:column; align-items:center; padding:14px 28px; cursor:pointer; transition:0.2s; position:relative; }
.prof-stat:not(:last-child)::after { content:""; position:absolute; right:0; top:20%; height:60%; width:1px; background:rgba(255,255,255,0.07); }
.prof-stat:hover { background:rgba(255,255,255,0.05); }
.prof-stat-num { font-size:20px; font-weight:900; color:white; line-height:1; }
.prof-stat-label { font-size:10px; color:rgba(255,255,255,0.3); font-weight:700; text-transform:uppercase; letter-spacing:0.8px; margin-top:3px; }
@@media(max-width:768px){ .prof-stats-row { width:100%; } .prof-stat { flex:1; padding:12px 6px; } .prof-stat-num { font-size:17px; } }

/* ══ HABIT STATS STRIP ══ */
.prof-habit-strip {
    display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;
}
.prof-habit-chip {
    display:flex; align-items:center; gap:6px;
    padding:8px 14px; border-radius:14px;
    background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07);
    font-size:12px; font-weight:700; color:rgba(255,255,255,0.6);
}
.prof-habit-chip.fire { border-color:rgba(251,146,60,0.3); color:#fb923c; background:rgba(251,146,60,0.08); }
.prof-habit-chip.trophy { border-color:rgba(251,191,36,0.3); color:#fbbf24; background:rgba(251,191,36,0.08); }
.prof-habit-chip.habit { border-color:rgba(99,102,241,0.3); color:#818cf8; background:rgba(99,102,241,0.08); }

/* ══ ACTIONS ══ */
.prof-actions { display:flex; gap:8px; flex-wrap:wrap; padding-top:20px; }
.prof-btn {
    padding:10px 20px; border-radius:12px; font-size:13px; font-weight:700;
    cursor:pointer; border:none; text-decoration:none;
    display:inline-flex; align-items:center; gap:6px; transition:0.2s;
    font-family:inherit; white-space:nowrap;
}
.prof-btn.primary { background:linear-gradient(135deg,#6366f1,#4f46e5); color:white; box-shadow:0 4px 16px rgba(99,102,241,0.35); }
.prof-btn.primary:hover { transform:translateY(-1px); box-shadow:0 8px 24px rgba(99,102,241,0.55); color:white; }
.prof-btn.secondary { background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.8); border:1px solid rgba(255,255,255,0.12); }
.prof-btn.secondary:hover { background:rgba(255,255,255,0.14); color:white; }
.prof-btn.success { background:linear-gradient(135deg,#22c55e,#16a34a); color:white; box-shadow:0 4px 14px rgba(34,197,94,0.3); }
.prof-btn.success:hover { transform:translateY(-1px); color:white; box-shadow:0 8px 20px rgba(34,197,94,0.4); }
.prof-btn.ghost-green { background:rgba(34,197,94,0.1); color:#4ade80; border:1px solid rgba(34,197,94,0.2); }
.prof-btn.ghost-yellow { background:rgba(251,191,36,0.1); color:#fbbf24; border:1px solid rgba(251,191,36,0.2); }
.prof-btn.ghost-red { background:rgba(239,68,68,0.1); color:#f87171; border:1px solid rgba(239,68,68,0.2); }
.prof-btn.ghost-red:hover { background:rgba(239,68,68,0.2); color:#ef4444; }
.prof-btn:disabled { cursor:not-allowed; opacity:0.6; transform:none !important; }

/* ══ POSTS GRID ══ */
.prof-tabs {
    display:flex; margin-bottom:16px;
    background:rgba(255,255,255,0.03); border-radius:18px;
    border:1px solid rgba(255,255,255,0.06); overflow:hidden;
    position:sticky; top:70px; z-index:10; backdrop-filter:blur(20px);
}
.prof-tab {
    flex:1; padding:14px 16px; text-align:center; font-size:13px; font-weight:700;
    color:rgba(255,255,255,0.35); cursor:pointer; transition:0.2s;
    border:none; background:transparent; font-family:inherit;
    display:flex; align-items:center; justify-content:center; gap:6px;
}
.prof-tab.active { background:rgba(99,102,241,0.15); color:#818cf8; border-bottom:2px solid #6366f1; }
.prof-tab:hover:not(.active) { background:rgba(255,255,255,0.04); color:rgba(255,255,255,0.6); }

.prof-content { min-height:300px; }
.posts-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:3px; border-radius:18px; overflow:hidden; }
.post-tile { position:relative; aspect-ratio:1; overflow:hidden; display:block; background:#1e293b; text-decoration:none; }
.post-tile-img { width:100%; height:100%; object-fit:cover; display:block; transition:0.35s; }
.post-tile:hover .post-tile-img { transform:scale(1.08); }
.post-tile-video { width:100%; height:100%; object-fit:cover; display:block; }
.post-tile-badge { position:absolute; top:8px; right:8px; background:rgba(0,0,0,0.75); color:white; font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; backdrop-filter:blur(4px); }
.post-tile-noimg { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:32px; background:linear-gradient(135deg,#1e293b,#2d1b69); }
.post-tile-overlay { position:absolute; inset:0; background:rgba(0,0,0,0.65); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; opacity:0; transition:0.25s; backdrop-filter:blur(3px); }
.post-tile:hover .post-tile-overlay { opacity:1; }
.post-tile-overlay-text { color:white; font-weight:800; font-size:14px; }
.post-tile-overlay-date { color:rgba(255,255,255,0.5); font-size:11px; }

/* ══ EMPTY ══ */
.prof-empty { display:flex; flex-direction:column; align-items:center; padding:80px 20px; text-align:center; }
.prof-empty-icon { font-size:64px; margin-bottom:18px; }
.prof-empty-title { font-size:18px; font-weight:800; color:rgba(255,255,255,0.6); margin-bottom:8px; }
.prof-empty-sub { font-size:13px; color:rgba(255,255,255,0.25); line-height:1.6; max-width:240px; }

/* ══ PRIVATE WALL ══ */
.private-wall {
    display:flex; flex-direction:column; align-items:center; padding:90px 20px; text-align:center;
    background:linear-gradient(135deg,rgba(99,102,241,0.04),rgba(124,58,237,0.04));
    border-radius:24px; border:1px solid rgba(99,102,241,0.1);
}
.private-wall-lock { font-size:80px; margin-bottom:22px; filter:drop-shadow(0 8px 28px rgba(99,102,241,0.35)); animation:floatLock 3s ease-in-out infinite; }
@@keyframes floatLock { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);} }
.private-wall-title { font-size:24px; font-weight:900; color:white; margin-bottom:10px; }
.private-wall-sub { font-size:14px; color:rgba(255,255,255,0.35); line-height:1.75; max-width:320px; }
.private-wall-hint { margin-top:28px; padding:14px 22px; border-radius:16px; background:rgba(99,102,241,0.1); border:1px solid rgba(99,102,241,0.2); font-size:13px; color:#818cf8; font-weight:600; }
.private-wall-notice { margin-top:14px; font-size:12px; color:rgba(255,255,255,0.2); font-style:italic; }

/* ══ MODALS ══ */
.follow-modal { position:fixed; inset:0; background:rgba(0,0,0,0.75); display:flex; justify-content:center; align-items:center; z-index:9999; backdrop-filter:blur(10px); }
.follow-content { background:linear-gradient(135deg,#1a1f35,#111827); border-radius:24px; padding:24px; width:380px; max-height:520px; overflow-y:auto; box-shadow:0 40px 80px rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.08); }
.follow-header { display:flex; justify-content:space-between; align-items:center; font-weight:800; font-size:16px; color:white; margin-bottom:16px; padding-bottom:14px; border-bottom:1px solid rgba(255,255,255,0.07); }
.close-btn { width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:14px; color:rgba(255,255,255,0.5); transition:0.2s; border:none; }
.close-btn:hover { background:rgba(255,255,255,0.14); color:white; }

.msg-req-modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:99999; align-items:center; justify-content:center; backdrop-filter:blur(12px); }
.msg-req-card { background:linear-gradient(135deg,#1a1f35,#0f172a); border-radius:28px; padding:36px 30px; max-width:380px; width:92%; border:1px solid rgba(255,255,255,0.08); box-shadow:0 40px 80px rgba(0,0,0,0.7); }
.msg-req-title { font-size:20px; font-weight:900; color:white; text-align:center; margin:0 0 6px; }
.msg-req-sub { font-size:13px; color:rgba(255,255,255,0.4); text-align:center; margin:0 0 20px; line-height:1.6; }
.msg-req-input { width:100%; padding:13px 16px; border-radius:14px; border:1.5px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.04); color:white; font-size:14px; font-family:inherit; outline:none; resize:none; transition:0.2s; box-sizing:border-box; margin-bottom:6px; }
.msg-req-input:focus { border-color:#6366f1; background:rgba(99,102,241,0.06); }
.msg-req-input::placeholder { color:rgba(255,255,255,0.2); }
.msg-req-chars { font-size:11px; color:rgba(255,255,255,0.25); text-align:right; margin-bottom:18px; }
.msg-req-btns { display:flex; gap:10px; }
.msg-req-cancel { flex:1; padding:12px; border-radius:13px; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.04); color:rgba(255,255,255,0.4); font-size:13px; font-weight:700; cursor:pointer; font-family:inherit; transition:0.2s; }
.msg-req-cancel:hover { background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.7); }
.msg-req-send { flex:1; padding:12px; border-radius:13px; border:none; background:linear-gradient(135deg,#6366f1,#2563eb); color:white; font-size:13px; font-weight:700; cursor:pointer; font-family:inherit; transition:0.2s; box-shadow:0 4px 14px rgba(99,102,241,0.4); }
.msg-req-send:hover { transform:translateY(-1px); }
.msg-req-send:disabled { background:#334155; box-shadow:none; cursor:not-allowed; transform:none; }

/* ══ TOAST ══ */
.prof-toast { position:fixed; bottom:90px; left:50%; transform:translateX(-50%); background:rgba(15,23,42,0.97); color:white; padding:12px 24px; border-radius:24px; font-size:13px; font-weight:600; z-index:99999; box-shadow:0 8px 32px rgba(0,0,0,0.5); backdrop-filter:blur(12px); border:1px solid rgba(255,255,255,0.08); animation:toastIn 0.3s ease; white-space:nowrap; }
@@keyframes toastIn { from{opacity:0;transform:translateX(-50%) translateY(10px);} to{opacity:1;transform:translateX(-50%) translateY(0);} }

@@media(max-width:768px){
    .posts-grid { gap:2px; }
    .prof-username { font-size:19px; }
    .prof-stats-row { width:100%; border-radius:14px; }
    .prof-tab { font-size:12px; padding:12px 8px; }
    .prof-tabs { top:60px; border-radius:14px; }
    .prof-habit-strip { gap:6px; }
    .prof-habit-chip { font-size:11px; padding:6px 10px; }
}
</style>

<!-- MODAL MENSAJE -->
<div class="msg-req-modal" id="msgReqModal">
    <div class="msg-req-card">
        <div style="text-align:center;margin-bottom:16px;font-size:36px;">💬</div>
        <div class="msg-req-title">Enviar mensaje</div>
        <div class="msg-req-sub">
            Escribe a <strong style="color:#818cf8;">@Model.Username</strong>.<br>
            Cuando lo acepte podrán chatear libremente.
        </div>
        <textarea class="msg-req-input" id="msgReqText" rows="3"
                  placeholder="Hola, me gustaría conectar contigo..."
                  maxlength="200" oninput="updateReqChars()"></textarea>
        <div class="msg-req-chars"><span id="reqCharsCount">0</span>/200</div>
        <div class="msg-req-btns">
            <button class="msg-req-cancel" onclick="closeMsgReqModal()">Cancelar</button>
            <button class="msg-req-send" id="msgReqSendBtn" onclick="sendMsgReq()" disabled>Enviar →</button>
        </div>
    </div>
</div>

<div class="prof-wrap">

    <!-- COVER -->
    <div class="prof-cover">
        @if (!string.IsNullOrEmpty(Model.CoverImage))
        { <img src="@Model.CoverImage" alt="portada" /> }
        else
        { <div class="prof-cover-dots"></div> }
        <div class="prof-cover-overlay"></div>
    </div>

    <!-- PROFILE CARD -->
    <div class="prof-card">
        <div class="prof-avatar-zone">
            <div class="prof-avatar-wrap">
                @if (!string.IsNullOrEmpty(profilePic))
                {
                    <img src="@profilePic" class="prof-avatar"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="prof-avatar-letter" style="display:none;">@Model.Username.Substring(0,1).ToUpper()</div>
                }
                else
                { <div class="prof-avatar-letter">@Model.Username.Substring(0,1).ToUpper()</div> }
            </div>

           @if (!isMe && !isSystemAccount)
{
    <div class="prof-actions" style="padding-top:16px;">
                    @if (isFollowing)
                    {
                        <form asp-controller="User" asp-action="Unfollow" method="post">
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <button class="prof-btn secondary">✓ Siguiendo</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="User" asp-action="Follow" method="post">
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <button class="prof-btn primary">+ Seguir</button>
                        </form>
                    }
                    @if (isFriend)
                    {
                        <button class="prof-btn ghost-green" disabled>✅ Amigos</button>
                        <button class="prof-btn ghost-red" onclick="confirmarEliminarAmigo()" id="removeFriendBtn">👋 Eliminar</button>
                    }
                    else if (friendStatus == "Pending")
                    { <button class="prof-btn ghost-yellow" disabled>⏳ Pendiente</button> }
                    else
                    {
                        <form asp-action="SendFriendRequest" method="post">
                            <input type="hidden" name="receiverId" value="@Model.Id" />
                            <button class="prof-btn success">👤 Agregar</button>
                        </form>
                    }
                    @if (canChat)
                    { <a href="/Message/Chat?userId=@Model.Id" class="prof-btn secondary">💬 Mensaje</a> }
                    else if (msgStatus == "Pending")
                    { <button class="prof-btn ghost-yellow" disabled>⏳ Mensaje enviado</button> }
                    else if (msgStatus == "Rejected")
                    { <button class="prof-btn ghost-red" disabled>🚫 Rechazado</button> }
                    else
                    { <button class="prof-btn secondary" onclick="document.getElementById('msgReqModal').style.display='flex'">💬 Mensaje</button> }
                </div>
            }
        </div>

        <!-- INFO -->
        <div class="prof-username-row">
            <h1 class="prof-username">@Model.Username</h1>
            @if (Model.IsPremium)
            { <span class="prof-premium-icon" title="Premium">👑</span> }
            @if (isSystemAccount)
{
   
}
        </div>

        @if (!string.IsNullOrEmpty(Model.FullName))
        { <p class="prof-fullname">@Model.FullName</p> }

        @if (canSeeProfile)
        {
            @if (!string.IsNullOrEmpty(Model.Bio))
            { <p class="prof-bio">@Model.Bio</p> }

       <div class="prof-meta">
    @if (Model.CreatedAt.HasValue && !isSystemAccount)
    { <span class="prof-meta-item">📅 Se unió en @Model.CreatedAt.Value.ToString("MMM yyyy", culture)</span> }
    @if (Model.IsPremium)
    { <span class="prof-meta-item" style="color:#fbbf24;">⭐ Premium</span> }
</div>
@if (!string.IsNullOrEmpty(Model.Country))
{
    <div style="margin-bottom:14px;">
        <span class="prof-meta-item">🌍 @Model.Country</span>
    </div>
}

           <div class="prof-stats-row">
    @if (isSystemAccount)
    {
        <div class="prof-stat">
            <span class="prof-stat-num" style="color:rgba(255,255,255,0.3);">—</span>
            <span class="prof-stat-label">Seguidores</span>
        </div>
        <div class="prof-stat">
            <span class="prof-stat-num" style="color:rgba(255,255,255,0.3);">—</span>
            <span class="prof-stat-label">Siguiendo</span>
        </div>
    }
    else
    {
        <div class="prof-stat" onclick="openModal('followers')">
            <span class="prof-stat-num">@followersCount</span>
            <span class="prof-stat-label">Seguidores</span>
        </div>
        <div class="prof-stat" onclick="openModal('following')">
            <span class="prof-stat-num">@followingCount</span>
            <span class="prof-stat-label">Siguiendo</span>
        </div>
    }
 <div class="prof-stat">
    <span class="prof-stat-num">@(isSystemAccount ? "—" : userPosts.Count.ToString())</span>
    <span class="prof-stat-label">Posts</span>
</div>
</div>

            @if (canSeeProfile && totalHabits > 0)
            {
                <div class="prof-habit-strip">
                    <div class="prof-habit-chip habit">📋 @totalHabits hábitos</div>
                    @if (bestStreak > 0)
                    { <div class="prof-habit-chip fire">🔥 @bestStreak días de racha</div> }
                    @if (isFriend)
                    { <div class="prof-habit-chip trophy">🤝 Amigos</div> }
                </div>
            }
        }
        else
        {
            <p style="font-size:13px;color:rgba(255,255,255,0.25);font-style:italic;margin:10px 0 0;">
                🔒 Esta cuenta es privada
            </p>
        }
    </div>

    @if (canSeeProfile)
    {
        <div class="prof-tabs">
            <button class="prof-tab active" onclick="switchTab(this)">📸 Publicaciones</button>
        </div>

        <div class="prof-content" id="tab-posts">
            @if (!userPosts.Any())
            {
                <div class="prof-empty">
                    @if (isSystemAccount)
{
    <div class="prof-empty-icon">🤖</div>
    <div class="prof-empty-title">Cuenta oficial</div>
    <div class="prof-empty-sub">Esta es la cuenta oficial de HabitTracker.
Aquí compartimos actualizaciones, novedades y anuncios importantes de la plataforma. ✦</div>
}
else
{
    <div class="prof-empty-icon">📭</div>
    <div class="prof-empty-title">Sin publicaciones</div>
    <div class="prof-empty-sub">@Model.Username aún no ha compartido nada.</div>
}
                </div>
            }
            else
            {
                <div class="posts-grid">
                    @foreach (var post in userPosts)
                    {
                        var isVideo = !string.IsNullOrEmpty(post.ImagePath) &&
                                      (post.ImagePath.Contains("/video/upload/") ||
                                       post.ImagePath.EndsWith(".mp4") ||
                                       post.ImagePath.EndsWith(".mov") ||
                                       post.ImagePath.EndsWith(".webm"));
                        <a href="/Post/Index" class="post-tile">
                            @if (isVideo)
                            {
                                <video class="post-tile-video" muted preload="metadata"><source src="@post.ImagePath" /></video>
                                <span class="post-tile-badge">▶</span>
                            }
                            else if (!string.IsNullOrEmpty(post.ImagePath))
                            { <img src="@post.ImagePath" class="post-tile-img" loading="lazy" /> }
                            else
                            { <div class="post-tile-noimg">📝</div> }
                            <div class="post-tile-overlay">
                                <span class="post-tile-overlay-text">@(isVideo ? "▶ Video" : "👁 Ver")</span>
                                <span class="post-tile-overlay-date">@post.CreatedAt.ToString("dd MMM", culture)</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="private-wall">
            <div class="private-wall-lock">🔒</div>
            <div class="private-wall-title">Esta cuenta es privada</div>
            <div class="private-wall-sub">
                Solo los amigos de <strong style="color:white;">@Model.Username</strong> pueden ver sus publicaciones y estadísticas.
            </div>
            @if (friendStatus == null || friendStatus == "")
            {
                <div class="private-wall-hint">👤 Agrégalo como amigo para ver su contenido</div>
            }
            else if (friendStatus == "Pending")
            {
                <div class="private-wall-hint" style="color:#fbbf24;border-color:rgba(251,191,36,0.2);background:rgba(251,191,36,0.08);">⏳ Solicitud enviada — esperando respuesta</div>
            }
            <div class="private-wall-notice">🔒 Esta cuenta es privada</div>
        </div>
    }
</div>

<!-- MODAL SEGUIDORES -->
<div id="followModal" class="follow-modal" style="display:none;">
    <div class="follow-content">
        <div class="follow-header">
            <span id="modalTitle">Usuarios</span>
            <button class="close-btn" onclick="closeModal()">✕</button>
        </div>
        <div id="followList"><div style="text-align:center;padding:20px;color:rgba(255,255,255,0.3);">Cargando...</div></div>
    </div>
</div>

<script>
const targetUserId = @Model.Id;

function switchTab(btn) {
    document.querySelectorAll('.prof-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
}

function openModal(type) {
    const modal = document.getElementById("followModal");
    const list = document.getElementById("followList");
    document.getElementById("modalTitle").innerText = type === "followers" ? "Seguidores" : "Siguiendo";
    modal.style.display = "flex";
    list.innerHTML = "<div style='text-align:center;padding:20px;color:rgba(255,255,255,0.3);'>Cargando...</div>";
    fetch('/User/' + (type === "followers" ? "GetFollowers" : "GetFollowing") + '?userId=' + targetUserId)
        .then(r => r.text()).then(data => list.innerHTML = data);
}

function closeModal() { document.getElementById("followModal").style.display = "none"; }
document.getElementById("followModal").addEventListener("click", function(e) { if(e.target===this) closeModal(); });

function closeMsgReqModal() { document.getElementById("msgReqModal").style.display = "none"; }
function updateReqChars() {
    const len = document.getElementById("msgReqText").value.length;
    document.getElementById("reqCharsCount").textContent = len;
    document.getElementById("msgReqSendBtn").disabled = len === 0;
}

async function sendMsgReq() {
    const msg = document.getElementById("msgReqText").value.trim();
    if (!msg) return;
    const btn = document.getElementById("msgReqSendBtn");
    btn.disabled = true; btn.textContent = "⏳ Enviando...";
    try {
        const res = await fetch("/Message/SendMessageRequest", {
            method:"POST", headers:{"Content-Type":"application/json"},
            body: JSON.stringify({ receiverId: targetUserId, message: msg })
        });
        const data = await res.json();
        if (data.success) {
            closeMsgReqModal();
            document.querySelectorAll(".prof-btn.secondary").forEach(b => {
                if (b.textContent.includes("Mensaje") && !b.href)
                    b.outerHTML = '<button class="prof-btn ghost-yellow" disabled>⏳ Mensaje enviado</button>';
            });
            showToast("✅ Solicitud enviada");
        } else {
            showToast("⚠️ " + (data.error ?? "Error al enviar"));
            btn.disabled = false; btn.textContent = "Enviar →";
        }
    } catch {
        showToast("❌ Error de conexión");
        btn.disabled = false; btn.textContent = "Enviar →";
    }
}

document.getElementById("msgReqModal").addEventListener("click", function(e) { if(e.target===this) closeMsgReqModal(); });

function confirmarEliminarAmigo() {
    if (!confirm("¿Eliminar a @Model.Username de tus amigos?")) return;
    fetch("/User/RemoveFriend", {
        method:"POST", headers:{"Content-Type":"application/json"},
        body: JSON.stringify({ blockedId: targetUserId })
    }).then(r => r.json()).then(data => {
        if (data.success) {
            showToast("✅ Amigo eliminado");
            const fb = document.querySelector(".prof-btn.ghost-green");
            const rb = document.getElementById("removeFriendBtn");
            if (fb) fb.outerHTML = '<form action="/User/SendFriendRequest" method="post" style="display:inline;"><input type="hidden" name="receiverId" value="'+targetUserId+'"/><button class="prof-btn success">👤 Agregar</button></form>';
            if (rb) rb.remove();
        } else { showToast("❌ No se pudo eliminar"); }
    }).catch(() => showToast("❌ Error"));
}

function showToast(msg) {
    document.querySelectorAll('.prof-toast').forEach(t => t.remove());
    const t = document.createElement("div");
    t.className = "prof-toast"; t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => { t.style.opacity="0"; t.style.transition="opacity 0.3s"; setTimeout(() => t.remove(), 300); }, 3000);
}
</script>