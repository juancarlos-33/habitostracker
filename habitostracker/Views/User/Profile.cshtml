@model HabitTrackerApp.Models.User
@{
    ViewData["Title"] = "Perfil de usuario";
    var myId = int.Parse(User.FindFirst("UserId").Value);
    var db = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>();
    var culture = new System.Globalization.CultureInfo("es-ES");
    var isFollowing = db.Follows.Any(f => f.FollowerId == myId && f.FollowingId == Model.Id);
    var friendStatus = db.FriendRequests
        .Where(f => (f.SenderId == myId && f.ReceiverId == Model.Id) ||
                    (f.SenderId == Model.Id && f.ReceiverId == myId))
        .Select(f => f.Status)
        .FirstOrDefault();
    var userPosts = db.Posts
        .Where(p => p.UserId == Model.Id)
        .OrderByDescending(p => p.CreatedAt)
        .ToList();
    var profilePic = !string.IsNullOrEmpty(Model.ProfileImage)
        ? Model.ProfileImage : Model.ProfilePicture;
    bool isMe = Model.Id == myId;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.prof-page { max-width: 900px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; padding-bottom: 40px; }

/* HERO */
.prof-hero {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-radius: 24px; margin-bottom: 16px;
    overflow: hidden; position: relative;
}
.prof-hero-banner {
    height: 120px;
    background: linear-gradient(135deg, #6366f1 0%, #2563eb 50%, #7c3aed 100%);
    position: relative; overflow: hidden;
}
.prof-hero-banner::before {
    content:""; position:absolute; inset:0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.prof-hero-body { padding: 0 24px 24px; }
.prof-avatar-wrap { position: relative; display: inline-block; margin-top: -48px; margin-bottom: 14px; }
.prof-avatar {
    width: 96px; height: 96px; border-radius: 50%; object-fit: cover;
    border: 4px solid #0f172a; box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    display: block;
}
.prof-avatar-letter {
    width: 96px; height: 96px; border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #7c3aed);
    color: white; display: flex; align-items: center; justify-content: center;
    font-size: 38px; font-weight: 800;
    border: 4px solid #0f172a; box-shadow: 0 8px 24px rgba(0,0,0,0.4);
}
.prof-online-dot {
    position: absolute; bottom: 4px; right: 4px;
    width: 20px; height: 20px; border-radius: 50%;
    background: #22c55e; border: 3px solid #0f172a;
}

.prof-info-row { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 14px; }
.prof-username { font-size: 22px; font-weight: 800; color: white; margin: 0 0 4px; }
.prof-fullname { font-size: 14px; color: rgba(255,255,255,0.5); margin: 0 0 6px; }
.prof-bio { font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.6; margin: 0 0 8px; max-width: 420px; }
.prof-joined { font-size: 12px; color: rgba(255,255,255,0.3); }

.prof-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.prof-btn {
    padding: 9px 18px; border-radius: 12px; font-size: 13px; font-weight: 700;
    cursor: pointer; border: none; text-decoration: none;
    display: inline-flex; align-items: center; gap: 6px; transition: 0.2s;
    font-family: inherit;
}
.prof-btn.follow { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; }
.prof-btn.follow:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(99,102,241,0.4); }
.prof-btn.following { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.15); }
.prof-btn.following:hover { background: rgba(239,68,68,0.15); color: #f87171; border-color: rgba(239,68,68,0.3); }
.prof-btn.add { background: linear-gradient(135deg, #22c55e, #16a34a); color: white; }
.prof-btn.add:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(34,197,94,0.35); }
.prof-btn.message { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.15); }
.prof-btn.message:hover { background: rgba(255,255,255,0.14); color: white; }
.prof-btn.friends { background: rgba(34,197,94,0.15); color: #4ade80; border: 1px solid rgba(34,197,94,0.25); }
.prof-btn.pending { background: rgba(251,191,36,0.1); color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }

/* STATS */
.prof-stats {
    display: flex; gap: 0; margin-top: 18px;
    background: rgba(255,255,255,0.05); border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.06); overflow: hidden;
    width: fit-content;
}
.prof-stat {
    display: flex; flex-direction: column; align-items: center;
    padding: 14px 24px; cursor: pointer; transition: 0.2s; position: relative;
}
.prof-stat:not(:last-child)::after {
    content:""; position:absolute; right:0; top:20%; height:60%;
    width:1px; background: rgba(255,255,255,0.08);
}
.prof-stat:hover { background: rgba(255,255,255,0.05); }
.prof-stat-num { font-size: 20px; font-weight: 800; color: white; }
.prof-stat-label { font-size: 11px; color: rgba(255,255,255,0.4); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

/* POSTS SECTION */
.prof-posts {
    background: white; border-radius: 22px; padding: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.04);
}
.prof-posts-title {
    font-size: 16px; font-weight: 800; color: #111827;
    margin-bottom: 18px; padding-bottom: 14px;
    border-bottom: 1px solid #f3f4f6;
    display: flex; align-items: center; gap: 8px;
}
.prof-posts-count {
    font-size: 12px; font-weight: 700; padding: 3px 10px;
    border-radius: 20px; background: #ede9fe; color: #6366f1;
    margin-left: auto;
}

.posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }

.post-tile {
    position: relative; border-radius: 16px; overflow: hidden;
    display: block; background: #f3f4f6; text-decoration: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: 0.2s; aspect-ratio: 1;
}
.post-tile:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.14); }
.post-tile-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: 0.3s; }
.post-tile:hover .post-tile-img { transform: scale(1.05); }
.post-tile-video { position: relative; width: 100%; height: 100%; background: #000; }
.post-tile-video video { width: 100%; height: 100%; object-fit: cover; }
.post-tile-badge {
    position: absolute; bottom: 8px; left: 8px;
    background: rgba(0,0,0,0.7); color: white; font-size: 10px; font-weight: 700;
    padding: 3px 10px; border-radius: 20px; backdrop-filter: blur(4px);
}
.post-tile-noimg {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-size: 32px;
    background: linear-gradient(135deg, #eff6ff, #e0e7ff);
}
.post-tile-overlay {
    position: absolute; inset: 0; background: rgba(0,0,0,0.55);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 4px; opacity: 0; transition: 0.2s;
}
.post-tile:hover .post-tile-overlay { opacity: 1; }
.post-tile-overlay span { color: white; font-weight: 700; font-size: 13px; }
.post-tile-overlay small { color: rgba(255,255,255,0.6); font-size: 11px; }

/* EMPTY */
.prof-empty {
    text-align: center; padding: 50px 20px; color: #9ca3af;
}
.prof-empty-icon { font-size: 52px; margin-bottom: 14px; }
.prof-empty-text { font-size: 15px; font-weight: 600; color: #6b7280; margin: 0 0 6px; }
.prof-empty-sub { font-size: 13px; }

/* FOLLOW MODAL */
.follow-modal {
    position: fixed; inset: 0; background: rgba(0,0,0,0.6);
    display: flex; justify-content: center; align-items: center;
    z-index: 9999; backdrop-filter: blur(6px);
}
.follow-content {
    background: white; border-radius: 22px; padding: 24px;
    width: 360px; max-height: 500px; overflow-y: auto;
    box-shadow: 0 24px 60px rgba(0,0,0,0.3);
}
.follow-header {
    display: flex; justify-content: space-between; align-items: center;
    font-weight: 800; font-size: 16px; margin-bottom: 16px; color: #111827;
}
.close-btn {
    width: 30px; height: 30px; border-radius: 50%;
    background: #f3f4f6; display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 14px; color: #6b7280; transition: 0.2s;
}
.close-btn:hover { background: #e5e7eb; color: #111827; }

/* DARK */
body.bg-dark .prof-posts { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .prof-posts-title { color: #f1f5f9 !important; border-color: #2d3748 !important; }
body.bg-dark .follow-content { background: #1e293b !important; }
body.bg-dark .follow-header { color: #f1f5f9 !important; }
body.bg-dark .close-btn { background: #334155 !important; color: #94a3b8 !important; }
body.bg-dark .post-tile-noimg { background: linear-gradient(135deg, #1e3a5f, #2d2d4d) !important; }
body.bg-dark .prof-posts-count { background: rgba(99,102,241,0.15) !important; }

@@media (max-width: 768px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
    .prof-hero-body { padding: 0 16px 20px; }
    .prof-info-row { flex-direction: column; }
    .prof-stats { width: 100%; justify-content: space-around; }
    .prof-stat { flex: 1; padding: 12px 8px; }
    .prof-username { font-size: 18px; }
}
</style>

<div class="prof-page">

    <!-- HERO CARD -->
    <div class="prof-hero">
        <div class="prof-hero-banner"></div>
        <div class="prof-hero-body">
            <div class="prof-info-row">
                <div>
                    <div class="prof-avatar-wrap">
                        @if (!string.IsNullOrEmpty(profilePic))
                        { <img src="@profilePic" class="prof-avatar" /> }
                        else
                        { <div class="prof-avatar-letter">@Model.Username.Substring(0,1).ToUpper()</div> }
                    </div>
                    <h2 class="prof-username">@Model.Username</h2>
                    @if (!string.IsNullOrEmpty(Model.FullName))
                    { <p class="prof-fullname">@Model.FullName</p> }
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    { <p class="prof-bio">@Model.Bio</p> }
                    <p class="prof-joined">📅 Se unió el @Model.CreatedAt?.ToString("dd MMM yyyy", culture)</p>
                </div>

                @if (!isMe)
                {
                    <div class="prof-actions">
                        @if (isFollowing)
                        {
                            <form asp-controller="User" asp-action="Unfollow" method="post">
                                <input type="hidden" name="userId" value="@Model.Id" />
                                <button class="prof-btn following">✓ Siguiendo</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="User" asp-action="Follow" method="post">
                                <input type="hidden" name="userId" value="@Model.Id" />
                                <button class="prof-btn follow">+ Seguir</button>
                            </form>
                        }

                        @if (friendStatus == "Accepted")
                        {
                            <button class="prof-btn friends" disabled>✅ Amigos</button>
                        }
                        else if (friendStatus == "Pending")
                        {
                            <button class="prof-btn pending" disabled>⏳ Pendiente</button>
                        }
                        else
                        {
                            <form asp-action="SendFriendRequest" method="post">
                                <input type="hidden" name="receiverId" value="@Model.Id" />
                                <button class="prof-btn add">👤 Agregar</button>
                            </form>
                        }

                        <a asp-controller="Message" asp-action="Chat" asp-route-userId="@Model.Id"
                           class="prof-btn message">💬 Mensaje</a>
                    </div>
                }
            </div>

            <!-- STATS -->
            <div class="prof-stats">
                <div class="prof-stat" onclick="if(@ViewBag.Followers > 0) openModal('followers')">
                    <span class="prof-stat-num">@ViewBag.Followers</span>
                    <span class="prof-stat-label">Seguidores</span>
                </div>
                <div class="prof-stat" onclick="if(@ViewBag.Following > 0) openModal('following')">
                    <span class="prof-stat-num">@ViewBag.Following</span>
                    <span class="prof-stat-label">Siguiendo</span>
                </div>
                <div class="prof-stat">
                    <span class="prof-stat-num">@userPosts.Count</span>
                    <span class="prof-stat-label">Posts</span>
                </div>
            </div>
        </div>
    </div>

    <!-- POSTS -->
    <div class="prof-posts">
        <div class="prof-posts-title">
            📸 Publicaciones
            <span class="prof-posts-count">@userPosts.Count</span>
        </div>

        @if (!userPosts.Any())
        {
            <div class="prof-empty">
                <div class="prof-empty-icon">📭</div>
                <div class="prof-empty-text">Sin publicaciones todavía</div>
                <div class="prof-empty-sub">@Model.Username aún no ha subido nada.</div>
            </div>
        }
        else
        {
            <div class="posts-grid">
                @foreach (var post in userPosts)
                {
                    var isVideo = !string.IsNullOrEmpty(post.ImagePath) &&
                                  (post.ImagePath.Contains("/video/upload/") ||
                                   post.ImagePath.EndsWith(".mp4") ||
                                   post.ImagePath.EndsWith(".mov") ||
                                   post.ImagePath.EndsWith(".webm"));

                    <a href="/Post/Index" class="post-tile">
                        @if (isVideo)
                        {
                            <div class="post-tile-video">
                                <video muted preload="metadata">
                                    <source src="@post.ImagePath" />
                                </video>
                                <span class="post-tile-badge">▶ Video</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(post.ImagePath))
                        {
                            <img src="@post.ImagePath" class="post-tile-img" />
                        }
                        else
                        {
                            <div class="post-tile-noimg">📝</div>
                        }
                        <div class="post-tile-overlay">
                            <span>@(isVideo ? "▶ Ver video" : "👁 Ver post")</span>
                            <small>@post.CreatedAt.ToString("dd MMM yyyy", culture)</small>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- MODAL SEGUIDORES/SIGUIENDO -->
<div id="followModal" class="follow-modal" style="display:none;">
    <div class="follow-content">
        <div class="follow-header">
            <span id="modalTitle">Usuarios</span>
            <div class="close-btn" onclick="closeModal()">✕</div>
        </div>
        <div id="followList">
            <div style="text-align:center;padding:20px;color:#9ca3af;">Cargando...</div>
        </div>
    </div>
</div>

<script>
function openModal(type) {
    const modal = document.getElementById("followModal");
    const list = document.getElementById("followList");
    const title = document.getElementById("modalTitle");
    modal.style.display = "flex";
    list.innerHTML = "<div style='text-align:center;padding:20px;color:#9ca3af;'>Cargando...</div>";
    title.innerText = type === "followers" ? "Seguidores" : "Siguiendo";
    fetch(`/User/${type === "followers" ? "GetFollowers" : "GetFollowing"}?userId=@Model.Id`)
        .then(r => r.text())
        .then(data => list.innerHTML = data);
}

function closeModal() {
    document.getElementById("followModal").style.display = "none";
}

document.getElementById("followModal").addEventListener("click", function(e) {
    if (e.target === this) closeModal();
});
</script>