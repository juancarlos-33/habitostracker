/* Estilos para compartir, like explosion, etc. */
.share-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5); display: none; z-index: 9998;
    backdrop-filter: blur(2px);
}
