<script>
// ══ FECHAS LOCALES ══════════════════════
document.addEventListener("DOMContentLoaded", convertirFechasLocales);

function convertirFechasLocales() {
    document.querySelectorAll("[data-utc]").forEach(el => {
        const utcStr = el.getAttribute("data-utc");
        if (!utcStr) return;
        try { el.textContent = formatearFecha(new Date(utcStr), el.getAttribute("data-format") || "datetime"); } catch(e) {}
    });
    document.querySelectorAll("[data-utc-time]").forEach(el => {
        const utcStr = el.getAttribute("data-utc-time");
        if (!utcStr) return;
        try { el.textContent = new Date(utcStr).toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' }); } catch(e) {}
    });
}

function formatearFecha(date, formato) {
    const ahora = new Date();
    const diffMin = Math.floor((ahora - date) / 60000);
    const diffH = Math.floor((ahora - date) / 3600000);
    const diffD = Math.floor((ahora - date) / 86400000);
    if (formato === "relative") {
        if (diffMin < 1) return "ahora";
        if (diffMin < 60) return `hace ${diffMin} min`;
        if (diffH < 24) return `hace ${diffH}h`;
        if (diffD === 1) return "ayer";
        if (diffD < 7) return `hace ${diffD} días`;
        return date.toLocaleDateString('es-CO', { day:'2-digit', month:'short' });
    }
    if (formato === "time") return date.toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' });
    if (formato === "date") return date.toLocaleDateString('es-CO', { day:'2-digit', month:'short', year:'numeric' });
    const esHoy = date.toDateString() === ahora.toDateString();
    const esAyer = new Date(ahora - 86400000).toDateString() === date.toDateString();
    const hora = date.toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' });
    if (esHoy) return hora;
    if (esAyer) return `ayer ${hora}`;
    return date.toLocaleDateString('es-CO', { day:'2-digit', month:'short' }) + ` ${hora}`;
}
window.htConvertirFechas = convertirFechasLocales;
</script>

<script>
const isSuperAdmin = @(User.IsInRole("SuperAdmin").ToString().ToLower());

// ══ SIGNALR ÚNICO ══════════════════════
const connectionGlobal = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

// Eventos de seguridad y sistema
connectionGlobal.on("ForceLogout", msg => {
    document.body.innerHTML = `<div style="height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;font-family:sans-serif;color:white;text-align:center;"><div style="background:#1e293b;padding:50px;border-radius:14px;"><h2 style="color:#f59e0b">⚠ Atención</h2><p>${msg}</p></div></div>`;
    setTimeout(() => window.location.href="/Account/LogoutGet", 2500);
});
connectionGlobal.on("IPBlocked", ip => {
    fetch("/Home/GetMyIP").then(r => r.text()).then(myIp => {
        if (myIp === ip) { document.body.innerHTML = `<div style="height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;font-family:sans-serif;color:white;text-align:center;"><div style="background:#1e293b;padding:50px;border-radius:14px;"><h2 style="color:#ef4444">🚫 IP bloqueada</h2></div></div>`; setTimeout(() => window.location.href="/Account/Login?ipblocked=true", 2500); }
    });
});
connectionGlobal.on("ConnectionBlocked", msg => {
    if (!isSuperAdmin) {
        document.body.innerHTML = `
            <div style="height:100vh;display:flex;align-items:center;justify-content:center;
                background:#050a14;font-family:'Plus Jakarta Sans',sans-serif;color:white;text-align:center;">
                <div style="background:#1e293b;padding:50px 40px;border-radius:24px;
                    border:1px solid rgba(239,68,68,0.2);max-width:380px;">
                    <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg"
                         style="width:80px;height:80px;border-radius:20px;margin-bottom:20px;
                         border:2px solid rgba(239,68,68,0.4);" />
                    <h2 style="color:#ef4444;margin:0 0 10px;">🔌 Acceso bloqueado</h2>
                    <p style="color:rgba(255,255,255,0.4);font-size:14px;margin:0;">${msg}</p>
                </div>
            </div>`;
        setTimeout(() => window.location.href = "/Account/Login?blocked=true", 3000);
    }
});
connectionGlobal.on("IPBlockedNow", msg => { document.body.innerHTML = `<div style="height:100vh;display:flex;align-items:center;justify-content:center;background:#020617;color:white;font-family:sans-serif;text-align:center;"><div style="background:#1e293b;padding:50px;border-radius:16px;"><h2 style="color:#ef4444">🚫 Acceso bloqueado</h2><p>${msg}</p></div></div>`; setTimeout(() => window.location.href="/Account/Login?ipblocked=true", 2000); });
connectionGlobal.on("UserDeleted", uid => { const myId = '@User.FindFirst("UserId")?.Value'; if (myId == uid) { alert("⚠ Esta cuenta fue eliminada."); setTimeout(() => window.location.href="/Account/Login", 1500); } });
connectionGlobal.on("UserConnectedNotification", u => showToastNotif(u, "● En línea", "", null));
connectionGlobal.on("NewSessionDetected", () => { if (window.location.pathname.toLowerCase().includes("/security")) location.reload(); });
connectionGlobal.on("ForceLogoutSession", token => { const myToken = '@User.FindFirst("SessionToken")?.Value'; if (token === myToken) { document.body.innerHTML = `<div style="height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;font-family:sans-serif;color:white;text-align:center;"><div style="background:#1e293b;padding:50px;border-radius:14px;"><h2 style="color:#f59e0b">⚠ Sesión cerrada</h2></div></div>`; setTimeout(() => window.location.href="/Account/LogoutGet", 2500); } });
connectionGlobal.on("UserOnline", () => {});
connectionGlobal.on("UserOffline", () => {});

// ✅ Notificaciones — una sola vez, con filtro de grupo activo
connectionGlobal.on("ReceiveNotification", (uid, msg, username, img, link) => {
    const activeGroup = sessionStorage.getItem('activeGroupChat');
    if (activeGroup && link && link.includes('/Group/Chat/' + activeGroup)) return;
    showToastNotif(username, msg, img, link);
});

// Polling bloqueo
if (!isSuperAdmin) {
    setInterval(async () => {
        try {
            const r = await fetch("/Account/CheckBlockStatus");
            if (r.status === 403) window.location.href = "/Account/Login?blocked=true";
        } catch {}
    }, 1000);
}

connectionGlobal.start().then(() => {
    const userId = '@(User.Identity.IsAuthenticated ? User.FindFirst("UserId")?.Value : "")';
    if (userId) connectionGlobal.invoke("JoinUserGroup", userId);
}).catch(e => console.error("SignalR global:", e));

function showToastNotif(username, message, userImage, link) {
    const letter = username ? username.charAt(0).toUpperCase() : "?";
    const avatarHTML = (userImage && userImage.trim())
        ? `<img src="${userImage}" style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;" />`
        : `<div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c3aed);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;flex-shrink:0;">${letter}</div>`;

    const card = document.createElement("div");
    card.className = "ht-notif-card";
    card.innerHTML = `${avatarHTML}<div style="flex:1;min-width:0;"><div style="font-weight:700;font-size:13px;color:#f1f5f9;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${username ?? ''}</div><div style="font-size:12px;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${message ?? ''}</div></div><button onclick="event.stopPropagation();this.closest('.ht-notif-card').remove();" style="background:none;border:none;color:#64748b;font-size:15px;cursor:pointer;padding:0;flex-shrink:0;">✕</button>`;

    const bar = document.createElement("div");
    bar.className = "ht-notif-progress";
    card.appendChild(bar);
    if (link) card.addEventListener("click", () => window.location.href = link);

  HabitSounds.notification();
    requestAnimationFrame(() => requestAnimationFrame(() => { card.classList.add("show"); bar.style.width = "0%"; }));
    setTimeout(() => { card.classList.remove("show"); card.classList.add("hide"); setTimeout(() => card.remove(), 400); }, 4000);
}
</script>


<script>
// ══ LOADER ══════════════════════════════
const htLoader = document.getElementById("ht-loader");
const htBar = document.getElementById("ht-loader-bar");
const isChatPage = window.location.pathname.toLowerCase().includes("/message") ||
                   window.location.pathname.toLowerCase().includes("/group/chat");
let loaderProgress = 0;

if (!isChatPage) {
    document.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => { if (!link.hasAttribute("data-no-loader") && htLoader) htLoader.style.display = "flex"; });
    });
    document.querySelectorAll("form").forEach(form => {
        form.addEventListener("submit", () => { if (!form.hasAttribute("data-no-loader") && htLoader) htLoader.style.display = "flex"; });
    });
}

const loaderInterval = setInterval(() => {
    if (loaderProgress < 88) { loaderProgress += Math.random() * 12; if(htBar) htBar.style.width = loaderProgress + "%"; }
}, 200);

window.addEventListener("load", () => {
    if(htBar) htBar.style.width = "100%";
    setTimeout(() => {
        if(htLoader) { htLoader.style.opacity = "0"; htLoader.style.transition = "opacity 0.4s"; }
        setTimeout(() => { if(htLoader) htLoader.style.display = "none"; clearInterval(loaderInterval); }, 400);
    }, 500);
});
window.addEventListener("pageshow", e => { if (e.persisted && htLoader) htLoader.style.display = "none"; });
</script>

<script>
// ══ DARK MODE ════════════════════════════
const body = document.body;
function toggleDarkMode() { body.classList.contains("bg-dark") ? disableDarkMode() : enableDarkMode(); }
function enableDarkMode() { body.classList.remove("bg-light","text-dark"); body.classList.add("bg-dark","text-light"); localStorage.setItem("darkMode","enabled"); }
function disableDarkMode() { body.classList.remove("bg-dark","text-light"); body.classList.add("bg-light","text-dark"); localStorage.setItem("darkMode","disabled"); }
if (localStorage.getItem("darkMode") === "enabled") enableDarkMode();
document.addEventListener("DOMContentLoaded", () => { if (localStorage.getItem("darkMode") === "enabled") enableDarkMode(); 
// Aplicar personalización guardada globalmente
(function(){
    const c = localStorage.getItem('ht_color');
    const f = localStorage.getItem('ht_font');
    const s = localStorage.getItem('ht_size_px');
    if (c) { document.documentElement.style.setProperty('--primary',c); document.documentElement.style.setProperty('--accent',c); }
    if (f) document.body.style.fontFamily = `'${f}',sans-serif`;
    if (s) document.documentElement.style.fontSize = s;
})();

});

// ══ SONIDOS ══════════════════════════
const HabitSounds = {
    enabled: localStorage.getItem('ht_sounds') !== 'false',

    ctx: null,
    getCtx() {
        if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        return this.ctx;
    },

    complete() {
        if (!this.enabled) return;
        const ctx = this.getCtx();
        const t = ctx.currentTime;
        // Tres notas ascendentes — sensación de logro
        [523, 659, 784].forEach((freq, i) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, t + i * 0.12);
            gain.gain.setValueAtTime(0, t + i * 0.12);
            gain.gain.linearRampToValueAtTime(0.18, t + i * 0.12 + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, t + i * 0.12 + 0.25);
            osc.start(t + i * 0.12);
            osc.stop(t + i * 0.12 + 0.3);
        });
    },

    notification() {
        if (!this.enabled) return;
        const ctx = this.getCtx();
        const t = ctx.currentTime;
        // Dos notas suaves — tipo mensaje
        [880, 1100].forEach((freq, i) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, t + i * 0.1);
            gain.gain.setValueAtTime(0, t + i * 0.1);
            gain.gain.linearRampToValueAtTime(0.12, t + i * 0.1 + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, t + i * 0.1 + 0.2);
            osc.start(t + i * 0.1);
            osc.stop(t + i * 0.1 + 0.25);
        });
    },

    toggle() {
        this.enabled = !this.enabled;
        localStorage.setItem('ht_sounds', this.enabled ? 'true' : 'false');
        return this.enabled;
    }
};
</script>

