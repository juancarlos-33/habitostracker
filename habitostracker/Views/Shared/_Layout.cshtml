<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HabitTracker Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --primary: #2563eb;
    --accent: #7c3aed;
    --surface: #ffffff;
    --surface-2: #f8fafc;
    --border: rgba(0,0,0,0.07);
    --text: #111827;
    --text-muted: #6b7280;
    --nav-bg: rgba(255,255,255,0.92);
    --sidebar-bg: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    --shadow: 0 8px 32px rgba(0,0,0,0.08);
    --bottom-nav-bg: rgba(255,255,255,0.96);
}
body.bg-dark {
    --surface: #0f172a; --surface-2: #1e293b;
    --border: rgba(255,255,255,0.07); --text: #f1f5f9;
    --text-muted: #64748b; --nav-bg: rgba(15,23,42,0.95);
    --bottom-nav-bg: rgba(15,23,42,0.97);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    transition: background 0.3s, color 0.3s;
    background: var(--surface-2); color: var(--text);
    padding-bottom: 70px; /* espacio para bottom nav móvil */
}
@@media (min-width: 769px) { body { padding-bottom: 0; } }

/* ══════════════════════════════════
   NAVBAR TOP
══════════════════════════════════ */
.ht-navbar {
    position: sticky; top: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 20px; margin: 10px 12px; border-radius: 18px;
    background: var(--nav-bg); backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border); box-shadow: var(--shadow);
    transition: all 0.3s;
}
.ht-nav-left { display: flex; align-items: center; gap: 10px; }
.ht-nav-right { display: flex; align-items: center; gap: 6px; }
.ht-brand {
    font-size: 17px; font-weight: 800; letter-spacing: -0.3px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    text-decoration: none;
}

/* ── ICON BTNS ── */
.ht-icon-btn {
    width: 36px; height: 36px; border-radius: 10px;
    border: none; background: transparent; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; transition: 0.15s; color: var(--text); position: relative;
    text-decoration: none;
}
.ht-icon-btn:hover { background: rgba(99,102,241,0.1); transform: scale(1.05); }
.ht-icon-btn .notif-dot {
    position: absolute; top: 4px; right: 4px;
    width: 8px; height: 8px; border-radius: 50%;
    background: #ef4444; border: 2px solid var(--nav-bg);
    animation: pulseDot 2s infinite;
}
@@keyframes pulseDot { 0%,100%{transform:scale(1);} 50%{transform:scale(1.3);} }

/* ── AVATAR ── */
.ht-avatar-btn { background: none; border: none; padding: 0; cursor: pointer; flex-shrink: 0; }
.ht-avatar-img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(99,102,241,0.4); transition: 0.2s; }
.ht-avatar-letter {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white; display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 800; border: 2px solid rgba(99,102,241,0.4); transition: 0.2s;
}
.ht-avatar-btn:hover .ht-avatar-img,
.ht-avatar-btn:hover .ht-avatar-letter { transform: scale(1.05); box-shadow: 0 0 0 3px rgba(99,102,241,0.3); }

/* ══════════════════════════════════
   DROPDOWN
══════════════════════════════════ */
.ht-dropdown { position: relative; }
.ht-dropdown-menu {
    position: absolute; top: calc(100% + 10px); right: 0;
    min-width: 280px; background: var(--surface);
    border: 1px solid var(--border); border-radius: 20px; padding: 8px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.15);
    opacity: 0; transform: translateY(-8px) scale(0.97);
    pointer-events: none; transition: opacity 0.18s, transform 0.18s; z-index: 9999;
}
.ht-dropdown.open .ht-dropdown-menu { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }
.ht-dropdown-header {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px 12px; border-bottom: 1px solid var(--border); margin-bottom: 6px;
}
.ht-dh-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid var(--border); }
.ht-dh-letter {
    width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white; display: flex; align-items: center; justify-content: center;
    font-size: 17px; font-weight: 800;
}
.ht-dh-name { font-weight: 700; font-size: 14px; color: var(--text); }
.ht-dh-role { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
.ht-menu-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; border-radius: 12px;
    font-size: 13px; font-weight: 600; color: var(--text);
    text-decoration: none; transition: 0.15s;
    width: 100%; border: none; background: transparent; cursor: pointer; text-align: left;
}
.ht-menu-item:hover { background: rgba(99,102,241,0.08); color: var(--primary); }
.ht-menu-item.danger { color: #ef4444; }
.ht-menu-item.danger:hover { background: rgba(239,68,68,0.08); }
.ht-menu-item .mi-icon { font-size: 16px; flex-shrink: 0; width: 22px; text-align: center; }
.ht-menu-item .mi-badge {
    margin-left: auto; background: #ef4444; color: white;
    font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 20px;
}
.ht-menu-item .mi-badge.green { background: #22c55e; }
.ht-menu-divider { height: 1px; background: var(--border); margin: 6px 8px; }

/* ══════════════════════════════════
   SIDEBAR (desktop)
══════════════════════════════════ */
.ht-sidebar {
    width: 250px; height: 100vh;
    background: var(--sidebar-bg); padding: 24px 14px;
    position: fixed; left: -270px; top: 0;
    display: flex; flex-direction: column; gap: 4px;
    transition: left 0.3s cubic-bezier(0.34,1.56,0.64,1);
    z-index: 9999; overflow-y: auto;
}
.ht-sidebar.show { left: 0; }
.ht-sidebar::-webkit-scrollbar { width: 4px; }
.ht-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.25); border-radius: 10px; }
.ht-sidebar::-webkit-scrollbar-track { background: transparent; }
.ht-sidebar-logo {
    font-size: 16px; font-weight: 800; color: white;
    padding: 12px 14px; border-radius: 14px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    box-shadow: 0 4px 20px rgba(37,99,235,0.4);
    margin-bottom: 16px; text-align: center; letter-spacing: -0.3px;
}
.ht-sidebar-section {
    font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.3);
    text-transform: uppercase; letter-spacing: 1px; padding: 8px 14px 4px;
}
.ht-sidebar-link {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; border-radius: 12px;
    color: rgba(255,255,255,0.65); text-decoration: none;
    font-size: 13px; font-weight: 600; transition: all 0.15s; position: relative;
}
.ht-sidebar-link:hover { background: rgba(255,255,255,0.08); color: white; transform: translateX(4px); }
.ht-sidebar-link.active {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white; box-shadow: 0 4px 14px rgba(37,99,235,0.35);
}
.ht-sidebar-link .sl-icon { font-size: 16px; width: 20px; text-align: center; flex-shrink: 0; }
.ht-sidebar-link .sl-badge {
    margin-left: auto; background: #ef4444; color: white;
    font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 20px;
}
.ht-sidebar-link .sl-badge.green { background: #22c55e; }

/* ══════════════════════════════════
   BOTTOM NAV (móvil — como Instagram)
══════════════════════════════════ */
.ht-bottom-nav {
    display: none;
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000;
    background: var(--bottom-nav-bg);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid var(--border);
    padding: 8px 0 env(safe-area-inset-bottom, 8px);
    box-shadow: 0 -8px 32px rgba(0,0,0,0.08);
}
@@media (max-width: 768px) {
    .ht-bottom-nav { display: flex; }
}
.ht-bottom-nav-inner {
    display: flex; align-items: center; justify-content: space-around;
    width: 100%; max-width: 560px; margin: 0 auto; padding: 0 8px;
}
.ht-bn-item {
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    padding: 6px 12px; border-radius: 14px; text-decoration: none;
    color: var(--text-muted); font-size: 10px; font-weight: 700;
    transition: 0.2s; position: relative; min-width: 52px;
    border: none; background: transparent; cursor: pointer; font-family: inherit;
}
.ht-bn-item:hover { color: var(--primary); }
.ht-bn-item.active { color: var(--primary); }
.ht-bn-icon { font-size: 22px; line-height: 1; }
.ht-bn-label { font-size: 10px; font-weight: 700; letter-spacing: 0.3px; }
.ht-bn-badge {
    position: absolute; top: 2px; right: 6px;
    background: #ef4444; color: white;
    font-size: 9px; font-weight: 800; padding: 1px 5px;
    border-radius: 20px; border: 2px solid var(--bottom-nav-bg);
    min-width: 16px; text-align: center;
}
/* indicador activo */
.ht-bn-item.active::after {
    content:""; position:absolute; bottom:-8px; left:50%;
    transform:translateX(-50%);
    width:20px; height:3px; border-radius:10px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
}
/* botón central (crear/compartir) */
.ht-bn-center {
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; box-shadow: 0 6px 20px rgba(99,102,241,0.45);
    border: none; cursor: pointer; transition: 0.2s; text-decoration: none;
    margin-top: -8px;
}
.ht-bn-center:hover { transform: scale(1.1); box-shadow: 0 8px 24px rgba(99,102,241,0.6); }

/* ══════════════════════════════════
   OVERLAY
══════════════════════════════════ */
#ht-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.4);
    backdrop-filter: blur(3px); opacity: 0; visibility: hidden;
    transition: 0.3s; z-index: 9998;
}
#ht-overlay.show { opacity: 1; visibility: visible; }

/* ══════════════════════════════════
   LOADER
══════════════════════════════════ */
#ht-loader {
    position: fixed; inset: 0; z-index: 99999;
    display: none; flex-direction: column;
    align-items: center; justify-content: center;
    background: rgba(0,0,0,0.08); backdrop-filter: blur(8px);
    animation: fadeIn 0.2s ease;
}
@@keyframes fadeIn { from{opacity:0;} to{opacity:1;} }
@@keyframes bounce { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-12px);} }
@@keyframes fadeText { 0%,100%{opacity:0.4;} 50%{opacity:1;} }
.ht-loader-gif { width: 160px; height: 160px; animation: bounce 1.4s infinite; filter: drop-shadow(0 8px 20px rgba(0,0,0,0.2)); }
.ht-loader-text { margin-top: 12px; font-size: 13px; font-weight: 600; color: white; animation: fadeText 1.4s infinite; }
.ht-loader-bar-wrap { width: 180px; height: 4px; background: rgba(255,255,255,0.2); border-radius: 10px; margin-top: 10px; overflow: hidden; }
.ht-loader-bar { height: 100%; background: linear-gradient(90deg, #4ade80, #22c55e); border-radius: 10px; transition: width 0.2s; width: 0%; }

/* ══════════════════════════════════
   NOTIF TOASTS
══════════════════════════════════ */
#ht-notifs {
    position: fixed; top: 76px; right: 16px; z-index: 999999;
    display: flex; flex-direction: column; gap: 10px;
    pointer-events: none; max-width: 340px; width: calc(100vw - 32px);
}
.ht-notif-card {
    background: rgba(15,23,42,0.96); backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.08); border-radius: 18px;
    padding: 14px 16px; display: flex; align-items: center; gap: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4); cursor: pointer; pointer-events: all;
    transform: translateX(120%); transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s;
    opacity: 0; position: relative; overflow: hidden;
}
.ht-notif-card.show { transform: translateX(0); opacity: 1; }
.ht-notif-card.hide { transform: translateX(120%); opacity: 0; }
.ht-notif-progress {
    position: absolute; bottom: 0; left: 0; height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 0 0 18px 18px; width: 100%; transition: width 4s linear;
}

/* ══════════════════════════════════
   CONTENT
══════════════════════════════════ */
.ht-content { padding: 0 20px; min-height: 100vh; }
@@media (max-width: 768px) { .ht-content { padding: 16px 14px; } }

/* ══════════════════════════════════
   DARK MODE
══════════════════════════════════ */
body.bg-dark .ht-navbar,
body.bg-dark .ht-bottom-nav { background: var(--nav-bg); border-color: var(--border); }
body.bg-dark .ht-dropdown-menu { background: #0f172a; border-color: rgba(255,255,255,0.08); }
body.bg-dark .ht-menu-item:hover { background: rgba(99,102,241,0.12); }
body.bg-dark .ht-menu-divider { background: rgba(255,255,255,0.07); }
body.bg-dark .ht-dropdown-header { border-color: rgba(255,255,255,0.07); }
body.bg-dark { color: #e4e6eb; }
body.bg-dark h1,body.bg-dark h2,body.bg-dark h3,body.bg-dark h4,body.bg-dark h5 { color: #fff; }
body.bg-dark label { color: #ccc !important; }
body.bg-dark input,body.bg-dark textarea,body.bg-dark select { background-color: #1e1e1e !important; color: #fff !important; border: 1px solid #444 !important; }
body.bg-dark ::placeholder { color: #bbb !important; }
body.bg-dark table { color: #fff; }
body.bg-dark th { background-color: #2a2a2a; color: #fff; }
body.bg-dark .card,body.bg-dark .shadow-sm { background-color: #1e1e2e !important; color: #fff !important; border: 1px solid #2d2d3d !important; }
body.bg-dark .modal-content { background-color: #1f1f2e; color: white; }
body.bg-dark .post-card { background-color: #1e1e1e !important; color: #fff !important; border: 1px solid #333; }
body.bg-dark .notification-card { background: #1e293b !important; color: #fff !important; }
body.bg-dark .notification-card:hover { background: #334155 !important; }
body.bg-dark .notification-message { color: #f1f5f9 !important; }
body.bg-dark .notification-time { color: #94a3b8 !important; }
body.bg-dark .dropdown-menu { background-color: #1e1e1e; border: 1px solid #333; }
body.bg-dark .dropdown-menu a { color: #fff !important; }
body.bg-dark .sec-card,body.bg-dark .help-card,body.bg-dark .guest-container { background: #1e1e1e !important; color: #fff !important; border: 1px solid #333 !important; }
body.bg-dark .table { color: white !important; }
body.bg-dark .table thead { background-color: #2a2a3d !important; }
body.bg-dark .ht-bn-item { color: #475569; }
body.bg-dark .ht-bn-item.active { color: #818cf8; }
body.bg-dark .modal-content .text-muted { color: #94a3b8 !important; }
body.bg-dark .modal-content .btn-outline-secondary { border-color: #475569; color: #94a3b8; }

/* ══════════════════════════════════
   MODAL
══════════════════════════════════ */
.modal-content { border-radius: 20px !important; }
body.bg-dark .modal-content { background: #1e293b !important; color: #f1f5f9 !important; border: 1px solid rgba(255,255,255,0.08) !important; }
</style>
</head>

<body>

<div id="ht-overlay"></div>

<!-- SIDEBAR -->
<div class="ht-sidebar" id="ht-sidebar">
    <div class="ht-sidebar-logo">🚀 HabitTracker Pro</div>

<div class="ht-sidebar-section">Principal</div>
<a class="ht-sidebar-link" asp-controller="Habit" asp-action="Index">
    <span class="sl-icon">🏠</span> Inicio
</a>
<a class="ht-sidebar-link" asp-controller="Habit" asp-action="History">
    <span class="sl-icon">📅</span> Historial
</a>
<a class="ht-sidebar-link" asp-controller="Habit" asp-action="Calendar">
    <span class="sl-icon">📅</span> Calendario
</a>
<a class="ht-sidebar-link guest-block" asp-controller="Habit" asp-action="Community">
    <span class="sl-icon">🌍</span> Comunidad
</a>
<a class="ht-sidebar-link guest-block" asp-controller="Habit" asp-action="Statistics">
    <span class="sl-icon">📈</span> Estadísticas
</a>
<a class="ht-sidebar-link guest-block" asp-controller="Habit" asp-action="ExportHistory">
    <span class="sl-icon">📤</span> Exportar historial
</a>
<a class="ht-sidebar-link guest-block" asp-controller="Habit" asp-action="Achievements">
    <span class="sl-icon">🏆</span> Logros
</a>

    <div class="ht-sidebar-section">Social</div>
    <a class="ht-sidebar-link guest-block" asp-controller="Post" asp-action="Index">
        <span class="sl-icon">📸</span> Publicaciones
    </a>
    <a class="ht-sidebar-link guest-block" asp-controller="User" asp-action="Index">
        <span class="sl-icon">👥</span> Amigos
    </a>
    <a class="ht-sidebar-link guest-block" asp-controller="User" asp-action="FriendRequests">
        <span class="sl-icon">📩</span> Solicitudes
    </a>
    <a class="ht-sidebar-link guest-block" asp-controller="Message" asp-action="Inbox" id="sidebar-msg-link">
        <span class="sl-icon">💬</span> Mensajes
        <span class="sl-badge" id="sidebar-msg-badge" style="display:none;"></span>
    </a>
    <a class="ht-sidebar-link guest-block" asp-controller="Post" asp-action="SavedPosts">
        <span class="sl-icon">🔖</span> Guardados
    </a>
    <a class="ht-sidebar-link guest-block" asp-controller="Group" asp-action="Index">
        <span class="sl-icon">👥</span> Grupos
    </a>

    <div class="ht-sidebar-section">Más</div>
    <a class="ht-sidebar-link guest-block" asp-controller="Support" asp-action="Chat">
        <span class="sl-icon">😔</span> Me siento mal
    </a>
    <a class="ht-sidebar-link guest-block" asp-controller="Account" asp-action="Security">
        <span class="sl-icon">🔐</span> Seguridad
    </a>
    <a class="ht-sidebar-link guest-block" asp-controller="Help" asp-action="Index">
        <span class="sl-icon">🆘</span> Mesa de ayuda
    </a>

    @if (User.IsInRole("SuperAdmin"))
    {
        <div class="ht-sidebar-section">Admin</div>
        <a class="ht-sidebar-link" asp-controller="Admin" asp-action="Index">
            <span class="sl-icon">🛡️</span> Centro de Seguridad
        </a>
        <a class="ht-sidebar-link" asp-controller="Admin" asp-action="Payments">
            <span class="sl-icon">💰</span> Pagos Premium
        </a>
    }
    <div style="text-align:center;padding:8px 0;color:rgba(255,255,255,0.2);font-size:11px;font-weight:600;letter-spacing:0.5px;flex-shrink:0;">
    ↕ desliza para ver más
</div>
</div>

<!-- NOTIFICACIONES -->
<div id="ht-notifs"></div>

<!-- LOADER -->
<div id="ht-loader">
    <img src="https://media.tenor.com/N5fU8iyU9F4AAAAj/shigure-ui-dance.gif" class="ht-loader-gif" />
    <span class="ht-loader-text">Cargando...</span>
    <div class="ht-loader-bar-wrap"><div class="ht-loader-bar" id="ht-loader-bar"></div></div>
</div>

<!-- NAVBAR TOP -->
@if (User.Identity.IsAuthenticated && Context.Request.Query["blocked"] != "true")
{
    var navUserName = User.Identity.Name ?? "U";
    var navFirstLetter = navUserName.Substring(0, 1).ToUpper();
    var navProfileImage = User.FindFirst("ProfileImage")?.Value;
    if (string.IsNullOrEmpty(navProfileImage))
        navProfileImage = User.FindFirst("ProfilePicture")?.Value;
    var navRole = User.IsInRole("SuperAdmin") ? "👑 SuperAdmin" :
                  User.IsInRole("Admin") ? "🛡️ Admin" :
                  User.IsInRole("Guest") ? "👤 Invitado" : "✨ Usuario";

    <nav class="ht-navbar">
        <div class="ht-nav-left">
            <button class="ht-icon-btn" data-no-loader onclick="toggleSidebar()" title="Menú">☰</button>
        </div>

        <a class="ht-brand" asp-controller="Habit" asp-action="Index">🚀 HabitTracker</a>

        <div class="ht-nav-right">
            <button onclick="toggleDarkMode()" data-no-loader class="ht-icon-btn" title="Tema">🌙</button>

            <!-- Comunidad -->
         

            <!-- Solicitudes de mensaje -->
            <a href="/Message/Inbox" class="ht-icon-btn guest-block" title="Mensajes"
               id="msgReqNavBtn" style="display:none; position:relative;">
                💬
                <span class="notif-dot" id="msgReqDot"></span>
            </a>

            <!-- Dropdown usuario -->
            <div class="ht-dropdown" id="ht-user-dropdown">
                <button class="ht-avatar-btn" data-no-loader onclick="toggleUserDropdown()" type="button">
                    @if (!string.IsNullOrWhiteSpace(navProfileImage))
                    { <img src="@navProfileImage" class="ht-avatar-img" /> }
                    else
                    { <div class="ht-avatar-letter">@navFirstLetter</div> }
                </button>

                <div class="ht-dropdown-menu" id="ht-user-menu">
                    <div class="ht-dropdown-header">
                        @if (!string.IsNullOrWhiteSpace(navProfileImage))
                        { <img src="@navProfileImage" class="ht-dh-avatar" /> }
