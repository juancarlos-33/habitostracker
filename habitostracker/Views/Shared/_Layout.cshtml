<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HabitTracker Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --accent: #7c3aed;
    --surface: #ffffff;
    --surface-2: #f8fafc;
    --border: rgba(0,0,0,0.07);
    --text: #111827;
    --text-muted: #6b7280;
    --nav-bg: rgba(255,255,255,0.88);
    --sidebar-bg: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    --radius: 16px;
    --shadow: 0 8px 32px rgba(0,0,0,0.08);
}

body.bg-dark {
    --surface: #0f172a;
    --surface-2: #1e293b;
    --border: rgba(255,255,255,0.07);
    --text: #f1f5f9;
    --text-muted: #64748b;
    --nav-bg: rgba(15,23,42,0.92);
}

* { box-sizing: border-box; }
body { font-family: 'Plus Jakarta Sans', sans-serif; transition: background 0.3s, color 0.3s; background: var(--surface-2); color: var(--text); }

/* ── NAVBAR ─────────────────────────────── */
.ht-navbar {
    position: sticky; top: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 20px;
    margin: 10px 12px;
    border-radius: 18px;
    background: var(--nav-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: background 0.3s, border 0.3s;
}

.ht-nav-left { display: flex; align-items: center; gap: 10px; }
.ht-nav-center { position: absolute; left: 50%; transform: translateX(-50%); }
.ht-nav-right { display: flex; align-items: center; gap: 8px; }

.ht-brand {
    font-size: 17px; font-weight: 800; letter-spacing: -0.3px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    text-decoration: none;
}

/* ── AVATAR ─────────────────────────────── */
.ht-avatar-btn { background: none; border: none; padding: 0; cursor: pointer; flex-shrink: 0; position: relative; }
.ht-avatar-img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(99,102,241,0.4); transition: 0.2s; }
.ht-avatar-letter {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white; display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 800; border: 2px solid rgba(99,102,241,0.4);
    transition: 0.2s;
}
.ht-avatar-btn:hover .ht-avatar-img,
.ht-avatar-btn:hover .ht-avatar-letter { transform: scale(1.05); box-shadow: 0 0 0 3px rgba(99,102,241,0.3); }

/* ── ICON BTNS ──────────────────────────── */
.ht-icon-btn {
    width: 36px; height: 36px; border-radius: 10px;
    border: none; background: transparent; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; transition: 0.15s; color: var(--text);
    position: relative;
}
.ht-icon-btn:hover { background: rgba(99,102,241,0.1); transform: scale(1.05); }
.ht-icon-btn .notif-dot {
    position: absolute; top: 4px; right: 4px;
    width: 8px; height: 8px; border-radius: 50%;
    background: #ef4444; border: 2px solid var(--nav-bg);
    animation: pulseDot 2s infinite;
}
@@keyframes pulseDot { 0%,100%{transform:scale(1);} 50%{transform:scale(1.3);} }

/* ── DROPDOWN ───────────────────────────── */
.ht-dropdown { position: relative; }
.ht-dropdown-menu {
    position: absolute; top: calc(100% + 10px); right: 0;
    min-width: 260px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 8px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    opacity: 0; transform: translateY(-8px) scale(0.97);
    pointer-events: none;
    transition: opacity 0.18s, transform 0.18s;
    z-index: 9999;
}
.ht-dropdown.open .ht-dropdown-menu { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }

.ht-dropdown-header {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px 10px; border-bottom: 1px solid var(--border); margin-bottom: 6px;
}
.ht-dh-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid var(--border); }
.ht-dh-letter {
    width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white; display: flex; align-items: center; justify-content: center;
    font-size: 17px; font-weight: 800;
}
.ht-dh-name { font-weight: 700; font-size: 14px; color: var(--text); }
.ht-dh-role { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

.ht-menu-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; border-radius: 12px;
    font-size: 13px; font-weight: 600; color: var(--text);
    text-decoration: none; transition: 0.15s;
    width: 100%; border: none; background: transparent; cursor: pointer; text-align: left;
}
.ht-menu-item:hover { background: rgba(99,102,241,0.08); color: var(--primary); }
.ht-menu-item.danger { color: #ef4444; }
.ht-menu-item.danger:hover { background: rgba(239,68,68,0.08); }
.ht-menu-item .mi-icon { font-size: 16px; flex-shrink: 0; width: 22px; text-align: center; }
.ht-menu-item .mi-badge {
    margin-left: auto; background: #ef4444; color: white;
    font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 20px;
}
.ht-menu-divider { height: 1px; background: var(--border); margin: 6px 8px; }

/* ── SIDEBAR ────────────────────────────── */
.ht-sidebar {
    width: 250px; height: 100vh;
    background: var(--sidebar-bg);
    padding: 24px 14px;
    position: fixed; left: -270px; top: 0;
    display: flex; flex-direction: column; gap: 4px;
    transition: left 0.3s cubic-bezier(0.34,1.56,0.64,1);
    z-index: 9999; overflow-y: auto;
}
.ht-sidebar.show { left: 0; }

.ht-sidebar-logo {
    font-size: 16px; font-weight: 800; color: white;
    padding: 12px 14px; border-radius: 14px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    box-shadow: 0 4px 20px rgba(37,99,235,0.4);
    margin-bottom: 16px; text-align: center;
    letter-spacing: -0.3px;
}

.ht-sidebar-section {
    font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.3);
    text-transform: uppercase; letter-spacing: 1px;
    padding: 8px 14px 4px;
}

.ht-sidebar-link {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; border-radius: 12px;
    color: rgba(255,255,255,0.65); text-decoration: none;
    font-size: 13px; font-weight: 600;
    transition: all 0.15s;
}
.ht-sidebar-link:hover {
    background: rgba(255,255,255,0.08);
    color: white; transform: translateX(4px);
}
.ht-sidebar-link.active {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white; box-shadow: 0 4px 14px rgba(37,99,235,0.35);
}
.ht-sidebar-link .sl-icon { font-size: 16px; width: 20px; text-align: center; flex-shrink: 0; }

/* ── OVERLAY ────────────────────────────── */
#ht-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.4); backdrop-filter: blur(3px);
    opacity: 0; visibility: hidden; transition: 0.3s; z-index: 9998;
}
#ht-overlay.show { opacity: 1; visibility: visible; }

/* ── LOADER ─────────────────────────────── */
#ht-loader {
    position: fixed; inset: 0; z-index: 99999;
    display: none; flex-direction: column;
    align-items: center; justify-content: center;
    background: rgba(0,0,0,0.08); backdrop-filter: blur(8px);
    animation: fadeIn 0.2s ease;
}
@@keyframes fadeIn { from{opacity:0;} to{opacity:1;} }
@@keyframes bounce { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-12px);} }
@@keyframes fadeText { 0%,100%{opacity:0.4;} 50%{opacity:1;} }

.ht-loader-gif { width: 160px; height: 160px; animation: bounce 1.4s infinite; filter: drop-shadow(0 8px 20px rgba(0,0,0,0.2)); }
.ht-loader-text { margin-top: 12px; font-size: 13px; font-weight: 600; color: white; animation: fadeText 1.4s infinite; }
.ht-loader-bar-wrap { width: 180px; height: 4px; background: rgba(255,255,255,0.2); border-radius: 10px; margin-top: 10px; overflow: hidden; }
.ht-loader-bar { height: 100%; background: linear-gradient(90deg, #4ade80, #22c55e); border-radius: 10px; transition: width 0.2s; width: 0%; }

/* ── NOTIF CONTAINER ────────────────────── */
#ht-notifs { position: fixed; top: 76px; right: 16px; z-index: 999999; display: flex; flex-direction: column; gap: 10px; pointer-events: none; max-width: 340px; width: calc(100vw - 32px); }

/* ── CONTENT ────────────────────────────── */
.ht-content { padding: 24px 20px; min-height: 100vh; }

/* ── DARK MODE ──────────────────────────── */
body.bg-dark .ht-navbar { background: var(--nav-bg); border-color: var(--border); }
body.bg-dark .ht-dropdown-menu { background: #0f172a; border-color: rgba(255,255,255,0.08); }
body.bg-dark .ht-menu-item:hover { background: rgba(99,102,241,0.12); }
body.bg-dark .ht-menu-divider { background: rgba(255,255,255,0.07); }
body.bg-dark .ht-dropdown-header { border-color: rgba(255,255,255,0.07); }

/* legacy compat */
body.bg-dark { color: #e4e6eb; }
body.bg-dark h1,body.bg-dark h2,body.bg-dark h3,body.bg-dark h4,body.bg-dark h5 { color: #fff; }
body.bg-dark label { color: #ccc !important; }
body.bg-dark input,body.bg-dark textarea,body.bg-dark select { background-color: #1e1e1e !important; color: #fff !important; border: 1px solid #444 !important; }
body.bg-dark ::placeholder { color: #bbb !important; }
body.bg-dark table { color: #fff; }
body.bg-dark th { background-color: #2a2a2a; color: #fff; }
body.bg-dark .card,body.bg-dark .shadow-sm { background-color: #1e1e2e !important; color: #fff !important; border: 1px solid #2d2d3d !important; }
body.bg-dark .modal-content { background-color: #1f1f2e; color: white; }
body.bg-dark .post-card { background-color: #1e1e1e !important; color: #fff !important; border: 1px solid #333; }
body.bg-dark .notification-card { background: #1e293b !important; color: #fff !important; }
body.bg-dark .notification-card:hover { background: #334155 !important; }
body.bg-dark .notification-message { color: #f1f5f9 !important; }
body.bg-dark .notification-time { color: #94a3b8 !important; }
body.bg-dark .dropdown-menu { background-color: #1e1e1e; border: 1px solid #333; }
body.bg-dark .dropdown-menu a { color: #fff !important; }
body.bg-dark .sec-card { background: #1e1e1e !important; color: #fff !important; border: 1px solid #333; }
body.bg-dark .help-card { background-color: #1e1e1e !important; color: #fff !important; border: 1px solid #333; }
body.bg-dark .guest-container { background-color: #1e1e1e !important; color: #fff !important; border: 1px solid #333; }
body.bg-dark .table { color: white !important; }
body.bg-dark .table thead { background-color: #2a2a3d !important; }

/* ── TOAST NOTIF ────────────────────────── */
.ht-notif-card {
    background: rgba(15,23,42,0.94);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px; padding: 14px 16px;
    display: flex; align-items: center; gap: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    cursor: pointer; pointer-events: all;
    transform: translateX(120%);
    transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s;
    opacity: 0; position: relative; overflow: hidden;
}
.ht-notif-card.show { transform: translateX(0); opacity: 1; }
.ht-notif-card.hide { transform: translateX(120%); opacity: 0; }
.ht-notif-progress {
    position: absolute; bottom: 0; left: 0; height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 0 0 18px 18px; width: 100%;
    transition: width 4s linear;
}

@@keyframes spin { 0%{transform:rotate(0deg);} 100%{transform:rotate(360deg);} }

/* ── MOBILE ─────────────────────────────── */
@@media (max-width: 768px) {
    .ht-content { padding: 16px 14px; }
    .ht-navbar { margin: 8px; padding: 8px 14px; }
}

/* ── MODAL ──────────────────────────────── */
.modal-content { border-radius: 20px !important; }
body.bg-dark .modal-content { background: #1e293b !important; color: #f1f5f9 !important; border: 1px solid rgba(255,255,255,0.08) !important; }
body.bg-dark .modal-content .text-muted { color: #94a3b8 !important; }
body.bg-dark .modal-content .btn-outline-secondary { border-color: #475569; color: #94a3b8; }
body.bg-dark .modal-content .btn-outline-secondary:hover { background: #334155; color: #f1f5f9; }
</style>
</head>

<body>

<div id="ht-overlay"></div>

<!-- SIDEBAR -->
<div class="ht-sidebar" id="ht-sidebar">
    <div class="ht-sidebar-logo">🚀 HabitTracker Pro</div>

    <div class="ht-sidebar-section">Principal</div>
    <a class="ht-sidebar-link" asp-controller="Habit" asp-action="Index"><span class="sl-icon">🏠</span> Inicio</a>
    <a class="ht-sidebar-link" asp-controller="Habit" asp-action="History"><span class="sl-icon">📊</span> Historial</a>
    <a class="ht-sidebar-link" asp-controller="Habit" asp-action="Calendar"><span class="sl-icon">📅</span> Calendario</a>

    <div class="ht-sidebar-section">Social</div>
    <a class="ht-sidebar-link guest-block" asp-controller="Post" asp-action="Index"><span class="sl-icon">📸</span> Publicaciones</a>
    <a class="ht-sidebar-link guest-block" asp-controller="User" asp-action="Index"><span class="sl-icon">👥</span> Amigos</a>
    <a class="ht-sidebar-link guest-block" asp-controller="User" asp-action="FriendRequests"><span class="sl-icon">📩</span> Solicitudes</a>
    <a class="ht-sidebar-link guest-block" asp-controller="Post" asp-action="SavedPosts"><span class="sl-icon">🔖</span> Guardados</a>

    <div class="ht-sidebar-section">Más</div>
    <a class="ht-sidebar-link guest-block" asp-controller="Support" asp-action="Chat"><span class="sl-icon">😔</span> Me siento mal</a>
    <a class="ht-sidebar-link guest-block" asp-controller="Account" asp-action="Security"><span class="sl-icon">🔐</span> Seguridad</a>
    <a class="ht-sidebar-link guest-block" asp-controller="Help" asp-action="Index"><span class="sl-icon">🆘</span> Mesa de ayuda</a>

    @if (User.IsInRole("SuperAdmin"))
    {
        <div class="ht-sidebar-section">Admin</div>
        <a class="ht-sidebar-link" asp-controller="Admin" asp-action="Index"><span class="sl-icon">🛡️</span> Centro de Seguridad</a>
        <a class="ht-sidebar-link" asp-controller="Admin" asp-action="Payments"><span class="sl-icon">💰</span> Pagos Premium</a>
    }
</div>

<!-- NOTIFICACIONES -->
<div id="ht-notifs"></div>

<!-- LOADER -->
<div id="ht-loader">
    <img src="https://media.tenor.com/N5fU8iyU9F4AAAAj/shigure-ui-dance.gif" class="ht-loader-gif" />
    <span class="ht-loader-text">Cargando...</span>
    <div class="ht-loader-bar-wrap"><div class="ht-loader-bar" id="ht-loader-bar"></div></div>
</div>

<!-- NAVBAR -->
@if (User.Identity.IsAuthenticated && Context.Request.Query["blocked"] != "true")
{
    var navUserName = User.Identity.Name ?? "U";
    var navFirstLetter = navUserName.Substring(0, 1).ToUpper();
    var navProfileImage = User.FindFirst("ProfileImage")?.Value;
    if (string.IsNullOrEmpty(navProfileImage))
        navProfileImage = User.FindFirst("ProfilePicture")?.Value;
    var navRole = User.IsInRole("SuperAdmin") ? "👑 SuperAdmin" :
                  User.IsInRole("Admin") ? "🛡️ Admin" :
                  User.IsInRole("Guest") ? "👤 Invitado" : "✨ Usuario";


    <nav class="ht-navbar">
        <!-- IZQUIERDA -->
        <div class="ht-nav-left">
            <button class="ht-icon-btn" data-no-loader onclick="toggleSidebar()" title="Menú">☰</button>
        </div>

        <!-- CENTRO -->
        <a class="ht-brand" asp-controller="Habit" asp-action="Index">🚀 HabitTracker</a>

        <!-- DERECHA -->
        <div class="ht-nav-right">
            <button onclick="toggleDarkMode()" data-no-loader class="ht-icon-btn" title="Tema">🌙</button>

            <!-- Dropdown usuario -->
            <div class="ht-dropdown" id="ht-user-dropdown">
                <button class="ht-avatar-btn" data-no-loader onclick="toggleUserDropdown()" type="button">
                    @if (!string.IsNullOrWhiteSpace(navProfileImage))
                    { <img src="@navProfileImage" class="ht-avatar-img" /> }
                    else
                    { <div class="ht-avatar-letter">@navFirstLetter</div> }
                </button>

                <div class="ht-dropdown-menu" id="ht-user-menu">
                    <!-- Header -->
                    <div class="ht-dropdown-header">
                        @if (!string.IsNullOrWhiteSpace(navProfileImage))
                        { <img src="@navProfileImage" class="ht-dh-avatar" /> }
                        else
                        { <div class="ht-dh-letter">@navFirstLetter</div> }
                        <div>
                            <div class="ht-dh-name">@navUserName</div>
                            <div class="ht-dh-role">@navRole</div>
                        </div>
                    </div>

                    <!-- Items -->
                    <a class="ht-menu-item guest-block" asp-controller="Account" asp-action="Profile">
                        <span class="mi-icon">👤</span><span>Mi Perfil</span>
                    </a>
                    <a class="ht-menu-item guest-block" asp-controller="Notification" asp-action="Index">
                        <span class="mi-icon">🔔</span><span>Notificaciones</span>
                        <span class="mi-badge-wrap">@await Component.InvokeAsync("NotificationCount")</span>
                    </a>
                    <a class="ht-menu-item guest-block" asp-controller="Message" asp-action="Inbox">
                        <span class="mi-icon">📨</span><span>Mensajes</span>
                        @if (ViewBag.NewMessages != null && (int)ViewBag.NewMessages > 0)
                        { <span class="mi-badge">@ViewBag.NewMessages</span> }
                    </a>
                    <a class="ht-menu-item guest-block" asp-controller="Habit" asp-action="Achievements">
                        <span class="mi-icon">🏆</span><span>Logros</span>
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <div class="ht-menu-divider"></div>
                        <a class="ht-menu-item" asp-controller="Admin" asp-action="Index">
                            <span class="mi-icon">👑</span><span>Panel Admin</span>
                        </a>
                    }
                    <div class="ht-menu-divider"></div>
                    <button class="ht-menu-item danger" data-bs-toggle="modal" data-bs-target="#logoutModal" data-no-loader>
                        <span class="mi-icon">🚪</span><span>Cerrar sesión</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>
}

<!-- CONTENIDO -->
<div class="ht-content">
    @RenderBody()
</div>

<!-- MODAL LOGOUT -->
<div class="modal fade" id="logoutModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-5">
                <div style="font-size:48px;margin-bottom:12px;">🚪</div>
                <h5 class="fw-bold">¿Cerrar sesión, @User.Identity.Name?</h5>
                <p class="text-muted small mt-1">Tendrás que volver a ingresar tus datos.</p>
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                   <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
    @Html.AntiForgeryToken()
    <input type="hidden" name="sessionToken" value="@User.FindFirst("SessionToken")?.Value" />
    <button type="submit" class="btn btn-danger rounded-pill px-4">Sí, salir</button>
</form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL GUEST -->
<div class="modal fade" id="guestModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body text-center p-4">
                <div style="font-size:44px;margin-bottom:12px;">🔐</div>
                <h4 class="fw-bold mb-2">Accede para continuar</h4>
                <p class="text-muted small">Crea una cuenta para desbloquear todas las funciones.</p>
                <a asp-controller="Account" asp-action="UpgradeAccount" class="btn btn-primary w-100 mb-2 rounded-pill py-2 fw-semibold">
                    Iniciar sesión o crear cuenta
                </a>
                <button id="closeGuestModal" type="button" class="btn btn-outline-secondary w-100 rounded-pill py-2 fw-semibold">
                    👤 Seguir como invitado
                </button>
            </div>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning text-center mx-3 mt-2">@TempData["Error"]</div>
}

<!-- SCRIPTS -->
<script>var isGuest = '@User.IsInRole("Guest")'.toLowerCase() === 'true';</script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
const isSuperAdmin = @(User.IsInRole("SuperAdmin").ToString().ToLower());

// ── SIGNALR GLOBAL ───────────────────────
const connectionGlobal = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

connectionGlobal.on("ForceLogout", function(message) {
    document.body.innerHTML = `<div style="height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;font-family:sans-serif;color:white;text-align:center;"><div style="background:#1e293b;padding:50px;border-radius:14px;"><h2 style="color:#f59e0b">⚠ Atención</h2><p>${message}</p><p style="opacity:0.6">Cerrando sesión...</p></div></div>`;
   setTimeout(() => window.location.href="/Account/LogoutGet", 2500);
});

connectionGlobal.on("IPBlocked", function(blockedIp) {
    fetch("/Home/GetMyIP").then(r => r.text()).then(myIp => {
        if (myIp === blockedIp) {
            document.body.innerHTML = `<div style="height:100vh;display:flex;align-items:center;justify-content:center;background:#0f172a;font-family:sans-serif;color:white;text-align:center;"><div style="background:#1e293b;padding:50px;border-radius:14px;"><h2 style="color:#ef4444">🚫 IP bloqueada</h2><p>Tu IP ha sido bloqueada</p></div></div>`;
            setTimeout(() => window.location.href="/Account/Login?ipblocked=true", 2500);
        }
    });
});

connectionGlobal.on("ConnectionBlocked", function(message) {
    if (isSuperAdmin) return;
    alert(message);
    setTimeout(() => window.location.href="/Home/ConnectionBlocked", 1500);
});

connectionGlobal.on("IPBlockedNow", function(message) {
    document.body.innerHTML = `<div style="height:100vh;display:flex;align-items:center;justify-content:center;background:#020617;color:white;font-family:sans-serif;text-align:center;"><div style="background:#1e293b;padding:50px;border-radius:16px;"><h2 style="color:#ef4444">🚫 Acceso bloqueado</h2><p>${message}</p><p style="opacity:0.6">Redirigiendo...</p></div></div>`;
    setTimeout(() => window.location.href="/Account/Login?ipblocked=true", 2000);
});

connectionGlobal.on("UserDeleted", function(userId) {
    const myId = '@User.FindFirst("UserId")?.Value';
    if (myId == userId) { alert("⚠ Esta cuenta fue eliminada."); setTimeout(() => window.location.href="/Account/Login", 1500); }
});

connectionGlobal.on("UserConnectedNotification", function(username) {
    showToastNotif(username, "● En línea", "", null);
});

// 🔥 nueva sesión detectada en tiempo real
connectionGlobal.on("NewSessionDetected", function() {
    if (window.location.pathname.toLowerCase().includes("/security")) {
        location.reload();
    }
});

connectionGlobal.start().catch(err => console.error("SignalR global:", err));
</script>

<script>
// ── SIGNALR NOTIFICACIONES ───────────────
const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

connection.start().then(function() {
    const userId = '@(User.Identity.IsAuthenticated ? User.FindFirst("UserId")?.Value : "")';
    if (userId) connection.invoke("JoinUserGroup", userId);

    connection.on("ReceiveNotification", function(uid, message, username, userImage, link) {
        showToastNotif(username, message, userImage, link);
    });

    connection.on("UserOnline", () => {});
    connection.on("UserOffline", () => {});
}).catch(err => console.error("SignalR notif:", err));

function showToastNotif(username, message, userImage, link) {
    const firstLetter = username ? username.charAt(0).toUpperCase() : "?";
    const avatarHTML = (userImage && userImage.trim() !== "")
        ? `<img src="${userImage}" style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;" />`
        : `<div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c3aed);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;flex-shrink:0;">${firstLetter}</div>`;

    const card = document.createElement("div");
    card.className = "ht-notif-card";
    card.innerHTML = `
        ${avatarHTML}
        <div style="flex:1;min-width:0;">
            <div style="font-weight:700;font-size:13px;color:#f1f5f9;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${username}</div>
            <div style="font-size:12px;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${message}</div>
        </div>
        <button onclick="event.stopPropagation();this.closest('.ht-notif-card').remove();" style="background:none;border:none;color:#64748b;font-size:15px;cursor:pointer;padding:0;flex-shrink:0;">✕</button>`;

    const progress = document.createElement("div");
    progress.className = "ht-notif-progress";
    card.appendChild(progress);

    if (link) card.addEventListener("click", () => window.location.href = link);

    document.getElementById("ht-notifs").appendChild(card);
    requestAnimationFrame(() => requestAnimationFrame(() => {
        card.classList.add("show");
        progress.style.width = "0%";
    }));

    setTimeout(() => {
        card.classList.remove("show");
        card.classList.add("hide");
        setTimeout(() => card.remove(), 400);
    }, 4000);
}

function handleNotificationClick(message, senderId, habitId, commentId) {
    if (message.toLowerCase().includes("coment")) window.location = `/Post/Details/${habitId}#comment-${commentId}`;
    else if (message.toLowerCase().includes("mensaje")) window.location = `/Message/Chat?userId=${senderId}`;
}
</script>

<script>
// ── LOADER ───────────────────────────────
const htLoader = document.getElementById("ht-loader");
const htBar = document.getElementById("ht-loader-bar");
const isChatPage = window.location.pathname.toLowerCase().includes("/message");
let loaderProgress = 0;

if (!isChatPage) {
    document.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", function() {
            if (link.hasAttribute("data-no-loader")) return;
            if (htLoader) htLoader.style.display = "flex";
        });
    });
    document.querySelectorAll("form").forEach(form => {
        form.addEventListener("submit", function() {
            if (!form.hasAttribute("data-no-loader")) { if(htLoader) htLoader.style.display = "flex"; }
        });
    });
}

const loaderInterval = setInterval(() => {
    if (loaderProgress < 88) { loaderProgress += Math.random() * 12; if(htBar) htBar.style.width = loaderProgress + "%"; }
}, 200);

window.addEventListener("load", function() {
    if(htBar) htBar.style.width = "100%";
    setTimeout(() => {
        if(htLoader) { htLoader.style.opacity = "0"; htLoader.style.transition = "opacity 0.4s"; }
        setTimeout(() => { if(htLoader) htLoader.style.display = "none"; clearInterval(loaderInterval); }, 400);
    }, 500);
});

window.addEventListener("pageshow", function(e) {
    if (e.persisted && htLoader) htLoader.style.display = "none";
});
</script>

<script>
// ── DARK MODE ────────────────────────────
const body = document.body;

function toggleDarkMode() {
    body.classList.contains("bg-dark") ? disableDarkMode() : enableDarkMode();
}

function enableDarkMode() {
    body.classList.remove("bg-light","text-dark");
    body.classList.add("bg-dark","text-light");
    localStorage.setItem("darkMode","enabled");
}

function disableDarkMode() {
    body.classList.remove("bg-dark","text-light");
    body.classList.add("bg-light","text-dark");
    localStorage.setItem("darkMode","disabled");
}

if (localStorage.getItem("darkMode") === "enabled") enableDarkMode();

document.addEventListener("DOMContentLoaded", function() {
    if (localStorage.getItem("darkMode") === "enabled") enableDarkMode();
});
</script>

<script>
// ── SIDEBAR ──────────────────────────────
function toggleSidebar() {
    const sidebar = document.getElementById("ht-sidebar");
    const overlay = document.getElementById("ht-overlay");
    const isOpen = sidebar.classList.contains("show");
    sidebar.classList.toggle("show");
    overlay.classList.toggle("show", !isOpen);
    document.body.style.overflow = !isOpen ? "hidden" : "";
}

document.getElementById("ht-overlay").addEventListener("click", () => {
    document.getElementById("ht-sidebar").classList.remove("show");
    document.getElementById("ht-overlay").classList.remove("show");
    document.body.style.overflow = "";
});

document.querySelectorAll(".ht-sidebar-link").forEach(link => {
    link.addEventListener("click", () => {
        document.getElementById("ht-sidebar").classList.remove("show");
        document.getElementById("ht-overlay").classList.remove("show");
        document.body.style.overflow = "";
    });
});
</script>

<script>
// ── USER DROPDOWN ────────────────────────
function toggleUserDropdown() {
    document.getElementById("ht-user-dropdown").classList.toggle("open");
}

document.addEventListener("click", function(e) {
    const dd = document.getElementById("ht-user-dropdown");
    if (dd && !dd.contains(e.target)) dd.classList.remove("open");
});
</script>

<script>
// ── GEOLOCATION ──────────────────────────
window.addEventListener("load", function() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function(pos) {
            fetch("/Account/SaveLocation", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ latitude: pos.coords.latitude, longitude: pos.coords.longitude })
            });
        });
    }
});
</script>

<script>
// ── GUEST MODAL ──────────────────────────
document.addEventListener("DOMContentLoaded", function() {
    const modalEl = document.getElementById('guestModal');
    const guestModal = new bootstrap.Modal(modalEl, { backdrop: true, keyboard: true });

    function cleanBackdrop() {
        setTimeout(() => {
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }, 300);
    }

    modalEl.addEventListener('hidden.bs.modal', cleanBackdrop);

    // 🔥 auto-abrir si viene del filtro
    if (window.location.search.includes("showGuestModal=true")) {
        setTimeout(() => guestModal.show(), 300);
    }

    // 🔥 interceptar clicks en elementos guest-block
    document.addEventListener("click", function(e) {
        if (!isGuest) return;
        const target = e.target.closest(".guest-block");
        if (!target) return;
        if (modalEl.contains(target)) return;
        if (target.closest("#logoutModal")) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        document.getElementById("ht-sidebar").classList.remove("show");
        document.getElementById("ht-overlay").classList.remove("show");
        document.body.style.overflow = "";
        guestModal.show();
    }, true);

    document.addEventListener("submit", function(e) {
        if (!isGuest) return;
        if (!e.target.classList.contains("guest-block-form")) return;
        if (modalEl.contains(e.target)) return;
        e.preventDefault();
        guestModal.show();
    }, true);

    document.getElementById("closeGuestModal").addEventListener("click", function() {
        guestModal.hide();
        cleanBackdrop();
    });
});
</script>

<script>
if ("Notification" in window) Notification.requestPermission();
</script>

