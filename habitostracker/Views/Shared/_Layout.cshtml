<script>
// ══ GUEST MODAL ══════════════════════════
document.addEventListener("DOMContentLoaded", () => {
    const modalEl = document.getElementById('guestModal');
    const guestModal = new bootstrap.Modal(modalEl, { backdrop: true, keyboard: true });

    function cleanBackdrop() {
        setTimeout(() => {
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }, 300);
    }

    modalEl.addEventListener('hidden.bs.modal', cleanBackdrop);
    if (window.location.search.includes("showGuestModal=true")) setTimeout(() => guestModal.show(), 300);

    document.addEventListener("click", e => {
        if (!isGuest) return;
        const target = e.target.closest(".guest-block");
        if (!target || modalEl.contains(target) || target.closest("#logoutModal")) return;
        e.preventDefault(); e.stopImmediatePropagation();
        document.getElementById("ht-sidebar").classList.remove("show");
        document.getElementById("ht-overlay").classList.remove("show");
        document.body.style.overflow = "";
        guestModal.show();
    }, true);

    document.addEventListener("submit", e => {
        if (!isGuest || !e.target.classList.contains("guest-block-form") || modalEl.contains(e.target)) return;
        e.preventDefault(); guestModal.show();
    }, true);

    document.getElementById("closeGuestModal").addEventListener("click", () => { guestModal.hide(); cleanBackdrop(); });
});
</script>

<script>
if ("Notification" in window) Notification.requestPermission();
</script>

