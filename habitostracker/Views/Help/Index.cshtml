@{
    ViewData["Title"] = "Mesa de ayuda";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.help-page { max-width: 640px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; }

/* HERO */
.help-hero {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-radius: 22px; padding: 32px 28px; margin-bottom: 16px;
    text-align: center; position: relative; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.06);
}
.help-hero::before {
    content:""; position:absolute; top:-60px; left:50%; transform:translateX(-50%);
    width:300px; height:200px;
    background: radial-gradient(ellipse, rgba(99,102,241,0.2), transparent 70%);
}
.help-hero-img {
    width: 90px; height: 90px; border-radius: 20px;
    object-fit: cover; border: 3px solid rgba(99,102,241,0.4);
    box-shadow: 0 8px 24px rgba(99,102,241,0.3);
    margin-bottom: 16px; position: relative; z-index: 1;
}
.help-hero-title { font-size: 20px; font-weight: 800; color: white; margin: 0 0 8px; }
.help-hero-sub { font-size: 13px; color: rgba(255,255,255,0.45); margin: 0; line-height: 1.6; }

/* ALERT BANNERS */
.help-banner {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 18px; border-radius: 16px; margin-bottom: 16px;
    font-size: 13px; font-weight: 600;
}
.help-banner.success { background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #16a34a; }
.help-banner.error { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #dc2626; }
.help-banner-icon { font-size: 20px; flex-shrink: 0; }

/* CARDS */
.help-card {
    background: white; border-radius: 20px; padding: 24px;
    margin-bottom: 14px; border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: 0.2s;
}
.help-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }

.help-card-header { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
.help-card-icon {
    width: 44px; height: 44px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
}
.help-card-icon.purple { background: rgba(99,102,241,0.1); }
.help-card-icon.green { background: rgba(34,197,94,0.1); }
.help-card-icon.blue { background: rgba(37,99,235,0.1); }
.help-card-title { font-size: 15px; font-weight: 700; color: #111827; margin: 0 0 3px; }
.help-card-desc { font-size: 12px; color: #9ca3af; margin: 0; }

/* FOUNDERS */
.founders-text {
    font-size: 13px; color: #6b7280; line-height: 1.7;
    background: #f9fafb; border-radius: 14px;
    padding: 16px 18px; border: 1px solid #f3f4f6;
}
.founders-text strong { color: #111827; }

/* STATS */
.help-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 10px; margin-top: 16px;
}
.stat-item {
    background: linear-gradient(135deg, rgba(99,102,241,0.06), rgba(37,99,235,0.06));
    border: 1px solid rgba(99,102,241,0.12);
    border-radius: 14px; padding: 14px; text-align: center;
}
.stat-num { font-size: 20px; font-weight: 800; color: #6366f1; }
.stat-label { font-size: 11px; color: #9ca3af; font-weight: 600; margin-top: 2px; }

/* FORM */
.help-textarea {
    width: 100%; min-height: 110px; padding: 13px 16px;
    border: 1.5px solid #e5e7eb; border-radius: 14px;
    font-size: 14px; font-family: inherit; outline: none;
    transition: 0.2s; background: #f9fafb; color: #111827;
    resize: vertical; box-sizing: border-box; line-height: 1.6;
}
.help-textarea:focus { border-color: #6366f1; background: white; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
.help-textarea::placeholder { color: #9ca3af; }
.help-submit-btn {
    width: 100%; padding: 13px; border: none; border-radius: 14px;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    color: white; font-size: 14px; font-weight: 700;
    font-family: inherit; cursor: pointer; transition: 0.2s;
    margin-top: 10px; position: relative; overflow: hidden;
}
.help-submit-btn::before {
    content:""; position:absolute; top:0; left:-100%; width:100%; height:100%;
    background: linear-gradient(120deg,transparent,rgba(255,255,255,0.15),transparent);
    transition: 0.5s;
}
.help-submit-btn:hover::before { left:100%; }
.help-submit-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(99,102,241,0.35); }

/* CONTACTO */
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.contact-card {
    background: #f9fafb; border-radius: 16px;
    padding: 18px; border: 1px solid #f3f4f6;
    display: flex; flex-direction: column; gap: 12px;
    transition: 0.2s;
}
.contact-card:hover { background: #f3f4f6; border-color: #e5e7eb; }
.contact-name { font-size: 14px; font-weight: 700; color: #111827; }
.contact-role { font-size: 11px; color: #9ca3af; font-weight: 600; }
.contact-link {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 14px; border-radius: 10px;
    background: white; border: 1px solid #e5e7eb;
    text-decoration: none; font-size: 13px; font-weight: 600;
    color: #374151; transition: 0.15s;
}
.contact-link:hover { background: #dcfce7; border-color: #86efac; color: #16a34a; }
.contact-link-icon { font-size: 16px; }

/* VERSION BADGE */
.version-badge {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px; border-radius: 14px;
    background: rgba(99,102,241,0.06); border: 1px solid rgba(99,102,241,0.12);
    font-size: 12px; font-weight: 600; color: #6366f1;
    margin-top: 14px;
}

/* DARK MODE */
body.bg-dark .help-card { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .help-card-title { color: #f1f5f9 !important; }
body.bg-dark .founders-text { background: #2d3748 !important; border-color: #3d4d60 !important; color: #94a3b8 !important; }
body.bg-dark .founders-text strong { color: #f1f5f9 !important; }
body.bg-dark .stat-item { background: rgba(99,102,241,0.08) !important; }
body.bg-dark .help-textarea { background: #2d3748 !important; border-color: #3d4d60 !important; color: #f1f5f9 !important; }
body.bg-dark .help-textarea:focus { background: #334155 !important; }
body.bg-dark .contact-card { background: #2d3748 !important; border-color: #3d4d60 !important; }
body.bg-dark .contact-card:hover { background: #334155 !important; }
body.bg-dark .contact-name { color: #f1f5f9 !important; }
body.bg-dark .contact-link { background: #1e293b !important; border-color: #3d4d60 !important; color: #94a3b8 !important; }
body.bg-dark .contact-link:hover { background: #14532d !important; border-color: #166534 !important; color: #4ade80 !important; }
body.bg-dark .version-badge { background: rgba(99,102,241,0.1) !important; }
body.bg-dark .help-banner.success { color: #4ade80 !important; }
body.bg-dark .help-banner.error { color: #f87171 !important; }

@@media (max-width: 480px) {
    .contact-grid { grid-template-columns: 1fr; }
    .help-stats { grid-template-columns: repeat(3, 1fr); }
}
</style>

<div class="help-page">

    @if (TempData["Success"] != null)
    {
        <div class="help-banner success">
            <span class="help-banner-icon">✅</span>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="help-banner error">
            <span class="help-banner-icon">❌</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- HERO -->
    <div class="help-hero">
        <img src="~/images/hole.png" class="help-hero-img" />
        <h2 class="help-hero-title">Mesa de Ayuda</h2>
        <p class="help-hero-sub">
            Estamos aquí para escucharte y mejorar tu experiencia 💙
        </p>
    </div>

    <!-- SOBRE NOSOTROS -->
    <div class="help-card">
        <div class="help-card-header">
            <div class="help-card-icon purple">🚀</div>
            <div>
                <div class="help-card-title">Sobre el proyecto</div>
                <div class="help-card-desc">Quiénes somos y qué estamos construyendo</div>
            </div>
        </div>
        <div class="founders-text">
            <strong>HabitTracker</strong> es nuestro primer proyecto como desarrolladores de software.
            Estamos construyendo una app enfocada en el control de hábitos, con el objetivo de
            ayudarte a <strong>superarte cada día</strong> y vencerte a ti mismo. 💡
            <br /><br />
            Actualmente nos encontramos en el <strong>segundo semestre de desarrollo</strong>,
            aprendiendo y mejorando constantemente para darte la mejor experiencia posible.
        </div>
        <div class="help-stats">
            <div class="stat-item">
                <div class="stat-num">2°</div>
                <div class="stat-label">Semestre</div>
            </div>
            <div class="stat-item">
                <div class="stat-num">2</div>
                <div class="stat-label">Fundadores</div>
            </div>
            <div class="stat-item">
                <div class="stat-num">∞</div>
                <div class="stat-label">Mejoras</div>
            </div>
        </div>
    </div>

    <!-- FEEDBACK -->
    <div class="help-card">
        <div class="help-card-header">
            <div class="help-card-icon purple">💡</div>
            <div>
                <div class="help-card-title">Envíanos tu recomendación</div>
                <div class="help-card-desc">Tu opinión nos ayuda a mejorar cada día</div>
            </div>
        </div>
        <form method="post" asp-controller="Help" asp-action="SendFeedback">
            <textarea name="message" class="help-textarea"
                      placeholder="¿Qué podemos mejorar? ¿Tienes alguna idea o sugerencia?" required></textarea>
            <button type="submit" class="help-submit-btn">
                🚀 Enviar recomendación
            </button>
        </form>
    </div>

<!-- CONTACTO -->
<div class="help-card">
    <div class="help-card-header">
        <div class="help-card-icon green">📬</div>
     
    </div>
    <div class="contact-grid">
        <div class="contact-card">
            <div>
                <div class="contact-name">Soporte general</div>
                <div class="contact-role">Dudas, errores y sugerencias</div>
            </div>
            <a href="mailto:soporte@habittracker.app" class="contact-link" data-no-loader>
                <span class="contact-link-icon">📧</span>
                <span>soporte@habittracker.app</span>
            </a>
        </div>
        <div class="contact-card">
            <div>
                <div class="contact-name">Privacidad y cuentas</div>
                <div class="contact-role">Eliminación y datos personales</div>
            </div>
            <a href="mailto:privacidad@habittracker.app" class="contact-link" data-no-loader>
                <span class="contact-link-icon">🔐</span>
                <span>privacidad@habittracker.app</span>
            </a>
        </div>
    </div>
 
    <div class="version-badge">
        🛠 HabitTracker Pro · En desarrollo activo · v2.0
    </div>
</div>

</div>