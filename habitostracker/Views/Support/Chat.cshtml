@model List<HabitTrackerApp.Models.SupportMessage>

@{
    ViewData["Title"] = "Apoyo emocional";
}

<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg: #080c14;
    --surface: #0d1220;
    --surface2: #111827;
    --border: rgba(255,255,255,0.06);
    --border2: rgba(255,255,255,0.1);
    --accent: #818cf8;
    --accent2: #6366f1;
    --green: #34d399;
    --text: #f1f5f9;
    --muted: rgba(255,255,255,0.35);
}

.sp-page {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 110px);
    font-family: 'DM Sans', sans-serif;
    position: relative;
}

/* ── AMBIENT BG ── */
.sp-page::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background:
        radial-gradient(ellipse 80% 60% at 20% 10%, rgba(99,102,241,0.08) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 80% 80%, rgba(52,211,153,0.06) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
}

/* ── HERO ── */
.sp-hero {
    position: relative; z-index: 1;
    background: linear-gradient(135deg, #0d1220 0%, #111827 100%);
    border-radius: 24px;
    padding: 22px 26px;
    margin-bottom: 12px;
    border: 1px solid var(--border2);
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
    overflow: hidden;
}
.sp-hero::after {
    content: '';
    position: absolute;
    top: -30px; right: -30px;
    width: 160px; height: 160px;
    background: radial-gradient(circle, rgba(99,102,241,0.15), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
}
.sp-hero-orb {
    width: 54px; height: 54px; border-radius: 18px; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px;
    box-shadow: 0 8px 24px rgba(99,102,241,0.4);
    animation: orbFloat 4s ease-in-out infinite;
    position: relative; z-index: 1;
}
@@keyframes orbFloat { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-4px);} }

.sp-hero-text { flex: 1; position: relative; z-index: 1; }
.sp-hero-title {
    font-family: 'Instrument Serif', serif;
    font-size: 22px; color: white;
    margin-bottom: 3px; letter-spacing: -0.3px;
}
.sp-hero-sub { font-size: 12px; color: var(--muted); line-height: 1.5; }

.sp-hero-right { margin-left: auto; display: flex; align-items: center; gap: 10px; position: relative; z-index: 1; }
.sp-status {
    display: flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 20px;
    background: rgba(52,211,153,0.1);
    border: 1px solid rgba(52,211,153,0.2);
    font-size: 11px; font-weight: 600; color: var(--green);
}
.sp-status-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(52,211,153,0.6);
    animation: statusPulse 2s infinite;
}
@@keyframes statusPulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }

.sp-clear-btn {
    padding: 6px 13px; border-radius: 10px;
    border: 1px solid var(--border2);
    background: rgba(255,255,255,0.04);
    color: var(--muted); font-size: 12px; font-weight: 600;
    cursor: pointer; transition: 0.2s; font-family: inherit;
}
.sp-clear-btn:hover { background: rgba(239,68,68,0.1); color: #f87171; border-color: rgba(239,68,68,0.25); }

/* ── MOOD BAR ── */
.sp-mood-bar {
    position: relative; z-index: 1;
    display: flex; gap: 8px; margin-bottom: 12px; flex-shrink: 0; flex-wrap: wrap;
}
.sp-mood-btn {
    flex: 1; min-width: 80px; padding: 9px 10px;
    border-radius: 14px; border: 1.5px solid var(--border);
    background: rgba(255,255,255,0.03);
    color: var(--muted); font-size: 12px; font-weight: 600;
    cursor: pointer; transition: 0.2s; font-family: inherit;
    display: flex; align-items: center; justify-content: center; gap: 5px;
    white-space: nowrap;
}
.sp-mood-btn:hover { border-color: var(--border2); color: var(--text); background: rgba(255,255,255,0.06); }
.sp-mood-btn.active { border-color: var(--accent2); background: rgba(99,102,241,0.12); color: var(--accent); }

/* ── CHAT WRAP ── */
.sp-chat-wrap {
    position: relative; z-index: 1;
    flex: 1; min-height: 0;
    background: var(--surface);
    border-radius: 22px;
    border: 1px solid var(--border);
    display: flex; flex-direction: column;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,0.3);
}

/* ── CHAT BOX ── */
.sp-chat-box {
    flex: 1; overflow-y: auto;
    padding: 24px 20px;
    display: flex; flex-direction: column; gap: 8px;
    scroll-behavior: smooth;
}
.sp-chat-box::-webkit-scrollbar { width: 4px; }
.sp-chat-box::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

/* DATE SEPARATOR */
.sp-date-sep {
    display: flex; align-items: center; gap: 10px;
    margin: 8px 0; opacity: 0.4;
}
.sp-date-sep span {
    font-size: 10px; font-weight: 700; color: var(--muted);
    text-transform: uppercase; letter-spacing: 1px; white-space: nowrap;
}
.sp-date-sep::before, .sp-date-sep::after {
    content: ''; flex: 1; height: 1px; background: var(--border);
}

/* MESSAGES */
.sp-msg-row { display: flex; align-items: flex-end; gap: 8px; animation: msgSlideIn 0.25s ease; }
.sp-msg-row.mine { justify-content: flex-end; }
.sp-msg-row.theirs { justify-content: flex-start; }
@@keyframes msgSlideIn { from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);} }

.sp-ai-avatar {
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    display: flex; align-items: center; justify-content: center;
    font-size: 15px;
    box-shadow: 0 4px 12px rgba(99,102,241,0.3);
}

.sp-bubble {
    max-width: 70%; padding: 12px 16px;
    border-radius: 20px; font-size: 14px; line-height: 1.6;
    word-break: break-word; position: relative;
}
.sp-bubble.mine {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; border-bottom-right-radius: 5px;
    box-shadow: 0 4px 16px rgba(99,102,241,0.3);
}
.sp-bubble.theirs {
    background: var(--surface2);
    color: var(--text); border-bottom-left-radius: 5px;
    border: 1px solid var(--border);
}
.sp-bubble-meta {
    display: flex; align-items: center; gap: 6px;
    margin-top: 4px;
}
.sp-msg-time { font-size: 10px; color: var(--muted); }
.sp-msg-row.mine .sp-msg-time { text-align: right; }

/* REACTION BTN */
.sp-react-btn {
    opacity: 0; transition: opacity 0.2s;
    background: none; border: none; cursor: pointer;
    font-size: 14px; padding: 2px 4px; border-radius: 6px;
    color: var(--muted);
}
.sp-msg-row:hover .sp-react-btn { opacity: 1; }
.sp-react-btn:hover { background: rgba(255,255,255,0.08); }

/* REACTION BADGE */
.sp-reaction {
    position: absolute; bottom: -10px; right: 8px;
    background: var(--surface2); border: 1px solid var(--border2);
    border-radius: 20px; padding: 2px 7px; font-size: 12px;
    cursor: pointer; transition: transform 0.15s;
}
.sp-reaction:hover { transform: scale(1.2); }

/* TYPING */
.sp-typing-row { display: flex; align-items: flex-end; gap: 8px; }
.sp-typing-bubble {
    background: var(--surface2); border: 1px solid var(--border);
    padding: 12px 16px; border-radius: 20px 20px 20px 5px;
    display: flex; gap: 5px; align-items: center;
}
.sp-typing-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--muted); animation: typBounce 1.2s infinite;
}
.sp-typing-dot:nth-child(2) { animation-delay: 0.2s; }
.sp-typing-dot:nth-child(3) { animation-delay: 0.4s; }
@@keyframes typBounce { 0%,60%,100%{transform:translateY(0);} 30%{transform:translateY(-6px);} }

/* EMPTY STATE */
.sp-empty {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 14px; text-align: center; padding: 40px 24px;
}
.sp-empty-orb {
    width: 80px; height: 80px; border-radius: 50%;
    background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(52,211,153,0.1));
    border: 1px solid rgba(99,102,241,0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; animation: orbFloat 4s ease-in-out infinite;
    box-shadow: 0 0 40px rgba(99,102,241,0.1);
}
.sp-empty-title {
    font-family: 'Instrument Serif', serif;
    font-size: 20px; color: var(--text); letter-spacing: -0.3px;
}
.sp-empty-sub { font-size: 13px; color: var(--muted); max-width: 280px; line-height: 1.6; }

/* CRISIS BANNER */
.sp-crisis-banner {
    display: none;
    margin: 0 16px 8px; padding: 12px 16px;
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.2);
    border-radius: 14px;
    font-size: 12px; color: #f87171; font-weight: 500; line-height: 1.6;
    flex-shrink: 0;
}
.sp-crisis-banner.show { display: flex; align-items: flex-start; gap: 10px; }
.sp-crisis-icon { font-size: 18px; flex-shrink: 0; }

/* SUGGESTIONS */
.sp-suggestions {
    padding: 10px 16px 0; display: flex; gap: 7px; flex-wrap: wrap;
    border-top: 1px solid var(--border); flex-shrink: 0;
}
.sp-chip {
    padding: 6px 13px; border-radius: 20px;
    border: 1px solid var(--border2);
    background: rgba(255,255,255,0.03);
    color: var(--muted); font-size: 12px; font-weight: 600;
    cursor: pointer; transition: 0.15s; white-space: nowrap; font-family: inherit;
}
.sp-chip:hover { background: rgba(99,102,241,0.12); border-color: var(--accent2); color: var(--accent); }

/* INPUT AREA */
.sp-input-area {
    padding: 12px 16px; border-top: 1px solid var(--border);
    flex-shrink: 0;
}
.sp-input-row {
    display: flex; gap: 10px; align-items: flex-end;
}
.sp-textarea {
    flex: 1; padding: 12px 16px;
    border: 1.5px solid var(--border2);
    border-radius: 20px; font-size: 14px;
    font-family: inherit; outline: none; transition: 0.2s;
    background: rgba(255,255,255,0.04); color: var(--text);
    resize: none; max-height: 120px; line-height: 1.5;
}
.sp-textarea:focus { border-color: var(--accent2); background: rgba(99,102,241,0.05); box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
.sp-textarea::placeholder { color: rgba(255,255,255,0.2); }

.sp-send-btn {
    width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
    border: none; background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; cursor: pointer; transition: 0.2s;
    display: flex; align-items: center; justify-content: center; font-size: 17px;
    box-shadow: 0 6px 16px rgba(99,102,241,0.4);
}
.sp-send-btn:hover { transform: scale(1.08); box-shadow: 0 8px 20px rgba(99,102,241,0.55); }
.sp-send-btn:disabled { background: rgba(255,255,255,0.08); box-shadow: none; cursor: not-allowed; transform: none; }

/* CHAR COUNTER */
.sp-char-count { font-size: 10px; color: var(--muted); text-align: right; margin-top: 5px; }
.sp-char-count.warn { color: #f59e0b; }
.sp-char-count.danger { color: #ef4444; }

/* RESOURCES CARD */
.sp-resources {
    display: none; margin: 0 16px 10px;
    background: rgba(52,211,153,0.06);
    border: 1px solid rgba(52,211,153,0.15);
    border-radius: 16px; padding: 14px 16px;
    flex-shrink: 0;
}
.sp-resources.show { display: block; }
.sp-resources-title { font-size: 12px; font-weight: 700; color: var(--green); margin-bottom: 8px; }
.sp-resource-item {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 0; border-bottom: 1px solid rgba(52,211,153,0.08);
    font-size: 12px; color: var(--muted);
}
.sp-resource-item:last-child { border-bottom: none; }
.sp-resource-item strong { color: var(--text); }

@@media (max-width: 640px) {
    .sp-hero { padding: 16px 18px; }
    .sp-hero-title { font-size: 18px; }
    .sp-mood-bar { gap: 6px; }
    .sp-mood-btn { font-size: 11px; padding: 7px 8px; }
    .sp-bubble { max-width: 85%; }
    .sp-status span:last-child { display: none; }
}
</style>

<div class="sp-page">

    <!-- HERO -->
    <div class="sp-hero">
        <div class="sp-hero-orb">💙</div>
        <div class="sp-hero-text">
            <div class="sp-hero-title">Espacio seguro</div>
            <div class="sp-hero-sub">Aquí puedes hablar sin filtros. Estoy para escucharte. 🤍</div>
        </div>
        <div class="sp-hero-right">
            <div class="sp-status">
                <div class="sp-status-dot"></div>
                <span>En línea</span>
            </div>
            <button class="sp-clear-btn" data-no-loader onclick="limpiarHistorial()">🗑</button>
        </div>
    </div>

    <!-- MOOD BAR -->
    <div class="sp-mood-bar" id="moodBar">
        <button class="sp-mood-btn" data-mood="triste" onclick="seleccionarMood(this, '😔 Me siento triste hoy')">😔 Triste</button>
        <button class="sp-mood-btn" data-mood="ansioso" onclick="seleccionarMood(this, '😰 Tengo ansiedad')">😰 Ansioso</button>
        <button class="sp-mood-btn" data-mood="enojado" onclick="seleccionarMood(this, '😤 Estoy frustrado y enojado')">😤 Frustrado</button>
        <button class="sp-mood-btn" data-mood="solo" onclick="seleccionarMood(this, '😞 Me siento muy solo')">😞 Solo</button>
        <button class="sp-mood-btn" data-mood="perdido" onclick="seleccionarMood(this, '🌀 Me siento perdido y sin dirección')">🌀 Perdido</button>
        <button class="sp-mood-btn" data-mood="bien" onclick="seleccionarMood(this, '🙂 Quiero hablar aunque estoy bien')">🙂 Solo hablar</button>
    </div>

    <!-- CHAT WRAP -->
    <div class="sp-chat-wrap">

        <!-- CRISIS BANNER -->
        <div class="sp-crisis-banner" id="crisisBanner">
            <span class="sp-crisis-icon">🚨</span>
            <span>Si estás en una situación de emergencia o piensas hacerte daño, por favor llama a una línea de crisis. <strong style="color:white;">Colombia: 106</strong> · <strong style="color:white;">Línea 106 Salud Mental</strong></span>
        </div>

        <!-- RESOURCES -->
        <div class="sp-resources" id="resourcesCard">
            <div class="sp-resources-title">📚 Recursos de ayuda</div>
            <div class="sp-resource-item"><span>📞</span><span><strong>Línea 106</strong> — Salud mental Colombia (gratuita 24/7)</span></div>
            <div class="sp-resource-item"><span>💬</span><span><strong>Línea 155</strong> — Violencia y emergencias</span></div>
            <div class="sp-resource-item"><span>🌐</span><span><strong>saludmental.minsalud.gov.co</strong> — Recursos oficiales</span></div>
        </div>

        <!-- CHAT BOX -->
        <div class="sp-chat-box" id="chatBox">
            @if (Model == null || !Model.Any())
            {
                <div class="sp-empty" id="emptyState">
                    <div class="sp-empty-orb">💙</div>
                    <div class="sp-empty-title">Aquí puedes hablar libremente</div>
                    <div class="sp-empty-sub">Sin juicios, sin filtros. Cuéntame qué está pasando y estaré aquí para ti.</div>
                </div>
            }
            else
            {
                <div class="sp-date-sep"><span>Conversación anterior</span></div>
                @foreach (var msg in Model)
                {
                    <div class="sp-msg-row mine">
                        <div>
                            <div class="sp-bubble mine">@msg.Message</div>
                            <div class="sp-bubble-meta" style="justify-content:flex-end;">
                                <span class="sp-msg-time">@msg.CreatedAt.ToString("hh:mm tt")</span>
                            </div>
                        </div>
                    </div>
                    <div class="sp-msg-row theirs">
                        <div class="sp-ai-avatar">🤖</div>
                        <div>
                            <div class="sp-bubble theirs" style="position:relative;">
                                @msg.Response
                                <span class="sp-reaction" onclick="toggleReaction(this)" title="Reaccionar">❤️</span>
                            </div>
                            <div class="sp-bubble-meta">
                                <span class="sp-msg-time">@msg.CreatedAt.ToString("hh:mm tt")</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- SUGERENCIAS -->
        <div class="sp-suggestions" id="suggestions">
            <button class="sp-chip" onclick="usarSugerencia(this)">💔 Problemas de pareja</button>
            <button class="sp-chip" onclick="usarSugerencia(this)">😴 No puedo dormir</button>
            <button class="sp-chip" onclick="usarSugerencia(this)">🎓 Problemas de estudio</button>
            <button class="sp-chip" onclick="usarSugerencia(this)">👨‍👩‍👧 Problemas familiares</button>
            <button class="sp-chip" onclick="usarSugerencia(this)">💼 Estrés laboral</button>
            <button class="sp-chip" onclick="usarSugerencia(this)">🌧️ Me siento vacío</button>
        </div>

        <!-- INPUT -->
        <div class="sp-input-area">
            <div class="sp-input-row">
                <textarea id="messageInput" class="sp-textarea" rows="1"
                          placeholder="Cuéntame qué está pasando..." maxlength="1000"></textarea>
                <button class="sp-send-btn" id="sendBtn" onclick="sendMessage()" data-no-loader disabled>➤</button>
            </div>
            <div class="sp-char-count" id="charCount">0 / 1000</div>
        </div>

    </div>
</div>

        <script>
const chatBox = document.getElementById("chatBox");
const sendBtn = document.getElementById("sendBtn");
const input = document.getElementById("messageInput");
const charCountEl = document.getElementById("charCount");

// scroll al fondo
window.addEventListener("load", () => {
    chatBox.scrollTop = chatBox.scrollHeight;
});

// ── TEXTAREA AUTO-RESIZE ──
input.addEventListener("input", function() {
    this.style.height = "auto";
    this.style.height = Math.min(this.scrollHeight, 120) + "px";
    sendBtn.disabled = this.value.trim() === "";

    const len = this.value.length;
    charCountEl.textContent = len + " / 1000";
    charCountEl.className = "sp-char-count" + (len > 900 ? " danger" : len > 700 ? " warn" : "");

    // detectar palabras clave de crisis
    detectarCrisis(this.value);
});

input.addEventListener("keydown", function(e) {
    if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        if (!sendBtn.disabled) sendMessage();
    }
});

// ── MOOD SELECTOR ──
function seleccionarMood(btn, texto) {
    document.querySelectorAll('.sp-mood-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    input.value = texto;
    input.dispatchEvent(new Event("input"));
    input.focus();
    document.getElementById("suggestions").style.display = "none";
}

// ── SUGERENCIAS ──
function usarSugerencia(btn) {
    input.value = btn.textContent.replace(/^[^\w]+/, "").trim();
    input.dispatchEvent(new Event("input"));
    input.focus();
    document.getElementById("suggestions").style.display = "none";
}

// ── DETECCIÓN DE CRISIS ──
const CRISIS_WORDS = ['suicidio', 'matarme', 'morir', 'no quiero vivir', 'hacerme daño', 'acabar con todo', 'no tiene sentido vivir'];
let crisisShown = false;

function detectarCrisis(text) {
    const lower = text.toLowerCase();
    const isCrisis = CRISIS_WORDS.some(w => lower.includes(w));
    const banner = document.getElementById("crisisBanner");
    const resources = document.getElementById("resourcesCard");

    if (isCrisis && !crisisShown) {
        crisisShown = true;
        banner.classList.add("show");
        resources.classList.add("show");
        chatBox.scrollTop = 0;
    } else if (!isCrisis) {
        crisisShown = false;
        banner.classList.remove("show");
    }
}

// ── TIMESTAMP ──
function makeTime() {
    return new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
}

// ── ESCAPE HTML ──
function escapeHtml(text) {
    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/\n/g, "<br>");
}

// ── REACCIONES ──
function toggleReaction(el) {
    const reactions = ['❤️', '🙏', '💙', '✨', '🤗'];
    const current = el.textContent;
    const idx = reactions.indexOf(current);
    el.textContent = reactions[(idx + 1) % reactions.length];
    el.style.transform = 'scale(1.4)';
    setTimeout(() => el.style.transform = 'scale(1)', 200);
}

// ── SEND MESSAGE ──
async function sendMessage() {
    const message = input.value.trim();
    if (!message) return;

    // ocultar empty state y sugerencias
    document.getElementById("emptyState")?.remove();
    document.getElementById("suggestions").style.display = "none";
    document.getElementById("moodBar").style.opacity = "0.4";

    // mensaje del usuario
    const userRow = document.createElement("div");
    userRow.className = "sp-msg-row mine";
    userRow.innerHTML = `
        <div>
            <div class="sp-bubble mine">${escapeHtml(message)}</div>
            <div class="sp-bubble-meta" style="justify-content:flex-end;">
                <span class="sp-msg-time">${makeTime()}</span>
            </div>
        </div>`;
    chatBox.appendChild(userRow);

    input.value = "";
    input.style.height = "auto";
    charCountEl.textContent = "0 / 1000";
    charCountEl.className = "sp-char-count";
    sendBtn.disabled = true;
    chatBox.scrollTop = chatBox.scrollHeight;

    // limpiar mood buttons
    document.querySelectorAll('.sp-mood-btn').forEach(b => b.classList.remove('active'));

    // typing indicator
    const typingRow = document.createElement("div");
    typingRow.className = "sp-typing-row";
    typingRow.id = "typingIndicator";
    typingRow.innerHTML = `
        <div class="sp-ai-avatar">🤖</div>
        <div class="sp-typing-bubble">
            <div class="sp-typing-dot"></div>
            <div class="sp-typing-dot"></div>
            <div class="sp-typing-dot"></div>
        </div>`;
    chatBox.appendChild(typingRow);
    chatBox.scrollTop = chatBox.scrollHeight;

    try {
        const res = await fetch("/Support/SendMessage", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: "message=" + encodeURIComponent(message)
        });

        if (!res.ok) throw new Error("Error del servidor");
        const data = await res.json();

        // delay realista
        await new Promise(r => setTimeout(r, 1000 + Math.random() * 800));

        document.getElementById("typingIndicator")?.remove();

        const aiRow = document.createElement("div");
        aiRow.className = "sp-msg-row theirs";
        aiRow.innerHTML = `
            <div class="sp-ai-avatar">🤖</div>
            <div>
                <div class="sp-bubble theirs" style="position:relative;">
                    ${escapeHtml(data.response)}
                    <span class="sp-reaction" onclick="toggleReaction(this)" title="Reaccionar">❤️</span>
                </div>
                <div class="sp-bubble-meta">
                    <span class="sp-msg-time">${makeTime()}</span>
                </div>
            </div>`;
        chatBox.appendChild(aiRow);
        chatBox.scrollTop = chatBox.scrollHeight;

        sendBtn.disabled = false;
        input.focus();
        document.getElementById("moodBar").style.opacity = "1";

        // mostrar recursos si respuesta toca temas de salud mental
        const respLower = data.response.toLowerCase();
        if (respLower.includes('crisis') || respLower.includes('ayuda profesional') || respLower.includes('línea')) {
            document.getElementById("resourcesCard").classList.add("show");
        }

    } catch (err) {
        document.getElementById("typingIndicator")?.remove();
        const errRow = document.createElement("div");
        errRow.className = "sp-msg-row theirs";
        errRow.innerHTML = `
            <div class="sp-ai-avatar">🤖</div>
            <div>
                <div class="sp-bubble theirs">Hubo un error al conectar. Intenta de nuevo. 😕</div>
            </div>`;
        chatBox.appendChild(errRow);
        chatBox.scrollTop = chatBox.scrollHeight;
        sendBtn.disabled = false;
        document.getElementById("moodBar").style.opacity = "1";
    }
}

// ── LIMPIAR HISTORIAL ──
async function limpiarHistorial() {
    if (!confirm("¿Limpiar todo el historial?")) return;
    await fetch("/Support/ClearHistory", { method: "POST" });
    chatBox.innerHTML = `
        <div class="sp-empty" id="emptyState">
            <div class="sp-empty-orb">💙</div>
            <div class="sp-empty-title">Aquí puedes hablar libremente</div>
            <div class="sp-empty-sub">Sin juicios, sin filtros. Cuéntame qué está pasando y estaré aquí para ti.</div>
        </div>`;
    document.getElementById("suggestions").style.display = "flex";
    document.getElementById("crisisBanner").classList.remove("show");
    document.getElementById("resourcesCard").classList.remove("show");
    document.getElementById("moodBar").style.opacity = "1";
    document.querySelectorAll('.sp-mood-btn').forEach(b => b.classList.remove('active'));
    crisisShown = false;
}
</script>