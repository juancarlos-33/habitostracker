@model List<HabitTrackerApp.Models.SupportMessage>

@{
    ViewData["Title"] = "Apoyo emocional";
}

<style>
* { box-sizing: border-box; }

.support-page {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 120px);
    font-family: 'Plus Jakarta Sans', sans-serif;
}

.support-hero {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-radius: 20px;
    padding: 20px 24px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1px solid rgba(255,255,255,0.06);
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
}
.support-hero::before {
    content:""; position:absolute; top:-30px; right:-30px;
    width:120px; height:120px;
    background: radial-gradient(circle, rgba(99,102,241,0.2), transparent 70%);
    border-radius:50%;
}
.support-hero-icon {
    width:48px; height:48px; border-radius:14px;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display:flex; align-items:center; justify-content:center;
    font-size:22px; flex-shrink:0;
    box-shadow: 0 6px 16px rgba(99,102,241,0.35);
}
.support-hero-title { font-size:17px; font-weight:800; color:white; margin:0 0 3px; }
.support-hero-sub { font-size:12px; color:rgba(255,255,255,0.4); margin:0; }
.support-hero-actions { margin-left:auto; flex-shrink:0; }
.clear-btn {
    padding: 7px 14px; border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.5);
    font-size: 12px; font-weight: 600;
    cursor: pointer; transition: 0.2s;
}
.clear-btn:hover { background: rgba(239,68,68,0.15); color: #f87171; border-color: rgba(239,68,68,0.3); }

/* CHAT BOX */
.chat-wrap {
    flex: 1;
    background: white;
    border-radius: 20px;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

.chat-box {
    flex: 1;
    overflow-y: auto;
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    scroll-behavior: smooth;
}

.chat-box::-webkit-scrollbar { width: 5px; }
.chat-box::-webkit-scrollbar-track { background: transparent; }
.chat-box::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }

/* MENSAJES */
.msg-row { display: flex; }
.msg-row.mine { justify-content: flex-end; }
.msg-row.theirs { justify-content: flex-start; }

.msg-bubble {
    max-width: 72%;
    padding: 11px 15px;
    border-radius: 18px;
    font-size: 14px;
    line-height: 1.55;
    word-break: break-word;
    animation: msgIn 0.2s ease;
}
@@keyframes msgIn { from{opacity:0;transform:translateY(6px);} to{opacity:1;transform:translateY(0);} }

.msg-bubble.mine {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white;
    border-bottom-right-radius: 4px;
    box-shadow: 0 2px 10px rgba(99,102,241,0.3);
}

.msg-bubble.theirs {
    background: #f1f5f9;
    color: #1e293b;
    border-bottom-left-radius: 4px;
}

.msg-time {
    font-size: 10px;
    margin-top: 4px;
    opacity: 0.5;
    text-align: right;
}
.msg-row.theirs .msg-time { text-align: left; }

.ai-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; flex-shrink: 0; align-self: flex-end;
    margin-right: 8px;
}

/* TYPING */
.typing-wrap {
    display: flex; align-items: center; gap: 8px;
    padding: 0 18px 14px;
}
.typing-bubble {
    background: #f1f5f9;
    padding: 10px 16px;
    border-radius: 18px 18px 18px 4px;
    display: flex; gap: 5px; align-items: center;
}
.typing-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #94a3b8; animation: typingBounce 1.2s infinite;
}
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@@keyframes typingBounce { 0%,60%,100%{transform:translateY(0);} 30%{transform:translateY(-6px);} }

/* EMPTY STATE */
.empty-state {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 12px; color: #9ca3af; text-align: center;
    padding: 40px 20px;
}
.empty-state-icon { font-size: 48px; }
.empty-state-title { font-size: 16px; font-weight: 700; color: #374151; }
.empty-state-sub { font-size: 13px; color: #9ca3af; }

/* SUGERENCIAS */
.suggestions {
    padding: 12px 18px 0;
    display: flex; gap: 8px; flex-wrap: wrap;
    border-top: 1px solid #f3f4f6;
}
.suggestion-chip {
    padding: 6px 14px; border-radius: 20px;
    border: 1.5px solid #e5e7eb;
    background: white; color: #374151;
    font-size: 12px; font-weight: 600;
    cursor: pointer; transition: 0.15s;
    white-space: nowrap;
}
.suggestion-chip:hover { background: #ede9fe; border-color: #6366f1; color: #6366f1; }

/* INPUT */
.chat-input-wrap {
    padding: 12px 16px;
    display: flex; gap: 10px; align-items: center;
    border-top: 1px solid #f3f4f6;
    flex-shrink: 0;
}
.chat-input {
    flex: 1; padding: 11px 16px;
    border: 1.5px solid #e5e7eb; border-radius: 24px;
    font-size: 14px; font-family: inherit; outline: none;
    transition: 0.2s; background: #f9fafb; color: #111827;
    resize: none; max-height: 100px;
}
.chat-input:focus { border-color: #6366f1; background: white; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
.chat-input::placeholder { color: #9ca3af; }
.send-btn {
    width: 42px; height: 42px; border-radius: 50%;
    border: none; background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; cursor: pointer; transition: 0.2s;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(99,102,241,0.35);
}
.send-btn:hover { transform: scale(1.08); }
.send-btn:disabled { background: #cbd5e1; box-shadow: none; cursor: not-allowed; transform: none; }

/* DARK MODE */
body.bg-dark .chat-wrap { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .msg-bubble.theirs { background: #2d3748 !important; color: #f1f5f9 !important; }
body.bg-dark .chat-input { background: #2d3748 !important; border-color: #3d4d60 !important; color: #f1f5f9 !important; }
body.bg-dark .chat-input:focus { background: #334155 !important; }
body.bg-dark .suggestions { border-color: #2d3748 !important; }
body.bg-dark .suggestion-chip { background: #2d3748 !important; border-color: #3d4d60 !important; color: #94a3b8 !important; }
body.bg-dark .suggestion-chip:hover { background: rgba(99,102,241,0.2) !important; border-color: #6366f1 !important; color: #818cf8 !important; }
body.bg-dark .chat-input-wrap { border-color: #2d3748 !important; }
body.bg-dark .typing-bubble { background: #2d3748 !important; }
body.bg-dark .empty-state-title { color: #f1f5f9 !important; }
</style>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<div class="support-page">

    <!-- HERO -->
    <div class="support-hero">
        <div class="support-hero-icon">😔</div>
        <div>
            <div class="support-hero-title">Apoyo emocional</div>
            <div class="support-hero-sub">Un espacio seguro para hablar sin filtro 💙</div>
        </div>
        <div class="support-hero-actions">
            <button class="clear-btn" data-no-loader onclick="limpiarHistorial()">🗑 Limpiar</button>
        </div>
    </div>

    <!-- CHAT -->
    <div class="chat-wrap">

        <div class="chat-box" id="chatBox">

            @if (Model == null || !Model.Any())
            {
                <div class="empty-state" id="emptyState">
                    <div class="empty-state-icon">💙</div>
                    <div class="empty-state-title">Aquí puedes hablar libremente</div>
                    <div class="empty-state-sub">Cuéntame qué está pasando, sin filtros.</div>
                </div>
            }
            else
            {
                @foreach (var msg in Model)
                {
                    <div class="msg-row mine">
                        <div>
                            <div class="msg-bubble mine">@msg.Message</div>
                            <div class="msg-time">@msg.CreatedAt.ToString("hh:mm tt")</div>
                        </div>
                    </div>
                    <div class="msg-row theirs">
                        <div class="ai-avatar">🤖</div>
                        <div>
                            <div class="msg-bubble theirs">@msg.Response</div>
                            <div class="msg-time">@msg.CreatedAt.ToString("hh:mm tt")</div>
                        </div>
                    </div>
                }
            }

        </div>

        <!-- SUGERENCIAS -->
        <div class="suggestions" id="suggestions">
            <button class="suggestion-chip" onclick="usarSugerencia(this)">😔 Me siento triste</button>
            <button class="suggestion-chip" onclick="usarSugerencia(this)">😰 Tengo ansiedad</button>
            <button class="suggestion-chip" onclick="usarSugerencia(this)">💔 Problemas de pareja</button>
            <button class="suggestion-chip" onclick="usarSugerencia(this)">😤 Estoy frustrado</button>
            <button class="suggestion-chip" onclick="usarSugerencia(this)">😴 No puedo dormir</button>
            <button class="suggestion-chip" onclick="usarSugerencia(this)">🎓 Problemas de estudio</button>
        </div>

        <!-- INPUT -->
        <div class="chat-input-wrap">
            <textarea id="messageInput" class="chat-input" rows="1"
                      placeholder="Cuéntame qué está pasando..."></textarea>
            <button class="send-btn" id="sendBtn" onclick="sendMessage()" data-no-loader>
                ➤
            </button>
        </div>

    </div>

</div>

<script>
const chatBox = document.getElementById("chatBox");
const sendBtn = document.getElementById("sendBtn");
const input = document.getElementById("messageInput");

// scroll al fondo al cargar
window.addEventListener("load", () => {
    chatBox.scrollTop = chatBox.scrollHeight;
});

// auto-resize textarea
input.addEventListener("input", function() {
    this.style.height = "auto";
    this.style.height = Math.min(this.scrollHeight, 100) + "px";
    sendBtn.disabled = this.value.trim() === "";
});

input.addEventListener("keydown", function(e) {
    if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
});

function usarSugerencia(btn) {
    const texto = btn.textContent.replace(/^[^\w]+/, "").trim();
    input.value = texto;
    input.dispatchEvent(new Event("input"));
    input.focus();
    // ocultar sugerencias
    document.getElementById("suggestions").style.display = "none";
}

function makeTime() {
    return new Date().toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' });
}

async function sendMessage() {
    const message = input.value.trim();
    if (!message) return;

    // ocultar empty state y sugerencias
    const empty = document.getElementById("emptyState");
    if (empty) empty.remove();
    document.getElementById("suggestions").style.display = "none";

    // mensaje del usuario
    chatBox.innerHTML += `
        <div class="msg-row mine">
            <div>
                <div class="msg-bubble mine">${escapeHtml(message)}</div>
                <div class="msg-time">${makeTime()}</div>
            </div>
        </div>`;

    input.value = "";
    input.style.height = "auto";
    sendBtn.disabled = true;
    chatBox.scrollTop = chatBox.scrollHeight;

    // typing indicator
    const typingId = "typing-" + Date.now();
    chatBox.innerHTML += `
        <div id="${typingId}" class="msg-row theirs">
            <div class="ai-avatar">🤖</div>
            <div class="typing-bubble">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>
        </div>`;
    chatBox.scrollTop = chatBox.scrollHeight;

    try {
        const res = await fetch("/Support/SendMessage", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: "message=" + encodeURIComponent(message)
        });

        if (!res.ok) throw new Error("Error del servidor");
        const data = await res.json();

        setTimeout(() => {
            const typingEl = document.getElementById(typingId);
            if (typingEl) typingEl.remove();

            chatBox.innerHTML += `
                <div class="msg-row theirs">
                    <div class="ai-avatar">🤖</div>
                    <div>
                        <div class="msg-bubble theirs">${escapeHtml(data.response)}</div>
                        <div class="msg-time">${makeTime()}</div>
                    </div>
                </div>`;

            chatBox.scrollTop = chatBox.scrollHeight;
            sendBtn.disabled = false;
            input.focus();
        }, 1200);

    } catch (err) {
        const typingEl = document.getElementById(typingId);
        if (typingEl) typingEl.remove();
        chatBox.innerHTML += `
            <div class="msg-row theirs">
                <div class="ai-avatar">🤖</div>
                <div>
                    <div class="msg-bubble theirs">Hubo un error. Intenta de nuevo 😕</div>
                </div>
            </div>`;
        sendBtn.disabled = false;
        chatBox.scrollTop = chatBox.scrollHeight;
    }
}

async function limpiarHistorial() {
    if (!confirm("¿Limpiar todo el historial de conversación?")) return;
    await fetch("/Support/ClearHistory", { method: "POST" });
    chatBox.innerHTML = `
        <div class="empty-state" id="emptyState">
            <div class="empty-state-icon">💙</div>
            <div class="empty-state-title">Aquí puedes hablar libremente</div>
            <div class="empty-state-sub">Cuéntame qué está pasando, sin filtros.</div>
        </div>`;
    document.getElementById("suggestions").style.display = "flex";
}

function escapeHtml(text) {
    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}
</script>