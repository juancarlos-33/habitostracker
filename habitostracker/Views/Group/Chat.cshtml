            <a href="/User/Profile/@msg.SenderId" class="grp-msg-sender">@msg.Sender?.Username</a>
        }
        <div class="grp-msg-bubble" oncontextmenu="abrirReactionPicker(event, @msg.Id)" ondblclick="responderMensaje(@msg.Id, '@(msg.Sender?.Username ?? "")', '@(msg.Content?.Replace("'", "\\'").Replace("\n", " ") ?? "")')" style="position:relative;">
            @if (msg.ReplyToMessageId.HasValue && msg.ReplyToMessage != null)
            {
                var replyText = msg.ReplyToMessage.Content?.Length > 50
                    ? msg.ReplyToMessage.Content.Substring(0, 50) + "..."
                    : msg.ReplyToMessage.Content ?? "";
                <div class="grp-msg-reply" onclick="scrollToMessage(@msg.ReplyToMessageId)">
                    <div class="grp-msg-reply-name">@msg.ReplyToMessage.Sender?.Username</div>
                    <div class="grp-msg-reply-text">@replyText</div>
