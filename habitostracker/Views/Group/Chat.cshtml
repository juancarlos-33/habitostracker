async function toggleGrabacion() {
    if (isRecording) {
        mediaRecorder.stop(); isRecording = false; clearInterval(recInterval);
        document.getElementById("grpRecording").style.display = "none";
        document.getElementById("grpRecBtn").classList.remove("recording"); return;
    }
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = []; isRecording = true;
        document.getElementById("grpRecording").style.display = "flex";
        document.getElementById("grpRecBtn").classList.add("recording");
        let secs = 0;
        recInterval = setInterval(() => { secs++; document.getElementById("grpRecTimer").textContent = `${Math.floor(secs/60)}:${String(secs%60).padStart(2,"0")}`; }, 1000);
        mediaRecorder.ondataavailable = e => { if (e.data?.size > 0) audioChunks.push(e.data); };
        mediaRecorder.onstop = () => {
            stream.getTracks().forEach(t => t.stop());
            recordedBlob = new Blob(audioChunks, { type: "audio/webm" });
            document.getElementById("grpPreviewAudio").src = URL.createObjectURL(recordedBlob);
            document.getElementById("grpAudioPreview").style.display = "block";
        };
        mediaRecorder.start();
    } catch (err) { showToast("❌ No se pudo acceder al micrófono"); }
}

async function enviarAudio() {
    if (!recordedBlob) return;
