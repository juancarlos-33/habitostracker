            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: `messageId=${msgId}&__RequestVerificationToken=${encodeURIComponent(token())}`
        });
        const data = await res.json();
        if (!data.success) showToast("❌ No se pudo eliminar");
    } catch { showToast("❌ Error de conexión"); }
}
let pinnedMsgId = @(Model.PinnedMessageId?.ToString() ?? "null");

async function fijarMensaje(msgId) {
    document.querySelectorAll('.grp-reaction-picker').forEach(p => p.remove());
    try {
        const res = await fetch('/Group/PinMessage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `messageId=${msgId}&__RequestVerificationToken=${encodeURIComponent(token())}`
        });
        const data = await res.json();
        if (data.success) {
            showToast(data.pinned ? '📌 Mensaje fijado' : '📌 Mensaje desfijado');
        } else {
            showToast('❌ ' + (data.error ?? 'Error'));
        }
    } catch { showToast('❌ Error de conexión'); }
}

async function desfijarMensaje() {
    if (!pinnedMsgId) return;
    await fijarMensaje(pinnedMsgId);
}

grpConnection.on("GroupMessagePinned", (msgId, content, pinnedBy) => {
    pinnedMsgId = msgId;
    const banner = document.getElementById('pinnedBanner');
    const contentEl = document.getElementById('pinnedContent');
    if (banner) {
        banner.style.display = 'flex';
        banner.onclick = () => scrollToMessage(msgId);
    }
    if (contentEl) contentEl.textContent = content.length > 60 ? content.substring(0, 60) + '...' : content;
    showToast(`📌 ${pinnedBy} fijó un mensaje`);
});

grpConnection.on("GroupMessageUnpinned", () => {
    pinnedMsgId = null;
    const banner = document.getElementById('pinnedBanner');
    if (banner) banner.style.display = 'none';
    showToast('📌 Mensaje desfijado');
});
async function reaccionar(msgId, emoji) {
    document.querySelectorAll('.grp-reaction-picker').forEach(p => p.remove());
    try {
        const res = await fetch("/Group/ReactToMessage", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: `messageId=${msgId}&emoji=${encodeURIComponent(emoji)}&__RequestVerificationToken=${encodeURIComponent(token())}`
        });
        const data = await res.json();
        if (data.success) actualizarReacciones(msgId.toString(), data.reactions);
    } catch (err) { console.error(err); }
}
// ══ BÚSQUEDA EN CHAT ══
let searchResultIds = [];
let searchCurrentIndex = -1;

function toggleBusqueda() {
    const bar = document.getElementById('searchBar');
    const input = document.getElementById('searchInput');
    const isOpen = bar.style.display === 'flex';
    bar.style.display = isOpen ? 'none' : 'flex';
    if (!isOpen) {
        input.focus();
        limpiarBusqueda();
    } else {
        limpiarBusqueda();
    }
}

function limpiarBusqueda() {
    // quitar highlights anteriores
    document.querySelectorAll('.search-highlight').forEach(el => {
        el.style.background = '';
        el.style.outline = '';
        el.classList.remove('search-highlight');
    });
    searchResultIds = [];
    searchCurrentIndex = -1;
    document.getElementById('searchResults').textContent = '';
    const input = document.getElementById('searchInput');
    if (input) input.value = '';
}

function buscarMensajes(query) {
    // limpiar highlights anteriores
    document.querySelectorAll('.search-highlight').forEach(el => {
        el.style.background = '';
        el.style.outline = '';
        el.classList.remove('search-highlight');
    });
    searchResultIds = [];
    searchCurrentIndex = -1;

    if (!query || query.trim().length < 2) {
        document.getElementById('searchResults').textContent = '';
        return;
    }

    const q = query.toLowerCase().trim();
    const bubbles = document.querySelectorAll('.grp-msg-bubble');

    bubbles.forEach(bubble => {
        const text = bubble.innerText.toLowerCase();
        if (text.includes(q)) {
            const row = bubble.closest('.grp-msg-row');
            if (row) {
                searchResultIds.push(row.id);
                bubble.classList.add('search-highlight');
                bubble.style.outline = '2px solid #6366f1';
                bubble.style.outlineOffset = '2px';
            }
        }
    });

    const count = searchResultIds.length;
    const resultsEl = document.getElementById('searchResults');

    if (count === 0) {
        resultsEl.textContent = 'Sin resultados';
        resultsEl.style.color = '#ef4444';
        return;
    }

    resultsEl.style.color = 'rgba(255,255,255,0.35)';
    searchCurrentIndex = 0;
    navegarResultado(0, true);
    resultsEl.textContent = `1 / ${count}`;
}

function navegarResultado(direction, reset = false) {
    if (!searchResultIds.length) return;

    if (!reset) {
        searchCurrentIndex += direction;
        if (searchCurrentIndex < 0) searchCurrentIndex = searchResultIds.length - 1;
        if (searchCurrentIndex >= searchResultIds.length) searchCurrentIndex = 0;
    }

    const rowId = searchResultIds[searchCurrentIndex];
    const row = document.getElementById(rowId);
    if (row) {
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const bubble = row.querySelector('.grp-msg-bubble');
        if (bubble) {
            bubble.style.outline = '2px solid #6366f1';
            // resaltar el actual más fuerte
            document.querySelectorAll('.search-highlight').forEach(el => {
                el.style.background = '';
            });
            bubble.style.background = 'rgba(99,102,241,0.2)';
        }
    }

    document.getElementById('searchResults').textContent = 
        `${searchCurrentIndex + 1} / ${searchResultIds.length}`;
}

function iniciarEdicion(msgId) {
    document.querySelectorAll('.grp-reaction-picker').forEach(p => p.remove());
    const bubble = document.querySelector(`#msg-${msgId} .grp-msg-bubble`);
    if (!bubble) return;

    // obtener texto actual sin el "editado"
    const textoActual = bubble.innerText.replace(' editado', '').trim();
    
    // reemplazar burbuja por input de edición
    bubble.innerHTML = `
        <textarea id="editInput-${msgId}" style="width:100%;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);border-radius:10px;padding:6px 10px;color:white;font-family:inherit;font-size:14px;resize:none;outline:none;">${textoActual}</textarea>
        <div style="display:flex;gap:6px;margin-top:6px;justify-content:flex-end;">
            <button onclick="cancelarEdicion(${msgId}, '${textoActual.replace(/'/g, "\\'")}')" style="padding:4px 12px;border-radius:8px;border:none;background:rgba(255,255,255,0.15);color:white;font-size:12px;cursor:pointer;font-family:inherit;">✕ Cancelar</button>
            <button onclick="guardarEdicion(${msgId})" style="padding:4px 12px;border-radius:8px;border:none;background:#22c55e;color:white;font-size:12px;cursor:pointer;font-family:inherit;">✓ Guardar</button>
        </div>
    `;
    document.getElementById(`editInput-${msgId}`)?.focus();
}

function cancelarEdicion(msgId, textoOriginal) {
    const bubble = document.querySelector(`#msg-${msgId} .grp-msg-bubble`);
    if (bubble) bubble.innerHTML = escapeHtml(textoOriginal);
}

async function guardarEdicion(msgId) {
    const input = document.getElementById(`editInput-${msgId}`);
    if (!input) return;
    const newContent = input.value.trim();
    if (!newContent) return;

    try {
        const res = await fetch("/Group/EditMessage", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: `messageId=${msgId}&newContent=${encodeURIComponent(newContent)}&__RequestVerificationToken=${encodeURIComponent(token())}`
        });
        const data = await res.json();
        if (!data.success) showToast("❌ No se pudo editar");
    } catch { showToast("❌ Error de conexión"); }
}
function actualizarReacciones(msgId, reactions) {
    const container = document.getElementById("reactions-" + msgId);
    if (!container) return;
    if (!reactions || reactions.length === 0) { container.innerHTML = ""; return; }
    container.innerHTML = reactions.map(r =>
        `<button class="grp-reaction-btn" onclick="reaccionar(${msgId}, '${r.emoji}')">${r.emoji}<span>${r.count}</span></button>`
    ).join("");
}
