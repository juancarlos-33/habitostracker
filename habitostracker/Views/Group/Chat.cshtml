            }

            @if (isAudio)
            {
                var audioUrl = !string.IsNullOrEmpty(msg.FileUrl) ? msg.FileUrl : msg.Content;
                <audio controls class="grp-msg-audio"><source src="@audioUrl" /></audio>
            }
            else if (isImage)
            {
                <img src="@msg.FileUrl" class="grp-msg-media" onclick="window.open('@msg.FileUrl', '_blank')" />
            }
            else if (isVideo)
            {
                <video controls class="grp-msg-media"><source src="@msg.FileUrl" /></video>
            }
            else if (!string.IsNullOrEmpty(msg.Content))
            {
                @msg.Content
            }
        </div>
        <div class="grp-msg-footer">
            <span class="grp-msg-time">@msg.SentAt.ToLocalTime().ToString("hh:mm tt")</span>
            @if (isMine)
            {
                <span class="grp-msg-check @(allRead ? "seen" : "")" id="check-@msg.Id">@(allRead ? "✔✔" : "✔")</span>
            }
        </div>
        <div class="grp-reactions" id="reactions-@msg.Id">
            @if (msg.Reactions != null && msg.Reactions.Any())
            {
                var reactionGroups = msg.Reactions.GroupBy(r => r.Emoji);
                foreach (var rg in reactionGroups)
                {
                    <button class="grp-reaction-btn" onclick="reaccionar(@msg.Id, '@rg.Key')">
                        @rg.Key<span>@rg.Count()</span>
                    </button>
                }
            }
        </div>
    </div>
</div>
                }
            }
        }
        <div class="grp-typing-indicator" id="typingIndicator">
            <div class="grp-typing-bubble">
                <div class="grp-typing-dot"></div><div class="grp-typing-dot"></div><div class="grp-typing-dot"></div>
            </div>
        </div>
    </div>

@if (!isMember)
{
