@model HabitTrackerApp.Models.Group

@{
    ViewData["Title"] = Model.Name;
    var messages = ViewBag.Messages as List<HabitTrackerApp.Models.GroupMessage> ?? new();
    var currentUserId = (int)ViewBag.CurrentUserId;
    var isAdmin = (bool)ViewBag.IsAdmin;
    var isMember = (bool)(ViewBag.IsMember ?? false);
    var isMuted = (bool)(ViewBag.IsMuted ?? false);
    var totalMembers = (int)ViewBag.TotalMembers;
    var members = Model.Members?.Where(m => m.IsActive).ToList() ?? new();
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
* { box-sizing: border-box; }

.grp-chat-page {
    display: flex; flex-direction: column;
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: #f1f5f9; z-index: 10; overflow: hidden; padding-top: 90px;
    font-family: 'Plus Jakarta Sans', sans-serif;
}
@@media (min-width: 768px) {
    .grp-chat-page {
        position: relative; padding-top: 0;
        height: calc(100vh - 130px); max-width: 860px;
        margin: 0 auto; border-radius: 20px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.1);
        overflow: hidden; border: 1px solid rgba(0,0,0,0.06);
    }
}

.grp-header {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px;
    background: linear-gradient(135deg, #1e293b, #334155);
    flex-shrink: 0; z-index: 2; cursor: pointer;
}
.grp-header-avatar {
    width: 42px; height: 42px; border-radius: 13px; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: white; font-weight: 800; overflow: hidden;
    border: 2px solid rgba(255,255,255,0.15);
}
.grp-header-avatar img { width: 100%; height: 100%; object-fit: cover; }
.grp-header-name { font-size: 15px; font-weight: 700; color: white; margin: 0 0 2px; }
.grp-header-meta { font-size: 11px; color: rgba(255,255,255,0.45); margin: 0; }
.grp-header-actions { margin-left: auto; display: flex; gap: 8px; align-items: center; }
.grp-header-btn {
    padding: 7px 14px; border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.6);
    font-size: 12px; font-weight: 600; cursor: pointer; transition: 0.2s;
    text-decoration: none; font-family: inherit;
}
.grp-header-btn:hover { background: rgba(255,255,255,0.12); color: white; }
.grp-header-btn.muted { color: #fbbf24; border-color: rgba(251,191,36,0.3); }

.grp-chat-box {
    flex: 1; overflow-y: auto; overflow-x: hidden;
    padding: 14px 12px; background: #f1f5f9;
    display: flex; flex-direction: column; gap: 3px;
    -webkit-overflow-scrolling: touch;
    min-height: 0; overscroll-behavior: contain;
}
.grp-chat-box::-webkit-scrollbar { width: 5px; }
.grp-chat-box::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

.grp-date-sep {
    display: flex; align-items: center; justify-content: center;
    margin: 10px 0 6px;
}
.grp-date-sep span {
    background: #cbd5e1; color: #475569;
    padding: 3px 14px; border-radius: 20px;
    font-size: 11px; font-weight: 600;
}

/* MENSAJE DE SISTEMA */
.grp-msg-system {
    display: flex; justify-content: center; margin: 6px 0;
}
.grp-msg-system-bubble {
    background: rgba(0,0,0,0.06); color: #64748b;
    padding: 5px 16px; border-radius: 20px;
    font-size: 12px; font-weight: 600; text-align: center;
    max-width: 80%;
}

.grp-msg-row { display: flex; max-width: 78%; margin-bottom: 1px; }
.grp-msg-row.mine { align-self: flex-end; }
.grp-msg-row.theirs { align-self: flex-start; gap: 8px; }

.grp-msg-avatar {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 11px; font-weight: 800;
    align-self: flex-end; overflow: hidden;
    text-decoration: none; cursor: pointer; transition: 0.2s;
}
.grp-msg-avatar:hover { transform: scale(1.1); }
.grp-msg-avatar img { width: 100%; height: 100%; object-fit: cover; }

.grp-msg-wrap { display: flex; flex-direction: column; }
.grp-msg-row.mine .grp-msg-wrap { align-items: flex-end; }
.grp-msg-row.theirs .grp-msg-wrap { align-items: flex-start; }

.grp-msg-sender {
    font-size: 11px; font-weight: 700; color: #6366f1;
    margin-bottom: 3px; padding: 0 4px;
    text-decoration: none; cursor: pointer;
}
.grp-msg-sender:hover { text-decoration: underline; }

.grp-msg-bubble {
    padding: 9px 13px 6px; border-radius: 18px;
    font-size: 14px; line-height: 1.55; word-break: break-word;
    max-width: min(300px, 72vw);
}
.grp-msg-row.mine .grp-msg-bubble {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; border-bottom-right-radius: 4px;
    box-shadow: 0 2px 10px rgba(99,102,241,0.3);
}
.grp-msg-row.theirs .grp-msg-bubble {
    background: white; color: #1e293b;
    border-bottom-left-radius: 4px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.grp-msg-media { max-width: 200px; border-radius: 12px; display: block; margin-top: 4px; cursor: pointer; }
.grp-msg-audio { width: 200px; height: 36px; margin-top: 4px; accent-color: #6366f1; }
.grp-msg-row.mine .grp-msg-audio { accent-color: white; }

.grp-msg-footer {
    display: flex; align-items: center; gap: 4px;
    margin-top: 3px; padding: 0 4px;
}
.grp-msg-time { font-size: 10px; color: #9ca3af; }
.grp-msg-check { font-size: 11px; color: #9ca3af; letter-spacing: -1px; }
.grp-msg-check.seen { color: #6366f1; font-weight: 700; }

/* BANNER NO MIEMBRO */
.grp-left-banner {
    flex-shrink: 0; padding: 14px 16px;
    background: rgba(251,191,36,0.08); border-top: 1px solid rgba(251,191,36,0.2);
    display: flex; align-items: center; gap: 10px;
    font-size: 13px; color: #92400e; font-weight: 600;
}

/* PREVIEW */
.grp-preview {
    flex-shrink: 0; padding: 8px 12px; background: white;
    border-top: 1px solid #e2e8f0; display: none; position: relative;
}
.grp-preview img, .grp-preview video { max-height: 100px; border-radius: 10px; }
.grp-preview-close {
    position: absolute; top: 4px; right: 12px;
    width: 22px; height: 22px; border-radius: 50%;
    background: #dc2626; color: white; border: none;
    font-size: 12px; cursor: pointer; display: flex; align-items: center; justify-content: center;
}

/* ocultar bottom nav en chat de grupo */
.ht-bottom-nav { display: none !important; }
body { padding-bottom: 0 !important; }

/* RECORDING */
.grp-recording {
    flex-shrink: 0; display: none; align-items: center; gap: 8px;
    padding: 6px 14px; background: #fef2f2; border-top: 1px solid #fecaca;
}
.grp-rec-dot { width: 9px; height: 9px; border-radius: 50%; background: #dc2626; animation: recPulse 1s infinite; }
@@keyframes recPulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
.grp-rec-label { font-size: 13px; font-weight: 600; color: #dc2626; flex: 1; }
.grp-rec-timer { font-size: 13px; font-weight: 700; color: #dc2626; }

/* AUDIO PREVIEW */
.grp-audio-preview {
    flex-shrink: 0; display: none;
    padding: 8px 12px; background: white; border-top: 1px solid #e2e8f0;
}
.grp-audio-preview audio { width: 100%; margin-bottom: 8px; }
.grp-audio-btns { display: flex; gap: 8px; }
.grp-audio-send {
    flex: 1; padding: 8px; border-radius: 10px; border: none;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
}
.grp-audio-cancel {
    padding: 8px 16px; border-radius: 10px; border: none;
    background: #fee2e2; color: #dc2626; font-size: 13px;
    font-weight: 700; cursor: pointer; font-family: inherit;
}

/* EMOJI */
.grp-emoji-panel {
    flex-shrink: 0; background: white;
    border-top: 1px solid #e2e8f0;
    padding: 8px 12px 10px; max-height: 220px; overflow-y: auto; display: none;
}
.grp-emoji-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(34px, 1fr)); gap: 2px; }
.grp-emoji-grid span { font-size: 22px; cursor: pointer; text-align: center; padding: 4px; border-radius: 8px; transition: 0.15s; }
.grp-emoji-grid span:hover { background: #f1f5f9; transform: scale(1.2); }

/* TYPING */
.grp-typing-indicator { display: none; flex-shrink: 0; padding: 0 14px 8px; }
.grp-typing-bubble {
    background: white; padding: 8px 14px; border-radius: 18px 18px 18px 4px;
    display: inline-flex; gap: 4px; align-items: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.grp-typing-dot { width: 6px; height: 6px; border-radius: 50%; background: #94a3b8; animation: typingBounce 1.2s infinite; }
.grp-typing-dot:nth-child(2) { animation-delay: 0.2s; }
.grp-typing-dot:nth-child(3) { animation-delay: 0.4s; }
@@keyframes typingBounce { 0%,60%,100%{transform:translateY(0);} 30%{transform:translateY(-5px);} }

/* INPUT BAR */
.grp-input-bar {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 12px 10px; background: white;
    border-top: 1px solid #e2e8f0; flex-shrink: 0;
}
.grp-bar-btn {
    width: 38px; height: 38px; border-radius: 50%;
    border: none; background: #f1f5f9; color: #64748b;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: 0.2s; flex-shrink: 0; font-size: 18px;
}
.grp-bar-btn:hover { background: #e2e8f0; color: #334155; }
.grp-bar-btn.active { background: #ede9fe; color: #6366f1; }
.grp-bar-btn.recording { background: #fee2e2; color: #dc2626; animation: recPulse 1s infinite; }
.grp-msg-input {
    flex: 1; min-width: 0; padding: 10px 16px;
    border: 1.5px solid #e2e8f0; border-radius: 24px;
    font-size: 14px; outline: none; background: #f8fafc;
    transition: 0.2s; color: #1e293b; font-family: inherit;
    resize: none; max-height: 100px;
}
.grp-msg-input:focus { border-color: #6366f1; background: white; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
.grp-send-btn {
    width: 40px; height: 40px; border-radius: 50%; border: none;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; cursor: pointer; transition: 0.2s;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; box-shadow: 0 4px 14px rgba(99,102,241,0.4);
}
.grp-send-btn:hover { transform: scale(1.08); }
.grp-send-btn:disabled { background: #cbd5e1; box-shadow: none; cursor: not-allowed; transform: none; }

/* DARK */
body.bg-dark .grp-chat-page { background: #0f172a !important; }
body.bg-dark .grp-chat-box { background: #0f172a !important; }
body.bg-dark .grp-msg-system-bubble { background: rgba(255,255,255,0.06) !important; color: #94a3b8 !important; }
body.bg-dark .grp-msg-row.theirs .grp-msg-bubble { background: #1e293b !important; color: #f1f5f9 !important; }
body.bg-dark .grp-input-bar { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .grp-msg-input { background: #0f172a !important; border-color: #334155 !important; color: #f1f5f9 !important; }
body.bg-dark .grp-bar-btn { background: #334155 !important; color: #94a3b8 !important; }
body.bg-dark .grp-emoji-panel { background: #1e293b !important; border-color: #334155 !important; }
body.bg-dark .grp-date-sep span { background: #334155 !important; color: #94a3b8 !important; }
body.bg-dark .grp-typing-bubble { background: #1e293b !important; }
body.bg-dark .grp-preview { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .grp-audio-preview { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .grp-left-banner { background: rgba(251,191,36,0.06) !important; }
</style>

<input type="file" id="grpFileInput" accept="image/*,video/*" style="display:none;" />

<div class="grp-chat-page">

    <!-- HEADER -->
    <div class="grp-header" onclick="window.location.href='/Group/Details/@Model.Id'">
        <div class="grp-header-avatar">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            { <img src="@Model.ImageUrl" /> }
            else
            { @Model.Name.Substring(0, 1).ToUpper() }
        </div>
        <div>
            <div class="grp-header-name">@Model.Name</div>
            <div class="grp-header-meta">@members.Count miembro@(members.Count != 1 ? "s" : "") · Toca para ver info</div>
        </div>
        <div class="grp-header-actions" onclick="event.stopPropagation()">
            <button type="button" class="grp-header-btn @(isMuted ? "muted" : "")"
                    id="muteBtn" onclick="toggleMute()" data-no-loader>
                @(isMuted ? "🔕" : "🔔")
            </button>
            <a asp-controller="Group" asp-action="Index" class="grp-header-btn" data-no-loader>← Grupos</a>
        </div>
    </div>

    <!-- CHAT BOX -->
    <div class="grp-chat-box" id="chatBox">
        @if (!messages.Any())
        {
            <div id="emptyState" style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:#9ca3af;text-align:center;padding:40px;">
                <div style="font-size:48px;">💬</div>
                <div style="font-size:16px;font-weight:700;color:#374151;">¡Sé el primero en escribir!</div>
                <div style="font-size:13px;">Empieza la conversación del grupo.</div>
            </div>
        }
        else
        {
            var grouped = messages.GroupBy(m => m.SentAt.ToLocalTime().Date).OrderBy(g => g.Key);
            foreach (var grp in grouped)
            {
                var today = DateTime.Today;
                var yesterday = today.AddDays(-1);
                string dateLabel = grp.Key == today ? "Hoy" :
                                   grp.Key == yesterday ? "Ayer" :
                                   grp.Key.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"));
                <div class="grp-date-sep"><span>@dateLabel</span></div>

                foreach (var msg in grp.OrderBy(m => m.SentAt))
                {
                    // 🔥 mensaje de sistema
                    if (msg.IsSystem)
                    {
                        <div class="grp-msg-system">
                            <div class="grp-msg-system-bubble">@msg.Content</div>
                        </div>
                        continue;
                    }

                    bool isMine = msg.SenderId == currentUserId;
                    var senderImg = msg.Sender?.ProfileImage ?? msg.Sender?.ProfilePicture ?? "";
                    var senderLetter = (msg.Sender?.Username ?? "?").Substring(0, 1).ToUpper();
                    var readCount = msg.Reads?.Count(r => r.UserId != msg.SenderId) ?? 0;
                    bool allRead = readCount >= totalMembers - 1 && totalMembers > 1;

                    bool isAudio = !string.IsNullOrEmpty(msg.Content) &&
                                   (msg.Content.Contains("cloudinary") || msg.Content.Contains("/audios/") || msg.Content.EndsWith(".webm"));
                    bool isImage = !string.IsNullOrEmpty(msg.FileUrl) &&
                                   (msg.FileUrl.Contains("/image/upload/") || msg.FileUrl.EndsWith(".jpg") || msg.FileUrl.EndsWith(".png") || msg.FileUrl.EndsWith(".jpeg"));
                    bool isVideo = !string.IsNullOrEmpty(msg.FileUrl) &&
                                   (msg.FileUrl.Contains("/video/upload/") || msg.FileUrl.EndsWith(".mp4") || msg.FileUrl.EndsWith(".webm"));

                    <div class="grp-msg-row @(isMine ? "mine" : "theirs")" id="msg-@msg.Id">
                        @if (!isMine)
                        {
                            <a href="/User/Profile/@msg.SenderId" class="grp-msg-avatar">
                                @if (!string.IsNullOrEmpty(senderImg))
                                { <img src="@senderImg" /> }
                                else { @senderLetter }
                            </a>
                        }
                        <div class="grp-msg-wrap">
                            @if (!isMine)
                            {
                                <a href="/User/Profile/@msg.SenderId" class="grp-msg-sender">
                                    @msg.Sender?.Username
                                </a>
                            }
                            <div class="grp-msg-bubble">
                                @if (isAudio)
                                {
                                    <audio controls class="grp-msg-audio"><source src="@msg.Content" /></audio>
                                }
                                else if (isImage)
                                {
                                    <img src="@msg.FileUrl" class="grp-msg-media" onclick="window.open('@msg.FileUrl', '_blank')" />
                                }
                                else if (isVideo)
                                {
                                    <video controls class="grp-msg-media"><source src="@msg.FileUrl" /></video>
                                }
                                else if (!string.IsNullOrEmpty(msg.Content))
                                { @msg.Content }
                            </div>
                            <div class="grp-msg-footer">
                                <span class="grp-msg-time">@msg.SentAt.ToLocalTime().ToString("hh:mm tt")</span>
                                @if (isMine)
                                {
                                    <span class="grp-msg-check @(allRead ? "seen" : "")" id="check-@msg.Id">
                                        @(allRead ? "✔✔" : "✔")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        }

        <div class="grp-typing-indicator" id="typingIndicator">
            <div class="grp-typing-bubble">
                <div class="grp-typing-dot"></div>
                <div class="grp-typing-dot"></div>
                <div class="grp-typing-dot"></div>
            </div>
        </div>
    </div>

    @if (!isMember)
    {
        <!-- BANNER SALISTE DEL GRUPO -->
        <div class="grp-left-banner">
            <span>⚠️</span>
            <span>Ya no eres miembro de este grupo. Solo puedes ver el historial.</span>
        </div>
    }
    else
    {
        <!-- PREVIEW ARCHIVO -->
        <div class="grp-preview" id="grpPreview">
            <button class="grp-preview-close" onclick="cancelarArchivo()">✕</button>
            <img id="grpPreviewImg" style="display:none;" />
            <video id="grpPreviewVid" controls style="display:none;"></video>
        </div>

        <!-- RECORDING STATUS -->
        <div class="grp-recording" id="grpRecording">
            <div class="grp-rec-dot"></div>
            <span class="grp-rec-label">Grabando audio...</span>
            <span class="grp-rec-timer" id="grpRecTimer">0:00</span>
        </div>

        <!-- AUDIO PREVIEW -->
        <div class="grp-audio-preview" id="grpAudioPreview">
            <audio id="grpPreviewAudio" controls></audio>
            <div class="grp-audio-btns">
                <button class="grp-audio-send" onclick="enviarAudio()">📤 Enviar audio</button>
                <button class="grp-audio-cancel" onclick="cancelarAudio()">Cancelar</button>
            </div>
        </div>

        <!-- EMOJI -->
        <div class="grp-emoji-panel" id="emojiPanel">
            <div class="grp-emoji-grid">
                @foreach (var e in new[]{"😀","😃","😄","😁","😆","😅","🤣","😂","🙂","😉","😊","😇","🥰","😍","🤩","😘","😋","😛","😜","🤪","😝","🤑","🤗","🤭","🤫","🤔","😐","😑","😶","😏","😒","🙄","😬","🤥","😌","😔","😪","😴","😷","🤒","🤕","🤢","🤮","🤧","🥵","🥶","😵","🤯","🤠","🥳","😎","🤓","😕","😟","🙁","☹️","😮","😲","😳","🥺","😦","😧","😨","😰","😥","😢","😭","😱","😖","😣","😞","😓","😩","😫","🤬","😤","😠","😡","💀","👻","👽","🤖","👋","✋","👌","✌️","🤞","👍","👎","✊","👊","👏","🙌","🙏","💪","❤️","🧡","💛","💚","💙","💜","🖤","💔","🔥","⚡","🌈","☀️","🌙","⭐","🌟","💫","✨","🎉","🎊","🎈","🎁","🏆","🥇","👑","🚀","💯","✅","❌","⚠️"})
                { <span onclick="addGroupEmoji('@e')">@e</span> }
            </div>
        </div>

        <!-- INPUT BAR -->
        <div class="grp-input-bar">
            <button type="button" class="grp-bar-btn" id="emojiBtn" onclick="toggleGroupEmoji()" data-no-loader>😊</button>
            <button type="button" class="grp-bar-btn" onclick="document.getElementById('grpFileInput').click()" data-no-loader title="Adjuntar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/>
                </svg>
            </button>
            <button type="button" class="grp-bar-btn" id="grpRecBtn" onclick="toggleGrabacion()" data-no-loader title="Audio">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/>
                    <path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/>
                </svg>
            </button>
            <textarea id="msgInput" class="grp-msg-input" rows="1" placeholder="Escribe un mensaje..."></textarea>
        <button class="grp-send-btn" id="sendBtn" data-no-loader disabled>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
            </button>
        </div>
    }

</div>

@Html.AntiForgeryToken()

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const groupId = @Model.Id;
const myId = "@User.FindFirst("UserId").Value";
const myName = "@User.Identity.Name";
let currentTotalMembers = @totalMembers;
let isMuted = @isMuted.ToString().ToLower();
const chatBox = document.getElementById("chatBox");
// 🔥 fix teclado virtual móvil
if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", () => {
        const chatPage = document.querySelector(".grp-chat-page");
        if (chatPage) {
            const vh = window.visualViewport.height;
            chatPage.style.height = vh + "px";
            chatPage.style.top = window.visualViewport.offsetTop + "px";
        }
        chatBox.scrollTop = chatBox.scrollHeight;
    });
}

// 🔥 focus en input mueve scroll al final
if (msgInput) {
    msgInput.addEventListener("focus", () => {
        setTimeout(() => chatBox.scrollTop = chatBox.scrollHeight, 300);
    });
}
const msgInput = document.getElementById("msgInput");
const sendBtn = document.getElementById("sendBtn");
let selectedFile = null;
let mediaRecorder = null, audioChunks = [], isRecording = false, recInterval = null;
let recordedBlob = null;



window.addEventListener("load", () => chatBox.scrollTop = chatBox.scrollHeight);

const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";

// 🔥 marcar como leído al abrir
fetch("/Group/MarkRead", {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
}).then(r => r.json()).then(data => {
    if (data.readIds) {
        data.readIds.forEach(msgId => {
            grpConnection.invoke("NotifyGroupRead", groupId.toString(), msgId.toString()).catch(() => {});
        });
    }
});

// SignalR
const grpConnection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub").withAutomaticReconnect().build();

grpConnection.start().then(async () => {
    await grpConnection.invoke("JoinUserGroup", myId);
    await grpConnection.invoke("JoinGroupChat", groupId.toString());
}).catch(err => console.error("SignalR grupo:", err));

// 🔥 recibir mensaje
grpConnection.on("ReceiveGroupMessage", (senderId, senderName, senderImage, content, time, msgId, fileUrl, fileType) => {
    if (String(senderId) === String(myId)) return;
    const empty = document.getElementById("emptyState");
    if (empty) empty.remove();

    // mensaje de sistema
    if (fileType === "system" || senderId === "0") {
        const row = document.createElement("div");
        row.className = "grp-msg-system";
        row.innerHTML = `<div class="grp-msg-system-bubble">${escapeHtml(content)}</div>`;
        chatBox.insertBefore(row, document.getElementById("typingIndicator"));
        chatBox.scrollTop = chatBox.scrollHeight;
        return;
    }

    const letter = senderName ? senderName.charAt(0).toUpperCase() : "?";
    const avatarHTML = (senderImage && senderImage.trim() !== "")
        ? `<img src="${senderImage}" style="width:100%;height:100%;object-fit:cover;" />`
        : letter;

    let contentHTML = "";
    if (fileType === "audio")
        contentHTML = `<audio controls class="grp-msg-audio"><source src="${content}" /></audio>`;
    else if (fileType === "image")
        contentHTML = `<img src="${fileUrl}" class="grp-msg-media" onclick="window.open('${fileUrl}', '_blank')" />`;
    else if (fileType === "video")
        contentHTML = `<video controls class="grp-msg-media"><source src="${fileUrl}" /></video>`;
    else
        contentHTML = escapeHtml(content);

    const row = document.createElement("div");
    row.className = "grp-msg-row theirs";
    if (msgId) row.id = "msg-" + msgId;
    row.innerHTML = `
        <a href="/User/Profile/${senderId}" class="grp-msg-avatar">${avatarHTML}</a>
        <div class="grp-msg-wrap">
            <a href="/User/Profile/${senderId}" class="grp-msg-sender">${senderName}</a>
            <div class="grp-msg-bubble">${contentHTML}</div>
            <div class="grp-msg-footer"><span class="grp-msg-time">${time}</span></div>
        </div>`;

    chatBox.insertBefore(row, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;

    fetch("/Group/MarkRead", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    }).then(r => r.json()).then(data => {
        if (data.readIds) {
            data.readIds.forEach(id => {
                grpConnection.invoke("NotifyGroupRead", groupId.toString(), id.toString()).catch(() => {});
            });
        }
    });
});

// 🔥 chulos
grpConnection.on("GroupMessageRead", (msgId, readCount) => {
    const check = document.getElementById("check-" + msgId);
    if (!check) return;
    const allRead = parseInt(readCount) >= currentTotalMembers - 1 && currentTotalMembers > 1;
    check.textContent = allRead ? "✔✔" : "✔";
    if (allRead) check.classList.add("seen");
    else check.classList.remove("seen");
});

grpConnection.on("GroupUserTyping", (senderName) => {
    if (senderName === myName) return;
    document.getElementById("typingIndicator").style.display = "block";
    chatBox.scrollTop = chatBox.scrollHeight;
});
grpConnection.on("GroupUserStoppedTyping", () => {
    document.getElementById("typingIndicator").style.display = "none";
});

// 🔥 para TODOS en el chat — mostrar mensaje de sistema
grpConnection.on("MemberRemovedFromGroup", (removedUserId, systemMessage) => {
    const empty = document.getElementById("emptyState");
    if (empty) empty.remove();

    const sysRow = document.createElement("div");
    sysRow.className = "grp-msg-system";
    sysRow.innerHTML = `<div class="grp-msg-system-bubble">${escapeHtml(systemMessage)}</div>`;
    chatBox.insertBefore(sysRow, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;
});

// 🔥 para EL ELIMINADO — bloquear chat en tiempo real
grpConnection.on("YouWereRemovedFromGroup", (removedGroupId, message) => {
    if (String(removedGroupId) !== String(groupId)) return;

    const empty = document.getElementById("emptyState");
    if (empty) empty.remove();

    // mensaje de sistema rojo
    const sysRow = document.createElement("div");
    sysRow.className = "grp-msg-system";
    sysRow.innerHTML = `<div class="grp-msg-system-bubble" style="background:rgba(239,68,68,0.1);color:#dc2626;border:1px solid rgba(239,68,68,0.2);">${escapeHtml(message)}</div>`;
    chatBox.insertBefore(sysRow, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;

    // quitar controles
    document.querySelector(".grp-input-bar")?.remove();
    document.getElementById("grpPreview")?.remove();
    document.getElementById("grpAudioPreview")?.remove();
    document.getElementById("grpRecording")?.remove();
    document.getElementById("emojiPanel")?.remove();

    // banner rojo
    const banner = document.createElement("div");
    banner.style.cssText = "flex-shrink:0;padding:14px 16px;background:rgba(239,68,68,0.1);border-top:1px solid rgba(239,68,68,0.2);display:flex;align-items:center;gap:10px;font-size:13px;color:#dc2626;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;";
    banner.innerHTML = `<span>🚫</span><span>${escapeHtml(message)}</span>`;
    document.querySelector(".grp-chat-page").appendChild(banner);

    showToast("🚫 " + message);
});

// 🔥 silenciar
async function toggleMute() {
    const res = await fetch("/Group/ToggleMute", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    });
    const data = await res.json();
    if (data.success) {
        isMuted = data.isMuted;
        const btn = document.getElementById("muteBtn");
        btn.textContent = isMuted ? "🔕" : "🔔";
        btn.classList.toggle("muted", isMuted);
        showToast(isMuted ? "🔕 Notificaciones silenciadas" : "🔔 Notificaciones activadas");
    }
}

function showToast(msg) {
    const t = document.createElement("div");
    t.style.cssText = "position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#1e293b;color:white;padding:10px 20px;border-radius:20px;font-size:13px;font-weight:600;z-index:99999;box-shadow:0 4px 20px rgba(0,0,0,0.3);font-family:'Plus Jakarta Sans',sans-serif;";
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
}

if (document.getElementById("msgInput")) {
    msgInput.addEventListener("input", function() {
        this.style.height = "auto";
        this.style.height = Math.min(this.scrollHeight, 100) + "px";
        sendBtn.disabled = this.value.trim() === "" && !selectedFile;
        grpConnection.invoke("GroupUserTyping", groupId.toString(), myName).catch(() => {});
        clearTimeout(window.grpTypingTimer);
        window.grpTypingTimer = setTimeout(() => {
            grpConnection.invoke("GroupUserStoppedTyping", groupId.toString()).catch(() => {});
        }, 1500);
    });

    msgInput.addEventListener("keydown", function(e) {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendGroupMessage(); }
    });
}

document.getElementById("grpFileInput")?.addEventListener("change", function() {
    const file = this.files[0]; if (!file) return;
    selectedFile = file;
    const url = URL.createObjectURL(file);
    const preview = document.getElementById("grpPreview");
    const img = document.getElementById("grpPreviewImg");
    const vid = document.getElementById("grpPreviewVid");
    preview.style.display = "block";
    if (file.type.startsWith("image")) {
        img.src = url; img.style.display = "block"; vid.style.display = "none";
    } else {
        vid.src = url; vid.style.display = "block"; img.style.display = "none";
    }
    sendBtn.disabled = false;
});

function cancelarArchivo() {
    selectedFile = null;
    document.getElementById("grpFileInput").value = "";
    document.getElementById("grpPreview").style.display = "none";
    document.getElementById("grpPreviewImg").style.display = "none";
    document.getElementById("grpPreviewVid").style.display = "none";
    sendBtn.disabled = msgInput?.value.trim() === "";
}

async function toggleGrabacion() {
    if (isRecording) {
        mediaRecorder.stop(); isRecording = false;
        clearInterval(recInterval);
        document.getElementById("grpRecording").style.display = "none";
        document.getElementById("grpRecBtn").classList.remove("recording");
        return;
    }
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = []; isRecording = true;
        document.getElementById("grpRecording").style.display = "flex";
        document.getElementById("grpRecBtn").classList.add("recording");
        let secs = 0;
        recInterval = setInterval(() => {
            secs++;
            document.getElementById("grpRecTimer").textContent =
                `${Math.floor(secs/60)}:${String(secs%60).padStart(2,"0")}`;
        }, 1000);
        mediaRecorder.ondataavailable = e => { if (e.data?.size > 0) audioChunks.push(e.data); };
        mediaRecorder.onstop = () => {
            stream.getTracks().forEach(t => t.stop());
            recordedBlob = new Blob(audioChunks, { type: "audio/webm" });
            document.getElementById("grpPreviewAudio").src = URL.createObjectURL(recordedBlob);
            document.getElementById("grpAudioPreview").style.display = "block";
        };
        mediaRecorder.start();
    } catch (err) { alert("No se pudo acceder al micrófono."); }
}

async function enviarAudio() {
    if (!recordedBlob) return;
    document.getElementById("grpAudioPreview").style.display = "none";
    const formData = new FormData();
    formData.append("audio", recordedBlob, "audio.webm");
    formData.append("groupId", groupId);
    formData.append("__RequestVerificationToken", token());
    const tempId = "temp-" + Date.now();
    agregarBurbujaMia(`<audio controls class="grp-msg-audio"><source src="${URL.createObjectURL(recordedBlob)}" /></audio>`, tempId);
    try {
        const res = await fetch("/Group/SendAudio", { method: "POST", body: formData });
        const data = await res.json();
        if (data.success) {
            const row = document.getElementById(tempId);
            if (row) row.id = "msg-" + data.id;
            const check = document.getElementById("check-" + tempId);
            if (check) check.id = "check-" + data.id;
            currentTotalMembers = data.totalMembers;
            await grpConnection.invoke("SendGroupMessage", groupId.toString(), myId, myName, data.audioUrl, data.id.toString(), "", "audio");
        }
    } catch (err) { console.error(err); }
    recordedBlob = null;
}

function cancelarAudio() {
    recordedBlob = null;
    document.getElementById("grpAudioPreview").style.display = "none";
    document.getElementById("grpPreviewAudio").src = "";
}

function makeTime() {
    return new Date().toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' });
}

function escapeHtml(text) {
    return String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;")
                       .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

function agregarBurbujaMia(contentHTML, tempId) {
    const empty = document.getElementById("emptyState");
    if (empty) empty.remove();
    const row = document.createElement("div");
    row.className = "grp-msg-row mine";
    row.id = tempId;
    row.innerHTML = `
        <div class="grp-msg-wrap">
            <div class="grp-msg-bubble">${contentHTML}</div>
            <div class="grp-msg-footer">
                <span class="grp-msg-time">${makeTime()}</span>
                <span class="grp-msg-check" id="check-${tempId}">✔</span>
            </div>
        </div>`;
    chatBox.insertBefore(row, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;
    return row;
}

async function sendGroupMessage() {
    const content = msgInput.value.trim();
    if (!content && !selectedFile) return;
    const tempId = "temp-" + Date.now();
    msgInput.value = ""; msgInput.style.height = "auto";
    sendBtn.disabled = true;

    if (selectedFile) {
        const file = selectedFile; selectedFile = null;
        cancelarArchivo();
        const url = URL.createObjectURL(file);
        const isImg = file.type.startsWith("image");
        const previewHTML = isImg
            ? `<img src="${url}" class="grp-msg-media" />`
            : `<video controls class="grp-msg-media"><source src="${url}" /></video>`;
        agregarBurbujaMia(previewHTML, tempId);
        const formData = new FormData();
        formData.append("file", file);
        formData.append("groupId", groupId);
        formData.append("__RequestVerificationToken", token());
        try {
            const res = await fetch("/Group/SendFile", { method: "POST", body: formData });
            const data = await res.json();
            if (data.success) {
                const row = document.getElementById(tempId);
                if (row) row.id = "msg-" + data.id;
                const check = document.getElementById("check-" + tempId);
                if (check) check.id = "check-" + data.id;
                currentTotalMembers = data.totalMembers;
                await grpConnection.invoke("SendGroupMessage", groupId.toString(), myId, myName, "", data.id.toString(), data.fileUrl, data.fileType);
            }
        } catch (err) { console.error(err); }
    } else {
        agregarBurbujaMia(escapeHtml(content), tempId);
        try {
            const res = await fetch("/Group/SendMessage", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `groupId=${groupId}&content=${encodeURIComponent(content)}&__RequestVerificationToken=${encodeURIComponent(token())}`
            });
            const data = await res.json();
            if (data.success) {
                const row = document.getElementById(tempId);
                if (row) row.id = "msg-" + data.id;
                const check = document.getElementById("check-" + tempId);
                if (check) check.id = "check-" + data.id;
                currentTotalMembers = data.totalMembers;
                await grpConnection.invoke("SendGroupMessage", groupId.toString(), myId, myName, content, data.id.toString(), "", "text");
            } else {
                document.getElementById(tempId)?.remove();
            }
        } catch (err) {
            console.error(err);
            document.getElementById(tempId)?.remove();
        }
    }
    msgInput.focus();
}

// 🔥 fix teclado virtual móvil
if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", () => {
        const chatPage = document.querySelector(".grp-chat-page");
        if (chatPage) {
            chatPage.style.height = window.visualViewport.height + "px";
        }
    });
}

function toggleGroupEmoji() {
    const panel = document.getElementById("emojiPanel");
    const btn = document.getElementById("emojiBtn");
    const isOpen = panel.style.display === "block";
    panel.style.display = isOpen ? "none" : "block";
    btn.classList.toggle("active", !isOpen);
}

function addGroupEmoji(emoji) {
    msgInput.value += emoji; msgInput.focus();
    sendBtn.disabled = msgInput.value.trim() === "" && !selectedFile;
}

document.addEventListener("click", (e) => {
    if (!e.target.closest("#emojiBtn") && !e.target.closest("#emojiPanel")) {
        const panel = document.getElementById("emojiPanel");
        if (panel) panel.style.display = "none";
        document.getElementById("emojiBtn")?.classList.remove("active");
    }
});
</script>