function responderMensaje(msgId, senderName, content) {
    replyToMessageId = msgId;
    replyToSender = senderName;

    // Detectar si es imagen, video o audio
    const msgEl = document.getElementById("msg-" + msgId);
    let previewText = content;
    let previewHTML = "";

    if (msgEl) {
        const img = msgEl.querySelector(".grp-msg-media[src]");
        const vid = msgEl.querySelector("video");
        const aud = msgEl.querySelector("audio");
        if (img && img.tagName === "IMG") {
            previewText = "📷 Foto";
            previewHTML = `<img src="${img.src}" style="height:40px;border-radius:6px;margin-top:4px;" />`;
        } else if (vid) {
            previewText = "🎥 Video";
        } else if (aud) {
            previewText = "🎵 Audio";
        }
    }

    replyToContent = previewText;
    document.getElementById("grpReplyName").textContent = senderName;
    document.getElementById("grpReplyText").textContent = previewText;
    if (previewHTML) {
        document.getElementById("grpReplyText").innerHTML = previewHTML;
    }
    document.getElementById("grpReplyPreview").style.display = "flex";
    if (msgInput) msgInput.focus();
}

