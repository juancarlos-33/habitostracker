@Html.AntiForgeryToken()

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const groupId = @Model.Id;
const myId = "@User.FindFirst("UserId").Value";
const myName = "@User.Identity.Name";
let currentTotalMembers = @totalMembers;
let isMuted = @isMuted.ToString().ToLower();
const chatBox = document.getElementById("chatBox");
const msgInput = document.getElementById("msgInput");
const sendBtn = document.getElementById("sendBtn");
let selectedFile = null;
let mediaRecorder = null, audioChunks = [], isRecording = false, recInterval = null;
let recordedBlob = null;
let activeUsersInChat = 1;
let replyToMessageId = null;
let replyToContent = "";
let replyToSender = "";

function scrollToBottom(smooth) {
    if (smooth) chatBox.style.scrollBehavior = 'smooth';
    chatBox.scrollTop = chatBox.scrollHeight;
    if (smooth) setTimeout(() => chatBox.style.scrollBehavior = 'auto', 400);
}

function mostrarBannerNoLeidos(count) {
    document.getElementById('unreadBanner')?.remove();
    const banner = document.createElement('div');
    banner.id = 'unreadBanner';
    banner.style.cssText = 'position:sticky;bottom:10px;left:0;right:0;display:flex;justify-content:center;z-index:10;pointer-events:none;';
    banner.innerHTML = `<div style="background:rgba(99,102,241,0.92);color:white;padding:6px 18px;border-radius:20px;font-size:12px;font-weight:700;box-shadow:0 4px 14px rgba(99,102,241,0.4);backdrop-filter:blur(8px);pointer-events:all;cursor:pointer;" onclick="scrollToBottom(true);this.parentElement.remove();">↓ ${count} mensaje${count!==1?'s':''} no leído${count!==1?'s':''}</div>`;
    chatBox.appendChild(banner);
    setTimeout(() => banner.remove(), 5000);
}

window.addEventListener("load", () => {
    const firstUnreadId = @firstUnreadId;
    const unreadCount = @unreadCount;
    if (firstUnreadId > 0 && unreadCount > 0) {
        const sep = document.getElementById("unreadSeparator");
        if (sep) {
            sep.scrollIntoView({ behavior: "auto", block: "center" });
            setTimeout(() => {
                sep.style.transition = "opacity 0.5s";
                sep.style.opacity = "0";
                setTimeout(() => sep.remove(), 500);
            }, 5000);
        } else {
            setTimeout(() => { chatBox.scrollTop = chatBox.scrollHeight; }, 100);
        }
    } else {
        setTimeout(() => { chatBox.scrollTop = chatBox.scrollHeight; }, 100);
    }
});

if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", () => {
        const chatPage = document.querySelector(".grp-chat-page");
        if (chatPage && window.innerWidth < 768) {
            chatPage.style.height = window.visualViewport.height + "px";
            chatPage.style.top = (window.visualViewport.offsetTop || 0) + "px";
        }
        chatBox.scrollTop = chatBox.scrollHeight;
    });
}

if (msgInput) {
    msgInput.addEventListener("focus", () => { setTimeout(() => chatBox.scrollTop = chatBox.scrollHeight, 300); });
}

function ajustarAltura() {
    const navbar = document.querySelector('.ht-navbar');
    const chatPage = document.querySelector('.grp-chat-page');
    if (!chatPage) return;
    if (window.innerWidth >= 768) {
        const navH = navbar ? navbar.getBoundingClientRect().bottom : 0;
        chatPage.style.height = (window.innerHeight - navH) + 'px';
    }
}
ajustarAltura();
window.addEventListener('resize', ajustarAltura);
window.addEventListener('load', ajustarAltura);
setTimeout(ajustarAltura, 100);
setTimeout(ajustarAltura, 500);

const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";

const grpConnection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub").withAutomaticReconnect().build();

grpConnection.start().then(async () => {
    await grpConnection.invoke("JoinUserGroup", myId);
    await grpConnection.invoke("JoinGroupChat", groupId.toString());
    fetch("/Group/MarkRead", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    }).then(r => r.json()).then(data => {
        if (data.readIds) data.readIds.forEach(msgId =>
            grpConnection.invoke("NotifyGroupRead", groupId.toString(), msgId.toString()).catch(() => {}));
    }).catch(() => {});
}).catch(err => console.error("SignalR grupo:", err));

grpConnection.on("GroupActiveUsers", (gId, count) => {
    if (String(gId) === String(groupId)) activeUsersInChat = count;
});

grpConnection.on("ReceiveGroupMessage", (senderId, senderName, senderImage, content, time, msgId, fileUrl, fileType, replyData) => {
    let replyToMessageId = "", replySender = "", replyContent = "";
    if (replyData && replyData !== "||") {
        const parts = replyData.split("|");
        replyToMessageId = parts[0] ?? "";
        replySender = parts[1] ?? "";
        replyContent = parts[2] ?? "";
    }
    if (String(senderId) === String(myId)) return;
    document.getElementById("emptyState")?.remove();
    document.getElementById('unreadBanner')?.remove();
    if (fileType === "system" || senderId === "0") {
        const row = document.createElement("div");
        row.className = "grp-msg-system";
        row.innerHTML = `<div class="grp-msg-system-bubble">${escapeHtml(content)}</div>`;
        chatBox.insertBefore(row, document.getElementById("typingIndicator"));
        chatBox.scrollTop = chatBox.scrollHeight; return;
    }
    const letter = senderName ? senderName.charAt(0).toUpperCase() : "?";
    const avatarHTML = (senderImage && senderImage.trim() !== "")
        ? `<img src="${senderImage}" style="width:100%;height:100%;object-fit:cover;" />` : letter;
    let contentHTML = "";
    if (fileType === "audio") contentHTML = `<audio controls class="grp-msg-audio"><source src="${content}" /></audio>`;
    else if (fileType === "image") contentHTML = `<img src="${fileUrl}" class="grp-msg-media" onclick="window.open('${fileUrl}', '_blank')" />`;
    else if (fileType === "video") contentHTML = `<video controls class="grp-msg-media"><source src="${fileUrl}" /></video>`;
    else contentHTML = escapeHtml(content);

    const replyHTML = (replyToMessageId && replyContent)
        ? `<div class="grp-msg-reply" onclick="scrollToMessage(${replyToMessageId})">
            <div class="grp-msg-reply-name">${escapeHtml(replySender)}</div>
            <div class="grp-msg-reply-text">${escapeHtml(replyContent.length > 50 ? replyContent.substring(0, 50) + '...' : replyContent)}</div>
           </div>` : '';

    const row = document.createElement("div");
    row.className = "grp-msg-row theirs";
    if (msgId) row.id = "msg-" + msgId;
  row.innerHTML = `<a href="/User/Profile/${senderId}" class="grp-msg-avatar">${avatarHTML}</a><div class="grp-msg-wrap"><a href="/User/Profile/${senderId}" class="grp-msg-sender">${escapeHtml(senderName)}</a><div class="grp-msg-bubble" oncontextmenu="abrirReactionPicker(event,${msgId})" ondblclick="responderMensaje(${msgId},'${escapeHtml(senderName)}','${escapeHtml(content)}')" style="position:relative;">${replyHTML}${contentHTML}</div><div class="grp-msg-footer"><span class="grp-msg-time">${time}</span></div></div><div class="grp-reactions" id="reactions-${msgId}"></div></div>`;
    chatBox.insertBefore(row, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;
    fetch("/Group/MarkRead", {
        method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    }).then(r => r.json()).then(data => {
        if (data.readIds) data.readIds.forEach(id =>
            grpConnection.invoke("NotifyGroupRead", groupId.toString(), id.toString()).catch(() => {}));
    }).catch(() => {});
});

grpConnection.on("GroupMessageRead", (msgId, readCount, activeInChat) => {
    const check = document.getElementById("check-" + msgId); if (!check) return;
    const inChat = activeInChat !== undefined ? activeInChat : activeUsersInChat;
    const allInChat = inChat >= currentTotalMembers;
    const allRead = parseInt(readCount) >= currentTotalMembers - 1 && currentTotalMembers > 1;
    if (allInChat) { check.textContent = "✔✔"; check.classList.add("seen"); }
    else if (allRead) { check.textContent = "✔✔"; check.classList.remove("seen"); }
    else { check.textContent = "✔"; check.classList.remove("seen"); }
});

grpConnection.on("GroupUserTyping", (senderName) => {
    if (senderName === myName) return;
    document.getElementById("typingIndicator").style.display = "block";
    chatBox.scrollTop = chatBox.scrollHeight;
});
grpConnection.on("GroupUserStoppedTyping", () => {
    document.getElementById("typingIndicator").style.display = "none";
});

grpConnection.on("MemberRemovedFromGroup", (removedUserId, systemMessage) => {
    document.getElementById("emptyState")?.remove();
    const sysRow = document.createElement("div"); sysRow.className = "grp-msg-system";
    sysRow.innerHTML = `<div class="grp-msg-system-bubble">${escapeHtml(systemMessage)}</div>`;
    chatBox.insertBefore(sysRow, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;
});

grpConnection.on("YouWereRemovedFromGroup", (removedGroupId, message) => {
    if (String(removedGroupId) !== String(groupId)) return;
    document.getElementById("emptyState")?.remove();
    const sysRow = document.createElement("div"); sysRow.className = "grp-msg-system";
