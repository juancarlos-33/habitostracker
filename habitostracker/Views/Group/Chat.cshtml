body.bg-dark #emptyState .empty-title { color: #f1f5f9 !important; }
</style>

<input type="file" id="grpFileInput" accept="image/*,video/*" style="display:none;" />

<div class="grp-chat-page">

    <div class="grp-header" onclick="window.location.href='/Group/Details/@Model.Id'">
        <div class="grp-header-avatar">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            { <img src="@Model.ImageUrl" /> }
            else
            { @Model.Name.Substring(0, 1).ToUpper() }
        </div>
        <div>
            <div class="grp-header-name">@Model.Name</div>
            <div class="grp-header-meta">@members.Count miembro@(members.Count != 1 ? "s" : "") · Toca para ver info</div>
        </div>
        <div class="grp-header-actions" onclick="event.stopPropagation()">
            <button type="button" class="grp-header-btn @(isMuted ? "muted" : "")" id="muteBtn" onclick="toggleMute()" data-no-loader>
                @(isMuted ? "🔕" : "🔔")
            </button>
            <a asp-controller="Group" asp-action="Index" class="grp-header-btn" data-no-loader>← Grupos</a>
        </div>
    </div>

    <div class="grp-chat-box" id="chatBox">
        @if (!messages.Any())
        {
            <div id="emptyState">
                <div class="empty-icon">💬</div>
                <div class="empty-title">¡Sé el primero en escribir!</div>
                <div>Empieza la conversación del grupo.</div>
            </div>
        }
        else
        {
            var grouped = messages.GroupBy(m => m.SentAt.ToLocalTime().Date).OrderBy(g => g.Key);
            foreach (var grp in grouped)
            {
                var today = DateTime.Today;
                var yesterday = today.AddDays(-1);
                string dateLabel = grp.Key == today ? "Hoy" :
                                   grp.Key == yesterday ? "Ayer" :
                                   grp.Key.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"));
                <div class="grp-date-sep"><span>@dateLabel</span></div>
                foreach (var msg in grp.OrderBy(m => m.SentAt))
                {
                    if (msg.IsSystem)
                    {
                        <div class="grp-msg-system">
                            <div class="grp-msg-system-bubble">@msg.Content</div>
                        </div>
                        continue;
                    }
                    bool isMine = msg.SenderId == currentUserId;
                    var senderImg = msg.Sender?.ProfileImage ?? msg.Sender?.ProfilePicture ?? "";
                    var senderLetter = (msg.Sender?.Username ?? "?").Substring(0, 1).ToUpper();
                    var readCount = msg.Reads?.Count(r => r.UserId != msg.SenderId) ?? 0;
                    bool allRead = readCount >= totalMembers - 1 && totalMembers > 1;
    
// ========== DETECCIÓN DE TIPO DE CONTENIDO ==========
bool isImage = !string.IsNullOrEmpty(msg.FileUrl) &&
               (msg.FileUrl.Contains("/image/upload/") || msg.FileUrl.EndsWith(".jpg") || msg.FileUrl.EndsWith(".png") || msg.FileUrl.EndsWith(".jpeg"));
bool isVideo = !string.IsNullOrEmpty(msg.FileUrl) &&
               (msg.FileUrl.Contains("/video/upload/") || msg.FileUrl.EndsWith(".mp4") || msg.FileUrl.EndsWith(".webm"));
bool isAudio = false;
if (!string.IsNullOrEmpty(msg.FileUrl) && (msg.FileUrl.Contains("/audio/upload/") || msg.FileUrl.EndsWith(".webm") || msg.FileUrl.Contains("audio")))
    isAudio = true;
else if (!string.IsNullOrEmpty(msg.Content) && (msg.Content.Contains("cloudinary") || msg.Content.Contains("/audios/") || msg.Content.EndsWith(".webm")))
    isAudio = true; // compatibilidad con mensajes antiguos

// ========== SEPARADOR DE NO LEÍDOS ==========
@if (firstUnreadId != 0 && msg.Id == firstUnreadId)
{
    <div class="grp-unread-sep" id="unreadSeparator">
        <span>⬇ @unreadCount mensaje@(unreadCount != 1 ? "s" : "") no leído@(unreadCount != 1 ? "s" : "")</span>
    </div>
}

// ========== MENSAJE ==========
<div class="grp-msg-row @(isMine ? "mine" : "theirs")" id="msg-@msg.Id">
    @if (!isMine)
    {
        <a href="/User/Profile/@msg.SenderId" class="grp-msg-avatar">
            @if (!string.IsNullOrEmpty(senderImg)) { <img src="@senderImg" /> }
            else { @senderLetter }
        </a>
    }
    <div class="grp-msg-wrap">
        @if (!isMine)
        {
            <a href="/User/Profile/@msg.SenderId" class="grp-msg-sender">@msg.Sender?.Username</a>
        }
        <div class="grp-msg-bubble" oncontextmenu="abrirReactionPicker(event, @msg.Id)" ondblclick="responderMensaje(@msg.Id, '@(msg.Sender?.Username ?? "")', '@(msg.Content?.Replace("'", "\\'").Replace("\n", " ") ?? "")')" style="position:relative;">
            @if (msg.ReplyToMessageId.HasValue && msg.ReplyToMessage != null)
            {
                var replyText = msg.ReplyToMessage.Content?.Length > 50
                    ? msg.ReplyToMessage.Content.Substring(0, 50) + "..."
                    : msg.ReplyToMessage.Content ?? "";
                <div class="grp-msg-reply" onclick="scrollToMessage(@msg.ReplyToMessageId)">
                    <div class="grp-msg-reply-name">@msg.ReplyToMessage.Sender?.Username</div>
                    <div class="grp-msg-reply-text">@replyText</div>
                </div>
            }

            @if (isAudio)
            {
                var audioUrl = !string.IsNullOrEmpty(msg.FileUrl) ? msg.FileUrl : msg.Content;
                <audio controls class="grp-msg-audio"><source src="@audioUrl" /></audio>
            }
            else if (isImage)
            {
                <img src="@msg.FileUrl" class="grp-msg-media" onclick="window.open('@msg.FileUrl', '_blank')" />
            }
            else if (isVideo)
            {
                <video controls class="grp-msg-media"><source src="@msg.FileUrl" /></video>
            }
            else if (!string.IsNullOrEmpty(msg.Content))
            {
                @msg.Content
            }
        </div>
        <div class="grp-msg-footer">
            <span class="grp-msg-time">@msg.SentAt.ToLocalTime().ToString("hh:mm tt")</span>
            @if (isMine)
            {
                <span class="grp-msg-check @(allRead ? "seen" : "")" id="check-@msg.Id">@(allRead ? "✔✔" : "✔")</span>
            }
        </div>
        <div class="grp-reactions" id="reactions-@msg.Id">
            @if (msg.Reactions != null && msg.Reactions.Any())
            {
                var reactionGroups = msg.Reactions.GroupBy(r => r.Emoji);
                foreach (var rg in reactionGroups)
                {
                    <button class="grp-reaction-btn" onclick="reaccionar(@msg.Id, '@rg.Key')">
                        @rg.Key<span>@rg.Count()</span>
                    </button>
                }
            }
        </div>
    </div>
</div>
                }
            }
        }
        <div class="grp-typing-indicator" id="typingIndicator">
            <div class="grp-typing-bubble">
                <div class="grp-typing-dot"></div><div class="grp-typing-dot"></div><div class="grp-typing-dot"></div>
            </div>
        </div>
    </div>

@if (!isMember)
{
    <div class="grp-left-banner"><span>⚠️</span><span>Ya no eres miembro de este grupo. Solo puedes ver el historial.</span></div>
}
else if (Model.Type == "channel" && !isAdmin && User.FindFirst("UserId").Value != Model.CreatorId.ToString())
{
    <div class="grp-left-banner" style="background:rgba(239,68,68,0.1); border-color:rgba(239,68,68,0.2);">
        <span>🔒</span><span>Solo el creador y administradores pueden escribir en este canal.</span>
    </div>
}
else if (!(bool)(ViewBag.CanWrite ?? true)) // para grupos normales con IsAdminOnly
{
    <div class="grp-left-banner" style="background:rgba(239,68,68,0.1); border-color:rgba(239,68,68,0.2);">
        <span>🔒</span><span>Solo el creador y administradores pueden escribir en este grupo.</span>
    </div>
}
else
{
    <div class="grp-preview" id="grpPreview">
        <img id="grpPreviewImg" style="display:none;" />
        <video id="grpPreviewVid" style="display:none;" controls></video>
        <button class="grp-preview-close" onclick="cancelarArchivo()">✕</button>
    </div>

    <div class="grp-recording" id="grpRecording">
        <div class="grp-rec-dot"></div>
        <span class="grp-rec-label">🎙 Grabando...</span>
        <span class="grp-rec-timer" id="grpRecTimer">0:00</span>
        <button class="grp-bar-btn" onclick="toggleGrabacion()" style="background:#fee2e2;color:#dc2626;">⏹</button>
    </div>

    <div class="grp-audio-preview" id="grpAudioPreview">
        <audio id="grpPreviewAudio" controls></audio>
        <div class="grp-audio-btns">
            <button class="grp-audio-cancel" onclick="cancelarAudio()">✕ Cancelar</button>
            <button class="grp-audio-send" onclick="enviarAudio()">📤 Enviar audio</button>
        </div>
    </div>

    <div class="grp-emoji-panel" id="emojiPanel">
        <div class="grp-emoji-grid">
            @foreach (var emoji in new[]{"😀","😂","🥰","😍","😎","🤩","😭","😡","🥺","😏","👍","👎","❤️","🔥","✨","🎉","💯","🙏","👀","💪","🤝","😴","🤔","🥳","😤","🤣","💀","🫡","🥹","😇","🤯","🤪","😈","👻","🎯","💥","🌟","⚡","🎮","🏆"})
            {
                <span onclick="addGroupEmoji('@emoji')">@emoji</span>
            }
        </div>
    </div>

    <div class="grp-reply-preview" id="grpReplyPreview">
        <div class="grp-reply-preview-content">
            <div class="grp-reply-preview-name" id="grpReplyName"></div>
            <div class="grp-reply-preview-text" id="grpReplyText"></div>
        </div>
        <button class="grp-reply-close" onclick="cancelarReply()">✕</button>
    </div>

    <div class="grp-input-bar">
        <button class="grp-bar-btn" onclick="document.getElementById('grpFileInput').click()" title="Adjuntar">📎</button>
        <button class="grp-bar-btn" id="emojiBtn" onclick="toggleGroupEmoji()" data-no-loader title="Emoji">😊</button>
        <textarea class="grp-msg-input" id="msgInput" placeholder="Escribe un mensaje..." rows="1"></textarea>
        <button class="grp-bar-btn" id="grpRecBtn" onclick="toggleGrabacion()" title="Grabar audio">🎙</button>
        <button class="grp-send-btn" id="sendBtn" onclick="sendGroupMessage()" disabled title="Enviar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
    </div>
}

@Html.AntiForgeryToken()

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const groupId = @Model.Id;
const myId = "@User.FindFirst("UserId").Value";
const myName = "@User.Identity.Name";
let currentTotalMembers = @totalMembers;
let isMuted = @isMuted.ToString().ToLower();
const chatBox = document.getElementById("chatBox");
const msgInput = document.getElementById("msgInput");
const sendBtn = document.getElementById("sendBtn");
let selectedFile = null;
let mediaRecorder = null, audioChunks = [], isRecording = false, recInterval = null;
let recordedBlob = null;
let activeUsersInChat = 1;
let replyToMessageId = null;
let replyToContent = "";
let replyToSender = "";

function scrollToBottom(smooth) {
    if (smooth) chatBox.style.scrollBehavior = 'smooth';
    chatBox.scrollTop = chatBox.scrollHeight;
    if (smooth) setTimeout(() => chatBox.style.scrollBehavior = 'auto', 400);
}

function mostrarBannerNoLeidos(count) {
    document.getElementById('unreadBanner')?.remove();
    const banner = document.createElement('div');
    banner.id = 'unreadBanner';
    banner.style.cssText = 'position:sticky;bottom:10px;left:0;right:0;display:flex;justify-content:center;z-index:10;pointer-events:none;';
    banner.innerHTML = `<div style="background:rgba(99,102,241,0.92);color:white;padding:6px 18px;border-radius:20px;font-size:12px;font-weight:700;box-shadow:0 4px 14px rgba(99,102,241,0.4);backdrop-filter:blur(8px);pointer-events:all;cursor:pointer;" onclick="scrollToBottom(true);this.parentElement.remove();">↓ ${count} mensaje${count!==1?'s':''} no leído${count!==1?'s':''}</div>`;
    chatBox.appendChild(banner);
    setTimeout(() => banner.remove(), 5000);
}

window.addEventListener("load", () => {
    const firstUnreadId = @firstUnreadId;
    const unreadCount = @unreadCount;
    if (firstUnreadId > 0 && unreadCount > 0) {
        const sep = document.getElementById("unreadSeparator");
        if (sep) {
            sep.scrollIntoView({ behavior: "auto", block: "center" });
            setTimeout(() => {
                sep.style.transition = "opacity 0.5s";
                sep.style.opacity = "0";
                setTimeout(() => sep.remove(), 500);
            }, 5000);
        }
    } else {
        chatBox.scrollTop = chatBox.scrollHeight;
    }
});

if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", () => {
        const chatPage = document.querySelector(".grp-chat-page");
        if (chatPage && window.innerWidth < 768) {
            chatPage.style.height = window.visualViewport.height + "px";
            chatPage.style.top = (window.visualViewport.offsetTop || 0) + "px";
        }
        chatBox.scrollTop = chatBox.scrollHeight;
    });
}

if (msgInput) {
    msgInput.addEventListener("focus", () => { setTimeout(() => chatBox.scrollTop = chatBox.scrollHeight, 300); });
}

function ajustarAltura() {
    const navbar = document.querySelector('.ht-navbar');
    const chatPage = document.querySelector('.grp-chat-page');
    if (!chatPage) return;
    if (window.innerWidth >= 768) {
        const navH = navbar ? navbar.getBoundingClientRect().bottom : 0;
        chatPage.style.height = (window.innerHeight - navH) + 'px';
    }
}
ajustarAltura();
window.addEventListener('resize', ajustarAltura);
window.addEventListener('load', ajustarAltura);
setTimeout(ajustarAltura, 100);
setTimeout(ajustarAltura, 500);

const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";

const grpConnection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub").withAutomaticReconnect().build();

grpConnection.start().then(async () => {
    await grpConnection.invoke("JoinUserGroup", myId);
    await grpConnection.invoke("JoinGroupChat", groupId.toString());
    fetch("/Group/MarkRead", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    }).then(r => r.json()).then(data => {
        if (data.readIds) data.readIds.forEach(msgId =>
            grpConnection.invoke("NotifyGroupRead", groupId.toString(), msgId.toString()).catch(() => {}));
    }).catch(() => {});
}).catch(err => console.error("SignalR grupo:", err));

grpConnection.on("GroupActiveUsers", (gId, count) => {
    if (String(gId) === String(groupId)) activeUsersInChat = count;
});

grpConnection.on("ReceiveGroupMessage", (senderId, senderName, senderImage, content, time, msgId, fileUrl, fileType, replyData) => {
    let replyToMessageId = "", replySender = "", replyContent = "";
    if (replyData && replyData !== "||") {
        const parts = replyData.split("|");
        replyToMessageId = parts[0] ?? "";
        replySender = parts[1] ?? "";
        replyContent = parts[2] ?? "";
    }
    if (String(senderId) === String(myId)) return;
    document.getElementById("emptyState")?.remove();
    document.getElementById('unreadBanner')?.remove();
    if (fileType === "system" || senderId === "0") {
        const row = document.createElement("div");
        row.className = "grp-msg-system";
        row.innerHTML = `<div class="grp-msg-system-bubble">${escapeHtml(content)}</div>`;
        chatBox.insertBefore(row, document.getElementById("typingIndicator"));
        chatBox.scrollTop = chatBox.scrollHeight; return;
    }
    const letter = senderName ? senderName.charAt(0).toUpperCase() : "?";
    const avatarHTML = (senderImage && senderImage.trim() !== "")
        ? `<img src="${senderImage}" style="width:100%;height:100%;object-fit:cover;" />` : letter;
    let contentHTML = "";
    if (fileType === "audio") contentHTML = `<audio controls class="grp-msg-audio"><source src="${content}" /></audio>`;
    else if (fileType === "image") contentHTML = `<img src="${fileUrl}" class="grp-msg-media" onclick="window.open('${fileUrl}', '_blank')" />`;
    else if (fileType === "video") contentHTML = `<video controls class="grp-msg-media"><source src="${fileUrl}" /></video>`;
    else contentHTML = escapeHtml(content);

    const replyHTML = (replyToMessageId && replyContent)
        ? `<div class="grp-msg-reply" onclick="scrollToMessage(${replyToMessageId})">
            <div class="grp-msg-reply-name">${escapeHtml(replySender)}</div>
            <div class="grp-msg-reply-text">${escapeHtml(replyContent.length > 50 ? replyContent.substring(0, 50) + '...' : replyContent)}</div>
           </div>` : '';

    const row = document.createElement("div");
    row.className = "grp-msg-row theirs";
    if (msgId) row.id = "msg-" + msgId;
  row.innerHTML = `<a href="/User/Profile/${senderId}" class="grp-msg-avatar">${avatarHTML}</a><div class="grp-msg-wrap"><a href="/User/Profile/${senderId}" class="grp-msg-sender">${escapeHtml(senderName)}</a><div class="grp-msg-bubble" oncontextmenu="abrirReactionPicker(event,${msgId})" ondblclick="responderMensaje(${msgId},'${escapeHtml(senderName)}','${escapeHtml(content)}')" style="position:relative;">${replyHTML}${contentHTML}</div><div class="grp-msg-footer"><span class="grp-msg-time">${time}</span></div></div><div class="grp-reactions" id="reactions-${msgId}"></div></div>`;
    chatBox.insertBefore(row, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;
    fetch("/Group/MarkRead", {
        method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    }).then(r => r.json()).then(data => {
        if (data.readIds) data.readIds.forEach(id =>
            grpConnection.invoke("NotifyGroupRead", groupId.toString(), id.toString()).catch(() => {}));
    }).catch(() => {});
});

grpConnection.on("GroupMessageRead", (msgId, readCount, activeInChat) => {
    const check = document.getElementById("check-" + msgId); if (!check) return;
    const inChat = activeInChat !== undefined ? activeInChat : activeUsersInChat;
    const allInChat = inChat >= currentTotalMembers;
    const allRead = parseInt(readCount) >= currentTotalMembers - 1 && currentTotalMembers > 1;
    if (allInChat) { check.textContent = "✔✔"; check.classList.add("seen"); }
    else if (allRead) { check.textContent = "✔✔"; check.classList.remove("seen"); }
    else { check.textContent = "✔"; check.classList.remove("seen"); }
});

grpConnection.on("GroupUserTyping", (senderName) => {
    if (senderName === myName) return;
    document.getElementById("typingIndicator").style.display = "block";
    chatBox.scrollTop = chatBox.scrollHeight;
});
grpConnection.on("GroupUserStoppedTyping", () => {
    document.getElementById("typingIndicator").style.display = "none";
});

grpConnection.on("MemberRemovedFromGroup", (removedUserId, systemMessage) => {
    document.getElementById("emptyState")?.remove();
    const sysRow = document.createElement("div"); sysRow.className = "grp-msg-system";
    sysRow.innerHTML = `<div class="grp-msg-system-bubble">${escapeHtml(systemMessage)}</div>`;
    chatBox.insertBefore(sysRow, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;
});

grpConnection.on("YouWereRemovedFromGroup", (removedGroupId, message) => {
    if (String(removedGroupId) !== String(groupId)) return;
    document.getElementById("emptyState")?.remove();
    const sysRow = document.createElement("div"); sysRow.className = "grp-msg-system";
    sysRow.innerHTML = `<div class="grp-msg-system-bubble" style="background:rgba(239,68,68,0.1);color:#dc2626;border:1px solid rgba(239,68,68,0.2);">${escapeHtml(message)}</div>`;
    chatBox.insertBefore(sysRow, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;
    document.querySelector(".grp-input-bar")?.remove();
    document.getElementById("grpPreview")?.remove();
    document.getElementById("grpAudioPreview")?.remove();
    document.getElementById("grpRecording")?.remove();
    document.getElementById("emojiPanel")?.remove();
    const banner = document.createElement("div");
    banner.style.cssText = "flex-shrink:0;padding:14px 16px;background:rgba(239,68,68,0.1);border-top:1px solid rgba(239,68,68,0.2);display:flex;align-items:center;gap:10px;font-size:13px;color:#dc2626;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;";
    banner.innerHTML = `<span>🚫</span><span>${escapeHtml(message)}</span>`;
    document.querySelector(".grp-chat-page").appendChild(banner);
    showToast("🚫 " + message);
});

grpConnection.on("AddedToGroup", (gId, groupName, adderName) => {
    if (String(gId) === String(groupId)) {
        const sysRow = document.createElement("div");
        sysRow.className = "grp-msg-system";
        sysRow.innerHTML = `<div class="grp-msg-system-bubble">➕ ${escapeHtml(adderName)} te añadió a este grupo</div>`;
        chatBox.insertBefore(sysRow, document.getElementById("typingIndicator"));
        chatBox.scrollTop = chatBox.scrollHeight;
    }
});

grpConnection.on("GroupMessageReaction", (msgId, reactions) => {
    actualizarReacciones(msgId, reactions);
});

sessionStorage.setItem('activeGroupChat', groupId.toString());
window.addEventListener('beforeunload', () => {
    sessionStorage.removeItem('activeGroupChat');
    grpConnection.invoke("LeaveGroupChat", groupId.toString()).catch(() => {});
});

async function toggleMute() {
    const res = await fetch("/Group/ToggleMute", {
        method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    });
    const data = await res.json();
    if (data.success) {
        isMuted = data.isMuted;
        const btn = document.getElementById("muteBtn");
        btn.textContent = isMuted ? "🔕" : "🔔";
        btn.classList.toggle("muted", isMuted);
        showToast(isMuted ? "🔕 Notificaciones silenciadas" : "🔔 Notificaciones activadas");
    }
}

function showToast(msg) {
    const t = document.createElement("div");
    t.style.cssText = "position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#1e293b;color:white;padding:10px 20px;border-radius:20px;font-size:13px;font-weight:600;z-index:99999;box-shadow:0 4px 20px rgba(0,0,0,0.3);font-family:'Plus Jakarta Sans',sans-serif;white-space:nowrap;pointer-events:none;";
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => { t.style.transition = "opacity 0.3s"; t.style.opacity = "0"; setTimeout(() => t.remove(), 300); }, 2800);
}

if (msgInput) {
    msgInput.addEventListener("input", function() {
        this.style.height = "auto";
        this.style.height = Math.min(this.scrollHeight, 100) + "px";
        if (sendBtn) sendBtn.disabled = this.value.trim() === "" && !selectedFile;
        grpConnection.invoke("GroupUserTyping", groupId.toString(), myName).catch(() => {});
        clearTimeout(window.grpTypingTimer);
        window.grpTypingTimer = setTimeout(() => grpConnection.invoke("GroupUserStoppedTyping", groupId.toString()).catch(() => {}), 1500);
    });
    msgInput.addEventListener("keydown", function(e) {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendGroupMessage(); }
    });
}

document.getElementById("grpFileInput")?.addEventListener("change", function() {
    const file = this.files[0]; if (!file) return;
    selectedFile = file;
    const url = URL.createObjectURL(file);
    const preview = document.getElementById("grpPreview");
    const img = document.getElementById("grpPreviewImg");
    const vid = document.getElementById("grpPreviewVid");
    preview.style.display = "block";
    if (file.type.startsWith("image")) { img.src = url; img.style.display = "block"; vid.style.display = "none"; }
    else { vid.src = url; vid.style.display = "block"; img.style.display = "none"; }
    if (sendBtn) sendBtn.disabled = false;
});

function cancelarArchivo() {
    selectedFile = null;
    document.getElementById("grpFileInput").value = "";
    document.getElementById("grpPreview").style.display = "none";
    document.getElementById("grpPreviewImg").style.display = "none";
    document.getElementById("grpPreviewVid").style.display = "none";
    if (sendBtn) sendBtn.disabled = msgInput?.value.trim() === "";
}

async function toggleGrabacion() {
    if (isRecording) {
        mediaRecorder.stop(); isRecording = false; clearInterval(recInterval);
        document.getElementById("grpRecording").style.display = "none";
        document.getElementById("grpRecBtn").classList.remove("recording"); return;
    }
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = []; isRecording = true;
        document.getElementById("grpRecording").style.display = "flex";
        document.getElementById("grpRecBtn").classList.add("recording");
        let secs = 0;
        recInterval = setInterval(() => { secs++; document.getElementById("grpRecTimer").textContent = `${Math.floor(secs/60)}:${String(secs%60).padStart(2,"0")}`; }, 1000);
        mediaRecorder.ondataavailable = e => { if (e.data?.size > 0) audioChunks.push(e.data); };
        mediaRecorder.onstop = () => {
            stream.getTracks().forEach(t => t.stop());
            recordedBlob = new Blob(audioChunks, { type: "audio/webm" });
            document.getElementById("grpPreviewAudio").src = URL.createObjectURL(recordedBlob);
            document.getElementById("grpAudioPreview").style.display = "block";
        };
        mediaRecorder.start();
    } catch (err) { showToast("❌ No se pudo acceder al micrófono"); }
}

async function enviarAudio() {
    if (!recordedBlob) return;
    document.getElementById("grpAudioPreview").style.display = "none";
    const formData = new FormData();
    formData.append("audio", recordedBlob, "audio.webm");
    formData.append("groupId", groupId);
    formData.append("__RequestVerificationToken", token());
    const tempId = "temp-" + Date.now();
    agregarBurbujaMia(`<audio controls class="grp-msg-audio"><source src="${URL.createObjectURL(recordedBlob)}" /></audio>`, tempId);
    try {
        const res = await fetch("/Group/SendAudio", { method: "POST", body: formData });
        const data = await res.json();
        if (data.success) {
            const row = document.getElementById(tempId); if (row) row.id = "msg-" + data.id;
            const check = document.getElementById("check-" + tempId); if (check) check.id = "check-" + data.id;
            currentTotalMembers = data.totalMembers;
            await grpConnection.invoke("SendGroupMessage", groupId.toString(), myId, myName, data.audioUrl, data.id.toString(), "", "audio");
        }
    } catch (err) { console.error(err); }
    recordedBlob = null;
}

function cancelarAudio() {
    recordedBlob = null;
    document.getElementById("grpAudioPreview").style.display = "none";
    document.getElementById("grpPreviewAudio").src = "";
}

function makeTime() { return new Date().toLocaleTimeString('es-CO', { hour:'2-digit', minute:'2-digit' }); }
function escapeHtml(text) { return String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function agregarBurbujaMia(contentHTML, tempId) {
    document.getElementById("emptyState")?.remove();

    // Crear contenedor principal del mensaje
    const row = document.createElement("div");
    row.className = "grp-msg-row mine";
    row.id = tempId;

    // Crear contenedor del wrap
    const wrap = document.createElement("div");
    wrap.className = "grp-msg-wrap";

    // Crear burbuja
    const bubble = document.createElement("div");
    bubble.className = "grp-msg-bubble";
    bubble.style.position = "relative";
    // Asignar eventos (sin pasar contentHTML como texto)
    bubble.oncontextmenu = (e) => {
        e.preventDefault();
        abrirReactionPicker(e, tempId);
    };
    bubble.ondblclick = () => {
        responderMensaje(tempId, myName, "mensaje"); // pasamos un placeholder, el contenido real se obtendrá de otro modo si es necesario
    };

    // Agregar reply si existe
    if (replyToMessageId && replyToContent) {
        const replyDiv = document.createElement("div");
        replyDiv.className = "grp-msg-reply";
        replyDiv.onclick = () => scrollToMessage(replyToMessageId);
        replyDiv.innerHTML = `
            <div class="grp-msg-reply-name">${escapeHtml(replyToSender ?? "")}</div>
            <div class="grp-msg-reply-text">${escapeHtml((replyToContent ?? "").length > 50 ? (replyToContent ?? "").substring(0, 50) + '...' : (replyToContent ?? ""))}</div>
        `;
        bubble.appendChild(replyDiv);
    }

    // Insertar el contenido HTML (que puede ser audio, imagen, texto)
    // IMPORTANTE: contentHTML ya contiene el HTML del reproductor (ej: <audio>). Lo insertamos como innerHTML.
    bubble.innerHTML += contentHTML;

    wrap.appendChild(bubble);

    // Footer
    const footer = document.createElement("div");
    footer.className = "grp-msg-footer";
    const timeSpan = document.createElement("span");
    timeSpan.className = "grp-msg-time";
    timeSpan.textContent = makeTime();
    const checkSpan = document.createElement("span");
    checkSpan.className = "grp-msg-check";
    checkSpan.id = "check-" + tempId;
    checkSpan.textContent = "✔";
    footer.appendChild(timeSpan);
    footer.appendChild(checkSpan);
    wrap.appendChild(footer);

    // Contenedor de reacciones
    const reactionsDiv = document.createElement("div");
    reactionsDiv.className = "grp-reactions";
    reactionsDiv.id = "reactions-" + tempId;
    wrap.appendChild(reactionsDiv);

    row.appendChild(wrap);
    chatBox.insertBefore(row, document.getElementById("typingIndicator"));
    chatBox.scrollTop = chatBox.scrollHeight;

    return row;
}

async function sendGroupMessage() {
    const content = msgInput ? msgInput.value.trim() : "";
    if (!content && !selectedFile) return;
    const tempId = "temp-" + Date.now();
    if (msgInput) { msgInput.value = ""; msgInput.style.height = "auto"; }
    if (sendBtn) sendBtn.disabled = true;
    if (selectedFile) {
        const file = selectedFile; selectedFile = null; cancelarArchivo();
        const url = URL.createObjectURL(file); const isImg = file.type.startsWith("image");
        agregarBurbujaMia(isImg ? `<img src="${url}" class="grp-msg-media" />` : `<video controls class="grp-msg-media"><source src="${url}" /></video>`, tempId);
        const formData = new FormData();
        formData.append("file", file); formData.append("groupId", groupId); formData.append("__RequestVerificationToken", token());
        try {
            const res = await fetch("/Group/SendFile", { method: "POST", body: formData });
            const data = await res.json();
            if (data.success) {
                const row = document.getElementById(tempId); if (row) row.id = "msg-" + data.id;
const check = document.getElementById("check-" + tempId); if (check) check.id = "check-" + data.id;
const reactions = document.getElementById("reactions-" + tempId); if (reactions) reactions.id = "reactions-" + data.id;
                currentTotalMembers = data.totalMembers;
                await grpConnection.invoke("SendGroupMessage", groupId.toString(), myId, myName, "", data.id.toString(), data.fileUrl, data.fileType);
            }
        } catch (err) { console.error(err); }
    } else {
        agregarBurbujaMia(escapeHtml(content), tempId);
        try {
            const res = await fetch("/Group/SendMessage", {
                method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `groupId=${groupId}&content=${encodeURIComponent(content)}&replyToMessageId=${replyToMessageId ?? ""}&__RequestVerificationToken=${encodeURIComponent(token())}`
            });
            const data = await res.json();
            if (data.success) {
            const row = document.getElementById(tempId); if (row) row.id = "msg-" + data.id;
const check = document.getElementById("check-" + tempId); if (check) check.id = "check-" + data.id;
const reactions = document.getElementById("reactions-" + tempId); if (reactions) reactions.id = "reactions-" + data.id;
                currentTotalMembers = data.totalMembers;
               const savedReplyId = replyToMessageId ? replyToMessageId.toString() : "";
const savedReplySender = replyToSender ?? "";
const savedReplyContent = replyToContent ?? "";
cancelarReply();
await grpConnection.invoke("SendGroupMessage", groupId.toString(), myId, myName, content, data.id.toString(), "", "text", savedReplyId, savedReplySender, savedReplyContent);
            } else { document.getElementById(tempId)?.remove(); }
        } catch (err) { console.error(err); document.getElementById(tempId)?.remove(); }
    }
    if (msgInput) msgInput.focus();
}

function responderMensaje(msgId, senderName, content) {
    replyToMessageId = msgId;
    replyToSender = senderName;
    replyToContent = content;
    document.getElementById("grpReplyName").textContent = senderName;
    document.getElementById("grpReplyText").textContent = content.length > 60 ? content.substring(0, 60) + "..." : content;
    document.getElementById("grpReplyPreview").style.display = "flex";
    if (msgInput) msgInput.focus();
}

function cancelarReply() {
    replyToMessageId = null;
    replyToContent = "";
    replyToSender = "";
    document.getElementById("grpReplyPreview").style.display = "none";
}

function scrollToMessage(msgId) {
    const el = document.getElementById("msg-" + msgId);
    if (!el) return;
    el.scrollIntoView({ behavior: "smooth", block: "center" });
    el.style.transition = "background 0.3s";
    el.style.background = "rgba(99,102,241,0.15)";
    setTimeout(() => el.style.background = "", 1500);
}

function toggleGroupEmoji() {
    const panel = document.getElementById("emojiPanel"); const btn = document.getElementById("emojiBtn"); if (!panel) return;
    const isOpen = panel.style.display === "block"; panel.style.display = isOpen ? "none" : "block"; btn.classList.toggle("active", !isOpen);
}
function addGroupEmoji(emoji) {
    if (!msgInput) return; msgInput.value += emoji; msgInput.focus();
    if (sendBtn) sendBtn.disabled = msgInput.value.trim() === "" && !selectedFile;
}
document.addEventListener("click", (e) => {
    if (!e.target.closest("#emojiBtn") && !e.target.closest("#emojiPanel")) {
        const panel = document.getElementById("emojiPanel"); if (panel) panel.style.display = "none";
        document.getElementById("emojiBtn")?.classList.remove("active");
    }
});

const EMOJIS_REACCION = ["❤️", "👍", "😂", "😮", "😢", "🔥"];
let longPressTimer = null;

function iniciarLongPress(msgId) {
    longPressTimer = setTimeout(() => abrirReactionPicker(null, msgId), 600);
}
function cancelarLongPress() { clearTimeout(longPressTimer); }

function abrirReactionPicker(e, msgId) {
    if (e) e.preventDefault();
    document.querySelectorAll('.grp-reaction-picker').forEach(p => p.remove());
    const bubble = document.querySelector(`#msg-${msgId} .grp-msg-bubble`);
    if (!bubble) return;
    const picker = document.createElement("div");
    picker.className = "grp-reaction-picker";
    picker.innerHTML = EMOJIS_REACCION.map(em => `<span onclick="reaccionar(${msgId}, '${em}')">${em}</span>`).join("");
    bubble.appendChild(picker);
    setTimeout(() => {
        document.addEventListener("click", function cerrar(ev) {
            if (!picker.contains(ev.target)) { picker.remove(); document.removeEventListener("click", cerrar); }
        });
    }, 100);
}

async function reaccionar(msgId, emoji) {
    document.querySelectorAll('.grp-reaction-picker').forEach(p => p.remove());
    try {
        const res = await fetch("/Group/ReactToMessage", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: `messageId=${msgId}&emoji=${encodeURIComponent(emoji)}&__RequestVerificationToken=${encodeURIComponent(token())}`
        });
        const data = await res.json();
        if (data.success) actualizarReacciones(msgId.toString(), data.reactions);
    } catch (err) { console.error(err); }
}

function actualizarReacciones(msgId, reactions) {
    const container = document.getElementById("reactions-" + msgId);
    if (!container) return;
    if (!reactions || reactions.length === 0) { container.innerHTML = ""; return; }
    container.innerHTML = reactions.map(r =>
        `<button class="grp-reaction-btn" onclick="reaccionar(${msgId}, '${r.emoji}')">${r.emoji}<span>${r.count}</span></button>`
    ).join("");
}
</script>