@model List<HabitTrackerApp.Models.Group>
@{
    var myGroupIds = ViewBag.MyGroupIds as List<int> ?? new List<int>();
    var myRequests = ViewBag.MyRequests as Dictionary<int, string> ?? new Dictionary<int, string>();
    var type = ViewBag.Type as string ?? "public";
    var isChannel = type == "channel";
}

@if (!Model.Any())
{
    <div style="text-align:center;padding:60px 20px;">
        <div style="font-size:48px;margin-bottom:14px;">@(isChannel ? "📢" : "🌍")</div>
        <div style="font-size:16px;font-weight:800;color:#f1f5f9;margin-bottom:8px;">
            No hay @(isChannel ? "canales" : "grupos públicos") aún
        </div>
        <div style="font-size:13px;color:rgba(255,255,255,0.3);margin-bottom:24px;">
            ¡Sé el primero en crear @(isChannel ? "un canal" : "un grupo público")!
        </div>
        <a href="/Group/Create" style="display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:14px;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;font-size:14px;font-weight:700;text-decoration:none;">
            ➕ Crear @(isChannel ? "canal" : "grupo")
        </a>
    </div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:8px;">
        @foreach (var g in Model)
        {
            var isMember = myGroupIds.Contains(g.Id);
            var reqStatus = myRequests.ContainsKey(g.Id) ? myRequests[g.Id] : "None";
            var memberCount = g.Members?.Count(m => m.IsActive) ?? 0;
            var letter = g.Name.Substring(0, 1).ToUpper();

            <div style="background:#1e293b;border-radius:20px;border:1px solid rgba(255,255,255,0.07);overflow:hidden;transition:0.2s;"
                 onmouseover="this.style.borderColor='rgba(99,102,241,0.3)'"
                 onmouseout="this.style.borderColor='rgba(255,255,255,0.07)'">
                <div style="display:flex;align-items:center;gap:14px;padding:16px;">
                    <!-- Avatar -->
                    <div style="width:54px;height:54px;border-radius:16px;background:linear-gradient(135deg,#6366f1,#4f46e5);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:white;flex-shrink:0;overflow:hidden;box-shadow:0 4px 14px rgba(99,102,241,0.3);">
                        @if (!string.IsNullOrEmpty(g.ImageUrl))
                        {
                            <img src="@g.ImageUrl" style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {

                            @letter
                        }
                    </div>

                    <!-- Info -->
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:3px;">
                            <span style="font-size:15px;font-weight:800;color:#f1f5f9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@g.Name</span>
                            @if (isChannel)
                            {
                                <span style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;background:rgba(99,102,241,0.15);color:#818cf8;border:1px solid rgba(99,102,241,0.2);">📢 Canal</span>
                            }
                            else
                            {

                                <span style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;background:rgba(34,197,94,0.1);color:#4ade80;border:1px solid rgba(34,197,94,0.2);">🌍 Público</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(g.Description))
                        {
                            <div style="font-size:12px;color:rgba(255,255,255,0.4);margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@g.Description</div>
                        }
                        <div style="font-size:11px;color:rgba(255,255,255,0.25);font-weight:600;">
                            👥 @memberCount miembro@(memberCount != 1 ? "s" : "")
                            · por @g.Creator?.Username
                        </div>
                    </div>

                    <!-- Acción -->
                    <div style="flex-shrink:0;">
                        @if (isMember)
                        {
                            <a href="/Group/Chat/@g.Id" style="display:inline-flex;align-items:center;gap:5px;padding:9px 16px;border-radius:12px;background:rgba(99,102,241,0.15);color:#818cf8;font-size:12px;font-weight:700;text-decoration:none;border:1px solid rgba(99,102,241,0.2);">
                                💬 Abrir
                            </a>
                        }
                        else if (reqStatus == "Pending")
                        {
                            <button disabled style="padding:9px 16px;border-radius:12px;background:rgba(251,191,36,0.1);color:#fbbf24;font-size:12px;font-weight:700;border:1px solid rgba(251,191,36,0.2);cursor:not-allowed;">
                                ⏳ Pendiente
                            </button>
                        }
                        else
                        {
                            <button onclick="solicitarUnirse(@g.Id, this)" style="padding:9px 16px;border-radius:12px;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;font-size:12px;font-weight:700;border:none;cursor:pointer;transition:0.2s;font-family:inherit;">
                                @(isChannel ? "📢 Unirse" : "✋ Solicitar")
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

