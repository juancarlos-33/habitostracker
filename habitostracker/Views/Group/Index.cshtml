@model List<HabitTrackerApp.Models.Group>

@{
    ViewData["Title"] = "Mis Grupos";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.grp-page { max-width: 680px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; }

.grp-hero {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-radius: 22px; padding: 28px; margin-bottom: 16px;
    display: flex; align-items: center; justify-content: space-between;
    border: 1px solid rgba(255,255,255,0.06); position: relative; overflow: hidden;
}
.grp-hero::before {
    content:""; position:absolute; top:-40px; right:-40px;
    width:160px; height:160px;
    background: radial-gradient(circle, rgba(99,102,241,0.15), transparent 70%);
    border-radius:50%;
}
.grp-hero-left { display: flex; align-items: center; gap: 16px; position: relative; z-index:1; }
.grp-hero-icon {
    width:52px; height:52px; border-radius:16px;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display:flex; align-items:center; justify-content:center;
    font-size:24px; flex-shrink:0;
    box-shadow: 0 8px 20px rgba(99,102,241,0.35);
}
.grp-hero-title { font-size:20px; font-weight:800; color:white; margin:0 0 4px; }
.grp-hero-sub { font-size:13px; color:rgba(255,255,255,0.4); margin:0; }
.grp-create-btn {
    padding: 10px 20px; border-radius: 12px; border: none;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    color: white; font-size: 13px; font-weight: 700;
    cursor: pointer; text-decoration: none;
    display: flex; align-items: center; gap: 6px;
    position: relative; z-index:1;
    box-shadow: 0 4px 14px rgba(99,102,241,0.35);
    transition: 0.2s;
}
.grp-create-btn:hover { transform: translateY(-1px); color: white; }

.grp-card {
    background: white; border-radius: 18px; padding: 16px 18px;
    margin-bottom: 10px; border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    display: flex; align-items: center; gap: 14px;
    text-decoration: none; transition: 0.2s; cursor: pointer;
}
.grp-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.08); transform: translateY(-1px); }
.grp-avatar {
    width: 50px; height: 50px; border-radius: 15px; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: white; font-weight: 800;
    overflow: hidden;
}
.grp-avatar img { width: 100%; height: 100%; object-fit: cover; }
.grp-info { flex: 1; min-width: 0; }
.grp-name { font-size: 14px; font-weight: 700; color: #111827; margin: 0 0 3px; }
.grp-meta { font-size: 12px; color: #9ca3af; }
.grp-badge {
    font-size: 11px; font-weight: 700; padding: 3px 10px;
    border-radius: 20px; background: #ede9fe; color: #6366f1; flex-shrink: 0;
}

.grp-empty {
    text-align: center; padding: 60px 20px;
    background: white; border-radius: 20px;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
}
.grp-empty-icon { font-size: 52px; margin-bottom: 14px; }
.grp-empty-title { font-size: 17px; font-weight: 700; color: #111827; margin: 0 0 8px; }
.grp-empty-sub { font-size: 13px; color: #9ca3af; margin: 0 0 20px; }

body.bg-dark .grp-card { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .grp-name { color: #f1f5f9 !important; }
body.bg-dark .grp-empty { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .grp-empty-title { color: #f1f5f9 !important; }
</style>

<div class="grp-page">
    <div class="grp-hero">
        <div class="grp-hero-left">
            <div class="grp-hero-icon">👥</div>
            <div>
                <h2 class="grp-hero-title">Mis Grupos</h2>
                <p class="grp-hero-sub">Chatea con varios amigos a la vez</p>
            </div>
        </div>
        <a asp-controller="Group" asp-action="Create" class="grp-create-btn">
            ➕ Nuevo grupo
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="grp-empty">
            <div class="grp-empty-icon">👥</div>
            <div class="grp-empty-title">No tienes grupos todavía</div>
            <div class="grp-empty-sub">Crea un grupo para chatear con varios amigos a la vez.</div>
            <a asp-controller="Group" asp-action="Create" class="grp-create-btn" style="display:inline-flex;margin:0 auto;">
                ➕ Crear primer grupo
            </a>
        </div>
    }
    else
    {
        foreach (var g in Model)
        {
            var memberCount = g.Members?.Count(m => m.IsActive) ?? 0;
            var firstLetter = g.Name.Substring(0, 1).ToUpper();
            <a asp-controller="Group" asp-action="Chat" asp-route-id="@g.Id" class="grp-card">
                <div class="grp-avatar">
                    @if (!string.IsNullOrEmpty(g.ImageUrl))
                    { <img src="@g.ImageUrl" /> }
                    else
                    { @firstLetter }
                </div>
                <div class="grp-info">
                    <div class="grp-name">@g.Name</div>
                    <div class="grp-meta">@memberCount miembro@(memberCount != 1 ? "s" : "") · Creado por @(g.Creator?.Username ?? "?")</div>
                </div>
                <span class="grp-badge">💬 Chat</span>
            </a>
        }
    }
</div>