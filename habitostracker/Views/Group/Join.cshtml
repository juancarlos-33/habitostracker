@model HabitTrackerApp.Models.Group
@{
    ViewData["Title"] = "Unirse a " + Model.Name;
    var isMember = (bool)(ViewBag.IsMember ?? false);
    var isChannel = Model.Type == "channel";
    var memberCount = Model.Members?.Count(m => m.IsActive) ?? 0;
    var pic = Model.ImageUrl;
    var letter = Model.Name.Substring(0, 1).ToUpper();
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.join-page {
    max-width: 480px; margin: 0 auto;
    font-family: 'Plus Jakarta Sans', sans-serif;
    padding-bottom: 40px; min-height: 80vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding-top: 40px;
}
.join-card {
    width: 100%; background: linear-gradient(180deg, #1e293b, #0f172a);
    border-radius: 28px; padding: 40px 32px;
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow: 0 24px 64px rgba(0,0,0,0.4);
    text-align: center;
}
.join-avatar {
    width: 90px; height: 90px; border-radius: 26px;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    display: flex; align-items: center; justify-content: center;
    font-size: 38px; font-weight: 900; color: white;
    margin: 0 auto 20px; overflow: hidden;
    box-shadow: 0 12px 32px rgba(99,102,241,0.4);
    border: 3px solid rgba(255,255,255,0.1);
}
.join-avatar img { width: 100%; height: 100%; object-fit: cover; }
.join-type-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11px; font-weight: 700; padding: 4px 12px;
    border-radius: 20px; margin-bottom: 14px;
}
.join-type-badge.channel { background: rgba(99,102,241,0.15); color: #818cf8; border: 1px solid rgba(99,102,241,0.25); }
.join-type-badge.public { background: rgba(34,197,94,0.1); color: #4ade80; border: 1px solid rgba(34,197,94,0.2); }
.join-type-badge.private { background: rgba(100,116,139,0.15); color: #94a3b8; border: 1px solid rgba(100,116,139,0.2); }
.join-name {
    font-size: 24px; font-weight: 900; color: white;
    margin: 0 0 8px; line-height: 1.2;
}
.join-desc {
    font-size: 14px; color: rgba(255,255,255,0.4);
    margin: 0 0 20px; line-height: 1.6;
}
.join-stats {
    display: flex; align-items: center; justify-content: center;
    gap: 20px; margin-bottom: 28px;
    padding: 14px 20px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
}
.join-stat { text-align: center; }
.join-stat-num { font-size: 20px; font-weight: 800; color: white; }
.join-stat-label { font-size: 11px; color: rgba(255,255,255,0.3); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }
.join-stat-sep { width: 1px; height: 30px; background: rgba(255,255,255,0.08); }
.join-creator {
    font-size: 12px; color: rgba(255,255,255,0.3);
    margin-bottom: 28px; font-weight: 600;
}
.join-btn {
    width: 100%; padding: 15px; border: none; border-radius: 16px;
    font-size: 15px; font-weight: 800; cursor: pointer;
    font-family: inherit; transition: 0.2s;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; box-shadow: 0 8px 24px rgba(99,102,241,0.4);
    margin-bottom: 10px;
}
.join-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(99,102,241,0.5); }
.join-btn:disabled { background: #334155; cursor: not-allowed; transform: none; box-shadow: none; }
.join-btn.success { background: linear-gradient(135deg, #22c55e, #16a34a); box-shadow: 0 8px 24px rgba(34,197,94,0.35); }
.join-cancel {
    display: block; text-align: center; font-size: 13px;
    color: rgba(255,255,255,0.3); text-decoration: none;
    font-weight: 600; padding: 8px; transition: 0.2s;
    margin-top: 4px;
}
.join-cancel:hover { color: rgba(255,255,255,0.6); }
.join-already {
    background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.2);
    border-radius: 16px; padding: 16px; margin-bottom: 16px;
    font-size: 14px; font-weight: 700; color: #4ade80; text-align: center;
}
</style>

<div class="join-page">
    <div class="join-card">

        <div class="join-avatar">
            @if (!string.IsNullOrEmpty(pic))
            { <img src="@pic" /> }
            else { @letter }
        </div>

        <div class="join-type-badge @Model.Type">
            @if (isChannel) { <text>📢 Canal</text> }
            else if (Model.Type == "public") { <text>🌍 Grupo público</text> }
            else { <text>🔒 Grupo privado</text> }
        </div>

        <div class="join-name">@Model.Name</div>

        @if (!string.IsNullOrEmpty(Model.Description))
        { <div class="join-desc">@Model.Description</div> }

        <div class="join-stats">
            <div class="join-stat">
                <div class="join-stat-num">@memberCount</div>
                <div class="join-stat-label">Miembros</div>
            </div>
            <div class="join-stat-sep"></div>
            <div class="join-stat">
                <div class="join-stat-num">@(isChannel ? "📢" : Model.Type == "public" ? "🌍" : "🔒")</div>
                <div class="join-stat-label">@(isChannel ? "Canal" : Model.Type == "public" ? "Público" : "Privado")</div>
            </div>
        </div>

        <div class="join-creator">Creado por @(Model.Creator?.Username ?? "Usuario")</div>

        @if (isMember)
        {
            <div class="join-already">✅ Ya eres miembro de este grupo</div>
            <a href="/Group/Chat/@Model.Id" class="join-btn success" style="display:block;text-decoration:none;text-align:center;padding:15px;">
                💬 Ir al chat
            </a>
        }
        else
        {
            @if (TempData["Success"] != null)
            {
                <div class="join-already">✅ @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:16px;padding:14px;margin-bottom:16px;font-size:13px;font-weight:700;color:#f87171;text-align:center;">
                    ❌ @TempData["Error"]
                </div>
            }

            <form asp-controller="Group" asp-action="JoinViaCode" asp-route-code="@Model.InviteCode" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="join-btn" id="joinBtn">
                    @if (isChannel) { <text>📢 Unirse al canal</text> }
                    else { <text>✋ Solicitar unirse</text> }
                </button>
            </form>
        }

        <a href="/Group/Index" class="join-cancel">← Volver a grupos</a>
    </div>
</div>

<script>
document.querySelector('form')?.addEventListener('submit', function() {
    const btn = document.getElementById('joinBtn');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ Procesando...'; }
});
</script>