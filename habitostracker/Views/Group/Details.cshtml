@model HabitTrackerApp.Models.Group

@{
    ViewData["Title"] = Model.Name;
    var isAdmin = (bool)ViewBag.IsAdmin;
    var currentUserId = (int)ViewBag.CurrentUserId;
    var isMuted = (bool)(ViewBag.IsMuted ?? false);
    var members = Model.Members?.Where(m => m.IsActive).ToList() ?? new();
    var isCreator = Model.CreatorId == currentUserId;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.grp-details-page { max-width: 560px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; padding-bottom: 40px; }

.grp-details-hero {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-radius: 24px; padding: 32px 24px; margin-bottom: 14px;
    text-align: center; position: relative; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.06);
}
.grp-details-hero::before {
    content:""; position:absolute; top:-40px; left:50%; transform:translateX(-50%);
    width:200px; height:200px;
    background: radial-gradient(circle, rgba(99,102,241,0.2), transparent 70%);
    border-radius:50%;
}
.grp-details-avatar-wrap { position: relative; display: inline-block; margin: 0 auto 16px; z-index: 1; }
.grp-details-avatar {
    width: 80px; height: 80px; border-radius: 22px;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    font-size: 34px; color: white; font-weight: 800;
    box-shadow: 0 10px 24px rgba(99,102,241,0.4); overflow: hidden;
    cursor: @(isAdmin ? "pointer" : "default"); transition: 0.2s;
}
.grp-details-avatar img { width: 100%; height: 100%; object-fit: cover; }
.grp-details-avatar:hover { @(isAdmin ? "opacity: 0.85;" : "") }
.grp-avatar-edit-badge {
    position: absolute; bottom: -6px; right: -6px;
    width: 26px; height: 26px; border-radius: 50%;
    background: #6366f1; color: white; border: 2px solid #0f172a;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; cursor: pointer; transition: 0.2s;
}
.grp-avatar-edit-badge:hover { background: #4f46e5; transform: scale(1.1); }
.grp-details-name { font-size: 20px; font-weight: 800; color: white; margin: 0 0 6px; position: relative; z-index:1; }
.grp-details-desc { font-size: 13px; color: rgba(255,255,255,0.4); margin: 0 0 6px; position: relative; z-index:1; }
.grp-details-meta { font-size: 12px; color: rgba(255,255,255,0.3); position: relative; z-index:1; }
.grp-back-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 12px;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.7); font-size: 13px; font-weight: 600;
    text-decoration: none; transition: 0.2s; margin-bottom: 16px; position: relative; z-index:1;
}
.grp-back-btn:hover { background: rgba(255,255,255,0.14); color: white; }

.grp-card {
    background: white; border-radius: 20px; padding: 20px 22px;
    margin-bottom: 12px; border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
}
.grp-card-title {
    font-size: 11px; font-weight: 700; color: #6b7280;
    text-transform: uppercase; letter-spacing: 0.7px; margin-bottom: 14px;
}

.grp-action-list { display: flex; flex-direction: column; gap: 6px; }
.grp-action-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px; border-radius: 13px;
    background: #f9fafb; cursor: pointer; transition: 0.15s; font-size: 14px;
    font-weight: 600; color: #111827; border: none;
    width: 100%; text-align: left; font-family: inherit;
}
.grp-action-item:hover { background: #f3f4f6; }
.grp-action-item.danger { color: #dc2626; }
.grp-action-item.danger:hover { background: #fef2f2; }
.grp-action-item.active-mute { color: #f59e0b; background: rgba(245,158,11,0.06); }
.grp-action-icon {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; flex-shrink: 0;
}
.grp-action-icon.blue { background: rgba(37,99,235,0.1); }
.grp-action-icon.red { background: rgba(239,68,68,0.1); }
.grp-action-icon.orange { background: rgba(249,115,22,0.1); }
.grp-action-icon.purple { background: rgba(99,102,241,0.1); }
.grp-action-icon.green { background: rgba(34,197,94,0.1); }
.grp-action-chevron { margin-left: auto; color: #9ca3af; font-size: 12px; }

/* MEMBERS */
.grp-member-row {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 0; border-bottom: 1px solid #f3f4f6;
}
.grp-member-row:last-child { border-bottom: none; padding-bottom: 0; }
.grp-member-avatar {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 15px; font-weight: 800; overflow: hidden;
    text-decoration: none;
}
.grp-member-avatar img { width: 100%; height: 100%; object-fit: cover; }
.grp-member-info { flex: 1; }
.grp-member-name { font-size: 14px; font-weight: 600; color: #111827; }
.grp-member-subrole { font-size: 11px; color: #9ca3af; margin-top: 1px; }
.grp-member-badge {
    font-size: 10px; font-weight: 700; padding: 2px 8px;
    border-radius: 20px; background: #ede9fe; color: #6366f1;
}
.grp-member-badge.creator { background: #111827; color: #fbbf24; }
.grp-member-actions { display: flex; gap: 6px; align-items: center; }
.grp-member-btn {
    width: 28px; height: 28px; border-radius: 8px;
    border: none; cursor: pointer; font-size: 12px; transition: 0.15s;
    display: flex; align-items: center; justify-content: center;
}
.grp-member-btn.remove { background: #fef2f2; color: #dc2626; }
.grp-member-btn.remove:hover { background: #dc2626; color: white; }
.grp-member-btn.promote { background: #fef9c3; color: #d97706; }
.grp-member-btn.promote:hover { background: #f59e0b; color: white; }
.grp-member-btn.demote { background: #ede9fe; color: #6366f1; }
.grp-member-btn.demote:hover { background: #6366f1; color: white; }

/* EDIT */
.grp-edit-field { display: flex; gap: 8px; margin-bottom: 12px; }
.grp-edit-input {
    flex: 1; padding: 10px 14px; border: 1.5px solid #e5e7eb;
    border-radius: 11px; font-size: 14px; font-family: inherit;
    outline: none; transition: 0.2s; color: #111827;
}
.grp-edit-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
.grp-edit-btn {
    padding: 10px 16px; border-radius: 11px; border: none;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    color: white; font-size: 13px; font-weight: 700;
    cursor: pointer; font-family: inherit; transition: 0.2s;
}
.grp-edit-btn:hover { transform: translateY(-1px); }

/* TOAST */
.grp-toast {
    position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%);
    background: #1e293b; color: white; padding: 10px 20px;
    border-radius: 20px; font-size: 13px; font-weight: 600;
    z-index: 99999; box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    animation: toastIn 0.3s ease; font-family: 'Plus Jakarta Sans', sans-serif;
}
@@keyframes toastIn { from{opacity:0;transform:translateX(-50%) translateY(10px);} to{opacity:1;transform:translateX(-50%) translateY(0);} }

/* MODAL AÑADIR MIEMBRO */
.add-member-modal {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.6); z-index: 99999;
    align-items: center; justify-content: center;
    backdrop-filter: blur(8px);
}
.add-member-card {
    background: #0f172a; border-radius: 24px; padding: 28px;
    max-width: 380px; width: 90%;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 30px 70px rgba(0,0,0,0.5);
}
.add-member-title { font-size: 17px; font-weight: 800; color: white; margin: 0 0 4px; }
.add-member-sub { font-size: 13px; color: rgba(255,255,255,0.4); margin: 0 0 18px; }
.add-member-search {
    width: 100%; padding: 11px 14px; border-radius: 12px;
    border: 1.5px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05); color: white;
    font-size: 14px; font-family: inherit; outline: none; margin-bottom: 12px;
    transition: 0.2s; box-sizing: border-box;
}
.add-member-search:focus { border-color: #6366f1; }
.add-member-search::placeholder { color: rgba(255,255,255,0.25); }
.add-member-list { max-height: 260px; overflow-y: auto; margin-bottom: 14px; }
.add-member-list::-webkit-scrollbar { width: 4px; }
.add-member-list::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
.add-member-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px; border-radius: 12px; cursor: pointer;
    transition: 0.15s; border: 1.5px solid transparent;
}
.add-member-item:hover { background: rgba(99,102,241,0.08); border-color: rgba(99,102,241,0.2); }
.add-member-item.selected { background: rgba(99,102,241,0.12); border-color: #6366f1; }
.add-member-avatar {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 14px; font-weight: 800; overflow: hidden;
}
.add-member-avatar img { width: 100%; height: 100%; object-fit: cover; }
.add-member-name { font-size: 14px; font-weight: 600; color: white; flex: 1; }
.add-member-check { color: #6366f1; font-size: 16px; display: none; }
.add-member-item.selected .add-member-check { display: block; }
.add-member-empty { text-align: center; padding: 20px; color: rgba(255,255,255,0.3); font-size: 13px; }
.add-member-btns { display: flex; gap: 10px; }
.add-member-cancel {
    flex: 1; padding: 11px; border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.5);
    font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
}
.add-member-confirm {
    flex: 1; padding: 11px; border-radius: 12px; border: none;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    color: white; font-size: 13px; font-weight: 700;
    cursor: pointer; font-family: inherit; transition: 0.2s;
}
.add-member-confirm:hover { transform: translateY(-1px); }
.add-member-confirm:disabled { background: #334155; cursor: not-allowed; transform: none; }

/* DARK */
body.bg-dark .grp-card { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .grp-card-title { color: #64748b !important; }
body.bg-dark .grp-action-item { background: #2d3748 !important; color: #f1f5f9 !important; }
body.bg-dark .grp-action-item:hover { background: #334155 !important; }
body.bg-dark .grp-action-item.danger { color: #f87171 !important; }
body.bg-dark .grp-action-item.danger:hover { background: #3f1010 !important; }
body.bg-dark .grp-member-name { color: #f1f5f9 !important; }
body.bg-dark .grp-member-row { border-color: #2d3748 !important; }
body.bg-dark .grp-edit-input { background: #2d3748 !important; border-color: #3d4d60 !important; color: #f1f5f9 !important; }
body.bg-dark .grp-member-btn.remove { background: #3f1010 !important; }
body.bg-dark .grp-member-btn.promote { background: #422006 !important; }
body.bg-dark .grp-member-btn.demote { background: #1e1b4b !important; }
</style>

<input type="file" id="groupImageInput" accept="image/*" style="display:none;" onchange="uploadGroupImage(this)" />

<!-- MODAL AÑADIR MIEMBRO -->
<div class="add-member-modal" id="addMemberModal">
    <div class="add-member-card">
        <div class="add-member-title">➕ Añadir miembros</div>
        <div class="add-member-sub">Selecciona amigos para agregar al grupo</div>
        <input type="text" class="add-member-search" placeholder="🔍 Buscar amigos..."
               oninput="filtrarAmigosModal(this.value)" id="addMemberSearch" />
        <div class="add-member-list" id="addMemberList">
            <div class="add-member-empty">Cargando...</div>
        </div>
        <div class="add-member-btns">
            <button class="add-member-cancel" onclick="closeAddMember()">Cancelar</button>
            <button class="add-member-confirm" id="addMemberConfirm" onclick="confirmarAgregar()" disabled>
                Agregar
            </button>
        </div>
    </div>
</div>

<div class="grp-details-page">

    <!-- HERO -->
    <div class="grp-details-hero">
        <a asp-controller="Group" asp-action="Chat" asp-route-id="@Model.Id" class="grp-back-btn">
            ← Volver al chat
        </a>
        <div class="grp-details-avatar-wrap">
            <div class="grp-details-avatar" id="groupAvatarEl"
                 onclick="@(isAdmin ? "document.getElementById('groupImageInput').click()" : "")">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                { <img src="@Model.ImageUrl" id="groupAvatarImg" /> }
                else
                { <span id="groupAvatarLetter">@Model.Name.Substring(0, 1).ToUpper()</span> }
            </div>
            @if (isAdmin)
            {
                <div class="grp-avatar-edit-badge" onclick="document.getElementById('groupImageInput').click()">📷</div>
            }
        </div>
        <div class="grp-details-name" id="groupNameDisplay">@Model.Name</div>
        @if (!string.IsNullOrEmpty(Model.Description))
        { <div class="grp-details-desc">@Model.Description</div> }
        <div class="grp-details-meta">
            Creado por @(Model.Creator?.Username ?? "?") · @members.Count miembro@(members.Count != 1 ? "s" : "")
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="grp-card">
            <div class="grp-card-title">✏️ Editar grupo</div>
            <div class="grp-edit-field">
                <input type="text" id="newGroupName" class="grp-edit-input"
                       placeholder="Nuevo nombre..." value="@Model.Name" />
                <button class="grp-edit-btn" onclick="updateName()">Guardar</button>
            </div>
        </div>
    }

    <!-- MIEMBROS -->
    <div class="grp-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div class="grp-card-title" style="margin:0;">👥 Miembros (@members.Count)</div>
            @if (isAdmin)
            {
                <button onclick="openAddMember()"
                        style="padding:7px 14px;border-radius:10px;border:none;background:linear-gradient(135deg,#6366f1,#2563eb);color:white;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:5px;">
                    ➕ Añadir
                </button>
            }
        </div>

        @foreach (var m in members.OrderByDescending(m => m.UserId == Model.CreatorId).ThenByDescending(m => m.Role == "Admin"))
        {
            var img = m.User?.ProfileImage ?? m.User?.ProfilePicture ?? "";
            var letter = (m.User?.Username ?? "?").Substring(0, 1).ToUpper();
            var isMe = m.UserId == currentUserId;
            var isMemberCreator = m.UserId == Model.CreatorId;
            var isMemberAdmin = m.Role == "Admin";

            <div class="grp-member-row" id="member-row-@m.UserId">
                <a asp-controller="User" asp-action="Profile" asp-route-id="@m.UserId" class="grp-member-avatar">
                    @if (!string.IsNullOrEmpty(img)) { <img src="@img" /> }
                    else { @letter }
                </a>
                <div class="grp-member-info">
                    <div class="grp-member-name">
                        @m.User?.Username @(isMe ? "(Tú)" : "")
                    </div>
                    <div class="grp-member-subrole">
                        @if (isMemberCreator) { <text>👑 Creador</text> }
                        else if (isMemberAdmin) { <text>⭐ Admin</text> }
                        else { <text>👤 Miembro</text> }
                    </div>
                </div>

                @if (isMemberCreator && !isMe)
                {
                    <!-- nadie puede tocar al creador -->
                }
                else if (!isMe && !isMemberCreator)
                {
                    <div class="grp-member-actions">
                        @* Solo el creador puede dar/quitar admin *@
                        @if (isCreator)
                        {
                            @if (!isMemberAdmin)
                            {
                                <button class="grp-member-btn promote"
                                        onclick="promoverAdmin(@m.UserId, '@m.User?.Username')"
                                        title="Dar admin">⭐</button>
                            }
                            else
                            {
                                <button class="grp-member-btn demote"
                                        onclick="quitarAdmin(@m.UserId, '@m.User?.Username')"
                                        title="Quitar admin">↓</button>
                            }
                        }
                        @* Admin y creador pueden eliminar (no a otros admins si no eres creador) *@
                        @if (isAdmin && (isCreator || !isMemberAdmin))
                        {
                            <button class="grp-member-btn remove"
                                    onclick="removeMember(@m.UserId, '@m.User?.Username')"
                                    title="Eliminar del grupo">✕</button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- OPCIONES -->
    <div class="grp-card">
        <div class="grp-card-title">⚙️ Opciones</div>
        <div class="grp-action-list">
            <button class="grp-action-item @(isMuted ? "active-mute" : "")"
                    id="muteActionBtn" onclick="toggleMute()">
                <div class="grp-action-icon orange">
                    <span id="muteIcon">@(isMuted ? "🔕" : "🔔")</span>
                </div>
                <span id="muteLabel">@(isMuted ? "Notificaciones silenciadas" : "Silenciar notificaciones")</span>
                <span class="grp-action-chevron">›</span>
            </button>
            <button class="grp-action-item" onclick="reportarGrupo()">
                <div class="grp-action-icon purple">🚩</div>
                <span>Reportar grupo</span>
                <span class="grp-action-chevron">›</span>
            </button>
            <button class="grp-action-item danger" onclick="confirmarSalir()">
                <div class="grp-action-icon red">🚪</div>
                <span>Salir del grupo</span>
                <span class="grp-action-chevron">›</span>
            </button>
            @if (isCreator)
            {
                <button class="grp-action-item danger" onclick="eliminarGrupo()">
                    <div class="grp-action-icon red">🗑️</div>
                    <span>Eliminar grupo</span>
                    <span class="grp-action-chevron">›</span>
                </button>
            }
        </div>
    </div>
</div>

<!-- MODAL SALIR -->
<div id="leaveModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:99999;align-items:center;justify-content:center;backdrop-filter:blur(8px);">
    <div style="background:#0f172a;border-radius:22px;padding:32px 28px;max-width:340px;width:90%;border:1px solid rgba(255,255,255,0.08);text-align:center;">
        <div style="font-size:40px;margin-bottom:14px;">🚪</div>
        <h4 style="color:white;font-weight:800;margin:0 0 10px;">¿Salir del grupo?</h4>
        <p style="color:rgba(255,255,255,0.4);font-size:13px;margin:0 0 22px;line-height:1.6;">Podrás ver el historial pero no podrás escribir.</p>
        <div style="display:flex;gap:10px;">
            <button onclick="document.getElementById('leaveModal').style.display='none'"
                    style="flex:1;padding:11px;border-radius:11px;border:1px solid #1e293b;background:#1e293b;color:#64748b;font-weight:700;font-size:13px;cursor:pointer;font-family:inherit;">
                Cancelar
            </button>
            <form asp-controller="Group" asp-action="Leave" method="post" style="flex:1;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="groupId" value="@Model.Id" />
                <button type="submit" style="width:100%;padding:11px;border-radius:11px;border:none;background:#dc2626;color:white;font-weight:700;font-size:13px;cursor:pointer;font-family:inherit;">
                    Sí, salir
                </button>
            </form>
        </div>
    </div>
</div>

<!-- MODAL REPORTAR -->
<div id="reportModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:99999;align-items:center;justify-content:center;backdrop-filter:blur(8px);">
    <div style="background:#0f172a;border-radius:22px;padding:32px 28px;max-width:340px;width:90%;border:1px solid rgba(255,255,255,0.08);">
        <div style="font-size:32px;margin-bottom:12px;text-align:center;">🚩</div>
        <h4 style="color:white;font-weight:800;margin:0 0 16px;text-align:center;">Reportar grupo</h4>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:18px;">
            @foreach (var motivo in new[]{"Contenido inapropiado","Spam o publicidad","Acoso o intimidación","Lenguaje ofensivo","Otro"})
            {
                <button onclick="seleccionarMotivo(this, '@motivo')"
                        style="padding:10px 14px;border-radius:11px;border:1.5px solid #1e293b;background:#1e293b;color:#94a3b8;font-size:13px;font-weight:600;cursor:pointer;text-align:left;font-family:inherit;transition:0.15s;">
                    @motivo
                </button>
            }
        </div>
        <div style="display:flex;gap:10px;">
            <button onclick="document.getElementById('reportModal').style.display='none'"
                    style="flex:1;padding:11px;border-radius:11px;border:1px solid #1e293b;background:#1e293b;color:#64748b;font-weight:700;font-size:13px;cursor:pointer;font-family:inherit;">
                Cancelar
            </button>
            <button id="sendReportBtn" onclick="enviarReporte()"
                    style="flex:1;padding:11px;border-radius:11px;border:none;background:#6366f1;color:white;font-weight:700;font-size:13px;cursor:pointer;font-family:inherit;" disabled>
                Reportar
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
const groupId = @Model.Id;
const isCreator = @isCreator.ToString().ToLower();
let isMuted = @isMuted.ToString().ToLower();
let selectedReason = null;
let selectedMembers = new Set();
let allFriends = [];

const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";

function showToast(msg) {
    const t = document.createElement("div");
    t.className = "grp-toast";
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
}

// ── FOTO GRUPO ───────────────────────────
async function uploadGroupImage(input) {
    const file = input.files[0];
    if (!file) return;
    showToast("⏳ Subiendo imagen...");
    const formData = new FormData();
    formData.append("image", file);
    formData.append("groupId", groupId);
    formData.append("__RequestVerificationToken", token());
    try {
        const res = await fetch("/Group/UpdateImage", { method: "POST", body: formData });
        const data = await res.json();
        if (data.success) {
            const el = document.getElementById("groupAvatarEl");
            const letter = document.getElementById("groupAvatarLetter");
            if (letter) letter.remove();
            let img = el.querySelector("img");
            if (!img) { img = document.createElement("img"); img.id = "groupAvatarImg"; el.appendChild(img); }
            img.src = data.imageUrl;
            showToast("✅ Foto actualizada");
        }
    } catch { showToast("❌ Error al subir"); }
}

// ── NOMBRE ───────────────────────────────
async function updateName() {
    const name = document.getElementById("newGroupName").value.trim();
    if (!name) return;
    const res = await fetch("/Group/UpdateName", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&name=${encodeURIComponent(name)}&__RequestVerificationToken=${encodeURIComponent(token())}`
    });
    const data = await res.json();
    if (data.success) { document.getElementById("groupNameDisplay").textContent = name; showToast("✅ Nombre actualizado"); }
    else showToast("❌ No se pudo actualizar");
}

// ── ELIMINAR MIEMBRO ─────────────────────
async function removeMember(userId, username) {
    if (!confirm(`¿Eliminar a ${username} del grupo?`)) return;
    const res = await fetch("/Group/RemoveMember", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&memberId=${userId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    });
    const data = await res.json();
    if (data.success) {
        showToast(`✅ ${username} eliminado`);
        const row = document.getElementById("member-row-" + userId);
        if (row) { row.style.opacity = "0"; row.style.transition = "0.3s"; setTimeout(() => row.remove(), 300); }
    } else showToast("❌ " + (data.message ?? "Error"));
}

// ── PROMOVER ADMIN ───────────────────────
async function promoverAdmin(userId, username) {
