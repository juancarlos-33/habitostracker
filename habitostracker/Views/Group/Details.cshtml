@model HabitTrackerApp.Models.Group
@{
    ViewData["Title"] = Model.Name;
    var isAdmin = (bool)ViewBag.IsAdmin;
    var currentUserId = (int)ViewBag.CurrentUserId;
    var isMuted = (bool)(ViewBag.IsMuted ?? false);
    var members = Model.Members?.Where(m => m.IsActive).ToList() ?? new();
    var isCreator = Model.CreatorId == currentUserId;
    var totalMembers = members.Count;
    var adminCount = members.Count(m => m.Role == "Admin");
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
        --bg: #070b14; --s1: #0d1220; --s2: #111827; --s3: #1e293b;
        --border: rgba(255,255,255,0.06); --border2: rgba(255,255,255,0.1);
        --accent: #6366f1; --accent2: #4f46e5; --green: #22c55e;
        --text: #f1f5f9; --muted: rgba(255,255,255,0.45);
    }
    .gd-page { max-width: 640px; margin: 0 auto; padding-bottom: 90px; color: var(--text); font-family: 'DM Sans', sans-serif; }

    .gd-hero { position: relative; border-radius: 28px; overflow: hidden; margin-bottom: 20px; background: var(--s1); box-shadow: 0 25px 70px rgba(0,0,0,0.5); }
    .gd-hero-cover { height: 170px; background: linear-gradient(135deg, #1e1b4b, #0d1220); position: relative; }
    .gd-hero-cover img { width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }

    .gd-avatar { width: 92px; height: 92px; border-radius: 24px; font-size: 38px; border: 4px solid var(--s1); box-shadow: 0 10px 40px rgba(99,102,241,0.6); cursor: pointer; }
    .gd-card { background: var(--s1); border-radius: 24px; padding: 22px; margin-bottom: 16px; border: 1px solid rgba(255,255,255,0.08); }

    .gd-action-item { transition: all 0.25s ease; }
    .gd-action-item:hover { transform: translateX(6px); background: rgba(99,102,241,0.12) !important; }

    .gd-toast {
        position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);
        background: #1e2937; color: white; padding: 14px 24px; border-radius: 9999px;
        font-weight: 600; box-shadow: 0 10px 30px rgba(0,0,0,0.4); z-index: 999999;
    }
</style>

<!-- INPUTS OCULTOS -->
<input type="file" id="groupImageInput" accept="image/*" style="display:none;" onchange="uploadGroupImage(this)" />
<input type="hidden" id="antiforgery-token" value="@Html.AntiForgeryToken().ToString().Replace("\"", "&quot;")" />

<!-- PHOTO OVERLAY -->
<div class="gd-photo-overlay" id="photoOverlay" onclick="cerrarFoto()">
    <div style="display:flex;flex-direction:column;align-items:center;gap:16px;" onclick="event.stopPropagation()">
        <img id="photoOverlayImg" src="" style="width:280px;height:280px;border-radius:28px;object-fit:cover;border:4px solid rgba(255,255,255,0.2);box-shadow:0 20px 60px rgba(0,0,0,0.6);" />
        <button onclick="cerrarFoto()" style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);color:white;padding:8px 24px;border-radius:20px;font-size:13px;font-weight:700;cursor:pointer;">✕ Cerrar</button>
    </div>
</div>

<!-- MODAL AÑADIR MIEMBRO -->
<div class="gd-modal" id="addMemberModal">
    <div class="gd-modal-card">
        <span class="gd-modal-icon">➕</span>
        <div class="gd-modal-title">Añadir miembros</div>
        <div class="gd-modal-sub">Selecciona personas para agregar al grupo</div>
        <input type="text" class="gd-modal-search" placeholder="🔍 Buscar..." oninput="filtrarAmigosModal(this.value)" id="addMemberSearch" />
        <div class="gd-modal-list" id="addMemberList"><div class="gd-modal-empty">Cargando...</div></div>
        <div class="gd-modal-btns">
            <button class="gd-modal-cancel" onclick="closeModal('addMemberModal')">Cancelar</button>
            <button class="gd-modal-confirm" id="addMemberConfirm" onclick="confirmarAgregar()" disabled>Agregar</button>
        </div>
    </div>
</div>

<!-- MODAL SALIR -->
<div class="gd-modal" id="leaveModal">
    <div class="gd-modal-card">
        <span class="gd-modal-icon">🚪</span>
        <div class="gd-modal-title">¿Salir del grupo?</div>
        <div class="gd-modal-sub">Podrás ver el historial pero no podrás escribir ni recibir nuevos mensajes.</div>
        <div class="gd-modal-btns">
            <button class="gd-modal-cancel" onclick="closeModal('leaveModal')">Cancelar</button>
            <form asp-controller="Group" asp-action="Leave" method="post" style="flex:2;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="groupId" value="@Model.Id" />
                <button type="submit" class="gd-modal-confirm danger-confirm" style="width:100%;">Sí, salir</button>
            </form>
        </div>
    </div>
</div>

<!-- MODAL ELIMINAR -->
<div class="gd-modal" id="deleteModal">
    <div class="gd-modal-card">
        <span class="gd-modal-icon">🗑️</span>
        <div class="gd-modal-title">¿Eliminar el grupo?</div>
        <div class="gd-modal-sub">Esta acción es <strong style="color:#f87171;">permanente e irreversible</strong>.</div>
        <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:12px;padding:12px 14px;margin-bottom:16px;font-size:13px;color:#fca5a5;line-height:1.6;">
            ⚠️ Escribe <strong style="color:white;">ELIMINAR</strong> para confirmar
        </div>
        <input type="text" id="deleteConfirmInput" class="gd-modal-search" placeholder="Escribe ELIMINAR" />
        <div class="gd-modal-btns">
            <button class="gd-modal-cancel" onclick="closeModal('deleteModal')">Cancelar</button>
            <button class="gd-modal-confirm danger-confirm" id="deleteConfirmBtn" onclick="confirmarEliminar()" disabled>Eliminar grupo</button>
        </div>
    </div>
</div>

<!-- MODAL REPORTAR -->
<div class="gd-modal" id="reportModal">
    <div class="gd-modal-card">
        <span class="gd-modal-icon">🚩</span>
        <div class="gd-modal-title">Reportar grupo</div>
        <div class="gd-modal-sub">¿Por qué reportas este grupo?</div>
        <div style="margin-bottom:16px;">
            @foreach (var motivo in new[]{"Contenido inapropiado","Spam o publicidad","Acoso o intimidación","Lenguaje ofensivo","Desinformación","Actividad ilegal","Otro"})
            {
                <button class="gd-reason-btn" onclick="seleccionarMotivo(this, '@motivo')">@motivo</button>
            }
        </div>
        <div class="gd-modal-btns">
            <button class="gd-modal-cancel" onclick="closeModal('reportModal')">Cancelar</button>
            <button id="sendReportBtn" onclick="enviarReporte()" class="gd-modal-confirm" disabled>🚩 Reportar</button>
        </div>
    </div>
</div>

<!-- MODAL ADMIN ONLY -->
<div class="gd-modal" id="adminOnlyModal">
    <div class="gd-modal-card">
        <span class="gd-modal-icon">🔒</span>
        <div class="gd-modal-title">Modo solo admins</div>
        <div class="gd-modal-sub">Cuando está activo, solo administradores pueden enviar mensajes. Los miembros solo pueden leer.</div>
        <div class="gd-modal-btns">
            <button class="gd-modal-cancel" onclick="closeModal('adminOnlyModal')">Cancelar</button>
            <button class="gd-modal-confirm" onclick="confirmarAdminOnly()">@(Model.IsAdminOnly ? "Desactivar" : "Activar")</button>
        </div>
    </div>
</div>

<div class="gd-page">

    <!-- HERO -->
    <div class="gd-hero">
        <div class="gd-hero-cover">
            <div class="gd-hero-cover-grid"></div>
            @if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img src="@Model.ImageUrl" /> }
        </div>
        <a asp-controller="Group" asp-action="Chat" asp-route-id="@Model.Id" class="gd-back-btn">← Chat</a>
        <div class="gd-type-badge @Model.Type">
            @(Model.Type == "channel" ? "📢 Canal" : Model.Type == "public" ? "🌍 Público" : "🔒 Privado")
        </div>
        <div class="gd-hero-body">
            <div class="gd-avatar-zone">
                <div class="gd-avatar-wrap">
                    <div class="gd-avatar" id="groupAvatarEl" onclick="abrirFoto()">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        { <img src="@Model.ImageUrl" id="groupAvatarImg" /> }
                        else { <span id="groupAvatarLetter">@Model.Name.Substring(0, 1).ToUpper()</span> }
                    </div>
                    @if (isAdmin)
                    { <div class="gd-avatar-edit" onclick="document.getElementById('groupImageInput').click()">📷</div> }
                </div>
                <div class="gd-hero-actions">
                    <a asp-controller="Group" asp-action="Chat" asp-route-id="@Model.Id" class="gd-hero-action-btn primary">💬 Chat</a>
                    <button class="gd-hero-action-btn secondary" id="compartirGrupoBtn">↗️ Compartir</button>
                </div>
            </div>
            <div class="gd-hero-name" id="groupNameDisplay">@Model.Name</div>
            @if (!string.IsNullOrEmpty(Model.Description)) { <div class="gd-hero-desc">@Model.Description</div> }
            <div class="gd-hero-meta">
                <div class="gd-hero-meta-item">👥 @totalMembers miembro@(totalMembers != 1 ? "s" : "")</div>
                <div class="gd-hero-meta-item">👑 @(Model.Creator?.Username ?? "?")</div>
                <div class="gd-hero-meta-item">📅 @Model.CreatedAt.ToString("MMM yyyy")</div>
                @if (Model.IsAdminOnly) { <div class="gd-hero-meta-item" style="color:#f59e0b;">🔒 Solo admins</div> }
            </div>
        </div>
    </div>

    <!-- EDITAR -->
    @if (isAdmin)
    {
        <div class="gd-card">
            <div class="gd-card-hd"><div class="gd-card-title">✏️ Editar grupo</div></div>
            <div class="gd-edit-row">
                <input type="text" id="newGroupName" class="gd-edit-input" placeholder="Nombre del grupo..." value="@Model.Name" />
                <button class="gd-edit-btn" id="updateNameBtn">Guardar</button>
            </div>
        </div>

        <!-- ENLACE DE INVITACIÓN -->
        <div class="gd-card">
            <div class="gd-card-hd">
                <div class="gd-card-title">🔗 Enlace de invitación</div>
                <button class="gd-card-btn" id="generarEnlaceBtn">Generar</button>
            </div>
            <div id="inviteSection" style="display:none;">
                <div class="gd-invite-box">
                    <div class="gd-invite-label">Código</div>
                    <div class="gd-invite-code" id="inviteCode">—</div>
                    <div class="gd-invite-link" id="inviteLink">—</div>
                    <div class="gd-invite-btns">
                        <button class="gd-invite-btn copy" id="copiarEnlaceBtn">📋 Copiar</button>
                        <button class="gd-invite-btn share" id="compartirEnlaceBtn">↗️ Compartir</button>
                        <button class="gd-invite-btn reset" id="resetEnlaceBtn">🔄 Nuevo</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- INFO DEL GRUPO -->
    <div class="gd-card">
        <div class="gd-card-hd"><div class="gd-card-title">ℹ️ Información</div></div>
        <div class="gd-info-grid">
            <div class="gd-info-row">
                <span class="gd-info-label">Tipo de grupo</span>
                <span class="gd-info-value">@(Model.Type == "channel" ? "📢 Canal" : Model.Type == "public" ? "🌍 Público" : "🔒 Privado")</span>
            </div>
            <div class="gd-info-row">
                <span class="gd-info-label">Creado por</span>
                <span class="gd-info-value">@(Model.Creator?.Username ?? "?")</span>
            </div>
            <div class="gd-info-row">
                <span class="gd-info-label">Fecha de creación</span>
                <span class="gd-info-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
            </div>
            <div class="gd-info-row">
                <span class="gd-info-label">Modo escritura</span>
                <span class="gd-info-value">@(Model.IsAdminOnly ? "Solo admins" : "Todos los miembros")</span>
            </div>
            <div class="gd-info-row">
                <span class="gd-info-label">Tu rol</span>
                <span class="gd-info-value">@(isCreator ? "👑 Creador" : isAdmin ? "⭐ Admin" : "👤 Miembro")</span>
            </div>
        </div>
    </div>

    <!-- MIEMBROS -->
    <div class="gd-card">
        <div class="gd-card-hd">
            <div class="gd-card-title">👥 Miembros (@totalMembers)</div>
            @if (isAdmin) { <button class="gd-card-btn" id="openAddMemberBtn">➕ Añadir</button> }
        </div>
        <div class="gd-members-count-bar">
            <span>👑 <strong>@adminCount</strong> admin@(adminCount != 1 ? "s" : "")</span>
            <span style="color:var(--border2);">·</span>
            <span>👤 <strong>@(totalMembers - adminCount)</strong> miembro@((totalMembers - adminCount) != 1 ? "s" : "")</span>
        </div>
        <div class="gd-search-wrap">
            <span class="gd-search-icon">🔍</span>
            <input type="text" class="gd-search-input" placeholder="Buscar miembro..." oninput="filtrarMiembros(this.value)" />
        </div>
        <div id="membersList">
            @foreach (var m in members.OrderByDescending(m => m.UserId == Model.CreatorId).ThenByDescending(m => m.Role == "Admin"))
            {
                var img = m.User?.ProfileImage ?? m.User?.ProfilePicture ?? "";
                var letter = (m.User?.Username ?? "?").Substring(0, 1).ToUpper();
                var isMe = m.UserId == currentUserId;
                var isMemberCreator = m.UserId == Model.CreatorId;
                var isMemberAdmin = m.Role == "Admin";

                <div class="gd-member" id="member-row-@m.UserId" data-name="@m.User?.Username?.ToLower()">
                    <a asp-controller="User" asp-action="Profile" asp-route-id="@m.UserId" class="gd-member-avatar">
                        @if (!string.IsNullOrEmpty(img)) { <img src="@img" /> } else { @letter }
                    </a>
                    <div class="gd-member-info">
                        <div class="gd-member-name">
                            @m.User?.Username
                            @if (isMe) { <span class="gd-badge me">Tú</span> }
                            @if (isMemberCreator) { <span class="gd-badge creator">👑 Creador</span> }
                            else if (isMemberAdmin) { <span class="gd-badge admin">⭐ Admin</span> }
                        </div>
                        <div class="gd-member-sub">
                            @if (isMemberCreator) { <text>Fundador · desde @m.JoinedAt.ToString("MMM yyyy")</text> }
                            else if (isMemberAdmin) { <text>Administrador · desde @m.JoinedAt.ToString("MMM yyyy")</text> }
                            else { <text>Miembro · desde @m.JoinedAt.ToString("MMM yyyy")</text> }
                        </div>
                    </div>
                    <div class="gd-member-btns">
                        @if (!isMe && !isMemberCreator)
                        {
                            <a href="/Message/Chat/@m.UserId" class="gd-mbtn msg" title="Mensaje privado">💬</a>
                            @if (isCreator)
                            {
                                @if (!isMemberAdmin)
                                { <button class="gd-mbtn promote" data-user-id="@m.UserId" data-username="@m.User?.Username">⭐</button> }
                                else
                                { <button class="gd-mbtn demote" data-user-id="@m.UserId" data-username="@m.User?.Username">↓</button> }
                            }
                            @if (isAdmin && (isCreator || !isMemberAdmin))
                            { <button class="gd-mbtn remove" data-user-id="@m.UserId" data-username="@m.User?.Username">✕</button> }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- OPCIONES -->
    <div class="gd-card">
        <div class="gd-card-hd"><div class="gd-card-title">⚙️ Opciones</div></div>
        <div class="gd-action-list">
            <button class="gd-action-item" id="muteBtn">
                <div class="gd-action-icon orange"><span id="muteIcon">@(isMuted ? "🔕" : "🔔")</span></div>
                <div style="flex:1;">
                    <div id="muteLabel">@(isMuted ? "Silenciado" : "Silenciar notificaciones")</div>
                </div>
                <div class="gd-toggle @(isMuted ? "on" : "")" id="muteToggle"></div>
            </button>

            @if (isCreator)
            {
                <div class="gd-action-item" id="toggleTypeBtn">
                    <div class="gd-action-icon purple" id="toggleIcon">@(Model.Type == "public" ? "🔒" : "🌍")</div>
                    <div style="flex:1;">
                        <div id="toggleText">@(Model.Type == "public" ? "Hacer privado" : "Hacer público")</div>
                    </div>
                </div>
            }

            @if (isAdmin)
            {
                <button class="gd-action-item" onclick="openModal('adminOnlyModal')">
                    <div class="gd-action-icon cyan">🔒</div>
                    <div style="flex:1;">
                        <div>Solo admins pueden escribir</div>
                    </div>
                </button>
            }

            <button class="gd-action-item" id="compartirGrupoBtn2">
                <div class="gd-action-icon green">↗️</div>
                <div style="flex:1;"><div>Compartir grupo</div></div>
            </button>

            <button class="gd-action-item" id="reportarGrupoBtn">
                <div class="gd-action-icon purple">🚩</div>
                <div style="flex:1;"><div>Reportar grupo</div></div>
            </button>

            <button class="gd-action-item danger" id="leaveGroupBtn">
                <div class="gd-action-icon red">🚪</div>
                <div style="flex:1;"><div>Salir del grupo</div></div>
            </button>

            @if (isCreator)
            {
                <button class="gd-action-item danger" id="deleteGroupBtn">
                    <div class="gd-action-icon red">🗑️</div>
                    <div style="flex:1;"><div>Eliminar grupo</div></div>
                </button>
            }
        </div>
    </div>
</div>

<script>
// ==================== SCRIPT COMPLETO Y CORREGIDO ====================
const groupId = @Model.Id;
const isCreator = @isCreator.ToString().ToLower();
const isAdmin = @isAdmin.ToString().ToLower();
let isMuted = @isMuted.ToString().ToLower();

let selectedReason = null;
let selectedMembers = new Set();
let allFriends = [];
let currentInviteLink = '';

const token = () => document.getElementById('antiforgery-token')?.value ?? "";

function showToast(msg) {
    const t = document.createElement("div");
    t.className = "gd-toast";
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3200);
}

function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

function confirmarAccion({title, message, confirmText = "Confirmar", danger = false, onConfirm}) {
    showConfirm({ icon: danger ? "🗑️" : "⚠️", title, message, confirmText, confirmColor: danger ? '#ef4444' : '#6366f1', onConfirm });
}

// ==================== FUNCIONES ====================

async function generarEnlace() {
    document.getElementById('inviteSection').style.display = 'block';
    try {
        const res = await fetch('/Group/GenerateInviteCode', {
            method: 'POST',
            headers: { "Content-Type": "application/x-www-form-urlencoded", "RequestVerificationToken": token() },
            body: `groupId=${groupId}`
        });
        const data = await res.json();
        if (data.success) {
            currentInviteLink = data.link;
            document.getElementById('inviteCode').textContent = data.code;
            document.getElementById('inviteLink').textContent = data.link;
            showToast('✅ Enlace generado');
        }
    } catch { showToast('❌ Error'); }
}

async function openAddMember() {
    selectedMembers.clear();
    openModal('addMemberModal');
    document.getElementById("addMemberList").innerHTML = '<div class="gd-modal-empty">Cargando...</div>';
    try {
        const res = await fetch(`/Group/GetFriendsToAdd?groupId=${groupId}`);
        allFriends = await res.json();
        renderFriendsList(allFriends);
    } catch { document.getElementById("addMemberList").innerHTML = '<div class="gd-modal-empty">Error al cargar</div>'; }
}

function renderFriendsList(friends) {
    const list = document.getElementById("addMemberList");
    list.innerHTML = friends.map(f => `
        <div class="gd-modal-item" onclick="toggleSelectFriend(${f.id}, this)">
            <div class="gd-modal-avatar">${f.img ? `<img src="${f.img}">` : f.username[0].toUpperCase()}</div>
            <div class="gd-modal-name">${f.username}</div>
            <span class="gd-modal-check">✓</span>
        </div>
    `).join('');
}

function toggleSelectFriend(id, el) {
    if (selectedMembers.has(id)) {
        selectedMembers.delete(id);
        el.classList.remove('selected');
    } else {
        selectedMembers.add(id);
        el.classList.add('selected');
    }
    const btn = document.getElementById("addMemberConfirm");
    btn.disabled = selectedMembers.size === 0;
    btn.textContent = selectedMembers.size ? `Agregar (${selectedMembers.size})` : "Agregar";
}

async function confirmarAgregar() {
    if (!selectedMembers.size) return;
    const btn = document.getElementById("addMemberConfirm");
    btn.disabled = true; btn.textContent = "Agregando...";

    let ok = 0;
    for (const id of selectedMembers) {
        try {
            const res = await fetch("/Group/AddMember", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded", "RequestVerificationToken": token() },
                body: `groupId=${groupId}&newUserId=${id}`
            });
            if ((await res.json()).success) ok++;
        } catch {}
    }
    closeModal('addMemberModal');
    if (ok > 0) { showToast(`✅ ${ok} miembro(s) agregado(s)`); setTimeout(() => location.reload(), 1000); }
}

async function toggleMute() {
    try {
        const res = await fetch("/Group/ToggleMute", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded", "RequestVerificationToken": token() },
            body: `groupId=${groupId}`
        });
        const data = await res.json();
        if (data.success) {
            isMuted = data.isMuted.toString();
            document.getElementById("muteIcon").textContent = isMuted === "true" ? "🔕" : "🔔";
            document.getElementById("muteLabel").textContent = isMuted === "true" ? "Silenciado" : "Silenciar notificaciones";
            document.getElementById("muteToggle").classList.toggle("on", isMuted === "true");
            showToast(isMuted === "true" ? "🔕 Silenciado" : "🔔 Activado");
        }
    } catch { showToast("❌ Error"); }
}

async function toggleGroupType() {
    confirmarAccion({
        title: "Cambiar visibilidad",
        message: "Esto afectará quién puede ver y unirse al grupo.",
        confirmText: "Cambiar",
        onConfirm: async () => {
            try {
                const res = await fetch('/Group/ToggleGroupType', {
                    method: 'POST',
                    headers: { "Content-Type": "application/x-www-form-urlencoded", "RequestVerificationToken": token() },
                    body: `groupId=${groupId}`
                });
                if (res.ok) {
                    showToast("✅ Tipo cambiado");
                    setTimeout(() => location.reload(), 900);
                } else showToast("❌ No tienes permiso");
            } catch { showToast("❌ Error"); }
        }
    });
}

function leaveGroup() {
    confirmarAccion({
        title: "¿Salir del grupo?",
        message: "Podrás ver el historial pero no recibirás nuevos mensajes.",
        danger: true,
        onConfirm: () => document.querySelector('#leaveModal form').submit()
    });
}

function deleteGroup() {
    confirmarAccion({
        title: "¿Eliminar grupo?",
        message: "Esta acción es irreversible.",
        danger: true,
        onConfirm: () => {
            const form = document.createElement("form");
            form.method = "POST"; form.action = "/Group/Delete";
            form.innerHTML = `<input type="hidden" name="groupId" value="${groupId}" /><input type="hidden" name="__RequestVerificationToken" value="${token()}" />`;
            document.body.appendChild(form);
            form.submit();
        }
    });
}

async function enviarReporte() {
    if (!selectedReason) return;
    closeModal('reportModal');
    try {
        const res = await fetch("/Group/Report", {
            method: "POST",
            headers: { "Content-Type": "application/json", "RequestVerificationToken": token() },
            body: JSON.stringify({ groupId, reason: selectedReason })
        });
        const data = await res.json();
        showToast(data.success ? "✅ Reporte enviado" : "❌ Error");
    } catch { showToast("❌ Error"); }
}

// ==================== EVENTOS ====================
document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('generarEnlaceBtn')?.addEventListener('click', generarEnlace);
    document.getElementById('openAddMemberBtn')?.addEventListener('click', openAddMember);
    document.getElementById('muteBtn')?.addEventListener('click', toggleMute);
    document.getElementById('toggleTypeBtn')?.addEventListener('click', toggleGroupType);
    document.getElementById('leaveGroupBtn')?.addEventListener('click', leaveGroup);
    document.getElementById('deleteGroupBtn')?.addEventListener('click', deleteGroup);
    document.getElementById('reportarGrupoBtn')?.addEventListener('click', () => openModal('reportModal'));

    // Miembros
    document.querySelectorAll('.gd-mbtn.promote').forEach(btn => {
        btn.addEventListener('click', () => promoverAdmin(btn.dataset.userId, btn.dataset.username));
    });
    document.querySelectorAll('.gd-mbtn.remove').forEach(btn => {
        btn.addEventListener('click', () => removeMember(btn.dataset.userId, btn.dataset.username));
    });
});
</script>