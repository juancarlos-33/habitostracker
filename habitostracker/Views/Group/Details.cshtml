// ── SILENCIAR ────────────────────────────
async function toggleMute() {
    const res = await fetch("/Group/ToggleMute", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
    });
    const data = await res.json();
    if (data.success) {
        isMuted = data.isMuted;
        document.getElementById("muteIcon").textContent = isMuted ? "🔕" : "🔔";
        document.getElementById("muteLabel").textContent = isMuted ? "Notificaciones silenciadas" : "Silenciar notificaciones";
        document.getElementById("muteActionBtn").classList.toggle("active-mute", isMuted);
        showToast(isMuted ? "🔕 Silenciadas" : "🔔 Activadas");
    }
}

// ── MODAL AÑADIR MIEMBRO ─────────────────
async function openAddMember() {
    selectedMembers.clear();
    document.getElementById("addMemberSearch").value = "";
    document.getElementById("addMemberConfirm").disabled = true;
    document.getElementById("addMemberModal").style.display = "flex";
    document.getElementById("addMemberList").innerHTML = '<div class="add-member-empty">Cargando...</div>';

    try {
        const res = await fetch(`/Group/GetFriendsToAdd?groupId=${groupId}`);
        allFriends = await res.json();
        renderFriendsList(allFriends);
    } catch {
        document.getElementById("addMemberList").innerHTML = '<div class="add-member-empty">Error al cargar</div>';
    }
}

function renderFriendsList(friends) {
    const list = document.getElementById("addMemberList");
    if (!friends.length) {
        list.innerHTML = '<div class="add-member-empty">No hay amigos disponibles para agregar</div>';
        return;
    }
    list.innerHTML = friends.map(f => {
        const avatarHTML = f.img
            ? `<img src="${f.img}" style="width:100%;height:100%;object-fit:cover;" />`
            : f.username.charAt(0).toUpperCase();
        return `
        <div class="add-member-item" id="friend-item-${f.id}" onclick="toggleSelectFriend(${f.id})">
            <div class="add-member-avatar">${avatarHTML}</div>
            <div class="add-member-name">${f.username}</div>
            <span class="add-member-check">✓</span>
        </div>`;
    }).join("");
}

function filtrarAmigosModal(q) {
    q = q.toLowerCase().trim();
    const filtered = q ? allFriends.filter(f => f.username.toLowerCase().includes(q)) : allFriends;
    renderFriendsList(filtered);
    // restaurar seleccionados
    selectedMembers.forEach(id => {
        const item = document.getElementById("friend-item-" + id);
        if (item) item.classList.add("selected");
    });
}

function toggleSelectFriend(id) {
    const item = document.getElementById("friend-item-" + id);
    if (!item) return;
    if (selectedMembers.has(id)) {
        selectedMembers.delete(id);
        item.classList.remove("selected");
    } else {
        selectedMembers.add(id);
        item.classList.add("selected");
    }
    document.getElementById("addMemberConfirm").disabled = selectedMembers.size === 0;
    const btn = document.getElementById("addMemberConfirm");
    btn.textContent = selectedMembers.size > 0 ? `Agregar (${selectedMembers.size})` : "Agregar";
}

async function confirmarAgregar() {
    if (!selectedMembers.size) return;
    const btn = document.getElementById("addMemberConfirm");
    btn.disabled = true; btn.textContent = "⏳ Agregando...";

    let ok = 0, fail = 0;
    for (const memberId of selectedMembers) {
        try {
            const res = await fetch("/Group/AddMember", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `groupId=${groupId}&newUserId=${memberId}&__RequestVerificationToken=${encodeURIComponent(token())}`
            });
            const data = await res.json();
            if (data.success) ok++; else fail++;
        } catch { fail++; }
    }

    closeAddMember();
    if (ok > 0) {
        showToast(`✅ ${ok} miembro${ok !== 1 ? "s" : ""} agregado${ok !== 1 ? "s" : ""}`);
        setTimeout(() => location.reload(), 1200);
    }
    if (fail > 0) showToast(`⚠️ ${fail} no se pudo agregar`);
}

function closeAddMember() {
    document.getElementById("addMemberModal").style.display = "none";
    selectedMembers.clear();
}
document.getElementById("addMemberModal").addEventListener("click", function(e) {
    if (e.target === this) closeAddMember();
});

// ── SALIR ────────────────────────────────
function confirmarSalir() {
    document.getElementById("leaveModal").style.display = "flex";
}

// ── REPORTAR ─────────────────────────────
function reportarGrupo() {
    selectedReason = null;
    document.getElementById("sendReportBtn").disabled = true;
    document.querySelectorAll("#reportModal button[onclick^='seleccionar']").forEach(b => {
        b.style.borderColor = "#1e293b"; b.style.color = "#94a3b8";
    });
    document.getElementById("reportModal").style.display = "flex";
}
function seleccionarMotivo(btn, motivo) {
    document.querySelectorAll("#reportModal button[onclick^='seleccionar']").forEach(b => {
        b.style.borderColor = "#1e293b"; b.style.color = "#94a3b8";
    });
    btn.style.borderColor = "#6366f1"; btn.style.color = "#818cf8";
    selectedReason = motivo;
    document.getElementById("sendReportBtn").disabled = false;
}
async function enviarReporte() {
    if (!selectedReason) return;
    document.getElementById("reportModal").style.display = "none";
    const res = await fetch("/Group/Report", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ groupId, reason: selectedReason })
    });
    const data = await res.json();
    showToast(data.success ? "✅ Reporte enviado" : "⚠️ " + (data.message ?? "Error"));
}

// ── ELIMINAR GRUPO ───────────────────────
async function eliminarGrupo() {
    if (!confirm("¿Eliminar este grupo permanentemente?")) return;
    const form = document.createElement("form");
    form.method = "POST"; form.action = "/Group/Delete";
    const input = document.createElement("input"); input.type = "hidden"; input.name = "groupId"; input.value = groupId;
    const tok = document.createElement("input"); tok.type = "hidden"; tok.name = "__RequestVerificationToken"; tok.value = token();
    form.appendChild(input); form.appendChild(tok);
    document.body.appendChild(form); form.submit();
}
</script>