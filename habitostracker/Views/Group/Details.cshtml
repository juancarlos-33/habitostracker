// ── ENLACE INVITACIÓN ──
async function generarEnlace() {
    document.getElementById('inviteSection').style.display = 'block';
    document.getElementById('inviteCode').textContent = '⏳';
    document.getElementById('inviteLink').textContent = 'Generando...';
    try {
        const res = await fetch('/Group/GenerateInviteCode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
        });
        const data = await res.json();
        if (data.success) {
            currentInviteLink = data.link;
            document.getElementById('inviteCode').textContent = data.code;
            document.getElementById('inviteLink').textContent = data.link;
        }
    } catch { showToast("❌ Error al generar"); }
}

async function resetEnlace() {
    document.getElementById('inviteCode').textContent = '⏳';
    try {
        const res = await fetch('/Group/ResetInviteCode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `groupId=${groupId}&__RequestVerificationToken=${encodeURIComponent(token())}`
        });
        const data = await res.json();
        if (data.success) {
            currentInviteLink = data.link;
            document.getElementById('inviteCode').textContent = data.code ?? '';
            document.getElementById('inviteLink').textContent = data.link;
            showToast('🔄 Enlace renovado');
        }
    } catch { showToast("❌ Error"); }
}

function copiarEnlace() {
    if (!currentInviteLink) return;
    navigator.clipboard.writeText(currentInviteLink)
        .then(() => showToast('📋 Enlace copiado'))
        .catch(() => { const i = document.createElement('input'); i.value = currentInviteLink; document.body.appendChild(i); i.select(); document.execCommand('copy'); i.remove(); showToast('📋 Enlace copiado'); });
}

function compartirEnlace() {
    if (!currentInviteLink) return;
    if (navigator.share) {
        navigator.share({ title: '@Model.Name', text: 'Únete al grupo en HabitTracker', url: currentInviteLink });
    } else {
        copiarEnlace();
    }
}

function compartirGrupo() {
    const url = window.location.origin + '/Group/Chat/@Model.Id';
    if (navigator.share) {
        navigator.share({ title: '@Model.Name', text: 'Mira este grupo en HabitTracker', url });
    } else {
        navigator.clipboard.writeText(url).then(() => showToast('📋 Link copiado'));
    }
}

// ── AÑADIR MIEMBRO ──
async function openAddMember() {
    selectedMembers.clear();
    document.getElementById("addMemberSearch").value = "";
    document.getElementById("addMemberConfirm").disabled = true;
    document.getElementById("addMemberConfirm").textContent = "Agregar";
    openModal('addMemberModal');
    document.getElementById("addMemberList").innerHTML = '<div class="gd-modal-empty">⏳ Cargando...</div>';
    try {
        const res = await fetch(`/Group/GetFriendsToAdd?groupId=${groupId}`);
        allFriends = await res.json();
        renderFriendsList(allFriends);
    } catch { document.getElementById("addMemberList").innerHTML = '<div class="gd-modal-empty">❌ Error al cargar</div>'; }
}

function renderFriendsList(friends) {
    const list = document.getElementById("addMemberList");
    if (!friends.length) { list.innerHTML = '<div class="gd-modal-empty">Sin amigos disponibles para agregar</div>'; return; }
    list.innerHTML = friends.map(f => {
        const avatar = f.img ? `<img src="${f.img}" style="width:100%;height:100%;object-fit:cover;" />` : f.username.charAt(0).toUpperCase();
        return `<div class="gd-modal-item ${selectedMembers.has(f.id) ? 'selected' : ''}" id="friend-item-${f.id}" onclick="toggleSelectFriend(${f.id})">
            <div class="gd-modal-avatar">${avatar}</div>
            <div class="gd-modal-name">${f.username}</div>
            <span class="gd-modal-check">✓</span>
        </div>`;
    }).join("");
}

function filtrarAmigosModal(q) {
    q = q.toLowerCase().trim();
    const filtered = q ? allFriends.filter(f => f.username.toLowerCase().includes(q)) : allFriends;
    renderFriendsList(filtered);
}

function toggleSelectFriend(id) {
    const item = document.getElementById("friend-item-" + id); if (!item) return;
    if (selectedMembers.has(id)) { selectedMembers.delete(id); item.classList.remove("selected"); }
    else { selectedMembers.add(id); item.classList.add("selected"); }
    const btn = document.getElementById("addMemberConfirm");
    btn.disabled = selectedMembers.size === 0;
    btn.textContent = selectedMembers.size > 0 ? `Agregar (${selectedMembers.size})` : "Agregar";
}

async function confirmarAgregar() {
    if (!selectedMembers.size) return;
    const btn = document.getElementById("addMemberConfirm");
    btn.disabled = true; btn.textContent = "⏳ Agregando...";
    let ok = 0, fail = 0;
    for (const memberId of selectedMembers) {
        try {
            const res = await fetch("/Group/AddMember", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `groupId=${groupId}&newUserId=${memberId}&__RequestVerificationToken=${encodeURIComponent(token())}`
            });
            const data = await res.json();
            data.success ? ok++ : fail++;
        } catch { fail++; }
    }
    closeModal('addMemberModal');
    if (ok > 0) { showToast(`✅ ${ok} miembro${ok !== 1 ? "s" : ""} agregado${ok !== 1 ? "s" : ""}`); setTimeout(() => location.reload(), 1200); }
    if (fail > 0) showToast(`⚠️ ${fail} no se pudo agregar`);
}

// ── REPORTAR ──
function reportarGrupo() {
    selectedReason = null;
    document.getElementById("sendReportBtn").disabled = true;
    document.querySelectorAll('.gd-reason-btn').forEach(b => b.classList.remove('selected'));
    openModal('reportModal');
}
function seleccionarMotivo(btn, motivo) {
    document.querySelectorAll('.gd-reason-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    selectedReason = motivo;
    document.getElementById("sendReportBtn").disabled = false;
}
async function enviarReporte() {
    if (!selectedReason) return;
    closeModal('reportModal');
    const res = await fetch("/Group/Report", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ groupId, reason: selectedReason })
    });
    const data = await res.json();
    showToast(data.success ? "✅ Reporte enviado. Lo revisaremos pronto." : "⚠️ " + (data.message ?? "Error"));
}

// ── ELIMINAR GRUPO CON CONFIRMACIÓN ESCRITA ──
document.getElementById('deleteConfirmInput')?.addEventListener('input', function() {
    document.getElementById('deleteConfirmBtn').disabled = this.value.trim().toUpperCase() !== 'ELIMINAR';
});

function confirmarEliminar() {
    const form = document.createElement("form");
    form.method = "POST"; form.action = "/Group/Delete";
    const inp = document.createElement("input"); inp.type = "hidden"; inp.name = "groupId"; inp.value = groupId;
    const tok = document.createElement("input"); tok.type = "hidden"; tok.name = "__RequestVerificationToken"; tok.value = token();
    form.appendChild(inp); form.appendChild(tok);
    document.body.appendChild(form); form.submit();
}
