@model HabitTrackerApp.Models.Post

@{
    ViewData["Title"] = "Detalles de la publicación";
}

<div class="container mt-4" style="max-width: 680px;">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        
        <!-- HEADER -->
        <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
            <div class="d-flex align-items-center gap-3">
                @if (Model.User != null)
                {
                    <a asp-controller="User" asp-action="Profile" asp-route-id="@Model.UserId">
                        @if (!string.IsNullOrEmpty(Model.User.ProfileImage))
                        {
                            <img src="@Model.User.ProfileImage" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;" />
                        }
                        else
                        {
                            <div style="width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #2563eb); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800;">@Model.User.Username.Substring(0,1).ToUpper()</div>
                        }
                    </a>
                    <div>
                        <div class="fw-bold">@Model.User.Username</div>
                        <div class="text-muted small">@Model.CreatedAt.ToString("dd MMM yyyy · hh:mm tt", new System.Globalization.CultureInfo("es-CO"))</div>
                    </div>
                }
            </div>
        </div>

        <!-- ALERTAS ROJAS (si está en advertencia) -->
        @if (Model.IsUnderWarning)
        {
            <div class="px-4 mt-2">
                <div class="alert alert-danger py-1" style="border-left: 4px solid #dc2626; font-size: 13px;">
                    ⚠️ <strong>Incumple nuestras normas</strong> 
                </div>
                <div class="alert alert-danger py-1" style="border-left: 4px solid #dc2626; background-color: #fff5f5; font-size: 13px;">
                    🔴 <strong>Cuenta en riesgo</strong>
                </div>
                <div class="alert alert-dark py-2 mt-1" role="alert">
                    🛑 <strong>Publicación sancionada</strong> – Esta publicación ha sido revisada y no cumple con nuestras directrices. 
                    El autor ha recibido una advertencia oficial. Los comentarios están permanentemente deshabilitados.
                </div>
            </div>
        }

        <!-- DESCRIPCIÓN -->
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="card-body px-4 pt-2 pb-0">
                <p class="card-text" style="font-size: 15px; line-height: 1.6;">@Model.Description</p>
            </div>
        }

        <!-- IMAGEN / VIDEO -->
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="px-4 pb-3">
                @if (Model.ImagePath.Contains(".mp4") || Model.ImagePath.Contains(".mov") || Model.ImagePath.Contains("/video/upload/"))
                {
                    <video controls class="img-fluid rounded-3" style="max-height: 500px; width: 100%;">
                        <source src="@Model.ImagePath" />
                    </video>
                }
                else
                {
                    <img src="@Model.ImagePath" class="img-fluid rounded-3" style="max-height: 500px; width: 100%; object-fit: cover;" />
                }
            </div>
        }

        <!-- SECCIÓN DE COMENTARIOS -->
        <div class="card-footer bg-white border-0 px-4 pb-4 pt-2">
            <h6 class="mb-3">💬 Comentarios</h6>

            @if (!Model.CommentsDisabled)
            {
                <!-- Formulario para agregar comentario (si no está deshabilitado) -->
                <form asp-action="AddComment" method="post" class="mb-4" enctype="multipart/form-data">
                    <input type="hidden" name="postId" value="@Model.Id" />
                    <div class="input-group">
                        <input type="text" name="comment" class="form-control rounded-pill" placeholder="Escribe un comentario..." />
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Enviar</button>
                    </div>
                </form>

                <!-- Aquí iría la lista de comentarios existentes (puedes cargarlos desde el controlador) -->
             <div id="commentsList">
    @foreach (var comment in ViewBag.Comments as List<HabitTrackerApp.Models.PostComment> ?? new List<HabitTrackerApp.Models.PostComment>())
    {
        <div style="padding:10px 0; border-bottom:1px solid #eee;">
            <strong>@comment.Username</strong>
            <span style="font-size:12px; color:#999; margin-left:8px;">@comment.CreatedAt.ToString("dd MMM yyyy · hh:mm tt")</span>
            <p style="margin:4px 0 0;">@comment.Comment</p>
        </div>
    }
</div>
            }
            else
            {
                <div class="alert alert-secondary mt-2">
                    🔒 Los comentarios están deshabilitados para esta publicación por incumplimiento de normas.
                </div>
            }
        </div>
    </div>
</div>

<style>
    body.bg-dark .card, body.bg-dark .card-header, body.bg-dark .card-footer {
        background-color: #1e293b !important;
        border-color: #334155 !important;
        color: #f1f5f9;
    }
    body.bg-dark .text-muted { color: #94a3b8 !important; }
    body.bg-dark .alert-dark { background-color: #2d3748; border-color: #4a5568; color: #e2e8f0; }
</style>