@model List<HabitTrackerApp.Models.Post>

@{
    var myLikes = ViewBag.MyLikes as List<int> ?? new List<int>();
    var commentCounts = ViewBag.CommentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="feed-header">
    <h2 class="feed-title">🔥 Publicaciones</h2>
    <a asp-controller="Post" asp-action="Create" class="new-post-btn">
        <span>+</span> Nueva publicación
    </a>
</div>

<div class="feed-container">
    @foreach (var post in Model)
    {
        <article class="post-card">

            <!-- HEADER -->
            <div class="post-header">
                <div class="post-header-left">
                    @if (post.User != null)
                    {
                        <a asp-controller="User" asp-action="Profile" asp-route-id="@post.UserId" class="avatar-link">
                            @if (!string.IsNullOrEmpty(post.User.ProfileImage))
                            {
                                <img src="@post.User.ProfileImage" class="post-avatar" />
                            }
                            else
                            {
                                <div class="post-avatar-placeholder">@post.DisplayUsername.Substring(0, 1).ToUpper()</div>
                            }
                        </a>
                    }
                    else
                    {
                        <div class="post-avatar-placeholder">👤</div>
                    }

                    <div class="post-meta">
                      <div class="post-username">
    @if (post.UserId == 29)
    {
        <a href="/User" style="text-decoration:none;color:inherit;">@post.DisplayUsername</a>
    }
    else
    {
        <a href="/User/Profile/@post.UserId" style="text-decoration:none;color:inherit;">@post.DisplayUsername</a>
    }
                            @if (post.UserId == 29)
                            {
                                <span class="owner-badge">👑 Propietario</span>
                            }
                        </div>
                        <div class="post-time">@post.CreatedAt.ToString("dd MMM yyyy · hh:mm tt")</div>
                    </div>
                </div>

                @if (post.UserId == int.Parse(User.FindFirst("UserId").Value))
                {
                    <a asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id"
                       class="delete-btn" data-no-loader="true"
                       onclick="return confirm('¿Eliminar esta publicación?')">🗑</a>
                }
            </div>

            <!-- DESCRIPCIÓN -->
            @if (!string.IsNullOrEmpty(post.Description))
            {
                <p class="post-description">@post.Description</p>
            }

            <!-- IMAGEN -->
            @if (!string.IsNullOrEmpty(post.ImagePath))
            {
                <div class="post-image-wrap">
                    <img src="@post.ImagePath" class="post-image" onerror="this.parentElement.style.display='none'" />
                </div>
            }

            <!-- DIVIDER -->
            <div class="post-divider"></div>

            <!-- ACCIONES -->
            <div class="post-actions">
                <button class="action-btn like-btn @(myLikes.Contains(post.Id) ? "liked" : "")"
                        onclick="toggleLike(@post.Id, this)">
                    <span class="action-icon">@(myLikes.Contains(post.Id) ? "❤️" : "🤍")</span>
                    <span class="action-count" id="post-like-count-@post.Id">
                        @(ViewBag.PostLikes != null && ((Dictionary<int,int>)ViewBag.PostLikes).ContainsKey(post.Id) ? ((Dictionary<int,int>)ViewBag.PostLikes)[post.Id] : 0)
                    </span>
                </button>

                <a asp-controller="Post" asp-action="Comments" asp-route-postId="@post.Id" class="action-btn">
                    <span class="action-icon">💬</span>
                    <span class="action-count">@(commentCounts.ContainsKey(post.Id) ? commentCounts[post.Id] : 0)</span>
                </a>

                <button class="action-btn" onclick="openShare(@post.Id)">
                    <span class="action-icon">↪️</span>
                </button>

                <button class="action-btn" onclick="savePost(@post.Id)">
                    <span class="action-icon">🔖</span>
                </button>

                <a asp-controller="Post" asp-action="Report" asp-route-postId="@post.Id" class="action-btn report-btn">
                    <span class="action-icon">🚩</span>
                </a>
            </div>

            <!-- COMENTARIO PREVIEW -->
           

          

        </article>
    }
</div>

<!-- SHARE MENU -->
<div id="shareOverlay" class="share-overlay" onclick="closeShare()"></div>
<div id="shareMenu" class="share-menu">
    <div class="share-title">Compartir publicación</div>
    <div class="share-option" onclick="shareWhatsApp()">📱 WhatsApp</div>
    <div class="share-option" onclick="shareTelegram()">✈️ Telegram</div>
    <div class="share-option" onclick="shareFacebook()">📘 Facebook</div>
    <div class="share-option" onclick="copyLink()">📋 Copiar link</div>
    <div class="share-option cancel" onclick="closeShare()">✕ Cancelar</div>
</div>

<div id="copyAlert" class="copy-alert">↪ Link copiado</div>

<style>
/* ===== FEED ===== */
.feed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.feed-title {
    font-size: 22px;
    font-weight: 700;
    margin: 0;
}

.new-post-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #2563eb;
    color: white;
    padding: 10px 18px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: 0.2s;
    box-shadow: 0 4px 12px rgba(37,99,235,0.3);
}

.new-post-btn:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
    color: white;
}

.feed-container {
    max-width: 620px;
    margin: 0 auto;
}

/* ===== CARD ===== */
.post-card {
    background: white;
    border-radius: 20px;
    padding: 18px;
    margin-bottom: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.05);
    transition: box-shadow 0.2s;
}

.post-card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.1);
}

/* ===== HEADER ===== */
.post-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.post-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
}

.avatar-link { text-decoration: none; }

.post-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e5e7eb;
}

.post-avatar-placeholder {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
}

.post-meta { display: flex; flex-direction: column; }

.post-username {
    font-weight: 700;
    font-size: 15px;
    color: #111827;
    display: flex;
    align-items: center;
    gap: 6px;
}

.post-time {
    font-size: 12px;
    color: #9ca3af;
    margin-top: 2px;
}

.owner-badge {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #111;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 20px;
    font-weight: 700;
}

.delete-btn {
    font-size: 18px;
    color: #ef4444;
    text-decoration: none;
    opacity: 0.7;
    transition: 0.2s;
    padding: 4px 8px;
    border-radius: 8px;
}

.delete-btn:hover {
    opacity: 1;
    background: #fef2f2;
}

/* ===== CONTENIDO ===== */
.post-description {
    font-size: 15px;
    color: #374151;
    line-height: 1.6;
    margin: 0 0 12px;
}

.post-image-wrap {
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 12px;
}

.post-image {
    width: 100%;
    max-height: 500px;
    object-fit: cover;
    display: block;
}

/* ===== DIVIDER ===== */
.post-divider {
    height: 1px;
    background: #f3f4f6;
    margin: 10px 0;
}

/* ===== ACCIONES ===== */
.post-actions {
    display: flex;
    align-items: center;
    gap: 4px;
}

.action-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 12px;
    border-radius: 50px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 14px;
    color: #6b7280;
    text-decoration: none;
    transition: 0.15s;
    font-weight: 500;
}

.action-btn:hover {
    background: #f3f4f6;
    color: #111;
}

.action-btn.liked .action-icon { transform: scale(1.15); }

.action-icon { font-size: 18px; }
.action-count { font-size: 13px; font-weight: 600; }

.report-btn:hover { background: #fef2f2; color: #ef4444; }

/* ===== COMENTARIOS ===== */
.comment-preview {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #f3f4f6;
    font-size: 14px;
    color: #374151;
}

.comment-author {
    font-weight: 700;
    margin-right: 5px;
    color: #111827;
}

.comment-text { color: #4b5563; }

.comment-reply-link {
    margin-left: 8px;
    font-size: 12px;
    color: #9ca3af;
    cursor: pointer;
    font-weight: 600;
}

.comment-reply-link:hover { color: #2563eb; }

.reply-form {
    display: none;
    margin-top: 8px;
    display: none;
    gap: 6px;
    align-items: center;
}

.reply-input {
    flex: 1;
    padding: 7px 12px;
    border-radius: 50px;
    border: 1px solid #e5e7eb;
    font-size: 13px;
    outline: none;
}

.reply-input:focus { border-color: #2563eb; }

.reply-submit {
    padding: 7px 14px;
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    width: auto;
}

.reply-item {
    margin-left: 20px;
    margin-top: 6px;
    font-size: 13px;
    color: #6b7280;
}

.reply-action {
    margin-left: 6px;
    text-decoration: none;
    font-size: 12px;
}

/* ===== SHARE MENU ===== */
.share-overlay {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.4);
    display: none; z-index: 9998;
}

.share-menu {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: white;
    border-radius: 24px 24px 0 0;
    padding: 20px;
    display: none;
    z-index: 9999;
    box-shadow: 0 -10px 40px rgba(0,0,0,0.15);
}

.share-title {
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 14px;
    color: #111;
    text-align: center;
}

.share-option {
    padding: 14px 16px;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 500;
    color: #374151;
    transition: 0.15s;
}

.share-option:hover { background: #f3f4f6; }
.share-option.cancel { color: #ef4444; margin-top: 6px; }

/* ===== COPY ALERT ===== */
.copy-alert {
    position: fixed; bottom: 40px; left: 50%;
    transform: translateX(-50%);
    background: #111; color: white;
    padding: 10px 22px; border-radius: 50px;
    font-size: 14px; opacity: 0;
    transition: 0.3s; pointer-events: none;
    z-index: 99999;
}

.copy-alert.show { opacity: 1; }

/* ===== DARK MODE ===== */
body.bg-dark .post-card {
    background: #1e1e2e !important;
    border-color: #2d2d3d !important;
    box-shadow: 0 2px 12px rgba(0,0,0,0.3) !important;
}

body.bg-dark .post-username,
body.bg-dark .feed-title { color: #f1f5f9 !important; }

body.bg-dark .post-description { color: #cbd5e1 !important; }
body.bg-dark .post-time { color: #64748b !important; }
body.bg-dark .post-divider { background: #2d2d3d !important; }
body.bg-dark .action-btn { color: #94a3b8 !important; }
body.bg-dark .action-btn:hover { background: #2d2d3d !important; color: #f1f5f9 !important; }
body.bg-dark .comment-preview { border-color: #2d2d3d !important; }
body.bg-dark .comment-author { color: #f1f5f9 !important; }
body.bg-dark .comment-text { color: #94a3b8 !important; }
body.bg-dark .reply-input { background: #2d2d3d; border-color: #3d3d4d; color: white; }
body.bg-dark .share-menu { background: #1e1e2e; }
body.bg-dark .share-title { color: #f1f5f9; }
body.bg-dark .share-option { color: #cbd5e1; }
body.bg-dark .share-option:hover { background: #2d2d3d; }
</style>

<script>
function toggleLike(postId, element) {
    fetch('/Post/ToggleLike?postId=' + postId, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            const icon = element.querySelector('.action-icon');
            const count = document.getElementById('post-like-count-' + postId);
            icon.textContent = data.liked ? '❤️' : '🤍';
            if (count) count.textContent = data.count;
            element.classList.toggle('liked', data.liked);
        });
}

function savePost(postId) {
    fetch('/Post/SavePost', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(postId)
    }).then(() => {
        const alert = document.getElementById('copyAlert');
        alert.textContent = '🔖 Publicación guardada';
        alert.classList.add('show');
        setTimeout(() => alert.classList.remove('show'), 2000);
    });
}

function toggleReplyBox(id) {
    const box = document.getElementById('replyBox-' + id);
    box.style.display = box.style.display === 'flex' ? 'none' : 'flex';
}

let currentPost = null;
function openShare(postId) {
    currentPost = postId;
    document.getElementById('shareMenu').style.display = 'block';
    document.getElementById('shareOverlay').style.display = 'block';
}

function closeShare() {
    document.getElementById('shareMenu').style.display = 'none';
    document.getElementById('shareOverlay').style.display = 'none';
}

function shareWhatsApp() {
    window.open('https://wa.me/?text=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
}

function shareTelegram() {
    window.open('https://t.me/share/url?url=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
}

function shareFacebook() {
    window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
}

function copyLink() {
    navigator.clipboard.writeText(window.location.origin + '/Post/Comments?postId=' + currentPost);
    closeShare();
    const alert = document.getElementById('copyAlert');
    alert.textContent = '↪ Link copiado';
    alert.classList.add('show');
    setTimeout(() => alert.classList.remove('show'), 2000);
}
</script>