// ==================== MODAL COMENTARIOS ====================
let currentPostId = null;
let commentConnection = null;
let selectedCommentImage = null;
let commentsCache = [];
let commentsSort = 'recent';
async function openCommentsModal(postId) {
    const modal = document.getElementById('commentsModal');
    if (!modal || modal.style.display === 'flex') return;
    
    currentPostId = postId;
    const body = document.getElementById('commentsModalBody');
    const footer = document.getElementById('commentsModalFooter');
    
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document.body.classList.add('modal-open');
    document.addEventListener('keydown', handleEscapeKey);
    const loader = document.getElementById('ht-loader');
    if (loader) {
        loader.style.display = 'none';
        loader.style.opacity = '0';
    }
    
    body.innerHTML = '<div class="comments-loading">Cargando comentarios...</div>';
    
    try {
        const res = await fetch(`/Post/GetComments?postId=${postId}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        
        const data = await res.json();
        
        if (data.success) {
            renderComments(data.comments || [], data.commentsDisabled || false);
            
            const subtitle = document.getElementById('commentsModalSubtitle');
            if (subtitle) subtitle.textContent = `${data.comments?.length || 0} comentario${(data.comments?.length || 0) === 1 ? '' : 's'}`;

            if (data.commentsDisabled) {
                footer.innerHTML = `<div class="comments-disabled-msg">🔒 Los comentarios están deshabilitados para esta publicación.</div>`;
            } else {
                footer.innerHTML = `
                    <div class="comments-input-wrapper">
                        <textarea id="newCommentText" class="comments-input" placeholder="Añade un comentario..." rows="1"></textarea>
                        <button class="comments-send-btn" id="sendCommentBtn" disabled>➤</button>
                    </div>
                    <div class="comments-attach-wrapper">
                        <label for="commentImageInput" class="comments-attach-btn">📎 Imagen</label>
                        <input type="file" id="commentImageInput" accept="image/*" style="display:none;" />
                    </div>
                    <div id="commentImagePreview" class="comment-image-preview" style="display:none;">
                        <img id="previewCommentImg" />
                        <button onclick="clearCommentImage()">✕</button>
                    </div>
                `;
                attachCommentEvents();
            }
        } else {
            body.innerHTML = `<div class="comments-loading" style="color:#ef4444;">${data.error || 'Error al cargar'}</div>`;
        }
    } catch (e) {
        console.error(e);
        body.innerHTML = `<div class="comments-loading" style="color:#ef4444;">❌ Error de conexión.<br><small>Inténtalo de nuevo</small></div>`;
    }
}
function handleEscapeKey(e) {
    if (e.key === 'Escape') {
        closeCommentsModal();
    }
}
function renderComments(comments, commentsDisabled) {
    const body = document.getElementById('commentsModalBody');
    commentsCache = Array.isArray(comments) ? comments : [];

    if (commentsCache.length === 0) {
        body.innerHTML = '<div class="comments-loading">No hay comentarios aún. Sé el primero.</div>';
        return;
    }

    const sorted = commentsSort === 'top' 
        ? [...commentsCache].sort((a,b) => (b.likeCount||0) - (a.likeCount||0))
        : [...commentsCache];

    let html = '';
    sorted.forEach(c => {
        const avatar = c.profileImage 
            ? `<img src="${c.profileImage}" class="comment-avatar" onclick="goToUserProfile(${c.userId})"/>`
            : `<div class="comment-avatar-letter">${(c.username||'U').charAt(0).toUpperCase()}</div>`;

        const img = c.imagePath ? `<img src="${c.imagePath}" class="comment-img" onclick="window.open('${c.imagePath}','_blank')"/>` : '';
        const isSystem = c.isSystemComment === true;
        const systemNote = isSystem ? `<div class="comment-system-note">Este es un comentario automático del sistema.</div>` : '';
        const actions = isSystem
            ? `<div class="comment-actions"><span class="comment-system-lock">🔒 Sin respuestas ni reacciones</span></div>`
            : `<div class="comment-actions">
                        <button class="comment-like-btn ${c.isLiked?'liked':''}" onclick="toggleCommentLikeModal(this, ${c.id})">
                            ${c.isLiked?'❤️':'🤍'} <span class="like-count">${c.likeCount||0}</span>
                        </button>
                        <button class="comment-reply-btn" data-comment-id="${c.id}" onclick="showReplyForm(this, ${c.id}, 'comment')">Responder</button>
                        ${c.isMine ? `<button class="comment-delete-btn" onclick="deleteCommentModal(${c.id})">Eliminar</button>` : ''}
                    </div>`;

        html += `
            <div class="comment-item ${isSystem ? 'system-comment' : ''}" id="comment-${c.id}" data-comment-id="${c.id}">
                ${avatar}
                <div class="comment-content">
                    <div class="comment-head">
                        <a href="/User/Profile/${c.userId}" class="comment-username">${escapeHtml(c.username)}</a>
                        ${isSystem ? '' : `<span class="comment-time">${c.createdAt}</span>`}
                    </div>
                    <div class="comment-text">${escapeHtml(c.comment)}</div>
                    ${systemNote}
                    ${img}
                    ${actions}
                    <div class="replies-container" id="replies-${c.id}">
                        ${isSystem ? '' : renderRepliesPreview(c.replies || [], c.id)}
                    </div>
                </div>
            </div>`;
    });

    body.innerHTML = html;
}
// Renderiza preview de respuestas (máximo 2)
function renderRepliesPreview(replies, commentId) {
    if (!replies || replies.length === 0) {
        return `<button class="view-replies-btn" onclick="cargarRespuestas(this, ${commentId})">Ver respuestas</button>`;
    }

    let html = '';
    const previewCount = Math.min(2, replies.length);
    
    for (let i = 0; i < previewCount; i++) {
        const r = replies[i];
        html += `
            <div class="reply-item" data-reply-id="${r.id}">
                ${r.profileImage ? `<img src="${r.profileImage}" class="reply-avatar" onclick="goToUserProfile(${r.userId})" />` : `<div class="reply-avatar-letter">${r.username.charAt(0).toUpperCase()}</div>`}
                <div class="reply-content">
                    <div class="reply-header">
                        <a href="/User/Profile/${r.userId}" class="reply-username-link">${escapeHtml(r.username)}</a>
                        <span class="reply-time">${r.createdAt}</span>
                    </div>
                    <div class="reply-text">${escapeHtml(r.text)}</div>
                    <div class="reply-actions">
                        <button class="reply-like-btn ${r.isLiked ? 'liked' : ''}" onclick="toggleReplyLikeModal(this, ${r.id})">
                            ${r.isLiked ? '❤️' : '🤍'} <span class="like-count">${r.likeCount || 0}</span>
                        </button>
                    </div>
                </div>
            </div>
        `;
    }

    if (replies.length > 2) {
        html += `
            <button class="view-replies-btn" onclick="cargarRespuestas(this, ${commentId})">
                Ver ${replies.length - 2} respuestas más
            </button>
        `;
    } else if (replies.length > 0) {
        html += `
            <button class="view-replies-btn" onclick="cargarRespuestas(this, ${commentId})">
                Ver todas las respuestas
            </button>
        `;
    }

    return html;
}
function setCommentsSort(sort) {
    commentsSort = sort;
    document.querySelectorAll('.cm-tab').forEach(btn => btn.classList.toggle('active', btn.dataset.sort === sort));
    renderComments(commentsCache, false);
}

function goToUserProfile(userId) {
    if (!userId) return;
    window.location.href = `/User/Profile/${userId}`;
}
function attachCommentEvents() {
    const textarea = document.getElementById('newCommentText');
    const sendBtn = document.getElementById('sendCommentBtn');
    if (!textarea) return;
    const updateButton = () => {
        sendBtn.disabled = textarea.value.trim() === '' && !selectedCommentImage;
    };
    textarea.addEventListener('input', () => {
        updateButton();
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 104) + 'px';
        if (commentConnection && commentConnection.state === 'Connected' && currentPostId) {
            commentConnection.invoke("UserTypingOnPost", currentPostId);
        }
    });
    updateButton();
    textarea.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (!sendBtn.disabled) sendComment();
        }
    });
    const fileInput = document.getElementById('commentImageInput');
    if (fileInput) {
        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                selectedCommentImage = file;
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const preview = document.getElementById('commentImagePreview');
                    const img = document.getElementById('previewCommentImg');
                    img.src = ev.target.result;
                    preview.style.display = 'flex';
                };
                reader.readAsDataURL(file);
                updateButton();
            }
        });
    }
    sendBtn.onclick = sendComment;
}
// ========== FUNCIONES PARA RESPUESTAS ==========
let activeReplyForm = null;

async function cargarRespuestas(btn, commentId) {
    btn.disabled = true;
    btn.textContent = 'Cargando...';
    try {
        const res = await fetch(`/Post/GetReplies?commentId=${commentId}`);
        if (!res.ok) throw new Error('Error');
        const replies = await res.json();
        const container = document.getElementById(`replies-${commentId}`);
        if (replies && replies.length) {
            let repliesHtml = '';
            replies.forEach(r => {
                repliesHtml += `
                    <div class="reply-item" data-reply-id="${r.id}">
                        ${r.profileImage ? `<img src="${r.profileImage}" class="reply-avatar" onclick="goToUserProfile(${r.userId})" />` : `<div class="reply-avatar-letter" onclick="goToUserProfile(${r.userId})">${r.username.charAt(0).toUpperCase()}</div>`}
                        <div class="reply-content">
                            <div class="reply-header">
                                <a href="/User/Profile/${r.userId}" class="reply-username-link">${escapeHtml(r.username)}</a>
                                <span class="reply-time">${r.createdAt}</span>
                            </div>
                            <div class="reply-text">${escapeHtml(r.text)}</div>
                            <div class="reply-actions">
                                <button class="reply-like-btn ${r.isLiked ? 'liked' : ''}" data-reply-id="${r.id}" onclick="toggleReplyLikeModal(this, ${r.id})">
                                    ${r.isLiked ? '❤️' : '🤍'} <span class="like-count">${r.likeCount}</span>
                                </button>
                                <button class="reply-reply-btn" data-reply-id="${r.id}" data-username="${escapeHtml(r.username)}" onclick="showReplyForm(this, ${r.id}, 'reply')">Responder</button>
                                ${r.isMine ? `<button class="reply-delete-btn" onclick="deleteReplyModal(${r.id})">Eliminar</button>` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = repliesHtml;
        } else {
            btn.textContent = 'Sin respuestas';
            btn.disabled = true;
        }
    } catch(e) {
        btn.textContent = 'Error';
        console.error(e);
    }
}

function showReplyForm(element, parentId, type) {
    if (activeReplyForm) {
        activeReplyForm.style.display = 'none';
        activeReplyForm.remove();
    }
    let container;
    if (type === 'comment') {
        container = document.getElementById(`replies-${parentId}`);
    } else {
        const replyItem = document.querySelector(`.reply-item[data-reply-id="${parentId}"]`);
        container = replyItem ? replyItem.querySelector('.reply-content') : null;
    }
    if (!container) return;
    const formDiv = document.createElement('div');
    formDiv.className = 'reply-form-container';
    formDiv.style.display = 'block';
    formDiv.innerHTML = `
        <div class="reply-form">
            <input type="text" class="reply-input" placeholder="Escribe una respuesta..." />
            <button class="reply-send-btn">Enviar</button>
            <button class="reply-cancel-btn">Cancelar</button>
        </div>
    `;
    const input = formDiv.querySelector('.reply-input');
    const sendBtn = formDiv.querySelector('.reply-send-btn');
    const cancelBtn = formDiv.querySelector('.reply-cancel-btn');
    
    sendBtn.onclick = async () => {
        const text = input.value.trim();
        if (!text) return;
        sendBtn.disabled = true;
        sendBtn.textContent = '...';
        try {
            const formData = new FormData();
            const topCommentId = type === 'comment'
                ? parentId
                : document.querySelector(`.reply-item[data-reply-id="${parentId}"]`)?.closest('.comment-item')?.getAttribute('data-comment-id');
            if (!topCommentId) throw new Error('No se encontró el comentario padre');
            formData.append('commentId', topCommentId);
            formData.append('text', text);
            if (type === 'reply') formData.append('parentReplyId', parentId);
            const res = await fetch('/Post/ReplyComment', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
                const reloadRes = await fetch(`/Post/GetReplies?commentId=${topCommentId}`);
                const replies = await reloadRes.json();
                const containerReplies = document.getElementById(`replies-${topCommentId}`);
                let repliesHtml = '';
                replies.forEach(r => {
                    repliesHtml += `
                        <div class="reply-item" data-reply-id="${r.id}">
                            ${r.profileImage ? `<img src="${r.profileImage}" class="reply-avatar" onclick="goToUserProfile(${r.userId})" />` : `<div class="reply-avatar-letter" onclick="goToUserProfile(${r.userId})">${r.username.charAt(0).toUpperCase()}</div>`}
                            <div class="reply-content">
                                <div class="reply-header"><a href="/User/Profile/${r.userId}" class="reply-username-link">${escapeHtml(r.username)}</a><span class="reply-time">${r.createdAt}</span></div>
                                <div class="reply-text">${escapeHtml(r.text)}</div>
                                <div class="reply-actions">
                                    <button class="reply-like-btn ${r.isLiked ? 'liked' : ''}" data-reply-id="${r.id}" onclick="toggleReplyLikeModal(this, ${r.id})">${r.isLiked ? '❤️' : '🤍'} <span class="like-count">${r.likeCount}</span></button>
                                    <button class="reply-reply-btn" data-reply-id="${r.id}" data-username="${escapeHtml(r.username)}" onclick="showReplyForm(this, ${r.id}, 'reply')">Responder</button>
                                    ${r.isMine ? `<button class="reply-delete-btn" onclick="deleteReplyModal(${r.id})">Eliminar</button>` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                });
                containerReplies.innerHTML = repliesHtml;
                formDiv.remove();
                activeReplyForm = null;
            } else {
                alert(data.error || 'Error');
                sendBtn.disabled = false;
                sendBtn.textContent = 'Enviar';
            }
        } catch(e) {
            alert('Error de conexión');
            sendBtn.disabled = false;
            sendBtn.textContent = 'Enviar';
        }
    };
    cancelBtn.onclick = () => {
        formDiv.remove();
        activeReplyForm = null;
    };
    container.appendChild(formDiv);
    activeReplyForm = formDiv;
    input.focus();
}

async function toggleReplyLikeModal(btn, replyId) {
    const isLiked = btn.classList.contains('liked');
    const countSpan = btn.querySelector('.like-count');
    let currentCount = parseInt(countSpan.innerText) || 0;
    btn.classList.toggle('liked');
    const newCount = isLiked ? currentCount - 1 : currentCount + 1;
    countSpan.innerText = newCount;
    btn.innerHTML = (isLiked ? '🤍' : '❤️') + ` <span class="like-count">${newCount}</span>`;
    try {
        const res = await fetch(`/Post/ToggleReplyLike?id=${replyId}`, { method: 'POST' });
        const data = await res.json();
        if (data.liked !== undefined) {
            countSpan.innerText = data.count;
            btn.innerHTML = (data.liked ? '❤️' : '🤍') + ` <span class="like-count">${data.count}</span>`;
            if (data.liked !== !isLiked) btn.classList.toggle('liked', data.liked);
        }
    } catch(e) { console.error(e); }
}

async function deleteReplyModal(replyId) {
    showConfirm({
        icon:'🗑️',
        title:'Eliminar respuesta',
        message:'Esta respuesta desaparecerá de la conversación.',
        confirmText:'Eliminar',
        onConfirm: async () => {
            try {
                const res = await fetch(`/Post/DeleteReply/${replyId}`, { method: 'GET' });
                if (res.ok) {
                    const replyEl = document.querySelector(`.reply-item[data-reply-id="${replyId}"]`);
                    if (replyEl) replyEl.remove();
                } else alert('Error al eliminar');
            } catch(e) { alert('Error de conexión'); }
        }
    });
}
function clearCommentImage() {
    selectedCommentImage = null;
    document.getElementById('commentImagePreview').style.display = 'none';
    document.getElementById('commentImageInput').value = '';
    const textarea = document.getElementById('newCommentText');
    if (textarea) {
        const sendBtn = document.getElementById('sendCommentBtn');
        sendBtn.disabled = textarea.value.trim() === '';
    }
}

async function sendComment() {
    const textarea = document.getElementById('newCommentText');
    const content = textarea.value.trim();
    if (!content && !selectedCommentImage) return;
    const formData = new FormData();
    formData.append('postId', currentPostId);
    formData.append('comment', content);
    if (selectedCommentImage) {
        formData.append('image', selectedCommentImage);
    }
    const sendBtn = document.getElementById('sendCommentBtn');
    sendBtn.disabled = true;
    sendBtn.innerHTML = '⏳';
    try {
        const res = await fetch('/Post/AddCommentAjax', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
            textarea.value = '';
            selectedCommentImage = null;
            document.getElementById('commentImagePreview').style.display = 'none';
            document.getElementById('commentImageInput').value = '';
            addCommentToList(data.comment);
            const subtitle = document.getElementById('commentsModalSubtitle');
            if (subtitle) {
                const current = document.querySelectorAll('#commentsModalBody .comment-item').length;
                subtitle.textContent = `${current} comentario${current === 1 ? '' : 's'} en esta publicación`;
            }
            sendBtn.disabled = false;
            sendBtn.innerHTML = '➤';
            textarea.focus();
        } else {
            alert(data.error || 'Error al comentar');
            sendBtn.disabled = false;
            sendBtn.innerHTML = '➤';
        }
    } catch(e) {
        console.error(e);
        alert('Error de conexión');
        sendBtn.disabled = false;
        sendBtn.innerHTML = '➤';
    }
}

function addCommentToList(comment) {
    const body = document.getElementById('commentsModalBody');
    const emptyMsg = body.querySelector('.comments-loading');
    if (emptyMsg && emptyMsg.innerText.includes('No hay comentarios')) emptyMsg.remove();
    const newCommentHtml = `
        <div class="comment-item" id="comment-${comment.id}">
            ${comment.profileImage ? `<img src="${comment.profileImage}" class="comment-avatar" onclick="goToUserProfile(${comment.userId})" />` : `<div class="comment-avatar-letter" onclick="goToUserProfile(${comment.userId})">${comment.username.charAt(0).toUpperCase()}</div>`}
            <div class="comment-content">
                <div class="comment-head">
                    <a href="/User/Profile/${comment.userId}" class="comment-username">${escapeHtml(comment.username)}</a>
                    <span class="comment-time">${comment.createdAt}</span>
                </div>
                <div class="comment-text">${escapeHtml(comment.comment)}</div>
                ${comment.imagePath ? `<img src="${comment.imagePath}" class="comment-img" onclick="window.open('${comment.imagePath}', '_blank')" />` : ''}
                <div class="comment-actions">
                    <button class="comment-like-btn" data-comment-id="${comment.id}" onclick="toggleCommentLikeModal(this, ${comment.id})">🤍 <span class="like-count">0</span></button>
                    <button class="comment-reply-btn" data-comment-id="${comment.id}" data-username="${escapeHtml(comment.username)}" onclick="showReplyForm(this, ${comment.id}, 'comment')">Responder</button>
                    ${comment.isMine ? `<button class="comment-delete-btn" onclick="deleteCommentModal(${comment.id})">Eliminar</button>` : ''}
                </div>
                <div class="replies-container" id="replies-${comment.id}">
                    <button class="view-replies-btn" onclick="cargarRespuestas(this, ${comment.id})">Ver respuestas</button>
                </div>
            </div>
        </div>
    `;
    body.insertAdjacentHTML('afterbegin', newCommentHtml);
}

function closeCommentsModal() {
    const modal = document.getElementById('commentsModal');
    if (!modal) return;

    modal.style.display = 'none';

    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('position');
    document.body.style.removeProperty('padding-right');
    document.body.style.removeProperty('top');
    document.documentElement.style.removeProperty('overflow');

    // Quitar clases residuales
    document.body.classList.remove('modal-open', 'overflow-hidden', 'no-scroll');
    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
    const loader = document.getElementById('ht-loader');
    if (loader) {
        loader.style.display = 'none';
        loader.style.opacity = '0';
    }

    // Limpiar SignalR
    if (commentConnection && currentPostId) {
        commentConnection.invoke("LeavePostGroup", currentPostId).catch(() => {});
    }

    // Limpiar formulario de respuesta activo
    if (activeReplyForm) {
        activeReplyForm.remove();
        activeReplyForm = null;
    }

    // Resetear variables globales
    currentPostId = null;
    selectedCommentImage = null;
    commentsCache = [];

    // Remover listener de Escape (evita duplicados)
    document.removeEventListener('keydown', handleEscapeKey);

    console.log("✅ Modal cerrado completamente");
}
async function toggleCommentLikeModal(btn, commentId) {
    const isLiked = btn.classList.contains('liked');
    const iconSpan = btn.querySelector('.like-count');
    const currentCount = parseInt(iconSpan.innerText) || 0;
    const newCount = isLiked ? currentCount - 1 : currentCount + 1;
    btn.classList.toggle('liked');
    iconSpan.innerText = newCount;
    btn.innerHTML = (isLiked ? '🤍' : '❤️') + ` <span class="like-count">${newCount}</span>`;
    try {
        const res = await fetch('/Post/ToggleCommentLike?commentId=' + commentId, { method: 'POST' });
        const data = await res.json();
        if (data.liked !== undefined) {
            iconSpan.innerText = data.count;
            btn.innerHTML = (data.liked ? '❤️' : '🤍') + ` <span class="like-count">${data.count}</span>`;
            if (data.liked !== !isLiked) btn.classList.toggle('liked', data.liked);
        }
    } catch(e) { console.error(e); }
}

async function deleteCommentModal(commentId) {
    showConfirm({
        icon:'🗑️',
        title:'Eliminar comentario',
        message:'Se quitará este comentario de la publicación.',
        confirmText:'Eliminar',
        onConfirm: async () => {
            try {
                const res = await fetch(`/Post/DeleteComment/${commentId}`, { method: 'GET' });
                if (res.ok) {
                    const commentEl = document.getElementById(`comment-${commentId}`);
                    if (commentEl) commentEl.remove();
                } else alert('Error al eliminar');
            } catch(e) { alert('Error de conexión'); }
        }
    });
}

function escapeHtml(text) {
    if (!text) return '';
    return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// Reemplazar enlaces de comentarios
document.querySelectorAll('.post-actions a.action-btn[href*="/Post/Comments"]').forEach(link => {
    const href = link.getAttribute('href');
    const match = href.match(/postId=(\d+)/);
    if (match) {
        const postId = match[1];
        link.setAttribute('href', 'javascript:void(0)');
        link.setAttribute('data-no-loader', 'true');
        link.setAttribute('onclick', `openCommentsModal(${postId})`);
    }
});

function setupCommentSignalR() {
    if (!window.connectionGlobal) return;
    commentConnection = window.connectionGlobal;
    window.connectionGlobal.on("NewComment", (comment) => {
        if (currentPostId && comment && comment.postId == currentPostId) {
            addCommentToList(comment);
        }
    });
    window.connectionGlobal.on("UserTypingOnPost", (data) => {
        if (currentPostId && data.postId == currentPostId) {
            const indicator = document.getElementById('commentTypingIndicator');
            indicator.style.display = 'block';
            clearTimeout(window.typingTimeout);
            window.typingTimeout = setTimeout(() => indicator.style.display = 'none', 1500);
        }
    });
}

if (window.connectionGlobal) {
    setupCommentSignalR();
} else {
    document.addEventListener('connectionGlobalReady', setupCommentSignalR);
}
</script>
