<script>
function revealSensitive(postId) {
    const img = document.getElementById('img-' + postId);
    const overlay = document.getElementById('overlay-' + postId);
    if (img) img.classList.remove('sensitive-blurred');
    if (overlay) { overlay.style.opacity = '0'; overlay.style.pointerEvents = 'none'; }
}

// ❤️ Double-tap to like (Instagram style)
const dblTapState = new Map();
function dblTapLike(postId, e) {
    const heart = document.getElementById('dbltap-heart-' + postId);
    if (heart) {
        heart.classList.remove('animate');
        void heart.offsetWidth;
        heart.classList.add('animate');
    }
    const btn = document.getElementById('like-btn-' + postId);
    if (btn && !btn.classList.contains('liked')) {
        toggleLike(postId, btn);
    }
    if (navigator.vibrate) try { navigator.vibrate(15); } catch(_){}
}
document.addEventListener('touchend', function(e){
    const wrap = e.target.closest('.post-media-wrap[data-post-id]');
    if (!wrap) return;
    const postId = wrap.getAttribute('data-post-id');
    const now = Date.now();
    const last = dblTapState.get(postId) || 0;
    if (now - last < 320) {
        dblTapLike(parseInt(postId, 10), e);
        dblTapState.set(postId, 0);
        e.preventDefault();
    } else {
        dblTapState.set(postId, now);
    }
}, {passive: false});

function toggleLike(postId, element) {
    const icon = document.getElementById('like-icon-' + postId);
    const isLiked = element.classList.contains('liked');
    icon.classList.remove('like-pop');
    void icon.offsetWidth;
    icon.classList.add('like-pop');
    if (!isLiked) {
        const explosion = document.getElementById('likeExplosion');
        const rect = icon.getBoundingClientRect();
        explosion.style.left = (rect.left + rect.width / 2) + 'px';
        explosion.style.top = (rect.top + rect.height / 2) + 'px';
        explosion.style.display = 'block';
        explosion.classList.remove('animate');
        void explosion.offsetWidth;
        explosion.classList.add('animate');
        setTimeout(() => { explosion.style.display = 'none'; explosion.classList.remove('animate'); }, 700);
    }
    fetch('/Post/ToggleLike?postId=' + postId, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            icon.textContent = data.liked ? '❤️' : '🤍';
            element.classList.toggle('liked', data.liked);
            const summary = document.getElementById('like-summary-' + postId);
            if (summary) {
                summary.innerHTML = data.count > 0
                    ? `<span>❤️ ${data.count} ${data.count === 1 ? 'like' : 'likes'}</span>`
                    : '';
            }
        });
}
function revealBlurred(postId) {
    const img = document.getElementById('img-' + postId);
    const overlay = document.getElementById('overlay-' + postId);
    if (img) {
        img.classList.remove('blurred-image');
        img.style.filter = 'none';
        img.style.transform = 'none';
    }
    if (overlay) overlay.style.display = 'none';
}
function savePost(postId, btn) {
    fetch('/Post/SavePost', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(postId)
    }).then(() => {
        const icon = btn.querySelector('.action-icon');
        icon.textContent = '🔖';
        icon.style.filter = 'drop-shadow(0 0 4px rgba(99,102,241,0.6))';
        showAlert('🔖 Publicación guardada');
        setTimeout(() => icon.style.filter = '', 1000);
    });
}
let currentPost = null;
function openShare(postId) {
    currentPost = postId;
    document.getElementById('shareMenu').style.display = 'block';
    document.getElementById('shareOverlay').style.display = 'block';
}
function closeShare() {
    document.getElementById('shareMenu').style.display = 'none';
    document.getElementById('shareOverlay').style.display = 'none';
}
function shareWhatsApp() {
    window.open('https://wa.me/?text=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}
function shareTelegram() {
    window.open('https://t.me/share/url?url=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}
function shareFacebook() {
    window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}
function copyLink() {
    navigator.clipboard.writeText(window.location.origin + '/Post/Comments?postId=' + currentPost);
    closeShare();
    showAlert('↪ Link copiado');
}
function showAlert(msg) {
    const el = document.getElementById('copyAlert');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 2500);
}
async function repostear() {
    if (!currentPost) return;
    closeShare();
    try {
        const res = await fetch('/Post/Repost', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(currentPost)
        });
        const data = await res.json();
        if (data.success) {
            showAlert(data.reposted ? '↪️ Reposteado en tu perfil' : '↩️ Repost eliminado');
        } else {
            showAlert('⚠️ ' + (data.error ?? 'Error'));
        }
    } catch {
        showAlert('❌ Error de conexión');
    }
}

// ══ ANUNCIO PRIMERA VEZ ══
(function() {
    if (localStorage.getItem('ht_posts_welcome_seen')) return;
    const overlay = document.createElement('div');
    overlay.id = 'welcomePostsOverlay';
    overlay.style.cssText = `
        position:fixed;inset:0;z-index:999999;
        background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);
        display:flex;align-items:center;justify-content:center;padding:20px;
    `;
