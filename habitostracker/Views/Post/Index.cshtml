@model List<HabitTrackerApp.Models.Post>

@{
    var myLikes = ViewBag.MyLikes as List<int> ?? new List<int>();
    var commentCounts = ViewBag.CommentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="feed-header">
    <!-- ══ HISTORIAS ══ -->
<div class="stories-bar" id="storiesBar">
    <!-- Mi historia -->
    <div class="story-item" onclick="window.location.href='/Story/Create'">
        <div class="story-avatar-wrap my-story">
            @{
                var myPic = User.FindFirst("ProfileImage")?.Value;
                var myUsername = User.Identity?.Name ?? "Yo";
            }
            @if (!string.IsNullOrEmpty(myPic))
            { <img src="@myPic" class="story-avatar-img"/> }
            else
            { <div class="story-avatar-letter">@myUsername.Substring(0,1).ToUpper()</div> }
            <div class="story-add-btn">+</div>
        </div>
        <div class="story-name">Tu historia</div>
    </div>

    <!-- Historias de amigos -->
    <div id="friendStories"></div>
</div>

<!-- VISOR DE HISTORIAS -->
<div id="storyViewer" class="story-viewer" style="display:none;">
    <div class="story-viewer-bg" onclick="closeStoryViewer()"></div>
    <div class="story-viewer-card">
        <!-- PROGRESS BARS -->
        <div class="story-progress-bars" id="storyProgressBars"></div>

        <!-- HEADER -->
        <div class="story-viewer-header">
            <div style="display:flex;align-items:center;gap:10px;">
                <img id="svAvatar" style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid white;"/>
                <div>
                    <div id="svUsername" style="font-size:13px;font-weight:700;color:white;"></div>
                    <div id="svTime" style="font-size:11px;color:rgba(255,255,255,0.6);"></div>
                </div>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
                <button id="svHighlight" onclick="toggleHighlight()" style="background:none;border:none;color:white;font-size:20px;cursor:pointer;" title="Destacar">☆</button>
                <button id="svDelete" onclick="deleteCurrentStory()" style="background:none;border:none;color:white;font-size:18px;cursor:pointer;display:none;">🗑</button>
                <button onclick="closeStoryViewer()" style="background:none;border:none;color:white;font-size:22px;cursor:pointer;">✕</button>
            </div>
        </div>

        <!-- CONTENIDO -->
        <div class="story-viewer-content" id="svContent">
            <img id="svImg" style="display:none;width:100%;height:100%;object-fit:cover;"/>
            <video id="svVideo" style="display:none;width:100%;height:100%;object-fit:cover;" playsinline muted></video>
            <div id="svText" style="display:none;width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:32px;text-align:center;font-size:22px;font-weight:800;color:white;line-height:1.4;word-break:break-word;"></div>
        </div>

        <!-- NAVEGACIÓN -->
        <div class="story-nav-left" onclick="prevStory()"></div>
        <div class="story-nav-right" onclick="nextStory()"></div>

        <!-- VIEWS -->
        <div class="story-views-bar">
            <span id="svViews">👁 0 vistas</span>
        </div>
    </div>
</div>
    <div>
        <h2 class="feed-title">🔥 Publicaciones</h2>
        <p class="feed-subtitle">Comparte momentos con la comunidad</p>
    </div>
    <a asp-controller="Post" asp-action="Create" class="new-post-btn">
        ✏️ Publicar
    </a>
</div>

@if (!Model.Any())
{
    <div class="feed-empty">
        <div class="feed-empty-icon">📭</div>
        <h5>Sin publicaciones aún</h5>
        <p>¡Sé el primero en compartir algo!</p>
        <a asp-controller="Post" asp-action="Create" class="new-post-btn" style="display:inline-flex;margin-top:16px;">
            ✏️ Crear publicación
        </a>
    </div>
}

<div class="feed-container">
    @foreach (var post in Model)
    {
        var isVideo = !string.IsNullOrEmpty(post.ImagePath) &&
                      (post.ImagePath.Contains("/video/upload/") ||
                       post.ImagePath.EndsWith(".mp4") ||
                       post.ImagePath.EndsWith(".mov") ||
                       post.ImagePath.EndsWith(".webm"));

        var currentUserId = int.Parse(User.FindFirst("UserId").Value);
        var likeCount = ViewBag.PostLikes != null && ((Dictionary<int,int>)ViewBag.PostLikes).ContainsKey(post.Id)
            ? ((Dictionary<int,int>)ViewBag.PostLikes)[post.Id] : 0;
        var isLiked = myLikes.Contains(post.Id);

        <article class="post-card" id="post-@post.Id">

            <!-- HEADER -->
            <div class="post-header">
                <div class="post-header-left">
                    @if (post.User != null)
                    {
                        <a asp-controller="User" asp-action="Profile" asp-route-id="@post.UserId" class="avatar-link">
                            @{
                                var postPic = !string.IsNullOrEmpty(post.User?.ProfileImage)
                                    ? post.User.ProfileImage
                                    : post.User?.ProfilePicture;
                            }
                            @if (!string.IsNullOrEmpty(postPic))
                            {
                                <img src="@postPic" class="post-avatar" />
                            }
                            else
                            {
                                <div class="post-avatar-placeholder">@post.DisplayUsername.Substring(0, 1).ToUpper()</div>
                            }
                        </a>
                    }
                    else
                    {
                        <div class="post-avatar-placeholder">👤</div>
                    }

                    <div class="post-meta">
                        <div class="post-username">
                            @if (post.UserId == 29)
                            {
                                <a href="/User" style="text-decoration:none;color:inherit;">@post.DisplayUsername</a>
                                <span class="owner-badge">👑 Propietario</span>
                            }
                            else
                            {
                                <a href="/User/Profile/@post.UserId" style="text-decoration:none;color:inherit;">@post.DisplayUsername</a>
                            }
                        </div>
                        <div class="post-time">@post.CreatedAt.ToString("dd MMM yyyy · hh:mm tt")</div>
                    </div>
                </div>

                <div class="post-header-right">
                    @if (post.IsSensitive)
                    {
                        <span class="sensitive-badge">⚠️ Sensible</span>
                    }
                    @if (post.UserId == currentUserId)
                    {
                        <a asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id"
                           class="delete-btn" data-no-loader="true"
                           onclick="return confirm('¿Eliminar esta publicación?')">🗑</a>
                    }
                </div>
            </div>

            <!-- DESCRIPCIÓN -->
            @if (!string.IsNullOrEmpty(post.Description))
            {
                <p class="post-description">@post.Description</p>
            }

            <!-- MEDIA -->
            @if (!string.IsNullOrEmpty(post.ImagePath))
            {
                <div class="post-media-wrap @(isVideo ? "video-wrap" : "")">
                    @if (isVideo)
                    {
                        <video controls class="post-media" preload="metadata">
                            <source src="@post.ImagePath" />
                        </video>
                        <div class="video-badge">▶ Video</div>
                    }
                    else
                    {
                        <img src="@post.ImagePath" class="post-media"
                             onerror="this.parentElement.style.display='none'"
                             loading="lazy" />
                    }
                </div>
            }

            <!-- STATS -->
            <div class="post-stats">
                <span id="like-summary-@post.Id" class="like-summary">
                    @if (likeCount > 0)
                    {
                        <span>❤️ @likeCount @(likeCount == 1 ? "like" : "likes")</span>
                    }
                </span>
                <span class="comment-summary">
                    @{
                        var cc = commentCounts.ContainsKey(post.Id) ? commentCounts[post.Id] : 0;
                    }
                    @if (cc > 0)
                    {
                        <span>@cc @(cc == 1 ? "comentario" : "comentarios")</span>
                    }
                </span>
            </div>

            <!-- DIVIDER -->
            <div class="post-divider"></div>

            <!-- ACCIONES -->
            <div class="post-actions">
                <button class="action-btn like-btn @(isLiked ? "liked" : "")"
                        id="like-btn-@post.Id"
                        data-no-loader="true"
                        onclick="toggleLike(@post.Id, this)">
                    <span class="action-icon like-icon" id="like-icon-@post.Id">@(isLiked ? "❤️" : "🤍")</span>
                    <span class="action-label">Me gusta</span>
                </button>

                <a asp-controller="Post" asp-action="Comments" asp-route-postId="@post.Id" class="action-btn">
                    <span class="action-icon">💬</span>
                    <span class="action-label">Comentar</span>
                </a>

                <button class="action-btn" data-no-loader="true" onclick="openShare(@post.Id)">
                    <span class="action-icon">↪️</span>
                    <span class="action-label">Compartir</span>
                </button>

                <button class="action-btn save-btn" data-no-loader="true" onclick="savePost(@post.Id, this)">
                    <span class="action-icon">🔖</span>
                    <span class="action-label">Guardar</span>
                </button>

                <a asp-controller="Post" asp-action="Report" asp-route-postId="@post.Id" class="action-btn report-btn">
                    <span class="action-icon">🚩</span>
                    <span class="action-label">Reportar</span>
                </a>
            </div>

        </article>
    }
</div>

<!-- SHARE MENU -->
<div id="shareOverlay" class="share-overlay" onclick="closeShare()"></div>
<div id="shareMenu" class="share-menu">
    <div class="share-handle"></div>
    <div class="share-title">Compartir publicación</div>
    <div class="share-options">
        <div class="share-option" onclick="shareWhatsApp()">
            <span class="share-option-icon">📱</span>
            <span>WhatsApp</span>
        </div>
        <div class="share-option" onclick="shareTelegram()">
            <span class="share-option-icon">✈️</span>
            <span>Telegram</span>
        </div>
        <div class="share-option" onclick="shareFacebook()">
            <span class="share-option-icon">📘</span>
            <span>Facebook</span>
        </div>
        <div class="share-option" onclick="copyLink()">
            <span class="share-option-icon">📋</span>
            <span>Copiar link</span>
        </div>
    </div>
    <div class="share-option cancel" onclick="closeShare()">✕ Cancelar</div>
</div>

<!-- LIKE EXPLOSION -->
<div id="likeExplosion" class="like-explosion" style="display:none;">❤️</div>

<div id="copyAlert" class="copy-alert">↪ Link copiado</div>

<style>
.feed-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
}

/* ══ STORIES BAR ══ */
.stories-bar{
    display:flex;gap:14px;overflow-x:auto;padding:4px 2px 16px;
    scrollbar-width:none;-webkit-overflow-scrolling:touch;margin-bottom:8px;
}
.stories-bar::-webkit-scrollbar{display:none;}
.story-item{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;flex-shrink:0;}
.story-avatar-wrap{
    width:64px;height:64px;border-radius:50%;position:relative;
    padding:3px;background:linear-gradient(135deg,#f97316,#ec4899,#6366f1);
}
.story-avatar-wrap.my-story{background:linear-gradient(135deg,#6366f1,#4f46e5);}
.story-avatar-wrap.viewed{background:#e5e7eb;}
.story-avatar-img{width:100%;height:100%;border-radius:50%;object-fit:cover;border:2px solid white;}
.story-avatar-letter{
    width:100%;height:100%;border-radius:50%;
    background:linear-gradient(135deg,#2563eb,#7c3aed);
    color:white;display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:22px;border:2px solid white;
}
.story-add-btn{
    position:absolute;bottom:0;right:0;
    width:20px;height:20px;border-radius:50%;
    background:#6366f1;color:white;font-size:14px;font-weight:800;
    display:flex;align-items:center;justify-content:center;
    border:2px solid white;line-height:1;
}
.story-name{font-size:11px;font-weight:600;color:#374151;max-width:64px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

/* ══ STORY VIEWER ══ */
.story-viewer{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;}
.story-viewer-bg{position:absolute;inset:0;background:rgba(0,0,0,0.92);}
.story-viewer-card{
    position:relative;width:100%;max-width:400px;height:100vh;max-height:720px;
    border-radius:20px;overflow:hidden;background:#000;z-index:1;
}
.story-progress-bars{
    position:absolute;top:12px;left:12px;right:12px;
    display:flex;gap:4px;z-index:10;
}
.story-progress-bar{
    flex:1;height:3px;background:rgba(255,255,255,0.3);border-radius:10px;overflow:hidden;
}
.story-progress-fill{height:100%;background:white;width:0%;transition:none;}
.story-viewer-header{
    position:absolute;top:28px;left:12px;right:12px;
    display:flex;align-items:center;justify-content:space-between;z-index:10;
}
.story-viewer-content{width:100%;height:100%;position:relative;}
.story-nav-left{position:absolute;left:0;top:0;width:40%;height:100%;z-index:5;cursor:pointer;}
.story-nav-right{position:absolute;right:0;top:0;width:40%;height:100%;z-index:5;cursor:pointer;}
.story-views-bar{
    position:absolute;bottom:16px;left:16px;right:16px;
    display:flex;align-items:center;justify-content:center;z-index:10;
}
.story-views-bar span{font-size:12px;color:rgba(255,255,255,0.7);font-weight:600;}

body.bg-dark .story-name{color:#94a3b8!important;}
body.bg-dark .story-avatar-wrap.viewed{background:#334155!important;}

@@media(max-width:768px){
    .story-viewer-card{border-radius:0;max-height:100vh;}
}

.feed-title { font-size: 22px; font-weight: 800; margin: 0 0 2px; color: #111827; }
.feed-subtitle { font-size: 13px; color: #9ca3af; margin: 0; }

.new-post-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    color: white; padding: 10px 20px; border-radius: 50px;
    font-size: 14px; font-weight: 600; text-decoration: none;
    transition: 0.2s; box-shadow: 0 4px 14px rgba(37,99,235,0.3);
    white-space: nowrap;
}

.new-post-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(37,99,235,0.4); color: white; }

.feed-empty {
    text-align: center; padding: 60px 20px; background: white;
    border-radius: 22px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04); max-width: 620px; margin: 0 auto 24px;
}

.feed-empty-icon { font-size: 52px; margin-bottom: 16px; }
.feed-empty h5 { font-size: 18px; font-weight: 700; color: #111827; margin-bottom: 8px; }
.feed-empty p { font-size: 14px; color: #9ca3af; margin: 0; }

.feed-container { max-width: 620px; margin: 0 auto; }

.post-card {
    background: white; border-radius: 22px; padding: 20px;
    margin-bottom: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04); transition: 0.2s;
}

.post-card:hover { box-shadow: 0 8px 28px rgba(0,0,0,0.1); transform: translateY(-1px); }

.post-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px; gap: 8px;
}

.post-header-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
.post-header-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.avatar-link { text-decoration: none; flex-shrink: 0; }

.post-avatar {
    width: 44px; height: 44px; border-radius: 50%; object-fit: cover;
    border: 2px solid #e5e7eb; flex-shrink: 0;
}

.post-avatar-placeholder {
    width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 17px; flex-shrink: 0;
}

.post-meta { display: flex; flex-direction: column; min-width: 0; }

.post-username {
    font-weight: 700; font-size: 15px; color: #111827;
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
}

.post-time { font-size: 12px; color: #9ca3af; margin-top: 2px; }

.owner-badge {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #111; font-size: 10px; padding: 2px 8px;
    border-radius: 20px; font-weight: 700;
}

.sensitive-badge {
    background: #fef3c7; color: #d97706; font-size: 10px;
    padding: 3px 8px; border-radius: 20px; font-weight: 700;
}

.delete-btn {
    font-size: 17px; color: #ef4444; text-decoration: none;
    opacity: 0.7; transition: 0.2s; padding: 5px 8px; border-radius: 8px;
}

.delete-btn:hover { opacity: 1; background: #fef2f2; }

.post-description {
    font-size: 15px; color: #374151; line-height: 1.65;
    margin: 0 0 14px; white-space: pre-wrap; word-break: break-word;
}

.post-media-wrap {
    border-radius: 16px; overflow: hidden; margin-bottom: 12px;
    background: #000; position: relative;
}

.post-media { width: 100%; max-height: 520px; object-fit: cover; display: block; }
.video-wrap .post-media { object-fit: contain; background: #000; }

.video-badge {
    position: absolute; top: 10px; left: 10px;
    background: rgba(0,0,0,0.6); color: white; font-size: 11px;
    font-weight: 700; padding: 3px 10px; border-radius: 20px;
    backdrop-filter: blur(4px);
}

/* STATS */
.post-stats {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 13px; color: #6b7280; padding: 4px 2px 8px;
    min-height: 20px;
}

.like-summary, .comment-summary { font-weight: 500; }

.post-divider { height: 1px; background: #f3f4f6; margin: 0 0 8px; }

/* ACCIONES */
.post-actions {
    display: flex; align-items: center;
    gap: 0; flex-wrap: nowrap; overflow-x: auto;
}

.action-btn {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 8px 10px; border-radius: 10px; border: none;
    background: transparent; cursor: pointer; font-size: 13px;
    color: #6b7280; text-decoration: none; transition: 0.15s;
    font-weight: 500; flex-shrink: 0; white-space: nowrap;
}

.action-btn:hover { background: #f3f4f6; color: #111; }
.action-icon { font-size: 17px; }
.action-label { font-size: 12px; font-weight: 600; }

.like-btn.liked .action-label { color: #ef4444; }
.like-btn.liked .action-icon { filter: drop-shadow(0 0 4px rgba(239,68,68,0.5)); }
.report-btn:hover { background: #fef2f2; color: #ef4444; }
.report-btn:hover .action-label { color: #ef4444; }

/* 🔥 LIKE ANIMATION */
@@keyframes likePopIn {
    0% { transform: scale(1); }
    30% { transform: scale(1.5); }
    60% { transform: scale(0.9); }
    100% { transform: scale(1); }
}

@@keyframes likeExplosionAnim {
    0% { transform: translate(-50%, -50%) scale(0); opacity: 1; }
    50% { transform: translate(-50%, -80%) scale(1.8); opacity: 1; }
    100% { transform: translate(-50%, -120%) scale(2.5); opacity: 0; }
}

.like-pop {
    animation: likePopIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.like-explosion {
    position: fixed; font-size: 36px; pointer-events: none;
    z-index: 99999; transform: translate(-50%, -50%);
}

.like-explosion.animate {
    animation: likeExplosionAnim 0.6s ease forwards;
}

/* SHARE */
.share-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5); display: none; z-index: 9998;
    backdrop-filter: blur(2px);
}

.share-menu {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: white; border-radius: 24px 24px 0 0;
    padding: 16px 20px 32px; display: none; z-index: 9999;
    box-shadow: 0 -10px 40px rgba(0,0,0,0.15);
}

.share-handle {
    width: 40px; height: 4px; background: #e5e7eb;
    border-radius: 10px; margin: 0 auto 16px;
}

.share-title { font-weight: 700; font-size: 16px; margin-bottom: 16px; color: #111; text-align: center; }

.share-options {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 12px; margin-bottom: 16px;
}

.share-option {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 14px 10px; border-radius: 16px; cursor: pointer;
    font-weight: 500; font-size: 12px; color: #374151;
    transition: 0.15s; background: #f9fafb; text-align: center;
}

.share-option:hover { background: #f3f4f6; transform: scale(1.03); }
.share-option-icon { font-size: 24px; }

.share-option.cancel {
    width: 100%; text-align: center; padding: 14px; color: #ef4444;
    background: #fef2f2; border-radius: 12px; flex-direction: row;
    justify-content: center; font-size: 14px;
}

.copy-alert {
    position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%);
    background: #111; color: white; padding: 10px 22px; border-radius: 50px;
    font-size: 14px; opacity: 0; transition: 0.3s; pointer-events: none;
    z-index: 99999; white-space: nowrap;
}

.copy-alert.show { opacity: 1; }

/* DARK MODE */
body.bg-dark .feed-title { color: #f1f5f9 !important; }
body.bg-dark .feed-empty { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .feed-empty h5 { color: #f1f5f9 !important; }
body.bg-dark .post-card { background: #1e1e2e !important; border-color: #2d2d3d !important; box-shadow: 0 2px 12px rgba(0,0,0,0.3) !important; }
body.bg-dark .post-username { color: #f1f5f9 !important; }
body.bg-dark .post-description { color: #cbd5e1 !important; }
body.bg-dark .post-time { color: #64748b !important; }
body.bg-dark .post-divider { background: #2d2d3d !important; }
body.bg-dark .post-stats { color: #64748b !important; }
body.bg-dark .action-btn { color: #94a3b8 !important; }
body.bg-dark .action-btn:hover { background: #2d2d3d !important; color: #f1f5f9 !important; }
body.bg-dark .share-menu { background: #1e1e2e !important; }
body.bg-dark .share-title { color: #f1f5f9 !important; }
body.bg-dark .share-option { background: #2d2d3d !important; color: #cbd5e1 !important; }
body.bg-dark .share-option:hover { background: #3d3d4d !important; }
body.bg-dark .share-handle { background: #3d3d4d !important; }
body.bg-dark .share-option.cancel { background: #3a1a1a !important; }
</style>

<script>
function toggleLike(postId, element) {
    const icon = document.getElementById('like-icon-' + postId);
    const isLiked = element.classList.contains('liked');

    // 🔥 animación inmediata
    icon.classList.remove('like-pop');
    void icon.offsetWidth;
    icon.classList.add('like-pop');

    if (!isLiked) {
        // 🔥 explosión de corazón
        const explosion = document.getElementById('likeExplosion');
        const rect = icon.getBoundingClientRect();
        explosion.style.left = (rect.left + rect.width / 2) + 'px';
        explosion.style.top = (rect.top + rect.height / 2) + 'px';
        explosion.style.display = 'block';
        explosion.classList.remove('animate');
        void explosion.offsetWidth;
        explosion.classList.add('animate');
        setTimeout(() => { explosion.style.display = 'none'; explosion.classList.remove('animate'); }, 700);
    }

    fetch('/Post/ToggleLike?postId=' + postId, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            icon.textContent = data.liked ? '❤️' : '🤍';
            element.classList.toggle('liked', data.liked);

            // 🔥 actualizar stats
            const summary = document.getElementById('like-summary-' + postId);
            if (summary) {
                summary.innerHTML = data.count > 0
                    ? `<span>❤️ ${data.count} ${data.count === 1 ? 'like' : 'likes'}</span>`
                    : '';
            }
        });
}

function savePost(postId, btn) {
    fetch('/Post/SavePost', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(postId)
    }).then(() => {
        const icon = btn.querySelector('.action-icon');
        icon.textContent = '🔖';
        icon.style.filter = 'drop-shadow(0 0 4px rgba(99,102,241,0.6))';
        showAlert('🔖 Publicación guardada');
        setTimeout(() => icon.style.filter = '', 1000);
    });
}

let currentPost = null;
function openShare(postId) {
    currentPost = postId;
    document.getElementById('shareMenu').style.display = 'block';
    document.getElementById('shareOverlay').style.display = 'block';
}

function closeShare() {
    document.getElementById('shareMenu').style.display = 'none';
    document.getElementById('shareOverlay').style.display = 'none';
}

function shareWhatsApp() {
    window.open('https://wa.me/?text=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}

function shareTelegram() {
    window.open('https://t.me/share/url?url=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}

function shareFacebook() {
    window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.origin + '/Post/Comments?postId=' + currentPost));
    closeShare();
}

function copyLink() {
    navigator.clipboard.writeText(window.location.origin + '/Post/Comments?postId=' + currentPost);
    closeShare();
    showAlert('↪ Link copiado');
}

function showAlert(msg) {
    const el = document.getElementById('copyAlert');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 2500);
}
// ══ STORIES ══
let allStories = [];
let currentStoryIndex = 0;
let currentUserStories = [];
let currentUserId2 = 0;
let storyTimer = null;
let storyProgressInterval = null;
const myUserId = @(int.Parse(User.FindFirst("UserId").Value));

async function loadFriendStories() {
    try {
        const res = await fetch('/Story/GetFriendsStories');
        const data = await res.json();
        const container = document.getElementById('friendStories');
        container.innerHTML = '';

        data.forEach(group => {
            const hasUnviewed = group.hasUnviewed;
            const user = group.user;
            const pic = user.profileImage || user.profilePicture || '';

            const item = document.createElement('div');
            item.className = 'story-item';
            item.onclick = () => openStoryViewer(group);

            const wrap = document.createElement('div');
            wrap.className = `story-avatar-wrap ${hasUnviewed ? '' : 'viewed'}`;

            if (pic) {
                wrap.innerHTML = `<img src="${pic}" class="story-avatar-img"/>`;
            } else {
                wrap.innerHTML = `<div class="story-avatar-letter">${user.username.charAt(0).toUpperCase()}</div>`;
            }

            const name = document.createElement('div');
            name.className = 'story-name';
            name.textContent = user.username;

            item.appendChild(wrap);
            item.appendChild(name);
            container.appendChild(item);
        });
    } catch(e) { console.error(e); }
}

function openStoryViewer(group) {
    currentUserStories = group.stories;
    currentStoryIndex = 0;
    currentUserId2 = group.user.id;

    document.getElementById('svAvatar').src = group.user.profileImage || group.user.profilePicture || '';
    document.getElementById('svUsername').textContent = group.user.username;
    document.getElementById('svDelete').style.display = group.user.id === myUserId ? 'block' : 'none';

    document.getElementById('storyViewer').style.display = 'flex';
    document.body.style.overflow = 'hidden';
    buildProgressBars();
    showStory(0);
}

function buildProgressBars() {
    const bars = document.getElementById('storyProgressBars');
    bars.innerHTML = '';
    currentUserStories.forEach((_, i) => {
        const bar = document.createElement('div');
        bar.className = 'story-progress-bar';
        bar.innerHTML = `<div class="story-progress-fill" id="progress-${i}"></div>`;
        bars.appendChild(bar);
    });
}

function showStory(index) {
    if (index >= currentUserStories.length) { closeStoryViewer(); return; }
    if (index < 0) { closeStoryViewer(); return; }

    currentStoryIndex = index;
    const story = currentUserStories[index];

    // Marcar como vista
    fetch('/Story/View', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(story.id)
    });

    // Limpiar contenido anterior
    document.getElementById('svImg').style.display = 'none';
    document.getElementById('svVideo').style.display = 'none';
    document.getElementById('svText').style.display = 'none';

    if (story.type === 'image') {
        const img = document.getElementById('svImg');
        img.src = story.mediaUrl;
        img.style.display = 'block';
    } else if (story.type === 'video') {
        const vid = document.getElementById('svVideo');
        vid.src = story.mediaUrl;
        vid.style.display = 'block';
        vid.play();
    } else if (story.type === 'text') {
        const txt = document.getElementById('svText');
        txt.textContent = story.textContent;
        txt.style.background = story.bgColor || '#6366f1';
        txt.style.display = 'flex';
    }

    // Tiempo
    const timeAgo = getTimeAgo(new Date(story.createdAt));
    document.getElementById('svTime').textContent = timeAgo;
    document.getElementById('svViews').textContent = `👁 ${story.views} vistas`;
    document.getElementById('svHighlight').textContent = story.isHighlight ? '★' : '☆';

    // Progress bars — resetear todas
    currentUserStories.forEach((_, i) => {
        const fill = document.getElementById('progress-' + i);
        if (fill) fill.style.width = i < index ? '100%' : '0%';
    });

    // Animar la actual
    startProgress(index, story.duration * 1000);
}

function startProgress(index, duration) {
    clearInterval(storyProgressInterval);
    clearTimeout(storyTimer);

    const fill = document.getElementById('progress-' + index);
    if (!fill) return;

    let elapsed = 0;
    const interval = 50;
    storyProgressInterval = setInterval(() => {
        elapsed += interval;
        fill.style.width = (elapsed / duration * 100) + '%';
        if (elapsed >= duration) {
            clearInterval(storyProgressInterval);
            showStory(currentStoryIndex + 1);
        }
    }, interval);
}

function nextStory() {
    clearInterval(storyProgressInterval);
    showStory(currentStoryIndex + 1);
}

function prevStory() {
    clearInterval(storyProgressInterval);
    showStory(currentStoryIndex - 1);
}

function closeStoryViewer() {
    clearInterval(storyProgressInterval);
    clearTimeout(storyTimer);
    document.getElementById('storyViewer').style.display = 'none';
    document.body.style.overflow = '';
    const vid = document.getElementById('svVideo');
    vid.pause(); vid.src = '';
}

async function deleteCurrentStory() {
    const story = currentUserStories[currentStoryIndex];
    if (!confirm('¿Eliminar esta historia?')) return;
    await fetch('/Story/Delete', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(story.id)
    });
    currentUserStories.splice(currentStoryIndex, 1);
    if (currentUserStories.length === 0) { closeStoryViewer(); return; }
    buildProgressBars();
    showStory(Math.min(currentStoryIndex, currentUserStories.length - 1));
}

async function toggleHighlight() {
    const story = currentUserStories[currentStoryIndex];
    const res = await fetch('/Story/ToggleHighlight', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(story.id)
    });
    const data = await res.json();
    story.isHighlight = data.isHighlight;
    document.getElementById('svHighlight').textContent = data.isHighlight ? '★' : '☆';
}

function getTimeAgo(date) {
    const diff = Math.floor((Date.now() - date) / 60000);
    if (diff < 1) return 'ahora';
    if (diff < 60) return `hace ${diff} min`;
    if (diff < 1440) return `hace ${Math.floor(diff/60)}h`;
    return `hace ${Math.floor(diff/1440)}d`;
}

document.addEventListener('DOMContentLoaded', loadFriendStories);
</script>