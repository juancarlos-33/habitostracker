@model List<HabitTrackerApp.Models.Post>

@{
    var myLikes = ViewBag.MyLikes as List<int> ?? new List<int>();
    var commentCounts = ViewBag.CommentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="feed-header">
    <div>
        <h2 class="feed-title">🔥 Publicaciones</h2>
        <p class="feed-subtitle">Comparte momentos con la comunidad</p>
    </div>
    <a asp-controller="Post" asp-action="Create" class="new-post-btn">
        ✏️ Publicar
    </a>
</div>

@if (!Model.Any())
{
    <div class="feed-empty">
        <div class="feed-empty-icon">📭</div>
        <h5>Sin publicaciones aún</h5>
        <p>¡Sé el primero en compartir algo!</p>
        <a asp-controller="Post" asp-action="Create" class="new-post-btn" style="display:inline-flex;margin-top:16px;">
            ✏️ Crear publicación
        </a>
    </div>
}

<div class="feed-container">
    @foreach (var post in Model)
    {
        var isVideo = !string.IsNullOrEmpty(post.ImagePath) &&
                      (post.ImagePath.Contains("/video/upload/") ||
                       post.ImagePath.EndsWith(".mp4") ||
                       post.ImagePath.EndsWith(".mov") ||
                       post.ImagePath.EndsWith(".webm"));

        var currentUserId = int.Parse(User.FindFirst("UserId").Value);
        var likeCount = ViewBag.PostLikes != null && ((Dictionary<int,int>)ViewBag.PostLikes).ContainsKey(post.Id)
            ? ((Dictionary<int,int>)ViewBag.PostLikes)[post.Id] : 0;
        var isLiked = myLikes.Contains(post.Id);

        <article class="post-card" id="post-@post.Id">
            <!-- HEADER -->
            <div class="post-header">
                <div class="post-header-left">
                    @if (post.User != null)
                    {
                        <a asp-controller="User" asp-action="Profile" asp-route-id="@post.UserId" class="avatar-link">
                            @{
                                var postPic = !string.IsNullOrEmpty(post.User?.ProfileImage)
                                    ? post.User.ProfileImage
                                    : post.User?.ProfilePicture;
                            }
                            @if (!string.IsNullOrEmpty(postPic))
                            {
                                <img src="@postPic" class="post-avatar" />
                            }
                            else
                            {
                                <div class="post-avatar-placeholder">@post.DisplayUsername.Substring(0, 1).ToUpper()</div>
                            }
                        </a>
                    }
                    else
                    {
                        <div class="post-avatar-placeholder">👤</div>
                    }

                    <div class="post-meta">
                        <div class="post-username">
                            <a href="/User/Profile/@post.UserId" style="text-decoration:none;color:inherit;">@post.DisplayUsername</a>
                        </div>
                        <div class="post-time-wrap">
                            <span class="post-time">@post.CreatedAt.ToString("dd MMM yyyy · hh:mm tt", new System.Globalization.CultureInfo("es-CO"))</span>
                            @if (post.Privacy == "Friends")
                            { <span class="post-privacy-badge friends">👥 Amigos</span> }
                            else if (post.Privacy == "Private")
                            { <span class="post-privacy-badge private">🔒 Solo yo</span> }
                            else
                            { <span class="post-privacy-badge public">🌐 Público</span> }
                        </div>
                    </div>
                </div>

                <div class="post-header-right">
                    @if (post.IsSensitive)
                    {
                        <span class="sensitive-badge">⚠️ Sensible</span>
                    }
                    @if (post.UserId == currentUserId)
                    {
                        <form method="post" asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" style="display:inline;margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="delete-btn" data-no-loader="true"
                                    onclick="event.preventDefault();showConfirm({icon:'🗑️',title:'¿Eliminar publicación?',message:'La publicación se eliminará permanentemente, junto con sus comentarios y reacciones.',confirmText:'🗑 Eliminar',confirmColor:'#ef4444',onConfirm:()=>this.closest('form').submit()});return false;">🗑</button>
                        </form>
                    }
                </div>
            </div>

            <!-- DESCRIPCIÓN -->
            @if (!string.IsNullOrEmpty(post.Description))
            {
                <p class="post-description">@post.Description</p>
            }

            <!-- ALERTAS DE ADVERTENCIA -->
            @if (post.IsUnderWarning)
            {
                <div class="alert alert-danger mt-2 py-1" style="border-left: 4px solid #dc2626; font-size: 13px;">
                    ⚠️ <strong>Incumple nuestras normas</strong>
                </div>
                <div class="alert alert-danger mt-1 py-1" style="border-left: 4px solid #dc2626; background-color: #fff5f5; font-size: 13px;">
                    🔴 <strong>Cuenta en riesgo</strong>
                </div>
            }

            <!-- MEDIA -->
            @if (!string.IsNullOrEmpty(post.ImagePath))
            {
                var isBlurred = post.IsSensitive || post.IsUnderWarning;
                var blurMessage = post.IsUnderWarning ? "⚠️ Publicación sospechosa - Incumple normas" : "⚠️ Contenido sensible";

                <div class="post-media-wrap @(isVideo ? "video-wrap" : "") @(isBlurred ? "blurred-wrap" : "")" data-post-id="@post.Id" ondblclick="dblTapLike(@post.Id, event)">
                    @if (isVideo)
                    {
                        <video controls class="post-media" preload="metadata">
                            <source src="@post.ImagePath" />
                        </video>
                        <div class="video-badge">▶ Video</div>
                    }
                    else if (isBlurred)
                    {
                        <img src="@post.ImagePath" class="post-media blurred-image" id="img-@post.Id" />
                        <div class="blur-overlay" id="overlay-@post.Id">
                            <div class="blur-overlay-content">
                                <span class="blur-icon">🚫</span>
                                <p>@blurMessage</p>
                                <button class="reveal-btn" onclick="revealBlurred(@post.Id)">Ver imagen</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <img src="@post.ImagePath" class="post-media" onclick="abrirFotoPost(this.src)" />
                    }
                    <div class="dbltap-heart" id="dbltap-heart-@post.Id">❤</div>
                </div>
            }

            <!-- STATS -->
            <div class="post-stats">
                <span id="like-summary-@post.Id" class="like-summary">
                    @if (likeCount > 0)
                    {
                        <span>❤️ @likeCount @(likeCount == 1 ? "like" : "likes")</span>
                    }
                </span>
                <span class="comment-summary">
                    @{
                        var cc = commentCounts.ContainsKey(post.Id) ? commentCounts[post.Id] : 0;
                    }
                    @if (cc > 0)
                    {
                        <span>@cc @(cc == 1 ? "comentario" : "comentarios")</span>
                    }
                </span>
            </div>

            <!-- DIVIDER -->
            <div class="post-divider"></div>

            <!-- ACCIONES -->
            <div class="post-actions">
                <button class="action-btn like-btn @(isLiked ? "liked" : "")"
                        id="like-btn-@post.Id"
                        data-no-loader="true"
                        onclick="toggleLike(@post.Id, this)">
                    <span class="action-icon like-icon" id="like-icon-@post.Id">@(isLiked ? "❤️" : "🤍")</span>
                    <span class="action-label">Me gusta</span>
                </button>

                <a asp-controller="Post" asp-action="Comments" asp-route-postId="@post.Id" class="action-btn">
                    <span class="action-icon">💬</span>
                    <span class="action-label">Comentar</span>
                </a>

                <button class="action-btn" data-no-loader="true" onclick="openShare(@post.Id)">
                    <span class="action-icon">↪️</span>
                    <span class="action-label">Compartir</span>
                </button>

                <button class="action-btn save-btn" data-no-loader="true" onclick="savePost(@post.Id, this)">
                    <span class="action-icon">🔖</span>
                    <span class="action-label">Guardar</span>
                </button>

                <a asp-controller="Post" asp-action="Report" asp-route-postId="@post.Id" class="action-btn report-btn">
                    <span class="action-icon">🚩</span>
                    <span class="action-label">Reportar</span>
                </a>
            </div>
        </article>
    }
</div>

<!-- SHARE MENU -->
<div id="shareOverlay" class="share-overlay" onclick="closeShare()"></div>
<div id="shareMenu" class="share-menu">
    <div class="share-handle"></div>
    <div class="share-title">Compartir publicación</div>
    <div class="share-options">
        <div class="share-option" onclick="repostear()">
            <span class="share-option-icon">↪️</span>
            <span>Repostear</span>
        </div>
        <div class="share-option" onclick="shareWhatsApp()">
            <span class="share-option-icon">📱</span>
            <span>WhatsApp</span>
        </div>
        <div class="share-option" onclick="shareTelegram()">
            <span class="share-option-icon">✈️</span>
            <span>Telegram</span>
        </div>
        <div class="share-option" onclick="shareFacebook()">
            <span class="share-option-icon">📘</span>
            <span>Facebook</span>
        </div>
        <div class="share-option" onclick="copyLink()">
            <span class="share-option-icon">📋</span>
            <span>Copiar link</span>
        </div>
    </div>
    <div class="share-option cancel" onclick="closeShare()">✕ Cancelar</div>
</div>

<!-- MODAL DE COMENTARIOS (estilo Facebook) - CORREGIDO: FUERA DEL SHARE MENU -->
<div id="commentsModal" class="comments-modal" style="display:none;">
    <div class="comments-modal-overlay" onclick="closeCommentsModal()"></div>
    <div class="comments-modal-container">
        <div class="comments-modal-header">
            <div>
                <div class="comments-modal-title">Comentarios</div>
                <div class="comments-modal-subtitle" id="commentsModalSubtitle">Conversación de la publicación</div>
            </div>
            <div class="comments-modal-tabs">
                <button type="button" class="cm-tab active" data-sort="recent" onclick="setCommentsSort('recent')">Recientes</button>
                <button type="button" class="cm-tab" data-sort="top" onclick="setCommentsSort('top')">Populares</button>
            </div>
            <button class="comments-modal-close" onclick="closeCommentsModal()">✕</button>
        </div>
        <div class="comments-modal-body" id="commentsModalBody">
            <div class="comments-loading">Cargando comentarios...</div>
        </div>
        <div class="comments-modal-footer" id="commentsModalFooter"></div>
        <div id="commentTypingIndicator" class="comment-typing-indicator" style="display:none;">✍️ Alguien está escribiendo...</div>
    </div>
</div>

<!-- LIKE EXPLOSION -->
<div id="likeExplosion" class="like-explosion" style="display:none;">❤️</div>

<div id="copyAlert" class="copy-alert">↪ Link copiado</div>

<style>
/* (todos los estilos originales se mantienen igual, incluyendo los del modal) */
.feed-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
}
/* ══ STORIES BAR ══ */
.stories-bar{
    display:flex;gap:14px;overflow-x:auto;padding:4px 2px 16px;
    scrollbar-width:none;-webkit-overflow-scrolling:touch;margin-bottom:8px;
}
.stories-bar::-webkit-scrollbar{display:none;}
.story-item{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;flex-shrink:0;}
.story-avatar-wrap{
    width:64px;height:64px;border-radius:50%;position:relative;
    padding:3px;background:linear-gradient(135deg,#f97316,#ec4899,#6366f1);
}
.story-avatar-wrap.my-story{background:linear-gradient(135deg,#6366f1,#4f46e5);}
.story-avatar-wrap.viewed{background:#e5e7eb;}
.story-avatar-img{width:100%;height:100%;border-radius:50%;object-fit:cover;border:2px solid white;}
.story-avatar-letter{
    width:100%;height:100%;border-radius:50%;
    background:linear-gradient(135deg,#2563eb,#7c3aed);
    color:white;display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:22px;border:2px solid white;
}
.story-add-btn{
    position:absolute;bottom:0;right:0;
    width:20px;height:20px;border-radius:50%;
    background:#6366f1;color:white;font-size:14px;font-weight:800;
    display:flex;align-items:center;justify-content:center;
    border:2px solid white;line-height:1;
}
.story-name{font-size:11px;font-weight:600;color:#374151;max-width:64px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

/* ══ STORY VIEWER ══ */
.story-viewer{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;}
.story-viewer-bg{position:absolute;inset:0;background:rgba(0,0,0,0.92);}
.story-viewer-card{
    position:relative;width:100%;max-width:400px;height:100vh;max-height:720px;
    border-radius:20px;overflow:hidden;background:#000;z-index:1;
}
.story-progress-bars{
    position:absolute;top:12px;left:12px;right:12px;
    display:flex;gap:4px;z-index:10;
}
.story-progress-bar{
    flex:1;height:3px;background:rgba(255,255,255,0.3);border-radius:10px;overflow:hidden;
}
.story-progress-fill{height:100%;background:white;width:0%;transition:none;}
.story-viewer-header{
    position:absolute;top:28px;left:12px;right:12px;
    display:flex;align-items:center;justify-content:space-between;z-index:10;
}
.story-viewer-content{width:100%;height:100%;position:relative;}
.story-nav-left{position:absolute;left:0;top:0;width:40%;height:100%;z-index:5;cursor:pointer;}
.story-nav-right{position:absolute;right:0;top:0;width:40%;height:100%;z-index:5;cursor:pointer;}
.story-views-bar{
    position:absolute;bottom:16px;left:16px;right:16px;
    display:flex;align-items:center;justify-content:center;z-index:10;
}
.story-views-bar span{font-size:12px;color:rgba(255,255,255,0.7);font-weight:600;}

body.bg-dark .story-name{color:#94a3b8!important;}
body.bg-dark .story-avatar-wrap.viewed{background:#334155!important;}

@@media(max-width:768px){
    .story-viewer-card{border-radius:0;max-height:100vh;}
}

.feed-title { font-size: 22px; font-weight: 800; margin: 0 0 2px; color: #111827; }
.feed-subtitle { font-size: 13px; color: #9ca3af; margin: 0; }

.new-post-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    color: white; padding: 10px 20px; border-radius: 50px;
    font-size: 14px; font-weight: 600; text-decoration: none;
    transition: 0.2s; box-shadow: 0 4px 14px rgba(37,99,235,0.3);
    white-space: nowrap;
}
.new-post-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(37,99,235,0.4); color: white; }

.feed-empty {
    text-align: center; padding: 60px 20px; background: white;
    border-radius: 22px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04); max-width: 620px; margin: 0 auto 24px;
}
.post-time-wrap {
    display: flex; align-items: center; gap: 6px;
    flex-wrap: wrap; margin-top: 2px;
}
.post-time { font-size: 12px; color: #9ca3af; }
.post-privacy-badge {
    font-size: 10px; font-weight: 700; padding: 2px 7px;
    border-radius: 20px; white-space: nowrap; line-height: 1.4;
}
.post-privacy-badge.friends { background:#dbeafe; color:#1d4ed8; }
.post-privacy-badge.private { background:#fce7f3; color:#9d174d; }
.post-privacy-badge.public { background:#dcfce7; color:#15803d; }
body.bg-dark .post-privacy-badge.friends { background:rgba(37,99,235,0.2); color:#93c5fd; }
body.bg-dark .post-privacy-badge.private { background:rgba(157,23,77,0.2); color:#f9a8d4; }
body.bg-dark .post-privacy-badge.public { background:rgba(21,128,61,0.2); color:#86efac; }

.feed-empty-icon { font-size: 52px; margin-bottom: 16px; }
.feed-empty h5 { font-size: 18px; font-weight: 700; color: #111827; margin-bottom: 8px; }
.feed-empty p { font-size: 14px; color: #9ca3af; margin: 0; }

.feed-container { max-width: 620px; margin: 0 auto; }

.post-card {
    background: white; border-radius: 22px; padding: 20px;
    margin-bottom: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04); transition: 0.2s;
}
.post-card:hover { box-shadow: 0 8px 28px rgba(0,0,0,0.1); transform: translateY(-1px); }

.post-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px; gap: 8px;
}
.post-header-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
.post-header-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.avatar-link { text-decoration: none; flex-shrink: 0; }
.post-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #e5e7eb; flex-shrink: 0; }
.post-avatar-placeholder {
    width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 17px; flex-shrink: 0;
}
.post-meta { display: flex; flex-direction: column; min-width: 0; }
.post-username { font-weight: 700; font-size: 15px; color: #111827; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.owner-badge {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #111; font-size: 10px; padding: 2px 8px;
    border-radius: 20px; font-weight: 700;
}

/* ===== MODAL COMENTARIOS ESTILOS ===== */
.comments-modal {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    z-index: 99999; display: flex; align-items: center; justify-content: center;
}
.comments-modal-overlay {
    position: absolute; inset: 0;
    background: rgba(2,6,23,0.72); backdrop-filter: blur(10px);
}
.comments-modal-container {
    position: relative; background: #ffffff; width: min(720px, calc(100vw - 28px));
    height: min(760px, calc(100vh - 36px)); border-radius: 26px; display: grid;
    grid-template-rows: auto 1fr auto auto;
    overflow: hidden; box-shadow: 0 30px 90px rgba(2,6,23,0.45);
    border: 1px solid rgba(255,255,255,.45);
}
.comments-modal-header {
    display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap:12px;
    padding: 14px 16px; border-bottom: 1px solid rgba(15,23,42,.07);
    background: rgba(255,255,255,.96); flex-shrink: 0;
}
.comments-modal-title { font-weight: 900; font-size: 18px; color: #0f172a; letter-spacing:-.2px; }
.comments-modal-subtitle { font-size: 12px; color:#64748b; font-weight:700; margin-top:2px; }
.comments-modal-tabs{display:flex;gap:6px;background:#f1f5f9;border-radius:999px;padding:4px;border:1px solid #e2e8f0;}
.cm-tab{border:none;background:transparent;color:#64748b;border-radius:999px;padding:7px 10px;font-size:12px;font-weight:900;cursor:pointer;}
.cm-tab.active{background:#0f172a;color:white;box-shadow:0 8px 18px rgba(15,23,42,.18);}
.comments-modal-close {
    background: #f1f5f9; border: none; font-size: 18px; cursor: pointer;
    color: #64748b; width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; transition: 0.2s;
}
.comments-modal-close:hover { background: #e2e8f0; color: #0f172a; }
.comments-modal-body {
    min-height: 0; overflow-y: auto; padding: 18px; background:
        radial-gradient(circle at top left, rgba(99,102,241,.08), transparent 30%),
        #f8fafc;
}
.comments-loading { text-align: center; padding: 54px 20px; color: #64748b; font-weight:700; }
.comment-item {
    display: flex; gap: 12px; margin-bottom: 14px; padding: 0;
    border-bottom: none;
}
.comment-avatar {
    width: 42px; height: 42px; border-radius: 50%; object-fit: cover;
    flex-shrink: 0; border:2px solid #fff; box-shadow:0 8px 22px rgba(15,23,42,.12);
}
.comment-avatar-letter {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    color: white; display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 16px; flex-shrink: 0; box-shadow:0 8px 22px rgba(15,23,42,.12);
}
.comment-content { flex: 1; min-width:0; background:#fff; border:1px solid rgba(15,23,42,.06); border-radius:18px; padding:11px 13px; box-shadow:0 10px 28px rgba(15,23,42,.055); }
.comment-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px; }
.comment-username { font-weight: 900; font-size: 13px; color: #0f172a; display: inline-block; text-decoration:none; }
.comment-username:hover{color:#4f46e5;text-decoration:underline;}
.comment-time { font-size: 11px; color: #94a3b8; font-weight:700; }
.comment-text { font-size: 14px; color: #334155; margin: 5px 0 8px; line-height:1.55; word-break: break-word; white-space:pre-wrap; }
.comment-img { max-width: 100%; max-height: 240px; border-radius: 14px; margin-top: 7px; cursor: pointer; object-fit:cover; box-shadow:0 10px 28px rgba(15,23,42,.12); }
.comment-actions { display: flex; gap: 8px; margin-top: 9px; flex-wrap:wrap; }
.comment-item.system-comment .comment-content {
    border: 1px solid rgba(245,158,11,.28);
    background: linear-gradient(135deg, rgba(245,158,11,.08), rgba(99,102,241,.06));
}
.comment-system-note {
    margin-top: 8px; padding: 8px 10px; border-radius: 10px;
    background: rgba(15,23,42,.06); color: #475569;
    font-size: 11px; font-weight: 800;
}
.comment-system-lock {
    color: #92400e; background: #fffbeb; border: 1px solid #fde68a;
    padding: 5px 10px; border-radius: 999px; font-size: 11px; font-weight: 800;
}
.comment-like-btn {
    background: #f8fafc; border: 1px solid #e2e8f0; font-size: 12px; font-weight: 900;
    color: #64748b; cursor: pointer; padding: 6px 10px;
    border-radius: 999px; transition: 0.2s; display: flex; align-items: center; gap: 4px;
}
.comment-like-btn:hover { background: #fff1f2; border-color:#fecdd3; color:#e11d48; }
.comment-like-btn.liked { color: #ef4444; }
.comment-reply-btn {
    background:#eff6ff; border:1px solid #dbeafe; color:#2563eb;
    font-size:12px; font-weight:900; border-radius:999px; padding:6px 10px; cursor:pointer;
}
.comment-reply-btn:hover { background:#dbeafe; }
.comment-delete-btn {
    background: #fff1f2; border: 1px solid #ffe4e6; font-size: 12px; color: #e11d48;
    cursor: pointer; padding: 6px 10px; border-radius: 999px; font-weight:900;
}
