@{
    ViewData["Title"] = "Nueva publicación";
}

<div class="create-post-page">

    <div class="create-post-header">
        <h2 class="create-post-title">📸 Nueva publicación</h2>
        <p class="create-post-subtitle">Comparte un momento con la comunidad</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="create-alert-error">⚠️ @TempData["Error"]</div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">

        <div class="create-card">

            <!-- MEDIA UPLOAD -->
            <div class="media-upload-zone" id="uploadZone" onclick="document.getElementById('mediaInput').click()">
                <input type="file" name="image" id="mediaInput" accept="image/*,video/*" style="display:none;" />

                <div id="uploadPlaceholder">
                    <div class="upload-icon">🖼️</div>
                    <div class="upload-text">Haz clic para subir una foto o video</div>
                    <div class="upload-hint">JPG, PNG, GIF, MP4, MOV — Máx 50MB</div>
                </div>

                <div id="mediaPreview" style="display:none;">
                    <img id="imagePreview" style="display:none;" class="preview-media" />
                    <video id="videoPreview" controls style="display:none;" class="preview-media"></video>
                    <button type="button" class="remove-media-btn" onclick="removeMedia(event)">✖</button>
                </div>
            </div>

            <!-- DESCRIPCIÓN -->
            <div class="description-field">
                <label class="field-label">✍️ Descripción</label>
                <textarea name="description" id="descInput" class="description-input"
                          placeholder="¿Qué quieres compartir hoy?" rows="4" maxlength="500"></textarea>
                <div class="char-counter"><span id="charCount">0</span>/500</div>
            </div>

            <!-- BOTONES -->
            <div class="create-actions">
                <a asp-action="Index" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-publish" id="btnPublish">
                    🚀 Publicar
                </button>
            </div>

        </div>
    </form>
</div>

<style>
.create-post-page { max-width: 600px; margin: 0 auto; }

.create-post-header { margin-bottom: 24px; }
.create-post-title { font-size: 24px; font-weight: 800; color: #111827; margin: 0 0 4px; }
.create-post-subtitle { font-size: 14px; color: #9ca3af; margin: 0; }

.create-alert-error {
    background: #fee2e2;
    color: #dc2626;
    padding: 12px 16px;
    border-radius: 12px;
    margin-bottom: 16px;
    font-size: 14px;
    font-weight: 500;
}

.create-card {
    background: white;
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 2px 14px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* UPLOAD ZONE */
.media-upload-zone {
    border: 2px dashed #e5e7eb;
    border-radius: 16px;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.2s;
    background: #f9fafb;
    position: relative;
    overflow: hidden;
}

.media-upload-zone:hover {
    border-color: #2563eb;
    background: #eff6ff;
}

.media-upload-zone.dragover {
    border-color: #2563eb;
    background: #dbeafe;
    transform: scale(1.01);
}

#uploadPlaceholder { text-align: center; padding: 24px; pointer-events: none; }
.upload-icon { font-size: 48px; margin-bottom: 12px; }
.upload-text { font-size: 15px; font-weight: 600; color: #374151; margin-bottom: 6px; }
.upload-hint { font-size: 12px; color: #9ca3af; }

#mediaPreview {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 200px;
}

.preview-media {
    max-width: 100%;
    max-height: 400px;
    border-radius: 12px;
    object-fit: contain;
    display: block;
}

.remove-media-btn {
    position: absolute;
    top: 8px; right: 8px;
    background: rgba(0,0,0,0.6);
    color: white;
    border: none;
    border-radius: 50%;
    width: 30px; height: 30px;
    font-size: 13px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.2s;
    z-index: 2;
}

.remove-media-btn:hover { background: #dc2626; }

/* DESCRIPCIÓN */
.field-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 8px;
}

.description-input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.6;
    outline: none;
    transition: 0.2s;
    resize: vertical;
    font-family: inherit;
    background: #f9fafb;
    color: #111827;
}

.description-input:focus {
    border-color: #2563eb;
    background: white;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
}

.description-input::placeholder { color: #9ca3af; }

.char-counter {
    text-align: right;
    font-size: 12px;
    color: #9ca3af;
    margin-top: 4px;
}

.char-counter.limit { color: #dc2626; }

/* ACCIONES */
.create-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
}

.btn-cancel {
    padding: 11px 22px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    background: white;
    color: #6b7280;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: 0.2s;
    display: inline-flex;
    align-items: center;
}

.btn-cancel:hover { background: #f3f4f6; color: #374151; }

.btn-publish {
    padding: 11px 28px;
    border-radius: 10px;
    border: none;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    color: white;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s;
    position: relative;
    overflow: hidden;
}

.btn-publish:hover { transform: scale(1.03); box-shadow: 0 6px 18px rgba(37,99,235,0.35); }
.btn-publish:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

/* DARK MODE */
body.bg-dark .create-post-title { color: #f1f5f9 !important; }
body.bg-dark .create-card { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .media-upload-zone { background: #2d2d3d !important; border-color: #3d3d4d !important; }
body.bg-dark .media-upload-zone:hover { background: #1e3a5f !important; border-color: #2563eb !important; }
body.bg-dark .upload-text { color: #f1f5f9 !important; }
body.bg-dark .description-input { background: #2d2d3d !important; border-color: #3d3d4d !important; color: #f1f5f9 !important; }
body.bg-dark .description-input:focus { background: #3d3d4d !important; }
body.bg-dark .field-label { color: #e2e8f0 !important; }
body.bg-dark .btn-cancel { background: #2d2d3d !important; border-color: #3d3d4d !important; color: #94a3b8 !important; }
</style>

<script>
const mediaInput = document.getElementById("mediaInput");
const uploadZone = document.getElementById("uploadZone");
const uploadPlaceholder = document.getElementById("uploadPlaceholder");
const mediaPreview = document.getElementById("mediaPreview");
const imagePreview = document.getElementById("imagePreview");
const videoPreview = document.getElementById("videoPreview");
const descInput = document.getElementById("descInput");
const charCount = document.getElementById("charCount");

// Contador de caracteres
descInput.addEventListener("input", function() {
    const len = this.value.length;
    charCount.textContent = len;
    charCount.parentElement.classList.toggle("limit", len >= 480);
});

// Selección de archivo
mediaInput.addEventListener("change", function() {
    const file = this.files[0];
    if (file) showPreview(file);
});

function showPreview(file) {
    const url = URL.createObjectURL(file);
    uploadPlaceholder.style.display = "none";
    mediaPreview.style.display = "flex";

    if (file.type.startsWith("image")) {
        imagePreview.src = url;
        imagePreview.style.display = "block";
        videoPreview.style.display = "none";
    } else if (file.type.startsWith("video")) {
        videoPreview.src = url;
        videoPreview.style.display = "block";
        imagePreview.style.display = "none";
    }
}

function removeMedia(e) {
    e.stopPropagation();
    mediaInput.value = "";
    imagePreview.src = "";
    imagePreview.style.display = "none";
    videoPreview.src = "";
    videoPreview.style.display = "none";
    mediaPreview.style.display = "none";
    uploadPlaceholder.style.display = "block";
}

mediaInput.addEventListener("change", function() {
    const file = this.files[0];
    if (!file) return;

    if (file.type.startsWith("video")) {
        const video = document.createElement("video");
        video.preload = "metadata";
        video.onloadedmetadata = function() {
            URL.revokeObjectURL(video.src);
            if (video.duration > 600) { // 10 minutos
                alert("⚠️ El video no puede durar más de 10 minutos.");
                mediaInput.value = "";
                return;
            }
            showPreview(file);
        };
        video.src = URL.createObjectURL(file);
    } else {
        showPreview(file);
    }
});

// Drag & Drop
uploadZone.addEventListener("dragover", (e) => {
    e.preventDefault();
    uploadZone.classList.add("dragover");
});

uploadZone.addEventListener("dragleave", () => uploadZone.classList.remove("dragover"));

uploadZone.addEventListener("drop", (e) => {
    e.preventDefault();
    uploadZone.classList.remove("dragover");
    const file = e.dataTransfer.files[0];
    if (file && (file.type.startsWith("image") || file.type.startsWith("video"))) {
        const dt = new DataTransfer();
        dt.items.add(file);
        mediaInput.files = dt.files;
        showPreview(file);
    }
});

// Validación
document.getElementById("createForm").addEventListener("submit", function(e) {
    const text = descInput.value.trim();
    const hasFile = mediaInput.files.length > 0;
    if (!text && !hasFile) {
        e.preventDefault();
        alert("Debes escribir algo o subir una imagen/video.");
        return;
    }
    // 🔥 deshabilitar DESPUÉS de un pequeño delay para que el form se envíe primero
    setTimeout(() => {
        document.getElementById("btnPublish").disabled = true;
        document.getElementById("btnPublish").textContent = "⏳ Publicando...";
    }, 100);
});
</script>