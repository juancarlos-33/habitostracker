@functions {
    string ResaltarMenciones(string text) {
        if (string.IsNullOrEmpty(text)) return text;
        var db2 = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>();
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        
        // Obtener todos los usuarios mencionados ordenados por longitud descendente
        var users = db2?.Users.ToList() ?? new List<HabitTrackerApp.Models.User>();
        var ordered = users.OrderByDescending(u => u.Username.Length).ToList();
        
        foreach (var user in ordered) {
            var mention = "@" + user.Username;
            if (encoded.Contains(mention)) {
                var link = "<a href='/User/Profile/" + user.Id + "' style='color:#818cf8;font-weight:700;text-decoration:none;'>" + mention + "</a>";
                encoded = encoded.Replace(mention, link);
            }
        }
        return encoded;
    }
}

@if (TempData["Error"] != null)
{
    <div class="cmt-alert">⚠️ @TempData["Error"]</div>
}

@model List<HabitTrackerApp.Models.PostComment>

@{
    var db = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>();
    var myUserId = int.Parse(User.FindFirst("UserId").Value);
    var currentUser = db?.Users.FirstOrDefault(u => u.Id == myUserId);
    var post = ViewBag.Post as HabitTrackerApp.Models.Post;
    var totalReplies = db?.CommentReplies.Count(r => Model.Select(c => c.Id).Contains(r.CommentId)) ?? 0;
}

