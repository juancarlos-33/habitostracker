@functions {
    string ResaltarMenciones(string text) {
        if (string.IsNullOrEmpty(text)) return text;
        return System.Text.RegularExpressions.Regex.Replace(
            System.Net.WebUtility.HtmlEncode(text),
            @"@@(\w+)",
            m => {
                var username = m.Groups[1].Value;
                var db2 = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>();
                var user = db2?.Users.FirstOrDefault(u => u.Username == username);
                if (user != null)
                    return "<a href='/User/Profile/" + user.Id + "' style='color:#818cf8;font-weight:700;text-decoration:none;'>@" + username + "</a>";
                return m.Value;
            }
        );
    }
}

@if (TempData["Error"] != null)
{
    <div class="cmt-alert">⚠️ @TempData["Error"]</div>
}

@model List<HabitTrackerApp.Models.PostComment>

@{
    var db = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>();
    var myUserId = int.Parse(User.FindFirst("UserId").Value);
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.cmt-page { max-width: 680px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; padding-bottom: 40px; }

.cmt-alert {
    background: rgba(251,191,36,0.1); color: #92400e;
    border: 1px solid rgba(251,191,36,0.3);
    padding: 12px 16px; border-radius: 14px;
    margin-bottom: 16px; font-size: 13px; font-weight: 600;
}

.cmt-title {
    font-size: 20px; font-weight: 800; color: #111827;
    margin-bottom: 20px; display: flex; align-items: center; gap: 8px;
}

/* FORM */
.cmt-form-card {
    background: white; border-radius: 20px; padding: 20px;
    margin-bottom: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
}
.cmt-textarea {
    width: 100%; padding: 12px 16px; border: 1.5px solid #e5e7eb;
    border-radius: 14px; font-size: 14px; resize: vertical; min-height: 80px;
    outline: none; transition: 0.2s; box-sizing: border-box;
    background: #f9fafb; color: #111827; font-family: inherit;
}
.cmt-textarea:focus { border-color: #6366f1; background: white; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
.cmt-form-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; gap: 10px; }
.cmt-file-label {
    font-size: 13px; color: #6b7280; cursor: pointer;
