</style>

<div class="cmt-page">
<div class="cmt-page-shell">

    <div class="cmt-topbar">
        <div class="cmt-title">💬 Conversación</div>
        <div class="cmt-count-pill">@Model.Count comentario@(Model.Count != 1 ? "s" : "") · @totalReplies respuesta@(totalReplies != 1 ? "s" : "")</div>
    </div>

    @if (post != null)
    {
        <div class="cmt-post-preview">
            @if (!string.IsNullOrEmpty(post.ImagePath))
            {
                <img src="@post.ImagePath" class="cmt-post-thumb" />
            }
            else
            {
                <div class="cmt-post-thumb">📝</div>
            }
            <div class="cmt-post-meta">
                <div class="cmt-post-author">@post.Username</div>
                <div class="cmt-post-desc">@(string.IsNullOrWhiteSpace(post.Description) ? "Publicación sin descripción." : post.Description)</div>
            </div>
            <a href="/Post/Index" class="cmt-post-link">Ver feed</a>
        </div>
    }

    <!-- FORM -->
   @if (ViewBag.CommentsDisabled == true)
{
    <div class="cmt-form-card" style="background: #fef2f2; border: 1px solid #fecaca;">
        <div style="display: flex; align-items: center; gap: 8px; color: #dc2626; font-weight: 600;">
            🔒 Los comentarios están deshabilitados para esta publicación por incumplimiento de las normas.
        </div>
    </div>
}
else
{
    <div class="cmt-form-card">
        <form asp-action="AddComment" method="post" enctype="multipart/form-data" data-no-loader="true">
            <input type="hidden" name="postId" value="@ViewBag.PostId" />
            <div class="cmt-composer-row">
                @if (!string.IsNullOrEmpty(currentUser?.ProfileImage ?? currentUser?.ProfilePicture))
                {
                    <img src="@(currentUser?.ProfileImage ?? currentUser?.ProfilePicture)" class="cmt-composer-avatar" />
                }
                else
                {
                    <div class="cmt-composer-letter">@((currentUser?.Username ?? "U").Substring(0,1).ToUpper())</div>
                }
                <div class="cmt-composer-main">
                    <textarea name="comment" class="cmt-textarea"
                              placeholder="Comparte tu opinión... usa arroba para mencionar"
                              required oninput="handleMentionInput(event, this)"></textarea>
                    <div class="cmt-form-bottom">
                        <label class="cmt-file-label">
                            📎 <span>Imagen</span>
                            <input type="file" name="image" accept="image/*" style="display:none;"
                                   onchange="this.parentElement.querySelector('span').textContent = this.files[0]?.name || 'Imagen'" />
                        </label>
                        <button type="submit" class="cmt-submit-btn">Publicar</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
}

    <!-- LISTA -->
    <div class="cmt-list">
        @if (!Model.Any())
        {
            <div class="cmt-empty">
                <div class="cmt-empty-icon">💭</div>
                <div class="cmt-empty-text">Sé el primero en comentar</div>
            </div>
        }
        else
        {
            foreach (var c in Model)
            {
                var replies = db.CommentReplies
                    .Where(r => r.CommentId == c.Id)
                    .OrderBy(r => r.CreatedAt)
                    .ToList();
                var parentReplies = replies.Where(x => x.ParentReplyId == null).ToList();
                bool isMine = c.UserId == myUserId;
                bool isLiked = ViewBag.MyCommentLikes != null && ((List<int>)ViewBag.MyCommentLikes).Contains(c.Id);
                int likeCount = ViewBag.CommentLikes != null && ((IDictionary<int,int>)ViewBag.CommentLikes).ContainsKey(c.Id)
                    ? ((IDictionary<int,int>)ViewBag.CommentLikes)[c.Id] : 0;

                <div class="cmt-card" id="cmt-@c.Id">
              <div class="cmt-header">
    <!-- AVATAR -->
    @if (!string.IsNullOrEmpty(c.ProfileImage))
    {
        <img src="@c.ProfileImage" class="cmt-avatar" />
    }
    else
    {
        <div class="cmt-avatar-letter">@c.Username.Substring(0,1).ToUpper()</div>
    }

    <!-- NOMBRE + BADGE + FECHA -->
    <div>
        <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
            @if (c.UserId == 29)
            { <a href="/User" class="cmt-username">@c.Username</a> }
            else
            { <a href="/User/Profile/@c.UserId" class="cmt-username">@c.Username</a> }
            
           
        </div>
   @if (c.UserId != 243)
{
    <div class="cmt-time" data-utc="@c.CreatedAt.ToString("o")" data-format="datetime"></div>
}
    </div>
</div>

                    <div class="cmt-body">
                    <p class="cmt-text">@Html.Raw(ResaltarMenciones(c.Comment))</p>
                        @if (!string.IsNullOrEmpty(c.ImagePath))
                        {
                            <img src="@c.ImagePath" class="cmt-img"
                                 onclick="window.open('@c.ImagePath', '_blank')" />
                        }
                    </div>

                  <div class="cmt-actions">
    @if (c.UserId != 243)
    {
        <button class="cmt-btn like" data-id="@c.Id" onclick="toggleCommentLike(this)">
            <span class="heart-icon">@(isLiked ? "❤️" : "🤍")</span>
            <span id="like-count-@c.Id">@likeCount</span>
        </button>
        <button class="cmt-btn reply" onclick="toggleReplyBox(@c.Id)">
            💬 Responder
        </button>
    }
    else
    {
        <span class="cmt-btn" style="opacity:0.5; cursor:not-allowed;">🔒</span>
    }
    
    @if (isMine)
    {
        <a asp-controller="Post" asp-action="DeleteComment" asp-route-id="@c.Id"
           class="cmt-btn delete">🗑 Eliminar</a>
    }
</div>

                    <div class="cmt-reply-form" id="replyBox-@c.Id">
                        <form asp-controller="Post" asp-action="ReplyComment" method="post" data-no-loader="true">
                            <input type="hidden" name="commentId" value="@c.Id" />
                            <input type="text" name="text" placeholder="Escribe tu respuesta... usa arroba"
                                   class="cmt-reply-input" required
                                   oninput="handleMentionInput(event, this)" />
                            <button type="submit" class="cmt-reply-submit">Enviar</button>
                        </form>
                    </div>

                    @if (parentReplies.Any())
                    {
                        <div class="reply-wrap">
                            @foreach (var parent in parentReplies)
                            {
                                var children = replies.Where(x => x.ParentReplyId == parent.Id).ToList();
                                bool rLiked = ViewBag.MyReplyLikes != null && ((List<int>)ViewBag.MyReplyLikes).Contains(parent.Id);
                                int rCount = ViewBag.ReplyLikes != null && ((IDictionary<int,int>)ViewBag.ReplyLikes).ContainsKey(parent.Id)
                                    ? ((IDictionary<int,int>)ViewBag.ReplyLikes)[parent.Id] : 0;

                                <div class="reply-item">
                                    <a href="/User/Profile/@parent.UserId">
                                        @if (!string.IsNullOrEmpty(parent.ProfileImage))
                                        { <img src="@parent.ProfileImage" class="reply-avatar" /> }
                                        else
                                        { <div class="reply-avatar-letter">@parent.Username.Substring(0,1).ToUpper()</div> }
                                    </a>
                                    <div class="reply-content">
                                      <div class="reply-header">
    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
        @if (parent.UserId == 29)
        { <a href="/User" class="reply-username">@parent.Username</a> }
        else
        { <a href="/User/Profile/@parent.UserId" class="reply-username">@parent.Username</a> }
        
      
    </div>
    <span class="reply-time" data-utc="@parent.CreatedAt.ToString("o")" data-format="datetime"></span>
</div>
                                        <p class="reply-text">@parent.Text</p>
                                      <div class="reply-actions">
    @if (parent.UserId != 243)
    {
        <button class="cmt-btn like" data-id="@parent.Id" onclick="toggleReplyLike(this)">
            <span class="heart-icon">@(rLiked ? "❤️" : "🤍")</span>
            <span id="reply-like-count-@parent.Id">@rCount</span>
        </button>
        <button class="cmt-btn reply" onclick="toggleReplyToReply(@parent.Id)">
            ↩️ Responder
        </button>
    }
    else
    {
        <span class="cmt-btn" style="opacity:0.5; cursor:not-allowed;">🔒 </span>
    }
</div>

                                        <div class="cmt-reply-form" id="replyToReplyBox-@parent.Id">
                                            <form asp-controller="Post" asp-action="ReplyComment" method="post" data-no-loader="true">
                                                <input type="hidden" name="commentId" value="@c.Id" />
                                                <input type="hidden" name="parentReplyId" value="@parent.Id" />
                                             <input type="text" name="text" placeholder="Responder a @(parent.Username)..."
                                                       class="cmt-reply-input" required
                                                       oninput="handleMentionInput(event, this)" />
                                                <button type="submit" class="cmt-reply-submit">Enviar</button>
                                            </form>
                                        </div>

                                        @if (children.Any())
                                        {
                                            <button class="view-replies-btn" onclick="toggleReplies(@parent.Id, this)">
                                                ▾ Ver @children.Count respuesta@(children.Count != 1 ? "s" : "")
                                            </button>
                                            <div class="replies-container" id="replies-@parent.Id">
                                                @foreach (var child in children)
                                                {
                                                    bool cLiked = ViewBag.MyReplyLikes != null && ((List<int>)ViewBag.MyReplyLikes).Contains(child.Id);
                                                    int cCount = ViewBag.ReplyLikes != null && ((IDictionary<int,int>)ViewBag.ReplyLikes).ContainsKey(child.Id)
                                                        ? ((IDictionary<int,int>)ViewBag.ReplyLikes)[child.Id] : 0;

                                                    <div class="reply-item child">
                                                        <a href="/User/Profile/@child.UserId">
                                                            @if (!string.IsNullOrEmpty(child.ProfileImage))
                                                            { <img src="@child.ProfileImage" class="reply-avatar" /> }
                                                            else
                                                            { <div class="reply-avatar-letter">@child.Username.Substring(0,1).ToUpper()</div> }
                                                        </a>
                                                        <div class="reply-content">
                                                          <div class="reply-header">
    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
        <a href="/User/Profile/@child.UserId" class="reply-username">@child.Username</a>
      
    </div>
    <span class="reply-arrow">→ @parent.Username</span>
    <span class="reply-time">@child.CreatedAt.ToString("dd MMM · HH:mm")</span>
</div>
                                                            <p class="reply-text">@child.Text</p>
                                                         <div class="reply-actions">
    @if (child.UserId != 243)
    {
        <button class="cmt-btn like" data-id="@child.Id" onclick="toggleReplyLike(this)">
            <span class="heart-icon">@(cLiked ? "❤️" : "🤍")</span>
            <span id="reply-like-count-@child.Id">@cCount</span>
        </button>
    }
    else
    {
        <span class="cmt-btn" style="opacity:0.5; cursor:not-allowed;">🔒 </span>
    }
</div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
</div>
</div>
</div>

<script>
function animateHeart(btn) {
    const icon = btn.querySelector(".heart-icon");
    if (!icon) return;
    icon.classList.remove("heart-pop");
    void icon.offsetWidth;
    icon.classList.add("heart-pop");
    setTimeout(() => icon.classList.remove("heart-pop"), 400);
}

function toggleCommentLike(el) {
    const commentId = el.getAttribute("data-id");
    fetch('/Post/ToggleCommentLike?commentId=' + commentId, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            el.querySelector(".heart-icon").textContent = data.liked ? "❤️" : "🤍";
            document.getElementById("like-count-" + commentId).textContent = data.count;
            animateHeart(el);
        });
}

async function toggleReplyLike(el) {
    const id = el.getAttribute("data-id");
    const res = await fetch('/Post/ToggleReplyLike?id=' + id, { method: "POST" });
    const data = await res.json();
    el.querySelector(".heart-icon").textContent = data.liked ? "❤️" : "🤍";
    document.getElementById("reply-like-count-" + id).textContent = data.count;
    animateHeart(el);
}

function toggleReplyBox(id) {
    const box = document.getElementById("replyBox-" + id);
    const isOpen = box.style.display === "block";
    box.style.display = isOpen ? "none" : "block";
    if (!isOpen) box.querySelector("input")?.focus();
}

function toggleReplyToReply(id) {
    const box = document.getElementById("replyToReplyBox-" + id);
    const isOpen = box.style.display === "block";
    box.style.display = isOpen ? "none" : "block";
    if (!isOpen) box.querySelector("input")?.focus();
}

function toggleReplies(id, btn) {
    const el = document.getElementById("replies-" + id);
    const isOpen = el.style.display === "flex";
    if (isOpen) {
        el.style.display = "none";
        btn.textContent = "Ver respuestas";
    } else {
        el.style.display = "flex";
        btn.textContent = "Ocultar respuestas";
    }
}

// MENCIONES
var friendsCache = null;
var _currentMentionInput = null;
var AT = String.fromCharCode(64);

async function getFriends() {
    if (friendsCache) return friendsCache;
    const res = await fetch('/User/GetFriendsForMention');
    friendsCache = await res.json();
    return friendsCache;
}

function createMentionDropdown() {
    var dropdown = document.getElementById('mention-dropdown');
    if (!dropdown) {
        dropdown = document.createElement('div');
        dropdown.id = 'mention-dropdown';
        dropdown.style.cssText = 'position:fixed;background:#1e293b;border:1px solid rgba(255,255,255,0.1);border-radius:14px;padding:6px;z-index:99999;min-width:200px;box-shadow:0 8px 32px rgba(0,0,0,0.4);display:none;max-height:200px;overflow-y:auto;';
        document.body.appendChild(dropdown);
    }
    return dropdown;
}

async function handleMentionInput(e, input) {
    _currentMentionInput = input;
    var val = input.value;
    var cursor = input.selectionStart;
    var textBeforeCursor = val.substring(0, cursor);
    var atIndex = textBeforeCursor.lastIndexOf(AT);
    var dropdown = createMentionDropdown();

    if (atIndex === -1) { dropdown.style.display = 'none'; return; }

    var afterAt = textBeforeCursor.substring(atIndex + 1);
    if (/\s/.test(afterAt)) { dropdown.style.display = 'none'; return; }

    var query = afterAt.toLowerCase();
    var friends = await getFriends();
    var filtered = friends.filter(function(f) { return f.username.toLowerCase().indexOf(query) !== -1; });

    if (!filtered.length) { dropdown.style.display = 'none'; return; }

    var rect = input.getBoundingClientRect();
    dropdown.style.left = rect.left + 'px';
    dropdown.style.top = (rect.bottom + 4) + 'px';
    dropdown.style.display = 'block';

    dropdown.innerHTML = filtered.map(function(f) {
        var avatar = f.profileImage
            ? '<img src="' + f.profileImage + '" style="width:30px;height:30px;border-radius:50%;object-fit:cover;"/>'
            : '<div style="width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;">' + f.username.charAt(0).toUpperCase() + '</div>';
        return '<div onclick="insertMention(\'' + f.username + '\')" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;cursor:pointer;" onmouseover="this.style.background=\'rgba(99,102,241,0.15)\'" onmouseout="this.style.background=\'transparent\'">'
            + avatar
            + '<span style="color:#f1f5f9;font-size:13px;font-weight:600;">' + AT + f.username + '</span>'
            + '</div>';
    }).join('');
}

function insertMention(username) {
    var input = _currentMentionInput;
    if (!input) return;
    var val = input.value;
    var cursor = input.selectionStart;
    var textBeforeCursor = val.substring(0, cursor);
    var atIndex = textBeforeCursor.lastIndexOf(AT);
    var newText = textBeforeCursor.substring(0, atIndex) + AT + username + ' ' + val.substring(cursor);
    input.value = newText;
    input.focus();
    var newCursor = atIndex + username.length + 2;
    input.setSelectionRange(newCursor, newCursor);
    document.getElementById('mention-dropdown').style.display = 'none';
}

document.addEventListener('click', function(e) {
    var dd = document.getElementById('mention-dropdown');
    if (dd && !dd.contains(e.target)) dd.style.display = 'none';
});
// resaltar comentario mencionado
document.addEventListener('DOMContentLoaded', function() {
    var params = new URLSearchParams(window.location.search);
    var highlight = params.get('highlight');
    if (highlight) {
        var el = document.getElementById('cmt-' + highlight);
        if (el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.style.transition = '0.5s';
            el.style.border = '2px solid #6366f1';
            el.style.boxShadow = '0 0 0 4px rgba(99,102,241,0.2)';
            setTimeout(() => {
                el.style.border = '';
                el.style.boxShadow = '';
            }, 3000);
        }
    }
});
</script>
