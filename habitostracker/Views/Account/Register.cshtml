@model HabitTrackerApp.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registro";
    Layout = "_LayoutLogin";
}

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:Inter,system-ui;
    background:#0d1117;
    overflow-x:hidden;
}

#plexus-bg {
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    z-index:0;
    pointer-events:none;
}

.register-wrapper {
    position:relative;
    z-index:2;
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:100vh;
    padding:30px 20px;
}

.register-card {
    width:480px;
    max-width:95%;
    padding:36px 32px;
    border-radius:22px;
    background:rgba(20,30,50,0.88);
    backdrop-filter:blur(20px);
    border:1px solid rgba(255,255,255,0.08);
    box-shadow:0 25px 60px rgba(0,0,0,0.7);
}

.register-header {
    text-align:center;
    margin-bottom:28px;
}

.register-header h2 {
    color:white;
    font-size:22px;
    font-weight:700;
    margin:0;
}

.register-header p {
    color:rgba(255,255,255,0.4);
    font-size:13px;
    margin-top:6px;
}

/* AVATAR UPLOAD */
.avatar-upload {
    display:flex;
    flex-direction:column;
    align-items:center;
    margin-bottom:24px;
}

.avatar-circle {
    width:90px;
    height:90px;
    border-radius:50%;
    background:rgba(255,255,255,0.08);
    border:2px dashed rgba(255,255,255,0.2);
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    overflow:hidden;
    transition:0.2s;
    position:relative;
}

.avatar-circle:hover {
    border-color:rgba(99,102,241,0.6);
    background:rgba(99,102,241,0.08);
}

.avatar-circle img {
    width:100%;
    height:100%;
    object-fit:cover;
    display:none;
}

.avatar-circle .avatar-placeholder {
    font-size:32px;
    transition:0.2s;
}

.avatar-label {
    margin-top:10px;
    font-size:12px;
    color:rgba(255,255,255,0.4);
    cursor:pointer;
}

.avatar-label:hover { color:rgba(99,102,241,0.8); }

/* GRID DE CAMPOS */
.fields-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    margin-bottom:14px;
}

.field-full { grid-column:1 / -1; }

.field { display:flex; flex-direction:column; gap:5px; }

.field label {
    font-size:12px;
    color:rgba(255,255,255,0.5);
    text-transform:uppercase;
    letter-spacing:0.6px;
    font-weight:600;
}

.field input,
.field select,
.field textarea {
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.1);
    border-radius:10px;
    padding:11px 14px;
    color:white;
    font-size:14px;
    transition:0.2s;
    outline:none;
    width:100%;
    font-family:Inter,system-ui;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
    background:rgba(255,255,255,0.09);
    border-color:#6366f1;
    box-shadow:0 0 0 3px rgba(99,102,241,0.15);
}

.field input::placeholder,
.field textarea::placeholder {
    color:rgba(255,255,255,0.2);
}

.field select option {
    background:#1e293b;
    color:white;
}

.field textarea { resize:vertical; min-height:80px; }

.text-danger { font-size:11px; color:#f87171; margin-top:2px; }

/* BOTÓN */
.btn-register {
    width:100%;
    padding:13px;
    border-radius:10px;
    border:none;
    background:linear-gradient(90deg,#6366f1,#2563eb);
    color:white;
    font-weight:700;
    font-size:15px;
    cursor:pointer;
    transition:0.2s;
    margin-top:6px;
    position:relative;
    overflow:hidden;
}

.btn-register::before {
    content:"";
    position:absolute;
    top:0; left:-100%;
    width:100%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.2),transparent);
    transition:0.5s;
}

.btn-register:hover::before { left:100%; }
.btn-register:hover { transform:scale(1.02); box-shadow:0 8px 20px rgba(99,102,241,0.4); }

.login-link {
    text-align:center;
    margin-top:18px;
    font-size:13px;
    color:rgba(255,255,255,0.4);
}

.login-link a {
    color:#6366f1;
    font-weight:600;
    text-decoration:none;
}

.login-link a:hover { color:#818cf8; }

.alert { border-radius:10px; font-size:13px; margin-bottom:16px; }

@@media (max-width:500px) {
    .fields-grid { grid-template-columns:1fr; }
    .field-full { grid-column:1; }
    .register-card { padding:28px 20px; }
}
</style>

<canvas id="plexus-bg"></canvas>

<div class="register-wrapper">
<div class="register-card">

    <div class="register-header">
        <h2>📝 Crear cuenta</h2>
        <p>Únete y empieza a construir hábitos increíbles</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="Register" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- AVATAR -->
        <div class="avatar-upload">
            <div class="avatar-circle" onclick="document.getElementById('imageInput').click()">
                <img id="previewImage" />
                <span class="avatar-placeholder" id="avatarPlaceholder">📷</span>
            </div>
            <span class="avatar-label" onclick="document.getElementById('imageInput').click()">
                Subir foto de perfil (opcional)
            </span>
            <input type="file" name="profilePhoto" id="imageInput" accept="image/*" style="display:none;" formnovalidate />
        </div>

        <div class="fields-grid">

            <div class="field">
                <label>Usuario</label>
                <input asp-for="Username" placeholder="Tu nombre de usuario" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="field">
                <label>Género</label>
                <select asp-for="Gender">
                    <option value="">Seleccionar</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>
                    <option value="Therian">Therian</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="field field-full">
                <label>Correo electrónico</label>
                <input asp-for="Email" placeholder="tu@correo.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="field field-full">
                <label>Contraseña</label>
                <input asp-for="Password" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

           

            <div class="field field-full">
                <label>Cuéntanos sobre ti</label>
                <textarea asp-for="Bio" placeholder="¿Qué hábitos quieres construir? ¿Qué te motiva?"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

        </div>

        <button type="submit" class="btn-register">
            🚀 Crear mi cuenta
        </button>

    </form>

    <div class="login-link">
        ¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a>
    </div>

</div>
</div>

<script>
document.getElementById("imageInput").addEventListener("change", function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(event) {
        const img = document.getElementById("previewImage");
        const placeholder = document.getElementById("avatarPlaceholder");
        img.src = event.target.result;
        img.style.display = "block";
        placeholder.style.display = "none";
    };
    reader.readAsDataURL(file);
});

// PLEXUS
const canvas = document.getElementById("plexus-bg");
const ctx = canvas.getContext("2d");

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
resize();
window.addEventListener("resize", resize);

let pts = [];
for (let i = 0; i < 80; i++) {
    pts.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
    });
}

function drawPlexus() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
            const dx = pts[i].x - pts[j].x;
            const dy = pts[i].y - pts[j].y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < 160) {
                ctx.beginPath();
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
                ctx.strokeStyle = `rgba(99,102,241,${0.2 * (1 - dist/160)})`;
                ctx.lineWidth = 0.6;
                ctx.stroke();
            }
        }
    }
    pts.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(99,102,241,0.7)";
        ctx.fill();
    });
    requestAnimationFrame(drawPlexus);
}
drawPlexus();
</script>