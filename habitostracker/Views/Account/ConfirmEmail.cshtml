@model HabitTrackerApp.Models.ConfirmEmailViewModel

@{
    ViewData["Title"] = "Confirmar correo";
    Layout = "_LayoutLogin";
}

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:Inter,system-ui;
    background:#0d1117;
    overflow:hidden;
}

#plexus-bg {
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    z-index:0;
    pointer-events:none;
}

.confirm-wrapper {
    position:relative;
    z-index:2;
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:100vh;
    padding:30px 20px;
}

.confirm-card {
    width:420px;
    max-width:95%;
    padding:36px 32px;
    border-radius:22px;
    background:rgba(20,30,50,0.88);
    backdrop-filter:blur(20px);
    border:1px solid rgba(255,255,255,0.08);
    box-shadow:0 25px 60px rgba(0,0,0,0.7);
}

.confirm-header {
    text-align:center;
    margin-bottom:28px;
}

.confirm-icon {
    font-size:44px;
    display:block;
    margin-bottom:12px;
    animation:bounce 1.2s ease;
}

@@keyframes bounce {
    0% { transform:translateY(-20px); opacity:0; }
    60% { transform:translateY(6px); }
    100% { transform:translateY(0); opacity:1; }
}

.confirm-header h2 {
    color:white;
    font-size:22px;
    font-weight:700;
    margin:0 0 8px;
}

.confirm-header p {
    color:rgba(255,255,255,0.4);
    font-size:13px;
    margin:0;
    line-height:1.5;
}

.info-box {
    display:flex;
    align-items:flex-start;
    gap:12px;
    background:rgba(16,185,129,0.08);
    border:1px solid rgba(16,185,129,0.2);
    border-radius:12px;
    padding:14px 16px;
    margin-bottom:24px;
}

.info-box-icon { font-size:18px; flex-shrink:0; }

.info-box p {
    font-size:13px;
    color:rgba(255,255,255,0.6);
    margin:0;
    line-height:1.5;
}

.field { margin-bottom:14px; }

.field label {
    display:block;
    font-size:12px;
    color:rgba(255,255,255,0.5);
    text-transform:uppercase;
    letter-spacing:0.6px;
    font-weight:600;
    margin-bottom:6px;
}

.field input {
    width:100%;
    padding:11px 14px;
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.1);
    border-radius:10px;
    color:white;
    font-size:14px;
    outline:none;
    transition:0.2s;
}

.field input[readonly] {
    opacity:0.5;
    cursor:not-allowed;
}

.field input:focus {
    background:rgba(255,255,255,0.09);
    border-color:#10b981;
    box-shadow:0 0 0 3px rgba(16,185,129,0.15);
}

.field input::placeholder { color:rgba(255,255,255,0.2); }

/* CÓDIGO OTP STYLE */
.code-input {
    font-size:22px !important;
    font-weight:800 !important;
    letter-spacing:8px !important;
    text-align:center !important;
}

.text-danger { font-size:11px; color:#f87171; margin-top:2px; display:block; }

.btn-confirm {
    width:100%;
    padding:13px;
    border-radius:10px;
    border:none;
    background:linear-gradient(90deg,#10b981,#059669);
    color:white;
    font-weight:700;
    font-size:15px;
    cursor:pointer;
    transition:0.2s;
    margin-top:6px;
    position:relative;
    overflow:hidden;
}

.btn-confirm::before {
    content:"";
    position:absolute;
    top:0; left:-100%;
    width:100%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.2),transparent);
    transition:0.5s;
}

.btn-confirm:hover::before { left:100%; }
.btn-confirm:hover { transform:scale(1.02); box-shadow:0 8px 20px rgba(16,185,129,0.4); }

.divider {
    display:flex;
    align-items:center;
    margin:16px 0;
    font-size:12px;
    color:rgba(255,255,255,0.2);
}

.divider::before,
.divider::after {
    content:"";
    flex:1;
    height:1px;
    background:rgba(255,255,255,0.08);
    margin:0 10px;
}

.btn-resend {
    width:100%;
    padding:12px;
    border-radius:10px;
    border:1px solid rgba(255,255,255,0.12);
    background:rgba(255,255,255,0.05);
    color:rgba(255,255,255,0.6);
    font-size:14px;
    font-weight:500;
    cursor:pointer;
    transition:0.2s;
}

.btn-resend:hover:not(:disabled) {
    background:rgba(255,255,255,0.1);
    color:white;
    border-color:rgba(255,255,255,0.25);
}

.btn-resend:disabled {
    opacity:0.5;
    cursor:not-allowed;
}

.timer-bar {
    height:3px;
    background:rgba(255,255,255,0.08);
    border-radius:10px;
    margin-top:10px;
    overflow:hidden;
}

.timer-fill {
    height:100%;
    background:linear-gradient(90deg,#10b981,#2563eb);
    border-radius:10px;
    transition:width 1s linear;
    width:100%;
}

.alert { border-radius:10px; font-size:13px; margin-bottom:16px; }
</style>

<canvas id="plexus-bg"></canvas>

<div class="confirm-wrapper">
<div class="confirm-card">

    <div class="confirm-header">
        <span class="confirm-icon">📧</span>
        <h2>Confirmar correo</h2>
        <p>Ingresa el código de 6 dígitos que enviamos a tu correo</p>
    </div>

    <div class="info-box">
        <span class="info-box-icon">✅</span>
        <p>Revisa tu bandeja de entrada y también la carpeta de spam si no lo encuentras.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary()
        </div>
    }

    <form asp-action="ConfirmEmail" method="post">
        @Html.AntiForgeryToken()

        <div class="field">
            <label>Correo</label>
            <input asp-for="Email" readonly />
        </div>

        <div class="field">
            <label>Código de confirmación</label>
            <input asp-for="Code"
                   type="text"
                   class="code-input"
                   placeholder="000000"
                   maxlength="6"
                   required />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-confirm">
            ✅ Confirmar cuenta
        </button>
    </form>

    <div class="divider"><span>¿No recibiste el código?</span></div>

    <form asp-action="ResendConfirmation" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@Model.Email" />
        <button id="resendBtn" type="submit" class="btn-resend" disabled>
            ⏳ Reenviar en 30s
        </button>
        <div class="timer-bar">
            <div class="timer-fill" id="timerFill"></div>
        </div>
    </form>

</div>
</div>

<script>
const resendBtn = document.getElementById("resendBtn");
const timerFill = document.getElementById("timerFill");
const total = 30;
let seconds = total;

const timer = setInterval(() => {
    seconds--;
    const pct = (seconds / total) * 100;
    timerFill.style.width = pct + "%";
    resendBtn.textContent = "⏳ Reenviar en " + seconds + "s";

    if (seconds <= 0) {
        clearInterval(timer);
        resendBtn.disabled = false;
        resendBtn.textContent = "🔁 Reenviar código";
        timerFill.style.width = "0%";
    }
}, 1000);

// PLEXUS
const canvas = document.getElementById("plexus-bg");
const ctx = canvas.getContext("2d");

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
resize();
window.addEventListener("resize", resize);

let pts = [];
for (let i = 0; i < 80; i++) {
    pts.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
    });
}

function drawPlexus() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
            const dx = pts[i].x - pts[j].x;
            const dy = pts[i].y - pts[j].y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < 160) {
                ctx.beginPath();
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
                ctx.strokeStyle = `rgba(16,185,129,${0.2 * (1 - dist/160)})`;
                ctx.lineWidth = 0.6;
                ctx.stroke();
            }
        }
    }
    pts.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(16,185,129,0.7)";
        ctx.fill();
    });
    requestAnimationFrame(drawPlexus);
}
drawPlexus();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}