@model HabitTrackerApp.Models.LoginViewModel

@{
    ViewData["Title"] = "HabitTracker Pro";
    Layout = "_LayoutLogin";
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<style>
:root {
    --ink: #03060f;
    --surface: #080d1a;
    --card: rgba(8,13,26,0.97);
    --indigo: #6366f1;
    --blue: #2563eb;
    --violet: #7c3aed;
    --muted: rgba(255,255,255,0.35);
    --faint: rgba(255,255,255,0.06);
    --border: rgba(255,255,255,0.07);
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior:smooth; }

body {
    font-family:'Plus Jakarta Sans', sans-serif;
    background:var(--ink); color:white;
    overflow-x:hidden; overflow-y:auto;
    min-height:100vh;
}

/* ════════════════════════════
   CANVAS + ORBS
════════════════════════════ */
#bg-canvas {
    position:fixed; inset:0; z-index:0; pointer-events:none;
}
.orb {
    position:fixed; border-radius:50%; filter:blur(120px);
    pointer-events:none; z-index:0; opacity:0.1;
    animation:orbDrift 12s ease-in-out infinite;
}
.orb-1 { width:700px; height:700px; background:#6366f1; top:-200px; left:-200px; animation-delay:0s; }
.orb-2 { width:500px; height:500px; background:#2563eb; bottom:-150px; right:-100px; animation-delay:5s; }
.orb-3 { width:400px; height:400px; background:#7c3aed; top:45%; left:35%; animation-delay:2.5s; }
@@keyframes orbDrift {
    0%,100%{ transform:translateY(0) scale(1); }
    50%{ transform:translateY(-50px) scale(1.08); }
}

/* ════════════════════════════
   NAVBAR
════════════════════════════ */
.nav {
    position:fixed; top:0; left:0; right:0; z-index:1000;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 52px;
    background:rgba(3,6,15,0.55);
    backdrop-filter:blur(32px) saturate(180%);
    border-bottom:1px solid var(--border);
}
.nav-brand { display:flex; align-items:center; gap:12px; text-decoration:none; }
.nav-brand-icon {
    width:40px; height:40px; border-radius:12px;
    background:linear-gradient(135deg,var(--indigo),var(--blue));
    display:flex; align-items:center; justify-content:center;
    font-size:19px; box-shadow:0 4px 20px rgba(99,102,241,0.5);
    flex-shrink:0;
}
.nav-brand-name {
    font-family:'Syne', sans-serif;
    font-size:18px; font-weight:800; color:white; letter-spacing:-0.2px;
}
.nav-brand-pill {
    font-size:10px; font-weight:700; padding:2px 9px; border-radius:20px;
    background:rgba(99,102,241,0.15); color:#818cf8;
    border:1px solid rgba(99,102,241,0.25);
}
.nav-links { display:flex; align-items:center; gap:4px; }
.nav-link {
    padding:8px 15px; border-radius:10px; font-size:13px; font-weight:600;
    text-decoration:none; color:rgba(255,255,255,0.4); transition:0.2s;
}
.nav-link:hover { color:white; background:var(--faint); }
.nav-link.cta {
    background:linear-gradient(135deg,var(--indigo),var(--blue));
    color:white; box-shadow:0 4px 16px rgba(99,102,241,0.35);
}
.nav-link.cta:hover { transform:translateY(-1px); box-shadow:0 8px 24px rgba(99,102,241,0.5); }

/* ════════════════════════════
   LAYOUT PRINCIPAL
════════════════════════════ */
.shell {
    display:flex; min-height:100vh; position:relative; z-index:1;
    padding-top:72px;
}

/* ── LEFT: SCROLL STORY ── */
.story {
    flex:1; overflow-y:auto; overflow-x:hidden;
    scroll-snap-type:y mandatory;
    height:calc(100vh - 72px);
}
.story::-webkit-scrollbar { display:none; }

/* ── RIGHT: STICKY FORM ── */
.form-col {
    width:470px; flex-shrink:0;
    position:sticky; top:72px; height:calc(100vh - 72px);
    display:flex; align-items:center; justify-content:center;
    padding:20px 40px 20px 0;
}

/* ════════════════════════════
   SECCIONES DEL STORY
════════════════════════════ */
.s {
    min-height:calc(100vh - 72px);
    display:flex; flex-direction:column; justify-content:center;
    padding:70px 80px;
    scroll-snap-align:start;
    position:relative;
}

/* INDICADOR DE SCROLL (puntos) */
.scroll-dots {
    position:fixed; right:16px; top:50%; transform:translateY(-50%);
    display:flex; flex-direction:column; gap:8px; z-index:500;
}
.scroll-dot {
    width:6px; height:6px; border-radius:50%;
    background:rgba(255,255,255,0.2); cursor:pointer; transition:0.3s;
    border:1px solid rgba(255,255,255,0.1);
}
.scroll-dot.active { background:var(--indigo); transform:scale(1.4); box-shadow:0 0 8px rgba(99,102,241,0.7); }

/* ════════════════════════════
   SECCIÓN 1 — HERO
════════════════════════════ */
.hero-eyebrow {
    display:inline-flex; align-items:center; gap:8px;
    padding:7px 16px; border-radius:30px; margin-bottom:28px;
    background:rgba(99,102,241,0.07); border:1px solid rgba(99,102,241,0.18);
    color:#a5b4fc; font-size:12px; font-weight:700; width:fit-content;
    opacity:0; transform:translateY(20px);
}
.eyebrow-dot {
    width:7px; height:7px; border-radius:50%; background:var(--indigo);
    box-shadow:0 0 10px rgba(99,102,241,1); animation:pulse 2s infinite;
}
@@keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

.hero-h {
    font-family:'Syne', sans-serif;
    font-size:68px; font-weight:800; line-height:1.04;
    letter-spacing:-2.5px; color:white; margin-bottom:22px;
}
.hero-h .line { display:block; overflow:hidden; }
.hero-h .word { display:inline-block; transform:translateY(110%); opacity:0; }
.grad {
    background:linear-gradient(135deg,#c7d2fe,#93c5fd,#6ee7b7);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    background-clip:text; background-size:200%; animation:gradShift 6s linear infinite;
}
@@keyframes gradShift { 0%{background-position:0%;} 100%{background-position:200%;} }

.hero-p {
    font-size:17px; color:var(--muted); line-height:1.85; max-width:460px;
    margin-bottom:44px; opacity:0; transform:translateY(20px);
}

.hero-kpis {
    display:flex; gap:0; width:fit-content;
    background:var(--faint); border:1px solid var(--border);
    border-radius:20px; overflow:hidden;
    opacity:0; transform:translateY(20px);
}
.kpi { padding:18px 32px; text-align:center; position:relative; }
.kpi:not(:last-child)::after {
    content:''; position:absolute; right:0; top:20%; height:60%;
    width:1px; background:var(--border);
}
.kpi-n {
    font-family:'Syne', sans-serif;
    font-size:26px; font-weight:800; color:white; display:block; margin-bottom:3px;
}
.kpi-l { font-size:10px; color:rgba(255,255,255,0.22); font-weight:700; text-transform:uppercase; letter-spacing:1.2px; }

.scroll-cue {
    display:flex; align-items:center; gap:10px; margin-top:44px;
    color:rgba(255,255,255,0.18); font-size:12px; font-weight:600;
    opacity:0; animation:fadeIn 1s ease 2s forwards;
}
@@keyframes fadeIn { to{opacity:1;} }
.scroll-cue-ring {
    width:34px; height:34px; border-radius:50%;
    border:1px solid rgba(255,255,255,0.1);
    display:flex; align-items:center; justify-content:center; font-size:14px;
    animation:bob 2s ease-in-out infinite;
}
@@keyframes bob { 0%,100%{transform:translateY(0);} 50%{transform:translateY(6px);} }

/* ════════════════════════════
   SECCIÓN 2 — FEATURES
════════════════════════════ */
.s-eyebrow {
    font-size:11px; font-weight:800; color:var(--indigo); text-transform:uppercase;
    letter-spacing:2.5px; margin-bottom:14px; opacity:0; transform:translateX(-20px);
}
.s-h {
    font-family:'Syne', sans-serif;
    font-size:44px; font-weight:800; color:white; letter-spacing:-1.5px;
    line-height:1.08; margin-bottom:14px; opacity:0; transform:translateY(30px);
}
.s-p {
    font-size:15px; color:var(--muted); line-height:1.7; max-width:420px;
    margin-bottom:40px; opacity:0; transform:translateY(20px);
}

.feat-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.feat {
    padding:22px; border-radius:20px;
    background:var(--faint); border:1px solid var(--border);
    transition:0.3s; cursor:default;
    opacity:0; transform:translateY(24px) scale(0.97);
}
.feat:hover {
    background:rgba(99,102,241,0.07); border-color:rgba(99,102,241,0.2);
    transform:translateY(-3px) scale(1) !important;
}
.feat-ico {
    width:46px; height:46px; border-radius:14px;
    display:flex; align-items:center; justify-content:center; font-size:22px;
    margin-bottom:14px; transition:0.2s;
}
.feat:hover .feat-ico { transform:scale(1.1) rotate(-6deg); }
.feat-t { font-size:14px; font-weight:800; color:white; margin-bottom:6px; }
.feat-d { font-size:12px; color:rgba(255,255,255,0.32); line-height:1.6; }

/* ════════════════════════════
   SECCIÓN 3 — SOCIAL PROOF
════════════════════════════ */
.proof-cards { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:8px; }
.proof-card {
    background:var(--faint); border:1px solid var(--border);
    border-radius:18px; padding:20px;
    opacity:0; transform:translateY(28px) scale(0.96);
}
.proof-stars { color:#fbbf24; font-size:12px; margin-bottom:10px; letter-spacing:2px; }
.proof-q { font-size:13px; color:rgba(255,255,255,0.4); line-height:1.65; margin-bottom:14px; font-style:italic; }
.proof-user { display:flex; align-items:center; gap:10px; }
.proof-av {
    width:32px; height:32px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size:12px; font-weight:800; color:white;
}
.proof-name { font-size:12px; font-weight:700; color:rgba(255,255,255,0.5); }
.proof-loc { font-size:10px; color:rgba(255,255,255,0.22); margin-top:1px; }

/* ════════════════════════════
   SECCIÓN 4 — CTA
════════════════════════════ */
.cta-h {
    font-family:'Syne', sans-serif;
    font-size:58px; font-weight:800; color:white;
    letter-spacing:-2px; line-height:1.06; margin-bottom:18px;
    opacity:0; transform:translateY(36px);
}
.cta-p {
    font-size:16px; color:var(--muted); line-height:1.7; max-width:400px;
    margin-bottom:36px; opacity:0; transform:translateY(20px);
}
.cta-btns { display:flex; gap:12px; flex-wrap:wrap; }
.cta-btn-main {
    display:inline-flex; align-items:center; gap:10px;
    padding:16px 32px; border-radius:16px;
    background:linear-gradient(135deg,var(--indigo),var(--blue));
    color:white; font-size:15px; font-weight:800;
    text-decoration:none; cursor:pointer; border:none; font-family:inherit;
    box-shadow:0 8px 30px rgba(99,102,241,0.45); transition:0.2s;
    opacity:0; transform:translateY(20px);
}
.cta-btn-main:hover { transform:translateY(-2px); box-shadow:0 14px 40px rgba(99,102,241,0.6); color:white; }
.cta-btn-sec {
    display:inline-flex; align-items:center; gap:8px;
    padding:16px 28px; border-radius:16px;
    border:1px solid var(--border); background:var(--faint);
    color:rgba(255,255,255,0.5); font-size:14px; font-weight:600;
    text-decoration:none; cursor:pointer; font-family:inherit; transition:0.2s;
    opacity:0; transform:translateY(20px);
}
.cta-btn-sec:hover { background:rgba(255,255,255,0.07); color:white; border-color:rgba(255,255,255,0.15); }

.footer-line {
    margin-top:60px; padding-top:28px; border-top:1px solid var(--border);
    font-size:12px; color:rgba(255,255,255,0.12);
    display:flex; gap:20px; flex-wrap:wrap;
}
.footer-line a { color:rgba(255,255,255,0.15); text-decoration:none; transition:0.2s; }
.footer-line a:hover { color:rgba(255,255,255,0.4); }

/* ════════════════════════════
   FORM CARD
════════════════════════════ */
.card {
    width:100%; padding:34px 30px;
    border-radius:28px;
    background:var(--card);
    backdrop-filter:blur(40px) saturate(160%);
    border:1px solid var(--border);
    box-shadow:0 40px 80px rgba(0,0,0,0.85),
               0 0 0 1px rgba(99,102,241,0.05),
               inset 0 1px 0 rgba(255,255,255,0.04);
}
.card-head { text-align:center; margin-bottom:22px; }
.mascot-wrap { position:relative; display:inline-block; margin-bottom:14px; }
.mascot {
    width:68px; height:68px; border-radius:20px; object-fit:cover;
    border:2px solid rgba(99,102,241,0.35);
    box-shadow:0 0 0 6px rgba(99,102,241,0.07), 0 10px 30px rgba(0,0,0,0.5);
    display:block; transition:transform 0.15s, filter 0.3s;
}
.mascot-ring {
    position:absolute; inset:-7px; border-radius:27px;
    border:1.5px solid rgba(99,102,241,0.18);
    animation:ringPulse 3s ease-in-out infinite;
}
@@keyframes ringPulse { 0%,100%{transform:scale(1);opacity:0.35;} 50%{transform:scale(1.05);opacity:0.8;} }
.card-title { font-family:'Syne',sans-serif; font-size:19px; font-weight:800; color:white; margin:0 0 4px; }
.card-sub { font-size:12px; color:rgba(255,255,255,0.25); margin:0; }

.g-btn {
    display:flex; align-items:center; justify-content:center; gap:10px;
    width:100%; padding:12px; background:white; border-radius:13px;
    border:none; color:#3c4043; font-weight:700; font-size:13px;
    text-decoration:none; transition:0.2s; margin-bottom:9px; font-family:inherit;
    position:relative; overflow:hidden;
}
.g-btn::before {
    content:''; position:absolute; inset:0;
    background:linear-gradient(120deg,transparent,rgba(99,102,241,0.07),transparent);
    transform:translateX(-100%); transition:0.5s;
}
.g-btn:hover::before { transform:translateX(100%); }
.g-btn:hover { background:#f1f3f4; transform:translateY(-2px); box-shadow:0 8px 24px rgba(0,0,0,0.3); }
.g-btn img { width:17px; height:17px; }

.guest-btn {
    display:flex; align-items:center; justify-content:center; gap:7px;
    width:100%; padding:11px;
    background:var(--faint); border:1px solid var(--border);
    border-radius:13px; color:rgba(255,255,255,0.38); font-size:12px; font-weight:600;
    text-decoration:none; transition:0.2s; margin-bottom:18px; font-family:inherit;
}
.guest-btn:hover { background:rgba(255,255,255,0.06); color:white; border-color:rgba(255,255,255,0.14); transform:translateY(-1px); }

.divider {
    display:flex; align-items:center; gap:10px;
    font-size:10px; color:rgba(255,255,255,0.14); font-weight:700;
    text-transform:uppercase; letter-spacing:1px; margin-bottom:18px;
}
.divider::before, .divider::after { content:''; flex:1; height:1px; background:rgba(255,255,255,0.05); }

.field { margin-bottom:13px; }
.label {
    display:block; font-size:10px; font-weight:700;
    color:rgba(255,255,255,0.25); text-transform:uppercase;
    letter-spacing:0.8px; margin-bottom:6px;
}
.input-wrap { position:relative; }
.input-ico { position:absolute; left:13px; top:50%; transform:translateY(-50%); font-size:14px; pointer-events:none; opacity:0.3; }
.inp {
    width:100%; padding:11px 13px 11px 38px; border-radius:12px;
    border:1.5px solid rgba(255,255,255,0.06);
    background:rgba(255,255,255,0.03); color:white;
    font-size:13px; outline:none; transition:0.2s; font-family:inherit; box-sizing:border-box;
}
.inp:focus { border-color:var(--indigo); background:rgba(99,102,241,0.05); box-shadow:0 0 0 3px rgba(99,102,241,0.1); }
.inp::placeholder { color:rgba(255,255,255,0.12); }
.pwd-toggle {
    position:absolute; right:12px; top:50%; transform:translateY(-50%);
    cursor:pointer; opacity:0.25; font-size:15px; background:none; border:none; color:white; transition:0.15s;
}
.pwd-toggle:hover { opacity:0.7; }
.forgot { text-align:right; margin-top:5px; }
.forgot a { font-size:11px; font-weight:600; color:#ef4444; text-decoration:none; }
.forgot a:hover { color:#fca5a5; }

.strength { display:flex; gap:3px; margin-top:5px; }
.s-bar { flex:1; height:2px; border-radius:10px; background:rgba(255,255,255,0.05); transition:0.3s; }

.submit {
    width:100%; padding:13px; border-radius:13px; border:none;
    background:linear-gradient(135deg,var(--indigo),var(--blue));
    color:white; font-weight:800; font-size:14px; cursor:pointer;
    transition:0.25s; position:relative; overflow:hidden; font-family:inherit;
    margin-top:6px; box-shadow:0 6px 22px rgba(99,102,241,0.4);
}
.submit::before {
    content:''; position:absolute; top:0; left:-100%; width:100%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.18),transparent); transition:0.6s;
}
.submit:hover::before { left:100%; }
.submit:hover { transform:translateY(-2px); box-shadow:0 12px 30px rgba(99,102,241,0.6); }

.reg-row { text-align:center; margin-top:14px; font-size:12px; color:rgba(255,255,255,0.2); }
.reg-link { color:#818cf8; font-weight:700; text-decoration:none; }
.reg-link:hover { color:#a5b4fc; }

.trust {
    display:flex; align-items:center; justify-content:center; gap:14px;
    margin-top:16px; padding-top:14px; border-top:1px solid rgba(255,255,255,0.04);
}
.trust span { font-size:10px; font-weight:600; color:rgba(255,255,255,0.17); }

.alert {
    padding:10px 13px; border-radius:11px; font-size:12px; font-weight:600;
    margin-bottom:12px; display:flex; align-items:center; gap:8px;
}
.alert.danger { background:rgba(239,68,68,0.07); border:1px solid rgba(239,68,68,0.16); color:#fca5a5; }
.alert.success { background:rgba(34,197,94,0.07); border:1px solid rgba(34,197,94,0.16); color:#86efac; }
.alert.warning { background:rgba(251,191,36,0.07); border:1px solid rgba(251,191,36,0.16); color:#fde68a; }

/* ════════════════════════════
   MÓVIL — TABS DE 3 SECCIONES
════════════════════════════ */
@@media (max-width: 960px) {
    .nav { padding:12px 18px; }
    .nav-brand-pill { display:none; }
    .nav-links .nav-link:not(.cta):not([href="/Home/Privacy"]) { display:none; }
    .nav-links .nav-link.cta { display:none; }

    .shell { flex-direction:column; padding-top:60px; }

    /* Ocultar story en móvil */
    .story { display:none; }
    .scroll-dots { display:none; }
    .form-col { display:none; }

    /* LAYOUT MÓVIL */
    .mobile-shell { display:flex; flex-direction:column; height:calc(100vh - 60px); }

    /* TABS */
    .mob-tabs {
        display:flex; background:rgba(8,13,26,0.95);
        border-bottom:1px solid var(--border);
        flex-shrink:0; overflow-x:auto; scrollbar-width:none;
    }
    .mob-tabs::-webkit-scrollbar { display:none; }
    .mob-tab {
        flex:1; padding:12px 8px; text-align:center;
        font-size:11px; font-weight:700; color:rgba(255,255,255,0.3);
        border-bottom:2px solid transparent; transition:0.2s; cursor:pointer;
        white-space:nowrap; min-width:80px; user-select:none;
    }
    .mob-tab.active { color:white; border-bottom-color:var(--indigo); }
    .mob-tab-ico { font-size:18px; display:block; margin-bottom:3px; }

    /* PANELS */
    .mob-panels { flex:1; overflow:hidden; position:relative; }
    .mob-panel {
        position:absolute; inset:0; overflow-y:auto;
        padding:24px 20px 40px;
        opacity:0; transform:translateX(30px);
        pointer-events:none; transition:opacity 0.3s, transform 0.3s;
    }
    .mob-panel.active { opacity:1; transform:translateX(0); pointer-events:all; }
    .mob-panel::-webkit-scrollbar { width:3px; }
    .mob-panel::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.1); border-radius:10px; }

    /* Estilos dentro de panels móvil */
    .mob-hero-h {
        font-family:'Syne',sans-serif; font-size:34px; font-weight:800;
        color:white; letter-spacing:-1.5px; line-height:1.08; margin-bottom:14px;
    }
    .mob-hero-p { font-size:14px; color:var(--muted); line-height:1.7; margin-bottom:24px; }
    .mob-kpis {
        display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:24px;
    }
    .mob-kpi {
        background:var(--faint); border:1px solid var(--border);
        border-radius:14px; padding:14px 10px; text-align:center;
    }
    .mob-kpi-n {
        font-family:'Syne',sans-serif; font-size:20px; font-weight:800; color:white; display:block;
    }
    .mob-kpi-l { font-size:9px; color:rgba(255,255,255,0.2); font-weight:700; text-transform:uppercase; letter-spacing:1px; }
    .mob-feat { display:flex; flex-direction:column; gap:10px; }
    .mob-feat-item {
