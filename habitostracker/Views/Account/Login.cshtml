<script>
gsap.registerPlugin(ScrollTrigger);

// ══ SCROLL DOTS PC ══
const story = document.getElementById("story");
const allDots = document.querySelectorAll(".dot");
function goSec(i) { const secs=["s1","s2","s3","s4"]; document.getElementById(secs[i])?.scrollIntoView({behavior:"smooth"}); }
story?.addEventListener("scroll",()=>{
    const idx = Math.round(story.scrollTop / story.clientHeight);
    allDots.forEach((d,i) => d.classList.toggle("on", i===idx));
});

// ══ GSAP ANIMACIONES ══
// S1 HERO
gsap.to("#htag",{opacity:1,y:0,duration:1,delay:0.4,ease:"expo.out"});
gsap.to(".hero-title .w",{y:0,opacity:1,duration:1,stagger:0.1,delay:0.7,ease:"expo.out"});
gsap.to("#hsub",{opacity:1,y:0,duration:0.9,delay:1.3,ease:"power3.out"});
gsap.to("#hkpis",{opacity:1,y:0,duration:0.8,delay:1.6,ease:"back.out(1.4)"});

// COUNTER
setTimeout(()=>{
    const el=document.getElementById("kc"); if(!el) return;
    let c=0; const t=setInterval(()=>{ c+=150; if(c>=9000){el.textContent="+9k";clearInterval(t);}else el.textContent="+"+Math.floor(c).toLocaleString(); },16);
},1800);

// S2
const st2={scrollTrigger:{trigger:"#s2",start:"top 78%",scroller:"#story"}};
gsap.to("#ftag",{opacity:1,x:0,duration:0.7,ease:"expo.out",...st2});
gsap.to("#ftit",{opacity:1,y:0,duration:0.9,delay:0.1,ease:"expo.out",...st2});
gsap.to("#fsub",{opacity:1,y:0,duration:0.7,delay:0.2,ease:"power3.out",...st2});
["#f1","#f2","#f3","#f4"].forEach((id,i)=>gsap.to(id,{opacity:1,y:0,scale:1,duration:0.6,delay:i*0.11,ease:"back.out(1.6)",scrollTrigger:{trigger:"#s2",start:"top 65%",scroller:"#story"}}));

// S3
const st3={scrollTrigger:{trigger:"#s3",start:"top 78%",scroller:"#story"}};
gsap.to("#ptag",{opacity:1,x:0,duration:0.7,ease:"expo.out",...st3});
gsap.to("#ptit",{opacity:1,y:0,duration:0.9,delay:0.1,ease:"expo.out",...st3});
["#pr1","#pr2","#pr3","#pr4"].forEach((id,i)=>gsap.to(id,{opacity:1,y:0,scale:1,duration:0.55,delay:i*0.1,ease:"back.out(1.5)",scrollTrigger:{trigger:"#s3",start:"top 65%",scroller:"#story"}}));

// S4
const st4={scrollTrigger:{trigger:"#s4",start:"top 78%",scroller:"#story"}};
gsap.to("#ctat",{opacity:1,y:0,duration:0.9,ease:"expo.out",...st4});
gsap.to("#ctas",{opacity:1,y:0,duration:0.7,delay:0.15,ease:"power3.out",...st4});
gsap.to("#ctam",{opacity:1,y:0,duration:0.7,delay:0.28,ease:"back.out(1.7)",...st4});
gsap.to("#ctag2",{opacity:1,y:0,duration:0.7,delay:0.38,ease:"back.out(1.7)",...st4});

// ══ 3D TILT FORM ══
const gc = document.getElementById("gc");
const fc = document.getElementById("fc");
if(gc && fc){
    fc.addEventListener("mousemove",e=>{
        const r=gc.getBoundingClientRect();
        const dx=(e.clientX-r.left-r.width/2)/r.width;
        const dy=(e.clientY-r.top-r.height/2)/r.height;
        gc.style.setProperty("--mx",(dx*100+50)+"%");
        gc.style.setProperty("--my",(dy*100+50)+"%");
        gsap.to(gc,{rotateY:dx*7,rotateX:-dy*5,duration:0.4,ease:"power1.out",transformPerspective:900});
    });
    fc.addEventListener("mouseleave",()=>{
        gc.style.setProperty("--mx","50%"); gc.style.setProperty("--my","50%");
        gsap.to(gc,{rotateY:0,rotateX:0,duration:0.8,ease:"elastic.out(1,0.4)"});
    });
}

