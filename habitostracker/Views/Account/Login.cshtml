@model HabitTrackerApp.Models.LoginViewModel

@{
    ViewData["Title"] = "HabitTracker Pro";
    Layout = "_LayoutLogin";
}

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
    min-height:100vh;
    font-family:'Plus Jakarta Sans',Inter,system-ui;
    background:#050a14;
    overflow-x:hidden;
}

#plexus-bg {
    position:fixed; top:0; left:0;
    width:100%; height:100%;
    z-index:0; pointer-events:none;
}

/* ── NAVBAR ── */
.ht-login-nav {
    position:fixed; top:0; left:0; right:0; z-index:100;
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 40px;
    background:rgba(5,10,20,0.7);
    backdrop-filter:blur(20px);
    border-bottom:1px solid rgba(255,255,255,0.06);
}
.ht-login-brand {
    display:flex; align-items:center; gap:12px; text-decoration:none;
}
.ht-login-brand-icon {
    width:38px; height:38px; border-radius:12px;
    background:linear-gradient(135deg,#6366f1,#2563eb);
    display:flex; align-items:center; justify-content:center;
    font-size:18px; box-shadow:0 4px 14px rgba(99,102,241,0.4);
}
.ht-login-brand-name {
    font-size:18px; font-weight:800; color:white; letter-spacing:-0.3px;
}
.ht-login-brand-badge {
    font-size:10px; font-weight:700; padding:2px 8px; border-radius:20px;
    background:rgba(99,102,241,0.2); color:#818cf8; border:1px solid rgba(99,102,241,0.3);
}
.ht-nav-links { display:flex; align-items:center; gap:8px; }
.ht-nav-link {
    padding:8px 16px; border-radius:10px; font-size:13px; font-weight:600;
    text-decoration:none; color:rgba(255,255,255,0.6); transition:0.2s;
}
.ht-nav-link:hover { color:white; background:rgba(255,255,255,0.06); }
.ht-nav-link.primary {
    background:linear-gradient(135deg,#6366f1,#2563eb);
    color:white; box-shadow:0 4px 14px rgba(99,102,241,0.35);
}
.ht-nav-link.primary:hover { transform:translateY(-1px); box-shadow:0 6px 18px rgba(99,102,241,0.45); }

/* ── LAYOUT ── */
.ht-login-layout {
    min-height:100vh; display:flex;
    position:relative; z-index:1;
    padding-top:72px;
}

/* LEFT PANEL */
.ht-login-left {
    flex:1; display:flex; flex-direction:column; justify-content:center;
    padding:60px 80px 60px 80px; max-width:620px;
}
.ht-hero-badge {
    display:inline-flex; align-items:center; gap:8px;
    padding:6px 14px; border-radius:20px;
    background:rgba(99,102,241,0.1); border:1px solid rgba(99,102,241,0.25);
    color:#818cf8; font-size:12px; font-weight:700;
    margin-bottom:24px; width:fit-content;
}
.ht-hero-badge-dot {
    width:7px; height:7px; border-radius:50%; background:#6366f1;
    animation:badgePulse 2s infinite;
}
@@keyframes badgePulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }

.ht-hero-title {
    font-size:52px; font-weight:800; color:white; line-height:1.15;
    letter-spacing:-1px; margin-bottom:20px;
}
.ht-hero-title span {
    background:linear-gradient(135deg,#6366f1,#2563eb,#06b6d4);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
}
.ht-hero-desc {
    font-size:16px; color:rgba(255,255,255,0.5); line-height:1.7;
    margin-bottom:40px; max-width:440px;
}

/* STATS */
.ht-stats { display:flex; gap:32px; margin-bottom:48px; flex-wrap:wrap; }
.ht-stat { }
.ht-stat-num { font-size:28px; font-weight:800; color:white; display:block; }
.ht-stat-label { font-size:12px; color:rgba(255,255,255,0.35); font-weight:600; text-transform:uppercase; letter-spacing:0.5px; }

/* FEATURES */
.ht-features { display:flex; flex-direction:column; gap:16px; }
.ht-feature {
    display:flex; align-items:center; gap:14px;
    padding:16px 20px; border-radius:16px;
    background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);
    transition:0.2s;
}
.ht-feature:hover { background:rgba(99,102,241,0.06); border-color:rgba(99,102,241,0.2); }
.ht-feature-icon {
    width:42px; height:42px; border-radius:12px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:20px;
}
.ht-feature-title { font-size:14px; font-weight:700; color:white; margin-bottom:2px; }
.ht-feature-desc { font-size:12px; color:rgba(255,255,255,0.4); line-height:1.5; }

/* RIGHT PANEL — FORM */
.ht-login-right {
    width:420px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    padding:40px 40px 40px 0;
}
.ht-login-card {
    width:100%; padding:36px 32px;
    border-radius:24px;
    background:rgba(15,23,42,0.9);
    backdrop-filter:blur(24px);
    border:1px solid rgba(255,255,255,0.08);
    box-shadow:0 30px 70px rgba(0,0,0,0.6), 0 0 0 1px rgba(99,102,241,0.08);
}

.ht-card-header { text-align:center; margin-bottom:28px; }
.ht-card-avatar-wrap { position:relative; display:inline-block; margin-bottom:14px; }
.ht-card-avatar {
    width:64px; height:64px; border-radius:20px; object-fit:cover;
    border:2px solid rgba(99,102,241,0.4);
    box-shadow:0 0 24px rgba(99,102,241,0.3);
    animation:mascotIn 0.6s cubic-bezier(0.34,1.56,0.64,1), glowPulse 3s infinite;
}
@@keyframes mascotIn {
    from { transform:translateY(-20px) scale(0.8); opacity:0; }
    to { transform:translateY(0) scale(1); opacity:1; }
}
@@keyframes glowPulse {
    0%,100%{ box-shadow:0 0 16px rgba(99,102,241,0.3); }
    50%{ box-shadow:0 0 28px rgba(99,102,241,0.6); }
}
.ht-card-title { font-size:20px; font-weight:800; color:white; margin:0 0 4px; }
.ht-card-sub { font-size:13px; color:rgba(255,255,255,0.35); margin:0; }

/* GOOGLE BTN */
.ht-google-btn {
    display:flex; align-items:center; justify-content:center; gap:10px;
    width:100%; padding:13px; background:white; border-radius:12px;
    border:none; color:#3c4043; font-weight:600; font-size:14px;
    text-decoration:none; transition:0.2s; margin-bottom:10px;
    font-family:inherit;
}
.ht-google-btn:hover { background:#f5f5f5; transform:translateY(-1px); box-shadow:0 6px 16px rgba(0,0,0,0.2); }
.ht-google-btn img { width:18px; }

.ht-guest-btn {
    display:flex; align-items:center; justify-content:center; gap:10px;
    width:100%; padding:12px;
    background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.12);
    border-radius:12px; color:rgba(255,255,255,0.6); font-size:13px; font-weight:600;
    text-decoration:none; transition:0.2s; margin-bottom:20px; font-family:inherit;
}
.ht-guest-btn:hover { background:rgba(255,255,255,0.08); color:white; border-color:rgba(255,255,255,0.2); }

.ht-divider {
    display:flex; align-items:center; gap:12px;
    font-size:11px; color:rgba(255,255,255,0.25);
    font-weight:600; text-transform:uppercase; letter-spacing:0.5px;
    margin-bottom:20px;
}
.ht-divider::before, .ht-divider::after {
    content:""; flex:1; height:1px; background:rgba(255,255,255,0.08);
}

/* FORM FIELDS */
.ht-field { margin-bottom:16px; }
.ht-label { display:block; font-size:12px; font-weight:700; color:rgba(255,255,255,0.45); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:7px; }
.ht-input {
    width:100%; padding:12px 14px; border-radius:12px;
    border:1.5px solid rgba(255,255,255,0.08);
    background:rgba(255,255,255,0.05); color:white;
    font-size:14px; outline:none; transition:0.2s; font-family:inherit;
    box-sizing:border-box;
}
.ht-input:focus {
    border-color:#6366f1; background:rgba(99,102,241,0.06);
    box-shadow:0 0 0 3px rgba(99,102,241,0.15);
}
.ht-input::placeholder { color:rgba(255,255,255,0.2); }

.ht-pwd-wrap { position:relative; }
.ht-pwd-toggle {
    position:absolute; right:14px; top:50%; transform:translateY(-50%);
    cursor:pointer; opacity:0.4; font-size:16px; transition:0.15s; user-select:none;
}
.ht-pwd-toggle:hover { opacity:0.9; }

.ht-forgot { display:block; text-align:right; margin-top:6px; }
.ht-forgot a { font-size:12px; font-weight:600; color:#ef4444; text-decoration:none; transition:0.2s; }
.ht-forgot a:hover { color:#f87171; }

.ht-submit-btn {
    width:100%; padding:13px; border-radius:12px; border:none;
    background:linear-gradient(135deg,#6366f1,#2563eb);
    color:white; font-weight:700; font-size:15px; cursor:pointer;
    transition:0.2s; position:relative; overflow:hidden; font-family:inherit;
    margin-top:6px;
}
.ht-submit-btn::before {
    content:""; position:absolute; top:0; left:-100%;
    width:100%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.2),transparent);
    transition:0.5s;
}
.ht-submit-btn:hover::before { left:100%; }
.ht-submit-btn:hover { transform:translateY(-1px); box-shadow:0 8px 24px rgba(99,102,241,0.5); }

.ht-register-row { text-align:center; margin-top:18px; font-size:13px; color:rgba(255,255,255,0.35); }
.ht-register-link { color:#6366f1; font-weight:700; text-decoration:none; transition:0.2s; }
.ht-register-link:hover { color:#818cf8; }

/* ALERTS */
.ht-alert {
    padding:10px 14px; border-radius:10px; font-size:13px; font-weight:600;
    margin-bottom:16px; display:flex; align-items:center; gap:8px;
}
.ht-alert.danger { background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.25); color:#f87171; }
.ht-alert.success { background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.25); color:#4ade80; }
.ht-alert.warning { background:rgba(251,191,36,0.1); border:1px solid rgba(251,191,36,0.25); color:#fbbf24; }

/* SCROLL REVEAL */
.reveal { opacity:0; transform:translateY(24px); transition:opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }

/* LOADER */
@@keyframes loginSpin { from{transform:rotate(0deg);} to{transform:rotate(360deg);} }

/* RESPONSIVE */
@@media (max-width:900px) {
    .ht-login-left { display:none; }
    .ht-login-right { width:100%; padding:24px 20px; justify-content:center; align-items:center; min-height:calc(100vh - 72px); }
    .ht-login-card { max-width:400px; }
    .ht-login-nav { padding:14px 20px; }
    .ht-nav-links .ht-nav-link:not(.primary) { display:none; }
}
</style>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<canvas id="plexus-bg"></canvas>

<!-- NAVBAR -->
<nav class="ht-login-nav">
    <a href="/" class="ht-login-brand">
        <div class="ht-login-brand-icon">🚀</div>
        <span class="ht-login-brand-name">HabitTracker</span>
        <span class="ht-login-brand-badge">Pro</span>
    </a>
    <div class="ht-nav-links">
        <a href="/Help/Index" class="ht-nav-link">Ayuda</a>
        <a href="/Account/Register" class="ht-nav-link">Registro</a>
        <a href="#form" class="ht-nav-link primary" onclick="document.querySelector('.ht-input').focus();return false;">Iniciar sesión →</a>
    </div>
</nav>

<div class="ht-login-layout">

    <!-- LEFT: HERO -->
    <div class="ht-login-left">
        <div class="ht-hero-badge reveal">
            <div class="ht-hero-badge-dot"></div>
            Lanzado — Disponible gratis
        </div>

        <h1 class="ht-hero-title reveal" style="transition-delay:0.1s;">
            Construye hábitos<br>que <span>transforman</span><br>tu vida
        </h1>

        <p class="ht-hero-desc reveal" style="transition-delay:0.2s;">
            La app de seguimiento de hábitos más completa. Conecta con amigos, comparte progreso y vence la procrastinación día a día.
        </p>

        <div class="ht-stats reveal" style="transition-delay:0.3s;">
            <div class="ht-stat">
                <span class="ht-stat-num">∞</span>
                <span class="ht-stat-label">Hábitos</span>
            </div>
            <div class="ht-stat">
                <span class="ht-stat-num">100%</span>
                <span class="ht-stat-label">Gratis</span>
            </div>
            <div class="ht-stat">
                <span class="ht-stat-num">24/7</span>
                <span class="ht-stat-label">Disponible</span>
            </div>
        </div>

        <div class="ht-features reveal" style="transition-delay:0.4s;">
            <div class="ht-feature">
                <div class="ht-feature-icon" style="background:rgba(99,102,241,0.12);">📊</div>
                <div>
                    <div class="ht-feature-title">Seguimiento inteligente</div>
                    <div class="ht-feature-desc">Visualiza tu progreso con gráficas y rachas en tiempo real.</div>
                </div>
            </div>
            <div class="ht-feature">
                <div class="ht-feature-icon" style="background:rgba(34,197,94,0.1);">👥</div>
                <div>
                    <div class="ht-feature-title">Red social de hábitos</div>
                    <div class="ht-feature-desc">Comparte logros, sigue amigos y motívate en comunidad.</div>
                </div>
            </div>
            <div class="ht-feature">
                <div class="ht-feature-icon" style="background:rgba(251,191,36,0.1);">🏆</div>
                <div>
                    <div class="ht-feature-title">Logros y recompensas</div>
                    <div class="ht-feature-desc">Desbloquea insignias y compite en el ranking global.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT: FORM -->
    <div class="ht-login-right">
        <div class="ht-login-card" id="form">

            <div class="ht-card-header">
                <div class="ht-card-avatar-wrap">
                    <img src="/images/otra.jpeg" class="ht-card-avatar" id="mascota" />
                </div>
                <div class="ht-card-title">Bienvenido de vuelta</div>
                <div class="ht-card-sub">Inicia sesión para continuar</div>
            </div>

            @if (Context.Request.Query["deleted"] == "true")
            {
                <div class="ht-alert danger">⚠️ Tu cuenta fue eliminada</div>
                <script>
                    if (window.history.replaceState) {
                        const url = new URL(window.location);
                        url.searchParams.delete("deleted");
                        window.history.replaceState({}, document.title, url.pathname);
                    }
                </script>
            }
            @if (Context.Request.Query["banned"] == "true")
            { <div class="ht-alert danger">🚫 Tu cuenta ha sido baneada</div> }
            @if (Context.Request.Query["deactivated"] == "true")
            { <div class="ht-alert warning">⚠️ Tu cuenta fue desactivada</div> }
            @if (Context.Request.Query["blocked"] == "true")
            { <div class="ht-alert danger">⚠️ El propietario bloqueó esta conexión</div> }
            @if (Context.Request.Query["ipblocked"] == "true")
            { <div class="ht-alert danger">🚫 Acceso denegado. IP bloqueada.</div> }
            @if (TempData["Success"] != null)
            { <div class="ht-alert success">✅ @TempData["Success"]</div> }
            @if (TempData["Unblocked"] != null)
            { <script>localStorage.clear(); sessionStorage.clear();</script> }
            @if (!ViewData.ModelState.IsValid)
            {
                var errorText = ViewData.ModelState.Values
                    .SelectMany(v => v.Errors)
                    .Select(e => e.ErrorMessage)
                    .FirstOrDefault();
                if (errorText != null)
                { <div class="ht-alert danger">❌ @errorText</div> }
            }

            @if (TempData["UnconfirmedEmail"] != null)
            {
                <form asp-controller="Account" asp-action="ResendConfirmation" method="post" style="margin-bottom:16px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@TempData["UnconfirmedEmail"]" />
                    <button type="submit" style="width:100%;padding:10px;border-radius:10px;border:1px solid rgba(99,102,241,0.3);background:rgba(99,102,241,0.1);color:#818cf8;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;">
                        📧 Reenviar código de confirmación
                    </button>
                </form>
            }

            <a href="/Account/ExternalLogin?provider=Google" class="ht-google-btn">
                <img src="https://developers.google.com/identity/images/g-logo.png" />
                <span>Continuar con Google</span>
            </a>

            <a href="/Account/GuestRegister" class="ht-guest-btn">
                👤 Continuar como invitado
            </a>

            <div class="ht-divider"><span>o con tu cuenta</span></div>

            <form asp-action="Login" method="post" id="loginForm">
                @Html.AntiForgeryToken()

                <div class="ht-field">
                    <label class="ht-label">Usuario</label>
                    <input asp-for="Username" class="ht-input" placeholder="Tu nombre de usuario" autocomplete="username" />
                </div>

                <div class="ht-field">
                    <label class="ht-label">Contraseña</label>
                    <div class="ht-pwd-wrap">
                        <input asp-for="Password" type="password" class="ht-input" id="passwordInput"
                               placeholder="••••••••" autocomplete="current-password" style="padding-right:44px;" />
                        <span class="ht-pwd-toggle" onclick="togglePassword()">👁️</span>
                    </div>
                    <div class="ht-forgot">
                        <a asp-controller="Account" asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
                    </div>
                </div>

                <input type="hidden" id="latInput" name="Latitude" />
                <input type="hidden" id="lonInput" name="Longitude" />

                <button type="button" class="ht-submit-btn" onclick="tryGetLocation()">
                    Entrar →
                </button>

                <div class="ht-register-row">
                    ¿No tienes cuenta?
                    <a asp-controller="Account" asp-action="Register" class="ht-register-link">Crear cuenta gratis</a>
                </div>
            </form>
        </div>
    </div>

</div>

<script>
// ── MASCOTA ──────────────────────────────
const mascota = document.getElementById("mascota");
document.addEventListener("mousemove", (e) => {
    const rect = mascota.getBoundingClientRect();
    const angle = Math.atan2(
        e.clientY - (rect.top + rect.height/2),
        e.clientX - (rect.left + rect.width/2)
    ) * 180 / Math.PI;
    mascota.style.transform = `rotate(${angle}deg)`;
});

const pwdInput = document.getElementById("passwordInput");
pwdInput.addEventListener("focus", () => {
    mascota.style.transform = "rotate(-15deg) scale(1.08)";
    mascota.style.filter = "brightness(0.6)";
});
pwdInput.addEventListener("blur", () => {
    mascota.style.filter = "brightness(1)";
});

function togglePassword() {
    const icon = document.querySelector(".ht-pwd-toggle");
    pwdInput.type = pwdInput.type === "password" ? "text" : "password";
    icon.textContent = pwdInput.type === "password" ? "👁️" : "🙈";
}

document.addEventListener("keydown", (e) => {
    if (e.key === "Enter") { e.preventDefault(); tryGetLocation(); }
});

function tryGetLocation() {
    const u = document.querySelector("input[name='Username']").value.trim();
    const p = document.querySelector("input[name='Password']").value.trim();
    if (!u || !p) return;

    const loader = document.createElement("div");
    loader.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(5,10,20,0.85);z-index:99999;display:flex;align-items:center;justify-content:center;flex-direction:column;backdrop-filter:blur(8px);";
    loader.innerHTML = `
        <img src="/images/otra.jpeg" style="width:80px;border-radius:50%;animation:loginSpin 1s linear infinite;box-shadow:0 0 24px rgba(99,102,241,0.5);" />
        <p style="color:white;margin-top:16px;font-weight:700;font-size:16px;font-family:'Plus Jakarta Sans',sans-serif;">Entrando...</p>
        <div style="width:120px;height:3px;background:rgba(255,255,255,0.1);border-radius:10px;margin-top:12px;overflow:hidden;">
            <div style="height:100%;background:linear-gradient(90deg,#6366f1,#2563eb);border-radius:10px;animation:loadBar 1.5s ease infinite;"></div>
        </div>`;
    document.body.appendChild(loader);

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (pos) => {
                document.getElementById("latInput").value = pos.coords.latitude;
                document.getElementById("lonInput").value = pos.coords.longitude;
                document.getElementById("loginForm").submit();
            },
            () => document.getElementById("loginForm").submit(),
            { timeout: 1000 }
        );
    } else {
        document.getElementById("loginForm").submit();
    }
}

// ── SCROLL REVEAL ────────────────────────
const revealEls = document.querySelectorAll(".reveal");
const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add("visible"); });
}, { threshold: 0.1 });
revealEls.forEach(el => observer.observe(el));
// trigger on load
setTimeout(() => revealEls.forEach(el => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) el.classList.add("visible");
}), 100);

// ── PLEXUS ───────────────────────────────
const canvas = document.getElementById("plexus-bg");
const ctx = canvas.getContext("2d");

function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resize();
window.addEventListener("resize", resize);

let pts = Array.from({length:110}, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    vx: (Math.random() - 0.5) * 0.35,
    vy: (Math.random() - 0.5) * 0.35,
    r: Math.random() * 1.4 + 0.6
}));

function drawPlexus() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < pts.length; i++) {
        for (let j = i+1; j < pts.length; j++) {
            const dx = pts[i].x - pts[j].x;
            const dy = pts[i].y - pts[j].y;
            const d = Math.sqrt(dx*dx + dy*dy);
            if (d < 160) {
                ctx.beginPath();
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
                ctx.strokeStyle = `rgba(99,102,241,${0.2*(1-d/160)})`;
                ctx.lineWidth = 0.5;
                ctx.stroke();
            }
        }
    }
    pts.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
        ctx.fillStyle = "rgba(99,102,241,0.6)";
        ctx.fill();
    });
    requestAnimationFrame(drawPlexus);
}
drawPlexus();
</script>

<style>
@@keyframes loadBar {
    0%{width:0%;margin-left:0;}
    50%{width:80%;}
    100%{width:0%;margin-left:100%;}
}
</style>