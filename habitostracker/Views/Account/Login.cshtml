// ── 3D FEAT
document.querySelectorAll(".feat-card").forEach(card=>{
    card.addEventListener("mousemove",e=>{
        const r=card.getBoundingClientRect();
        const dx=(e.clientX-r.left-r.width/2)/r.width;
        const dy=(e.clientY-r.top-r.height/2)/r.height;
        card.style.setProperty("--mx",(dx*100+50)+"%");
        card.style.setProperty("--my",(dy*100+50)+"%");
        gsap.to(card,{rotateY:dx*10,rotateX:-dy*7,translateZ:14,duration:0.25,ease:"power1.out",transformPerspective:600});
    });
    card.addEventListener("mouseleave",()=>{
        card.style.setProperty("--mx","50%");card.style.setProperty("--my","50%");
        gsap.to(card,{rotateY:0,rotateX:0,translateZ:0,duration:0.6,ease:"elastic.out(1,0.4)"});
    });
});

