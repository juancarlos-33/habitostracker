@model HabitTrackerApp.Models.LoginViewModel

@{
    ViewData["Title"] = "HabitTracker Pro";
    Layout = "_LayoutLogin";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">

<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

body {
    font-family:'Plus Jakarta Sans',sans-serif;
    background:#030712; color:white;
    overflow-x:hidden;
}

/* ── CANVAS ── */
#plexus-bg {
    position:fixed; top:0; left:0;
    width:100%; height:100%; z-index:0; pointer-events:none;
}

/* ── ORBS ── */
.orb {
    position:fixed; border-radius:50%; filter:blur(100px);
    pointer-events:none; z-index:0; opacity:0.12;
    animation:orbFloat 10s ease-in-out infinite;
}
.orb-1 { width:600px; height:600px; background:#6366f1; top:-200px; left:-200px; }
.orb-2 { width:500px; height:500px; background:#2563eb; bottom:-100px; right:-100px; animation-delay:4s; }
.orb-3 { width:350px; height:350px; background:#7c3aed; top:50%; left:40%; animation-delay:2s; }
@@keyframes orbFloat { 0%,100%{transform:translateY(0) scale(1);} 50%{transform:translateY(-40px) scale(1.06);} }

/* ── NAVBAR ── */
.ht-login-nav {
    position:fixed; top:0; left:0; right:0; z-index:1000;
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 48px;
    background:rgba(3,7,18,0.5);
    backdrop-filter:blur(28px);
    border-bottom:1px solid rgba(255,255,255,0.04);
}
.ht-login-brand { display:flex; align-items:center; gap:12px; text-decoration:none; }
.ht-login-brand-icon {
    width:40px; height:40px; border-radius:13px;
    background:linear-gradient(135deg,#6366f1,#2563eb);
    display:flex; align-items:center; justify-content:center;
    font-size:19px; box-shadow:0 4px 20px rgba(99,102,241,0.5);
}
.ht-login-brand-name { font-size:18px; font-weight:800; color:white; letter-spacing:-0.3px; }
.ht-login-brand-badge {
    font-size:10px; font-weight:700; padding:2px 9px; border-radius:20px;
    background:rgba(99,102,241,0.18); color:#818cf8; border:1px solid rgba(99,102,241,0.3);
}
.ht-nav-links { display:flex; align-items:center; gap:6px; }
.ht-nav-link {
    padding:8px 16px; border-radius:10px; font-size:13px; font-weight:600;
    text-decoration:none; color:rgba(255,255,255,0.45); transition:0.2s;
}
.ht-nav-link:hover { color:white; background:rgba(255,255,255,0.06); }
.ht-nav-link.primary {
    background:linear-gradient(135deg,#6366f1,#2563eb);
    color:white; box-shadow:0 4px 14px rgba(99,102,241,0.35);
}
.ht-nav-link.primary:hover { transform:translateY(-1px); box-shadow:0 8px 22px rgba(99,102,241,0.5); }

/* ══════════════════════════════════════
   LAYOUT PRINCIPAL
══════════════════════════════════════ */
.login-shell {
    display:flex; min-height:100vh; position:relative; z-index:1;
}

/* ── LEFT: SCROLL SECTIONS ── */
.login-left {
    flex:1; padding-top:80px;
    overflow-y:auto; overflow-x:hidden;
}

/* ── RIGHT: STICKY FORM ── */
.login-right {
    width:460px; flex-shrink:0;
    position:sticky; top:0; height:100vh;
    display:flex; align-items:center; justify-content:center;
    padding:24px 40px 24px 0;
}

/* ══════════════════════════════════════
   SECCIONES LEFT
══════════════════════════════════════ */
.ls-section {
    min-height:100vh; display:flex; flex-direction:column;
    justify-content:center; padding:60px 80px;
    position:relative;
}

/* SECCIÓN 1 — HERO */
.ls-badge {
    display:inline-flex; align-items:center; gap:8px;
    padding:8px 18px; border-radius:30px; margin-bottom:32px; width:fit-content;
    background:rgba(99,102,241,0.08); border:1px solid rgba(99,102,241,0.2);
    color:#a5b4fc; font-size:12px; font-weight:700;
    opacity:0; transform:translateY(20px);
}
.ls-badge-dot {
    width:8px; height:8px; border-radius:50%; background:#6366f1;
    box-shadow:0 0 10px rgba(99,102,241,0.9);
    animation:dotPulse 2s infinite;
}
@@keyframes dotPulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

.ls-title {
    font-size:62px; font-weight:900; line-height:1.08;
    letter-spacing:-2px; margin-bottom:24px; color:white;
    overflow:hidden;
}
.ls-title .line { display:block; overflow:hidden; }
.ls-title .word { display:inline-block; transform:translateY(100%); opacity:0; }
.ls-title .gradient-word {
    background:linear-gradient(135deg,#818cf8,#60a5fa,#34d399);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    background-clip:text; background-size:200% auto;
    animation:gradientShift 5s linear infinite;
}
@@keyframes gradientShift { 0%{background-position:0% center;} 100%{background-position:200% center;} }

.ls-desc {
    font-size:17px; color:rgba(255,255,255,0.4); line-height:1.8;
    max-width:480px; margin-bottom:48px;
    opacity:0; transform:translateY(24px);
}

/* STATS ROW */
.ls-stats {
    display:flex; gap:0; width:fit-content;
    background:rgba(255,255,255,0.025);
    border:1px solid rgba(255,255,255,0.06);
    border-radius:22px; overflow:hidden;
    opacity:0; transform:translateY(24px);
}
.ls-stat { padding:20px 36px; text-align:center; position:relative; }
.ls-stat:not(:last-child)::after {
    content:""; position:absolute; right:0; top:20%; height:60%;
    width:1px; background:rgba(255,255,255,0.06);
}
.ls-stat-num { font-size:28px; font-weight:900; color:white; display:block; line-height:1; margin-bottom:4px; }
.ls-stat-label { font-size:11px; color:rgba(255,255,255,0.25); font-weight:700; text-transform:uppercase; letter-spacing:1px; }

/* SCROLL HINT */
.ls-scroll-hint {
    display:flex; align-items:center; gap:10px;
    margin-top:48px; color:rgba(255,255,255,0.2);
    font-size:12px; font-weight:600;
    opacity:0; animation:hintFade 2s ease 2s forwards;
}
@@keyframes hintFade { to{opacity:1;} }
.ls-scroll-arrow {
    width:32px; height:32px; border-radius:50%;
    border:1px solid rgba(255,255,255,0.1);
    display:flex; align-items:center; justify-content:center;
    font-size:14px; animation:bounceDown 2s ease-in-out infinite;
}
@@keyframes bounceDown { 0%,100%{transform:translateY(0);} 50%{transform:translateY(5px);} }

/* SECCIÓN 2 — FEATURES */
.ls-section-label {
    font-size:11px; font-weight:800; color:#6366f1;
    text-transform:uppercase; letter-spacing:2px;
    margin-bottom:16px; opacity:0; transform:translateX(-20px);
}
.ls-section-title {
    font-size:42px; font-weight:900; color:white;
    letter-spacing:-1.5px; line-height:1.1; margin-bottom:16px;
    opacity:0; transform:translateY(30px);
}
.ls-section-sub {
    font-size:15px; color:rgba(255,255,255,0.35); line-height:1.7;
    max-width:420px; margin-bottom:48px;
    opacity:0; transform:translateY(20px);
}

.ls-features { display:flex; flex-direction:column; gap:16px; }
.ls-feature {
    display:flex; align-items:flex-start; gap:18px;
    padding:22px 24px; border-radius:20px;
    background:rgba(255,255,255,0.02);
    border:1px solid rgba(255,255,255,0.05);
    transition:0.3s; cursor:default;
    opacity:0; transform:translateX(-40px);
}
.ls-feature:hover {
    background:rgba(99,102,241,0.06);
    border-color:rgba(99,102,241,0.18);
    transform:translateX(6px) !important;
}
.ls-feature-icon {
    width:50px; height:50px; border-radius:15px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:24px;
    transition:0.2s;
}
.ls-feature:hover .ls-feature-icon { transform:scale(1.1) rotate(-5deg); }
.ls-feature-title { font-size:15px; font-weight:800; color:white; margin-bottom:4px; }
.ls-feature-desc { font-size:13px; color:rgba(255,255,255,0.35); line-height:1.6; }

/* SECCIÓN 3 — SOCIAL PROOF */
.ls-proof-grid {
    display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:16px;
}
.ls-proof-card {
    background:rgba(255,255,255,0.025); border:1px solid rgba(255,255,255,0.05);
    border-radius:18px; padding:20px 22px;
    opacity:0; transform:translateY(30px) scale(0.95);
}
.ls-proof-stars { color:#fbbf24; font-size:13px; margin-bottom:10px; }
.ls-proof-text { font-size:13px; color:rgba(255,255,255,0.45); line-height:1.6; margin-bottom:14px; }
.ls-proof-user { display:flex; align-items:center; gap:10px; }
.ls-proof-avatar {
    width:34px; height:34px; border-radius:50%;
    background:linear-gradient(135deg,#6366f1,#2563eb);
    display:flex; align-items:center; justify-content:center;
    font-size:13px; font-weight:800; color:white;
}
.ls-proof-name { font-size:12px; font-weight:700; color:rgba(255,255,255,0.6); }

/* SECCIÓN 4 — CTA FINAL */
.ls-cta-big {
    font-size:56px; font-weight:900; color:white;
    letter-spacing:-2px; line-height:1.08; margin-bottom:20px;
    opacity:0; transform:translateY(40px);
}
.ls-cta-sub {
    font-size:16px; color:rgba(255,255,255,0.35); line-height:1.7;
    max-width:420px; margin-bottom:36px;
    opacity:0; transform:translateY(20px);
}
.ls-cta-btn {
    display:inline-flex; align-items:center; gap:10px;
    padding:16px 32px; border-radius:16px;
    background:linear-gradient(135deg,#6366f1,#2563eb);
    color:white; font-size:15px; font-weight:800;
    text-decoration:none; cursor:pointer; border:none; font-family:inherit;
    box-shadow:0 8px 28px rgba(99,102,241,0.45);
    transition:0.2s; opacity:0; transform:translateY(20px);
}
.ls-cta-btn:hover { transform:translateY(-2px); box-shadow:0 14px 36px rgba(99,102,241,0.6); color:white; }

/* ══════════════════════════════════════
   FORM CARD
══════════════════════════════════════ */
.ht-login-card {
    width:100%; padding:36px 32px;
    border-radius:28px;
    background:rgba(10,16,30,0.96);
    backdrop-filter:blur(40px);
    border:1px solid rgba(255,255,255,0.07);
    box-shadow:0 40px 80px rgba(0,0,0,0.8),
               inset 0 1px 0 rgba(255,255,255,0.05);
}
.ht-card-header { text-align:center; margin-bottom:24px; }
.ht-card-avatar-wrap { position:relative; display:inline-block; margin-bottom:16px; }
.ht-card-avatar {
    width:72px; height:72px; border-radius:22px; object-fit:cover;
    border:2px solid rgba(99,102,241,0.4);
    box-shadow:0 0 0 6px rgba(99,102,241,0.08), 0 8px 28px rgba(0,0,0,0.5);
    transition:transform 0.15s, filter 0.3s; display:block;
}
.ht-card-avatar-ring {
    position:absolute; inset:-6px; border-radius:28px;
    border:1.5px solid rgba(99,102,241,0.2);
    animation:ringPulse 3s ease-in-out infinite;
}
@@keyframes ringPulse { 0%,100%{transform:scale(1);opacity:0.4;} 50%{transform:scale(1.05);opacity:0.9;} }
.ht-card-title { font-size:20px; font-weight:800; color:white; margin:0 0 5px; }
.ht-card-sub { font-size:13px; color:rgba(255,255,255,0.28); margin:0; }

.ht-google-btn {
    display:flex; align-items:center; justify-content:center; gap:10px;
    width:100%; padding:13px; background:white; border-radius:14px;
    border:none; color:#3c4043; font-weight:700; font-size:14px;
    text-decoration:none; transition:0.2s; margin-bottom:10px; font-family:inherit;
    position:relative; overflow:hidden;
}
.ht-google-btn::before {
    content:""; position:absolute; inset:0;
    background:linear-gradient(120deg,transparent,rgba(99,102,241,0.06),transparent);
    transform:translateX(-100%); transition:0.5s;
}
.ht-google-btn:hover::before { transform:translateX(100%); }
.ht-google-btn:hover { background:#f1f3f4; transform:translateY(-2px); box-shadow:0 8px 22px rgba(0,0,0,0.3); }
.ht-google-btn img { width:18px; height:18px; }

.ht-guest-btn {
    display:flex; align-items:center; justify-content:center; gap:8px;
    width:100%; padding:12px;
    background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);
    border-radius:14px; color:rgba(255,255,255,0.45); font-size:13px; font-weight:600;
    text-decoration:none; transition:0.2s; margin-bottom:20px; font-family:inherit;
}
.ht-guest-btn:hover { background:rgba(255,255,255,0.06); color:white; border-color:rgba(255,255,255,0.15); transform:translateY(-1px); }

.ht-divider {
    display:flex; align-items:center; gap:10px;
    font-size:11px; color:rgba(255,255,255,0.15);
    font-weight:700; text-transform:uppercase; letter-spacing:1px;
    margin-bottom:20px;
}
.ht-divider::before, .ht-divider::after { content:""; flex:1; height:1px; background:rgba(255,255,255,0.05); }

.ht-field { margin-bottom:14px; }
.ht-label { display:block; font-size:11px; font-weight:700; color:rgba(255,255,255,0.3); text-transform:uppercase; letter-spacing:0.7px; margin-bottom:7px; }
.ht-input-wrap { position:relative; }
.ht-input-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); font-size:15px; pointer-events:none; opacity:0.35; }
.ht-input {
    width:100%; padding:12px 14px 12px 40px; border-radius:13px;
    border:1.5px solid rgba(255,255,255,0.07);
    background:rgba(255,255,255,0.03); color:white;
    font-size:14px; outline:none; transition:0.2s; font-family:inherit; box-sizing:border-box;
}
.ht-input:focus { border-color:#6366f1; background:rgba(99,102,241,0.05); box-shadow:0 0 0 3px rgba(99,102,241,0.12); }
.ht-input::placeholder { color:rgba(255,255,255,0.15); }
.ht-pwd-toggle {
    position:absolute; right:14px; top:50%; transform:translateY(-50%);
    cursor:pointer; opacity:0.3; font-size:16px; background:none; border:none; color:white; transition:0.15s;
}
.ht-pwd-toggle:hover { opacity:0.8; }
.ht-forgot { text-align:right; margin-top:6px; }
.ht-forgot a { font-size:12px; font-weight:600; color:#ef4444; text-decoration:none; }
.ht-forgot a:hover { color:#fca5a5; }

.ht-strength { display:flex; gap:4px; margin-top:6px; }
.ht-strength-bar { flex:1; height:3px; border-radius:10px; background:rgba(255,255,255,0.06); transition:0.3s; }

.ht-submit-btn {
    width:100%; padding:14px; border-radius:14px; border:none;
    background:linear-gradient(135deg,#6366f1,#2563eb);
    color:white; font-weight:800; font-size:15px; cursor:pointer;
    transition:0.25s; position:relative; overflow:hidden; font-family:inherit;
    margin-top:8px; box-shadow:0 6px 22px rgba(99,102,241,0.45);
}
.ht-submit-btn::before {
    content:""; position:absolute; top:0; left:-100%; width:100%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.2),transparent); transition:0.6s;
}
.ht-submit-btn:hover::before { left:100%; }
.ht-submit-btn:hover { transform:translateY(-2px); box-shadow:0 12px 30px rgba(99,102,241,0.6); }

.ht-register-row { text-align:center; margin-top:16px; font-size:13px; color:rgba(255,255,255,0.25); }
.ht-register-link { color:#818cf8; font-weight:700; text-decoration:none; }
.ht-register-link:hover { color:#a5b4fc; }

.ht-trust {
    display:flex; align-items:center; justify-content:center; gap:16px;
    margin-top:18px; padding-top:16px; border-top:1px solid rgba(255,255,255,0.04);
}
.ht-trust-item { font-size:11px; font-weight:600; color:rgba(255,255,255,0.2); }

.ht-alert {
    padding:11px 14px; border-radius:12px; font-size:13px; font-weight:600;
    margin-bottom:14px; display:flex; align-items:center; gap:8px;
}
.ht-alert.danger { background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.18); color:#fca5a5; }
.ht-alert.success { background:rgba(34,197,94,0.08); border:1px solid rgba(34,197,94,0.18); color:#86efac; }
.ht-alert.warning { background:rgba(251,191,36,0.08); border:1px solid rgba(251,191,36,0.18); color:#fde68a; }

/* ══════════════════════════════════════
   RESPONSIVE MÓVIL
══════════════════════════════════════ */
@@media (max-width:960px) {
    .login-shell { flex-direction:column; }
    .login-left { padding-top:72px; overflow-y:visible; }
    .login-right { width:100%; position:relative; height:auto; padding:0 16px 48px; }
    .ls-section { min-height:auto; padding:60px 20px; }
    .ls-title { font-size:36px; }
    .ls-cta-big { font-size:34px; }
    .ls-section-title { font-size:28px; }
    .ls-proof-grid { grid-template-columns:1fr; }
    .ls-stats { width:100%; }
    .ls-stat { flex:1; padding:16px; }
    .ht-login-nav { padding:12px 20px; }
    .ht-nav-links .ht-nav-link:not(.primary):not([href="/Home/Privacy"]) { display:none; }
    .ht-login-brand-badge { display:none; }
}
</style>

<canvas id="plexus-bg"></canvas>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>

<!-- NAVBAR -->
<nav class="ht-login-nav">
    <a href="/" class="ht-login-brand">
        <div class="ht-login-brand-icon">🚀</div>
        <span class="ht-login-brand-name">HabitTracker</span>
        <span class="ht-login-brand-badge">Pro</span>
    </a>
    <div class="ht-nav-links">
        <a href="/Help/Index" class="ht-nav-link">Ayuda</a>
        <a href="/Home/Privacy" target="_blank" class="ht-nav-link">🔐 Privacidad</a>
        <a href="/Account/Register" class="ht-nav-link">Registro</a>
        <a href="#" class="ht-nav-link primary" onclick="document.getElementById('usernameInput').focus();return false;">
            Iniciar sesión →
        </a>
    </div>
</nav>

<div class="login-shell">

    <!-- ══ LEFT: SCROLL STORY ══ -->
    <div class="login-left" id="loginLeft">

        <!-- SECCIÓN 1: HERO -->
        <section class="ls-section" id="sec1">
            <div class="ls-badge" id="heroBadge">
                <div class="ls-badge-dot"></div>
                Disponible gratis · Sin tarjeta de crédito
            </div>
            <h1 class="ls-title" id="heroTitle">
                <span class="line"><span class="word">Construye</span> <span class="word">hábitos</span></span>
                <span class="line"><span class="word gradient-word">que transforman</span></span>
                <span class="line"><span class="word">tu</span> <span class="word">vida.</span></span>
            </h1>
            <p class="ls-desc" id="heroDesc">
                La plataforma de hábitos más completa. Conecta con personas, comparte tu progreso y construye la mejor versión de ti mismo, día a día.
            </p>
            <div class="ls-stats" id="heroStats">
                <div class="ls-stat">
                    <span class="ls-stat-num" data-count="9000">0</span>
                    <span class="ls-stat-label">Usuarios</span>
                </div>
                <div class="ls-stat">
                    <span class="ls-stat-num">∞</span>
                    <span class="ls-stat-label">Hábitos</span>
                </div>
                <div class="ls-stat">
                    <span class="ls-stat-num">24/7</span>
                    <span class="ls-stat-label">Disponible</span>
                </div>
            </div>
            <div class="ls-scroll-hint">
                <div class="ls-scroll-arrow">↓</div>
                Desliza para descubrir más
            </div>
        </section>

        <!-- SECCIÓN 2: FEATURES -->
        <section class="ls-section" id="sec2">
            <div class="ls-section-label" id="feat-label">Lo que obtienes</div>
            <div class="ls-section-title" id="feat-title">Todo lo que necesitas<br>en un solo lugar</div>
            <div class="ls-section-sub" id="feat-sub">Herramientas diseñadas para construir hábitos reales con resultados reales.</div>
            <div class="ls-features">
                <div class="ls-feature" id="feat1">
                    <div class="ls-feature-icon" style="background:rgba(99,102,241,0.1);">📊</div>
                    <div>
                        <div class="ls-feature-title">Seguimiento inteligente</div>
                        <div class="ls-feature-desc">Gráficas, rachas y estadísticas avanzadas de tus últimos 90 días. Visualiza tu progreso real.</div>
                    </div>
                </div>
                <div class="ls-feature" id="feat2">
                    <div class="ls-feature-icon" style="background:rgba(34,197,94,0.1);">👥</div>
                    <div>
                        <div class="ls-feature-title">Red social de hábitos</div>
                        <div class="ls-feature-desc">Comparte logros, sigue amigos, reacciona a su progreso. La motivación colectiva funciona.</div>
                    </div>
                </div>
                <div class="ls-feature" id="feat3">
                    <div class="ls-feature-icon" style="background:rgba(251,191,36,0.1);">🏆</div>
                    <div>
                        <div class="ls-feature-title">Logros y badges</div>
                        <div class="ls-feature-desc">Desbloquea insignias por cada hito. 7 días, 30 días, 100 días. Tu disciplina tiene recompensa.</div>
                    </div>
                </div>
                <div class="ls-feature" id="feat4">
                    <div class="ls-feature-icon" style="background:rgba(239,68,68,0.1);">💬</div>
                    <div>
                        <div class="ls-feature-title">Chat grupal en tiempo real</div>
                        <div class="ls-feature-desc">Grupos de hábitos con chat, reacciones, respuestas y notificaciones. Accountability real.</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 3: SOCIAL PROOF -->
        <section class="ls-section" id="sec3">
            <div class="ls-section-label" id="proof-label">Testimonios</div>
            <div class="ls-section-title" id="proof-title">Miles ya<br>cambiaron sus hábitos</div>
            <div class="ls-proof-grid">
                <div class="ls-proof-card" id="proof1">
                    <div class="ls-proof-stars">★★★★★</div>
                    <div class="ls-proof-text">"Llevo 47 días consecutivos con mi rutina de ejercicio. Nunca había logrado tanto."</div>
                    <div class="ls-proof-user">
                        <div class="ls-proof-avatar">A</div>
                        <div class="ls-proof-name">Andrés M. · Colombia</div>
                    </div>
                </div>
                <div class="ls-proof-card" id="proof2">
                    <div class="ls-proof-stars">★★★★★</div>
                    <div class="ls-proof-text">"El chat de grupos me hace sentir que no estoy solo en esto. Es increíble."</div>
                    <div class="ls-proof-user">
                        <div class="ls-proof-avatar">S</div>
                        <div class="ls-proof-name">Sara L. · México</div>
                    </div>
                </div>
                <div class="ls-proof-card" id="proof3">
                    <div class="ls-proof-stars">★★★★★</div>
                    <div class="ls-proof-text">"Las estadísticas premium me ayudan a entender cuándo soy más productivo."</div>
                    <div class="ls-proof-user">
                        <div class="ls-proof-avatar">C</div>
                        <div class="ls-proof-name">Carlos R. · España</div>
                    </div>
                </div>
                <div class="ls-proof-card" id="proof4">
                    <div class="ls-proof-stars">★★★★★</div>
                    <div class="ls-proof-text">"Logré mi récord de 100 días. El badge fue la mejor motivación que tuve."</div>
                    <div class="ls-proof-user">
                        <div class="ls-proof-avatar">V</div>
                        <div class="ls-proof-name">Valentina G. · Argentina</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 4: CTA FINAL -->
        <section class="ls-section" id="sec4">
            <div class="ls-cta-big" id="cta-title">¿Listo para<br><span class="gradient-word">empezar hoy?</span></div>
            <div class="ls-cta-sub" id="cta-sub">Únete gratis en menos de un minuto. Sin tarjeta, sin compromisos. Solo tus hábitos y tú.</div>
            <button class="ls-cta-btn" id="cta-btn" onclick="document.getElementById('usernameInput').focus()">
                🚀 Crear cuenta gratis →
            </button>
            <div style="margin-top:60px;padding-top:32px;border-top:1px solid rgba(255,255,255,0.04);font-size:12px;color:rgba(255,255,255,0.15);text-align:center;">
                <a href="/Home/Privacy" style="color:rgba(255,255,255,0.2);text-decoration:none;">🔐 Política de Privacidad</a>
                · HabitTracker Pro © @DateTime.Now.Year
            </div>
        </section>

    </div>

    <!-- ══ RIGHT: FORM ══ -->
    <div class="login-right">
        <div class="ht-login-card" id="form">
            <div class="ht-card-header">
                <div class="ht-card-avatar-wrap">
                    <div class="ht-card-avatar-ring"></div>
                    <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg"
                         class="ht-card-avatar" id="mascota" />
                </div>
                <div class="ht-card-title">Bienvenido :)</div>
                <div class="ht-card-sub">Inicia sesión para continuar</div>
            </div>

            @if (Context.Request.Query["deleted"] == "true")
            {
                <div class="ht-alert danger">⚠️ Tu cuenta fue eliminada</div>
                <script>
                    const url = new URL(window.location);
                    url.searchParams.delete("deleted");
                    window.history.replaceState({}, document.title, url.pathname);
                </script>
            }
            @if (Context.Request.Query["banned"] == "true")
            { <div class="ht-alert danger">🚫 Tu cuenta ha sido baneada</div> }
            @if (Context.Request.Query["deactivated"] == "true")
            { <div class="ht-alert warning">⚠️ Tu cuenta fue desactivada</div> }
            @if (Context.Request.Query["blocked"] == "true")
            { <div class="ht-alert danger">🔌 El propietario bloqueó esta conexión</div> }
            @if (Context.Request.Query["ipblocked"] == "true")
            { <div class="ht-alert danger">🚫 Acceso denegado. IP bloqueada.</div> }
            @if (TempData["Success"] != null)
            { <div class="ht-alert success">✅ @TempData["Success"]</div> }
            @if (TempData["Unblocked"] != null)
            { <script>localStorage.clear(); sessionStorage.clear();</script> }
            @if (!ViewData.ModelState.IsValid)
            {
                var errorText = ViewData.ModelState.Values
                    .SelectMany(v => v.Errors).Select(e => e.ErrorMessage).FirstOrDefault();
                if (errorText != null)
                { <div class="ht-alert danger">❌ @errorText</div> }
            }
            @if (TempData["UnconfirmedEmail"] != null)
            {
                <form asp-controller="Account" asp-action="ResendConfirmation" method="post" style="margin-bottom:14px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@TempData["UnconfirmedEmail"]" />
                    <button type="submit" style="width:100%;padding:10px;border-radius:12px;border:1px solid rgba(99,102,241,0.3);background:rgba(99,102,241,0.07);color:#818cf8;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;">
                        📧 Reenviar código de confirmación
                    </button>
                </form>
            }

            <a href="/Account/ExternalLogin?provider=Google" class="ht-google-btn">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="G" />
                <span>Continuar con Google</span>
            </a>
            <a href="/Account/GuestRegister" class="ht-guest-btn">👤 Continuar como invitado</a>

            <div class="ht-divider"><span>o con tu cuenta</span></div>

            <form asp-action="Login" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <div class="ht-field">
                    <label class="ht-label">Usuario</label>
                    <div class="ht-input-wrap">
                        <input asp-for="Username" class="ht-input" id="usernameInput"
                               placeholder="Tu nombre de usuario" autocomplete="username"
                               oninput="onUsernameInput(this)" />
                        <span class="ht-input-icon">👤</span>
                    </div>
                </div>
                <div class="ht-field">
                    <label class="ht-label">Contraseña</label>
                    <div class="ht-input-wrap">
                        <input asp-for="Password" type="password" class="ht-input"
                               id="passwordInput" placeholder="••••••••"
                               autocomplete="current-password" style="padding-right:44px;"
                               oninput="onPasswordInput(this)" />
                        <span class="ht-input-icon">🔒</span>
                        <button type="button" class="ht-pwd-toggle" onclick="togglePassword()">👁️</button>
                    </div>
                    <div class="ht-strength">
                        <div class="ht-strength-bar" id="sb1"></div>
                        <div class="ht-strength-bar" id="sb2"></div>
                        <div class="ht-strength-bar" id="sb3"></div>
                        <div class="ht-strength-bar" id="sb4"></div>
                    </div>
                    <div class="ht-forgot">
                        <a asp-controller="Account" asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
                    </div>
                </div>
                <input type="hidden" id="latInput" name="Latitude" />
                <input type="hidden" id="lonInput" name="Longitude" />
                <button type="button" class="ht-submit-btn" onclick="tryGetLocation()">Entrar →</button>
                <div class="ht-register-row">
                    ¿No tienes cuenta?
                    <a asp-controller="Account" asp-action="Register" class="ht-register-link">Crear cuenta gratis</a>
                </div>
            </form>

            <div class="ht-trust">
                <div class="ht-trust-item">🔒 SSL</div>
                <div class="ht-trust-item">🛡️ Sin spam</div>
                <div class="ht-trust-item">✨ Gratis</div>
            </div>
        </div>
    </div>

</div>

<!-- GSAP CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<script>
gsap.registerPlugin(ScrollTrigger);

const isMobile = window.innerWidth <= 960;
const scrollContainer = isMobile ? window : document.getElementById("loginLeft");

// Configurar ScrollTrigger para el contenedor del left panel
ScrollTrigger.defaults({
    scroller: isMobile ? window : "#loginLeft"
});

// ── ANIMACIÓN HERO ──────────────────────────────
gsap.to("#heroBadge", {
    opacity:1, y:0, duration:0.8, delay:0.3, ease:"back.out(1.7)"
});

gsap.to(".ls-title .word", {
    y:0, opacity:1, duration:0.7, stagger:0.08, delay:0.6, ease:"power3.out"
});

gsap.to("#heroDesc", {
    opacity:1, y:0, duration:0.7, delay:1.1, ease:"power2.out"
});

gsap.to("#heroStats", {
    opacity:1, y:0, duration:0.7, delay:1.4, ease:"back.out(1.4)"
});

// Contador animado
setTimeout(() => {
    const el = document.querySelector("[data-count]");
    if (!el) return;
    const target = parseInt(el.dataset.count);
    let current = 0;
    const step = target / 60;
    const timer = setInterval(() => {
        current += step;
        if (current >= target) { el.textContent = "+9k"; clearInterval(timer); return; }
        el.textContent = "+" + Math.floor(current).toLocaleString();
    }, 16);
}, 1600);

// ── SECCIÓN 2: FEATURES ────────────────────────
gsap.to("#feat-label", {
    opacity:1, x:0, duration:0.6, ease:"power2.out",
    scrollTrigger:{ trigger:"#sec2", start:"top 80%" }
});
gsap.to("#feat-title", {
    opacity:1, y:0, duration:0.7, delay:0.15, ease:"power3.out",
    scrollTrigger:{ trigger:"#sec2", start:"top 75%" }
});
gsap.to("#feat-sub", {
    opacity:1, y:0, duration:0.6, delay:0.25, ease:"power2.out",
    scrollTrigger:{ trigger:"#sec2", start:"top 75%" }
});
["#feat1","#feat2","#feat3","#feat4"].forEach((id, i) => {
    gsap.to(id, {
        opacity:1, x:0, duration:0.6, delay:i * 0.12,
        ease:"power2.out",
        scrollTrigger:{ trigger:"#sec2", start:"top 65%" }
    });
});

// ── SECCIÓN 3: PROOF ───────────────────────────
gsap.to("#proof-label", {
    opacity:1, x:0, duration:0.6, ease:"power2.out",
    scrollTrigger:{ trigger:"#sec3", start:"top 80%" }
});
gsap.to("#proof-title", {
    opacity:1, y:0, duration:0.7, delay:0.15, ease:"power3.out",
    scrollTrigger:{ trigger:"#sec3", start:"top 75%" }
});
["#proof1","#proof2","#proof3","#proof4"].forEach((id, i) => {
    gsap.to(id, {
        opacity:1, y:0, scale:1, duration:0.5, delay:i * 0.1,
        ease:"back.out(1.4)",
        scrollTrigger:{ trigger:"#sec3", start:"top 65%" }
    });
});

// ── SECCIÓN 4: CTA ─────────────────────────────
gsap.to("#cta-title", {
    opacity:1, y:0, duration:0.8, ease:"power3.out",
    scrollTrigger:{ trigger:"#sec4", start:"top 80%" }
});
gsap.to("#cta-sub", {
    opacity:1, y:0, duration:0.7, delay:0.2, ease:"power2.out",
    scrollTrigger:{ trigger:"#sec4", start:"top 75%" }
});
gsap.to("#cta-btn", {
    opacity:1, y:0, duration:0.7, delay:0.35, ease:"back.out(1.7)",
    scrollTrigger:{ trigger:"#sec4", start:"top 70%" }
});

// ── MASCOTA ────────────────────────────────────
const mascota = document.getElementById("mascota");
const pwdInput = document.getElementById("passwordInput");

document.addEventListener("mousemove", e => {
    if (mascota.dataset.hiding) return;
    const r = mascota.getBoundingClientRect();
    const angle = Math.atan2(e.clientY - (r.top + r.height/2), e.clientX - (r.left + r.width/2)) * 180 / Math.PI;
    mascota.style.transform = `rotate(${angle * 0.07}deg)`;
});

pwdInput.addEventListener("focus", () => {
    mascota.dataset.hiding = "1";
    gsap.to(mascota, { rotation:-12, scale:1.06, filter:"brightness(0.4) blur(1px)", duration:0.3 });
});
pwdInput.addEventListener("blur", () => {
    delete mascota.dataset.hiding;
    gsap.to(mascota, { rotation:0, scale:1, filter:"brightness(1) blur(0px)", duration:0.3 });
});

function togglePassword() {
    pwdInput.type = pwdInput.type === "password" ? "text" : "password";
    document.querySelector(".ht-pwd-toggle").textContent = pwdInput.type === "password" ? "👁️" : "🙈";
}

function onUsernameInput(input) {
    gsap.to(mascota, { filter: input.value.trim().length > 0
        ? "brightness(1.1) drop-shadow(0 0 10px rgba(99,102,241,0.6))"
        : "brightness(1)", duration:0.3 });
}

function onPasswordInput(input) {
    const v = input.value;
    let score = 0;
    if (v.length >= 6) score++;
    if (v.length >= 10) score++;
    if (/[A-Z]/.test(v) && /[0-9]/.test(v)) score++;
    if (/[^A-Za-z0-9]/.test(v)) score++;
    const colors = ["#ef4444","#f59e0b","#22c55e","#6366f1"];
    for (let i = 1; i <= 4; i++) {
        document.getElementById("sb"+i).style.background =
            i <= score ? colors[score-1] : "rgba(255,255,255,0.06)";
    }
}

document.addEventListener("keydown", e => {
    if (e.key === "Enter") { e.preventDefault(); tryGetLocation(); }
});

function tryGetLocation() {
    const u = document.querySelector("input[name='Username']").value.trim();
    const p = document.querySelector("input[name='Password']").value.trim();
    if (!u || !p) {
        gsap.to("#form", { x:-8, duration:0.06, yoyo:true, repeat:5, ease:"power1.inOut" });
        return;
    }
    const overlay = document.createElement("div");
    overlay.style.cssText = "position:fixed;inset:0;background:rgba(3,7,18,0.92);z-index:99999;display:flex;align-items:center;justify-content:center;flex-direction:column;backdrop-filter:blur(16px);";
    overlay.innerHTML = `
        <div style="position:relative;margin-bottom:22px;">
            <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg"
                 style="width:80px;height:80px;border-radius:20px;border:2px solid rgba(99,102,241,0.4);box-shadow:0 0 0 8px rgba(99,102,241,0.08);" />
        </div>
        <p style="color:white;font-weight:800;font-size:20px;font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:6px;">Entrando...</p>
        <p style="color:rgba(255,255,255,0.3);font-size:13px;font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:24px;">Verificando credenciales</p>
        <div style="width:180px;height:4px;background:rgba(255,255,255,0.06);border-radius:10px;overflow:hidden;">
            <div id="loginBar" style="height:100%;background:linear-gradient(90deg,#6366f1,#2563eb);border-radius:10px;width:0%;transition:width 0.25s;"></div>
        </div>`;
    document.body.appendChild(overlay);
    gsap.from(overlay, { opacity:0, duration:0.3 });

    let prog = 0;
    const interval = setInterval(() => {
        prog += Math.random() * 14;
        if (prog > 85) prog = 85;
        const b = document.getElementById("loginBar");
        if (b) b.style.width = prog + "%";
    }, 200);

    const submit = () => {
        clearInterval(interval);
        const b = document.getElementById("loginBar");
        if (b) b.style.width = "100%";
        setTimeout(() => document.getElementById("loginForm").submit(), 300);
    };

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(pos => {
            document.getElementById("latInput").value = pos.coords.latitude;
            document.getElementById("lonInput").value = pos.coords.longitude;
            submit();
        }, submit, { timeout:1500 });
    } else { submit(); }
}

// ── PLEXUS ─────────────────────────────────────
const canvas = document.getElementById("plexus-bg");
const ctx = canvas.getContext("2d");
let mouse = { x:window.innerWidth/2, y:window.innerHeight/2 };
function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resize();
window.addEventListener("resize", resize);
document.addEventListener("mousemove", e => { mouse.x = e.clientX; mouse.y = e.clientY; });

const pts = Array.from({ length:80 }, () => ({
    x: Math.random() * window.innerWidth,
    y: Math.random() * window.innerHeight,
    vx: (Math.random()-.5) * 0.25,
    vy: (Math.random()-.5) * 0.25,
    r: Math.random() * 1.4 + 0.4,
    op: Math.random() * 0.4 + 0.15
}));

function drawPlexus() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < pts.length; i++) {
        for (let j = i+1; j < pts.length; j++) {
            const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
            const d = Math.sqrt(dx*dx + dy*dy);
            if (d < 130) {
                ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y);
                ctx.strokeStyle = `rgba(99,102,241,${0.15*(1-d/130)})`; ctx.lineWidth=0.5; ctx.stroke();
            }
        }
        const mdx = pts[i].x-mouse.x, mdy = pts[i].y-mouse.y;
        const md = Math.sqrt(mdx*mdx+mdy*mdy);
        if (md < 160) {
            ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(mouse.x, mouse.y);
            ctx.strokeStyle = `rgba(139,92,246,${0.22*(1-md/160)})`; ctx.lineWidth=0.7; ctx.stroke();
        }
    }
    pts.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
        ctx.fillStyle = `rgba(99,102,241,${p.op})`; ctx.fill();
    });
    requestAnimationFrame(drawPlexus);
}
drawPlexus();
</script>