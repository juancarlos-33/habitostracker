<script>
gsap.registerPlugin(ScrollTrigger);

// ── SCROLL SECTIONS PC ──────────────────────────
const story = document.getElementById("story");
const dots = document.querySelectorAll(".scroll-dot");
const sections = ["s1","s2","s3","s4"];

function scrollToSec(i) {
    const el = document.getElementById(sections[i]);
    if (el) el.scrollIntoView({ behavior:"smooth" });
}

if (story) {
    story.addEventListener("scroll", () => {
        const h = story.clientHeight;
        const idx = Math.round(story.scrollTop / h);
        dots.forEach((d,i) => d.classList.toggle("active", i===idx));
    });
}

// ── ANIMACIONES GSAP PC ─────────────────────────
const stDef = { scroller:"#story" };

// S1 HERO
gsap.to("#eyebrow", { opacity:1, y:0, duration:0.8, delay:0.3, ease:"back.out(1.7)" });
gsap.to(".hero-h .word", { y:0, opacity:1, duration:0.7, stagger:0.09, delay:0.6, ease:"power3.out" });
gsap.to("#heroP", { opacity:1, y:0, duration:0.7, delay:1.1, ease:"power2.out" });
gsap.to("#heroKpis", { opacity:1, y:0, duration:0.7, delay:1.4, ease:"back.out(1.4)" });

// CONTADOR
setTimeout(() => {
    const el = document.getElementById("kpiCount");
    if (!el) return;
    let c = 0; const step = 9000/70;
    const t = setInterval(() => {
        c += step; if (c >= 9000) { el.textContent = "+9k"; clearInterval(t); return; }
        el.textContent = "+" + Math.floor(c).toLocaleString();
    }, 16);
}, 1600);

// S2 FEATURES
const s2 = { scrollTrigger:{ trigger:"#s2", start:"top 78%", scroller:"#story" } };
gsap.to("#f-ey", { opacity:1, x:0, duration:0.6, ease:"power2.out", ...s2 });
gsap.to("#f-h", { opacity:1, y:0, duration:0.7, delay:0.12, ease:"power3.out", ...s2 });
gsap.to("#f-p", { opacity:1, y:0, duration:0.6, delay:0.22, ease:"power2.out", ...s2 });
["#f1","#f2","#f3","#f4"].forEach((id,i) => gsap.to(id, {
    opacity:1, y:0, scale:1, duration:0.55, delay:i*0.1, ease:"back.out(1.5)",
    scrollTrigger:{ trigger:"#s2", start:"top 68%", scroller:"#story" }
}));

// S3 PROOF
const s3 = { scrollTrigger:{ trigger:"#s3", start:"top 78%", scroller:"#story" } };
gsap.to("#p-ey", { opacity:1, x:0, duration:0.6, ease:"power2.out", ...s3 });
gsap.to("#p-h", { opacity:1, y:0, duration:0.7, delay:0.12, ease:"power3.out", ...s3 });
["#p1","#p2","#p3","#p4"].forEach((id,i) => gsap.to(id, {
