function mt(i){
    document.querySelectorAll(".mob-tab").forEach((t,j)=>t.classList.toggle("on",j===i));
    document.querySelectorAll(".mob-pane").forEach((p,j)=>{
        if(j===i){p.classList.add("on");gsap.from(p,{x:20,opacity:0,duration:0.35,ease:"power2.out"});}
        else p.classList.remove("on");
    });
