// ══ PLEXUS CANVAS ══
const cv=document.getElementById("three-canvas");
const cx=cv.getContext("2d");
let mx2={x:innerWidth/2,y:innerHeight/2};
function rsz(){cv.width=innerWidth;cv.height=innerHeight;}rsz();window.addEventListener("resize",rsz);
document.addEventListener("mousemove",e=>{mx2.x=e.clientX;mx2.y=e.clientY;});
const pts=Array.from({length:80},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.18,vy:(Math.random()-.5)*.18,r:Math.random()*1.3+0.3,op:Math.random()*.28+.07}));
function draw(){
    cx.clearRect(0,0,cv.width,cv.height);
    for(let i=0;i<pts.length;i++){
        for(let j=i+1;j<pts.length;j++){
            const dx=pts[i].x-pts[j].x,dy=pts[i].y-pts[j].y,d=Math.sqrt(dx*dx+dy*dy);
            if(d<125){cx.beginPath();cx.moveTo(pts[i].x,pts[i].y);cx.lineTo(pts[j].x,pts[j].y);cx.strokeStyle=`rgba(99,102,241,${.11*(1-d/125)})`;cx.lineWidth=.45;cx.stroke();}
        }
        const mdx=pts[i].x-mx2.x,mdy=pts[i].y-mx2.y,md=Math.sqrt(mdx*mdx+mdy*mdy);
        if(md<155){cx.beginPath();cx.moveTo(pts[i].x,pts[i].y);cx.lineTo(mx2.x,mx2.y);cx.strokeStyle=`rgba(139,92,246,${.16*(1-md/155)})`;cx.lineWidth=.7;cx.stroke();}
        pts[i].x+=pts[i].vx;pts[i].y+=pts[i].vy;
        if(pts[i].x<0||pts[i].x>cv.width)pts[i].vx*=-1;
        if(pts[i].y<0||pts[i].y>cv.height)pts[i].vy*=-1;
        cx.beginPath();cx.arc(pts[i].x,pts[i].y,pts[i].r,0,Math.PI*2);cx.fillStyle=`rgba(99,102,241,${pts[i].op})`;cx.fill();
    }
    requestAnimationFrame(draw);
}
draw();
</script>

