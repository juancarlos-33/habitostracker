// ── MASCOTA ─────────────────────────────────────
const mascota = document.getElementById("mascota");
const pInput = document.getElementById("pInput");

if (mascota && pInput) {
    document.addEventListener("mousemove", e => {
        if (mascota.dataset.h) return;
        const r = mascota.getBoundingClientRect();
        const a = Math.atan2(e.clientY-(r.top+r.height/2), e.clientX-(r.left+r.width/2))*180/Math.PI;
        gsap.to(mascota, { rotation:a*0.07, duration:0.4, ease:"power1.out" });
    });
    pInput.addEventListener("focus", () => {
        mascota.dataset.h = "1";
        gsap.to(mascota, { rotation:-12, scale:1.06, filter:"brightness(0.35) blur(1.5px)", duration:0.35 });
    });
    pInput.addEventListener("blur", () => {
        delete mascota.dataset.h;
        gsap.to(mascota, { rotation:0, scale:1, filter:"brightness(1) blur(0px)", duration:0.35 });
    });
}

function onUser(inp) {
    if (!mascota) return;
    gsap.to(mascota, { filter:inp.value.trim().length>0
        ? "brightness(1.12) drop-shadow(0 0 12px rgba(99,102,241,0.7))"
        : "brightness(1)", duration:0.3 });
}

function onPwd(inp) {
    const v = inp.value; let s=0;
    if (v.length>=6) s++; if (v.length>=10) s++;
    if (/[A-Z]/.test(v)&&/[0-9]/.test(v)) s++;
    if (/[^A-Za-z0-9]/.test(v)) s++;
    const c=["#ef4444","#f59e0b","#22c55e","#6366f1"];
    for (let i=1;i<=4;i++) document.getElementById("sb"+i).style.background=i<=s?c[s-1]:"rgba(255,255,255,0.05)";
}

function togglePwd() {
    const i = document.getElementById("pInput");
    if (!i) return;
    i.type = i.type==="password"?"text":"password";
    document.querySelector(".pwd-toggle").textContent = i.type==="password"?"👁️":"🙈";
}

function toggleMPwd() {
    const i = document.getElementById("mpInput");
    if (!i) return;
    i.type = i.type==="password"?"text":"password";
}

document.addEventListener("keydown", e => {
    if (e.key==="Enter") { e.preventDefault(); tryLogin(); }
});

function tryLogin() { _doLogin("loginForm","uInput","pInput","latInput","lonInput"); }
function tryMLogin() { _doLogin("mLoginForm","muInput","mpInput","mLatInput","mLonInput"); }

function _doLogin(formId, uId, pId, latId, lonId) {
    const u = document.getElementById(uId)?.value.trim();
    const p = document.getElementById(pId)?.value.trim();
    if (!u || !p) {
        const card = document.getElementById("formCard") || document.getElementById("mp2");
        if (card) gsap.to(card, { x:-8, duration:0.06, yoyo:true, repeat:5, ease:"power1.inOut", clearProps:"x" });
        return;
    }
    const ov = document.createElement("div");
    ov.style.cssText = "position:fixed;inset:0;background:rgba(3,6,15,0.93);z-index:99999;display:flex;align-items:center;justify-content:center;flex-direction:column;backdrop-filter:blur(20px);";
    ov.innerHTML = `<div style="position:relative;margin-bottom:22px;">
        <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg"
             style="width:78px;height:78px;border-radius:20px;border:2px solid rgba(99,102,241,0.4);box-shadow:0 0 0 8px rgba(99,102,241,0.07);" />
    </div>
    <p style="color:white;font-family:'Syne',sans-serif;font-weight:800;font-size:20px;margin-bottom:6px;">Entrando...</p>
    <p style="color:rgba(255,255,255,0.28);font-size:12px;font-family:'Plus Jakarta Sans',sans-serif;margin-bottom:24px;">Verificando credenciales</p>
    <div style="width:180px;height:3px;background:rgba(255,255,255,0.06);border-radius:10px;overflow:hidden;">
        <div id="lBar" style="height:100%;background:linear-gradient(90deg,#6366f1,#2563eb);width:0%;transition:width 0.25s;"></div>
    </div>`;
    document.body.appendChild(ov);
    gsap.from(ov, { opacity:0, duration:0.35 });

    let prog=0;
    const iv = setInterval(() => {
        prog += Math.random()*13; if (prog>85) prog=85;
        const b=document.getElementById("lBar"); if(b) b.style.width=prog+"%";
    }, 200);

    const done = () => {
        clearInterval(iv);
        const b=document.getElementById("lBar"); if(b) b.style.width="100%";
        setTimeout(() => document.getElementById(formId).submit(), 300);
    };

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(pos => {
            document.getElementById(latId).value = pos.coords.latitude;
            document.getElementById(lonId).value = pos.coords.longitude;
            done();
        }, done, { timeout:1500 });
    } else { done(); }
}

// ── MÓVIL TABS ──────────────────────────────────
let currentTab = 0;
function mobSwitch(i) {
    document.querySelectorAll(".mob-tab").forEach((t,j) => t.classList.toggle("active", j===i));
    document.querySelectorAll(".mob-panel").forEach((p,j) => p.classList.toggle("active", j===i));
    currentTab = i;
}

// ── CANVAS PLEXUS ───────────────────────────────
const cv = document.getElementById("bg-canvas");
const cx = cv.getContext("2d");
let mouse = { x:window.innerWidth/2, y:window.innerHeight/2 };
function resize() { cv.width=window.innerWidth; cv.height=window.innerHeight; }
resize(); window.addEventListener("resize", resize);
document.addEventListener("mousemove", e => { mouse.x=e.clientX; mouse.y=e.clientY; });

const pts = Array.from({length:75}, () => ({
    x:Math.random()*window.innerWidth, y:Math.random()*window.innerHeight,
    vx:(Math.random()-.5)*.22, vy:(Math.random()-.5)*.22,
    r:Math.random()*1.3+0.4, op:Math.random()*.35+.1
}));

function draw() {
    cx.clearRect(0,0,cv.width,cv.height);
    for (let i=0;i<pts.length;i++) {
        for (let j=i+1;j<pts.length;j++) {
            const dx=pts[i].x-pts[j].x, dy=pts[i].y-pts[j].y, d=Math.sqrt(dx*dx+dy*dy);
            if (d<125) { cx.beginPath(); cx.moveTo(pts[i].x,pts[i].y); cx.lineTo(pts[j].x,pts[j].y); cx.strokeStyle=`rgba(99,102,241,${.13*(1-d/125)})`; cx.lineWidth=.5; cx.stroke(); }
        }
        const mdx=pts[i].x-mouse.x, mdy=pts[i].y-mouse.y, md=Math.sqrt(mdx*mdx+mdy*mdy);
        if (md<150) { cx.beginPath(); cx.moveTo(pts[i].x,pts[i].y); cx.lineTo(mouse.x,mouse.y); cx.strokeStyle=`rgba(139,92,246,${.2*(1-md/150)})`; cx.lineWidth=.7; cx.stroke(); }
    }
    pts.forEach(p => {
        p.x+=p.vx; p.y+=p.vy;
        if(p.x<0||p.x>cv.width) p.vx*=-1;
        if(p.y<0||p.y>cv.height) p.vy*=-1;
        cx.beginPath(); cx.arc(p.x,p.y,p.r,0,Math.PI*2);
        cx.fillStyle=`rgba(99,102,241,${p.op})`; cx.fill();
    });
    requestAnimationFrame(draw);
}
draw();
</script>