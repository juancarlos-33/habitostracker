<script>
gsap.registerPlugin(ScrollTrigger);

// ── NAV
window.addEventListener("scroll",()=>document.getElementById("nav").classList.toggle("scrolled",window.scrollY>50));

// ── HERO
gsap.to("#htag",{opacity:1,y:0,duration:1,delay:0.4,ease:"expo.out"});
gsap.to(".hero-h .wd",{y:0,opacity:1,duration:1,stagger:0.1,delay:0.7,ease:"expo.out"});
gsap.to("#hp",{opacity:1,y:0,duration:0.9,delay:1.2,ease:"power3.out"});
gsap.to("#hb",{opacity:1,y:0,duration:0.8,delay:1.5,ease:"back.out(1.4)"});
gsap.to("#hk",{opacity:1,y:0,duration:0.8,delay:1.7,ease:"back.out(1.4)"});

setTimeout(()=>{
    const el=document.getElementById("kc");if(!el)return;
    let c=0;const t=setInterval(()=>{c+=150;if(c>=9000){el.textContent="+9k";clearInterval(t);}else el.textContent="+"+Math.floor(c).toLocaleString();},16);
},1900);

// ── SCROLL REVEAL
document.querySelectorAll(".reveal-tag").forEach(el=>gsap.from(el,{opacity:0,x:-20,duration:0.6,ease:"expo.out",scrollTrigger:{trigger:el,start:"top 82%"}}));
