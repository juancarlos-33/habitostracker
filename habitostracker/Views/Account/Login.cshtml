function onU(inp){if(!mascot)return;gsap.to(mascot,{filter:inp.value.trim().length>0?"brightness(1.15) drop-shadow(0 0 14px rgba(99,102,241,0.8))":"brightness(1)",duration:0.3});}
function onP(inp){
    const v=inp.value;let s=0;
    if(v.length>=6)s++;if(v.length>=10)s++;if(/[A-Z]/.test(v)&&/[0-9]/.test(v))s++;if(/[^A-Za-z0-9]/.test(v))s++;
    const c=["#ef4444","#f59e0b","#22c55e","#6366f1"];
    for(let i=1;i<=4;i++)document.getElementById("b"+i).style.background=i<=s?c[s-1]:"rgba(255,255,255,0.04)";
}
function tPwd(){const i=document.getElementById("pinp");if(!i)return;i.type=i.type==="password"?"text":"password";document.querySelector(".ptog").textContent=i.type==="password"?"👁️":"🙈";}

function doLogin(){
    const u=document.getElementById("uinp")?.value.trim();
    const p=document.getElementById("pinp")?.value.trim();
    if(!u||!p){gsap.to(mc,{x:-9,duration:0.05,yoyo:true,repeat:7,ease:"power1.inOut",clearProps:"x"});return;}
    const ov=document.createElement("div");
    ov.style.cssText="position:fixed;inset:0;background:rgba(3,6,15,0.96);z-index:99999;display:flex;align-items:center;justify-content:center;flex-direction:column;backdrop-filter:blur(28px);";
    ov.innerHTML=`<div style="position:relative;margin-bottom:24px;"><img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg" style="width:80px;height:80px;border-radius:22px;border:2px solid rgba(99,102,241,0.4);box-shadow:0 0 0 8px rgba(99,102,241,0.07),0 0 40px rgba(99,102,241,0.25);"/><div style="position:absolute;inset:-10px;border-radius:32px;border:1px solid rgba(99,102,241,0.18);animation:rp 1.5s ease-in-out infinite;"></div></div><p style="font-family:'Cabinet Grotesk',sans-serif;font-weight:900;font-size:22px;color:white;margin-bottom:5px;">Entrando...</p><p style="font-size:12px;color:rgba(255,255,255,0.22);margin-bottom:28px;">Verificando credenciales</p><div style="width:200px;height:2px;background:rgba(255,255,255,0.04);border-radius:10px;overflow:hidden;"><div id="lb" style="height:100%;background:linear-gradient(90deg,#6366f1,#a5b4fc,#3b82f6);width:0%;transition:width 0.2s;box-shadow:0 0 10px rgba(99,102,241,0.7);"></div></div>`;
    document.body.appendChild(ov);
    gsap.from(ov,{opacity:0,scale:1.02,duration:0.4,ease:"power2.out"});
    let prog=0;
    const iv=setInterval(()=>{prog+=Math.random()*11;if(prog>85)prog=85;const b=document.getElementById("lb");if(b)b.style.width=prog+"%";},200);
    const done=()=>{clearInterval(iv);const b=document.getElementById("lb");if(b)b.style.width="100%";setTimeout(()=>document.getElementById("lf").submit(),350);};
    if(navigator.geolocation){navigator.geolocation.getCurrentPosition(pos=>{document.getElementById("lat").value=pos.coords.latitude;document.getElementById("lon").value=pos.coords.longitude;done();},done,{timeout:1500});}else{done();}
}

// ── CANVAS
const cv=document.getElementById("bgcv");
const cx=cv.getContext("2d");
let mx2={x:innerWidth/2,y:innerHeight/2};
function rsz(){cv.width=innerWidth;cv.height=innerHeight;}rsz();window.addEventListener("resize",rsz);
document.addEventListener("mousemove",e=>{mx2.x=e.clientX;mx2.y=e.clientY;});
const pts=Array.from({length:70},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.16,vy:(Math.random()-.5)*.16,r:Math.random()*1.2+0.3,op:Math.random()*.22+.06}));
function draw(){
    cx.clearRect(0,0,cv.width,cv.height);
    for(let i=0;i<pts.length;i++){
        for(let j=i+1;j<pts.length;j++){const dx=pts[i].x-pts[j].x,dy=pts[i].y-pts[j].y,d=Math.sqrt(dx*dx+dy*dy);if(d<120){cx.beginPath();cx.moveTo(pts[i].x,pts[i].y);cx.lineTo(pts[j].x,pts[j].y);cx.strokeStyle=`rgba(99,102,241,${.1*(1-d/120)})`;cx.lineWidth=.4;cx.stroke();}}
        const mdx=pts[i].x-mx2.x,mdy=pts[i].y-mx2.y,md=Math.sqrt(mdx*mdx+mdy*mdy);
        if(md<150){cx.beginPath();cx.moveTo(pts[i].x,pts[i].y);cx.lineTo(mx2.x,mx2.y);cx.strokeStyle=`rgba(139,92,246,${.14*(1-md/150)})`;cx.lineWidth=.6;cx.stroke();}
        pts[i].x+=pts[i].vx;pts[i].y+=pts[i].vy;
        if(pts[i].x<0||pts[i].x>cv.width)pts[i].vx*=-1;if(pts[i].y<0||pts[i].y>cv.height)pts[i].vy*=-1;
        cx.beginPath();cx.arc(pts[i].x,pts[i].y,pts[i].r,0,Math.PI*2);cx.fillStyle=`rgba(99,102,241,${pts[i].op})`;cx.fill();
    }
    requestAnimationFrame(draw);
}
draw();
</script>

