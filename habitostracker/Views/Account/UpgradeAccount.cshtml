@{
    ViewData["Title"] = "Completa tu cuenta";
    Layout = "_LayoutLogin";
}

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
    min-height:100vh;
    font-family:'Plus Jakarta Sans',Inter,system-ui;
    background:#0d1117;
    overflow-x:hidden;
}

#plexus-bg {
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    z-index:0;
    pointer-events:none;
}

.upgrade-wrapper {
    position:relative;
    z-index:2;
    width:100%;
    min-height:100vh;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:40px 20px 60px;
}

.upgrade-card {
    width:460px;
    max-width:96%;
    border-radius:24px;
    background:rgba(15,23,42,0.9);
    backdrop-filter:blur(24px);
    border:1px solid rgba(255,255,255,0.08);
    box-shadow:0 32px 80px rgba(0,0,0,0.7);
    overflow:hidden;
}

/* CARD TOP GRADIENT BAR */
.card-glow {
    height:4px;
    background:linear-gradient(90deg,#6366f1,#2563eb,#7c3aed);
    background-size:200%;
    animation:gradientShift 3s ease infinite;
}
@@keyframes gradientShift { 0%,100%{background-position:0%;} 50%{background-position:100%;} }

.card-body { padding:36px 32px; }

/* HEADER */
.upgrade-header {
    text-align:center;
    margin-bottom:28px;
}

.upgrade-icon-wrap {
    width:72px; height:72px;
    border-radius:20px;
    background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(37,99,235,0.2));
    border:1px solid rgba(99,102,241,0.3);
    display:flex; align-items:center; justify-content:center;
    font-size:36px;
    margin:0 auto 16px;
    animation:iconPop 0.5s cubic-bezier(0.34,1.56,0.64,1);
}
@@keyframes iconPop { from{transform:scale(0.5);opacity:0;} to{transform:scale(1);opacity:1;} }

.upgrade-header h2 {
    color:white;
    font-size:22px;
    font-weight:800;
    margin:0 0 8px;
    letter-spacing:-0.3px;
}

.upgrade-header p {
    color:rgba(255,255,255,0.4);
    font-size:13px;
    margin:0;
    line-height:1.6;
}

/* BENEFITS */
.benefits {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-bottom:24px;
}

.benefit-item {
    display:flex;
    align-items:center;
    gap:8px;
    font-size:12px;
    font-weight:600;
    color:rgba(255,255,255,0.65);
    background:rgba(99,102,241,0.07);
    border:1px solid rgba(99,102,241,0.15);
    border-radius:10px;
    padding:10px 12px;
    transition:0.2s;
}
.benefit-item:hover { background:rgba(99,102,241,0.14); color:white; }
.benefit-item .bi { font-size:15px; color:#818cf8; flex-shrink:0; }

/* GOOGLE BTN */
.google-btn {
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    width:100%;
    padding:13px;
    background:white;
    border-radius:12px;
    border:none;
    color:#3c4043;
    font-weight:700;
    font-size:14px;
    text-decoration:none;
    transition:0.2s;
    margin-bottom:16px;
    box-shadow:0 4px 14px rgba(0,0,0,0.3);
}
.google-btn img { width:18px; }
.google-btn:hover { background:#f1f1f1; transform:translateY(-1px); box-shadow:0 8px 20px rgba(0,0,0,0.3); color:#3c4043; }

/* DIVIDER */
.divider {
    display:flex;
    align-items:center;
    margin:0 0 16px;
    font-size:11px;
    font-weight:600;
    color:rgba(255,255,255,0.2);
    letter-spacing:0.5px;
    text-transform:uppercase;
}
.divider::before, .divider::after {
    content:"";
    flex:1;
    height:1px;
    background:rgba(255,255,255,0.08);
    margin:0 12px;
}

/* FIELDS */
.field { margin-bottom:14px; }
.field label {
    display:block;
    font-size:11px;
    color:rgba(255,255,255,0.4);
    text-transform:uppercase;
    letter-spacing:0.8px;
    font-weight:700;
    margin-bottom:7px;
}
.field input {
    width:100%;
    padding:12px 14px;
    background:rgba(255,255,255,0.05);
    border:1.5px solid rgba(255,255,255,0.08);
    border-radius:12px;
    color:white;
    font-size:14px;
    font-family:inherit;
    outline:none;
    transition:0.2s;
}
.field input:focus {
    background:rgba(255,255,255,0.08);
    border-color:#6366f1;
    box-shadow:0 0 0 3px rgba(99,102,241,0.15);
}
.field input::placeholder { color:rgba(255,255,255,0.18); }

/* SUBMIT BTN */
.btn-upgrade {
    width:100%;
    padding:14px;
    border-radius:12px;
    border:none;
    background:linear-gradient(90deg,#6366f1,#2563eb);
    color:white;
    font-weight:800;
    font-size:15px;
    font-family:inherit;
    cursor:pointer;
    transition:0.2s;
    margin-top:4px;
    position:relative;
    overflow:hidden;
    letter-spacing:-0.2px;
}
.btn-upgrade::before {
    content:"";
    position:absolute;
    top:0; left:-100%;
    width:100%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.15),transparent);
    transition:0.5s;
}
.btn-upgrade:hover::before { left:100%; }
.btn-upgrade:hover { transform:translateY(-1px); box-shadow:0 8px 24px rgba(99,102,241,0.45); }

/* BACK LINK */
.back-link {
    text-align:center;
    margin-top:20px;
    padding-top:18px;
    border-top:1px solid rgba(255,255,255,0.06);
    font-size:13px;
    color:rgba(255,255,255,0.3);
}
.back-link a {
    color:#6366f1;
    font-weight:700;
    text-decoration:none;
}
.back-link a:hover { color:#818cf8; }

/* ALERT */
.alert { border-radius:12px; font-size:13px; margin-bottom:16px; }

/* MOBILE */
@@media (max-width: 480px) {
    .card-body { padding:28px 20px; }
    .benefits { grid-template-columns:1fr; }
    .upgrade-wrapper { padding:24px 16px 50px; }
}
</style>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<canvas id="plexus-bg"></canvas>

<div class="upgrade-wrapper">
<div class="upgrade-card">
    <div class="card-glow"></div>
    <div class="card-body">

        <div class="upgrade-header">
            <div class="upgrade-icon-wrap">🔓</div>
            <h2>Completa tu cuenta</h2>
            <p>Convierte tu cuenta de invitado en una cuenta completa y desbloquea todo lo que HabitTracker tiene para ofrecerte</p>
        </div>

        <div class="benefits">
            <div class="benefit-item"><i class="bi bi-chat-dots-fill"></i><span>Mensajes</span></div>
            <div class="benefit-item"><i class="bi bi-people-fill"></i><span>Amigos</span></div>
            <div class="benefit-item"><i class="bi bi-image-fill"></i><span>Publicaciones</span></div>
            <div class="benefit-item"><i class="bi bi-bell-fill"></i><span>Notificaciones</span></div>
            <div class="benefit-item"><i class="bi bi-shield-check-fill"></i><span>Perfil propio</span></div>
        </div>

        <a href="/Account/GoogleLogin" class="google-btn" onclick="sessionStorage.setItem('ht_google_oauth_started','1'); window.location.replace(this.href); return false;">
            <img src="https://developers.google.com/identity/images/g-logo.png" />
            Continuar con Google
        </a>

        <div class="divider"><span>o crea con correo</span></div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form method="post" asp-action="UpgradeAccount">
            @Html.AntiForgeryToken()

            <div class="field">
                <label>Correo electrónico</label>
                <input name="email" type="email" placeholder="tu@correo.com" required />
            </div>

            <div class="field">
                <label>Contraseña</label>
                <input name="password" type="password" placeholder="Mínimo 6 caracteres" required />
            </div>

            <button type="submit" class="btn-upgrade">
                🚀 Crear mi cuenta
            </button>
        </form>

        <div class="back-link">
            ¿Prefieres esperar? <a asp-controller="Habit" asp-action="Index">← Seguir como invitado</a>
        </div>

    </div>
</div>
</div>

<script>
const canvas = document.getElementById("plexus-bg");
const ctx = canvas.getContext("2d");

function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resize();
window.addEventListener("resize", resize);

const pts = Array.from({length:90}, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    vx: (Math.random()-0.5)*0.45,
    vy: (Math.random()-0.5)*0.45,
    r: Math.random()*1.5+0.8
}));

function draw() {
    ctx.clearRect(0,0,canvas.width,canvas.height);
    for (let i=0;i<pts.length;i++) {
        for (let j=i+1;j<pts.length;j++) {
            const dx=pts[i].x-pts[j].x, dy=pts[i].y-pts[j].y;
            const d=Math.sqrt(dx*dx+dy*dy);
            if (d<170) {
                ctx.beginPath();
                ctx.moveTo(pts[i].x,pts[i].y);
                ctx.lineTo(pts[j].x,pts[j].y);
                ctx.strokeStyle=`rgba(99,102,241,${0.18*(1-d/170)})`;
                ctx.lineWidth=0.6; ctx.stroke();
            }
        }
    }
    pts.forEach(p => {
        p.x+=p.vx; p.y+=p.vy;
        if(p.x<0||p.x>canvas.width) p.vx*=-1;
        if(p.y<0||p.y>canvas.height) p.vy*=-1;
        ctx.beginPath();
        ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
        ctx.fillStyle="rgba(99,102,241,0.65)";
        ctx.fill();
    });
    requestAnimationFrame(draw);
}
draw();
</script>
