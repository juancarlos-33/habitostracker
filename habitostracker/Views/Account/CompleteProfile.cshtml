@{
    ViewData["Title"] = "Completa tu perfil";
    Layout = "_LayoutLogin";
}

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

.complete-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: #020617;
    position: relative;
    overflow: hidden;
    font-family: 'Plus Jakarta Sans', sans-serif;
}

/* Orbes de fondo animados */
.complete-wrapper::before {
    content: '';
    position: absolute;
    top: -150px; left: -150px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(99,102,241,0.18), transparent 70%);
    border-radius: 50%;
    animation: floatOrb 8s ease-in-out infinite;
}
.complete-wrapper::after {
    content: '';
    position: absolute;
    bottom: -100px; right: -100px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(34,197,94,0.12), transparent 70%);
    border-radius: 50%;
    animation: floatOrb 10s ease-in-out infinite reverse;
}
@@keyframes floatOrb {
    0%,100% { transform: translate(0,0) scale(1); }
    50% { transform: translate(30px,30px) scale(1.1); }
}

/* Partículas decorativas */
.particle {
    position: absolute;
    border-radius: 50%;
    background: rgba(99,102,241,0.3);
    animation: float linear infinite;
}
@@keyframes float {
    0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(-100px) rotate(720deg); opacity: 0; }
}

.complete-layout {
    display: flex;
    align-items: center;
    gap: 60px;
    max-width: 960px;
    width: 100%;
    position: relative;
    z-index: 2;
}

/* LADO IZQUIERDO — imagen + info */
.complete-left {
    flex: 1;
    display: none;
}
@@media (min-width: 900px) {
    .complete-left { display: block; }
}

.complete-img-wrap {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.6);
    border: 1px solid rgba(255,255,255,0.08);
}
.complete-img-wrap img {
    width: 100%;
    display: block;
    height: 480px;
    object-fit: cover;
}
.complete-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(2,6,23,0.95) 0%, rgba(2,6,23,0.3) 50%, transparent 100%);
}
.complete-img-text {
    position: absolute;
    bottom: 28px; left: 28px; right: 28px;
}
.complete-img-text h3 {
    font-size: 22px;
    font-weight: 800;
    color: white;
    margin-bottom: 8px;
    line-height: 1.3;
}
.complete-img-text p {
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
}
.complete-img-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(99,102,241,0.25);
    border: 1px solid rgba(99,102,241,0.4);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 700;
    color: #818cf8;
    margin-bottom: 12px;
}

/* LADO DERECHO — formulario */
.complete-card {
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(30px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 28px;
    padding: 44px 40px;
    width: 100%;
    max-width: 460px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
    animation: cardIn 0.6s cubic-bezier(0.34,1.56,0.64,1) both;
}
@@keyframes cardIn {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.complete-header { text-align: center; margin-bottom: 36px; }

.complete-logo-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: 18px;
}
.complete-logo {
    width: 72px; height: 72px;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    border-radius: 22px;
    display: flex; align-items: center; justify-content: center;
    font-size: 34px;
    box-shadow: 0 8px 32px rgba(99,102,241,0.5);
    animation: logoBounce 0.8s cubic-bezier(0.34,1.56,0.64,1) both 0.2s;
}
@@eyframes logoBounce {
    from { opacity: 0; transform: scale(0.5) rotate(-10deg); }
    to { opacity: 1; transform: scale(1) rotate(0deg); }
}
.complete-logo-ring {
    position: absolute;
    inset: -6px;
    border-radius: 28px;
    border: 2px solid rgba(99,102,241,0.3);
    animation: ringPulse 2s ease-in-out infinite;
}
@@keyframes ringPulse {
    0%,100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.08); opacity: 1; }
}

.complete-step-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.25);
    border-radius: 20px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: 700;
    color: #4ade80;
    margin-bottom: 14px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.complete-title {
    font-size: 24px;
    font-weight: 800;
    color: white;
    margin: 0 0 8px;
    letter-spacing: -0.3px;
}
.complete-subtitle {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    margin: 0;
    line-height: 1.6;
}

/* Progreso */
.progress-bar-wrap {
    background: rgba(255,255,255,0.06);
    border-radius: 10px;
    height: 4px;
    margin-bottom: 32px;
    overflow: hidden;
}
.progress-bar-fill {
    height: 100%;
    width: 50%;
    background: linear-gradient(90deg, #6366f1, #22c55e);
    border-radius: 10px;
    animation: fillBar 0.8s ease 0.5s both;
}
@@keyframes fillBar {
    from { width: 0; }
    to { width: 50%; }
}

.field-group { margin-bottom: 24px; }

.field-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: rgba(255,255,255,0.8);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.required { color: #f87171; }

/* Género */
.gender-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}
.gender-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 22px 16px;
    border-radius: 18px;
    border: 2px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
    position: relative;
    overflow: hidden;
}
.gender-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(99,102,241,0.1), transparent);
    opacity: 0;
    transition: opacity 0.25s;
}
.gender-card:hover::before { opacity: 1; }
.gender-card input[type="radio"] { display: none; }
.gender-card:hover {
    border-color: rgba(99,102,241,0.4);
    transform: translateY(-2px);
}
.gender-card.selected {
    border-color: #6366f1;
    background: rgba(99,102,241,0.15);
    box-shadow: 0 0 24px rgba(99,102,241,0.25), inset 0 0 24px rgba(99,102,241,0.05);
}
.gender-card.selected::before { opacity: 1; }
.gender-check {
    position: absolute;
    top: 10px; right: 10px;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: #6366f1;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; color: white;
    opacity: 0; transform: scale(0);
    transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1);
}
.gender-card.selected .gender-check { opacity: 1; transform: scale(1); }
.gender-icon { font-size: 36px; transition: transform 0.2s; }
.gender-card:hover .gender-icon { transform: scale(1.1); }
.gender-text { font-size: 14px; font-weight: 700; color: white; }
.gender-sub { font-size: 11px; color: rgba(255,255,255,0.4); }

/* Bio */
.bio-wrap { position: relative; }
.bio-input {
    width: 100%;
    padding: 14px 16px;
    background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    color: white;
    font-size: 14px;
    resize: none;
    min-height: 110px;
    outline: none;
    transition: all 0.2s;
    line-height: 1.6;
    font-family: inherit;
}
.bio-input::placeholder { color: rgba(255,255,255,0.25); }
.bio-input:focus {
    border-color: rgba(99,102,241,0.6);
    background: rgba(255,255,255,0.08);
    box-shadow: 0 0 0 4px rgba(99,102,241,0.1);
}
.char-count {
    text-align: right;
    font-size: 11px;
    color: rgba(255,255,255,0.3);
    margin-top: 6px;
    transition: color 0.2s;
}
.char-count.warning { color: #f87171; }

/* Botón */
.complete-btn {
    width: 100%;
    padding: 16px;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    color: white;
    border: none;
    border-radius: 16px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(99,102,241,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    position: relative;
    overflow: hidden;
    font-family: inherit;
}
.complete-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
    opacity: 0;
    transition: opacity 0.2s;
}
.complete-btn:hover::before { opacity: 1; }
.complete-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(99,102,241,0.55);
}
.complete-btn:active { transform: translateY(0); }
.complete-btn-arrow {
    transition: transform 0.2s;
}
.complete-btn:hover .complete-btn-arrow { transform: translateX(4px); }

.complete-footer {
    text-align: center;
    margin-top: 20px;
    font-size: 12px;
    color: rgba(255,255,255,0.25);
}
</style>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<!-- Partículas -->
<div id="particles"></div>

<div class="complete-wrapper">
    <div class="complete-layout">

        <!-- IZQUIERDA: imagen -->
        <div class="complete-left">
            <div class="complete-img-wrap">
                <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg" alt="HabitTracker" />
                <div class="complete-img-overlay"></div>
                <div class="complete-img-text">
                    <div class="complete-img-badge">✨ Únete a la comunidad</div>
                    <h3>Construye hábitos que<br/>cambien tu vida</h3>
                    <p>Miles de personas ya están transformando su rutina diaria con HabitTracker. ¡Tú eres el siguiente!</p>
                </div>
            </div>
        </div>

        <!-- DERECHA: formulario -->
        <div class="complete-card">

            <div class="complete-header">
                <div class="complete-logo-wrap">
                    <div class="complete-logo">🎯</div>
                    <div class="complete-logo-ring"></div>
                </div>
                <div class="complete-step-badge">⚡ Último paso</div>
                <h2 class="complete-title">¡Casi listo!</h2>
                <p class="complete-subtitle">Cuéntanos sobre ti para personalizar tu experiencia</p>
            </div>

            <div class="progress-bar-wrap">
                <div class="progress-bar-fill"></div>
            </div>

            <form asp-action="CompleteProfile" method="post" id="profileForm">
                @Html.AntiForgeryToken()

                <!-- GÉNERO -->
                <div class="field-group">
                    <label class="field-label">👤 ¿Cuál es tu género? <span class="required">*</span></label>
                    <div class="gender-options">
                        <label class="gender-card" id="male-card">
                            <div class="gender-check">✓</div>
                            <input type="radio" name="gender" value="Masculino" required />
                            <span class="gender-icon">👨</span>
                            <span class="gender-text">Masculino</span>
                            <span class="gender-sub">Él / Him</span>
                        </label>
                        <label class="gender-card" id="female-card">
                            <div class="gender-check">✓</div>
                            <input type="radio" name="gender" value="Femenino" required />
                            <span class="gender-icon">👩</span>
                            <span class="gender-text">Femenino</span>
                            <span class="gender-sub">Ella / Her</span>
                        </label>
                    </div>
                </div>

                <!-- BIO -->
                <div class="field-group">
                    <label class="field-label">✍️ Cuéntanos sobre ti <span class="required">*</span></label>
                    <div class="bio-wrap">
                        <textarea name="bio" class="bio-input"
                                  placeholder="¿Qué hábitos quieres construir? ¿Qué te motiva cada día?..."
                                  required minlength="10" maxlength="300"></textarea>
                    </div>
                    <div class="char-count"><span id="charCount">0</span>/300</div>
                </div>

                <button type="submit" class="complete-btn">
                    Crear mi cuenta
                    <span class="complete-btn-arrow">→</span>
                </button>

            </form>

            <div class="complete-footer">
                🔒 Tus datos están seguros con nosotros
            </div>

        </div>
    </div>
</div>

<script>
    // Bloquear botón atrás en CompleteProfile
history.pushState(null, '', window.location.href);
window.addEventListener('popstate', function() {
    history.pushState(null, '', window.location.href);
});
// Partículas
const container = document.getElementById('particles');
for (let i = 0; i < 12; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    const size = Math.random() * 6 + 3;
    p.style.cssText = `
        width:${size}px;height:${size}px;
        left:${Math.random()*100}%;
        animation-duration:${Math.random()*15+10}s;
        animation-delay:${Math.random()*10}s;
        opacity:${Math.random()*0.4+0.1};
    `;
    container.appendChild(p);
}

// Género
document.querySelectorAll('.gender-card').forEach(card => {
    card.addEventListener('click', function() {
        document.querySelectorAll('.gender-card').forEach(c => c.classList.remove('selected'));
        this.classList.add('selected');
        this.querySelector('input[type="radio"]').checked = true;
    });
});
// Si ya pasó por aquí antes, ir al home directamente
if (sessionStorage.getItem('profileCompleted')) {
    window.location.replace('/Habit/Index');
}

document.getElementById('profileForm').addEventListener('submit', function() {
    sessionStorage.setItem('showCreating', '1');
    sessionStorage.setItem('onboardingDone', '1');
    sessionStorage.setItem('profileCompleted', '1');
});

// Bio contador
const bioInput = document.querySelector('.bio-input');
const charCount = document.getElementById('charCount');
const charCountWrap = document.querySelector('.char-count');
bioInput.addEventListener('input', function() {
    const len = this.value.length;
    charCount.textContent = len;
    charCountWrap.classList.toggle('warning', len > 270);
});

// Submit → ir a pantalla de carga
document.getElementById('profileForm').addEventListener('submit', function() {
    sessionStorage.setItem('showCreating', '1');
});
</script>