@model HabitTrackerApp.Models.VerifyCodeViewModel

@{
    ViewData["Title"] = "Verificar Código";
    Layout = "_LayoutLogin";
}

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:Inter,system-ui;
    background:#0d1117;
    overflow-x:hidden;
}

#plexus-bg {
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    z-index:0;
    pointer-events:none;
}

.verify-wrapper {
    position:relative;
    z-index:2;
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:100vh;
    padding:30px 20px;
    overflow-y:auto;
}

.verify-card {
    width:420px;
    max-width:95%;
    padding:36px 32px;
    border-radius:22px;
    background:rgba(20,30,50,0.88);
    backdrop-filter:blur(20px);
    border:1px solid rgba(255,255,255,0.08);
    box-shadow:0 25px 60px rgba(0,0,0,0.7);
}

.verify-header {
    text-align:center;
    margin-bottom:28px;
}

.verify-icon {
    font-size:44px;
    display:block;
    margin-bottom:12px;
    animation:bounce 1.2s ease;
}

@@keyframes bounce {
    0% { transform:translateY(-20px); opacity:0; }
    60% { transform:translateY(6px); }
    100% { transform:translateY(0); opacity:1; }
}

.verify-header h2 {
    color:white;
    font-size:22px;
    font-weight:700;
    margin:0 0 8px;
}

.verify-header p {
    color:rgba(255,255,255,0.4);
    font-size:13px;
    margin:0;
    line-height:1.5;
}

.steps {
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    margin-bottom:24px;
}

.step {
    display:flex;
    align-items:center;
    gap:6px;
    font-size:12px;
    color:rgba(255,255,255,0.35);
}

.step.active { color:rgba(255,255,255,0.85); }

.step-num {
    width:22px; height:22px;
    border-radius:50%;
    background:rgba(255,255,255,0.08);
    display:flex; align-items:center; justify-content:center;
    font-size:11px; font-weight:700;
}

.step.active .step-num {
    background:#6366f1;
    color:white;
}

.step-line {
    width:24px; height:1px;
    background:rgba(255,255,255,0.1);
}

.field { margin-bottom:14px; }

.field label {
    display:block;
    font-size:12px;
    color:rgba(255,255,255,0.5);
    text-transform:uppercase;
    letter-spacing:0.6px;
    font-weight:600;
    margin-bottom:6px;
}

.field input {
    width:100%;
    padding:11px 14px;
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.1);
    border-radius:10px;
    color:white;
    font-size:14px;
    outline:none;
    transition:0.2s;
}

.field input[readonly] {
    opacity:0.5;
    cursor:not-allowed;
}

.field input:focus {
    background:rgba(255,255,255,0.09);
    border-color:#6366f1;
    box-shadow:0 0 0 3px rgba(99,102,241,0.15);
}

.field input::placeholder { color:rgba(255,255,255,0.2); }

.code-input {
    font-size:22px !important;
    font-weight:800 !important;
    letter-spacing:8px !important;
    text-align:center !important;
}

.password-wrap { position:relative; }

.pw-toggle {
    position:absolute;
    right:14px;
    top:50%;
    transform:translateY(-50%);
    cursor:pointer;
    font-size:16px;
    opacity:0.5;
    transition:0.2s;
}

.pw-toggle:hover { opacity:1; }

.strength-bar {
    height:3px;
    background:rgba(255,255,255,0.08);
    border-radius:10px;
    margin-top:8px;
    overflow:hidden;
}

.strength-fill {
    height:100%;
    border-radius:10px;
    width:0%;
    transition:width 0.3s, background 0.3s;
}

.strength-label {
    font-size:11px;
    color:rgba(255,255,255,0.35);
    margin-top:4px;
    text-align:right;
}

.text-danger { font-size:11px; color:#f87171; margin-top:2px; display:block; }

.alert {
    border-radius:10px;
    font-size:13px;
    margin-bottom:16px;
    padding:12px 16px;
}

.alert-danger { background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.25); color:#fca5a5; }
.alert-warning { background:rgba(234,179,8,0.1); border:1px solid rgba(234,179,8,0.25); color:#fde68a; }

.btn-verify {
    width:100%;
    padding:13px;
    border-radius:10px;
    border:none;
    background:linear-gradient(90deg,#10b981,#059669);
    color:white;
    font-weight:700;
    font-size:15px;
    cursor:pointer;
    transition:0.2s;
    margin-top:6px;
    position:relative;
    overflow:hidden;
}

.btn-verify::before {
    content:"";
    position:absolute;
    top:0; left:-100%;
    width:100%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.2),transparent);
    transition:0.5s;
}

.btn-verify:hover::before { left:100%; }
.btn-verify:hover { transform:scale(1.02); box-shadow:0 8px 20px rgba(16,185,129,0.4); }

.back-link {
    text-align:center;
    margin-top:18px;
    font-size:13px;
    color:rgba(255,255,255,0.35);
}

.back-link a {
    color:#4da6ff;
    font-weight:600;
    text-decoration:none;
}

.back-link a:hover { color:#1a8cff; }
</style>

<canvas id="plexus-bg"></canvas>

<div class="verify-wrapper">
<div class="verify-card">

    <div class="verify-header">
        <span class="verify-icon">🔑</span>
        <h2>Verificar código</h2>
        <p>Ingresa el código recibido y crea tu nueva contraseña</p>
    </div>

    <div class="steps">
        <div class="step">
            <div class="step-num">✓</div>
            <span>Correo</span>
        </div>
        <div class="step-line"></div>
        <div class="step">
            <div class="step-num">✓</div>
            <span>Código</span>
        </div>
        <div class="step-line"></div>
        <div class="step active">
            <div class="step-num">3</div>
            <span>Contraseña</span>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (TempData["GeneratedCode"] != null)
    {
        <div class="alert alert-warning">
            🔢 Código de prueba: <strong>@TempData["GeneratedCode"]</strong>
        </div>
    }

    <form asp-action="VerifyCode" method="post">
        @Html.AntiForgeryToken()

        <div class="field">
            <label>Correo</label>
            <input asp-for="Email" readonly />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="field">
            <label>Código recibido</label>
            <input asp-for="Code" class="code-input" placeholder="000000" maxlength="6" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="field">
            <label>Nueva contraseña</label>
            <div class="password-wrap">
                <input asp-for="NewPassword" type="password" id="newPw" placeholder="••••••••" />
                <span class="pw-toggle" onclick="togglePw()">👁️</span>
            </div>
            <div class="strength-bar">
                <div class="strength-fill" id="strengthFill"></div>
            </div>
            <div class="strength-label" id="strengthLabel"></div>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-verify">
            ✅ Cambiar contraseña
        </button>
    </form>

    <div class="back-link">
        <a asp-action="Login">← Volver al inicio de sesión</a>
    </div>

</div>
</div>

<script>
function togglePw() {
    const input = document.getElementById("newPw");
    const icon = document.querySelector(".pw-toggle");
    if (input.type === "password") {
        input.type = "text";
        icon.textContent = "🙈";
    } else {
        input.type = "password";
        icon.textContent = "👁️";
    }
}

document.getElementById("newPw").addEventListener("input", function() {
    const val = this.value;
    const fill = document.getElementById("strengthFill");
    const label = document.getElementById("strengthLabel");
    let strength = 0;

    if (val.length >= 8) strength++;
    if (/[A-Z]/.test(val)) strength++;
    if (/[0-9]/.test(val)) strength++;
    if (/[^A-Za-z0-9]/.test(val)) strength++;

    const colors = ["#ef4444","#f97316","#eab308","#22c55e"];
    const labels = ["Muy débil","Débil","Media","Fuerte"];
    const widths = ["25%","50%","75%","100%"];

    if (val.length === 0) {
        fill.style.width = "0%";
        label.textContent = "";
    } else {
        const idx = Math.min(strength - 1, 3);
        fill.style.width = widths[idx];
        fill.style.background = colors[idx];
        label.textContent = labels[idx];
        label.style.color = colors[idx];
    }
});

// PLEXUS
const canvas = document.getElementById("plexus-bg");
const ctx = canvas.getContext("2d");

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
resize();
window.addEventListener("resize", resize);

let pts = [];
for (let i = 0; i < 80; i++) {
    pts.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
    });
}

function drawPlexus() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
            const dx = pts[i].x - pts[j].x;
            const dy = pts[i].y - pts[j].y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < 160) {
                ctx.beginPath();
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
                ctx.strokeStyle = `rgba(16,185,129,${0.2 * (1 - dist/160)})`;
                ctx.lineWidth = 0.6;
                ctx.stroke();
            }
        }
    }
    pts.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(16,185,129,0.7)";
        ctx.fill();
    });
    requestAnimationFrame(drawPlexus);
}
drawPlexus();
</script>