@model HabitTrackerApp.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutLogin";
}

<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:Inter,system-ui;
    background:#0d1117;
    overflow:hidden;
}

#plexus-bg {
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    z-index:0;
    pointer-events:none;
}

.forgot-wrapper {
    position:relative;
    z-index:2;
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:100vh;
    padding:30px 20px;
}

.forgot-card {
    width:420px;
    max-width:95%;
    padding:36px 32px;
    border-radius:22px;
    background:rgba(20,30,50,0.88);
    backdrop-filter:blur(20px);
    border:1px solid rgba(255,255,255,0.08);
    box-shadow:0 25px 60px rgba(0,0,0,0.7);
}

.forgot-header {
    text-align:center;
    margin-bottom:28px;
}

.forgot-icon {
    font-size:44px;
    display:block;
    margin-bottom:12px;
    animation:bounce 1.2s ease;
}

@@keyframes bounce {
    0% { transform:translateY(-20px); opacity:0; }
    60% { transform:translateY(6px); }
    100% { transform:translateY(0); opacity:1; }
}

.forgot-header h2 {
    color:white;
    font-size:22px;
    font-weight:700;
    margin:0 0 8px;
}

.forgot-header p {
    color:rgba(255,255,255,0.4);
    font-size:13px;
    margin:0;
    line-height:1.5;
}

.info-box {
    display:flex;
    align-items:flex-start;
    gap:12px;
    background:rgba(37,99,235,0.1);
    border:1px solid rgba(37,99,235,0.25);
    border-radius:12px;
    padding:14px 16px;
    margin-bottom:24px;
}

.info-box-icon { font-size:18px; flex-shrink:0; margin-top:1px; }

.info-box p {
    font-size:13px;
    color:rgba(255,255,255,0.6);
    margin:0;
    line-height:1.5;
}

.field { margin-bottom:14px; }

.field label {
    display:block;
    font-size:12px;
    color:rgba(255,255,255,0.5);
    text-transform:uppercase;
    letter-spacing:0.6px;
    font-weight:600;
    margin-bottom:6px;
}

.field input {
    width:100%;
    padding:11px 14px;
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.1);
    border-radius:10px;
    color:white;
    font-size:14px;
    outline:none;
    transition:0.2s;
}

.field input:focus {
    background:rgba(255,255,255,0.09);
    border-color:#2563eb;
    box-shadow:0 0 0 3px rgba(37,99,235,0.15);
}

.field input::placeholder { color:rgba(255,255,255,0.2); }

.text-danger { font-size:11px; color:#f87171; margin-top:2px; display:block; }

.btn-forgot {
    width:100%;
    padding:13px;
    border-radius:10px;
    border:none;
    background:linear-gradient(90deg,#2563eb,#1d4ed8);
    color:white;
    font-weight:700;
    font-size:15px;
    cursor:pointer;
    transition:0.2s;
    margin-top:6px;
    position:relative;
    overflow:hidden;
}

.btn-forgot::before {
    content:"";
    position:absolute;
    top:0; left:-100%;
    width:100%; height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,0.2),transparent);
    transition:0.5s;
}

.btn-forgot:hover::before { left:100%; }
.btn-forgot:hover { transform:scale(1.02); box-shadow:0 8px 20px rgba(37,99,235,0.4); }

.back-link {
    text-align:center;
    margin-top:18px;
    font-size:13px;
    color:rgba(255,255,255,0.35);
}

.back-link a {
    color:#4da6ff;
    font-weight:600;
    text-decoration:none;
}

.back-link a:hover { color:#1a8cff; }

.alert { border-radius:10px; font-size:13px; margin-bottom:16px; }
</style>

<canvas id="plexus-bg"></canvas>

<div class="forgot-wrapper">
<div class="forgot-card">

    <div class="forgot-header">
        <span class="forgot-icon">🔐</span>
        <h2>Recuperar contraseña</h2>
        <p>Ingresa tu correo y te enviaremos un código de verificación</p>
    </div>

    <div class="info-box">
        <span class="info-box-icon">💡</span>
        <p>Te enviaremos un código de 6 dígitos al correo registrado. Revisa también tu carpeta de spam.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary()
        </div>
    }

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div class="field">
            <label>Correo registrado</label>
            <input asp-for="Email" placeholder="tu@correo.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-forgot">
            📨 Enviar código de verificación
        </button>
    </form>

    <div class="back-link">
        <a asp-controller="Account" asp-action="Login">← Volver al inicio de sesión</a>
    </div>

</div>
</div>

<script>
const canvas = document.getElementById("plexus-bg");
const ctx = canvas.getContext("2d");

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
resize();
window.addEventListener("resize", resize);

let pts = [];
for (let i = 0; i < 80; i++) {
    pts.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
    });
}

function drawPlexus() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
            const dx = pts[i].x - pts[j].x;
            const dy = pts[i].y - pts[j].y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < 160) {
                ctx.beginPath();
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
                ctx.strokeStyle = `rgba(37,99,235,${0.2 * (1 - dist/160)})`;
                ctx.lineWidth = 0.6;
                ctx.stroke();
            }
        }
    }
    pts.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(96,165,250,0.7)";
        ctx.fill();
    });
    requestAnimationFrame(drawPlexus);
}
drawPlexus();
</script>