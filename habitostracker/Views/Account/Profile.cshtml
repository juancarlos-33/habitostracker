@model HabitTrackerApp.Models.User

@{
    ViewData["Title"] = "Mi Perfil";
    var culture = new System.Globalization.CultureInfo("es-ES");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />

@if (TempData["Success"] != null)
{
    <div class="profile-alert">✅ @TempData["Success"]</div>
}

<!-- FOTO DE PORTADA -->
<div class="cover-wrap" id="coverWrap">
    @if (!string.IsNullOrEmpty(Model.CoverImage))
    {
        <img src="@Model.CoverImage" class="cover-img" id="coverImg" />
    }
    else
    {
        <div class="cover-placeholder" id="coverImg">
            <div class="cover-gradient"></div>
        </div>
    }
    @if (Model.IsPremium)
    {
        <label class="cover-edit-btn" for="coverInput">
            📷 Cambiar portada
        </label>
        <input type="file" id="coverInput" accept="image/*" style="display:none;" onchange="uploadCover(this)" />
    }
    else
    {
        <div class="cover-lock-btn">
            🔒 <a href="/User/Pay" style="color:white;text-decoration:none;">Premium para portada</a>
        </div>
    }
</div>

<div class="profile-wrapper">

    <!-- COLUMNA IZQUIERDA -->
    <div class="profile-left">

      <div class="avatar-section">
    @{
        var pic = !string.IsNullOrEmpty(Model.ProfileImage)
            ? Model.ProfileImage
            : Model.ProfilePicture;
    }
    @if (!string.IsNullOrEmpty(pic))
    {
        <img id="previewImage" src="@pic" class="profile-avatar"
             onerror="this.style.display='none';document.getElementById('previewLetter').style.display='flex';"/>
        <div id="previewLetter" class="profile-avatar-letter" style="display:none;">
            @Model.Username.Substring(0, 1).ToUpper()
        </div>
    }
    else
    {
        <div id="previewLetter" class="profile-avatar-letter">
            @Model.Username.Substring(0, 1).ToUpper()
        </div>
    }
    <div class="avatar-overlay" onclick="document.getElementById('imageInput').click()">
        📷
    </div>
</div>

        <h2 class="profile-name">@Model.Username</h2>

        @if (!string.IsNullOrEmpty(Model.FullName))
        {
            <p class="profile-fullname">@Model.FullName</p>
        }

        <p class="profile-bio-preview">@(string.IsNullOrEmpty(Model.Bio) ? "Sin biografía aún..." : Model.Bio)</p>

        @if (Model.IsGoogleAccount)
        {
            <div class="google-badge">
                <img src="https://developers.google.com/identity/images/g-logo.png" style="width:14px;" />
                Cuenta de Google
            </div>
        }

        @if (Model.IsPremium)
        {
            <div class="premium-badge">👑 Usuario Premium</div>
        }

        <div class="follow-stats">
            <div class="follow-stat" onclick="if(@ViewBag.Followers > 0) openModal('followers')">
                <span class="stat-num">@ViewBag.Followers</span>
                <span class="stat-label">Seguidores</span>
            </div>
            <div class="follow-divider"></div>
            <div class="follow-stat" onclick="if(@ViewBag.Following > 0) openModal('following')">
                <span class="stat-num">@ViewBag.Following</span>
                <span class="stat-label">Siguiendo</span>
            </div>
        </div>

        @if (Model.CreatedAt.HasValue)
        {
            <div class="member-since">
                📅 Miembro desde @Model.CreatedAt.Value.ToString("dd MMM yyyy", culture)
            </div>
        }

        <button type="button" id="removePhotoBtn" data-no-loader class="remove-photo-btn">
            🗑️ Eliminar foto
        </button>
    </div>

    <!-- COLUMNA DERECHA -->
    <div class="profile-right">
        <form asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data" data-no-loader>
            @Html.AntiForgeryToken()
            <input type="hidden" id="croppedImageInput" name="croppedImage" />
            <input type="file" id="imageInput" name="profilePhoto" accept="image/*" style="display:none;" />

            <div class="form-section">
                <div class="section-header">
                    <h4 class="section-title">✏️ Información personal</h4>
                    <span class="section-subtitle">Actualiza tus datos de perfil</span>
                </div>

                <div class="fields-grid">
                    <div class="field-group">
                        <label class="field-label">Usuario</label>
                        <div class="field-input-wrapper">
                            <input class="field-input" value="@Model.Username" disabled />
                            <span class="field-icon">🔒</span>
                        </div>
                    </div>

                    <div class="field-group">
                        <label class="field-label">Nombre completo</label>
                        <div class="field-input-wrapper">
                            <input asp-for="FullName" class="field-input" placeholder="Tu nombre completo" />
                            <span class="field-icon">👤</span>
                        </div>
                    </div>

                    <div class="field-group full-width">
                        <label class="field-label">Correo electrónico</label>
                        <div class="field-input-wrapper">
                            <input asp-for="Email" class="field-input" disabled />
                            <span class="field-icon">📧</span>
                        </div>
                    </div>

                    <div class="field-group full-width">
                        <label class="field-label">Biografía</label>
                        <textarea asp-for="Bio" class="field-textarea" rows="3" placeholder="Cuéntanos sobre ti..."></textarea>
                        <span class="field-hint">Máximo 300 caracteres</span>
                    </div>
                </div>
            </div>

            <div class="form-section" id="cropperSection" style="display:none;">
                <div class="section-header">
                    <h4 class="section-title">✂️ Recortar imagen</h4>
                    <span class="section-subtitle">Ajusta tu foto antes de guardar</span>
                </div>
                <img id="cropImage" style="max-width:100%;" />
                <button type="button" id="cropButton" data-no-loader class="crop-btn">✂️ Confirmar recorte</button>
            </div>

            <!-- PANEL PERSONALIZACIÓN -->
<div class="form-section" id="customSection">
    <div class="section-header">
        <h4 class="section-title">🎨 Personalización</h4>
        <span class="section-subtitle">Ajusta la apariencia a tu gusto</span>
    </div>

    <!-- AVATARES -->
<div style="margin-bottom:24px;">
    <label class="field-label">Avatar prediseñado</label>
    <p style="font-size:12px;color:#9ca3af;margin:4px 0 12px;">Elige un avatar o sube tu propia foto</p>

    <!-- ESTILOS -->
    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;" id="avatarStyles">
        @foreach (var style in new[] {
            ("pixel-art","🎮 Pixel Art"),("adventurer","🧝 Adventurer"),
            ("notionists","🌸 Notionists"),("bottts","👾 Bottts"),
            ("lorelei","🦊 Lorelei"),("personas","🎭 Personas"),("micah","🐱 Micah")
        })
        {
            <button type="button" class="style-btn" data-style="@style.Item1"
                    onclick="loadAvatarStyle('@style.Item1')"
                    style="padding:6px 12px;border-radius:8px;border:2px solid #e5e7eb;background:white;font-size:12px;font-weight:600;cursor:pointer;transition:0.2s;color:#374151;">
                @style.Item2
            </button>
        }
    </div>

    <!-- GRID DE AVATARES -->
    <div id="avatarGrid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-height:280px;overflow-y:auto;padding:4px;"></div>

    <div id="avatarLoading" style="text-align:center;padding:20px;color:#9ca3af;display:none;">
        ⏳ Cargando avatares...
    </div>

    <!-- AVATAR SELECCIONADO -->
    <div id="avatarSelected" style="display:none;margin-top:12px;padding:12px;background:#f0fdf4;border:1px solid #86efac;border-radius:12px;display:flex;align-items:center;gap:12px;">
        <img id="avatarSelectedImg" style="width:48px;height:48px;border-radius:50%;" />
        <div>
            <div style="font-size:13px;font-weight:700;color:#15803d;">✅ Avatar seleccionado</div>
            <div style="font-size:11px;color:#9ca3af;">Guarda los cambios para aplicarlo</div>
        </div>
        <button type="button" onclick="cancelAvatar()" style="margin-left:auto;background:none;border:none;color:#9ca3af;cursor:pointer;font-size:18px;">✕</button>
    </div>

    <input type="hidden" id="selectedAvatarUrl" name="selectedAvatarUrl" />
</div>

    <!-- COLOR ACENTO -->
    <div style="margin-bottom:24px;">
        <label class="field-label">Color principal</label>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;" id="colorPalette">
            @foreach (var c in new[] {
                ("#2563eb","Azul"),("#7c3aed","Morado"),("#db2777","Rosa"),
                ("#dc2626","Rojo"),("#ea580c","Naranja"),("#16a34a","Verde"),
                ("#0891b2","Cian"),("#d97706","Dorado"),("#111827","Negro"),
                ("#6366f1","Índigo")
            })
            {
                <button type="button" class="color-swatch" data-color="@c.Item1"
                        title="@c.Item2"
                        style="width:36px;height:36px;border-radius:50%;background:@c.Item1;border:3px solid transparent;cursor:pointer;transition:0.2s;"
                        onclick="setAccentColor('@c.Item1')">
                </button>
            }
            <!-- Color personalizado -->
            <label title="Color personalizado" style="width:36px;height:36px;border-radius:50%;overflow:hidden;cursor:pointer;border:3px solid #e5e7eb;display:flex;align-items:center;justify-content:center;font-size:18px;">
                🎨
                <input type="color" id="customColorInput" style="opacity:0;position:absolute;width:0;height:0;" oninput="setAccentColor(this.value)"/>
            </label>
        </div>
        <div style="margin-top:10px;display:flex;align-items:center;gap:8px;">
            <div id="colorPreview" style="width:20px;height:20px;border-radius:50%;background:var(--primary);"></div>
            <span style="font-size:12px;color:#9ca3af;" id="colorLabel">Color actual</span>
        </div>
    </div>

    <!-- FUENTE -->
    <div style="margin-bottom:24px;">
        <label class="field-label">Fuente</label>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
            @foreach (var f in new[] {
                ("Plus Jakarta Sans","Jakarta"),("Inter","Inter"),
                ("Poppins","Poppins"),("Montserrat","Montserrat")
            })
            {
                <button type="button" class="font-btn" data-font="@f.Item1"
                        onclick="setFont('@f.Item1')"
                        style="padding:8px 16px;border-radius:10px;border:2px solid #e5e7eb;background:white;font-family:'@f.Item1',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:0.2s;color:#374151;">
                    @f.Item2
                </button>
            }
        </div>
    </div>

    <!-- TAMAÑO DE TEXTO -->
    <div style="margin-bottom:8px;">
        <label class="field-label">Tamaño de texto</label>
        <div style="display:flex;gap:8px;margin-top:8px;">
            @foreach (var s in new[] { ("small","Pequeño","13px"), ("normal","Normal","15px"), ("large","Grande","17px") })
            {
                <button type="button" class="size-btn" data-size="@s.Item1"
                        onclick="setFontSize('@s.Item1','@s.Item3')"
                        style="flex:1;padding:10px;border-radius:10px;border:2px solid #e5e7eb;background:white;font-size:@s.Item3;font-weight:600;cursor:pointer;transition:0.2s;color:#374151;">
                    @s.Item2
                </button>
            }
        </div>
    </div>

    <!-- RESET -->
    <button type="button" onclick="resetCustomization()" data-no-loader
            style="margin-top:16px;padding:9px 18px;border-radius:10px;border:1px solid #e5e7eb;background:white;font-size:12px;font-weight:600;color:#6b7280;cursor:pointer;transition:0.2s;">
        🔄 Restablecer valores
    </button>
</div>

            <button type="submit" class="save-btn">
                💾 Guardar cambios
            </button>
        </form>
    </div>
</div>

<!-- MODAL SEGUIDORES -->
<div id="followModal" class="follow-modal" style="display:none;">
    <div class="follow-content">
        <div class="follow-header">
            <span id="modalTitle">Usuarios</span>
            <span class="close-btn" onclick="closeModal()">✖</span>
        </div>
        <div id="followList"></div>
    </div>
</div>

<style>
    .color-swatch:hover { transform: scale(1.15); }
.color-swatch.active { border-color: white !important; box-shadow: 0 0 0 2px var(--primary); }
.font-btn:hover { border-color: var(--primary) !important; color: var(--primary) !important; }
.font-btn.active { border-color: var(--primary) !important; background: var(--primary) !important; color: white !important; }
.size-btn:hover { border-color: var(--primary) !important; color: var(--primary) !important; }
.size-btn.active { border-color: var(--primary) !important; background: var(--primary) !important; color: white !important; }

body.bg-dark #customSection { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .color-swatch { border-color: #3d3d4d !important; }
body.bg-dark .font-btn,
body.bg-dark .size-btn { background: #2d2d3d !important; border-color: #3d3d4d !important; color: #f1f5f9 !important; }
body.bg-dark .font-btn.active,
body.bg-dark .size-btn.active { background: var(--primary) !important; color: white !important; }
.cover-wrap {
    position: relative; width: 100%; height: 200px;
    border-radius: 22px; overflow: hidden; margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12); max-width: 960px; margin-left: auto; margin-right: auto;
}
.cover-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cover-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #1e293b, #334155); }
.cover-gradient { width: 100%; height: 100%; background: linear-gradient(135deg, rgba(99,102,241,0.3), rgba(37,99,235,0.2), rgba(124,58,237,0.3)); }
.cover-edit-btn {
    position: absolute; bottom: 14px; right: 14px;
    background: rgba(0,0,0,0.6); backdrop-filter: blur(8px);
    color: white; padding: 8px 16px; border-radius: 20px;
    font-size: 12px; font-weight: 700; cursor: pointer;
    border: 1px solid rgba(255,255,255,0.15); transition: 0.2s;
}
.cover-edit-btn:hover { background: rgba(0,0,0,0.8); }
.cover-lock-btn {
    position: absolute; bottom: 14px; right: 14px;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(8px);
    color: rgba(255,255,255,0.7); padding: 8px 16px; border-radius: 20px;
    font-size: 12px; font-weight: 700; border: 1px solid rgba(255,255,255,0.1);
}

.profile-alert {
    background: linear-gradient(135deg, #dcfce7, #bbf7d0);
    color: #15803d; padding: 14px 20px; border-radius: 14px;
    margin-bottom: 24px; font-weight: 600; font-size: 14px;
    border: 1px solid #86efac; display: flex; align-items: center; gap: 8px;
    max-width: 960px; margin-left: auto; margin-right: auto;
}

.profile-wrapper {
    display: grid; grid-template-columns: 280px 1fr;
    gap: 24px; max-width: 960px; margin: 0 auto;
}

@@media (max-width: 768px) {
    .profile-wrapper { grid-template-columns: 1fr; }
    .profile-left { position: static !important; }
    .fields-grid { grid-template-columns: 1fr !important; }
    .full-width { grid-column: 1 !important; }
    .cover-wrap { border-radius: 14px; height: 150px; }
}

@@media (min-width: 769px) {
    .profile-left { position: sticky; top: 20px; }
}

.profile-left {
    background: white; border-radius: 24px; padding: 32px 24px;
    text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid rgba(0,0,0,0.05); height: fit-content;
}

.avatar-section { position: relative; width: 120px; height: 120px; margin: 0 auto 20px; }

.profile-avatar {
    width: 120px; height: 120px; border-radius: 50%; object-fit: cover;
    border: 4px solid white; box-shadow: 0 4px 20px rgba(0,0,0,0.15); display: block;
}

.profile-avatar-letter {
    width: 120px; height: 120px; border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed); color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 42px; font-weight: 800; border: 4px solid white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.style-btn:hover { border-color: var(--primary) !important; color: var(--primary) !important; }
.style-btn.active { border-color: var(--primary) !important; background: var(--primary) !important; color: white !important; }
.avatar-option {
    border-radius: 16px; overflow: hidden; cursor: pointer;
    border: 3px solid transparent; transition: 0.2s; aspect-ratio: 1;
    display: flex; align-items: center; justify-content: center;
    background: #f9fafb; padding: 6px;
}
.avatar-option:hover { border-color: var(--primary); transform: scale(1.05); }
.avatar-option.selected { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.2); }
.avatar-option img { width: 100%; height: 100%; object-fit: cover; }

body.bg-dark .style-btn { background: #2d2d3d !important; border-color: #3d3d4d !important; color: #f1f5f9 !important; }
body.bg-dark .style-btn.active { background: var(--primary) !important; color: white !important; }
body.bg-dark .avatar-option { background: #2d2d3d !important; }
body.bg-dark #avatarSelected { background: #14532d !important; border-color: #16a34a !important; }

.avatar-overlay {
    position: absolute; bottom: 2px; right: 2px;
    width: 34px; height: 34px; background: #2563eb; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; cursor: pointer; border: 3px solid white;
    transition: 0.2s; box-shadow: 0 2px 8px rgba(37,99,235,0.4);
}
.avatar-overlay:hover { background: #1d4ed8; transform: scale(1.1); }

.profile-name { font-size: 20px; font-weight: 800; color: #111827; margin: 0 0 4px; }
.profile-fullname { font-size: 14px; color: #6b7280; margin: 0 0 8px; font-weight: 500; }
.profile-bio-preview { font-size: 13px; color: #9ca3af; margin-bottom: 16px; line-height: 1.6; font-style: italic; }

.google-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: #eff6ff; color: #2563eb; padding: 5px 12px; border-radius: 20px;
    font-size: 12px; font-weight: 600; margin-bottom: 10px;
}

.premium-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    color: #92400e; padding: 5px 14px; border-radius: 20px;
    font-size: 12px; font-weight: 700; margin-bottom: 10px; border: 1px solid #fcd34d;
}

.follow-stats {
    display: flex; align-items: center; justify-content: center;
    gap: 20px; margin: 16px 0; padding: 16px; background: #f9fafb; border-radius: 16px;
}
.follow-stat {
    display: flex; flex-direction: column; align-items: center;
    cursor: pointer; transition: 0.2s; padding: 4px 8px; border-radius: 10px;
}
.follow-stat:hover { background: #f3f4f6; }
.follow-stat:hover .stat-num { color: #2563eb; }
.stat-num { font-size: 22px; font-weight: 800; color: #111827; }
.stat-label { font-size: 11px; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
.follow-divider { width: 1px; height: 30px; background: #e5e7eb; }

.member-since {
    font-size: 12px; color: #9ca3af; margin: 12px 0;
    padding: 8px 14px; background: #f9fafb; border-radius: 10px;
}

.remove-photo-btn {
    width: 100%; padding: 10px; border: 1px solid #fecaca; background: #fef2f2;
    color: #dc2626; border-radius: 12px; font-size: 13px; font-weight: 600;
    cursor: pointer; transition: 0.2s; margin-top: 8px;
}
.remove-photo-btn:hover { background: #fee2e2; border-color: #fca5a5; }

.profile-right { display: flex; flex-direction: column; gap: 20px; }

.form-section {
    background: white; border-radius: 24px; padding: 28px 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07); border: 1px solid rgba(0,0,0,0.05);
}

.section-header { margin-bottom: 22px; }
.section-title { font-size: 16px; font-weight: 700; color: #111827; margin: 0 0 4px; }
.section-subtitle { font-size: 13px; color: #9ca3af; }

.fields-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.field-group { margin: 0; }
.full-width { grid-column: 1 / -1; }

.field-label {
    display: block; font-size: 12px; font-weight: 700; color: #6b7280;
    text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;
}

.field-input-wrapper { position: relative; }

.field-input {
    width: 100%; padding: 11px 38px 11px 14px; border: 1.5px solid #e5e7eb;
    border-radius: 12px; font-size: 14px; color: #111827; background: white;
    transition: 0.2s; box-sizing: border-box;
}
.field-input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
.field-input:disabled { background: #f9fafb; color: #9ca3af; cursor: not-allowed; }
.field-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 15px; opacity: 0.5; }

.field-textarea {
    width: 100%; padding: 11px 14px; border: 1.5px solid #e5e7eb; border-radius: 12px;
    font-size: 14px; color: #111827; background: white; transition: 0.2s; resize: vertical;
    box-sizing: border-box; font-family: inherit;
}
.field-textarea:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
.field-hint { font-size: 11px; color: #9ca3af; margin-top: 4px; display: block; }

.crop-btn {
    margin-top: 12px; padding: 10px 24px;
    background: linear-gradient(135deg, #16a34a, #15803d);
    color: white; border: none; border-radius: 12px;
    font-weight: 600; cursor: pointer; transition: 0.2s; font-size: 14px; display: block; width: 100%;
}
.crop-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(22,163,74,0.3); }

.save-btn {
    width: 100%; padding: 15px; background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white; border: none; border-radius: 16px; font-size: 15px; font-weight: 700;
    cursor: pointer; transition: 0.2s; box-shadow: 0 4px 15px rgba(37,99,235,0.3); margin-top: 4px;
}
.save-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(37,99,235,0.4); }

.follow-modal {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
    display: flex; justify-content: center; align-items: center; z-index: 9999;
}

.follow-content {
    background: white; border-radius: 24px; padding: 28px;
    width: 380px; max-height: 520px; overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
}

.follow-header {
    display: flex; justify-content: space-between; align-items: center;
    font-weight: 700; font-size: 17px; margin-bottom: 18px;
    color: #111827; padding-bottom: 14px; border-bottom: 1px solid #f3f4f6;
}

.close-btn {
    cursor: pointer; font-size: 16px; color: #9ca3af;
    width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
    border-radius: 50%; transition: 0.2s;
}
.close-btn:hover { background: #f3f4f6; color: #111827; }

