@model HabitTrackerApp.Models.User
@using HabitTrackerApp.Models
@inject HabitTrackerApp.Data.HabitDbContext _context

@{
    ViewData["Title"] = "Mi Perfil";
    var culture = new System.Globalization.CultureInfo("es-ES");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

@if (TempData["Success"] != null)
{
    <div class="prof-alert success">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="prof-alert danger">❌ @TempData["Error"]</div>
}

<div class="my-prof-wrap">

    <!-- ══ COVER ══ -->
    <div class="my-cover-wrap" id="coverWrap">
        @if (!string.IsNullOrEmpty(Model.CoverImage))
        {
            <img src="@Model.CoverImage" class="my-cover-img" id="coverImg" />
        }
        else
        {
            <div class="my-cover-placeholder" id="coverImg">
                <div class="my-cover-dots"></div>
                <div class="my-cover-gradient"></div>
            </div>
        }
        <div class="my-cover-overlay"></div>
        <label class="my-cover-edit-btn" for="coverInput">
            <span>📷</span> Cambiar portada
        </label>
        <input type="file" id="coverInput" accept="image/*" style="display:none;" onchange="uploadCover(this)" />
    </div>

    <!-- ══ LAYOUT ══ -->
    <div class="my-prof-layout">

        <!-- SIDEBAR IZQUIERDA -->
        <div class="my-prof-sidebar">

            <!-- AVATAR CARD -->
            <div class="my-card">
                <div class="my-avatar-zone">
                    <div class="my-avatar-section">
                        @{
                            var pic = !string.IsNullOrEmpty(Model.ProfileImage)
                                ? Model.ProfileImage : Model.ProfilePicture;
                        }
                        @if (!string.IsNullOrEmpty(pic))
                        {
                           <img id="previewImage" src="@pic" class="my-avatar" style="cursor:pointer;"
     onclick="abrirFotoPerfil(this.src)"
     onerror="this.style.display='none';document.getElementById('previewLetter').style.display='flex';"/>
                            <div id="previewLetter" class="my-avatar-letter" style="display:none;">
                                @Model.Username.Substring(0, 1).ToUpper()
                            </div>
                        }
                        else
                        {
                            <div id="previewLetter" class="my-avatar-letter">
                                @Model.Username.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <div class="my-avatar-edit-btn" onclick="document.getElementById('imageInput').click()" title="Cambiar foto">
                            📷
                        </div>
                    </div>

                    <div class="my-user-info">
                        <div class="my-username">
                            @Model.Username
                            @if (Model.IsPremium)
                            { <span class="my-premium-icon" title="Premium">👑</span> }
                            @if (Model.IsPrivate)
                            { <span class="my-private-badge">🔒</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(Model.FullName))
                        { <div class="my-fullname">@Model.FullName</div> }
                        <div class="my-bio-preview">@(string.IsNullOrEmpty(Model.Bio) ? "Sin biografía aún..." : Model.Bio)</div>
                    </div>

                </div>

                <!-- BADGES -->
                <div class="my-badges-row">
                    @if (Model.IsGoogleAccount)
                    {
                        <div class="my-badge google">
                            <img src="https://developers.google.com/identity/images/g-logo.png" style="width:13px;" />
                            Google
                        </div>
                    }
                    @if (Model.IsPremium)
                    {
                        <div class="my-badge premium">👑 Premium</div>
                    }
                    @if (Model.IsPrivate)
                    {
                        <div class="my-badge private">🔒 Privado</div>
                    }
                    else
                    {
                        <div class="my-badge public">🌍 Público</div>
                    }
                </div>

                <!-- STATS -->
                <div class="my-stats-row">
                    <div class="my-stat" onclick="if(@ViewBag.Followers > 0) openFollowModal('followers')">
                        <div class="my-stat-num">@ViewBag.Followers</div>
                        <div class="my-stat-label">Seguidores</div>
                    </div>
                    <div class="my-stat-sep"></div>
                    <div class="my-stat" onclick="if(@ViewBag.Following > 0) openFollowModal('following')">
                        <div class="my-stat-num">@ViewBag.Following</div>
                        <div class="my-stat-label">Siguiendo</div>
                    </div>
                </div>

                @if (Model.CreatedAt.HasValue)
                {
                    <div class="my-meta-item">📅 Miembro desde @Model.CreatedAt.Value.ToString("MMM yyyy", culture)</div>
                }

                <button type="button" id="removePhotoBtn" data-no-loader class="my-remove-photo-btn">
                    🗑️ Eliminar foto de perfil
                </button>
            </div>
        </div>

        <!-- COLUMNA DERECHA -->
        <div class="my-prof-right">
            <form asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data" data-no-loader>
                @Html.AntiForgeryToken()
                <input type="hidden" id="croppedImageInput" name="croppedImage" />
                <input type="file" id="imageInput" name="profilePhoto" accept="image/*" style="display:none;" />

                <!-- ══ INFO PERSONAL ══ -->
                <div class="my-card">
                    <div class="my-card-header">
                        <div>
                            <div class="my-card-title">✏️ Información personal</div>
                            <div class="my-card-sub">Actualiza tus datos de perfil</div>
                        </div>
                    </div>
                    <div class="my-fields-grid">
                        <div class="my-field">
                            <label class="my-label">Usuario</label>
                            <div class="my-input-wrap">
                                <input class="my-input" value="@Model.Username" disabled />
                                <span class="my-input-icon">🔒</span>
                            </div>
                        </div>
                        <div class="my-field">
                            <label class="my-label">Nombre completo</label>
                            <div class="my-input-wrap">
                                <input asp-for="FullName" class="my-input" placeholder="Tu nombre completo" />
                                <span class="my-input-icon">👤</span>
                            </div>
                        </div>
                        <div class="my-field my-full">
                            <label class="my-label">Correo electrónico</label>
                            <div class="my-input-wrap">
                                <input asp-for="Email" class="my-input" disabled />
                                <span class="my-input-icon">📧</span>
                            </div>
                        </div>
                        <div class="my-field my-full">
                            <label class="my-label">Biografía</label>
                            <textarea asp-for="Bio" class="my-textarea" rows="3" placeholder="Cuéntanos sobre ti..." maxlength="300"></textarea>
                            <span class="my-hint">Máximo 300 caracteres</span>
                        </div>
                    </div>
                </div>

                <!-- ══ RECORTAR ══ -->
                <div class="my-card" id="cropperSection" style="display:none;">
                    <div class="my-card-header">
                        <div>
                            <div class="my-card-title">✂️ Recortar imagen</div>
                            <div class="my-card-sub">Ajusta tu foto antes de guardar</div>
                        </div>
                    </div>
                    <img id="cropImage" style="max-width:100%;border-radius:12px;" />
                    <button type="button" id="cropButton" data-no-loader class="my-crop-btn">✂️ Confirmar recorte</button>
                </div>

                <!-- ══ AVATARES ══ -->
                <div class="my-card">
                    <div class="my-card-header">
                        <div>
                            <div class="my-card-title">🧑‍🎤 Avatar prediseñado</div>
                            <div class="my-card-sub">Elige un avatar o sube tu propia foto</div>
                        </div>
                    </div>

                    <div class="my-avatar-styles" id="avatarStyles">
                        @foreach (var style in new[] {
                            ("pixel-art","🎮 Pixel"),("adventurer","🧝 Adventurer"),
                            ("notionists","🌸 Notion"),("bottts","👾 Bottts"),
                            ("lorelei","🦊 Lorelei"),("personas","🎭 Personas"),("micah","🐱 Micah")
                        })
                        {
                            <button type="button" class="my-style-btn" data-style="@style.Item1"
                                    onclick="loadAvatarStyle('@style.Item1')">
                                @style.Item2
                            </button>
                        }
                    </div>

                    <div id="avatarGrid" class="my-avatar-grid"></div>
                    <div id="avatarLoading" style="text-align:center;padding:16px;color:rgba(255,255,255,0.3);display:none;">⏳ Cargando...</div>

                    <div id="avatarSelected" style="display:none;margin-top:12px;padding:12px 16px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2);border-radius:14px;display:flex;align-items:center;gap:12px;">
                        <img id="avatarSelectedImg" style="width:44px;height:44px;border-radius:50%;border:2px solid rgba(34,197,94,0.4);" />
                        <div style="flex:1;">
                            <div style="font-size:13px;font-weight:700;color:#4ade80;">✅ Avatar seleccionado</div>
                            <div style="font-size:11px;color:rgba(255,255,255,0.3);">Guarda los cambios para aplicarlo</div>
                        </div>
                        <button type="button" onclick="cancelAvatar()" style="background:none;border:none;color:rgba(255,255,255,0.3);cursor:pointer;font-size:18px;padding:0;">✕</button>
                    </div>
                    <input type="hidden" id="selectedAvatarUrl" name="selectedAvatarUrl" />
                </div>

                <!-- ══ PERSONALIZACIÓN ══ -->
                <div class="my-card">
                    <div class="my-card-header">
                        <div>
                            <div class="my-card-title">🎨 Personalización</div>
                            <div class="my-card-sub">Ajusta la apariencia a tu gusto</div>
                        </div>
                    </div>

                    <div class="my-custom-section">
                        <label class="my-label">Color principal</label>
                        <div class="my-color-row" id="colorPalette">
                            @foreach (var c in new[] {
                                ("#2563eb","Azul"),("#7c3aed","Morado"),("#db2777","Rosa"),
                                ("#dc2626","Rojo"),("#ea580c","Naranja"),("#16a34a","Verde"),
                                ("#0891b2","Cian"),("#d97706","Dorado"),("#111827","Negro"),("#6366f1","Índigo")
                            })
                            {
                                <button type="button" class="my-color-swatch" data-color="@c.Item1"
                                        title="@c.Item2" style="background:@c.Item1;"
                                        onclick="setAccentColor('@c.Item1')"></button>
                            }
                            <label class="my-color-custom" title="Color personalizado">
                                🎨
                                <input type="color" id="customColorInput" style="opacity:0;position:absolute;width:0;height:0;" oninput="setAccentColor(this.value)"/>
                            </label>
                        </div>
                        <div class="my-color-preview-row">
                            <div id="colorPreview" class="my-color-dot" style="background:var(--primary);"></div>
                            <span id="colorLabel" style="font-size:12px;color:rgba(255,255,255,0.3);">Color actual</span>
                        </div>
                    </div>

                    <div class="my-custom-section">
                        <label class="my-label">Fuente</label>
                        <div class="my-font-row">
                            @foreach (var f in new[] {
                                ("Plus Jakarta Sans","Jakarta"),("Inter","Inter"),
                                ("Poppins","Poppins"),("Montserrat","Montserrat")
                            })
                            {
                                <button type="button" class="my-font-btn" data-font="@f.Item1"
                                        onclick="setFont('@f.Item1')"
                                        style="font-family:'@f.Item1',sans-serif;">
                                    @f.Item2
                                </button>
                            }
                        </div>
                    </div>

                    <div class="my-custom-section">
                        <label class="my-label">Tamaño de texto</label>
                        <div class="my-size-row">
                            @foreach (var s in new[] { ("small","Pequeño","13px"), ("normal","Normal","15px"), ("large","Grande","17px") })
                            {
                                <button type="button" class="my-size-btn" data-size="@s.Item1"
                                        onclick="setFontSize('@s.Item1','@s.Item3')"
                                        style="font-size:@s.Item3;">
                                    @s.Item2
                                </button>
                            }
                        </div>
                    </div>

                    <button type="button" onclick="resetCustomization()" data-no-loader class="my-reset-btn">
                        🔄 Restablecer valores
                    </button>
                </div>

                <!-- ══ PRIVACIDAD ══ -->
                <div class="my-card">
                    <div class="my-card-header">
                        <div>
                            <div class="my-card-title">🔒 Privacidad de la cuenta</div>
                            <div class="my-card-sub">Controla quién puede ver tu perfil y contenido</div>
                        </div>
                    </div>

                    <div class="my-privacy-options">
                        <div class="my-privacy-option @(!Model.IsPrivate ? "active" : "")" onclick="setPrivacy(false)" id="opt-public">
                            <div class="my-privacy-icon">🌍</div>
                            <div class="my-privacy-info">
                                <div class="my-privacy-title">Cuenta pública</div>
                                <div class="my-privacy-desc">Cualquier persona puede ver tu perfil y publicaciones</div>
                            </div>
                            <div class="my-privacy-check" id="check-public">@(!Model.IsPrivate ? "✓" : "")</div>
                        </div>

                        <div class="my-privacy-option @(Model.IsPrivate ? "active" : "")" onclick="setPrivacy(true)" id="opt-private">
                            <div class="my-privacy-icon">🔒</div>
                            <div class="my-privacy-info">
                                <div class="my-privacy-title">Cuenta privada</div>
                                <div class="my-privacy-desc">Solo tus amigos pueden ver tu perfil y publicaciones</div>
                            </div>
                            <div class="my-privacy-check" id="check-private">@(Model.IsPrivate ? "✓" : "")</div>
                        </div>
                    </div>

                    <input type="hidden" id="isPrivateInput" name="IsPrivate" value="@(Model.IsPrivate ? "true" : "false")" />
                </div>
<button type="button" class="my-save-btn" onclick="guardarPerfil()">
    💾 Guardar cambios
</button>
            </form>

            <!-- ══ MIS PUBLICACIONES ══ -->
<!-- ══ MIS PUBLICACIONES (estilo muro) ══ -->
<div class="my-card" style="margin-top:16px;">
    <div class="my-card-header">
        <div class="my-card-title">📸 Mis publicaciones</div>
    </div>
    @{
        // Usamos ViewBag.UserPosts que viene del controlador
        var misPosts = ViewBag.UserPosts as List<Post> ?? new List<Post>();
        var postLikes = ViewBag.PostLikes as Dictionary<int, int> ?? new Dictionary<int, int>();
        var commentCounts = ViewBag.CommentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
        var myLikes = ViewBag.MyLikes as HashSet<int> ?? new HashSet<int>();
        var myId = int.Parse(User.FindFirst("UserId").Value);
    }
    @if (!misPosts.Any())
    {
        <div style="text-align:center; padding:40px 20px; color:rgba(255,255,255,0.3);">
            <div style="font-size:36px;">📭</div>
            <div style="margin-top:8px;">Aún no has publicado nada</div>
            <a href="/Post/Create" style="display:inline-block; margin-top:12px; padding:8px 20px; background:linear-gradient(135deg,#6366f1,#4f46e5); border-radius:30px; color:white; font-size:13px; font-weight:700; text-decoration:none;">➕ Crear publicación</a>
        </div>
    }
    else
    {
        <div class="feed-container" style="max-width:100%; margin:0;">
            @foreach (var post in misPosts)
            {
                var isVideo = !string.IsNullOrEmpty(post.ImagePath) &&
                              (post.ImagePath.Contains("/video/upload/") ||
                               post.ImagePath.EndsWith(".mp4") ||
                               post.ImagePath.EndsWith(".mov") ||
                               post.ImagePath.EndsWith(".webm"));
                var likeCount = postLikes.ContainsKey(post.Id) ? postLikes[post.Id] : 0;
                var isLiked = myLikes.Contains(post.Id);
                var comentarios = commentCounts.ContainsKey(post.Id) ? commentCounts[post.Id] : 0;

                <article class="post-card" id="post-@post.Id" style="background:rgba(255,255,255,0.05); border-radius:20px; padding:16px; margin-bottom:20px; border:1px solid rgba(255,255,255,0.08); transition:0.2s;">
                    <!-- HEADER -->
                    <div class="post-header" style="display:flex; justify-content:space-between; margin-bottom:12px;">
                        <div style="display:flex; gap:10px;">
                            <a asp-controller="User" asp-action="Profile" asp-route-id="@post.UserId" class="avatar-link">
                                @{
                                    var postPic = !string.IsNullOrEmpty(post.User?.ProfileImage) ? post.User.ProfileImage : post.User?.ProfilePicture;
                                }
                                @if (!string.IsNullOrEmpty(postPic))
                                {
                                    <img src="@postPic" style="width:44px; height:44px; border-radius:50%; object-fit:cover;" />
                                }
                                else
                                {
                                    <div style="width:44px; height:44px; border-radius:50%; background:linear-gradient(135deg,#2563eb,#7c3aed); color:white; display:flex; align-items:center; justify-content:center; font-weight:800;">@post.DisplayUsername.Substring(0,1).ToUpper()</div>
                                }
                            </a>
                            <div>
                                <div style="font-weight:700; color:white;">@post.DisplayUsername</div>
                                <div style="font-size:12px; color:rgba(255,255,255,0.4);">@post.CreatedAt.ToString("dd MMM yyyy · hh:mm tt", new System.Globalization.CultureInfo("es-CO"))</div>
                            </div>
                        </div>
                        <div>
                            @if (post.IsSensitive)
                            {
                                <span style="background:#fef3c7; color:#d97706; font-size:10px; padding:3px 8px; border-radius:20px;">⚠️ Sensible</span>
                            }
                        </div>
                    </div>

                    <!-- DESCRIPCIÓN -->
                    @if (!string.IsNullOrEmpty(post.Description))
                    {
                        <p style="font-size:15px; color:rgba(255,255,255,0.7); line-height:1.65; margin:0 0 14px;">@post.Description</p>
                    }

                  function revealBlurred(postId) {
    const img = document.getElementById('img-' + postId);
    const overlay = document.getElementById('overlay-' + postId);
    if (img) {
        img.classList.remove('blurred-image');
        img.style.filter = 'none';
        img.style.transform = 'none';
    }
    if (overlay) overlay.style.display = 'none';
}

                    <!-- STATS (LIKES Y COMENTARIOS) -->
                    <div style="display:flex; justify-content:space-between; font-size:13px; color:#6b7280; padding:4px 2px 8px;">
                        <span id="like-summary-@post.Id">
                            @if (likeCount > 0)
                            {
                                <span>❤️ @likeCount @(likeCount == 1 ? "like" : "likes")</span>
                            }
                        </span>
                        <span>
                            @if (comentarios > 0)
                            {
                                <span>@comentarios @(comentarios == 1 ? "comentario" : "comentarios")</span>
                            }
                        </span>
                    </div>

                    <div style="height:1px; background:rgba(255,255,255,0.08); margin:0 0 8px;"></div>

                    <!-- ACCIONES -->
                    <div style="display:flex; align-items:center; gap:0; flex-wrap:nowrap; overflow-x:auto;">
                        <button class="action-btn like-btn" data-post-id="@post.Id" data-no-loader="true" style="display:inline-flex; align-items:center; gap:5px; padding:8px 10px; background:transparent; border:none; cursor:pointer; color:#6b7280;">
                            <span class="action-icon like-icon" id="like-icon-@post.Id" style="font-size:17px;">@(isLiked ? "❤️" : "🤍")</span>
                            <span class="action-label" style="font-size:12px; font-weight:600;">Me gusta</span>
                        </button>

                        <a asp-controller="Post" asp-action="Comments" asp-route-postId="@post.Id" class="action-btn" style="display:inline-flex; align-items:center; gap:5px; padding:8px 10px; text-decoration:none; color:#6b7280;">
                            <span style="font-size:17px;">💬</span>
                            <span style="font-size:12px; font-weight:600;">Comentar</span>
                        </a>

                        <button class="action-btn" data-no-loader="true" onclick="openShare(@post.Id)" style="display:inline-flex; align-items:center; gap:5px; padding:8px 10px; background:transparent; border:none; cursor:pointer; color:#6b7280;">
                            <span style="font-size:17px;">↪️</span>
                            <span style="font-size:12px; font-weight:600;">Compartir</span>
                        </button>

                        <button class="action-btn save-btn" data-no-loader="true" onclick="savePost(@post.Id, this)" style="display:inline-flex; align-items:center; gap:5px; padding:8px 10px; background:transparent; border:none; cursor:pointer; color:#6b7280;">
                            <span style="font-size:17px;">🔖</span>
                            <span style="font-size:12px; font-weight:600;">Guardar</span>
                        </button>

                        <a asp-controller="Post" asp-action="Report" asp-route-postId="@post.Id" class="action-btn report-btn" style="display:inline-flex; align-items:center; gap:5px; padding:8px 10px; text-decoration:none; color:#6b7280;">
                            <span style="font-size:17px;">🚩</span>
                            <span style="font-size:12px; font-weight:600;">Reportar</span>
                        </a>
                    </div>
                </article>
            }
        </div>
    }

    <!-- SHARE MENU -->
<div id="shareOverlay" class="share-overlay" onclick="closeShare()"></div>
<div id="shareMenu" class="share-menu">
    <div class="share-handle"></div>
    <div class="share-title">Compartir publicación</div>
    <div class="share-options">
        <div class="share-option" onclick="shareWhatsApp()">
            <span class="share-option-icon">📱</span>
            <span>WhatsApp</span>
        </div>
        <div class="share-option" onclick="shareTelegram()">
            <span class="share-option-icon">✈️</span>
            <span>Telegram</span>
        </div>
        <div class="share-option" onclick="shareFacebook()">
            <span class="share-option-icon">📘</span>
            <span>Facebook</span>
        </div>
        <div class="share-option" onclick="copyLink()">
            <span class="share-option-icon">📋</span>
            <span>Copiar link</span>
        </div>
    </div>
    <div class="share-option cancel" onclick="closeShare()">✕ Cancelar</div>
</div>

<!-- LIKE EXPLOSION -->
<div id="likeExplosion" class="like-explosion" style="display:none;">❤️</div>

<!-- COPY ALERT -->
<div id="copyAlert" class="copy-alert">↪ Link copiado</div>
</div>        </div>
    </div>
</div>

<!-- MODAL SEGUIDORES -->
<div id="followModal" class="my-follow-modal" style="display:none;">
    <div class="my-follow-content">
        <div class="my-follow-header">
            <span id="modalTitle">Usuarios</span>
            <button onclick="closeFollowModal()" style="background:rgba(255,255,255,0.08);border:none;color:white;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:14px;">✕</button>
        </div>
        <div id="followList"></div>
    </div>
</div>

<style>
* { box-sizing: border-box; }
.my-prof-wrap { max-width: 980px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; padding-bottom: 60px; }

/* ══ ALERTS ══ */
.prof-alert { padding:13px 18px; border-radius:14px; margin-bottom:20px; font-size:14px; font-weight:600; display:flex; align-items:center; gap:8px; }
.prof-alert.success { background:rgba(34,197,94,0.1); color:#4ade80; border:1px solid rgba(34,197,94,0.2); }
.prof-alert.danger { background:rgba(239,68,68,0.1); color:#f87171; border:1px solid rgba(239,68,68,0.2); }

/* ══ COVER ══ */
