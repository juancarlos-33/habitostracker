    width:34px; height:34px; border-radius:50%; border:3px solid transparent;
    cursor:pointer; transition:0.2s;
}
.my-color-swatch:hover { transform:scale(1.15); }
.my-color-swatch.active { border-color:white; box-shadow:0 0 0 2px var(--primary); }
.my-color-custom {
    width:34px; height:34px; border-radius:50%;
    border:2px solid rgba(255,255,255,0.15); background:rgba(255,255,255,0.06);
    display:flex; align-items:center; justify-content:center;
    font-size:16px; cursor:pointer; transition:0.2s; position:relative;
}
.my-color-custom:hover { border-color:rgba(99,102,241,0.4); }
.my-color-preview-row { display:flex; align-items:center; gap:8px; margin-top:10px; }
.my-color-dot { width:18px; height:18px; border-radius:50%; border:2px solid rgba(255,255,255,0.1); }
.my-font-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
.my-font-btn {
    padding:8px 16px; border-radius:10px; border:1.5px solid rgba(255,255,255,0.1);
    background:rgba(255,255,255,0.04); color:rgba(255,255,255,0.6);
    font-size:13px; font-weight:600; cursor:pointer; transition:0.2s; font-family:inherit;
}
.my-font-btn:hover { border-color:rgba(99,102,241,0.4); color:#818cf8; }
.my-font-btn.active { border-color:#6366f1; background:rgba(99,102,241,0.15); color:#818cf8; }
.my-size-row { display:flex; gap:8px; margin-top:8px; }
.my-size-btn {
    flex:1; padding:10px; border-radius:10px; border:1.5px solid rgba(255,255,255,0.1);
    background:rgba(255,255,255,0.04); color:rgba(255,255,255,0.6);
    font-weight:600; cursor:pointer; transition:0.2s; font-family:inherit;
}
.my-size-btn:hover { border-color:rgba(99,102,241,0.4); color:#818cf8; }
.my-size-btn.active { border-color:#6366f1; background:rgba(99,102,241,0.15); color:#818cf8; }
.my-reset-btn {
    margin-top:16px; padding:9px 18px; border-radius:10px;
    border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.04);
    color:rgba(255,255,255,0.4); font-size:12px; font-weight:600;
    cursor:pointer; transition:0.2s; font-family:inherit;
}
.my-reset-btn:hover { background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.7); }

/* ══ PRIVACIDAD ══ */
.my-privacy-options { display:flex; flex-direction:column; gap:10px; }
.my-privacy-option {
    display:flex; align-items:center; gap:14px;
    padding:16px; border-radius:16px;
    border:1.5px solid rgba(255,255,255,0.08);
    background:rgba(255,255,255,0.03);
    cursor:pointer; transition:0.2s;
}
.my-privacy-option:hover { border-color:rgba(99,102,241,0.3); background:rgba(99,102,241,0.05); }
.my-privacy-option.active { border-color:#6366f1; background:rgba(99,102,241,0.1); }
.my-privacy-icon { font-size:24px; flex-shrink:0; }
.my-privacy-info { flex:1; min-width:0; }
.my-privacy-title { font-size:14px; font-weight:700; color:white; margin-bottom:3px; }
.my-privacy-desc { font-size:12px; color:rgba(255,255,255,0.4); line-height:1.5; }
.my-privacy-check {
    width:24px; height:24px; border-radius:50%; flex-shrink:0;
    border:2px solid rgba(255,255,255,0.15);
    display:flex; align-items:center; justify-content:center;
    font-size:13px; font-weight:800; color:#6366f1;
    background:rgba(99,102,241,0.1);
    transition:0.2s;
}
.my-privacy-option.active .my-privacy-check { border-color:#6366f1; background:rgba(99,102,241,0.2); }

/* ══ SAVE BTN ══ */
.my-save-btn {
    width:100%; padding:16px;
    background:linear-gradient(135deg,#6366f1,#4f46e5);
    color:white; border:none; border-radius:16px;
    font-size:15px; font-weight:800; cursor:pointer; transition:0.2s;
    box-shadow:0 6px 20px rgba(99,102,241,0.4); font-family:inherit;
    letter-spacing:-0.2px;
}
