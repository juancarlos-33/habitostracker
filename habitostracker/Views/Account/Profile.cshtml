@model HabitTrackerApp.Models.User

@{
    ViewData["Title"] = "Mi Perfil";
    var culture = new System.Globalization.CultureInfo("es-ES");
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />

@if (TempData["Success"] != null)
{
    <div class="profile-alert">✅ @TempData["Success"]</div>
}

<div class="profile-wrapper">

    <!-- COLUMNA IZQUIERDA -->
    <div class="profile-left">

        <div class="avatar-section">
            @{
                var pic = !string.IsNullOrEmpty(Model.ProfileImage)
                    ? Model.ProfileImage
                    : Model.ProfilePicture;
            }
            @if (!string.IsNullOrEmpty(pic))
            {
                <img id="previewImage" src="@pic?v=@DateTime.Now.Ticks" class="profile-avatar" />
            }
            else
            {
                <div id="previewLetter" class="profile-avatar-letter">
                    @Model.Username.Substring(0, 1).ToUpper()
                </div>
            }
            <div class="avatar-overlay" onclick="document.getElementById('imageInput').click()">
                📷
            </div>
        </div>

        <h2 class="profile-name">@Model.Username</h2>

        @if (!string.IsNullOrEmpty(Model.FullName))
        {
            <p class="profile-fullname">@Model.FullName</p>
        }

        <p class="profile-bio-preview">@(string.IsNullOrEmpty(Model.Bio) ? "Sin biografía aún..." : Model.Bio)</p>

        @if (Model.IsGoogleAccount)
        {
            <div class="google-badge">
                <img src="https://developers.google.com/identity/images/g-logo.png" style="width:14px;" />
                Cuenta de Google
            </div>
        }

        @if (Model.IsPremium)
        {
            <div class="premium-badge">👑 Usuario Premium</div>
        }

        <div class="follow-stats">
            <div class="follow-stat" onclick="if(@ViewBag.Followers > 0) openModal('followers')">
                <span class="stat-num">@ViewBag.Followers</span>
                <span class="stat-label">Seguidores</span>
            </div>
            <div class="follow-divider"></div>
            <div class="follow-stat" onclick="if(@ViewBag.Following > 0) openModal('following')">
                <span class="stat-num">@ViewBag.Following</span>
                <span class="stat-label">Siguiendo</span>
            </div>
        </div>

        @if (Model.CreatedAt.HasValue)
        {
            <div class="member-since">
                📅 Miembro desde @Model.CreatedAt.Value.ToString("dd MMM yyyy", culture)
            </div>
        }

        <button type="button" id="removePhotoBtn" data-no-loader class="remove-photo-btn">
            🗑️ Eliminar foto
        </button>
    </div>

    <!-- COLUMNA DERECHA -->
    <div class="profile-right">
        <form asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data" data-no-loader>
            @Html.AntiForgeryToken()
            <input type="hidden" id="croppedImageInput" name="croppedImage" />
            <input type="file" id="imageInput" name="profilePhoto" accept="image/*" style="display:none;" />

            <div class="form-section">
                <div class="section-header">
                    <h4 class="section-title">✏️ Información personal</h4>
                    <span class="section-subtitle">Actualiza tus datos de perfil</span>
                </div>

                <div class="fields-grid">
                    <div class="field-group">
                        <label class="field-label">Usuario</label>
                        <div class="field-input-wrapper">
                            <input class="field-input" value="@Model.Username" disabled />
                            <span class="field-icon">🔒</span>
                        </div>
                    </div>

                    <div class="field-group">
                        <label class="field-label">Nombre completo</label>
                        <div class="field-input-wrapper">
                            <input asp-for="FullName" class="field-input" placeholder="Tu nombre completo" />
                            <span class="field-icon">👤</span>
                        </div>
                    </div>

                    <div class="field-group full-width">
                        <label class="field-label">Correo electrónico</label>
                        <div class="field-input-wrapper">
                            <input asp-for="Email" class="field-input" disabled />
                            <span class="field-icon">📧</span>
                        </div>
                    </div>

                    <div class="field-group full-width">
                        <label class="field-label">Biografía</label>
                        <textarea asp-for="Bio" class="field-textarea" rows="3" placeholder="Cuéntanos sobre ti..."></textarea>
                        <span class="field-hint">Máximo 300 caracteres</span>
                    </div>
                </div>
            </div>

            <!-- 🔥 CROPPER oculto, se activa desde el botón de la foto -->
            <div class="form-section" id="cropperSection" style="display:none;">
                <div class="section-header">
                    <h4 class="section-title">✂️ Recortar imagen</h4>
                    <span class="section-subtitle">Ajusta tu foto antes de guardar</span>
                </div>
                <img id="cropImage" style="max-width:100%;" />
                <button type="button" id="cropButton" data-no-loader class="crop-btn">✂️ Confirmar recorte</button>
            </div>

            <button type="submit" class="save-btn">
                💾 Guardar cambios
            </button>
        </form>
    </div>
</div>

<!-- MODAL SEGUIDORES -->
<div id="followModal" class="follow-modal" style="display:none;">
    <div class="follow-content">
        <div class="follow-header">
            <span id="modalTitle">Usuarios</span>
            <span class="close-btn" onclick="closeModal()">✖</span>
        </div>
        <div id="followList"></div>
    </div>
</div>

<style>
.profile-alert {
    background: linear-gradient(135deg, #dcfce7, #bbf7d0);
    color: #15803d;
    padding: 14px 20px;
    border-radius: 14px;
    margin-bottom: 24px;
    font-weight: 600;
    font-size: 14px;
    border: 1px solid #86efac;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* 🔥 PC: 2 columnas | Móvil: 1 columna */
.profile-wrapper {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    max-width: 960px;
    margin: 0 auto;
}

@@media (max-width: 768px) {
    .profile-wrapper {
        grid-template-columns: 1fr;
    }
    .profile-left {
        position: static !important;
    }
    .fields-grid {
        grid-template-columns: 1fr !important;
    }
    .full-width {
        grid-column: 1 !important;
    }
}

@@media (min-width: 769px) {
    .profile-left {
        position: sticky;
        top: 20px;
    }
}

.profile-left {
    background: white;
    border-radius: 24px;
    padding: 32px 24px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid rgba(0,0,0,0.05);
    height: fit-content;
}

.avatar-section {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 20px;
}

.profile-avatar {
    width: 120px; height: 120px;
    border-radius: 50%; object-fit: cover;
    border: 4px solid white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    display: block;
}

.profile-avatar-letter {
    width: 120px; height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 42px; font-weight: 800;
    border: 4px solid white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.avatar-overlay {
    position: absolute;
    bottom: 2px; right: 2px;
    width: 34px; height: 34px;
    background: #2563eb;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; cursor: pointer;
    border: 3px solid white;
    transition: 0.2s;
    box-shadow: 0 2px 8px rgba(37,99,235,0.4);
}

.avatar-overlay:hover { background: #1d4ed8; transform: scale(1.1); }

.profile-name { font-size: 20px; font-weight: 800; color: #111827; margin: 0 0 4px; }
.profile-fullname { font-size: 14px; color: #6b7280; margin: 0 0 8px; font-weight: 500; }
.profile-bio-preview { font-size: 13px; color: #9ca3af; margin-bottom: 16px; line-height: 1.6; font-style: italic; }

.google-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: #eff6ff; color: #2563eb;
    padding: 5px 12px; border-radius: 20px;
    font-size: 12px; font-weight: 600; margin-bottom: 10px;
}

.premium-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    color: #92400e; padding: 5px 14px; border-radius: 20px;
    font-size: 12px; font-weight: 700; margin-bottom: 10px;
    border: 1px solid #fcd34d;
}

.follow-stats {
    display: flex; align-items: center; justify-content: center;
    gap: 20px; margin: 16px 0; padding: 16px;
    background: #f9fafb; border-radius: 16px;
}

.follow-stat {
    display: flex; flex-direction: column; align-items: center;
    cursor: pointer; transition: 0.2s; padding: 4px 8px; border-radius: 10px;
}

.follow-stat:hover { background: #f3f4f6; }
.follow-stat:hover .stat-num { color: #2563eb; }
.stat-num { font-size: 22px; font-weight: 800; color: #111827; }
.stat-label { font-size: 11px; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
.follow-divider { width: 1px; height: 30px; background: #e5e7eb; }

.member-since {
    font-size: 12px; color: #9ca3af; margin: 12px 0;
    padding: 8px 14px; background: #f9fafb; border-radius: 10px;
}

.remove-photo-btn {
    width: 100%; padding: 10px;
    border: 1px solid #fecaca; background: #fef2f2;
    color: #dc2626; border-radius: 12px;
    font-size: 13px; font-weight: 600;
    cursor: pointer; transition: 0.2s; margin-top: 8px;
}

.remove-photo-btn:hover { background: #fee2e2; border-color: #fca5a5; }

.profile-right { display: flex; flex-direction: column; gap: 20px; }

.form-section {
    background: white; border-radius: 24px; padding: 28px 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07); border: 1px solid rgba(0,0,0,0.05);
}

.section-header { margin-bottom: 22px; }
.section-title { font-size: 16px; font-weight: 700; color: #111827; margin: 0 0 4px; }
.section-subtitle { font-size: 13px; color: #9ca3af; }

.fields-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.field-group { margin: 0; }
.full-width { grid-column: 1 / -1; }

.field-label {
    display: block; font-size: 12px; font-weight: 700;
    color: #6b7280; text-transform: uppercase;
    letter-spacing: 0.5px; margin-bottom: 6px;
}

.field-input-wrapper { position: relative; }

.field-input {
    width: 100%; padding: 11px 38px 11px 14px;
    border: 1.5px solid #e5e7eb; border-radius: 12px;
    font-size: 14px; color: #111827; background: white;
    transition: 0.2s; box-sizing: border-box;
}

.field-input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
.field-input:disabled { background: #f9fafb; color: #9ca3af; cursor: not-allowed; }
.field-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 15px; opacity: 0.5; }

.field-textarea {
    width: 100%; padding: 11px 14px;
    border: 1.5px solid #e5e7eb; border-radius: 12px;
    font-size: 14px; color: #111827; background: white;
    transition: 0.2s; resize: vertical;
    box-sizing: border-box; font-family: inherit;
}

.field-textarea:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
.field-hint { font-size: 11px; color: #9ca3af; margin-top: 4px; display: block; }

.crop-btn {
    margin-top: 12px; padding: 10px 24px;
    background: linear-gradient(135deg, #16a34a, #15803d);
    color: white; border: none; border-radius: 12px;
    font-weight: 600; cursor: pointer; transition: 0.2s; font-size: 14px;
    display: block; width: 100%;
}

.crop-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(22,163,74,0.3); }

.save-btn {
    width: 100%; padding: 15px;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white; border: none; border-radius: 16px;
    font-size: 15px; font-weight: 700; cursor: pointer;
    transition: 0.2s; box-shadow: 0 4px 15px rgba(37,99,235,0.3); margin-top: 4px;
}

.save-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(37,99,235,0.4); }

.follow-modal {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
    display: flex; justify-content: center; align-items: center; z-index: 9999;
}

.follow-content {
    background: white; border-radius: 24px; padding: 28px;
    width: 380px; max-height: 520px; overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
}

.follow-header {
    display: flex; justify-content: space-between; align-items: center;
    font-weight: 700; font-size: 17px; margin-bottom: 18px;
    color: #111827; padding-bottom: 14px; border-bottom: 1px solid #f3f4f6;
}

.close-btn {
    cursor: pointer; font-size: 16px; color: #9ca3af;
    width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%; transition: 0.2s;
}

.close-btn:hover { background: #f3f4f6; color: #111827; }

/* DARK MODE */
body.bg-dark .profile-left,
body.bg-dark .form-section { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .profile-name { color: #f1f5f9 !important; }
body.bg-dark .profile-fullname { color: #94a3b8 !important; }
body.bg-dark .section-title { color: #f1f5f9 !important; }
body.bg-dark .field-label { color: #64748b !important; }
body.bg-dark .field-input,
body.bg-dark .field-textarea { background: #2d2d3d !important; border-color: #3d3d4d !important; color: #f1f5f9 !important; }
body.bg-dark .field-input:disabled { background: #252535 !important; color: #64748b !important; }
body.bg-dark .follow-stats { background: #2d2d3d !important; }
body.bg-dark .member-since { background: #2d2d3d !important; color: #64748b !important; }
body.bg-dark .stat-num { color: #f1f5f9 !important; }
body.bg-dark .follow-content { background: #1e1e2e !important; }
body.bg-dark .follow-header { color: #f1f5f9 !important; border-color: #2d2d3d !important; }
body.bg-dark .profile-alert { background: #14532d !important; color: #86efac !important; border-color: #16a34a !important; }
body.bg-dark .profile-bio-preview { color: #64748b !important; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
<script>
let cropper;
const input = document.getElementById("imageInput");
const image = document.getElementById("cropImage");
let preview = document.getElementById("previewImage");
const hiddenInput = document.getElementById("croppedImageInput");
const cropButton = document.getElementById("cropButton");
const cropperSection = document.getElementById("cropperSection");

input.addEventListener("change", function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(event) {
        image.src = event.target.result;
        cropperSection.style.display = "block";
        // 🔥 scroll hasta el cropper en móvil
        cropperSection.scrollIntoView({ behavior: "smooth", block: "start" });
        if (cropper) cropper.destroy();
        cropper = new Cropper(image, {
            aspectRatio: 1, viewMode: 1,
            autoCropArea: 1, zoomable: true
        });
    };
    reader.readAsDataURL(file);
});

cropButton.addEventListener("click", function() {
    if (!cropper) return;
    const canvas = cropper.getCroppedCanvas({ width: 300, height: 300 });
    const base64 = canvas.toDataURL("image/png");

    if (!preview) {
        const letter = document.getElementById("previewLetter");
        if (letter) letter.remove();
        const img = document.createElement("img");
        img.id = "previewImage";
        img.className = "profile-avatar";
        document.querySelector(".avatar-section").prepend(img);
        preview = img;
    }

    preview.src = base64;
    hiddenInput.value = base64;
    cropperSection.style.display = "none";
    cropper.destroy();
    cropper = null;
});

document.getElementById("removePhotoBtn").addEventListener("click", function() {
    hiddenInput.value = "REMOVE";
    if (preview) preview.style.display = "none";
    const oldLetter = document.getElementById("previewLetter");
    if (oldLetter) return;
    const letter = document.createElement("div");
    letter.id = "previewLetter";
    letter.className = "profile-avatar-letter";
    letter.innerText = "@Model.Username.Substring(0, 1).ToUpper()";
    document.querySelector(".avatar-section").prepend(letter);
});

function openModal(type) {
    const modal = document.getElementById("followModal");
    const list = document.getElementById("followList");
    const title = document.getElementById("modalTitle");
    modal.style.display = "flex";
    list.innerHTML = "<div style='text-align:center;padding:20px;color:#9ca3af;'>Cargando...</div>";
    title.innerText = type === "followers" ? "Seguidores" : "Siguiendo";
    fetch(`/User/${type === "followers" ? "GetFollowers" : "GetFollowing"}?userId=@Model.Id`)
        .then(r => r.text())
        .then(data => list.innerHTML = data);
}

function closeModal() {
    document.getElementById("followModal").style.display = "none";
}
</script>