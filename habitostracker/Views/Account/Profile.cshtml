/* ══ AVATARES ══ */
.my-avatar-styles { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; }
.my-style-btn {
    padding:6px 12px; border-radius:10px; border:1.5px solid rgba(255,255,255,0.1);
    background:rgba(255,255,255,0.04); color:rgba(255,255,255,0.6);
    font-size:12px; font-weight:600; cursor:pointer; transition:0.2s; font-family:inherit;
}
.my-style-btn:hover { border-color:rgba(99,102,241,0.4); color:#818cf8; }
.my-style-btn.active { border-color:#6366f1; background:rgba(99,102,241,0.15); color:#818cf8; }
.my-avatar-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; max-height:260px; overflow-y:auto; padding:2px; }
.my-avatar-grid::-webkit-scrollbar { width:4px; }
.my-avatar-grid::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.15); border-radius:10px; }
.my-avatar-opt {
    border-radius:14px; overflow:hidden; cursor:pointer;
    border:2.5px solid transparent; transition:0.2s; aspect-ratio:1;
    background:rgba(255,255,255,0.04); padding:6px;
}
.my-avatar-opt:hover { border-color:rgba(99,102,241,0.5); transform:scale(1.04); }
.my-avatar-opt.selected { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,0.25); }
.my-avatar-opt img { width:100%; height:100%; object-fit:cover; border-radius:8px; }

/* ══ PERSONALIZACIÓN ══ */
.my-custom-section { margin-bottom:20px; }
.my-custom-section:last-child { margin-bottom:0; }
.my-color-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
