/* ══ FOLLOW MODAL ══ */
.my-follow-modal {
    position:fixed; inset:0; background:rgba(0,0,0,0.7); backdrop-filter:blur(8px);
    display:flex; justify-content:center; align-items:center; z-index:9999;
}
.my-follow-content {
    background:linear-gradient(135deg,#1a1f35,#111827);
    border-radius:24px; padding:24px; width:380px; max-height:520px; overflow-y:auto;
    box-shadow:0 30px 70px rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.08);
}
.my-follow-header {
    display:flex; justify-content:space-between; align-items:center;
    font-weight:800; font-size:16px; color:white; margin-bottom:16px;
    padding-bottom:14px; border-bottom:1px solid rgba(255,255,255,0.07);
}
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
<script>
let cropper;
const input = document.getElementById("imageInput");
const image = document.getElementById("cropImage");

const hiddenInput = document.getElementById("croppedImageInput");
const cropperSection = document.getElementById("cropperSection");

input.addEventListener("change", function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(event) {
        image.src = event.target.result;
        cropperSection.style.display = "block";
        cropperSection.scrollIntoView({ behavior:"smooth", block:"start" });
        if (cropper) cropper.destroy();
        cropper = new Cropper(image, { aspectRatio:1, viewMode:1, autoCropArea:1, zoomable:true });
    };
    reader.readAsDataURL(file);
});

// ══ FOTO PERFIL EXPANDIBLE ══
function abrirFotoPerfil(src) {
    const overlay = document.createElement('div');
    overlay.id = 'photoOverlay';
    overlay.style.cssText = `
        position:fixed;inset:0;z-index:999999;
        background:rgba(0,0,0,0.85);backdrop-filter:blur(12px);
        display:flex;align-items:center;justify-content:center;
        animation:fadeInPhoto 0.25s ease;cursor:pointer;
    `;

    overlay.innerHTML = `
        <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:16px;">
            <img src="${src}" style="
                width:280px;height:280px;border-radius:50%;object-fit:cover;
                border:4px solid rgba(255,255,255,0.15);
                box-shadow:0 20px 60px rgba(0,0,0,0.6);
                animation:scaleInPhoto 0.3s cubic-bezier(0.34,1.56,0.64,1);
            "/>
            <button onclick="cerrarFotoPerfil()" style="
                background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);
                color:white;padding:8px 24px;border-radius:20px;
                font-size:13px;font-weight:700;cursor:pointer;
                font-family:inherit;transition:0.2s;
            " onmouseover="this.style.background='rgba(255,255,255,0.2)'"
               onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                ✕ Cerrar
            </button>
        </div>
    `;

    // cerrar al click fuera
    overlay.addEventListener('click', function(e) {
        if (e.target === this) cerrarFotoPerfil();
    });

    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
}

function cerrarFotoPerfil() {
    const overlay = document.getElementById('photoOverlay');
    if (overlay) {
        overlay.style.opacity = '0';
        overlay.style.transition = 'opacity 0.2s';
        setTimeout(() => { overlay.remove(); document.body.style.overflow = ''; }, 200);
    }
}

document.getElementById("cropButton").addEventListener("click", function() {
    if (!cropper) return;
    const canvas = cropper.getCroppedCanvas({ width:300, height:300 });
    const base64 = canvas.toDataURL("image/png");

    // actualizar preview
    let previewEl = document.getElementById("previewImage");
    if (!previewEl) {
        previewEl = document.createElement("img");
        previewEl.id = "previewImage";
        previewEl.className = "my-avatar";
        previewEl.style.cursor = "pointer";
        previewEl.onclick = function() { abrirFotoPerfil(this.src); };
        document.querySelector(".my-avatar-section").prepend(previewEl);
    }
    previewEl.src = base64;
    previewEl.style.display = "block";

    const letter = document.getElementById("previewLetter");
    if (letter) letter.style.display = "none";

    // guardar en hidden input
    hiddenInput.value = base64;

    cropperSection.style.display = "none";
    cropper.destroy();
    cropper = null;
});

document.getElementById("removePhotoBtn").addEventListener("click", function() {
    hiddenInput.value = "REMOVE";
    const previewEl = document.getElementById("previewImage");
    if (previewEl) previewEl.style.display = "none";
    const oldLetter = document.getElementById("previewLetter");
    if (oldLetter) { oldLetter.style.display = "flex"; return; }
    const letter = document.createElement("div");
    letter.id = "previewLetter"; letter.className = "my-avatar-letter";
    letter.innerText = "@Model.Username.Substring(0, 1).ToUpper()";
    document.querySelector(".my-avatar-section").prepend(letter);
});

// ══ PRIVACIDAD ══
function setPrivacy(isPrivate) {
    document.getElementById('isPrivateInput').value = isPrivate ? 'true' : 'false';
    document.getElementById('opt-public').classList.toggle('active', !isPrivate);
    document.getElementById('opt-private').classList.toggle('active', isPrivate);
    document.getElementById('check-public').textContent = !isPrivate ? '✓' : '';
    document.getElementById('check-private').textContent = isPrivate ? '✓' : '';
}

// ══ PERSONALIZACIÓN ══
function setAccentColor(color) {
    document.documentElement.style.setProperty('--primary', color);
    document.documentElement.style.setProperty('--accent', color);
    localStorage.setItem('ht_color', color);
    document.getElementById('colorPreview').style.background = color;
    document.getElementById('colorLabel').textContent = color;
    document.querySelectorAll('.my-color-swatch').forEach(s => {
        s.classList.toggle('active', s.dataset.color === color);
        s.style.borderColor = s.dataset.color === color ? 'white' : 'transparent';
    });
}

function setFont(font) {
    document.body.style.fontFamily = "'" + font + "', sans-serif";
    localStorage.setItem('ht_font', font);
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://fonts.googleapis.com/css2?family=' + font.replace(/ /g,'+') + ':wght@400;500;600;700;800&display=swap';
    document.head.appendChild(link);
    document.querySelectorAll('.my-font-btn').forEach(b => b.classList.toggle('active', b.dataset.font === font));
}

function setFontSize(size, px) {
    document.documentElement.style.fontSize = px;
    localStorage.setItem('ht_size', size);
    localStorage.setItem('ht_size_px', px);
    document.querySelectorAll('.my-size-btn').forEach(b => b.classList.toggle('active', b.dataset.size === size));
}

function resetCustomization() {
    localStorage.removeItem('ht_color');
    localStorage.removeItem('ht_font');
    localStorage.removeItem('ht_size');
    localStorage.removeItem('ht_size_px');
    document.documentElement.style.setProperty('--primary', '#2563eb');
    document.documentElement.style.setProperty('--accent', '#7c3aed');
    document.body.style.fontFamily = "'Plus Jakarta Sans', sans-serif";
    document.documentElement.style.fontSize = '15px';
    document.querySelectorAll('.my-color-swatch,.my-font-btn,.my-size-btn').forEach(b => b.classList.remove('active'));
    setAccentColor('#2563eb');
}

// ══ AVATARES ══
const avatarSeeds = ['Felix','Luna','Max','Sofia','Alex','Mia','Jake','Zoe','Leo','Emma','Sam','Lily','Tom','Nora','Ben','Eva','Rio','Aria','Kai','Maya','Ash','Iris','Rey','Nova'];
let currentStyle = 'adventurer';

function loadAvatarStyle(style) {
    currentStyle = style;
    document.querySelectorAll('.my-style-btn').forEach(b => b.classList.toggle('active', b.dataset.style === style));
    const grid = document.getElementById('avatarGrid');
    const loading = document.getElementById('avatarLoading');
    grid.innerHTML = '';
    loading.style.display = 'block';
    let loaded = 0;
    avatarSeeds.forEach(seed => {
        const url = 'https://api.dicebear.com/7.x/' + style + '/png?seed=' + seed + '&size=200&backgroundColor=b6e3f4,c0aede,d1d4f9,ffd5dc,ffdfbf';
        const div = document.createElement('div');
        div.className = 'my-avatar-opt';
        div.onclick = () => selectAvatar(url, div);
        const img = document.createElement('img');
        img.src = url;
        img.onload = () => { loaded++; if (loaded >= avatarSeeds.length) loading.style.display = 'none'; };
        img.onerror = () => { loaded++; div.style.display = 'none'; if (loaded >= avatarSeeds.length) loading.style.display = 'none'; };
        div.appendChild(img);
        grid.appendChild(div);
    });
    setTimeout(() => loading.style.display = 'none', 3000);
}

function selectAvatar(url, el) {
    document.getElementById('selectedAvatarUrl').value = url;
    document.getElementById('avatarSelectedImg').src = url;
    document.getElementById('avatarSelected').style.display = 'flex';
    document.querySelectorAll('.my-avatar-opt').forEach(a => a.classList.remove('selected'));
    el.classList.add('selected');
    const letter = document.getElementById('previewLetter');
    if (letter) letter.style.display = 'none';
    let prev = document.getElementById('previewImage');
    if (prev) { prev.src = url; prev.style.display = 'block'; }
    else {
        const img = document.createElement('img');
        img.id = 'previewImage'; img.className = 'my-avatar'; img.src = url;
        document.querySelector('.my-avatar-section').prepend(img);
    }
}

function cancelAvatar() {
    document.getElementById('selectedAvatarUrl').value = '';
    document.getElementById('avatarSelected').style.display = 'none';
    document.querySelectorAll('.my-avatar-opt').forEach(a => a.classList.remove('selected'));
}

// ══ COVER ══
async function uploadCover(input) {
    const file = input.files[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('coverPhoto', file);
    formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
    const btn = document.querySelector('.my-cover-edit-btn');
    if (btn) btn.innerHTML = '<span>⏳</span> Subiendo...';
    try {
        const res = await fetch('/Account/UpdateCover', { method:'POST', body:formData });
        const data = await res.json();
        if (data.success) {
            const wrap = document.getElementById('coverImg');
            if (wrap.tagName === 'IMG') { wrap.src = data.coverUrl; }
            else {
                const img = document.createElement('img');
                img.src = data.coverUrl; img.className = 'my-cover-img'; img.id = 'coverImg';
                wrap.replaceWith(img);
            }
            if (btn) btn.innerHTML = '<span>📷</span> Cambiar portada';
        } else {
            alert(data.error ?? 'Error al subir');
            if (btn) btn.innerHTML = '<span>📷</span> Cambiar portada';
        }
    } catch(e) {
        if (btn) btn.innerHTML = '<span>📷</span> Cambiar portada';
    }
}

// ══ FOLLOW MODAL ══
function openFollowModal(type) {
    const modal = document.getElementById("followModal");
    const list = document.getElementById("followList");
    document.getElementById("modalTitle").innerText = type === "followers" ? "Seguidores" : "Siguiendo";
    modal.style.display = "flex";
    list.innerHTML = "<div style='text-align:center;padding:20px;color:rgba(255,255,255,0.3);'>Cargando...</div>";
    fetch('/User/' + (type === "followers" ? "GetFollowers" : "GetFollowing") + '?userId=@Model.Id')
        .then(r => r.text()).then(data => list.innerHTML = data);
}

function closeFollowModal() {
    document.getElementById("followModal").style.display = "none";
}

document.getElementById("followModal").addEventListener("click", function(e) {
    if (e.target === this) closeFollowModal();
});

// ══ INIT ══
document.addEventListener('DOMContentLoaded', () => {
    loadAvatarStyle('adventurer');
    const color = localStorage.getItem('ht_color');
    const font = localStorage.getItem('ht_font');
    const sizePx = localStorage.getItem('ht_size_px');
    const size = localStorage.getItem('ht_size');
    if (color) setAccentColor(color);
    if (font) setFont(font);
    if (sizePx) {
        document.documentElement.style.fontSize = sizePx;
        document.querySelectorAll('.my-size-btn').forEach(b => b.classList.toggle('active', b.dataset.size === size));
    }
});
</script>