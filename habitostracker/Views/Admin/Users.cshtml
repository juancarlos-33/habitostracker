                        { <a target="_blank" class="ml" href="https://maps.google.com/?q=@(user.Latitude.Value.ToString("F6",System.Globalization.CultureInfo.InvariantCulture)),@(user.Longitude.Value.ToString("F6",System.Globalization.CultureInfo.InvariantCulture))">🗺️ Ver en mapa</a> }
