                                    @if (user.Latitude != null && user.Longitude != null)
                                    {
                                        <a target="_blank" class="ml" href="https://maps.google.com/?q=@(user.Latitude.Value.ToString("F6",System.Globalization.CultureInfo.InvariantCulture)),@(user.Longitude.Value.ToString("F6",System.Globalization.CultureInfo.InvariantCulture))">🗺️ Ver mapa</a>
                                    }
                                    @if (isSuperAdmin && user.Id != myId)
                                    {
                                        @if (isBlockedIp)
                                        {
                                            <form asp-controller="Admin" asp-action="UnblockIP" method="post" style="margin:0">
                                                <input type="hidden" name="ip" value="@user.LastIp"/>
                                                <button class="ipb ub" onclick="return confirm('¿Desbloquear IP?')">🔓 Desbloquear IP</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Admin" asp-action="BlockIP" method="post" style="margin:0" onsubmit="return confirm('¿Bloquear IP?')">
                                                <input type="hidden" name="ip" value="@user.LastIp"/>
                                                <button type="submit" class="ipb bl">🚫 Bloquear IP</button>
                                            </form>
                                        }
                                    }
                                </div>
                            }
                            else { <span style="color:#9ca3af;">—</span> }
                        </td>
                        <td>
                            @if (user.Role != "SuperAdmin")
                            {
                                <div class="dc">
                                    @if (!string.IsNullOrEmpty(user.OperatingSystem)) { <span>🖥️ @user.OperatingSystem</span> }
                                    @if (!string.IsNullOrEmpty(user.Device)) { <span>📱 @user.Device</span> }
                                    @if (!string.IsNullOrEmpty(user.Browser)) { <span>🌐 @user.Browser</span> }
                                </div>
                            }
                            else { <span style="color:#9ca3af;">—</span> }
                        </td>
                        <td>
                            <div class="acc">
                                @if (user.Role == "SuperAdmin") { <span class="bd ow">Propietario</span> }
                                else if (user.Id == myId) { <span class="bd gu">Tu cuenta</span> }
                                else
                                {
                                    if (!user.IsActive)
                                    {
                                        <a asp-controller="Admin" asp-action="ReactivateUser" asp-route-id="@user.Id" class="ab su" onclick="return confirm('¿Reactivar?')">🔓 Reactivar</a>
                                    }
                                    else if (user.IsBanned)
                                    {
                                        <a asp-controller="Admin" asp-action="UnbanUser" asp-route-id="@user.Id" class="ab su" onclick="return confirm('¿Desbanear?')">🔓 Desbanear</a>
                                    }
                                    else
                                    {
                                        if (isAdminUser && !isSuperAdmin)
                                        {
                                            <button class="ab da" onclick="mostrarWarn()">🔒 Desactivar</button>
                                            <button class="ab wa" onclick="mostrarWarn()">🚫 Banear</button>
                                        }
                                        else
                                        {
                                            <button class="ab da" onclick="confirmDelete(@user.Id)">🔒 Desactivar</button>
                                            <a asp-controller="Admin" asp-action="BanUser" asp-route-id="@user.Id" class="ab wa" onclick="return confirm('¿Banear?')">🚫 Banear</a>
                                        }
                                        @if (isSuperAdmin)
                                        {
                                            <a asp-controller="Admin" asp-action="DeleteUserPermanently" asp-route-id="@user.Id" class="ab dl" onclick="return confirm('¿Eliminar permanentemente?')">💀 Eliminar</a>
                                            if (user.Role == "Admin")
                                            { <a href="#" class="ab se" onclick="event.preventDefault();confirmRemoveAdmin(@user.Id)">⬇️ Quitar Admin</a> }
                                            else
                                            { <a asp-controller="Admin" asp-action="MakeAdmin" asp-route-id="@user.Id" class="ab pr2" onclick="return confirm('¿Hacer Admin?')">⬆️ Hacer Admin</a> }
                                            @if (user.IsIpBlocked)
                                            { <button class="ab ub2" onclick="desbloquearConexion(@user.Id,'@user.Username')" data-no-loader="true">🔓 Desbloquear conexión</button> }
                                            else
                                            { <button class="ab bc" onclick="confirmarBloquearConexion(@user.Id,'@user.Username')" data-no-loader="true">🔌 Bloquear conexión</button> }
                                        }
                                    }
                                    @if (isSuperAdmin && user.Id != myId)
                                    {
                                        <form asp-controller="Admin" asp-action="ResetPassword" method="post" style="display:inline">
                                            <input type="hidden" name="userId" value="@user.Id"/>
                                            <button class="ab ne" onclick="return confirm('¿Resetear contraseña?')">🔑 Reset</button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- MOBILE CARDS -->
    <div class="mc2">
        @foreach (var user in Model)
        {
            var blockedIps = ViewBag.BlockedIps as List<string> ?? new List<string>();
            bool isBlockedIp = user.LastIp != null && blockedIps.Contains(user.LastIp);
            bool isAdminUser = user.Role == "Admin";
            var photo = user.ProfileImage ?? user.ProfilePicture ?? "";

            <div class="mcard user-row" data-username="@user.Username.ToLower()" data-blocked="@user.IsIpBlocked.ToString().ToLower()">
                <div class="mct">
                    <div class="uc">
                        @if (user.Role == "SuperAdmin")
                        {
                            @if (!string.IsNullOrEmpty(photo)) { <img src="@photo" class="uth"/> }
                            else { <div class="utl">@user.Username.Substring(0,1).ToUpper()</div> }
                        }
                        else
                        {
                            <a href="/User/Profile/@user.Id" style="text-decoration:none;">
                                @if (!string.IsNullOrEmpty(photo)) { <img src="@photo" class="uth"/> }
                                else { <div class="utl">@user.Username.Substring(0,1).ToUpper()</div> }
                            </a>
                        }
                        <div>
                            @if (user.Role == "SuperAdmin") { <div class="un">@user.Username</div> }
                            else { <a href="/User/Profile/@user.Id" class="un" style="text-decoration:none;color:inherit;">@user.Username</a> }
                            <div style="display:flex;gap:3px;margin-top:3px;flex-wrap:wrap;">
                                @if (user.Role == "SuperAdmin") { <span class="bd ow">👑 SuperAdmin</span> }
                                else if (user.Role == "Admin") { <span class="bd ad">🛡️ Admin</span> }
                                @if (user.IsPremium) { <span class="bd pr">✨ Pro</span> }
                            </div>
                        </div>
                    </div>
                    <div id="status-mob-@user.Id">
                        @if (user.IsBanned) { <span class="st bn">🚫</span> }
                        else if (!user.IsActive) { <span class="st in">⚠️</span> }
                        else if (user.LastOnline != null && (DateTime.Now - user.LastOnline.Value).TotalSeconds < 60) { <span class="st a">🟢</span> }
                        else { <span class="st of">⚫</span> }
                    </div>
                </div>
                @if (user.Role != "SuperAdmin")
                {
                    <div class="mi">
                        <div class="mir"><span class="mic">📧</span><span>@(user.Role == "Guest" ? "Invitado" : (user.Email ?? "—"))</span></div>
