@inject HabitTrackerApp.Data.HabitDbContext _context
@model List<HabitTrackerApp.Models.User>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@{
    var myId = int.Parse(User.FindFirst("UserId").Value);
    var me = _context.Users.FirstOrDefault(u => u.Id == myId);
    var activeNow = Model.Count(u =>
        u.IsActive && !u.IsBanned && u.LastOnline != null &&
        (DateTime.Now - u.LastOnline.Value).TotalSeconds < 60);
    var block = Context.RequestServices
        .GetService<HabitTrackerApp.Data.HabitDbContext>()
        .ConnectionBlocks.FirstOrDefault();
    bool isBlocked = block != null && block.IsBlocked;
    var ipInfo = ViewBag.IpInfo as Dictionary<string, (string country, string region, string city, string isp)>;
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<!-- ADVERTENCIA ADMIN -->
<div id="adminWarningOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:999999;align-items:center;justify-content:center;flex-direction:column;backdrop-filter:blur(12px);">
    <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg"
         style="width:90px;height:90px;border-radius:22px;border:3px solid #ef4444;box-shadow:0 0 0 8px rgba(239,68,68,0.15),0 8px 30px rgba(0,0,0,0.5);margin-bottom:20px;animation:warnBounce 0.5s cubic-bezier(0.34,1.56,0.64,1);" />
    <div style="background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid rgba(239,68,68,0.3);border-radius:24px;padding:28px 32px;text-align:center;max-width:360px;width:90%;box-shadow:0 30px 60px rgba(0,0,0,0.5);">
        <div style="font-size:32px;margin-bottom:12px;">⛔</div>
        <div style="font-size:17px;font-weight:800;color:white;margin-bottom:8px;">Acción no permitida</div>
        <div style="font-size:13px;color:rgba(255,255,255,0.5);line-height:1.6;">No puedes banear ni desactivar a otro administrador. Esta acción va en contra de las normas del sistema.<br><br><span style="color:#fbbf24;font-weight:700;">⚠️ El propietario ha sido notificado.</span></div>
    </div>
</div>

<!-- MODAL CÓDIGO ADMIN -->
<div id="codeModal" class="code-modal">
    <div class="code-box">
        <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg"
             style="width:56px;height:56px;border-radius:14px;margin-bottom:14px;border:2px solid rgba(99,102,241,0.4);" />
        <h5 style="margin:0 0 6px;color:white;font-size:16px;font-weight:800;">⚠️ Autorización requerida</h5>
        <p style="font-size:12px;opacity:0.5;margin:0 0 14px;">Ingresa el código de 5 dígitos</p>
        <input type="text" id="codeInput" maxlength="5" inputmode="numeric"
               placeholder="• • • • •" oninput="this.value = this.value.replace(/\D/g, '')" />
        <div id="codeError" class="code-error"></div>
        <div class="code-actions">
            <button onclick="validarCodigo()">Aceptar</button>
            <button onclick="cerrarModal()">Cancelar</button>
        </div>
    </div>
</div>

<div class="admin-page">

    <!-- HERO HEADER -->
    <div class="admin-hero">
        <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg"
             class="admin-hero-mascot" alt="mascota" />
        <div class="admin-hero-info">
            <div class="admin-hero-badge">🛡️ Panel de Control</div>
            <div class="admin-hero-title">Centro de Administración</div>
            <div class="admin-hero-sub">Gestiona usuarios, conexiones y seguridad · <strong style="color:white;">@me?.Username</strong></div>
        </div>
        <div class="admin-hero-right">
            <!-- CONEXIÓN -->
            <div class="connection-pill @(isBlocked ? "blocked" : "active")">
                <span class="conn-dot @(isBlocked ? "red" : "green")"></span>
                @(isBlocked ? "🔴 Bloqueada" : "🟢 Activa")
            </div>
            @if (isBlocked)
            {
                <form asp-controller="Admin" asp-action="ToggleConnectionBlock" method="post" style="margin-top:8px;">
                    <button class="conn-action-btn restore">🔓 Restaurar</button>
                </form>
            }
            else if (me?.Role == "SuperAdmin")
            {
                <form asp-controller="Admin" asp-action="ToggleConnectionBlock" method="post" style="margin-top:8px;">
                    <button class="conn-action-btn block" onclick="return confirm('¿Bloquear la conexión global?')">🔒 Bloquear global</button>
                </form>
            }
            else if (me?.Role == "Admin")
            {
                <button class="conn-action-btn block" onclick="pedirCodigoAdmin()" style="margin-top:8px;">🔒 Bloquear global</button>
            }
        </div>
    </div>

    <!-- KPIs -->
    <div class="kpi-grid">
        <div class="kpi-card" onclick="showAll()" style="cursor:pointer;">
            <div class="kpi-icon-wrap blue">👥</div>
            <div>
                <div class="kpi-val">@Model.Count</div>
                <div class="kpi-lbl">Usuarios</div>
            </div>
        </div>
        <div class="kpi-card kpi-clickable" onclick="filterByStatus('banned')">
            <div class="kpi-icon-wrap red">🚫</div>
            <div>
                <div class="kpi-val red">@Model.Count(u => u.IsBanned)</div>
                <div class="kpi-lbl">Baneados</div>
            </div>
        </div>
        <div class="kpi-card kpi-clickable" onclick="filterByStatus('inactive')">
            <div class="kpi-icon-wrap yellow">⚠️</div>
            <div>
                <div class="kpi-val yellow">@Model.Count(u => !u.IsActive)</div>
                <div class="kpi-lbl">Desactivados</div>
            </div>
        </div>
        <div class="kpi-card kpi-clickable" onclick="filterByStatus('active')">
            <div class="kpi-icon-wrap green">✅</div>
            <div>
                <div class="kpi-val green" id="activeUsers">@activeNow</div>
                <div class="kpi-lbl">Activos ahora</div>
            </div>
        </div>
    </div>

    <!-- ACCIONES -->
    <div class="quick-actions">
        <button class="quick-btn neutral" onclick="showAll()" data-no-loader>👥 Todos</button>
        <a asp-controller="Admin" asp-action="Reports" class="quick-btn red">🚩 Reportes</a>
        @if (isSuperAdmin)
        {
            <form asp-controller="Admin" asp-action="GenerateAccessCode" method="post" style="display:inline">
                <button type="submit" class="quick-btn yellow">🔑 Generar código</button>
            </form>
        }
    </div>

    @if (TempData["GeneratedCode"] != null)
    {
        <div class="info-pill green">🔐 Código generado: <strong>@TempData["GeneratedCode"]</strong></div>
    }
    @if (TempData["NewPassword"] != null)
    {
        <div class="info-pill green">🔑 Nueva contraseña: <strong>@TempData["NewPassword"]</strong></div>
    }

    <!-- BUSCADOR -->
    <div class="search-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" id="searchUser" placeholder="Buscar usuario por nombre..." class="search-input" />
    </div>

    <!-- TABLA DESKTOP -->
    <div class="table-wrap">
        <table class="users-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th>Ubicación</th>
                    <th>Dispositivo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var blockedIps = ViewBag.BlockedIps as List<string> ?? new List<string>();
                    bool isBlockedIp = user.LastIp != null && blockedIps.Contains(user.LastIp);
                    bool isAdminUser = user.Role == "Admin";

                    <tr class="user-row" data-username="@user.Username.ToLower()">
                        <td>
                            <div class="user-cell">
                                @if (user.Role == "SuperAdmin")
                                {
                                    @if (!string.IsNullOrEmpty(user.ProfileImage))
                                    { <img src="@user.ProfileImage" class="user-thumb" /> }
                                    else
                                    { <div class="user-thumb-letter">@user.Username.Substring(0,1).ToUpper()</div> }
                                }
                                else
                                {
                                    <a href="/User/Profile/@user.Id" style="text-decoration:none;flex-shrink:0;">
                                        @if (!string.IsNullOrEmpty(user.ProfileImage))
                                        { <img src="@user.ProfileImage" class="user-thumb" /> }
                                        else
                                        { <div class="user-thumb-letter">@user.Username.Substring(0,1).ToUpper()</div> }
                                    </a>
                                }
                                <div>
                                    @if (user.Role == "SuperAdmin")
                                    { <div class="user-name">@user.Username</div> }
                                    else
                                    { <a href="/User/Profile/@user.Id" class="user-name" style="text-decoration:none;color:inherit;">@user.Username</a> }
                                    <div style="display:flex;gap:4px;margin-top:3px;flex-wrap:wrap;">
                                        @if (user.Role == "SuperAdmin") { <span class="badge owner">👑 SuperAdmin</span> }
                                        else if (user.Role == "Admin") { <span class="badge admin">🛡️ Admin</span> }
                                        else if (user.Role == "Guest") { <span class="badge guest">👤 Invitado</span> }
                                        @if (user.IsPremium) { <span class="badge premium">✨ Pro</span> }
                                        @if (user.IsGoogleAccount) { <span class="badge google">G</span> }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="text-sm text-muted">
                            @if (user.Role == "SuperAdmin") { <span>🔒 Privado</span> }
                            else if (user.Role == "Guest") { <span>👤 Invitado</span> }
                            else { @user.Email }
                        </td>
                        <td id="status-@user.Id">
                            @if (user.IsBanned) { <span class="status-tag banned">🚫 Baneado</span> }
                            else if (!user.IsActive) { <span class="status-tag inactive">⚠️ Desactivado</span> }
                            else if (user.LastOnline != null && (DateTime.Now - user.LastOnline.Value).TotalSeconds < 60)
                            { <span class="status-tag active">🟢 Activo</span> }
                            else { <span class="status-tag offline">⚫ Inactivo</span> }
                        </td>
                        <td class="text-sm">
                            @if (user.Role != "SuperAdmin")
                            {
                                <div class="location-cell">
                                    @if (!string.IsNullOrEmpty(user.Country))
                                    {
                                        <span>🌍 @user.Country</span>
                                    }
                                    @if (!string.IsNullOrEmpty(user.City))
                                    {
                                        <span>🏙️ @user.City</span>
                                    }
                                    @if (!string.IsNullOrEmpty(user.Municipality))
                                    {
                                        <span>📍 @user.Municipality</span>
                                    }
                                    <span class="ip-text">🌐 @(user.LastIp ?? "—")</span>
                                    @if (user.Latitude != null && user.Longitude != null)
                                    {
                                        <a target="_blank" class="map-link"
                                           href="https://maps.google.com/?q=@(user.Latitude.Value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)),@(user.Longitude.Value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture))">
                                            🗺️ Ver mapa
                                        </a>
                                    }
                                    @if (isSuperAdmin && user.Id != myId)
                                    {
                                        @if (isBlockedIp)
                                        {
                                            <form asp-controller="Admin" asp-action="UnblockIP" method="post" style="margin:0">
                                                <input type="hidden" name="ip" value="@user.LastIp" />
                                                <button class="ip-btn unblock" onclick="return confirm('¿Desbloquear IP?')">🔓 Desbloquear IP</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Admin" asp-action="BlockIP" method="post" style="margin:0" onsubmit="return confirm('¿Bloquear IP?')">
                                                <input type="hidden" name="ip" value="@user.LastIp" />
                                                <button type="submit" class="ip-btn block">🚫 Bloquear IP</button>
                                            </form>
                                        }
                                    }
                                </div>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-sm">
                            @if (user.Role != "SuperAdmin")
                            {
                                <div class="device-cell">
                                    @if (!string.IsNullOrEmpty(user.OperatingSystem)) { <span>🖥️ @user.OperatingSystem</span> }
                                    @if (!string.IsNullOrEmpty(user.Device)) { <span>📱 @user.Device</span> }
                                    @if (!string.IsNullOrEmpty(user.Browser)) { <span>🌐 @user.Browser</span> }
                                </div>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>
                            <div class="actions-cell">
                                @if (user.Role == "SuperAdmin")
                                { <span class="badge owner">Propietario</span> }
                                else if (user.Id == myId)
                                { <span class="badge guest">Tu cuenta</span> }
                                else
                                {
                                    if (!user.IsActive)
                                    {
                                        <a asp-controller="Admin" asp-action="ReactivateUser" asp-route-id="@user.Id"
                                           class="action-btn success" onclick="return confirm('¿Reactivar?')">🔓 Reactivar</a>
                                    }
                                    else if (user.IsBanned)
                                    {
                                        <a asp-controller="Admin" asp-action="UnbanUser" asp-route-id="@user.Id"
                                           class="action-btn success" onclick="return confirm('¿Desbanear?')">🔓 Desbanear</a>
                                    }
                                    else
                                    {
                                        if (isAdminUser && !isSuperAdmin)
                                        {
                                            <button class="action-btn danger" onclick="mostrarAdvertenciaAdmin()">🔒 Desactivar</button>
                                            <button class="action-btn warning" onclick="mostrarAdvertenciaAdmin()">🚫 Banear</button>
                                        }
                                        else
                                        {
                                            <button class="action-btn danger" onclick="confirmDelete(@user.Id)">🔒 Desactivar</button>
                                            <a asp-controller="Admin" asp-action="BanUser" asp-route-id="@user.Id"
                                               class="action-btn warning" onclick="return confirm('¿Banear este usuario?')">🚫 Banear</a>
                                        }

                                        @if (isSuperAdmin)
                                        {
                                            <a asp-controller="Admin" asp-action="DeleteUserPermanently" asp-route-id="@user.Id"
                                               class="action-btn delete" onclick="return confirm('¿Eliminar permanentemente? Esta acción no se puede deshacer.')">💀 Eliminar</a>

                                            if (user.Role == "Admin")
                                            {
                                                <a href="#" class="action-btn secondary" onclick="event.preventDefault();confirmRemoveAdmin(@user.Id)">⬇️ Quitar Admin</a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Admin" asp-action="MakeAdmin" asp-route-id="@user.Id"
                                                   class="action-btn primary" onclick="return confirm('¿Hacer Admin?')">⬆️ Hacer Admin</a>
                                            }

                                            <button class="action-btn block-conn" onclick="confirmarBloquearConexion(@user.Id, '@user.Username')">
                                                🔌 Bloquear conexión
                                            </button>
                                        }
                                    }

                                    @if (isSuperAdmin && user.Id != myId)
                                    {
                                        <form asp-controller="Admin" asp-action="ResetPassword" method="post" style="display:inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button class="action-btn neutral" onclick="return confirm('¿Resetear contraseña?')">🔑 Reset</button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- CARDS MÓVIL -->
    <div class="mobile-cards">
        @foreach (var user in Model)
        {
            var blockedIps = ViewBag.BlockedIps as List<string> ?? new List<string>();
            bool isBlockedIp = user.LastIp != null && blockedIps.Contains(user.LastIp);
            bool isAdminUser = user.Role == "Admin";

            <div class="mobile-card user-row" data-username="@user.Username.ToLower()">
                <div class="mobile-card-top">
                    <div class="user-cell">
                        @if (user.Role == "SuperAdmin")
                        {
                            @if (!string.IsNullOrEmpty(user.ProfileImage))
                            { <img src="@user.ProfileImage" class="user-thumb" /> }
                            else
                            { <div class="user-thumb-letter">@user.Username.Substring(0,1).ToUpper()</div> }
                        }
                        else
                        {
                            <a href="/User/Profile/@user.Id" style="text-decoration:none;">
                                @if (!string.IsNullOrEmpty(user.ProfileImage))
                                { <img src="@user.ProfileImage" class="user-thumb" /> }
                                else
                                { <div class="user-thumb-letter">@user.Username.Substring(0,1).ToUpper()</div> }
                            </a>
                        }
                        <div>
                            @if (user.Role == "SuperAdmin")
                            { <div class="user-name">@user.Username</div> }
                            else
                            { <a href="/User/Profile/@user.Id" class="user-name" style="text-decoration:none;color:inherit;">@user.Username</a> }
                            <div style="display:flex;gap:4px;margin-top:3px;flex-wrap:wrap;">
                                @if (user.Role == "SuperAdmin") { <span class="badge owner">👑 SuperAdmin</span> }
                                else if (user.Role == "Admin") { <span class="badge admin">🛡️ Admin</span> }
                                @if (user.IsPremium) { <span class="badge premium">✨ Pro</span> }
                            </div>
                        </div>
                    </div>
                    <div id="status-mob-@user.Id">
                        @if (user.IsBanned) { <span class="status-tag banned">🚫</span> }
                        else if (!user.IsActive) { <span class="status-tag inactive">⚠️</span> }
                        else if (user.LastOnline != null && (DateTime.Now - user.LastOnline.Value).TotalSeconds < 60)
                        { <span class="status-tag active">🟢</span> }
                        else { <span class="status-tag offline">⚫</span> }
                    </div>
                </div>

                @if (user.Role != "SuperAdmin")
                {
                    <div class="mobile-info">
                        <div class="mobile-info-row">
                            <span class="mobile-info-icon">📧</span>
                            <span>@(user.Role == "Guest" ? "Usuario invitado" : (user.Email ?? "—"))</span>
                        </div>
                        @if (!string.IsNullOrEmpty(user.Country))
                        {
                            <div class="mobile-info-row">
                                <span class="mobile-info-icon">🌍</span>
                                <span>@user.Country @(!string.IsNullOrEmpty(user.City) ? $"· {user.City}" : "")</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(user.Municipality))
                        {
                            <div class="mobile-info-row">
                                <span class="mobile-info-icon">📍</span>
                                <span>@user.Municipality</span>
                            </div>
                        }
                        <div class="mobile-info-row">
                            <span class="mobile-info-icon">🌐</span>
                            <span>@(user.LastIp ?? "—")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(user.Device) || !string.IsNullOrEmpty(user.Browser))
                        {
                            <div class="mobile-info-row">
                                <span class="mobile-info-icon">💻</span>
                                <span>@(user.Device ?? "") @(!string.IsNullOrEmpty(user.Browser) ? $"· {user.Browser}" : "")</span>
                            </div>
                        }
                        @if (user.Latitude != null && user.Longitude != null)
                        {
                            <a target="_blank" class="map-link"
                               href="https://maps.google.com/?q=@(user.Latitude.Value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)),@(user.Longitude.Value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture))">
                                🗺️ Ver en mapa
                            </a>
                        }
                    </div>
                }

                <div class="actions-cell" style="margin-top:10px;">
                    @if (user.Role == "SuperAdmin")
                    { <span class="badge owner">Propietario</span> }
                    else if (user.Id == myId)
                    { <span class="badge guest">Tu cuenta</span> }
                    else
                    {
                        if (!user.IsActive)
                        {
                            <a asp-controller="Admin" asp-action="ReactivateUser" asp-route-id="@user.Id"
                               class="action-btn success" onclick="return confirm('¿Reactivar?')">🔓 Reactivar</a>
                        }
                        else if (user.IsBanned)
                        {
                            <a asp-controller="Admin" asp-action="UnbanUser" asp-route-id="@user.Id"
                               class="action-btn success" onclick="return confirm('¿Desbanear?')">🔓 Desbanear</a>
                        }
                        else
                        {
                            if (isAdminUser && !isSuperAdmin)
                            {
                                <button class="action-btn danger" onclick="mostrarAdvertenciaAdmin()">🔒 Desactivar</button>
                                <button class="action-btn warning" onclick="mostrarAdvertenciaAdmin()">🚫 Banear</button>
                            }
                            else
                            {
                                <button class="action-btn danger" onclick="confirmDelete(@user.Id)">🔒 Desactivar</button>
                                <a asp-controller="Admin" asp-action="BanUser" asp-route-id="@user.Id"
                                   class="action-btn warning" onclick="return confirm('¿Banear?')">🚫 Banear</a>
                            }

                            @if (isSuperAdmin)
                            {
                                <a asp-controller="Admin" asp-action="DeleteUserPermanently" asp-route-id="@user.Id"
                                   class="action-btn delete" onclick="return confirm('¿Eliminar permanentemente?')">💀 Eliminar</a>
                                if (user.Role == "Admin")
                                { <a href="#" class="action-btn secondary" onclick="event.preventDefault();confirmRemoveAdmin(@user.Id)">⬇️ Quitar Admin</a> }
                                else
                                { <a asp-controller="Admin" asp-action="MakeAdmin" asp-route-id="@user.Id" class="action-btn primary" onclick="return confirm('¿Hacer Admin?')">⬆️ Hacer Admin</a> }
                                <button class="action-btn block-conn" onclick="confirmarBloquearConexion(@user.Id, '@user.Username')">🔌 Bloquear conexión</button>
                            }
                        }

                        @if (isSuperAdmin && user.Id != myId)
                        {
                            <form asp-controller="Admin" asp-action="ResetPassword" method="post" style="display:inline">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button class="action-btn neutral" onclick="return confirm('¿Resetear contraseña?')">🔑 Reset</button>
                            </form>
                        }
                    }
                </div>
            </div>
        }
    </div>

</div>

<style>
* { font-family: 'Plus Jakarta Sans', sans-serif; }
.admin-page { max-width: 1200px; margin: 0 auto; padding-bottom: 40px; }

/* ══ HERO ══ */
.admin-hero {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    border-radius: 24px; padding: 22px 24px; margin-bottom: 16px;
    display: flex; align-items: center; gap: 16px;
    border: 1px solid rgba(255,255,255,0.06); position: relative; overflow: hidden;
}
.admin-hero::before {
    content:''; position:absolute; top:-50px; right:-50px;
    width:200px; height:200px;
    background: radial-gradient(circle, rgba(99,102,241,0.15), transparent 70%);
    border-radius:50%; pointer-events:none;
}
.admin-hero-mascot {
    width:64px; height:64px; border-radius:16px; object-fit:cover; flex-shrink:0;
    border:2px solid rgba(99,102,241,0.4); box-shadow:0 0 0 5px rgba(99,102,241,0.08);
    animation:floatM 3s ease-in-out infinite; position:relative; z-index:1;
}
@@keyframes floatM { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-5px);} }
@@keyframes warnBounce { from{transform:scale(0.6) rotate(-10deg);opacity:0;} to{transform:scale(1) rotate(0);opacity:1;} }
.admin-hero-info { flex:1; position:relative; z-index:1; }
.admin-hero-badge {
    display:inline-flex; align-items:center; gap:5px;
