</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
connection.start().catch(err => console.error(err));

connection.on("UserOnline", userId => {
    const html = '<span class="status-tag active">🟢 Activo</span>';
    const c = document.getElementById("status-" + userId);
    const m = document.getElementById("status-mob-" + userId);
    if (c) c.innerHTML = html;
    if (m) m.innerHTML = '<span class="status-tag active">🟢</span>';
    const counter = document.getElementById("activeUsers");
    if (counter) counter.textContent = parseInt(counter.textContent) + 1;
});

connection.on("UserOffline", userId => {
    const html = '<span class="status-tag offline">⚫ Inactivo</span>';
    const c = document.getElementById("status-" + userId);
    const m = document.getElementById("status-mob-" + userId);
    if (c) c.innerHTML = html;
    if (m) m.innerHTML = '<span class="status-tag offline">⚫</span>';
    const counter = document.getElementById("activeUsers");
    if (counter) counter.textContent = Math.max(0, parseInt(counter.textContent) - 1);
});

document.getElementById("searchUser").addEventListener("keyup", function() {
    const val = this.value.toLowerCase();
    document.querySelectorAll(".user-row").forEach(row => {
        row.style.display = row.dataset.username.includes(val) ? "" : "none";
    });
});

function confirmDelete(userId) {
    if (confirm("¿Desactivar este usuario?")) window.location.href = "/Admin/DeleteUser/" + userId;
}

function confirmRemoveAdmin(userId) {
    if (confirm("¿Quitar permisos de admin?")) window.location.href = "/Admin/RemoveAdmin/" + userId;
}

function pedirCodigoAdmin() { document.getElementById("codeModal").style.display = "flex"; }

function cerrarModal() {
    document.getElementById("codeModal").style.display = "none";
    document.getElementById("codeInput").value = "";
    document.getElementById("codeError").textContent = "";
}

function showAll() {
    document.querySelectorAll(".user-row").forEach(row => row.style.display = "");
}

function filterByStatus(status) {
    document.querySelectorAll(".user-row").forEach(row => {
        const cell = row.querySelector("[id^='status-']");
        if (!cell) return;
        const text = cell.textContent.toLowerCase();
        const show = status === 'banned' ? text.includes('baneado')
            : status === 'inactive' ? text.includes('desactivado')
            : status === 'active' ? (text.includes('activo') && !text.includes('inactivo') && !text.includes('desactivado'))
            : true;
        row.style.display = show ? "" : "none";
    });
}

function mostrarAdvertenciaAdmin() {
    const overlay = document.getElementById("adminWarningOverlay");
    overlay.style.display = "flex";
    // Notificar al SuperAdmin via SignalR
    connection.invoke("NotifyAdminAction").catch(() => {});
    setTimeout(() => { overlay.style.display = "none"; }, 4000);
}

function confirmarBloquearConexion(userId, username) {
    if (!confirm(`¿Bloquear completamente la conexión de ${username}? No podrá acceder a la plataforma desde ningún dispositivo ni red.`)) return;
    const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
    fetch('/Admin/BlockUserConnection', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify({ userId })
    }).then(r => r.json()).then(data => {
        if (data.success) {
            mostrarToast(`🔌 Conexión de ${username} bloqueada`);
        } else {
            mostrarToast('⚠️ Error al bloquear');
        }
    }).catch(() => mostrarToast('⚠️ Error de conexión'));
}

function mostrarToast(msg) {
    const t = document.createElement("div");
    t.textContent = msg;
    t.style.cssText = "position:fixed;bottom:24px;right:24px;background:#1e293b;color:white;padding:12px 20px;border-radius:14px;font-size:13px;font-weight:600;z-index:99999;box-shadow:0 10px 30px rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.08);font-family:'Plus Jakarta Sans',sans-serif;";
    document.body.appendChild(t);
    setTimeout(() => { t.style.transition = 'opacity 0.3s'; t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3500);
}

function validarCodigo() {
    const codigo = document.getElementById("codeInput").value.replace(/\D/g, '');
    const error = document.getElementById("codeError");
    if (!codigo) { error.textContent = "Debes escribir un código"; return; }
    const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
    fetch('/Admin/ValidateAccessCode', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify({ code: codigo })
    }).then(res => res.json()).then(data => {
        if (!data.success) { error.textContent = "❌ Código incorrecto"; return; }
        cerrarModal();
        if (confirm("¿Bloquear la conexión global para todos?")) {
            fetch('/Admin/ToggleConnectionBlock', { method: 'POST', headers: { 'RequestVerificationToken': token } })
                .then(() => location.reload());
        }
    }).catch(() => { error.textContent = "⚠️ Error al validar"; });
}
</script>