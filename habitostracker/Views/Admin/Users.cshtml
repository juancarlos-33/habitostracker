@inject HabitTrackerApp.Data.HabitDbContext _context
@model List<HabitTrackerApp.Models.User>

<form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

@{
    var myId = int.Parse(User.FindFirst("UserId").Value);
    var me = _context.Users.FirstOrDefault(u => u.Id == myId);
    var activeNow = Model.Count(u => u.IsActive && !u.IsBanned && u.LastOnline != null && (DateTime.Now - u.LastOnline.Value).TotalSeconds < 60);
    var block = Context.RequestServices.GetService<HabitTrackerApp.Data.HabitDbContext>().ConnectionBlocks.FirstOrDefault();
    bool isBlocked = block != null && block.IsBlocked;
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    var totalInactive = Model.Count(u => u.IsActive && !u.IsBanned && (u.LastOnline == null || (DateTime.Now - u.LastOnline.Value).TotalSeconds >= 60));
    var totalBanned = Model.Count(u => u.IsBanned);
    var totalDeactivated = Model.Count(u => !u.IsActive);
    var totalBlocked = Model.Count(u => u.IsIpBlocked);
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<!-- WARN OVERLAY -->
<div id="warnOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:999999;align-items:center;justify-content:center;flex-direction:column;backdrop-filter:blur(16px);">
    <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg" style="width:88px;height:88px;border-radius:22px;border:3px solid #ef4444;box-shadow:0 0 0 8px rgba(239,68,68,0.12);margin-bottom:20px;animation:wB 0.5s cubic-bezier(0.34,1.56,0.64,1);"/>
    <div style="background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid rgba(239,68,68,0.25);border-radius:24px;padding:28px 32px;text-align:center;max-width:360px;width:90%;box-shadow:0 40px 80px rgba(0,0,0,0.6);">
        <div style="font-size:36px;margin-bottom:12px;">⛔</div>
        <div style="font-size:17px;font-weight:800;color:white;margin-bottom:8px;">Acción no permitida</div>
        <div style="font-size:13px;color:rgba(255,255,255,0.45);line-height:1.7;">No puedes banear ni desactivar a otro administrador.<br><br><span style="color:#fbbf24;font-weight:700;">⚠️ El propietario ha sido notificado.</span></div>
    </div>
</div>

<!-- CODE MODAL -->
<div id="codeModal" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.75);display:none;align-items:center;justify-content:center;z-index:9999;backdrop-filter:blur(12px);">
    <div style="background:linear-gradient(135deg,#1e293b,#0f172a);padding:32px 28px;border-radius:24px;width:320px;text-align:center;color:white;border:1px solid rgba(255,255,255,0.08);box-shadow:0 40px 80px rgba(0,0,0,0.6);">
        <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg" style="width:52px;height:52px;border-radius:14px;margin-bottom:14px;border:2px solid rgba(99,102,241,0.4);"/>
        <h5 style="margin:0 0 6px;font-size:16px;font-weight:800;">⚠️ Autorización requerida</h5>
        <p style="font-size:12px;opacity:0.45;margin:0 0 14px;">Código de 5 dígitos</p>
        <input type="text" id="codeInput" maxlength="5" inputmode="numeric" placeholder="• • • • •"
               oninput="this.value=this.value.replace(/\D/g,'')"
               style="width:100%;padding:12px;border-radius:12px;border:1.5px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);font-size:20px;text-align:center;letter-spacing:6px;color:white;outline:none;box-sizing:border-box;font-family:inherit;"/>
        <div id="codeError" style="color:#f87171;font-size:12px;margin-top:8px;min-height:18px;"></div>
        <div style="margin-top:16px;display:flex;gap:8px;">
            <button onclick="validarCodigo()" style="flex:1;padding:10px;border-radius:12px;border:none;background:linear-gradient(135deg,#6366f1,#2563eb);color:white;font-weight:700;cursor:pointer;font-family:inherit;">Aceptar</button>
            <button onclick="cerrarModal()" style="flex:1;padding:10px;border-radius:12px;border:none;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.5);font-weight:700;cursor:pointer;font-family:inherit;">Cancelar</button>
        </div>
    </div>
</div>

<style>
*{font-family:'Plus Jakarta Sans',sans-serif;}
@@keyframes wB{from{transform:scale(0.6) rotate(-10deg);opacity:0;}to{transform:scale(1) rotate(0);opacity:1;}}
@@keyframes fadeUp{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:translateY(0);}}
@@keyframes floatM{0%,100%{transform:translateY(0);}50%{transform:translateY(-6px);}}
@@keyframes pulse2{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,0.4);}50%{box-shadow:0 0 0 6px rgba(34,197,94,0);}}
@@keyframes scanline{0%{transform:translateY(-100%);}100%{transform:translateY(100vh);}}
@@keyframes countUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
@@keyframes shimmer{0%{background-position:-200% center;}100%{background-position:200% center;}}
@@keyframes glow{0%,100%{box-shadow:0 0 20px rgba(99,102,241,0.3);}50%{box-shadow:0 0 40px rgba(99,102,241,0.6);}}

.ap{max-width:1200px;margin:0 auto;padding-bottom:60px;}

/* HERO */
.ah{
    background:linear-gradient(135deg,#0f172a 0%,#1e293b 60%,#0f172a 100%);
    border-radius:24px;padding:28px 32px;margin-bottom:20px;
    display:flex;align-items:center;gap:20px;
    border:1px solid rgba(255,255,255,0.07);position:relative;overflow:hidden;
}
.ah::before{content:'';position:absolute;top:-80px;right:-80px;width:320px;height:320px;background:radial-gradient(circle,rgba(99,102,241,0.18),transparent 70%);border-radius:50%;pointer-events:none;}
.ah::after{content:'';position:absolute;bottom:-60px;left:60px;width:200px;height:200px;background:radial-gradient(circle,rgba(234,179,8,0.1),transparent 70%);border-radius:50%;pointer-events:none;}
.ah-scan{position:absolute;inset:0;overflow:hidden;pointer-events:none;opacity:0.03;}
.ah-scan::after{content:'';position:absolute;width:100%;height:2px;background:linear-gradient(90deg,transparent,#6366f1,transparent);animation:scanline 4s linear infinite;}
.ah-mascot{width:76px;height:76px;border-radius:20px;object-fit:cover;flex-shrink:0;border:2px solid rgba(99,102,241,0.5);box-shadow:0 0 0 6px rgba(99,102,241,0.1),0 8px 28px rgba(0,0,0,0.5);animation:floatM 3s ease-in-out infinite;position:relative;z-index:1;}
.ah-info{flex:1;position:relative;z-index:1;}
.ah-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.3);border-radius:20px;padding:4px 13px;font-size:11px;font-weight:700;color:#a5b4fc;margin-bottom:8px;}
.ah-title{font-size:23px;font-weight:900;color:white;margin-bottom:4px;letter-spacing:-0.5px;}
.ah-sub{font-size:13px;color:rgba(255,255,255,0.35);}
.ah-stats{display:flex;gap:16px;margin-top:12px;}
.ah-stat{font-size:11px;color:rgba(255,255,255,0.3);font-weight:600;display:flex;align-items:center;gap:5px;}
.ah-stat span{color:white;font-weight:800;}
.ah-right{position:relative;z-index:1;flex-shrink:0;text-align:center;min-width:190px;}
.conn-pill{display:inline-flex;align-items:center;gap:7px;padding:8px 18px;border-radius:20px;font-size:12px;font-weight:700;}
.conn-pill.on{background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3);color:#22c55e;}
.conn-pill.off{background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);color:#ef4444;}
.cdot{width:7px;height:7px;border-radius:50%;}
.cdot.g{background:#22c55e;animation:pulse2 2s infinite;}
.cdot.r{background:#ef4444;}
.cab{padding:9px 18px;border-radius:12px;border:none;font-size:12px;font-weight:700;cursor:pointer;transition:0.2s;font-family:inherit;margin-top:8px;width:100%;}
.cab.restore{background:rgba(34,197,94,0.12);color:#22c55e;border:1px solid rgba(34,197,94,0.25);}
.cab.restore:hover{background:#22c55e;color:white;transform:translateY(-1px);}
.cab.blk{background:rgba(239,68,68,0.12);color:#ef4444;border:1px solid rgba(239,68,68,0.25);}
.cab.blk:hover{background:#ef4444;color:white;transform:translateY(-1px);}

/* KPI CARDS */
.kpi-wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;}
.kpi-card{
    border-radius:18px;padding:18px 16px;
    display:flex;align-items:center;gap:14px;
    cursor:pointer;transition:all 0.25s cubic-bezier(0.34,1.56,0.64,1);
    position:relative;overflow:hidden;
}
.kpi-card::before{content:'';position:absolute;top:-30px;right:-30px;width:100px;height:100px;border-radius:50%;pointer-events:none;transition:0.3s;}
.kpi-card:hover{transform:translateY(-4px);}
.kpi-card:hover::before{width:130px;height:130px;}
.kpi-icon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;position:relative;z-index:1;}
.kpi-val{font-size:30px;font-weight:900;line-height:1;font-variant-numeric:tabular-nums;animation:countUp 0.5s ease both;position:relative;z-index:1;}
.kpi-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;margin-top:3px;position:relative;z-index:1;}

/* light mode */
body:not(.bg-dark) .kpi-card{background:white;box-shadow:0 2px 12px rgba(0,0,0,0.07);border:1px solid rgba(0,0,0,0.05);}
body:not(.bg-dark) .kpi-card:hover{box-shadow:0 16px 32px rgba(0,0,0,0.12);}
body:not(.bg-dark) .kpi-lbl{color:#9ca3af;}
body:not(.bg-dark) .kpi-card.total .kpi-val{color:#1e40af;}
body:not(.bg-dark) .kpi-card.total .kpi-icon{background:rgba(37,99,235,0.1);}
body:not(.bg-dark) .kpi-card.total::before{background:rgba(37,99,235,0.06);}
body:not(.bg-dark) .kpi-card.active .kpi-val{color:#15803d;}
body:not(.bg-dark) .kpi-card.active .kpi-icon{background:rgba(22,163,74,0.1);}
body:not(.bg-dark) .kpi-card.active::before{background:rgba(22,163,74,0.06);}
body:not(.bg-dark) .kpi-card.offline .kpi-val{color:#475569;}
body:not(.bg-dark) .kpi-card.offline .kpi-icon{background:rgba(100,116,139,0.1);}
body:not(.bg-dark) .kpi-card.offline::before{background:rgba(100,116,139,0.06);}
body:not(.bg-dark) .kpi-card.banned .kpi-val{color:#dc2626;}
body:not(.bg-dark) .kpi-card.banned .kpi-icon{background:rgba(239,68,68,0.1);}
body:not(.bg-dark) .kpi-card.banned::before{background:rgba(239,68,68,0.06);}
body:not(.bg-dark) .kpi-card.deact .kpi-val{color:#b45309;}
body:not(.bg-dark) .kpi-card.deact .kpi-icon{background:rgba(217,119,6,0.1);}
body:not(.bg-dark) .kpi-card.deact::before{background:rgba(217,119,6,0.06);}
body:not(.bg-dark) .kpi-card.blkd .kpi-val{color:#4f46e5;}
body:not(.bg-dark) .kpi-card.blkd .kpi-icon{background:rgba(99,102,241,0.1);}
body:not(.bg-dark) .kpi-card.blkd::before{background:rgba(99,102,241,0.06);}

/* dark mode */
body.bg-dark .kpi-card{background:#1e293b;border:1px solid rgba(255,255,255,0.07);box-shadow:0 2px 16px rgba(0,0,0,0.3);}
body.bg-dark .kpi-card:hover{box-shadow:0 16px 40px rgba(0,0,0,0.4);}
body.bg-dark .kpi-lbl{color:rgba(255,255,255,0.35);}
body.bg-dark .kpi-card.total .kpi-val{color:#60a5fa;}
body.bg-dark .kpi-card.total .kpi-icon{background:rgba(37,99,235,0.2);}
body.bg-dark .kpi-card.total::before{background:rgba(37,99,235,0.08);}
body.bg-dark .kpi-card.active .kpi-val{color:#4ade80;}
body.bg-dark .kpi-card.active .kpi-icon{background:rgba(22,163,74,0.2);}
body.bg-dark .kpi-card.active::before{background:rgba(22,163,74,0.08);}
body.bg-dark .kpi-card.offline .kpi-val{color:#94a3b8;}
body.bg-dark .kpi-card.offline .kpi-icon{background:rgba(100,116,139,0.2);}
body.bg-dark .kpi-card.offline::before{background:rgba(100,116,139,0.08);}
body.bg-dark .kpi-card.banned .kpi-val{color:#f87171;}
body.bg-dark .kpi-card.banned .kpi-icon{background:rgba(239,68,68,0.2);}
body.bg-dark .kpi-card.banned::before{background:rgba(239,68,68,0.08);}
body.bg-dark .kpi-card.deact .kpi-val{color:#fbbf24;}
body.bg-dark .kpi-card.deact .kpi-icon{background:rgba(217,119,6,0.2);}
body.bg-dark .kpi-card.deact::before{background:rgba(217,119,6,0.08);}
body.bg-dark .kpi-card.blkd .kpi-val{color:#a5b4fc;}
body.bg-dark .kpi-card.blkd .kpi-icon{background:rgba(99,102,241,0.2);}
body.bg-dark .kpi-card.blkd::before{background:rgba(99,102,241,0.08);}

/* QUICK */
.qa{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;}
.qb{padding:9px 18px;border-radius:11px;font-size:12px;font-weight:700;text-decoration:none;border:none;cursor:pointer;transition:0.2s;font-family:inherit;}
.qb.n{background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;}
.qb.n:hover{background:#e5e7eb;}
.qb.r{background:#fef2f2;color:#dc2626;border:1px solid #fecaca;}
.qb.r:hover{background:#dc2626;color:white;}
.qb.y{background:#fef3c7;color:#d97706;border:1px solid #fde68a;}
.qb.y:hover{background:#d97706;color:white;}
.ip{padding:10px 16px;border-radius:12px;margin-bottom:14px;font-size:13px;font-weight:600;}
.ip.g{background:#f0fdf4;color:#166534;border:1px solid #86efac;}

/* SEARCH */
.sw{position:relative;margin-bottom:16px;max-width:440px;}
.si{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:15px;}
.sinp{width:100%;padding:12px 16px 12px 44px;border:1.5px solid #e5e7eb;border-radius:50px;font-size:13px;outline:none;transition:0.25s;box-sizing:border-box;background:white;font-family:inherit;box-shadow:0 2px 8px rgba(0,0,0,0.04);}
.sinp:focus{border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,0.1);}

/* TABLE */
.tw{overflow-x:auto;background:white;border-radius:22px;box-shadow:0 4px 20px rgba(0,0,0,0.07);border:1px solid rgba(0,0,0,0.05);margin-bottom:16px;}
.mc2{display:none;}
@@media(max-width:768px){
    .tw{display:none;}.mc2{display:flex;flex-direction:column;gap:10px;}
    .kpi-wrap{grid-template-columns:repeat(2,1fr);}
    .ah{flex-wrap:wrap;}
    .ah-stats{display:none;}
}

.ut{width:100%;border-collapse:collapse;min-width:920px;}
.ut thead th{padding:13px 14px;font-size:10px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:0.8px;border-bottom:1px solid #f1f5f9;white-space:nowrap;background:white;}
.ut tbody tr{transition:0.15s;}
.ut tbody tr:hover{background:#f8fafc;}
.ut td{padding:12px 14px;border-bottom:1px solid #f1f5f9;vertical-align:middle;}

/* USER CELL */
.uc{display:flex;align-items:center;gap:10px;}
.uth{width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid #e2e8f0;flex-shrink:0;transition:0.2s;}
.uth:hover{border-color:#6366f1;transform:scale(1.08);}
.utl{width:40px;height:40px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;}
.un{font-weight:700;color:#0f172a;font-size:13px;}

/* BADGES */
.bd{display:inline-flex;align-items:center;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700;}
.bd.ow{background:#0f172a;color:white;}
.bd.ad{background:#dbeafe;color:#1d4ed8;}
.bd.gu{background:#f1f5f9;color:#64748b;}
.bd.pr{background:#fef3c7;color:#d97706;}
.bd.go{background:#4285f4;color:white;}

/* STATUS */
.st{display:inline-flex;align-items:center;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;white-space:nowrap;}
.st.a{background:#dcfce7;color:#16a34a;}
.st.bn{background:#fee2e2;color:#dc2626;}
.st.in{background:#fef9c3;color:#854d0e;}
.st.of{background:#f1f5f9;color:#94a3b8;}

/* LOCATION */
.lc{display:flex;flex-direction:column;gap:3px;}
.lc span{font-size:11px;color:#475569;}
.ipt{color:#94a3b8!important;font-size:10px!important;}
.ml{color:#6366f1;font-size:11px;font-weight:600;text-decoration:none;}
.ml:hover{text-decoration:underline;}
.ipb{padding:3px 9px;border-radius:7px;border:none;cursor:pointer;font-size:11px;font-weight:700;font-family:inherit;margin-top:3px;transition:0.15s;}
.ipb.bl{background:#fee2e2;color:#dc2626;}
.ipb.bl:hover{background:#dc2626;color:white;}
.ipb.ub{background:#dcfce7;color:#16a34a;}
.ipb.ub:hover{background:#16a34a;color:white;}

/* DEVICE */
.dc{display:flex;flex-direction:column;gap:3px;}
.dc span{font-size:11px;color:#475569;}

/* ACTIONS */
.acc{display:flex;flex-wrap:wrap;gap:4px;}
.ab{padding:5px 11px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;border:none;text-decoration:none;transition:0.15s;display:inline-flex;align-items:center;gap:3px;font-family:inherit;}
.ab.su{background:#dcfce7;color:#16a34a;}.ab.su:hover{background:#16a34a;color:white;}
.ab.da{background:#fee2e2;color:#dc2626;}.ab.da:hover{background:#dc2626;color:white;}
.ab.wa{background:#fef9c3;color:#854d0e;}.ab.wa:hover{background:#d97706;color:white;}
.ab.dl{background:#f1f5f9;color:#64748b;}.ab.dl:hover{background:#64748b;color:white;}
.ab.pr2{background:#dbeafe;color:#2563eb;}.ab.pr2:hover{background:#2563eb;color:white;}
.ab.se{background:#f1f5f9;color:#374151;}.ab.se:hover{background:#374151;color:white;}
.ab.ne{background:#f1f5f9;color:#374151;}.ab.ne:hover{background:#374151;color:white;}
.ab.bc{background:linear-gradient(135deg,rgba(99,102,241,0.1),rgba(37,99,235,0.08));color:#4f46e5;border:1px solid rgba(99,102,241,0.2);}
.ab.bc:hover{background:linear-gradient(135deg,#6366f1,#2563eb);color:white;border-color:transparent;}
.ab.ub2{background:linear-gradient(135deg,rgba(34,197,94,0.1),rgba(16,185,129,0.08));color:#16a34a;border:1px solid rgba(34,197,94,0.2);}
.ab.ub2:hover{background:linear-gradient(135deg,#22c55e,#16a34a);color:white;border-color:transparent;}

/* MOBILE CARDS */
.mcard{background:white;border-radius:18px;padding:16px;box-shadow:0 4px 16px rgba(0,0,0,0.07);border:1px solid rgba(0,0,0,0.05);}
.mct{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;}
.mi{background:#f8fafc;border-radius:13px;padding:10px 13px;margin-bottom:12px;display:flex;flex-direction:column;gap:6px;}
.mir{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#475569;}
.mic{flex-shrink:0;width:16px;text-align:center;}

/* DARK */
body.bg-dark .tw,body.bg-dark .mcard{background:#1e293b!important;border-color:#334155!important;}
body.bg-dark .un{color:#f1f5f9!important;}
body.bg-dark .ut thead th{color:#64748b!important;border-color:#334155!important;background:#1e293b!important;}
body.bg-dark .ut tbody tr:hover{background:#2d3748!important;}
body.bg-dark .ut td{border-color:#334155!important;}
body.bg-dark .sinp{background:#1e293b!important;border-color:#334155!important;color:#f1f5f9!important;}
body.bg-dark .mi{background:#2d3748!important;}
body.bg-dark .mir{color:#94a3b8!important;}
body.bg-dark .lc span{color:#94a3b8!important;}
body.bg-dark .dc span{color:#94a3b8!important;}
body.bg-dark .qb.n{background:#1e293b!important;color:#94a3b8!important;border-color:#334155!important;}
</style>

<div class="ap">

    <!-- HERO -->
    <div class="ah">
        <div class="ah-scan"></div>
        <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg" class="ah-mascot"/>
        <div class="ah-info">
            <div class="ah-badge">🛡️ Panel de Control</div>
            <div class="ah-title">Centro de Administración</div>
            <div class="ah-sub">Gestiona usuarios, conexiones y seguridad · <strong style="color:white;">@me?.Username</strong></div>
            <div class="ah-stats">
                <div class="ah-stat">👥 <span>@Model.Count</span> usuarios</div>
                <div class="ah-stat">🟢 <span id="ahActive">@activeNow</span> activos</div>
                <div class="ah-stat">🔌 <span>@totalBlocked</span> bloqueados</div>
            </div>
        </div>
        <div class="ah-right">
            <div class="conn-pill @(isBlocked ? "off" : "on")">
                <span class="cdot @(isBlocked ? "r" : "g")"></span>
                @(isBlocked ? "🔴 Bloqueada" : "🟢 Activa")
            </div>
            @if (isBlocked)
            {
                <form asp-controller="Admin" asp-action="ToggleConnectionBlock" method="post">
                    <button class="cab restore">🔓 Restaurar conexión</button>
                </form>
            }
            else if (me?.Role == "SuperAdmin")
            {
                <form asp-controller="Admin" asp-action="ToggleConnectionBlock" method="post">
                    <button class="cab blk" onclick="return confirm('¿Bloquear conexión global?')">🔒 Bloquear para todos</button>
                </form>
            }
            else if (me?.Role == "Admin")
            {
                <button class="cab blk" onclick="pedirCodigoAdmin()">🔒 Bloquear para todos</button>
            }
        </div>
    </div>

    <!-- KPIs -->
    <div class="kpi-wrap">
        <div class="kpi-card total" onclick="showAll()">
            <div class="kpi-icon">👥</div>
            <div>
                <div class="kpi-val">@Model.Count</div>
                <div class="kpi-lbl">Total usuarios</div>
            </div>
        </div>
        <div class="kpi-card active" onclick="filterByStatus('active')">
            <div class="kpi-icon">🟢</div>
            <div>
                <div class="kpi-val" id="activeUsers">@activeNow</div>
                <div class="kpi-lbl">Activos ahora</div>
            </div>
        </div>
        <div class="kpi-card offline" onclick="filterByStatus('offline')">
            <div class="kpi-icon">⚫</div>
            <div>
                <div class="kpi-val">@totalInactive</div>
                <div class="kpi-lbl">Inactivos</div>
            </div>
        </div>
        <div class="kpi-card banned" onclick="filterByStatus('banned')">
            <div class="kpi-icon">🚫</div>
            <div>
                <div class="kpi-val">@totalBanned</div>
                <div class="kpi-lbl">Baneados</div>
            </div>
        </div>
        <div class="kpi-card deact" onclick="filterByStatus('inactive')">
            <div class="kpi-icon">⚠️</div>
            <div>
                <div class="kpi-val">@totalDeactivated</div>
                <div class="kpi-lbl">Desactivados</div>
            </div>
        </div>
        <div class="kpi-card blkd" onclick="filterByStatus('blocked')">
            <div class="kpi-icon">🔌</div>
            <div>
                <div class="kpi-val">@totalBlocked</div>
                <div class="kpi-lbl">Con. bloqueada</div>
            </div>
        </div>
    </div>

    <!-- ACCIONES -->
    <div class="qa">
        <button class="qb n" onclick="showAll()" data-no-loader>👥 Todos</button>
        <a asp-controller="Admin" asp-action="Reports" class="qb r">🚩 Reportes</a>
        @if (isSuperAdmin)
        {
            <form asp-controller="Admin" asp-action="GenerateAccessCode" method="post" style="display:inline">
                <button type="submit" class="qb y">🔑 Generar código</button>
            </form>
        }
    </div>

    @if (TempData["GeneratedCode"] != null) { <div class="ip g">🔐 Código: <strong>@TempData["GeneratedCode"]</strong></div> }
    @if (TempData["NewPassword"] != null) { <div class="ip g">🔑 Contraseña: <strong>@TempData["NewPassword"]</strong></div> }

    <!-- SEARCH -->
    <div class="sw">
        <span class="si">🔍</span>
        <input type="text" id="searchUser" placeholder="Buscar usuario..." class="sinp"/>
    </div>

    <!-- TABLA DESKTOP -->
    <div class="tw">
        <table class="ut">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th>Ubicación</th>
                    <th>Dispositivo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var blockedIps = ViewBag.BlockedIps as List<string> ?? new List<string>();
                    bool isBlockedIp = user.LastIp != null && blockedIps.Contains(user.LastIp);
                    bool isAdminUser = user.Role == "Admin";
                    var photo = user.ProfileImage ?? user.ProfilePicture ?? "";

                    <tr class="user-row" data-username="@user.Username.ToLower()" data-blocked="@user.IsIpBlocked.ToString().ToLower()">
                        <td>
                            <div class="uc">
                                @if (user.Role == "SuperAdmin")
                                {
                                    @if (!string.IsNullOrEmpty(photo)) { <img src="@photo" class="uth"/> }
                                    else { <div class="utl">@user.Username.Substring(0,1).ToUpper()</div> }
                                }
                                else
                                {
                                    <a href="/User/Profile/@user.Id" style="text-decoration:none;flex-shrink:0;">
                                        @if (!string.IsNullOrEmpty(photo)) { <img src="@photo" class="uth"/> }
                                        else { <div class="utl">@user.Username.Substring(0,1).ToUpper()</div> }
                                    </a>
                                }
                                <div>
                                    @if (user.Role == "SuperAdmin") { <div class="un">@user.Username</div> }
                                    else { <a href="/User/Profile/@user.Id" class="un" style="text-decoration:none;color:inherit;">@user.Username</a> }
                                    <div style="display:flex;gap:3px;margin-top:3px;flex-wrap:wrap;">
                                        @if (user.Role == "SuperAdmin") { <span class="bd ow">👑 SuperAdmin</span> }
                                        else if (user.Role == "Admin") { <span class="bd ad">🛡️ Admin</span> }
                                        else if (user.Role == "Guest") { <span class="bd gu">👤 Invitado</span> }
                                        @if (user.IsPremium) { <span class="bd pr">✨ Pro</span> }
                                        @if (user.IsGoogleAccount) { <span class="bd go">G</span> }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td style="font-size:12px;color:#64748b;">
                            @if (user.Role == "SuperAdmin") { <span>🔒 Privado</span> }
                            else if (user.Role == "Guest") { <span>👤 Invitado</span> }
                            else { @user.Email }
                        </td>
                        <td id="status-@user.Id">
                            @if (user.IsBanned) { <span class="st bn">🚫 Baneado</span> }
                            else if (!user.IsActive) { <span class="st in">⚠️ Desactivado</span> }
                            else if (user.LastOnline != null && (DateTime.Now - user.LastOnline.Value).TotalSeconds < 60) { <span class="st a">🟢 Activo</span> }
                            else { <span class="st of">⚫ Inactivo</span> }
