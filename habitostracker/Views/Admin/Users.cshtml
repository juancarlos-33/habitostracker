                        <td>
                            @if (user.Role != "SuperAdmin")
                            {
                                <div class="lc">
                                    @if (!string.IsNullOrEmpty(user.Country)) { <span>🌍 @user.Country</span> }
                                    @if (!string.IsNullOrEmpty(user.City)) { <span>🏙️ @user.City</span> }
                                    @if (!string.IsNullOrEmpty(user.Municipality)) { <span>📍 @user.Municipality</span> }
