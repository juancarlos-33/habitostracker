/* CODE MODAL */
.code-modal {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.6); display: none;
    align-items: center; justify-content: center; z-index: 9999;
}
.code-box {
    background: #1f2937; padding: 28px; border-radius: 16px;
    width: 300px; text-align: center; color: white;
}
.code-box input {
    width: 100%; padding: 10px; border-radius: 10px;
    border: none; margin-top: 10px; font-size: 18px;
    text-align: center; letter-spacing: 4px;
}
.code-error { color: #f87171; font-size: 13px; margin-top: 8px; }
.code-actions { margin-top: 14px; display: flex; justify-content: space-between; gap: 8px; }
.code-actions button {
    flex: 1; padding: 9px; border-radius: 10px; border: none;
    font-weight: 600; cursor: pointer;
}
.code-actions button:first-child { background: #2563eb; color: white; }
.code-actions button:last-child { background: #374151; color: white; }
</style>

<div id="codeModal" class="code-modal">
    <div class="code-box">
        <h5>⚠️ Autorización requerida</h5>
        <p style="font-size:13px;opacity:0.8;">Ingresa el código de 5 dígitos</p>
        <input type="text" id="codeInput" maxlength="5" inputmode="numeric"
               placeholder="• • • • •" oninput="this.value = this.value.replace(/\D/g, '')" />
        <div id="codeError" class="code-error"></div>
        <div class="code-actions">
            <button onclick="validarCodigo()">Aceptar</button>
            <button onclick="cerrarModal()">Cancelar</button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
connection.start().catch(err => console.error(err));

connection.on("UserOnline", function(userId) {
    const cell = document.getElementById("status-" + userId);
    const mobCell = document.getElementById("status-mob-" + userId);
    const html = '<span class="status-tag active">Activo</span>';
    if (cell) cell.innerHTML = html;
    if (mobCell) mobCell.innerHTML = html;
    const counter = document.getElementById("activeUsers");
    if (counter) counter.innerText = parseInt(counter.innerText) + 1;
});

connection.on("UserOffline", function(userId) {
    const cell = document.getElementById("status-" + userId);
    const mobCell = document.getElementById("status-mob-" + userId);
    const html = '<span class="status-tag offline">Inactivo</span>';
    if (cell) cell.innerHTML = html;
    if (mobCell) mobCell.innerHTML = html;
    const counter = document.getElementById("activeUsers");
    if (counter) counter.innerText = Math.max(0, parseInt(counter.innerText) - 1);
});

connection.on("ForceLogout", function(message) {
    alert(message);
    window.location.href = "/Account/Login";
});

document.getElementById("searchUser").addEventListener("keyup", function() {
    const value = this.value.toLowerCase();
    document.querySelectorAll(".user-row").forEach(row => {
        row.style.display = row.dataset.username.includes(value) ? "" : "none";
    });
});

function confirmDelete(userId) {
    if (confirm("¿Desactivar este usuario?")) window.location.href = "/Admin/DeleteUser/" + userId;
}

function confirmRemoveAdmin(userId) {
    if (confirm("¿Quitar permisos de admin?")) window.location.href = "/Admin/RemoveAdmin/" + userId;
}

function pedirCodigoAdmin() { document.getElementById("codeModal").style.display = "flex"; }

function cerrarModal() {
    document.getElementById("codeModal").style.display = "none";
    document.getElementById("codeInput").value = "";
    document.getElementById("codeError").innerText = "";
}

function validarCodigo() {
    const codigo = document.getElementById("codeInput").value.replace(/\D/g, '');
    const error = document.getElementById("codeError");
    if (!codigo) { error.innerText = "Debes escribir un código"; return; }
    const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
    fetch('/Admin/ValidateAccessCode', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify({ code: codigo })
    }).then(res => res.json()).then(data => {
        if (!data.success) { error.innerText = "❌ Código incorrecto"; return; }
        cerrarModal();
        if (confirm("¿Bloquear la conexión global?")) {
            fetch('/Admin/ToggleConnectionBlock', { method: 'POST', headers: { 'RequestVerificationToken': token } })
                .then(() => location.reload());
        }
    }).catch(() => { error.innerText = "⚠️ Error al validar"; });
}
</script>