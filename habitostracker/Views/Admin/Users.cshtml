</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
// ── GSAP
gsap.from(".ah",{opacity:0,y:-20,duration:0.7,ease:"expo.out"});
gsap.from(".kpi-card",{opacity:0,y:24,duration:0.5,stagger:0.07,delay:0.25,ease:"back.out(1.6)"});
gsap.from(".qa",{opacity:0,y:10,duration:0.4,delay:0.7,ease:"power2.out"});
gsap.from(".tw,.mc2",{opacity:0,y:20,duration:0.6,delay:0.5,ease:"power2.out"});

// Animación de contadores
document.querySelectorAll('.kpi-val').forEach(el=>{
    const target=parseInt(el.textContent)||0;
    if(target===0)return;
    let current=0;
    const step=Math.ceil(target/20);
    const iv=setInterval(()=>{
        current=Math.min(current+step,target);
        el.textContent=current;
        if(current>=target)clearInterval(iv);
    },40);
});

// ── SIGNALR
const conn=new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
conn.start().catch(e=>console.error(e));
conn.on("UserOnline",uid=>{
    const c=document.getElementById("status-"+uid);
    const m=document.getElementById("status-mob-"+uid);
    if(c)c.innerHTML='<span class="st a">🟢 Activo</span>';
    if(m)m.innerHTML='<span class="st a">🟢</span>';
    const el=document.getElementById("activeUsers");
    const ah=document.getElementById("ahActive");
    if(el)el.textContent=parseInt(el.textContent)+1;
    if(ah)ah.textContent=parseInt(ah.textContent)+1;
});
conn.on("UserOffline",uid=>{
    const c=document.getElementById("status-"+uid);
    const m=document.getElementById("status-mob-"+uid);
    if(c)c.innerHTML='<span class="st of">⚫ Inactivo</span>';
    if(m)m.innerHTML='<span class="st of">⚫</span>';
    const el=document.getElementById("activeUsers");
    const ah=document.getElementById("ahActive");
    if(el)el.textContent=Math.max(0,parseInt(el.textContent)-1);
    if(ah)ah.textContent=Math.max(0,parseInt(ah.textContent)-1);
});

// ── SEARCH
document.getElementById("searchUser").addEventListener("keyup",function(){
    const v=this.value.toLowerCase();
    document.querySelectorAll(".user-row").forEach(r=>r.style.display=r.dataset.username.includes(v)?"":"none");
});

function showAll(){
    document.querySelectorAll(".user-row").forEach(r=>r.style.display="");
    document.querySelectorAll(".kpi-card").forEach(c=>c.style.outline="");
}

function filterByStatus(status){
    document.querySelectorAll(".kpi-card").forEach(c=>c.style.outline="");
    const map={active:'.active',offline:'.offline',banned:'.banned',inactive:'.deact',blocked:'.blkd',all:'.total'};
    const sel=document.querySelector('.kpi-card'+map[status]);
    if(sel)sel.style.outline="2px solid currentColor";
    document.querySelectorAll(".user-row").forEach(r=>{
        const c=r.querySelector("[id^='status-']");
        if(!c)return;
        const t=c.textContent.toLowerCase();
        let show=true;
        if(status==='banned')show=t.includes('baneado');
        else if(status==='inactive')show=t.includes('desactivado');
        else if(status==='active')show=t.includes('activo')&&!t.includes('inactivo')&&!t.includes('desactivado');
        else if(status==='offline')show=t.includes('inactivo');
        else if(status==='blocked')show=r.dataset.blocked==='true';
        r.style.display=show?"":"none";
    });
}

function confirmDelete(id){if(confirm("¿Desactivar este usuario?"))window.location.href="/Admin/DeleteUser/"+id;}
function confirmRemoveAdmin(id){if(confirm("¿Quitar admin?"))window.location.href="/Admin/RemoveAdmin/"+id;}
function pedirCodigoAdmin(){document.getElementById("codeModal").style.display="flex";}
function cerrarModal(){document.getElementById("codeModal").style.display="none";document.getElementById("codeInput").value="";document.getElementById("codeError").textContent="";}

function mostrarWarn(){
    const o=document.getElementById("warnOverlay");
    o.style.display="flex";
    conn.invoke("NotifyAdminAction").catch(()=>{});
    setTimeout(()=>o.style.display="none",5000);
}

function confirmarBloquearConexion(userId,username){
    if(!confirm(`¿Bloquear completamente la conexión de ${username}?`))return;
    const token=document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
    fetch('/Admin/BlockUserConnection',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':token},body:JSON.stringify({userId})})
    .then(r=>r.json()).then(d=>{
        if(d.success){toast(`🔌 Conexión de ${username} bloqueada`,'#6366f1');setTimeout(()=>location.reload(),1500);}
        else toast('⚠️ Error al bloquear','#ef4444');
    }).catch(()=>toast('⚠️ Error de conexión','#ef4444'));
}

function desbloquearConexion(userId,username){
    if(!confirm(`¿Desbloquear la conexión de ${username}?`))return;
    const token=document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
    fetch('/Admin/UnblockUserConnection',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':token},body:JSON.stringify({userId})})
    .then(r=>r.json()).then(d=>{
        if(d.success){toast(`🔓 Conexión de ${username} desbloqueada`,'#22c55e');setTimeout(()=>location.reload(),1500);}
        else toast('⚠️ Error al desbloquear','#ef4444');
    }).catch(()=>toast('⚠️ Error de conexión','#ef4444'));
}

function toast(msg,color='#6366f1'){
    const t=document.createElement("div");
    t.textContent=msg;
    t.style.cssText=`position:fixed;bottom:24px;right:24px;background:#0f172a;color:white;padding:13px 22px;border-radius:14px;font-size:13px;font-weight:600;z-index:99999;box-shadow:0 10px 30px rgba(0,0,0,0.4);border:1px solid ${color}44;border-left:3px solid ${color};font-family:'Plus Jakarta Sans',sans-serif;`;
    document.body.appendChild(t);
    gsap.from(t,{opacity:0,x:20,duration:0.35,ease:"back.out(1.4)"});
    setTimeout(()=>{gsap.to(t,{opacity:0,x:20,duration:0.3,onComplete:()=>t.remove()});},3500);
}

function validarCodigo(){
    const c=document.getElementById("codeInput").value.replace(/\D/g,'');
    const e=document.getElementById("codeError");
    if(!c){e.textContent="Debes escribir un código";return;}
    const token=document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
    fetch('/Admin/ValidateAccessCode',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':token},body:JSON.stringify({code:c})})
    .then(r=>r.json()).then(d=>{
        if(!d.success){e.textContent="❌ Código incorrecto";return;}
        cerrarModal();
        if(confirm("¿Bloquear conexión global?"))
            fetch('/Admin/ToggleConnectionBlock',{method:'POST',headers:{'RequestVerificationToken':token}}).then(()=>location.reload());
    }).catch(()=>e.textContent="⚠️ Error al validar");
}
</script>