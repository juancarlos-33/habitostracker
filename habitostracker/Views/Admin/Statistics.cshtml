<div class="stats-page">

    <div class="stats-header">
        <h2 class="stats-title">📊 Estadísticas del sistema</h2>
        <p class="stats-subtitle">Resumen general de actividad en la plataforma</p>
    </div>

    <div class="stats-grid">

        <div class="stat-card blue">
            <div class="stat-icon">👥</div>
            <div class="stat-value">@ViewBag.TotalUsers</div>
            <div class="stat-label">Usuarios registrados</div>
            <div class="stat-bar">
                <div class="stat-bar-fill" style="width:75%;background:#2563eb;"></div>
            </div>
        </div>

        <div class="stat-card green">
            <div class="stat-icon">🔥</div>
            <div class="stat-value">@ViewBag.TotalHabits</div>
            <div class="stat-label">Hábitos creados</div>
            <div class="stat-bar">
                <div class="stat-bar-fill" style="width:60%;background:#16a34a;"></div>
            </div>
        </div>

        <div class="stat-card purple">
            <div class="stat-icon">💬</div>
            <div class="stat-value">@ViewBag.TotalMessages</div>
            <div class="stat-label">Mensajes enviados</div>
            <div class="stat-bar">
                <div class="stat-bar-fill" style="width:85%;background:#7c3aed;"></div>
            </div>
        </div>

    </div>

</div>

<style>
.stats-page { max-width: 1100px; margin: 0 auto; }

.stats-header { margin-bottom: 28px; }
.stats-title { font-size: 24px; font-weight: 800; color: #111827; margin: 0 0 4px; }
.stats-subtitle { font-size: 14px; color: #9ca3af; margin: 0; }

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
}

.stat-card {
    background: white;
    border-radius: 22px;
    padding: 28px 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
    transition: 0.25s;
    position: relative;
    overflow: hidden;
}

.stat-card::before {
    content: "";
    position: absolute;
    top: 0; right: 0;
    width: 80px; height: 80px;
    border-radius: 0 22px 0 80px;
    opacity: 0.06;
}

.stat-card.blue::before { background: #2563eb; }
.stat-card.green::before { background: #16a34a; }
.stat-card.purple::before { background: #7c3aed; }

.stat-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.1); }

.stat-icon { font-size: 32px; margin-bottom: 14px; }

.stat-value {
    font-size: 42px;
    font-weight: 900;
    color: #111827;
    line-height: 1;
    margin-bottom: 6px;
    letter-spacing: -1px;
}

.stat-card.blue .stat-value { color: #2563eb; }
.stat-card.green .stat-value { color: #16a34a; }
.stat-card.purple .stat-value { color: #7c3aed; }

.stat-label {
    font-size: 14px;
    color: #6b7280;
    font-weight: 500;
    margin-bottom: 16px;
}

.stat-bar {
    height: 4px;
    background: rgba(0,0,0,0.06);
    border-radius: 10px;
    overflow: hidden;
}

.stat-bar-fill {
    height: 100%;
    border-radius: 10px;
    transition: width 1s ease;
}

/* DARK MODE */
body.bg-dark .stats-title { color: #f1f5f9 !important; }
body.bg-dark .stat-card { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .stat-label { color: #64748b !important; }
body.bg-dark .stat-bar { background: rgba(255,255,255,0.06) !important; }
</style>