@model List<HabitTrackerApp.Models.Payment>

@{
    ViewData["Title"] = "Solicitudes Premium (prueba)";
}

<h2>💸 Pagos pendientes - Modo prueba</h2>

@if (!Model.Any())
{
    <p>No hay pagos registrados.</p>
}
else
{
    <table border="1" cellpadding="8" style="width:100%; border-collapse:collapse;">
        <thead>
            <tr><th>ID</th><th>Usuario</th><th>Comprobante</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@(p.User?.Username ?? "Usuario eliminado")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.Screenshot))
                        {
                            <a href="@p.Screenshot" target="_blank">Ver comprobante</a>
                        }
                        else
                        {
                            <span>Sin imagen</span>
                        }
                    </td>
                    <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (p.IsApproved)
                        {
                            <span>Aprobado</span>
                        }
                        else if (p.IsRejected)
                        {

                            <span>Rechazado</span>
                        }
                        else
                        {

                            <span>Pendiente</span>
                        }
                    </td>
                    <td>
                        @if (!p.IsApproved && !p.IsRejected)
                        {
                            <form asp-action="ApprovePayment" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" onclick="return confirm('¿Aprobar pago?')">Aprobar</button>
                            </form>
                            <form asp-action="RejectPayment" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" onclick="return confirm('¿Rechazar pago?')">Rechazar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div style="margin-top:20px;">
    <a href="/Admin/Index">← Volver al panel</a>
</div>