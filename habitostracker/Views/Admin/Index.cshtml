@inject HabitTrackerApp.Data.HabitDbContext _context

@{
    var block = Context.RequestServices
        .GetService<HabitTrackerApp.Data.HabitDbContext>()
        .ConnectionBlocks
        .FirstOrDefault();
    bool isBlocked = block != null && block.IsBlocked;
    var recentUsers = ViewBag.RecentUsers as List<HabitTrackerApp.Models.User> ?? new List<HabitTrackerApp.Models.User>();
    var adminName = User.Identity?.Name ?? "Admin";
    var totalUsers = _context.Users.Count(u => u.Role != "Guest" && u.Role != "System");
    var totalHabits = _context.Habits.Count();
    var totalMessages = _context.Messages.Count();
    var totalPremium = _context.Users.Count(u => u.IsPremium);
    var totalPosts = _context.Posts.Count();
    var totalGroups = _context.Groups.Count(g => g.IsActive);
    var completedToday = _context.HabitHistories.Count(h => h.Date == DateTime.Today && h.Completed);
    var newUsersToday = _context.Users.Count(u => u.CreatedAt.HasValue && u.CreatedAt.Value.Date == DateTime.Today);
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">

<style>
*, *::before, *::after { box-sizing: border-box; }

.ap { 
    max-width: 1100px; margin: 0 auto; 
    font-family: 'Plus Jakarta Sans', sans-serif; 
    padding-bottom: 80px;
}

/* ══ CANVAS 3D BG ══ */
#adminCanvas {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 0; opacity: 0.35;
}

.ap > * { position: relative; z-index: 1; }

/* ══ HERO ══ */
.ap-hero {
    background: linear-gradient(135deg, #020617 0%, #0f172a 40%, #1e1b4b 100%);
    border-radius: 32px; padding: 36px 40px;
    margin-bottom: 24px; position: relative; overflow: hidden;
    border: 1px solid rgba(99,102,241,0.2);
    box-shadow: 0 0 60px rgba(99,102,241,0.15), 0 32px 64px rgba(0,0,0,0.4);
}
.ap-hero::before {
    content:''; position:absolute; top:-80px; right:-80px;
    width:320px; height:320px;
    background: radial-gradient(circle, rgba(99,102,241,0.25), transparent 70%);
    border-radius:50%; animation: rotateGlow 8s linear infinite;
}
.ap-hero::after {
    content:''; position:absolute; bottom:-60px; left:60px;
    width:240px; height:240px;
    background: radial-gradient(circle, rgba(234,179,8,0.15), transparent 70%);
    border-radius:50%;
}
@@keyframes rotateGlow {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.2); }
    100% { transform: rotate(360deg) scale(1); }
}

.ap-hero-inner { display: flex; align-items: center; gap: 24px; position: relative; z-index: 1; }

.ap-hero-avatar {
    width: 90px; height: 90px; border-radius: 24px; object-fit: cover;
    border: 2px solid rgba(99,102,241,0.5);
    box-shadow: 0 0 0 6px rgba(99,102,241,0.1), 0 0 30px rgba(99,102,241,0.4);
    flex-shrink: 0; animation: floatAvatar 4s ease-in-out infinite;
}
@@keyframes floatAvatar {
    0%,100% { transform: translateY(0) rotate(0deg); }
    33% { transform: translateY(-8px) rotate(1deg); }
    66% { transform: translateY(-4px) rotate(-1deg); }
}

.ap-hero-info { flex: 1; }
.ap-hero-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, rgba(234,179,8,0.15), rgba(251,191,36,0.08));
    border: 1px solid rgba(234,179,8,0.3);
    border-radius: 20px; padding: 5px 14px;
    font-size: 11px; font-weight: 700; color: #fbbf24;
    margin-bottom: 10px; letter-spacing: 0.5px;
}
.ap-hero-title { 
    font-size: 28px; font-weight: 900; color: white; 
    margin: 0 0 6px; letter-spacing: -0.5px;
    background: linear-gradient(135deg, #fff, #c7d2fe);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.ap-hero-sub { font-size: 14px; color: rgba(255,255,255,0.45); margin: 0; }
.ap-hero-sub strong { color: #818cf8; -webkit-text-fill-color: #818cf8; }

.ap-hero-stats {
    display: flex; gap: 16px; margin-top: 20px; flex-wrap: wrap;
}
.ap-hero-stat {
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px; padding: 10px 18px; text-align: center;
    transition: 0.2s;
}
.ap-hero-stat:hover { background: rgba(99,102,241,0.15); border-color: rgba(99,102,241,0.3); }
.ap-hero-stat-num { font-size: 20px; font-weight: 800; color: white; }
.ap-hero-stat-lbl { font-size: 10px; color: rgba(255,255,255,0.35); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

.ap-clock {
    flex-shrink: 0; text-align: center;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px; padding: 16px 24px;
    position: relative; z-index: 1;
}
.ap-clock-time { 
    font-size: 32px; font-weight: 900; color: white; 
    font-variant-numeric: tabular-nums; letter-spacing: -1px;
    text-shadow: 0 0 20px rgba(99,102,241,0.6);
}
.ap-clock-date { font-size: 11px; color: rgba(255,255,255,0.3); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; }
.ap-clock-dot { 
    width: 8px; height: 8px; border-radius: 50%; background: #22c55e;
    display: inline-block; margin-right: 6px;
    box-shadow: 0 0 8px rgba(34,197,94,0.8);
    animation: livePulse 2s infinite;
}
@@keyframes livePulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

/* ══ KPI GRID ══ */
.ap-kpis {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 14px; margin-bottom: 24px;
}
.ap-kpi {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    border-radius: 20px; padding: 20px;
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
    cursor: default; overflow: hidden; position: relative;
}
.ap-kpi::before {
    content:''; position:absolute; top:0; left:0; right:0; height:2px;
    border-radius:20px 20px 0 0;
}
.ap-kpi.blue::before { background: linear-gradient(90deg, #2563eb, #3b82f6); }
.ap-kpi.green::before { background: linear-gradient(90deg, #16a34a, #22c55e); }
.ap-kpi.purple::before { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
.ap-kpi.gold::before { background: linear-gradient(90deg, #d97706, #fbbf24); }
.ap-kpi.rose::before { background: linear-gradient(90deg, #e11d48, #f43f5e); }
.ap-kpi.cyan::before { background: linear-gradient(90deg, #0891b2, #06b6d4); }
.ap-kpi.orange::before { background: linear-gradient(90deg, #ea580c, #f97316); }
.ap-kpi.emerald::before { background: linear-gradient(90deg, #059669, #10b981); }

.ap-kpi:hover { 
    transform: translateY(-4px) scale(1.02); 
    box-shadow: 0 16px 40px rgba(0,0,0,0.3);
    border-color: rgba(255,255,255,0.15);
}
.ap-kpi-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.ap-kpi-icon {
    width: 44px; height: 44px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center; font-size: 22px;
}
.ap-kpi.blue .ap-kpi-icon { background: rgba(37,99,235,0.15); }
.ap-kpi.green .ap-kpi-icon { background: rgba(22,163,74,0.15); }
.ap-kpi.purple .ap-kpi-icon { background: rgba(99,102,241,0.15); }
.ap-kpi.gold .ap-kpi-icon { background: rgba(217,119,6,0.15); }
.ap-kpi.rose .ap-kpi-icon { background: rgba(225,29,72,0.15); }
.ap-kpi.cyan .ap-kpi-icon { background: rgba(8,145,178,0.15); }
.ap-kpi.orange .ap-kpi-icon { background: rgba(234,88,12,0.15); }
.ap-kpi.emerald .ap-kpi-icon { background: rgba(5,150,105,0.15); }

.ap-kpi-trend {
    font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 20px;
}
.ap-kpi-trend.up { background: rgba(34,197,94,0.15); color: #4ade80; }
.ap-kpi-trend.neutral { background: rgba(148,163,184,0.15); color: #94a3b8; }

.ap-kpi-val { font-size: 32px; font-weight: 900; color: white; line-height: 1; margin-bottom: 4px; }
.ap-kpi-lbl { font-size: 11px; color: rgba(255,255,255,0.35); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }

/* ══ SECTION HEADER ══ */
.ap-section-hdr {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 14px;
}
.ap-section-title { font-size: 16px; font-weight: 800; color: #f1f5f9; }
.ap-section-line { flex: 1; height: 1px; background: rgba(255,255,255,0.06); }
.ap-section-badge {
    font-size: 11px; font-weight: 700; padding: 3px 10px;
    border-radius: 20px; background: rgba(99,102,241,0.15);
    color: #818cf8; border: 1px solid rgba(99,102,241,0.2);
}

/* ══ MODULES ══ */
.ap-modules {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px; margin-bottom: 24px;
}
.ap-module {
    display: flex; align-items: center; gap: 16px;
    padding: 18px 20px; border-radius: 18px; text-decoration: none;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
    position: relative; overflow: hidden;
}
.ap-module::after {
    content:''; position:absolute; inset:0;
    background: linear-gradient(135deg, transparent, rgba(99,102,241,0.05));
    opacity: 0; transition: 0.3s;
}
.ap-module:hover { 
    transform: translateY(-3px) scale(1.02); 
    box-shadow: 0 16px 40px rgba(0,0,0,0.3);
    border-color: rgba(99,102,241,0.3);
}
.ap-module:hover::after { opacity: 1; }

.ap-module-stripe {
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px; border-radius: 18px 0 0 18px;
}
.ap-module.m-users .ap-module-stripe { background: linear-gradient(180deg, #2563eb, #3b82f6); }
.ap-module.m-habits .ap-module-stripe { background: linear-gradient(180deg, #ea580c, #f97316); }
.ap-module.m-stats .ap-module-stripe { background: linear-gradient(180deg, #16a34a, #22c55e); }
.ap-module.m-feedback .ap-module-stripe { background: linear-gradient(180deg, #dc2626, #ef4444); }
.ap-module.m-logs .ap-module-stripe { background: linear-gradient(180deg, #d97706, #fbbf24); }
.ap-module.m-reports .ap-module-stripe { background: linear-gradient(180deg, #9333ea, #a855f7); }
.ap-module.m-payments .ap-module-stripe { background: linear-gradient(180deg, #059669, #10b981); }
.ap-module.m-security .ap-module-stripe { background: linear-gradient(180deg, #0891b2, #06b6d4); }

.ap-module-icon {
    width: 46px; height: 46px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; background: rgba(255,255,255,0.06);
    transition: 0.3s;
}
.ap-module:hover .ap-module-icon { transform: scale(1.1) rotate(5deg); }

.ap-module-info { flex: 1; min-width: 0; }
.ap-module-name { 
    font-size: 14px; font-weight: 800; color: #f1f5f9; 
    display: flex; align-items: center; gap: 8px; margin-bottom: 3px;
}
.ap-module-desc { font-size: 11px; color: rgba(255,255,255,0.3); }
.ap-module-badge { 
    background: #ef4444; color: white; font-size: 10px; 
    font-weight: 800; padding: 2px 7px; border-radius: 20px;
    animation: badgePulse 2s infinite;
}
@@keyframes badgePulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.1);} }
.ap-module-arrow { 
    font-size: 18px; color: rgba(255,255,255,0.2); transition: 0.3s; flex-shrink: 0;
}
.ap-module:hover .ap-module-arrow { color: #818cf8; transform: translateX(4px); }

/* ══ ACTIVITY FEED ══ */
.ap-activity {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    border-radius: 24px; padding: 24px;
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    margin-bottom: 24px;
}
.ap-activity-item {
    display: flex; align-items: center; gap: 14px;
    padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: 0.2s;
}
.ap-activity-item:last-child { border-bottom: none; padding-bottom: 0; }
.ap-activity-item:hover { padding-left: 6px; }
.ap-activity-dot {
    width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
}
.ap-activity-dot.blue { background: #3b82f6; box-shadow: 0 0 8px rgba(59,130,246,0.6); }
.ap-activity-dot.green { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.6); }
.ap-activity-dot.purple { background: #8b5cf6; box-shadow: 0 0 8px rgba(139,92,246,0.6); }
.ap-activity-dot.gold { background: #fbbf24; box-shadow: 0 0 8px rgba(251,191,36,0.6); }
.ap-activity-dot.rose { background: #f43f5e; box-shadow: 0 0 8px rgba(244,63,94,0.6); }
.ap-activity-text { flex: 1; font-size: 13px; color: rgba(255,255,255,0.7); font-weight: 500; }
.ap-activity-text strong { color: white; font-weight: 700; }
.ap-activity-time { font-size: 11px; color: rgba(255,255,255,0.25); font-weight: 600; white-space: nowrap; }

/* ══ USERS GRID ══ */
.ap-users {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    border-radius: 24px; padding: 24px;
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
}
.ap-users-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
.ap-user-card {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px; border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.06); text-decoration: none;
    transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
    background: rgba(255,255,255,0.03); position: relative; overflow: hidden;
}
.ap-user-card::before {
    content:''; position:absolute; inset:0;
    background: linear-gradient(135deg, rgba(99,102,241,0.08), transparent);
    opacity:0; transition:0.3s;
}
.ap-user-card:hover { 
    transform: translateY(-2px) scale(1.02);
    border-color: rgba(99,102,241,0.3);
    box-shadow: 0 8px 24px rgba(99,102,241,0.15);
}
.ap-user-card:hover::before { opacity: 1; }
.ap-user-avatar-wrap { position: relative; flex-shrink: 0; }
.ap-user-avatar { 
    width: 42px; height: 42px; border-radius: 50%; object-fit: cover; 
    border: 2px solid rgba(255,255,255,0.1);
}
.ap-user-letter {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white; display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 16px;
}
.ap-google-dot {
    position: absolute; bottom: -2px; right: -2px;
    background: #4285f4; color: white; font-size: 8px; font-weight: 800;
    width: 16px; height: 16px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid #0f172a;
}
.ap-user-info { flex: 1; min-width: 0; }
.ap-user-name { 
    display: block; font-size: 13px; font-weight: 700; color: #f1f5f9; 
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ap-user-date { display: block; font-size: 10px; color: rgba(255,255,255,0.25); margin-top: 2px; }
.ap-user-role { 
    font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 20px; 
    position: absolute; top: 8px; right: 8px; flex-shrink: 0;
}
.ap-user-role.premium { background: rgba(217,119,6,0.2); color: #fbbf24; }
.ap-user-role.admin { background: rgba(37,99,235,0.2); color: #60a5fa; }

/* ══ DARK ALWAYS ══ */
.ap-hero, .ap-kpi, .ap-module, .ap-activity, .ap-users { 
    color: white; 
}

@@media (max-width: 768px) {
    .ap-hero-inner { flex-direction: column; align-items: flex-start; }
    .ap-clock { width: 100%; }
    .ap-kpis { grid-template-columns: repeat(2, 1fr); }
    .ap-hero-avatar { width: 70px; height: 70px; }
    .ap-hero-title { font-size: 22px; }
    .ap-modules { grid-template-columns: 1fr; }
}
</style>

<!-- CANVAS 3D -->
<canvas id="adminCanvas"></canvas>

<div class="ap">

    <!-- HERO -->
    <div class="ap-hero">
        <div class="ap-hero-inner">
            <img src="https://res.cloudinary.com/dzrjag7ia/image/upload/v1776560628/NE_lmertz.jpg"
                 class="ap-hero-avatar" alt="mascota" />
            <div class="ap-hero-info">
                <div class="ap-hero-badge">⚡ Centro de Control · HabitTracker Pro</div>
                <div class="ap-hero-title">Panel de Administración</div>
                <div class="ap-hero-sub">
                    Bienvenido, <strong>@adminName</strong> · 
                    <span class="ap-clock-dot"></span>Sistema operativo
                </div>
                <div class="ap-hero-stats">
                    <div class="ap-hero-stat">
                        <div class="ap-hero-stat-num">@totalUsers</div>
                        <div class="ap-hero-stat-lbl">Usuarios</div>
                    </div>
                    <div class="ap-hero-stat">
                        <div class="ap-hero-stat-num">@totalPremium</div>
                        <div class="ap-hero-stat-lbl">Premium</div>
                    </div>
                    <div class="ap-hero-stat">
                        <div class="ap-hero-stat-num">@completedToday</div>
                        <div class="ap-hero-stat-lbl">Hábitos hoy</div>
                    </div>
                    <div class="ap-hero-stat">
                        <div class="ap-hero-stat-num">@newUsersToday</div>
                        <div class="ap-hero-stat-lbl">Nuevos hoy</div>
                    </div>
                </div>
            </div>
            <div class="ap-clock">
                <div class="ap-clock-time" id="apClock">--:--:--</div>
                <div class="ap-clock-date" id="apDate">--</div>
            </div>
        </div>
    </div>

    <!-- KPIs -->
    <div class="ap-kpis">
        <div class="ap-kpi blue">
            <div class="ap-kpi-top">
                <div class="ap-kpi-icon">👥</div>
                <span class="ap-kpi-trend up">+@newUsersToday hoy</span>
            </div>
            <div class="ap-kpi-val" id="kpiUsers">@totalUsers</div>
            <div class="ap-kpi-lbl">Usuarios totales</div>
        </div>
        <div class="ap-kpi green">
            <div class="ap-kpi-top">
                <div class="ap-kpi-icon">🔥</div>
                <span class="ap-kpi-trend up">Activos</span>
            </div>
            <div class="ap-kpi-val">@completedToday</div>
            <div class="ap-kpi-lbl">Hábitos completados hoy</div>
        </div>
        <div class="ap-kpi purple">
            <div class="ap-kpi-top">
                <div class="ap-kpi-icon">💬</div>
                <span class="ap-kpi-trend neutral">Total</span>
            </div>
            <div class="ap-kpi-val">@totalMessages</div>
            <div class="ap-kpi-lbl">Mensajes enviados</div>
        </div>
        <div class="ap-kpi gold">
            <div class="ap-kpi-top">
                <div class="ap-kpi-icon">👑</div>
                <span class="ap-kpi-trend up">VIP</span>
            </div>
            <div class="ap-kpi-val">@totalPremium</div>
            <div class="ap-kpi-lbl">Usuarios Premium</div>
        </div>
        <div class="ap-kpi rose">
            <div class="ap-kpi-top">
                <div class="ap-kpi-icon">📸</div>
                <span class="ap-kpi-trend neutral">Posts</span>
            </div>
            <div class="ap-kpi-val">@totalPosts</div>
            <div class="ap-kpi-lbl">Publicaciones</div>
        </div>
        <div class="ap-kpi cyan">
            <div class="ap-kpi-top">
                <div class="ap-kpi-icon">👥</div>
                <span class="ap-kpi-trend neutral">Activos</span>
            </div>
            <div class="ap-kpi-val">@totalGroups</div>
            <div class="ap-kpi-lbl">Grupos activos</div>
        </div>
        <div class="ap-kpi orange">
            <div class="ap-kpi-top">
                <div class="ap-kpi-icon">📋</div>
                <span class="ap-kpi-trend neutral">Total</span>
            </div>
            <div class="ap-kpi-val">@totalHabits</div>
            <div class="ap-kpi-lbl">Hábitos creados</div>
        </div>
        <div class="ap-kpi emerald">
            <div class="ap-kpi-top">
                <div class="ap-kpi-icon">🌐</div>
                <span class="ap-kpi-trend up">Online</span>
            </div>
            <div class="ap-kpi-val" id="kpiOnline">0</div>
            <div class="ap-kpi-lbl">Usuarios en línea</div>
        </div>
    </div>

    <!-- MÓDULOS -->
    <div class="ap-section-hdr">
        <div class="ap-section-title">🧩 Módulos del sistema</div>
        <div class="ap-section-line"></div>
        <div class="ap-section-badge">8 módulos</div>
    </div>
    <div class="ap-modules">
        <a asp-controller="Admin" asp-action="Users" class="ap-module m-users">
            <div class="ap-module-stripe"></div>
