</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
// ══ RELOJ ══
function updateClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2,'0');
    const m = String(now.getMinutes()).padStart(2,'0');
    const s = String(now.getSeconds()).padStart(2,'0');
    const el = document.getElementById('apClock');
    if (el) el.textContent = `${h}:${m}:${s}`;
    const days = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
    const months = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
    const dateEl = document.getElementById('apDate');
    if (dateEl) dateEl.textContent = `${days[now.getDay()]} ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()}`;
}
setInterval(updateClock, 1000);
updateClock();

// ══ ANIMACIÓN NÚMEROS KPI ══
function animateNumber(el, target, duration = 1200) {
    const start = 0;
    const startTime = performance.now();
    function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(start + (target - start) * eased);
        if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.ap-kpi-val').forEach(el => {
        const target = parseInt(el.textContent);
        if (!isNaN(target) && target > 0) {
            el.textContent = '0';
            setTimeout(() => animateNumber(el, target), 300);
        }
    });
});

// ══ CANVAS 3D PARTÍCULAS ══
const canvas = document.getElementById('adminCanvas');
const ctx = canvas.getContext('2d');
let particles = [];
let animFrame;

function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}

class Particle {
    constructor() { this.reset(); }
    reset() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.z = Math.random() * 3 + 0.5;
        this.vx = (Math.random() - 0.5) * 0.4;
        this.vy = (Math.random() - 0.5) * 0.4;
        this.size = Math.random() * 2.5 + 0.5;
        this.opacity = Math.random() * 0.6 + 0.1;
        this.color = Math.random() > 0.5 ? '99,102,241' : '139,92,246';
        this.pulse = Math.random() * Math.PI * 2;
    }
    update() {
        this.x += this.vx * this.z;
        this.y += this.vy * this.z;
        this.pulse += 0.02;
        if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) this.reset();
    }
    draw() {
        const pulse = Math.sin(this.pulse) * 0.3 + 0.7;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size * pulse, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${this.color},${this.opacity * pulse})`;
        ctx.fill();
    }
}

function initParticles() {
    particles = [];
    for (let i = 0; i < 80; i++) particles.push(new Particle());
}

function drawConnections() {
    for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 120) {
                const alpha = (1 - dist / 120) * 0.15;
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.strokeStyle = `rgba(99,102,241,${alpha})`;
                ctx.lineWidth = 0.5;
                ctx.stroke();
            }
        }
    }
}

function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach(p => { p.update(); p.draw(); });
    drawConnections();
    animFrame = requestAnimationFrame(animate);
}

resizeCanvas();
initParticles();
animate();
window.addEventListener('resize', () => { resizeCanvas(); initParticles(); });

// ══ SIGNALR ══
const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
connection.start().then(() => {
    // usuarios online
    fetch('/Group/GetUsersForGroup?type=all').catch(() => {});
}).catch(err => console.error(err));

connection.on("UserOnline", () => {
    const el = document.getElementById('kpiOnline');
    if (el) el.textContent = parseInt(el.textContent || '0') + 1;
});
connection.on("UserOffline", () => {
    const el = document.getElementById('kpiOnline');
    if (el) el.textContent = Math.max(0, parseInt(el.textContent || '0') - 1);
});

connection.on("NewFeedback", function() {
    const badge = document.querySelector(".ap-module-badge");
    if (badge) badge.textContent = parseInt(badge.textContent) + 1;
    showAdminToast("💬 Nuevo comentario recibido");
});

function showAdminToast(msg) {
    const t = document.createElement("div");
    t.textContent = msg;
    t.style.cssText = "position:fixed;bottom:24px;right:24px;background:linear-gradient(135deg,#1e293b,#0f172a);color:white;padding:14px 22px;border-radius:16px;box-shadow:0 16px 40px rgba(0,0,0,0.4);z-index:9999;font-size:14px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;border:1px solid rgba(99,102,241,0.3);animation:toastSlide 0.3s ease;";
    document.body.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; t.style.transition = '0.3s'; setTimeout(() => t.remove(), 300); }, 4000);
}
</script>
<style>
@@keyframes toastSlide { from{opacity:0;transform:translateY(20px);} to{opacity:1;transform:translateY(0);} }
</style>
}