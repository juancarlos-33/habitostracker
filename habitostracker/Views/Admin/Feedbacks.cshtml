@model List<HabitTrackerApp.Models.Feedback>

<div class="feedbacks-page">

    <div class="feedbacks-header">
        <h2 class="feedbacks-title">📩 Comentarios de usuarios</h2>
        <p class="feedbacks-subtitle">Opiniones y sugerencias de la comunidad · @Model.Count total</p>
    </div>

    @if (!Model.Any())
    {
        <div class="feedbacks-empty">
            <div class="empty-icon">💬</div>
            <h5>Aún no hay comentarios</h5>
            <p>Cuando los usuarios envíen comentarios aparecerán aquí.</p>
        </div>
    }
    else
    {
        <div class="feedbacks-grid">
            @foreach (var feedback in Model)
            {
                <div class="feedback-card">
                    <div class="feedback-header">
                        <div class="feedback-user">
                            @if (!string.IsNullOrEmpty(feedback.User?.ProfileImage))
                            {
                                <img src="@feedback.User.ProfileImage" class="feedback-avatar" />
                            }
                            else
                            {
                                <div class="feedback-avatar-letter">
                                    @feedback.User?.Username.Substring(0, 1).ToUpper()
                                </div>
                            }
                            <div>
                                <div class="feedback-username">@feedback.User?.Username</div>
                                <div class="feedback-date">@feedback.CreatedAt.ToString("dd MMM yyyy · HH:mm")</div>
                            </div>
                        </div>
                        <div class="feedback-quote">💬</div>
                    </div>
                    <div class="feedback-message">
                        @feedback.Message
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
.feedbacks-page { max-width: 900px; margin: 0 auto; }

.feedbacks-header { margin-bottom: 24px; }
.feedbacks-title { font-size: 24px; font-weight: 800; color: #111827; margin: 0 0 4px; }
.feedbacks-subtitle { font-size: 14px; color: #9ca3af; margin: 0; }

.feedbacks-empty {
    text-align: center;
    padding: 60px 20px;
    background: white;
    border-radius: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
}

.empty-icon { font-size: 52px; margin-bottom: 14px; }
.feedbacks-empty h5 { font-size: 20px; font-weight: 700; color: #111827; margin-bottom: 8px; }
.feedbacks-empty p { font-size: 14px; color: #9ca3af; margin: 0; }

.feedbacks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 16px;
}

@@media (max-width: 600px) {
    .feedbacks-grid { grid-template-columns: 1fr; }
}

.feedback-card {
    background: white;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
    transition: 0.2s;
    border-left: 4px solid #2563eb;
}

.feedback-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}

.feedback-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.feedback-user { display: flex; align-items: center; gap: 12px; }

.feedback-avatar {
    width: 44px; height: 44px;
    border-radius: 50%; object-fit: cover;
    border: 2px solid #e5e7eb;
    flex-shrink: 0;
}

.feedback-avatar-letter {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 17px;
    flex-shrink: 0;
}

.feedback-username { font-size: 15px; font-weight: 700; color: #111827; }
.feedback-date { font-size: 12px; color: #9ca3af; margin-top: 2px; }

.feedback-quote { font-size: 24px; opacity: 0.3; }

.feedback-message {
    font-size: 14px;
    color: #4b5563;
    line-height: 1.6;
    background: #f9fafb;
    padding: 14px 16px;
    border-radius: 12px;
    border-left: 3px solid #e5e7eb;
}

/* DARK MODE */
body.bg-dark .feedbacks-title { color: #f1f5f9 !important; }
body.bg-dark .feedbacks-empty,
body.bg-dark .feedback-card {
    background: #1e1e2e !important;
    border-color: #2d2d3d !important;
}
body.bg-dark .feedback-card { border-left-color: #2563eb !important; }
body.bg-dark .feedbacks-empty h5 { color: #f1f5f9 !important; }
body.bg-dark .feedback-username { color: #f1f5f9 !important; }
body.bg-dark .feedback-message {
    background: #2d2d3d !important;
    color: #cbd5e1 !important;
    border-left-color: #3d3d4d !important;
}
</style>