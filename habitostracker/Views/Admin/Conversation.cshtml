@model List<HabitTrackerApp.Models.Message>

<div class="conversation-page">

    <div class="conversation-header">
        <h2 class="conversation-title">💬 Conversación</h2>
        <p class="conversation-subtitle">Modo moderación — solo lectura</p>
    </div>

    <div class="chat-container">
        <div class="chat-toolbar">
            <div class="chat-users">
                <div class="chat-user-pill">
                    👤 Usuario @ViewBag.User1
                </div>
                <span class="chat-vs">↔</span>
                <div class="chat-user-pill">
                    👤 Usuario @ViewBag.User2
                </div>
            </div>
            <div class="chat-live-badge" id="liveBadge">
                <span class="live-dot"></span> En vivo
            </div>
        </div>

        <div id="chatBox" class="chat-box">
            @if (!Model.Any())
            {
                <div class="chat-empty">
                    <span>💬</span>
                    <p>No hay mensajes en esta conversación</p>
                </div>
            }
            else
            {
                @foreach (var msg in Model)
                {
                    <div class="chat-message">
                        <div class="chat-message-header">
                            <div class="chat-sender">
                                @{
                                    var senderImg = msg.Sender?.ProfileImage ?? msg.Sender?.ProfilePicture;
                                }
                                @if (!string.IsNullOrEmpty(senderImg))
                                {
                                    <img src="@senderImg" class="chat-avatar-img" />
                                }
                                else
                                {
                                    <div class="chat-avatar-letter">
                                        @(msg.Sender != null ? msg.Sender.Username.Substring(0,1).ToUpper() : "X")
                                    </div>
                                }
                                <span class="chat-username">
                                    @(msg.Sender != null ? msg.Sender.Username : "Cuenta eliminada")
                                </span>
                            </div>
                            <span class="chat-time">@msg.SentAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="chat-bubble">@msg.Content</div>
                        @if (msg.IsRead)
                        {
                            <div class="chat-read">✔✔ Visto</div>
                        }
                    </div>
                }
            }
        </div>
    </div>

</div>

<style>
.conversation-page { max-width: 800px; margin: 0 auto; }

.conversation-header { margin-bottom: 20px; }
.conversation-title { font-size: 24px; font-weight: 800; color: #111827; margin: 0 0 4px; }
.conversation-subtitle { font-size: 14px; color: #9ca3af; margin: 0; }

.chat-container {
    background: white;
    border-radius: 22px;
    box-shadow: 0 2px 14px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.04);
    overflow: hidden;
}

.chat-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #f3f4f6;
    flex-wrap: wrap;
    gap: 10px;
}

.chat-users { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

.chat-user-pill {
    background: #eff6ff;
    color: #2563eb;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
}

.chat-vs { font-size: 16px; color: #9ca3af; }

.chat-live-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #f0fdf4;
    color: #16a34a;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.live-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #16a34a;
    animation: pulse 1.5s infinite;
}

@@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
}

.chat-box {
    max-height: 520px;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-behavior: smooth;
}

.chat-box::-webkit-scrollbar { width: 4px; }
.chat-box::-webkit-scrollbar-track { background: transparent; }
.chat-box::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 10px; }

.chat-empty {
    text-align: center;
    padding: 40px;
    color: #9ca3af;
}

.chat-empty span { font-size: 40px; display: block; margin-bottom: 10px; }
.chat-empty p { font-size: 14px; margin: 0; }

.chat-message {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.chat-message-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.chat-sender { display: flex; align-items: center; gap: 8px; }

.chat-avatar-img {
    width: 32px; height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e5e7eb;
}

.chat-avatar-letter {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
}

.chat-username { font-size: 13px; font-weight: 700; color: #111827; }
.chat-time { font-size: 11px; color: #9ca3af; white-space: nowrap; }

.chat-bubble {
    background: #f9fafb;
    border: 1px solid #f3f4f6;
    border-radius: 0 14px 14px 14px;
    padding: 10px 14px;
    font-size: 14px;
    color: #374151;
    line-height: 1.5;
    max-width: 85%;
    word-break: break-word;
}

.chat-read {
    font-size: 11px;
    color: #2563eb;
    padding-left: 4px;
}

/* DARK MODE */
body.bg-dark .conversation-title { color: #f1f5f9 !important; }
body.bg-dark .chat-container { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .chat-toolbar { border-color: #2d2d3d !important; }
body.bg-dark .chat-user-pill { background: #1e3a5f !important; color: #60a5fa !important; }
body.bg-dark .chat-bubble { background: #2d2d3d !important; border-color: #3d3d4d !important; color: #e2e8f0 !important; }
body.bg-dark .chat-username { color: #f1f5f9 !important; }
body.bg-dark .chat-box::-webkit-scrollbar-thumb { background: #3d3d4d; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const user1 = "@ViewBag.User1";
    const user2 = "@ViewBag.User2";

    const connectionAdminChat = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    connectionAdminChat.on("ReceiveMessage", function(senderId, receiverId, username, message, time) {
        if (
            (senderId == user1 && receiverId == user2) ||
            (senderId == user2 && receiverId == user1)
        ) {
            const chatBox = document.getElementById("chatBox");
            const msg = document.createElement("div");
            msg.className = "chat-message";
            msg.innerHTML = `
                <div class="chat-message-header">
                    <div class="chat-sender">
                        <div class="chat-avatar-letter">${username.charAt(0).toUpperCase()}</div>
                        <span class="chat-username">${username}</span>
                    </div>
                    <span class="chat-time">${time}</span>
                </div>
                <div class="chat-bubble">${message}</div>
            `;
            chatBox.appendChild(msg);
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    });

    connectionAdminChat.start();

    // Auto scroll al fondo
    const chatBox = document.getElementById("chatBox");
    if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
</script>