    const motivos = ["Contenido inapropiado", "Acoso o intimidación", "Spam o publicidad", "Lenguaje ofensivo", "Otro"];
    const motivo = prompt("¿Por qué quieres denunciar a este usuario?\n\n" + motivos.map((m, i) => `${i + 1}. ${m}`).join("\n") + "\n\nEscribe el número del motivo:");
    if (!motivo) return;
    const idx = parseInt(motivo.trim()) - 1;
    const reason = (idx >= 0 && idx < motivos.length) ? motivos[idx] : "Otro";
    const res = await fetch("/User/ReportUser", {
        method: "POST",
