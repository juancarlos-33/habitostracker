}

.btn-send-audio { background: #dcfce7; color: #16a34a; }
.btn-cancel-audio { background: #fee2e2; color: #dc2626; }

body.bg-dark .chat-page { background: #1e1e2e !important; }
body.bg-dark .chat-header { background: #1e1e2e !important; border-color: #2d2d3d !important; }
body.bg-dark .chat-header-name { color: #f1f5f9 !important; }
body.bg-dark .chat-box { background: #0f172a !important; }
body.bg-dark .bubble-theirs { background: #2d2d3d !important; color: #f1f5f9 !important; }
