body.bg-dark .date-separator span { background: #334155 !important; color: #94a3b8 !important; }
body.bg-dark .msg-context-menu { background: #0f172a !important; border-color: #334155 !important; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const myId = "@User.FindFirst("UserId").Value";
const receiverId = "@ViewBag.OtherUserId";
const chatBox = document.getElementById("chatBox");
const sendBtn = document.getElementById("sendBtn");
const pendingConfirms = new Set();

window.addEventListener("load", () => { chatBox.scrollTop = chatBox.scrollHeight; });

const chatConnection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub").withAutomaticReconnect().build();

async function startConnection() {
    await chatConnection.start();
    await chatConnection.invoke("JoinUserGroup", myId);
    // 🔥 registrar que estoy en este chat
    await chatConnection.invoke("EnterChat", receiverId);
    await fetch("/Message/MarkAsSeen?senderId=" + receiverId, { method: "POST" });
    localStorage.setItem("currentChatUserId", receiverId);

    const blockCheck = await fetch(`/User/IsBlocked?userId=${receiverId}`);
    const blockStatus = await blockCheck.json();
    if (blockStatus.blocked) { deshabilitarChat(); mostrarAnuncioBloqueo(true); }
}

startConnection().catch(err => console.error(err));

// 🔥 visibilitychange — mensajes nuevos al volver + EnterChat/LeaveChat
document.addEventListener("visibilitychange", async () => {
    if (document.visibilityState === "hidden") {
        try { await chatConnection.invoke("LeaveChat", receiverId); } catch(e) {}
    } else {
        await handleAppReturn();
    }
});

// 🔥 también escuchar focus para cubrir casos donde visibilitychange no dispara
window.addEventListener("focus", async () => {
    await handleAppReturn();
});

// 🔥 también pageshow cubre cuando el navegador restaura la página desde caché
window.addEventListener("pageshow", async (e) => {
    if (e.persisted) await handleAppReturn();
});

async function handleAppReturn() {
    if (chatConnection.state === "Disconnected") {
        await startConnection();
    } else {
        if (chatConnection.state === "Connected") {
            try {
                await chatConnection.invoke("JoinUserGroup", myId);
                await chatConnection.invoke("EnterChat", receiverId);
            } catch(e) {}
        }
    }
    await fetch("/Message/MarkAsSeen?senderId=" + receiverId, { method: "POST" });
    await loadNewMessages();
}

async function loadNewMessages() {
    const msgWraps = chatBox.querySelectorAll(".msg-wrap[id^='msg-']");
    let lastId = 0;
    msgWraps.forEach(w => { const id = parseInt(w.id.replace("msg-", "")); if (id > lastId) lastId = id; });

    const res = await fetch(`/Message/GetNewMessages?senderId=${receiverId}&lastId=${lastId}`);
    if (!res.ok) return;
    const msgs = await res.json();

    msgs.forEach(msg => {
        if (document.getElementById("msg-" + msg.id)) return;
        const isMe = msg.senderId == myId;
        const wrap = document.createElement("div");
        wrap.className = `msg-wrap ${isMe ? "msg-mine" : "msg-theirs"}`;
        wrap.id = "msg-" + msg.id;

        let mediaHTML = "";
        if (msg.fileUrl) {
            const isImg = msg.fileUrl.includes("/image/upload/") || /\.(jpg|jpeg|png|gif)$/i.test(msg.fileUrl);
            const isVid = msg.fileUrl.includes("/video/upload/") || /\.(mp4|webm)$/i.test(msg.fileUrl);
            if (isImg) mediaHTML = `<img src="${msg.fileUrl}" class="msg-media" />`;
            else if (isVid) mediaHTML = `<video controls class="msg-media"><source src="${msg.fileUrl}" /></video>`;
        }

        let contentHTML = "";
        if (msg.content && msg.content.trim() !== "") {
            if (msg.content.startsWith("http") && (msg.content.includes("cloudinary") || msg.content.includes("/audios/")))
                contentHTML = `<audio controls class="msg-audio"><source src="${msg.content}" /></audio>`;
            else if (!msg.fileUrl)
                contentHTML = `<span class="msg-text">${msg.content}</span>`;
        }

        const checkHTML = isMe ? `<span class="msg-check ${msg.isRead ? "seen" : "sent"}">✔</span>` : "";

        wrap.innerHTML = `
            <div class="msg-content-wrap">
                <div class="msg-bubble ${isMe ? "bubble-mine" : "bubble-theirs"}">
                    ${contentHTML}${mediaHTML}
                    <div class="msg-footer"><span class="msg-time">${msg.time}</span>${checkHTML}</div>
                </div>
            </div>`;

        chatBox.insertBefore(wrap, document.getElementById("typingIndicator"));
    });

    if (msgs.length > 0) {
        // 🔥 banner mensajes no leídos
        const unread = msgs.filter(m => m.senderId != myId);
        if (unread.length > 0) {
            document.getElementById("unreadBanner")?.remove();
            const banner = document.createElement("div");
            banner.id = "unreadBanner";
            banner.style.cssText = "text-align:center;padding:8px 16px;margin:6px 12px;background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.25);border-radius:12px;font-size:13px;color:#6366f1;font-weight:600;cursor:pointer;";
            banner.textContent = `📩 ${unread.length} mensaje${unread.length > 1 ? "s" : ""} nuevo${unread.length > 1 ? "s" : ""}`;
            banner.onclick = () => { chatBox.scrollTop = chatBox.scrollHeight; banner.remove(); };
           // 🔥 insertar banner ANTES del primer mensaje nuevo
const primerMensajeNuevo = document.getElementById("msg-" + msgs[0].id);
if (primerMensajeNuevo) {
    chatBox.insertBefore(banner, primerMensajeNuevo);
} else {
    chatBox.appendChild(banner);
}
            setTimeout(() => banner?.remove(), 4000);
        }
        chatBox.scrollTop = chatBox.scrollHeight;
        await fetch("/Message/MarkAsSeen?senderId=" + receiverId, { method: "POST" });
    }
}

function makeTime() { return new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' }); }

function scrollBottom(wrap) {
    const imgs = wrap ? wrap.querySelectorAll("img") : [];
    if (imgs.length > 0) { imgs[0].onload = () => chatBox.scrollTop = chatBox.scrollHeight; imgs[0].onerror = () => chatBox.scrollTop = chatBox.scrollHeight; }
    chatBox.scrollTop = chatBox.scrollHeight;
}

let longPressTimer = null;
function startLongPress(e, msgId, isMine) {
    longPressTimer = setTimeout(() => {
        const touch = e.touches[0];
        openMsgMenu({ preventDefault: () => {}, clientX: touch.clientX, clientY: touch.clientY }, msgId, isMine);
    }, 600);
}
function cancelLongPress() { if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; } }

let ctxMessageId = null, ctxIsMine = false;
function openMsgMenu(e, msgId, isMine) {
    e.preventDefault();
    ctxMessageId = msgId; ctxIsMine = isMine;
    const menu = document.getElementById("msgContextMenu");
    const overlay = document.getElementById("ctxOverlay");
    document.getElementById("ctxDeleteAll").style.display = isMine ? "flex" : "none";
    menu.style.display = "block"; overlay.style.display = "block";
    menu.style.left = Math.min(e.clientX, window.innerWidth - 220) + "px";
    menu.style.top = Math.min(e.clientY, window.innerHeight - 120) + "px";
}

function ctxClose() {
    document.getElementById("msgContextMenu").style.display = "none";
    document.getElementById("ctxOverlay").style.display = "none";
    ctxMessageId = null;
}

async function ctxDelete(scope) {
    const msgId = ctxMessageId; ctxClose();
    if (!msgId) return;
    if (!confirm(scope === "all" ? "¿Eliminar para todos?" : "¿Eliminar para ti?")) return;
    const res = await fetch(`/Message/Delete?messageId=${msgId}&scope=${scope}`, { method: "POST" });
    if (res.ok) {
        const el = document.getElementById("msg-" + msgId);
        if (el) {
            if (scope === "all") { const b = el.querySelector(".msg-bubble"); if(b) b.innerHTML = `<span style="font-style:italic;opacity:0.6;font-size:13px;">Mensaje eliminado</span>`; }
            else { el.style.opacity = "0"; el.style.transition = "0.3s"; setTimeout(() => el.remove(), 300); }
        }
    }
}

document.getElementById("chatForm").addEventListener("submit", async function(e) {
    e.preventDefault();
    const content = document.getElementById("messageInput").value.trim();
    const fileInput = document.getElementById("fileInput");
    const file = fileInput.files[0];
    if (!content && !file) return;

    const tempId = "temp-" + Date.now();
    const wrap = document.createElement("div");
    wrap.className = "msg-wrap msg-mine"; wrap.id = tempId;

    let mediaHTML = "";
    if (file) {
        const url = URL.createObjectURL(file);
        if (file.type.startsWith("image")) mediaHTML = `<img src="${url}" class="msg-media" />`;
        else if (file.type.startsWith("video")) mediaHTML = `<video controls class="msg-media"><source src="${url}" /></video>`;
    }

    const replyId = document.getElementById('dmReplyToMessageId').value;
    const replyName = document.getElementById('dmReplyName').textContent;
    const replyText = document.getElementById('dmReplyText').textContent;
    let replyHTML = "";
    if (replyId) {
        replyHTML = `<div class="msg-reply"><div class="msg-reply-name">${escapeHtmlDM(replyName)}</div><div class="msg-reply-text">${escapeHtmlDM(replyText)}</div></div>`;
    }

    const previewC = (content && content.length > 80) ? content.substring(0,80)+'…' : (content||'');
    wrap.innerHTML = `
        <div class="msg-content-wrap"><div class="msg-bubble bubble-mine" data-msg-id="${tempId}" data-sender-name="@(ViewBag.MyUsername ?? "Yo")" data-content-preview="${escapeHtmlDM(previewC)}">
            ${replyHTML}
            ${content ? `<span class="msg-text">${content}</span>` : ""}${mediaHTML}
            <div class="msg-footer"><span class="msg-time">${makeTime()}</span><span class="msg-check pending" id="check-${tempId}">🕐</span></div>
        </div></div>`;

    chatBox.insertBefore(wrap, document.getElementById("typingIndicator"));
    scrollBottom(wrap);

    document.getElementById("messageInput").value = "";
    sendBtn.disabled = true; closeEmoji();
    fileInput.value = "";
    document.getElementById("previewContainer").style.display = "none";
    document.getElementById("previewImage").style.display = "none";
    document.getElementById("previewVideo").style.display = "none";

    const formData = new FormData();
    formData.append("receiverId", receiverId);
    if (content) formData.append("content", content);
    if (file) formData.append("file", file);
    if (replyId) formData.append("replyToMessageId", replyId);
    formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);
    cancelarReplyDM();

    try {
        const res = await fetch('/Message/Send', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
            const check = document.getElementById("check-" + tempId);
            if (check) {
                check.textContent = "✔"; check.className = "msg-check sent";
                check.setAttribute("data-message-id", data.messageId);
                if (pendingConfirms.has(data.messageId)) {
                    check.textContent = "✔✔"; check.className = "msg-check delivered";
                    pendingConfirms.delete(data.messageId);
                }
            }
            wrap.id = "msg-" + data.messageId;
            const bubbleEl = wrap.querySelector('.msg-bubble');
            if (bubbleEl) bubbleEl.setAttribute('data-msg-id', data.messageId);
            if (data.filePath && data.filePath !== "") {
                const mediaEl = wrap.querySelector(".msg-media");
                if (mediaEl) {
                    if (data.filePath.includes("/image/upload/") || /\.(jpg|jpeg|png|gif)$/i.test(data.filePath)) mediaEl.src = data.filePath;
                    else { const src = mediaEl.querySelector("source"); if (src) { src.src = data.filePath; mediaEl.load(); } }
                }
            }
        } else { wrap.remove(); if (data.error) alert(data.error); }
    } catch (err) { wrap.remove(); alert("Error de conexión"); }
});

function escapeHtmlDM(s){ return (s||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

// 🔥 SIGNALR LISTENERS
chatConnection.on("ReceiveMessage", (senderId, rcvId, senderName, message, fileUrl, msgId, replyId, replySender, replyContent) => {
    if (String(senderId) !== String(receiverId) && String(rcvId) !== String(receiverId)) return;
    if (String(senderId) === String(myId)) return;
    document.getElementById("typingIndicator").style.display = "none";

    let mediaHTML = "";
    if (fileUrl && fileUrl.trim() !== "") {
        const isImg = fileUrl.includes("/image/upload/") || /\.(jpg|jpeg|png|gif)$/i.test(fileUrl);
        const isVid = fileUrl.includes("/video/upload/") || /\.(mp4|webm)$/i.test(fileUrl);
        if (isImg) mediaHTML = `<img src="${fileUrl}" class="msg-media" />`;
        else if (isVid) mediaHTML = `<video controls class="msg-media"><source src="${fileUrl}" /></video>`;
    }

    let replyHTML = "";
    if (replyId && replyId > 0) {
        replyHTML = `<div class="msg-reply" onclick="scrollToMsg(${replyId})"><div class="msg-reply-name">${escapeHtmlDM(replySender||'')}</div><div class="msg-reply-text">${escapeHtmlDM(replyContent||'')}</div></div>`;
    }

    const previewC = (message && message.length > 80) ? message.substring(0,80)+'…' : (message||'');
    const wrap = document.createElement("div");
    wrap.className = "msg-wrap msg-theirs";
    if (msgId) wrap.id = "msg-" + msgId;
    wrap.innerHTML = `
        <div class="msg-content-wrap"><div class="msg-bubble bubble-theirs" data-msg-id="${msgId||''}" data-sender-name="${escapeHtmlDM(senderName||'')}" data-content-preview="${escapeHtmlDM(previewC)}">
            ${replyHTML}
            ${(message && message.trim() !== "") ? `<span class="msg-text">${message}</span>` : ""}${mediaHTML}
            <div class="msg-footer"><span class="msg-time">${makeTime()}</span></div>
        </div></div>`;

    chatBox.insertBefore(wrap, document.getElementById("typingIndicator"));
    scrollBottom(wrap);
    fetch("/Message/MarkAsSeen?senderId=" + senderId, { method: "POST" });
    chatConnection.invoke("MessagesViewed", senderId);
});

chatConnection.on("ReceiveAudio", (senderId, audioUrl) => {
    if (String(senderId) !== String(receiverId)) return;
    const wrap = document.createElement("div");
    wrap.className = "msg-wrap msg-theirs";
    wrap.innerHTML = `
        <div class="msg-content-wrap"><div class="msg-bubble bubble-theirs">
            <audio controls class="msg-audio"><source src="${audioUrl}" /></audio>
            <div class="msg-footer"><span class="msg-time">${makeTime()}</span></div>
        </div></div>`;
    chatBox.insertBefore(wrap, document.getElementById("typingIndicator"));
    scrollBottom(null);
});

chatConnection.on("UserRecording", () => {
    const ind = document.getElementById("typingIndicator");
    ind.innerHTML = `<span style="width:8px;height:8px;border-radius:50%;background:#dc2626;animation:recPulse 1s infinite;display:inline-block;flex-shrink:0;"></span><span style="font-size:12px;color:#dc2626;font-weight:600;margin-left:6px;">Grabando audio...</span>`;
    ind.style.display = "flex"; ind.setAttribute("data-recording", "true");
    chatBox.scrollTop = chatBox.scrollHeight;
});

chatConnection.on("UserStoppedRecording", () => {
    const ind = document.getElementById("typingIndicator");
    if (ind.getAttribute("data-recording") === "true") {
        ind.innerHTML = `<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>`;
        ind.style.display = "none"; ind.removeAttribute("data-recording");
    }
});

chatConnection.on("MessageDeleted", (messageId) => {
    const el = document.getElementById("msg-" + messageId);
    if (el) { const b = el.querySelector(".msg-bubble"); if(b) b.innerHTML = `<span style="font-style:italic;opacity:0.6;font-size:13px;">Mensaje eliminado</span>`; }
});

chatConnection.on("MessageSentConfirm", (messageId) => {
    const check = document.querySelector(`[data-message-id='${messageId}']`);
    if (check) { check.textContent = "✔✔"; check.className = "msg-check delivered"; }
    else pendingConfirms.add(messageId);
});

chatConnection.on("MessageSeen", (messageId) => {
    const s = document.querySelector(`[data-message-id='${messageId}']`);
    if (s) { s.textContent = "✔✔"; s.className = "msg-check seen"; }
});

chatConnection.on("ForceSeenUpdate", () => {
    document.querySelectorAll(".msg-check.delivered, .msg-check.sent").forEach(m => { m.textContent = "✔✔"; m.className = "msg-check seen"; });
});

// 🔥 online/offline con contador en tiempo real
let offlineSeconds = 0;
let offlineInterval = null;

chatConnection.on("UserOnline", (uid) => {
    if (uid != receiverId) return;
    clearInterval(offlineInterval); offlineSeconds = 0;
    document.getElementById("onlineStatus").textContent = "● En línea";
    document.getElementById("onlineStatus").className = "chat-header-status online";
    const dot = document.getElementById("onlineDot");
    if (dot) dot.style.display = "block";
});

chatConnection.on("UserOffline", (uid) => {
    if (uid != receiverId) return;
    document.getElementById("onlineStatus").className = "chat-header-status offline";
    const dot = document.getElementById("onlineDot");
    if (dot) dot.style.display = "none";
    offlineSeconds = 0;
    clearInterval(offlineInterval);
    function updateOfflineText() {
        offlineSeconds += 60;
        const mins = Math.floor(offlineSeconds / 60);
        const hours = Math.floor(mins / 60);
        let text = mins < 2 ? "Hace un momento" : mins < 60 ? `Hace ${mins} min` : hours < 24 ? `Hace ${hours} h` : "Hace más de un día";
        document.getElementById("onlineStatus").textContent = "○ " + text;
    }
    document.getElementById("onlineStatus").textContent = "○ Hace un momento";
    offlineInterval = setInterval(updateOfflineText, 60000);
});

// 🔥 si ya estaba offline al cargar, iniciar contador desde el tiempo real
@{
    if (!isOnline && lastOnline.HasValue)
    {
        var totalSecs = (int)(DateTime.UtcNow - lastOnline.Value.ToUniversalTime()).TotalSeconds;
        @Html.Raw($@"
offlineSeconds = {totalSecs};
offlineInterval = setInterval(() => {{
    offlineSeconds += 60;
    const mins = Math.floor(offlineSeconds / 60);
    const hours = Math.floor(mins / 60);
    let text = mins < 2 ? 'Hace un momento' : mins < 60 ? `Hace ${{mins}} min` : hours < 24 ? `Hace ${{hours}} h` : 'Hace más de un día';
    document.getElementById('onlineStatus').textContent = '○ ' + text;
}}, 60000);
        ")
    }
}

