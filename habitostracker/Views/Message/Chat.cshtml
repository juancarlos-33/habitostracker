    const el = document.getElementById('msg-' + id);
    if(!el) return;
    el.scrollIntoView({behavior:'smooth', block:'center'});
    el.style.transition='background 0.3s';
    el.style.background='rgba(99,102,241,0.10)';
    setTimeout(()=>el.style.background='', 1200);
}

/* ═════════ SWIPE-TO-REPLY (móvil) ═════════ */
(function(){
    const THRESHOLD = 60, MAX = 80, RATIO = 1.4;
    if (!('ontouchstart' in window) && !navigator.maxTouchPoints) return;
    let active = null;

    function getInfo(bubble){
        return {
            id: bubble.getAttribute('data-msg-id'),
            sender: bubble.getAttribute('data-sender-name') || '',
            content: bubble.getAttribute('data-content-preview') || ''
        };
    }
    function ensureInd(bubble){
        let el = bubble.querySelector(':scope > .dm-swipe-ind');
        if(el) return el;
        el = document.createElement('div');
        el.className = 'dm-swipe-ind';
        el.textContent = '↩';
        el.style.cssText='position:absolute;top:50%;width:36px;height:36px;border-radius:50%;background:#6366f1;color:white;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;opacity:0;pointer-events:none;transition:opacity 0.12s;z-index:5;transform:translateY(-50%);';
        bubble.appendChild(el);
        return el;
    }
    function start(e, bubble){
        if(!bubble.getAttribute('data-msg-id')) return;
        if(e.touches && e.touches.length>1) return;
        const t = e.touches[0];
        active = { bubble, sx:t.clientX, sy:t.clientY, dx:0, dy:0, locked:false, ind: ensureInd(bubble) };
        const wrap = bubble.closest('.msg-wrap');
        const isMine = wrap && wrap.classList.contains('msg-mine');
        active.ind.style.left = isMine ? 'auto' : '-44px';
        active.ind.style.right = isMine ? '-44px' : 'auto';
        bubble.style.transition = 'transform 0s';
    }
    function move(e){
        if(!active) return;
        const t = e.touches[0];
        active.dx = t.clientX - active.sx;
        active.dy = t.clientY - active.sy;
        const wrap = active.bubble.closest('.msg-wrap');
        const isMine = wrap && wrap.classList.contains('msg-mine');
        const dir = isMine ? -1 : 1;
        const horizontal = active.dx * dir;

        if(!active.locked){
            if(Math.abs(active.dx) < 6 && Math.abs(active.dy) < 6) return;
            if(Math.abs(active.dx) > Math.abs(active.dy)*RATIO && horizontal > 0){
                active.locked = true;
            } else {
                active = null;
                return;
            }
        }
        if(e.cancelable) e.preventDefault();
        const clamped = Math.max(0, Math.min(horizontal, MAX));
        active.bubble.style.transform = 'translateX(' + (dir * clamped) + 'px)';
        active.ind.style.opacity = Math.min(1, clamped / THRESHOLD).toFixed(2);
        active.ind.style.transform = 'translateY(-50%) scale(' + (0.6 + 0.4*Math.min(1, clamped/THRESHOLD)).toFixed(2) + ')';
    }
    function end(){
        if(!active) return;
        const wrap = active.bubble.closest('.msg-wrap');
        const isMine = wrap && wrap.classList.contains('msg-mine');
        const horizontal = active.dx * (isMine ? -1 : 1);
        active.bubble.style.transition = 'transform 0.18s ease';
        active.bubble.style.transform = '';
        active.ind.style.opacity = '0';
        if(active.locked && horizontal >= THRESHOLD){
            const info = getInfo(active.bubble);
            if(info.id) {
                responderMensajeDM(parseInt(info.id,10), info.sender, info.content);
                if(navigator.vibrate) navigator.vibrate(15);
            }
        }
        active = null;
    }
    function attach(b){
        if(b._swipeAttached) return;
        b._swipeAttached = true;
        b.addEventListener('touchstart', e => start(e, b), {passive:true});
        b.addEventListener('touchmove', move, {passive:false});
        b.addEventListener('touchend', end);
        b.addEventListener('touchcancel', end);
    }
    function attachAll(){ document.querySelectorAll('.msg-bubble[data-msg-id]').forEach(attach); }
    attachAll();
    const cb = document.getElementById('chatBox');
    if(cb){ new MutationObserver(()=>attachAll()).observe(cb,{childList:true,subtree:true}); }
})();

/* Doble-click en bubble = reply en desktop */
document.addEventListener('dblclick', function(e){
    const b = e.target.closest('.msg-bubble[data-msg-id]');
    if(!b) return;
    const id = b.getAttribute('data-msg-id');
    const sender = b.getAttribute('data-sender-name') || '';
    const content = b.getAttribute('data-content-preview') || '';
    responderMensajeDM(parseInt(id,10), sender, content);
});
</script>