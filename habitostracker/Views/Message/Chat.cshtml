    <form id="chatForm" asp-controller="Message" asp-action="Send" method="post"
          enctype="multipart/form-data" data-no-loader="true">
        @Html.AntiForgeryToken()
        <input type="hidden" name="receiverId" value="@ViewBag.OtherUserId" />
        <input type="hidden" name="replyToMessageId" id="dmReplyToMessageId" value="" />
        <input type="file" name="file" id="fileInput" style="display:none;" accept="image/*,video/*" />

        <div id="previewContainer" style="display:none;" class="preview-container">
            <span class="preview-close" onclick="removePreview()">✕</span>
            <img id="previewImage" style="display:none;" />
            <video id="previewVideo" controls style="display:none;"></video>
        </div>

        <div id="audioPreview" style="display:none;" class="audio-preview">
            <audio id="previewPlayer" controls></audio>
            <div class="audio-btns">
                <button type="button" class="btn-send-audio" onclick="sendAudio()">Enviar audio</button>
                <button type="button" class="btn-cancel-audio" onclick="cancelAudio()">Cancelar</button>
            </div>
        </div>

        <div id="recordingStatus" style="display:none;" class="recording-status">
            <span class="rec-dot"></span>
            <span class="rec-label">Grabando</span>
            <span id="recTimer" class="rec-timer">0:00</span>
        </div>

@{
    bool isSystemChat = ViewBag.IsSystemChat == true;
    bool isPendingRequest = reqStatus == "Pending" && yoEnvie;
}
@if (isSystemChat)
{
    <div style="text-align:center;padding:10px 16px;margin:0 0 8px;background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.15);border-radius:14px;font-size:12px;color:#818cf8;font-weight:600;line-height:1.6;">
        🤖 Este es un mensaje automático del sistema.<br>No puedes responder a este chat.
    </div>
}
<div class="input-bar" @(isSystemChat || isPendingRequest ? "style=opacity:0.4;pointer-events:none;" : "")>
    <button type="button" class="bar-btn emoji-toggle" onclick="toggleEmoji()" data-no-loader>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="10"/>
            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
            <line x1="9" y1="9" x2="9.01" y2="9"/>
            <line x1="15" y1="9" x2="15.01" y2="9"/>
        </svg>
    </button>
    <button type="button" class="bar-btn" onclick="document.getElementById('fileInput').click()" title="Adjuntar" data-no-loader>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/>
        </svg>
    </button>
    <button type="button" class="bar-btn rec-btn" onclick="startRecording()" id="recordBtn" title="Grabar audio" data-no-loader>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/>
            <path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/>
        </svg>
    </button>
@if (isPendingRequest)
{
    <div style="text-align:center;padding:10px 16px;margin:0 0 8px;background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.15);border-radius:14px;font-size:12px;color:#fbbf24;font-weight:600;line-height:1.6;">
        ⏳ Esperando que @otherName acepte tu solicitud para chatear.
    </div>
}
<input type="text" id="messageInput" name="content" class="msg-input"
       placeholder="@(isDeletedUser ? "No puedes enviar mensajes" : isSystemChat ? "Este es un mensaje automático del sistema" : isPendingRequest ? "Esperando que acepten tu solicitud..." : "Escribe algo...")"
       @(isDeletedUser || isSystemChat || isPendingRequest ? "disabled" : "") autocomplete="off" />
<button type="submit" class="send-btn" id="sendBtn" @(isDeletedUser || isSystemChat || isPendingRequest ? "disabled" : "") disabled>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
    </svg>
</button>
        </div>
    </form>
</div>

<style>
.chat-page { display: flex; flex-direction: column; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #f8f9fb; z-index: 10; overflow: hidden; padding-top: 90px; }
@@media (min-width: 768px) { .chat-page { position: relative; padding-top: 0; height: calc(100vh - 130px); max-width: 860px; margin: 0 auto; border-radius: 20px; box-shadow: 0 8px 40px rgba(0,0,0,0.1); overflow: hidden; border: 1px solid rgba(0,0,0,0.06); } }
.chat-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: linear-gradient(135deg, #1e293b, #334155); flex-shrink: 0; z-index: 2; }
.chat-header-user { display: flex; align-items: center; gap: 12px; text-decoration: none; color: white; min-width: 0; flex: 1; }
.chat-avatar-wrap { position: relative; flex-shrink: 0; }
.chat-header-avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,0.2); display: block; }
.avatar-letter { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 16px; border: 2px solid rgba(255,255,255,0.2); }
.online-dot { position: absolute; bottom: 1px; right: 1px; width: 11px; height: 11px; border-radius: 50%; background: #22c55e; border: 2px solid #1e293b; }
.chat-header-name { font-size: 15px; font-weight: 700; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chat-header-status { font-size: 11px; margin-top: 1px; color: rgba(255,255,255,0.5); }
.chat-header-status.online { color: #4ade80; }
.header-menu-wrap { position: relative; flex-shrink: 0; }
.header-menu-btn { width: 38px; height: 38px; border-radius: 50%; border: none; background: rgba(255,255,255,0.1); color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
.header-menu-btn:hover { background: rgba(255,255,255,0.2); }
.header-menu-dropdown { position: absolute; top: 46px; right: 0; background: #1e293b; border-radius: 14px; padding: 6px; min-width: 220px; box-shadow: 0 12px 40px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.08); z-index: 9999; animation: menuFadeIn 0.15s ease; }
@@keyframes menuFadeIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
.header-menu-dropdown button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 14px; background: none; border: none; color: #f1f5f9; font-size: 14px; font-weight: 500; cursor: pointer; border-radius: 10px; text-align: left; transition: 0.15s; }
.header-menu-dropdown button:hover { background: rgba(255,255,255,0.08); }
.header-menu-dropdown .menu-danger { color: #f87171 !important; }
.menu-divider { margin: 4px 8px; border: none; border-top: 1px solid rgba(255,255,255,0.08); }
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
.modal-box { background: #1e293b; border-radius: 20px; padding: 28px 24px; min-width: 300px; max-width: 90vw; box-shadow: 0 20px 60px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.08); }
.modal-title { font-size: 17px; font-weight: 700; color: #f1f5f9; margin-bottom: 16px; }
.modal-desc { font-size: 14px; color: #94a3b8; margin-bottom: 16px; }
.modal-input { width: 100%; padding: 10px 14px; border-radius: 10px; border: 1.5px solid #334155; background: #0f172a; color: #f1f5f9; font-size: 14px; outline: none; margin-bottom: 16px; box-sizing: border-box; }
.modal-input:focus { border-color: #6366f1; }
.modal-options { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 16px; }
.modal-opt-btn { padding: 10px; border-radius: 10px; border: 1.5px solid #334155; background: #0f172a; color: #f1f5f9; font-size: 13px; font-weight: 600; cursor: pointer; transition: 0.15s; }
.modal-opt-btn:hover { background: #334155; border-color: #6366f1; color: #818cf8; }
.modal-actions { display: flex; gap: 8px; justify-content: flex-end; }
.modal-btn-cancel { padding: 9px 18px; border-radius: 10px; border: none; background: #334155; color: #94a3b8; font-size: 13px; font-weight: 600; cursor: pointer; }
.modal-btn-ok { padding: 9px 18px; border-radius: 10px; border: none; background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; font-size: 13px; font-weight: 600; cursor: pointer; }
#callModal, #incomingCallModal { position: fixed; inset: 0; background: rgba(15,23,42,0.92); z-index: 99999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(16px); }
.call-modal-inner { background: linear-gradient(160deg, #1e293b 0%, #0f172a 100%); border-radius: 32px; padding: 44px 36px; text-align: center; color: white; min-width: 300px; box-shadow: 0 32px 80px rgba(0,0,0,0.7); border: 1px solid rgba(255,255,255,0.07); }
.call-ripple { position: relative; width: 100px; height: 100px; margin: 0 auto 20px; }
.call-ripple::before, .call-ripple::after { content: ''; position: absolute; inset: -12px; border-radius: 50%; border: 2px solid rgba(99,102,241,0.3); animation: ripple 2s infinite; }
.call-ripple::after { animation-delay: 1s; }
@@keyframes ripple { 0% { transform: scale(0.9); opacity: 1; } 100% { transform: scale(1.4); opacity: 0; } }
.call-avatar-img { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #6366f1; display: block; }
.call-avatar-letter { width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; display: flex; align-items: center; justify-content: center; font-size: 38px; font-weight: 800; border: 3px solid #6366f1; margin: 0 auto; }
.call-name { font-size: 22px; font-weight: 700; margin-bottom: 8px; }
.call-status { font-size: 13px; color: rgba(255,255,255,0.5); }
.call-timer { font-size: 24px; font-weight: 700; color: #818cf8; margin-top: 8px; }
.incoming-pulse { color: #818cf8 !important; animation: textPulse 1.5s infinite; }
@@keyframes textPulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }
.call-actions { display: flex; justify-content: center; gap: 28px; margin-top: 32px; }
.call-end-btn, .call-reject-btn, .call-accept-btn { width: 64px; height: 64px; border-radius: 50%; border: none; cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; color: white; }
.call-end-btn, .call-reject-btn { background: linear-gradient(135deg,#dc2626,#b91c1c); box-shadow: 0 6px 20px rgba(220,38,38,0.4); }
.call-accept-btn { background: linear-gradient(135deg,#22c55e,#16a34a); box-shadow: 0 6px 20px rgba(34,197,94,0.4); }
.call-end-btn:hover, .call-reject-btn:hover, .call-accept-btn:hover { transform: scale(1.08); }
.deleted-alert { background: #fef9c3; color: #854d0e; text-align: center; padding: 8px; font-size: 12px; font-weight: 600; flex-shrink: 0; border-bottom: 1px solid #fde047; }
.date-separator { display: flex; align-items: center; justify-content: center; margin: 12px 0 8px; }
.date-separator span { background: #cbd5e1; color: #475569; padding: 3px 14px; border-radius: 20px; font-size: 11px; font-weight: 600; }
.msg-context-menu { position: fixed; z-index: 9000; background: #1e293b; border-radius: 14px; padding: 6px; min-width: 200px; box-shadow: 0 12px 40px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.08); animation: menuFadeIn 0.15s ease; }
.msg-context-menu button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 14px; background: none; border: none; color: #f1f5f9; font-size: 14px; font-weight: 500; cursor: pointer; border-radius: 10px; text-align: left; transition: 0.15s; }
.msg-context-menu button:hover { background: rgba(255,255,255,0.08); }
.msg-context-menu button:last-child { color: #94a3b8; }
.chat-box { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 16px 12px; background: #f1f5f9; display: flex; flex-direction: column; gap: 4px; -webkit-overflow-scrolling: touch; min-height: 0; overscroll-behavior: contain; }
.chat-box::-webkit-scrollbar { width: 6px; }
.chat-box::-webkit-scrollbar-track { background: rgba(0,0,0,0.04); border-radius: 10px; }
.chat-box::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #6366f1, #8b5cf6); border-radius: 10px; border: 1px solid rgba(255,255,255,0.2); }
.chat-box::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, #4f46e5, #7c3aed); }
.msg-wrap { display: flex; max-width: 78%; margin-bottom: 1px; cursor: context-menu; }
.msg-mine { align-self: flex-end; }
.msg-theirs { align-self: flex-start; }
.msg-content-wrap { display: flex; flex-direction: column; }
.msg-mine .msg-content-wrap { align-items: flex-end; }
.msg-theirs .msg-content-wrap { align-items: flex-start; }
.msg-bubble { padding: 10px 14px 6px; border-radius: 18px; font-size: 14px; line-height: 1.55; word-break: break-word; max-width: min(320px, 74vw); position: relative; transition: transform 0.18s ease; }
.bubble-mine { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border-bottom-right-radius: 4px; box-shadow: 0 2px 12px rgba(99,102,241,0.3); }
.bubble-theirs { background: white; color: #1e293b; border-bottom-left-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }

.msg-reply { padding: 6px 10px; margin: 0 0 6px; border-left: 3px solid currentColor; border-radius: 9px; cursor: pointer; opacity: 0.95; max-width: 100%; overflow: hidden; }
.bubble-mine .msg-reply { background: rgba(255,255,255,0.18); }
.bubble-theirs .msg-reply { background: rgba(99,102,241,0.08); border-left-color: #6366f1; }
.msg-reply-name { font-size: 11px; font-weight: 800; margin-bottom: 1px; }
.bubble-mine .msg-reply-name { color: rgba(255,255,255,0.95); }
.bubble-theirs .msg-reply-name { color: #4338ca; }
.msg-reply-text { font-size: 12px; opacity: 0.85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

#dmReplyPreview { display: none; align-items: center; gap: 10px; padding: 8px 12px; background: rgba(99,102,241,0.08); border-left: 3px solid #6366f1; margin: 0 8px; border-radius: 10px 10px 0 0; }
#dmReplyPreview.show { display: flex; }
.dm-reply-pv-content { flex: 1; min-width: 0; }
.dm-reply-pv-name { font-size: 11.5px; font-weight: 800; color: #4338ca; }
.dm-reply-pv-text { font-size: 12px; color: #475569; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dm-reply-pv-close { background: rgba(99,102,241,0.12); border: none; width: 26px; height: 26px; border-radius: 50%; cursor: pointer; color: #4338ca; font-size: 13px; flex-shrink: 0; }
body.bg-dark #dmReplyPreview { background: rgba(99,102,241,0.18); }
body.bg-dark .dm-reply-pv-text { color: #cbd5e1; }
body.bg-dark .bubble-theirs .msg-reply { background: rgba(255,255,255,0.06); }
body.bg-dark .bubble-theirs .msg-reply-name { color: #818cf8; }
.msg-text { display: block; }
.msg-footer { display: flex; align-items: center; justify-content: flex-end; gap: 4px; margin-top: 4px; }
.msg-time { font-size: 10px; }
.bubble-mine .msg-time { color: rgba(255,255,255,0.6); }
.bubble-theirs .msg-time { color: #94a3b8; }
.msg-check { font-size: 11px; }
.msg-check.pending { font-size: 13px; opacity: 0.6; }
.msg-check.sent { color: rgba(255,255,255,0.6); }
.msg-check.delivered { color: rgba(255,255,255,0.6); font-weight: 400; letter-spacing: -1px; }
.msg-check.seen { color: #a5f3fc; font-weight: 700; }
.msg-media { max-width: 200px; border-radius: 12px; display: block; margin-top: 6px; }
.msg-audio {
    width: 220px;
    height: 36px;
    margin-top: 6px;
    border-radius: 20px;
    accent-color: #6366f1;
}

.audio-player-wrap {
    display: flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.15);
    border-radius: 20px; padding: 6px 12px;
    margin-top: 6px; min-width: 200px; max-width: 240px;
}
.bubble-theirs .audio-player-wrap { background: #f1f5f9; }
.audio-play-btn {
    width: 32px; height: 32px; border-radius: 50%;
    background: white; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 13px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
