}

.preview-container img,
.preview-container video { max-width: 140px; border-radius: 10px; }

.audio-preview { padding: 8px 0; margin-bottom: 6px; }
.audio-preview audio { width: 100%; margin-bottom: 8px; }
.audio-preview-btns { display: flex; gap: 8px; }

.btn-send-audio, .btn-cancel-audio {
