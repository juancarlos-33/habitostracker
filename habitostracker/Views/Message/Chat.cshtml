}

form {
    flex-shrink: 0;
    padding: 10px 12px;
    background: white;
    border-top: 1px solid #f3f4f6;
}

.emoji-row {
    display: flex;
    gap: 2px;
    margin-bottom: 8px;
    overflow-x: auto;
