}
.audio-play-btn:hover { transform: scale(1.08); }
.bubble-mine .audio-play-btn { background: rgba(255,255,255,0.9); color: #4f46e5; }
.bubble-theirs .audio-play-btn { background: #6366f1; color: white; }
.audio-progress-wrap { flex: 1; display: flex; flex-direction: column; gap: 3px; }
.audio-progress {
    width: 100%; height: 3px; border-radius: 10px;
    appearance: none; -webkit-appearance: none;
    background: rgba(255,255,255,0.3); cursor: pointer; outline: none;
}

/* en la página del chat, ocultar bottom nav y quitar padding */
body {
    padding-bottom: 0 !important;
}

.ht-bottom-nav {
    display: none !important;
}

.bubble-theirs .audio-progress { background: #cbd5e1; }
.audio-progress::-webkit-slider-thumb {
    -webkit-appearance: none; width: 10px; height: 10px;
    border-radius: 50%; background: white; cursor: pointer;
}
.bubble-theirs .audio-progress::-webkit-slider-thumb { background: #6366f1; }
.audio-duration { font-size: 10px; color: rgba(255,255,255,0.7); }
.bubble-theirs .audio-duration { color: #64748b; }
.bubble-mine .msg-audio { accent-color: white; }
.msg-reaction-badge { font-size: 16px; margin-top: 3px; background: white; border-radius: 20px; padding: 1px 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.1); width: fit-content; }
.typing-indicator { display: flex; gap: 5px; align-items: center; padding: 10px 16px; background: white; border-radius: 18px; border-bottom-left-radius: 4px; width: fit-content; box-shadow: 0 2px 8px rgba(0,0,0,0.06); align-self: flex-start; margin-top: 4px; }
.typing-dot { width: 7px; height: 7px; border-radius: 50%; background: #94a3b8; animation: typingBounce 1.2s infinite; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@@keyframes typingBounce { 0%,60%,100% { transform: translateY(0); } 30% { transform: translateY(-7px); } }
.emoji-panel { flex-shrink: 0; background: white; border-top: 1px solid #e2e8f0; padding: 8px 12px 10px; max-height: 220px; overflow-y: auto; }
.emoji-search-wrap { margin-bottom: 8px; }
.emoji-search-wrap input { width: 100%; padding: 7px 14px; border: 1.5px solid #e2e8f0; border-radius: 20px; font-size: 13px; outline: none; background: #f8fafc; transition: 0.2s; color: #1e293b; }
.emoji-search-wrap input:focus { border-color: #6366f1; background: white; }
.emoji-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(34px, 1fr)); gap: 2px; }
.emoji-grid span { font-size: 22px; cursor: pointer; text-align: center; padding: 4px; border-radius: 8px; transition: 0.15s; user-select: none; }
.emoji-grid span:hover { background: #f1f5f9; transform: scale(1.2); }
form { flex-shrink: 0; padding: 8px 12px 10px; background: white; border-top: 1px solid #e2e8f0; }
.recording-status { display: flex; align-items: center; gap: 8px; padding: 6px 14px; background: #fef2f2; border-radius: 12px; font-size: 13px; font-weight: 600; color: #dc2626; margin-bottom: 8px; border: 1px solid #fecaca; }
.rec-dot { width: 9px; height: 9px; border-radius: 50%; background: #dc2626; animation: recPulse 1s infinite; flex-shrink: 0; }
.rec-label { flex: 1; }
.rec-timer { font-variant-numeric: tabular-nums; }
@@keyframes recPulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.3; transform:scale(0.7); } }
.input-bar { display: flex; align-items: center; gap: 6px; }
.bar-btn { width: 38px; height: 38px; border-radius: 50%; border: none; background: #f1f5f9; color: #64748b; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; flex-shrink: 0; }
.bar-btn:hover { background: #e2e8f0; color: #334155; }
.bar-btn.emoji-toggle.active { background: #ede9fe; color: #6366f1; }
.rec-btn.recording { background: #fee2e2; color: #dc2626; animation: recPulse 1s infinite; }
.msg-input { flex: 1; min-width: 0; padding: 10px 16px; border: 1.5px solid #e2e8f0; border-radius: 24px; font-size: 14px; outline: none; background: #f8fafc; transition: 0.2s; color: #1e293b; }
.msg-input:focus { border-color: #6366f1; background: white; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
.send-btn { width: 40px; height: 40px; border-radius: 50%; border: none; background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 14px rgba(99,102,241,0.4); }
.send-btn:hover { transform: scale(1.08); }
.send-btn:disabled { background: #cbd5e1; cursor: not-allowed; transform: none; box-shadow: none; }
.preview-container { position: relative; padding: 8px; margin-bottom: 8px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; }
.preview-close { position: absolute; top: 4px; right: 4px; background: #dc2626; color: white; border-radius: 50%; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 12px; font-weight: 700; }
.preview-container img, .preview-container video { max-width: 130px; border-radius: 10px; }
.audio-preview { padding: 8px; margin-bottom: 8px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; }
.audio-preview audio { width: 100%; margin-bottom: 8px; }
.audio-btns { display: flex; gap: 8px; }
.btn-send-audio, .btn-cancel-audio { padding: 7px 16px; border-radius: 20px; border: none; font-size: 13px; font-weight: 600; cursor: pointer; transition: 0.2s; }
.btn-send-audio { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; flex: 1; }
.btn-cancel-audio { background: #fee2e2; color: #dc2626; }
body.bg-dark .chat-page { background: #0f172a !important; }
body.bg-dark .chat-header { background: linear-gradient(135deg,#0f172a,#1e293b) !important; }
body.bg-dark .chat-box { background: #0f172a !important; }
body.bg-dark .bubble-theirs { background: #1e293b !important; color: #f1f5f9 !important; box-shadow: none !important; }
body.bg-dark .bubble-theirs .msg-time { color: #64748b !important; }
body.bg-dark form { background: #1e293b !important; border-color: #334155 !important; }
body.bg-dark .msg-input { background: #0f172a !important; border-color: #334155 !important; color: #f1f5f9 !important; }
body.bg-dark .bar-btn { background: #334155 !important; color: #94a3b8 !important; }
body.bg-dark .bar-btn:hover { background: #475569 !important; color: #f1f5f9 !important; }
body.bg-dark .emoji-panel { background: #1e293b !important; border-color: #334155 !important; }
body.bg-dark .emoji-search-wrap input { background: #0f172a !important; border-color: #334155 !important; color: #f1f5f9 !important; }
body.bg-dark .emoji-grid span:hover { background: #334155 !important; }
body.bg-dark .typing-indicator { background: #1e293b !important; }
body.bg-dark .msg-reaction-badge { background: #1e293b !important; }
