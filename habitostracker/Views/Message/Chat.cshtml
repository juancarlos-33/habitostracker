@model List<HabitTrackerApp.Models.Message>

@{
    ViewData["Title"] = "Chat";
    var myId = int.Parse(User.FindFirst("UserId").Value);
    bool isDeletedUser = ViewBag.OtherUserId == null;
    bool isOnline = false;
    if (ViewBag.OtherLastOnline != null)
    {
        var seconds = (DateTime.Now - ((DateTime)ViewBag.OtherLastOnline)).TotalSeconds;
        isOnline = seconds < 60;
    }
    var otherImg = ViewBag.OtherUserProfileImage as string;
    var otherName = (ViewBag.OtherUsername as string) ?? "Cuenta eliminada";
}

<div class="chat-page">

    <div class="chat-header">
        <a asp-controller="User" asp-action="Profile" asp-route-id="@ViewBag.OtherUserId" class="chat-header-user">
            @if (!string.IsNullOrEmpty(otherImg))
            { <img src="@otherImg" class="chat-header-avatar" /> }
            else
            { <div class="chat-header-avatar avatar-letter">@otherName.Substring(0,1).ToUpper()</div> }
            <div>
                <div class="chat-header-name">@otherName</div>
                <div class="chat-header-status @(isOnline ? "online" : "offline")" id="onlineStatus">
                    @(isOnline ? "🟢 En línea" : "⚫ Offline")
                </div>
            </div>
        </a>
        <button class="call-btn" id="callBtn" onclick="startCall()" title="Llamar">📞</button>
    </div>

    @if (isDeletedUser)
    {
        <div class="deleted-alert">⚠️ Esta cuenta fue eliminada</div>
    }

    <!-- MODAL LLAMADA SALIENTE -->
    <div id="callModal" style="display:none;">
        <div class="call-modal-inner">
            <div class="call-avatar-wrap">
                @if (!string.IsNullOrEmpty(otherImg))
                { <img src="@otherImg" class="call-avatar-img" /> }
                else
                { <div class="call-avatar-letter">@otherName.Substring(0,1).ToUpper()</div> }
            </div>
            <div class="call-name">@otherName</div>
            <div class="call-status" id="callStatus">Llamando...</div>
            <div class="call-timer" id="callTimer" style="display:none;">00:00</div>
            <div class="call-actions">
                <button class="call-end-btn" onclick="endCall()">📵</button>
            </div>
        </div>
    </div>

    <!-- MODAL LLAMADA ENTRANTE -->
    <div id="incomingCallModal" style="display:none;">
        <div class="call-modal-inner">
            <div class="call-avatar-wrap">
                @if (!string.IsNullOrEmpty(otherImg))
                { <img src="@otherImg" class="call-avatar-img" /> }
                else
                { <div class="call-avatar-letter">@otherName.Substring(0,1).ToUpper()</div> }
            </div>
            <div class="call-name">@otherName</div>
            <div class="call-status incoming-pulse">📞 Llamada entrante...</div>
            <div class="call-actions">
                <button class="call-accept-btn" onclick="acceptCall()">📞</button>
                <button class="call-end-btn" onclick="rejectCall()">📵</button>
            </div>
        </div>
    </div>

    <!-- CHAT BOX -->
    <div id="chatBox" class="chat-box">
        @foreach (var msg in Model)
        {
            bool isMe = msg.SenderId == myId;
            var senderImg = msg.Sender?.ProfileImage ?? msg.Sender?.ProfilePicture;
            var senderInitial = (msg.Sender?.Username ?? "?").Substring(0,1).ToUpper();

            <div class="msg-wrap @(isMe ? "msg-mine" : "msg-theirs")" id="msg-@msg.Id">
                @if (!isMe)
                {
                    if (!string.IsNullOrEmpty(senderImg))
                    { <img src="@senderImg" class="msg-avatar" /> }
                    else
                    { <div class="msg-avatar avatar-letter-gray">@senderInitial</div> }
                }

                <div class="msg-content-wrap">
                    <div class="msg-bubble @(isMe ? "bubble-mine" : "bubble-theirs")">
                        @if (!string.IsNullOrEmpty(msg.Content))
                        {
                            if (msg.Content.EndsWith(".jpg") || msg.Content.EndsWith(".png") || msg.Content.EndsWith(".jpeg"))
                            { <img src="@msg.Content" class="msg-media" /> }
                            else if (msg.Content.EndsWith(".mp4"))
                            { <video controls class="msg-media"><source src="@msg.Content" type="video/mp4" /></video> }
                            else if (msg.Content.EndsWith(".webm"))
                            { <audio controls class="msg-audio"><source src="@msg.Content" type="audio/webm" /></audio> }
                            else
                            { <span>@msg.Content</span> }
                        }
                        @if (!string.IsNullOrEmpty(msg.FileUrl))
                        {
                            var ext = System.IO.Path.GetExtension(msg.FileUrl).ToLower();
                            if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif")
                            { <img src="@msg.FileUrl" class="msg-media" /> }
                            else if (ext == ".mp4" || ext == ".webm")
                            { <video controls class="msg-media"><source src="@msg.FileUrl" /></video> }
                        }
                    </div>

                    <div class="msg-meta">
                        @if (!string.IsNullOrEmpty(msg.Reaction))
                        { <span class="msg-reaction" id="reaction-@msg.Id">@msg.Reaction</span> }
                        else
                        { <span class="msg-reaction" id="reaction-@msg.Id" style="display:none;"></span> }

                        @if (isMe)
                        {
                            @if (msg.IsRead)
                            { <span class="msg-status seen">✔✔ visto</span> }
                            else
                            { <span class="msg-status sent" data-message-id="@msg.Id">✔ enviado</span> }
                        }
                    </div>

                    <div class="reaction-btns">
                        <button onclick="reactToMessage(@msg.Id, '🔥')">🔥</button>
                        <button onclick="reactToMessage(@msg.Id, '❤️')">❤️</button>
                        <button onclick="reactToMessage(@msg.Id, '😂')">😂</button>
                        <button onclick="reactToMessage(@msg.Id, '👍')">👍</button>
                        <button onclick="reactToMessage(@msg.Id, '😮')">😮</button>
                        @if (isMe)
                        {
                            <button onclick="deleteMessage(@msg.Id, 'me')" class="delete-msg-btn" title="Eliminar para mí">🗑</button>
                            <button onclick="deleteMessage(@msg.Id, 'all')" class="delete-msg-btn delete-all-btn" title="Eliminar para todos">❌</button>
                        }
                        else
                        {
                            <button onclick="deleteMessage(@msg.Id, 'me')" class="delete-msg-btn" title="Eliminar para mí">🗑</button>
                        }
                    </div>
                </div>

                @if (isMe)
                {
                    var myImg = User.FindFirst("ProfileImage")?.Value;
                    if (!string.IsNullOrEmpty(myImg))
                    { <img src="@myImg" class="msg-avatar" /> }
                    else
                    { <div class="msg-avatar avatar-letter">@User.Identity.Name.Substring(0,1).ToUpper()</div> }
                }
            </div>
        }

        <div id="typingIndicator" class="typing-indicator" style="display:none;">
            <span class="typing-dot"></span>
            <span class="typing-dot"></span>
            <span class="typing-dot"></span>
        </div>
    </div>

    <!-- FORM -->
    <form id="chatForm" asp-controller="Message" asp-action="Send" method="post"
          enctype="multipart/form-data" data-no-loader="true">
        @Html.AntiForgeryToken()
        <input type="hidden" name="receiverId" value="@ViewBag.OtherUserId" />

        <div id="previewContainer" style="display:none;" class="preview-container">
            <span class="preview-close" onclick="removePreview()">✖</span>
            <img id="previewImage" style="display:none;" />
            <video id="previewVideo" controls style="display:none;"></video>
        </div>

        <div id="audioPreview" style="display:none;" class="audio-preview">
            <audio id="previewPlayer" controls></audio>
            <div class="audio-preview-btns">
                <button type="button" class="btn-send-audio" onclick="sendAudio()">✅ Enviar</button>
                <button type="button" class="btn-cancel-audio" onclick="cancelAudio()">❌ Cancelar</button>
            </div>
        </div>

        <div class="emoji-row">
            <span onclick="addEmoji('😀')">😀</span>
            <span onclick="addEmoji('😂')">😂</span>
            <span onclick="addEmoji('😍')">😍</span>
            <span onclick="addEmoji('😎')">😎</span>
            <span onclick="addEmoji('🔥')">🔥</span>
            <span onclick="addEmoji('💀')">💀</span>
            <span onclick="addEmoji('😭')">😭</span>
        </div>

        <div class="input-row">
            <input type="file" name="file" id="fileInput" style="display:none;" accept="image/*,video/*" />
            <button type="button" class="input-btn" onclick="startRecording()" id="recordBtn" title="Grabar">🎤</button>
            <button type="button" class="input-btn" onclick="document.getElementById('fileInput').click()" title="Adjuntar">📎</button>
            <input type="text" id="messageInput" name="content" class="msg-input"
                   placeholder="@(isDeletedUser ? "No puedes enviar mensajes" : "Escribe un mensaje...")"
                   @(isDeletedUser ? "disabled" : "") />
            <button type="submit" class="send-btn" @(isDeletedUser ? "disabled" : "")>➤</button>
        </div>
    </form>
</div>

<style>
.chat-page {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 56px; left: 0; right: 0; bottom: 0;
    background: white;
    z-index: 10;
}

@@media (min-width: 768px) {
    .chat-page {
        position: relative;
        top: auto; left: auto; right: auto; bottom: auto;
        height: calc(100vh - 100px);
        max-width: 900px;
        margin: 0 auto;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.06);
    }
}

.chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: white;
    border-bottom: 1px solid #f3f4f6;
    flex-shrink: 0;
    z-index: 2;
}

.chat-header-user {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
}

.chat-header-avatar {
    width: 42px; height: 42px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #e5e7eb;
    flex-shrink: 0;
}

.avatar-letter {
    background: linear-gradient(135deg,#2563eb,#7c3aed);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 16px;
    width: 42px; height: 42px;
    border-radius: 50%;
    flex-shrink: 0;
}

.avatar-letter-gray {
    background: #6b7280;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    width: 32px; height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
}

.chat-header-name { font-size: 15px; font-weight: 700; color: #111827; }
.chat-header-status { font-size: 12px; margin-top: 1px; }
.chat-header-status.online { color: #16a34a; }
.chat-header-status.offline { color: #9ca3af; }

.call-btn {
    width: 42px; height: 42px;
    border-radius: 50%;
    border: none;
    background: #16a34a;
    color: white;
    font-size: 18px;
    cursor: pointer;
    transition: 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.call-btn:hover { background: #15803d; transform: scale(1.05); }
.call-btn.calling { background: #dc2626; animation: pulse-ring 1s infinite; }

#callModal, #incomingCallModal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.75);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
}

.call-modal-inner {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-radius: 28px;
    padding: 40px 32px;
    text-align: center;
    color: white;
    min-width: 280px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.6);
    border: 1px solid rgba(255,255,255,0.08);
}

.call-avatar-wrap { margin-bottom: 16px; }

.call-avatar-img {
    width: 84px; height: 84px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #4ade80;
    animation: pulse-ring 2s infinite;
}

.call-avatar-letter {
    width: 84px; height: 84px;
    border-radius: 50%;
    background: linear-gradient(135deg,#2563eb,#7c3aed);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34px;
    font-weight: 800;
    margin: 0 auto;
    border: 3px solid #4ade80;
    animation: pulse-ring 2s infinite;
}

@@keyframes pulse-ring {
    0%, 100% { box-shadow: 0 0 0 0 rgba(74,222,128,0.4); }
    50% { box-shadow: 0 0 0 12px rgba(74,222,128,0); }
}

.call-name { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
.call-status { font-size: 13px; color: rgba(255,255,255,0.55); margin-bottom: 8px; }
.call-timer { font-size: 20px; font-weight: 700; color: #4ade80; margin-bottom: 24px; }
.incoming-pulse { color: #4ade80 !important; animation: textPulse 1s infinite; }

@@keyframes textPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.call-actions { display: flex; justify-content: center; gap: 24px; margin-top: 28px; }

.call-end-btn, .call-accept-btn {
    width: 60px; height: 60px;
    border-radius: 50%;
    border: none;
    font-size: 24px;
    cursor: pointer;
    transition: 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.call-end-btn { background: #dc2626; }
.call-accept-btn { background: #16a34a; }
.call-end-btn:hover { background: #b91c1c; transform: scale(1.1); }
.call-accept-btn:hover { background: #15803d; transform: scale(1.1); }

.deleted-alert {
    background: #fef3c7;
    color: #92400e;
    text-align: center;
    padding: 10px;
    font-size: 13px;
    font-weight: 500;
    flex-shrink: 0;
}

/* 🔥 SCROLL ARREGLADO */
.chat-box {
    flex: 1;
    overflow-y: scroll !important;
    overflow-x: hidden;
    padding: 16px;
    background: #f0f2f5;
    display: flex;
    flex-direction: column;
    gap: 4px;
    -webkit-overflow-scrolling: touch;
    min-height: 0;
}

.chat-box::-webkit-scrollbar { width: 4px; }
.chat-box::-webkit-scrollbar-track { background: transparent; }
.chat-box::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }

.msg-wrap {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    max-width: 80%;
}

.msg-mine { align-self: flex-end; flex-direction: row-reverse; }
.msg-theirs { align-self: flex-start; }

.msg-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
}

.msg-content-wrap { display: flex; flex-direction: column; gap: 2px; }
.msg-mine .msg-content-wrap { align-items: flex-end; }
.msg-theirs .msg-content-wrap { align-items: flex-start; }

.msg-bubble {
    padding: 9px 13px;
    border-radius: 18px;
    font-size: 14px;
    line-height: 1.5;
    word-break: break-word;
    max-width: min(320px, 70vw);
}

.bubble-mine {
    background: #2563eb;
    color: white;
    border-bottom-right-radius: 4px;
}

.bubble-theirs {
    background: white;
    color: #111827;
