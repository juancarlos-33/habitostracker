@model List<HabitTrackerApp.Models.Message>

@{
    ViewData["Title"] = "Chat";
    var myId = int.Parse(User.FindFirst("UserId").Value);
    bool isDeletedUser = ViewBag.OtherUserId == null;
    bool isOnline = false;
    if (ViewBag.OtherLastOnline != null)
    {
        var seconds = (DateTime.Now - ((DateTime)ViewBag.OtherLastOnline)).TotalSeconds;
        isOnline = seconds < 60;
    }
    var otherImg = ViewBag.OtherUserProfileImage as string;
    var otherName = (ViewBag.OtherUsername as string) ?? "Cuenta eliminada";
    var lastOnline = ViewBag.OtherLastOnline as DateTime?;

    string lastOnlineText = "Offline";
    if (isOnline) lastOnlineText = "En línea";
    else if (lastOnline.HasValue)
    {
        var diff = DateTime.UtcNow - lastOnline.Value.ToUniversalTime();
        if (diff.TotalMinutes < 2) lastOnlineText = "Hace un momento";
        else if (diff.TotalMinutes < 60) lastOnlineText = $"Hace {(int)diff.TotalMinutes} min";
        else if (diff.TotalHours < 24) lastOnlineText = $"Hoy a las {lastOnline.Value:hh:mm tt}";
        else if (diff.TotalDays < 2) lastOnlineText = $"Ayer a las {lastOnline.Value:hh:mm tt}";
        else lastOnlineText = lastOnline.Value.ToString("dd/MM/yyyy");
    }

    var grouped = Model.GroupBy(m => m.SentAt.Date).OrderBy(g => g.Key).ToList();
}

<div class="chat-page">
    <div class="chat-header">
        <a asp-controller="User" asp-action="Profile" asp-route-id="@ViewBag.OtherUserId" class="chat-header-user">
            <div class="chat-avatar-wrap">
                @if (!string.IsNullOrEmpty(otherImg))
                { <img src="@otherImg" class="chat-header-avatar" /> }
                else
                { <div class="chat-header-avatar avatar-letter">@otherName.Substring(0,1).ToUpper()</div> }
            @if (ViewBag.IsSystemChat != true)
{
    <span class="online-dot" id="onlineDot" style="@(isOnline ? "" : "display:none;")"></span>
}
            </div>
            <div>
            <div class="chat-header-name">
    @otherName
    @if (ViewBag.IsSystemChat == true)
    {
        <span title="Cuenta oficial verificada" style="
            display:inline-flex;align-items:center;justify-content:center;
            width:18px;height:18px;border-radius:50%;
            background:linear-gradient(135deg,#2563eb,#6366f1);
            margin-left:5px;vertical-align:middle;flex-shrink:0;
        ">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="white">
                <path d="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z"/>
            </svg>
        </span>
    }
</div>
               @if (ViewBag.IsSystemChat != true)
{
    <div class="chat-header-status @(isOnline ? "online" : "offline")" id="onlineStatus">
        @(isOnline ? "● En línea" : "○ " + lastOnlineText)
    </div>
}
else
{
    <div class="chat-header-status" id="onlineStatus" style="display:none;"></div>
}
            </div>
        </a>
        <div class="header-menu-wrap">
        <button class="header-menu-btn" onclick="toggleHeaderMenu()" data-no-loader title="Opciones"
        @(ViewBag.IsSystemChat == true ? "disabled style=opacity:0.3;cursor:not-allowed;" : "")>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/>
                </svg>
            </button>
            <div id="headerMenu" class="header-menu-dropdown" style="display:none;">
                <button onclick="silenciarNotificaciones()">🔕 Silenciar notificaciones</button>
                <button onclick="crearGrupo()">👥 Crear grupo</button>
                <button onclick="anclarChat()">📌 Anclar chat</button>
                <hr class="menu-divider" />
                <button onclick="denunciarUsuario()" class="menu-danger">🚩 Denunciar</button>
                <button onclick="bloquearUsuario()" class="menu-danger" id="btnBloquear">🚫 Bloquear</button>
            </div>
        </div>
    </div>

    @if (isDeletedUser)
    { <div class="deleted-alert">⚠️ Esta cuenta fue eliminada</div> }

    <div id="callModal" style="display:none;">
        <div class="call-modal-inner">
            <div class="call-ripple">
                @if (!string.IsNullOrEmpty(otherImg))
                { <img src="@otherImg" class="call-avatar-img" /> }
                else
                { <div class="call-avatar-letter">@otherName.Substring(0,1).ToUpper()</div> }
            </div>
            <div class="call-name">@otherName</div>
            <div class="call-status" id="callStatus">Llamando...</div>
            <div class="call-timer" id="callTimer" style="display:none;">00:00</div>
            <div class="call-actions">
                <button class="call-end-btn" onclick="endCall()">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M13.5 4.06c0-1.336-1.616-2.005-2.56-1.06l-4.5 4.5H4.508c-1.141 0-2.318.664-2.66 1.905A9.76 9.76 0 001.5 12c0 .898.121 1.768.35 2.595.341 1.24 1.518 1.905 2.659 1.905h1.93l4.5 4.5c.945.945 2.561.276 2.561-1.06V4.06z"/>
                        <path d="M17.78 9.22a.75.75 0 010 1.06L16.06 12l1.72 1.72a.75.75 0 11-1.06 1.06L15 13.06l-1.72 1.72a.75.75 0 11-1.06-1.06L13.94 12l-1.72-1.72a.75.75 0 011.06-1.06L15 10.94l1.72-1.72a.75.75 0 011.06 0z"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div id="incomingCallModal" style="display:none;">
        <div class="call-modal-inner">
            <div class="call-ripple">
                @if (!string.IsNullOrEmpty(otherImg))
                { <img src="@otherImg" class="call-avatar-img" /> }
                else
                { <div class="call-avatar-letter">@otherName.Substring(0,1).ToUpper()</div> }
            </div>
            <div class="call-name">@otherName</div>
            <div class="call-status incoming-pulse">Llamada entrante</div>
            <div class="call-actions">
                <button class="call-reject-btn" onclick="rejectCall()">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M13.5 4.06c0-1.336-1.616-2.005-2.56-1.06l-4.5 4.5H4.508c-1.141 0-2.318.664-2.66 1.905A9.76 9.76 0 001.5 12c0 .898.121 1.768.35 2.595.341 1.24 1.518 1.905 2.659 1.905h1.93l4.5 4.5c.945.945 2.561.276 2.561-1.06V4.06z"/>
                    </svg>
                </button>
                <button class="call-accept-btn" onclick="acceptCall()">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.67A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div id="msgContextMenu" class="msg-context-menu" style="display:none;">
        <button id="ctxDeleteMe" onclick="ctxDelete('me')">🗑 Eliminar para mí</button>
        <button id="ctxDeleteAll" onclick="ctxDelete('all')" style="display:none;">❌ Eliminar para todos</button>
        <button onclick="ctxClose()">✕ Cancelar</button>
    </div>
    <div id="ctxOverlay" onclick="ctxClose()" style="display:none;position:fixed;inset:0;z-index:8999;"></div>

    <!-- 🔥 Modal crear grupo -->
    <div id="grupoModal" class="modal-overlay" style="display:none;">
        <div class="modal-box">
            <div class="modal-title">👥 Crear grupo</div>
            <input type="text" id="grupoNombre" class="modal-input" placeholder="Nombre del grupo..." />
            <div class="modal-actions">
                <button class="modal-btn-cancel" onclick="cerrarModal('grupoModal')">Cancelar</button>
                <button class="modal-btn-ok" onclick="confirmarGrupo()">Crear</button>
            </div>
        </div>
    </div>

    <!-- 🔥 Modal silenciar -->
    <div id="silenciarModal" class="modal-overlay" style="display:none;">
        <div class="modal-box">
            <div class="modal-title">🔕 Silenciar notificaciones</div>
            <p class="modal-desc">¿Por cuánto tiempo?</p>
            <div class="modal-options">
                <button class="modal-opt-btn" onclick="confirmarSilenciar(8)">8 horas</button>
                <button class="modal-opt-btn" onclick="confirmarSilenciar(24)">1 día</button>
                <button class="modal-opt-btn" onclick="confirmarSilenciar(168)">1 semana</button>
                <button class="modal-opt-btn" onclick="confirmarSilenciar(-1)">Siempre</button>
            </div>
            <div class="modal-actions">
                <button class="modal-btn-cancel" onclick="cerrarModal('silenciarModal')">Cancelar</button>
            </div>
        </div>
    </div>

    <!-- 🔥 Modal anclar -->
    <div id="anclarModal" class="modal-overlay" style="display:none;">
        <div class="modal-box">
            <div class="modal-title">📌 Anclar chat</div>
            <p class="modal-desc">Este chat aparecerá fijo en la parte superior de tu bandeja de entrada.</p>
            <div class="modal-actions">
                <button class="modal-btn-cancel" onclick="cerrarModal('anclarModal')">Cancelar</button>
                <button class="modal-btn-ok" onclick="confirmarAnclar()">Anclar</button>
            </div>
        </div>
    </div>

    <div id="chatBox" class="chat-box">
        @{
    var reqStatus = ViewBag.MsgRequestStatus as string ?? "None";
    var reqSenderId = (int)(ViewBag.MsgRequestSenderId ?? 0);
    var reqFirstMsg = ViewBag.MsgRequestFirstMessage as string ?? "";
    var reqId = (int)(ViewBag.MsgRequestId ?? 0);
    bool yoEnvie = reqSenderId == myId;
}
<!-- DEBUG: reqStatus=@reqStatus | reqSenderId=@reqSenderId | myId=@myId | reqFirstMsg=@reqFirstMsg | reqId=@reqId -->
@if (reqStatus == "Pending")
{
    <div id="msgRequestBanner" style="display:flex;flex-direction:column;align-items:center;padding:24px 16px;margin:12px;background:rgba(99,102,241,0.06);border:1px solid rgba(99,102,241,0.15);border-radius:20px;text-align:center;">
        <div style="font-size:36px;margin-bottom:12px;">💬</div>
        @if (yoEnvie)
        {
            <div style="font-size:14px;font-weight:700;color:white;margin-bottom:6px;">Solicitud enviada</div>
            <div style="font-size:12px;color:rgba(255,255,255,0.4);margin-bottom:16px;line-height:1.6;">
                Esperando que <strong style="color:rgba(255,255,255,0.7);">@otherName</strong> acepte tu solicitud para chatear.
            </div>
            <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:12px 16px;max-width:280px;margin-bottom:12px;">
                <div style="font-size:11px;color:rgba(255,255,255,0.3);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px;">Tu mensaje</div>
                <div style="font-size:13px;color:rgba(255,255,255,0.7);line-height:1.6;">@reqFirstMsg</div>
            </div>
            <div style="font-size:11px;color:rgba(255,255,255,0.25);font-style:italic;">⏳ Pendiente de respuesta</div>
        }
        else
        {
            <div style="font-size:14px;font-weight:700;color:white;margin-bottom:6px;">@otherName quiere enviarte un mensaje</div>
            <div style="font-size:12px;color:rgba(255,255,255,0.4);margin-bottom:16px;line-height:1.6;">
                Acepta la solicitud para comenzar a chatear.
            </div>
            <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:12px 16px;max-width:280px;margin-bottom:16px;">
                <div style="font-size:11px;color:rgba(255,255,255,0.3);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px;">Su mensaje</div>
                <div style="font-size:13px;color:rgba(255,255,255,0.7);line-height:1.6;">@reqFirstMsg</div>
            </div>
            <div style="display:flex;gap:10px;">
                <button onclick="responderSolicitud(@reqId, false)" data-no-loader
                    style="padding:10px 20px;border-radius:12px;border:1px solid rgba(239,68,68,0.3);background:rgba(239,68,68,0.1);color:#f87171;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:0.2s;">
                    🚫 Rechazar
                </button>
                <button onclick="responderSolicitud(@reqId, true)" data-no-loader
                    style="padding:10px 20px;border-radius:12px;border:none;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:0.2s;box-shadow:0 4px 12px rgba(99,102,241,0.4);">
                    ✅ Aceptar
                </button>
            </div>
        }
    </div>
}
@if (reqStatus == "Rejected" && !yoEnvie)
{
    <div style="text-align:center;padding:16px;margin:12px;background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.15);border-radius:16px;">
        <div style="font-size:13px;color:#f87171;font-weight:600;">🚫 Rechazaste la solicitud de @otherName</div>
    </div>
}
@if (reqStatus == "Rejected" && yoEnvie)
{
    <div style="text-align:center;padding:16px;margin:12px;background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.15);border-radius:16px;">
        <div style="font-size:13px;color:#f87171;font-weight:600;">🚫 @otherName rechazó tu solicitud</div>
    </div>
}
        @foreach (var group in grouped)
        {
            var dateLabel = "";
            var today = DateTime.Today;
            var yesterday = today.AddDays(-1);
            if (group.Key == today) dateLabel = "Hoy";
            else if (group.Key == yesterday) dateLabel = "Ayer";
            else dateLabel = group.Key.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"));

            <div class="date-separator"><span>@dateLabel</span></div>

            @foreach (var msg in group.OrderBy(m => m.SentAt))
            {
                bool isMe = msg.SenderId == myId;
                <div class="msg-wrap @(isMe ? "msg-mine" : "msg-theirs")" id="msg-@msg.Id"
                     data-is-mine="@isMe.ToString().ToLower()"
                     oncontextmenu="openMsgMenu(event, @msg.Id, @isMe.ToString().ToLower())"
                     ontouchstart="startLongPress(event, @msg.Id, @isMe.ToString().ToLower())"
                     ontouchend="cancelLongPress()"
                     ontouchmove="cancelLongPress()">
                    <div class="msg-content-wrap">
                        <div class="msg-bubble @(isMe ? "bubble-mine" : "bubble-theirs")"
                             data-msg-id="@msg.Id"
                             data-sender-name="@(msg.Sender?.Username ?? "")"
                             data-content-preview="@(msg.Content?.Length > 80 ? msg.Content.Substring(0,80) + "…" : msg.Content ?? "")">
                            @if (msg.ReplyToMessageId.HasValue && msg.ReplyToMessage != null)
                            {
                                var replyText = !string.IsNullOrEmpty(msg.ReplyToMessage.FileUrl)
                                    ? (msg.ReplyToMessage.FileUrl.Contains("/video/upload/") ? "🎥 Video" : "📷 Foto")
                                    : (msg.ReplyToMessage.Content?.Length > 80
                                        ? msg.ReplyToMessage.Content.Substring(0, 80) + "…"
                                        : msg.ReplyToMessage.Content ?? "");
                                <div class="msg-reply" onclick="scrollToMsg(@msg.ReplyToMessageId)">
                                    <div class="msg-reply-name">@msg.ReplyToMessage.Sender?.Username</div>
                                    <div class="msg-reply-text">@replyText</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                if (msg.Content.EndsWith(".jpg") || msg.Content.EndsWith(".png") || msg.Content.EndsWith(".jpeg"))
                                { <img src="@msg.Content" class="msg-media" /> }
                                else if (msg.Content.EndsWith(".mp4"))
                                { <video controls class="msg-media"><source src="@msg.Content" type="video/mp4" /></video> }
                                else if (msg.Content.StartsWith("http") && (msg.Content.Contains("cloudinary") || msg.Content.Contains("/audios/") || msg.Content.EndsWith(".webm")))
                                { <audio controls class="msg-audio"><source src="@msg.Content" /></audio> }
                                else if (!msg.Content.StartsWith("http") && !msg.Content.EndsWith(".jpg") && !msg.Content.EndsWith(".png"))
                                { <span class="msg-text">@msg.Content</span> }
                            }
                            @if (!string.IsNullOrEmpty(msg.FileUrl))
                            {
                                var isCloudinaryImg = msg.FileUrl.Contains("/image/upload/");
                                var isCloudinaryVid = msg.FileUrl.Contains("/video/upload/");
                                var ext = System.IO.Path.GetExtension(msg.FileUrl).ToLower();
                                if (isCloudinaryImg || ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif")
                                { <img src="@msg.FileUrl" class="msg-media" /> }
                                else if (isCloudinaryVid || ext == ".mp4" || ext == ".webm")
                                { <video controls class="msg-media"><source src="@msg.FileUrl" /></video> }
                            }
                            <div class="msg-footer">
                                <span class="msg-time">@msg.SentAt.ToString("hh:mm tt")</span>
                                @if (isMe)
                                {
                                    @if (msg.IsRead)
                                    { <span class="msg-check seen" title="Visto">✔✔</span> }
                                    else if (ViewBag.ReceiverIsOnline == true)
                                    { <span class="msg-check delivered" data-message-id="@msg.Id" title="Entregado">✔✔</span> }
                                    else
                                    { <span class="msg-check sent" data-message-id="@msg.Id" title="Enviado">✔</span> }
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(msg.Reaction))
                        { <span class="msg-reaction-badge" id="reaction-@msg.Id">@msg.Reaction</span> }
                        else
                        { <span class="msg-reaction-badge" id="reaction-@msg.Id" style="display:none;"></span> }
                    </div>
                </div>
            }
        }
        <div id="typingIndicator" class="typing-indicator" style="display:none;">
            <span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>
        </div>
    </div>

    <div id="emojiPanel" class="emoji-panel" style="display:none;">
        <div class="emoji-search-wrap">
            <input type="text" id="emojiSearch" placeholder="Buscar emoji..." oninput="filterEmojis(this.value)" />
        </div>
