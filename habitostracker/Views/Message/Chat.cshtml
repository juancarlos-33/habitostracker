// ── LLAMADAS ──────────────────────────────
window.peerConnection = null; window.localStream = null;
let callerId = null, callTimerInterval = null, callSeconds = 0, pendingOffer = null;

function createPeerConnection(targetId) {
    const pc = new RTCPeerConnection({ iceServers: [
        { urls: "stun:stun.l.google.com:19302" }, { urls: "stun:stun1.l.google.com:19302" },
        { urls: "stun:stun2.l.google.com:19302" }, { urls: "stun:stun3.l.google.com:19302" },
        { urls: "stun:stun.cloudflare.com:3478" },
    ]});
    pc.ontrack = (event) => {
        let audio = document.getElementById("remoteAudio");
        if (!audio) { audio = document.createElement("audio"); audio.id = "remoteAudio"; audio.autoplay = true; audio.setAttribute("playsinline", ""); audio.style.display = "none"; document.body.appendChild(audio); }
        audio.srcObject = event.streams?.[0] ?? new MediaStream([event.track]);
        audio.play().catch(e => console.warn(e));
    };
    pc.onicecandidate = (e) => { if (e.candidate) chatConnection.invoke("SendIceCandidate", targetId, JSON.stringify(e.candidate)); };
    pc.onconnectionstatechange = () => {
        if (pc.connectionState === "connected") { document.getElementById("callStatus").textContent = "En llamada"; startCallTimer(); }
        else if (["disconnected","failed","closed"].includes(pc.connectionState)) endCall();
    };
    window.peerConnection = pc; return pc;
}

function startCallTimer() {
    callSeconds = 0;
    const t = document.getElementById("callTimer");
    if (t) t.style.display = "block";
    callTimerInterval = setInterval(() => {
        callSeconds++;
        const m = String(Math.floor(callSeconds/60)).padStart(2,"0");
        const s = String(callSeconds%60).padStart(2,"0");
        if (t) t.textContent = `${m}:${s}`;
    }, 1000);
}

async function startCall() {
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        window.localStream = stream;
        document.getElementById("callModal").style.display = "flex";
        document.getElementById("callStatus").textContent = "Llamando...";
        const pc = createPeerConnection(receiverId);
        stream.getTracks().forEach(t => pc.addTrack(t, stream));
        const offer = await pc.createOffer({ offerToReceiveAudio: true });
        await pc.setLocalDescription(offer);
        await chatConnection.invoke("CallUser", receiverId);
        await chatConnection.invoke("SendOffer", receiverId, JSON.stringify(offer));
    } catch (err) { alert("❌ " + err.message); document.getElementById("callModal").style.display = "none"; }
}

chatConnection.on("IncomingCall", (cId) => { callerId = cId; document.getElementById("incomingCallModal").style.display = "flex"; });
chatConnection.on("ReceiveOffer", (offer) => { pendingOffer = offer; });

async function acceptCall() {
    document.getElementById("incomingCallModal").style.display = "none";
    document.getElementById("callModal").style.display = "flex";
    document.getElementById("callStatus").textContent = "Conectando...";
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        window.localStream = stream;
        const pc = createPeerConnection(callerId);
        stream.getTracks().forEach(t => pc.addTrack(t, stream));
        if (pendingOffer) {
            await pc.setRemoteDescription(new RTCSessionDescription(JSON.parse(pendingOffer)));
            const answer = await pc.createAnswer();
            await pc.setLocalDescription(answer);
            await chatConnection.invoke("SendAnswer", callerId, JSON.stringify(answer));
            if (window.pendingCandidates?.length) {
                for (const c of window.pendingCandidates) await pc.addIceCandidate(new RTCIceCandidate(JSON.parse(c)));
                window.pendingCandidates = [];
            }
            pendingOffer = null;
        }
    } catch (err) { alert("❌ " + err.message); endCall(); }
}

function rejectCall() {
    document.getElementById("incomingCallModal").style.display = "none";
    chatConnection.invoke("HangUp", callerId);
    pendingOffer = null; callerId = null;
}

chatConnection.on("ReceiveAnswer", async (answer) => {
    if (window.peerConnection) await window.peerConnection.setRemoteDescription(new RTCSessionDescription(JSON.parse(answer)));
});

chatConnection.on("ReceiveIceCandidate", async (candidate) => {
    try {
        if (window.peerConnection?.remoteDescription) await window.peerConnection.addIceCandidate(new RTCIceCandidate(JSON.parse(candidate)));
        else { if (!window.pendingCandidates) window.pendingCandidates = []; window.pendingCandidates.push(candidate); }
    } catch (e) { console.warn("ICE:", e); }
});

chatConnection.on("CallEnded", () => endCall());

function endCall() {
    document.getElementById("callModal").style.display = "none";
    document.getElementById("incomingCallModal").style.display = "none";
    if (callTimerInterval) { clearInterval(callTimerInterval); callTimerInterval = null; }
    const t = document.getElementById("callTimer");
    if (t) { t.style.display = "none"; t.textContent = "00:00"; }
    const audio = document.getElementById("remoteAudio");
    if (audio) { audio.pause(); audio.srcObject = null; audio.remove(); }
    if (window.localStream) { window.localStream.getTracks().forEach(t => t.stop()); window.localStream = null; }
    if (window.peerConnection) { window.peerConnection.close(); window.peerConnection = null; }
    window.pendingCandidates = []; pendingOffer = null;
    try { chatConnection.invoke("HangUp", callerId ?? receiverId); } catch(e) {}
    callerId = null;
}

function createAudioPlayer(src) {
    const id = "ap-" + Date.now() + Math.random().toString(36).substr(2,5);
    return `
        <div class="audio-player-wrap">
            <button class="audio-play-btn" onclick="toggleAudio('${id}')" id="btn-${id}">▶</button>
            <div class="audio-progress-wrap">
                <input type="range" class="audio-progress" id="prog-${id}" value="0" min="0" max="100" step="0.1"
                    oninput="seekAudio('${id}', this.value)" />
                <span class="audio-duration" id="dur-${id}">0:00</span>
            </div>
            <audio id="${id}" src="${src}" onended="audioEnded('${id}')"
                ontimeupdate="updateAudioProgress('${id}')"
                onloadedmetadata="audioLoaded('${id}')"></audio>
        </div>`;
}

function toggleAudio(id) {
    const audio = document.getElementById(id);
    const btn = document.getElementById("btn-" + id);
    if (!audio) return;
    if (audio.paused) { audio.play(); btn.textContent = "⏸"; }
    else { audio.pause(); btn.textContent = "▶"; }
}

function seekAudio(id, val) {
    const audio = document.getElementById(id);
    if (audio && audio.duration) audio.currentTime = (val / 100) * audio.duration;
}

function audioEnded(id) {
    const btn = document.getElementById("btn-" + id);
    const prog = document.getElementById("prog-" + id);
    if (btn) btn.textContent = "▶";
    if (prog) prog.value = 0;
}

function updateAudioProgress(id) {
    const audio = document.getElementById(id);
    const prog = document.getElementById("prog-" + id);
    const dur = document.getElementById("dur-" + id);
    if (!audio || !prog || !dur) return;
    if (audio.duration) {
        prog.value = (audio.currentTime / audio.duration) * 100;
        const secs = Math.floor(audio.currentTime);
        const total = Math.floor(audio.duration);
        dur.textContent = `${Math.floor(secs/60)}:${String(secs%60).padStart(2,"0")} / ${Math.floor(total/60)}:${String(total%60).padStart(2,"0")}`;
    }
}

function audioLoaded(id) {
    const audio = document.getElementById(id);
    const dur = document.getElementById("dur-" + id);
    if (!audio || !dur) return;
    const total = Math.floor(audio.duration);
    if (!isNaN(total))
        dur.textContent = `0:00 / ${Math.floor(total/60)}:${String(total%60).padStart(2,"0")}`;
}

// ── GRABACIÓN ──────────────────────────────
var mediaRecorder = null, audioChunks = [], isRecording = false;

async function startRecording() {
    if (isRecording && mediaRecorder?.state === "recording") {
        mediaRecorder.requestData(); mediaRecorder.stop(); isRecording = false;
        const rb = document.getElementById("recordBtn");
        rb.classList.remove("recording");
        rb.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/></svg>`;
        document.getElementById("recordingStatus").style.display = "none";
        chatConnection.invoke("StopRecording", receiverId); return;
    }
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = []; isRecording = true;
        const rb = document.getElementById("recordBtn");
        rb.classList.add("recording");
        rb.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>`;
        document.getElementById("recordingStatus").style.display = "flex";
        chatConnection.invoke("StartRecording", receiverId);
        let recSec = 0;
        const ri = setInterval(() => {
            if (!isRecording) { clearInterval(ri); return; }
            recSec++;
            document.getElementById("recTimer").textContent = `${Math.floor(recSec/60)}:${String(recSec%60).padStart(2,"0")}`;
        }, 1000);
        mediaRecorder.ondataavailable = e => { if (e.data?.size > 0) audioChunks.push(e.data); };
        mediaRecorder.onstop = () => {
            stream.getTracks().forEach(t => t.stop());
            if (!audioChunks.length) return;
            const blob = new Blob(audioChunks, { type: 'audio/webm' });
            window.recordedAudio = blob;
            document.getElementById("previewPlayer").src = URL.createObjectURL(blob);
            document.getElementById("audioPreview").style.display = "block";
            document.getElementById("recordingStatus").style.display = "none";
        };
        mediaRecorder.start();
    } catch (err) { alert("Error al acceder al micrófono"); }
}

async function sendAudio() {
    if (!window.recordedAudio) return;
    const formData = new FormData();
    formData.append("audio", window.recordedAudio, "audio.webm");
    formData.append("receiverId", receiverId);
    const btn = document.querySelector(".btn-send-audio");
    btn.textContent = "Enviando..."; btn.disabled = true;
 const res = await fetch('/Message/SendAudio', { method: 'POST', body: formData });
if (res.ok) {
    const data = await res.json();
    const audioTempCheck = "audio-check-" + Date.now();
    const wrap = document.createElement("div");
    wrap.className = "msg-wrap msg-mine";
    wrap.innerHTML = `
        <div class="msg-content-wrap"><div class="msg-bubble bubble-mine">
            ${createAudioPlayer(data.audioUrl)}
            <div class="msg-footer"><span class="msg-time">${makeTime()}</span><span class="msg-check sent" id="${audioTempCheck}">✔</span></div>
        </div></div>`;
        chatBox.insertBefore(wrap, document.getElementById("typingIndicator"));
        scrollBottom(null); cancelAudio();
        if (data.messageId) {
            const check = document.getElementById(audioTempCheck);
            if (check) {
                check.setAttribute("data-message-id", data.messageId);
                wrap.id = "msg-" + data.messageId;
                if (pendingConfirms.has(data.messageId)) {
                    check.textContent = "✔✔"; check.className = "msg-check delivered";
                    pendingConfirms.delete(data.messageId);
                }
            }
        }
    }
    btn.textContent = "Enviar audio"; btn.disabled = false;
}

function cancelAudio() {
    window.recordedAudio = null;
    document.getElementById("previewPlayer").src = "";
    document.getElementById("audioPreview").style.display = "none";
}

