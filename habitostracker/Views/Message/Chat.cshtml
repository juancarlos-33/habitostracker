body.bg-dark .msg-input { background: #2d2d3d !important; border-color: #3d3d4d !important; color: white !important; }
body.bg-dark .input-btn { background: #2d2d3d !important; border-color: #3d3d4d !important; }
body.bg-dark .reaction-btns { background: #2d2d3d !important; }
body.bg-dark .typing-indicator { background: #2d2d3d !important; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const myId = "@User.FindFirst("UserId").Value";
const receiverId = "@ViewBag.OtherUserId";
const chatBox = document.getElementById("chatBox");

// 🔥 scroll al fondo al cargar
window.addEventListener("load", () => {
    chatBox.scrollTop = chatBox.scrollHeight;
});

const connection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub")
    .withAutomaticReconnect()
    .build();

connection.start().then(async () => {
    await connection.invoke("JoinUserGroup", myId);
    await fetch("/Message/MarkAsSeen?senderId=" + receiverId, { method: "POST" });
    localStorage.setItem("currentChatUserId", receiverId);
});

// 🔥 RECIBIR MENSAJE EN TIEMPO REAL
connection.on("ReceiveMessage", (senderId, rcvId, senderName, message) => {
    const currentChat = localStorage.getItem("currentChatUserId");
    if (senderId != currentChat && rcvId != currentChat) return;

    document.getElementById("typingIndicator").style.display = "none";

    const profileImage = "@(ViewBag.OtherUserProfileImage ?? "")";
    const firstLetter = senderName.charAt(0).toUpperCase();
    const avatarHTML = profileImage
        ? `<img src="${profileImage}" class="msg-avatar" />`
        : `<div class="msg-avatar avatar-letter-gray">${firstLetter}</div>`;

    const wrap = document.createElement("div");
    wrap.className = "msg-wrap msg-theirs";
    wrap.innerHTML = `${avatarHTML}<div class="msg-content-wrap"><div class="msg-bubble bubble-theirs">${message}</div></div>`;
    chatBox.appendChild(wrap);
    chatBox.scrollTop = chatBox.scrollHeight;

    fetch("/Message/MarkAsSeen?senderId=" + senderId, { method: "POST" });
    connection.invoke("MessagesViewed", senderId);
});

