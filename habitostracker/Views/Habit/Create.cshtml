@model HabitTrackerApp.Models.Habit

@{
    ViewData["Title"] = "Crear Hábito";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.create-page {
    max-width: 520px; margin: 0 auto;
    font-family: 'Plus Jakarta Sans', sans-serif;
    padding-bottom: 40px;
}

/* HERO */
.create-hero {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-radius: 24px; padding: 28px; margin-bottom: 20px;
    position: relative; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.06);
}
.create-hero::before {
    content:""; position:absolute; top:-50px; right:-50px;
    width:200px; height:200px;
    background: radial-gradient(circle, rgba(99,102,241,0.2), transparent 70%);
    border-radius:50%;
}
.create-hero::after {
    content:""; position:absolute; bottom:-30px; left:40px;
    width:120px; height:120px;
    background: radial-gradient(circle, rgba(37,99,235,0.15), transparent 70%);
    border-radius:50%;
}
.create-hero-content { display: flex; align-items: center; gap: 18px; position: relative; z-index:1; }
.create-hero-icon {
    width: 58px; height: 58px; border-radius: 18px;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px; flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(99,102,241,0.45);
    animation: iconBounce 0.6s cubic-bezier(0.34,1.56,0.64,1);
}
@@keyframes iconBounce {
    from { transform: scale(0.5) rotate(-10deg); opacity:0; }
    to { transform: scale(1) rotate(0deg); opacity:1; }
}
.create-hero-title { font-size: 21px; font-weight: 800; color: white; margin: 0 0 4px; }
.create-hero-sub { font-size: 13px; color: rgba(255,255,255,0.4); margin: 0; }

/* TIPS */
.create-tips {
    display: flex; gap: 8px; margin-top: 18px; flex-wrap: wrap;
    position: relative; z-index:1;
}
.create-tip {
    display: flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 20px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
    font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.5);
}

/* CARD */
.create-card {
    background: white; border-radius: 24px; padding: 28px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    border: 1px solid rgba(0,0,0,0.05);
}

/* ERROR */
.create-error {
    display: none; align-items: center; gap: 8px;
    padding: 12px 16px; border-radius: 14px;
    background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2);
    color: #dc2626; font-size: 13px; font-weight: 600;
    margin-bottom: 18px; animation: errIn 0.3s ease;
}
@@keyframes errIn { from{opacity:0;transform:translateY(-6px);} to{opacity:1;transform:translateY(0);} }

/* FIELD */
.create-field { margin-bottom: 20px; }
.create-label {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 12px; font-weight: 700; color: #374151;
    text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 8px;
}
.create-char-count { font-size: 11px; font-weight: 600; color: #9ca3af; }
.create-char-count.warn { color: #f59e0b; }
.create-char-count.limit { color: #ef4444; }

.create-input-wrap { position: relative; }
.create-input {
    width: 100%; padding: 14px 48px 14px 16px;
    border: 1.5px solid #e5e7eb; border-radius: 14px;
    font-size: 15px; font-family: inherit; outline: none;
    transition: 0.2s; background: #f9fafb; color: #111827;
    box-sizing: border-box;
}
.create-input:focus {
    border-color: #6366f1; background: white;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
}
.create-input.error { border-color: #ef4444; background: #fff5f5; }
.create-input.error:focus { box-shadow: 0 0 0 3px rgba(239,68,68,0.1); }
.create-input::placeholder { color: #9ca3af; }
.create-input-clear {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    width: 24px; height: 24px; border-radius: 50%;
    background: #e5e7eb; border: none; color: #6b7280;
    font-size: 11px; cursor: pointer; display: none;
    align-items: center; justify-content: center;
    transition: 0.15s;
}
.create-input-clear:hover { background: #d1d5db; color: #374151; }

/* SUGERENCIAS */
.create-suggestions-label {
    font-size: 11px; font-weight: 700; color: #9ca3af;
    text-transform: uppercase; letter-spacing: 0.5px;
    margin-bottom: 10px; margin-top: 4px;
}
.create-suggestions { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
.create-suggestion {
    padding: 7px 14px; border-radius: 20px;
    border: 1.5px solid #e5e7eb; background: #f9fafb;
    font-size: 12px; font-weight: 600; color: #374151;
    cursor: pointer; transition: 0.15s; font-family: inherit;
    display: flex; align-items: center; gap: 5px;
}
.create-suggestion:hover { border-color: #6366f1; color: #6366f1; background: rgba(99,102,241,0.04); }
.create-suggestion.selected { border-color: #6366f1; color: #6366f1; background: rgba(99,102,241,0.08); }

/* PREVIEW */
.create-preview {
    display: none; align-items: center; gap: 12px;
    padding: 14px 16px; background: rgba(99,102,241,0.06);
    border: 1.5px solid rgba(99,102,241,0.15); border-radius: 14px;
    margin-bottom: 20px; transition: 0.2s;
}
.create-preview-icon { font-size: 24px; }
.create-preview-text { flex: 1; }
.create-preview-name { font-size: 15px; font-weight: 800; color: #4f46e5; }
.create-preview-sub { font-size: 12px; color: #6366f1; opacity: 0.7; margin-top: 1px; }

/* BTNS */
.create-btns { display: flex; gap: 10px; margin-top: 4px; }
.create-submit {
    flex: 1; padding: 14px; border-radius: 14px; border: none;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; font-size: 14px; font-weight: 800;
    cursor: pointer; font-family: inherit; transition: 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    box-shadow: 0 6px 18px rgba(99,102,241,0.35);
    position: relative; overflow: hidden;
}
.create-submit::before {
    content:""; position:absolute; top:0; left:-100%;
    width:100%; height:100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: 0.5s;
}
.create-submit:hover::before { left:100%; }
.create-submit:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(99,102,241,0.45); }
.create-submit:disabled { background: #cbd5e1; box-shadow: none; cursor: not-allowed; transform: none; }
.create-cancel {
    padding: 14px 22px; border-radius: 14px;
    border: 1.5px solid #e5e7eb; background: white;
    color: #374151; font-size: 14px; font-weight: 700;
    cursor: pointer; font-family: inherit; transition: 0.2s;
    text-decoration: none; display: flex; align-items: center; gap: 6px;
}
.create-cancel:hover { background: #f9fafb; border-color: #d1d5db; color: #111827; }

/* DARK */
body.bg-dark .create-card { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .create-label { color: #94a3b8 !important; }
body.bg-dark .create-input { background: #2d3748 !important; border-color: #3d4d60 !important; color: #f1f5f9 !important; }
body.bg-dark .create-input:focus { background: #334155 !important; }
body.bg-dark .create-input.error { background: rgba(239,68,68,0.1) !important; }
body.bg-dark .create-suggestion { background: #2d3748 !important; border-color: #3d4d60 !important; color: #94a3b8 !important; }
body.bg-dark .create-suggestion:hover { border-color: #6366f1 !important; color: #818cf8 !important; background: rgba(99,102,241,0.1) !important; }
body.bg-dark .create-cancel { background: #2d3748 !important; border-color: #3d4d60 !important; color: #94a3b8 !important; }
body.bg-dark .create-cancel:hover { background: #334155 !important; color: #f1f5f9 !important; }
body.bg-dark .create-preview { background: rgba(99,102,241,0.1) !important; }
body.bg-dark .create-suggestions-label { color: #475569 !important; }
</style>

<div class="create-page">

    <!-- HERO -->
    <div class="create-hero">
        <div class="create-hero-content">
            <div class="create-hero-icon">🎯</div>
            <div>
                <div class="create-hero-title">Nuevo hábito</div>
                <div class="create-hero-sub">Dale un nombre claro y específico</div>
            </div>
        </div>
        <div class="create-tips">
            <div class="create-tip">⏰ Hazlo diario</div>
            <div class="create-tip">📏 Sé específico</div>
            <div class="create-tip">🔥 Empieza pequeño</div>
        </div>
    </div>

    <div class="create-card">

        @if (TempData["Error"] != null)
        {
            <div class="create-error" style="display:flex;">
                ⚠️ @TempData["Error"]
            </div>
        }

        <div class="create-error" id="nameError">
            ⚠️ El nombre del hábito es obligatorio.
        </div>

        <!-- PREVIEW en tiempo real -->
        <div class="create-preview" id="habitPreview">
            <div class="create-preview-icon" id="previewIcon">🎯</div>
            <div class="create-preview-text">
                <div class="create-preview-name" id="previewName"></div>
                <div class="create-preview-sub">Racha: 0 días · Listo para empezar</div>
            </div>
        </div>

        <form asp-action="Create" method="post" id="createForm">
            @Html.AntiForgeryToken()

            <div class="create-field">
                <div class="create-label">
                    <span>Nombre del hábito *</span>
                    <span class="create-char-count" id="charCount">0/60</span>
                </div>
                <div class="create-input-wrap">
                    <input type="text" id="habitName" asp-for="Name"
                           class="create-input"
                           placeholder="Ej: Leer 30 minutos al día..."
                           oninput="onHabitInput(this)"
                           maxlength="60"
                           autocomplete="off" />
                    <button type="button" class="create-input-clear" id="clearBtn"
                            onclick="clearInput()">✕</button>
                </div>
            </div>

            <!-- SUGERENCIAS -->
            <div class="create-suggestions-label">💡 Sugerencias rápidas</div>
            <div class="create-suggestions">
                @foreach (var s in new[] {
                    ("📚", "Leer 30 min"),
                    ("🏃", "Ejercicio"),
                    ("💧", "Tomar agua"),
                    ("🧘", "Meditar"),
                    ("📝", "Journaling"),
                    ("🛌", "Dormir 8h"),
                    ("🚶", "Caminar"),
                    ("🎸", "Practicar")
                })
                {
                    <button type="button" class="create-suggestion"
                            onclick="useSuggestion('@s.Item1 @s.Item2')">
                        @s.Item1 @s.Item2
                    </button>
                }
            </div>

            <div class="create-btns" style="margin-top:24px;">
                <a href="/Habit" class="create-cancel">← Cancelar</a>
                <button type="submit" class="create-submit" id="submitBtn" disabled>
                    🎯 Crear hábito
                </button>
            </div>
        </form>
    </div>
</div>

<script>
const habitIcons = {
    "leer": "📚", "libro": "📚", "read": "📚",
    "ejercicio": "🏃", "gym": "💪", "correr": "🏃", "deporte": "⚽",
    "agua": "💧", "hidrat": "💧",
    "meditar": "🧘", "meditación": "🧘",
    "journal": "📝", "escribir": "✍️", "diario": "📓",
    "dormir": "🛌", "sueño": "🛌",
    "caminar": "🚶", "pasear": "🚶",
    "música": "🎵", "guitar": "🎸", "practicar": "🎯",
    "paja": "🚫", "pornografía": "🚫", "dejar": "🚫",
    "cocinar": "🍳", "comer": "🥗",
    "estudiar": "📖", "inglés": "🗣️",
    "default": "🎯"
};

function getIcon(name) {
    const lower = name.toLowerCase();
    for (const [key, icon] of Object.entries(habitIcons)) {
        if (lower.includes(key)) return icon;
    }
    return habitIcons.default;
}

function onHabitInput(input) {
    const val = input.value;
    const len = val.length;

    // contador
    const counter = document.getElementById("charCount");
    counter.textContent = `${len}/60`;
    counter.className = "create-char-count" + (len > 50 ? " warn" : "") + (len >= 58 ? " limit" : "");

    // clear btn
    document.getElementById("clearBtn").style.display = len > 0 ? "flex" : "none";

    // error
    if (len > 0) {
        input.classList.remove("error");
        document.getElementById("nameError").style.display = "none";
    }

    // preview
    const preview = document.getElementById("habitPreview");
    const previewName = document.getElementById("previewName");
    const previewIcon = document.getElementById("previewIcon");

    if (val.trim().length > 0) {
        previewName.textContent = val.trim();
        previewIcon.textContent = getIcon(val);
        preview.style.display = "flex";
    } else {
        preview.style.display = "none";
    }

    // submit
    document.getElementById("submitBtn").disabled = val.trim() === "";
}

function clearInput() {
    const input = document.getElementById("habitName");
    input.value = "";
    input.focus();
    onHabitInput(input);
}

function useSuggestion(text) {
    const input = document.getElementById("habitName");
    input.value = text;
    onHabitInput(input);
    input.focus();

    // marcar sugerencia seleccionada
    document.querySelectorAll(".create-suggestion").forEach(btn => {
        btn.classList.toggle("selected", btn.textContent.trim() === text.trim());
    });
}

document.getElementById("createForm").addEventListener("submit", function(e) {
    const name = document.getElementById("habitName").value.trim();
    if (!name) {
        e.preventDefault();
        const input = document.getElementById("habitName");
        input.classList.add("error");
        input.focus();
        const err = document.getElementById("nameError");
        err.style.display = "flex";
        err.scrollIntoView({ behavior: "smooth", block: "center" });
    } else {
        const btn = document.getElementById("submitBtn");
        btn.innerHTML = "⏳ Creando...";
        btn.disabled = true;
    }
});

// ocultar loader si existe
document.addEventListener("DOMContentLoaded", function() {
    const loader = document.getElementById("globalLoader");
    if (loader) { loader.style.display = "none"; loader.style.pointerEvents = "none"; }
});
</script>