@model List<HabitTrackerApp.Models.Habit>
@inject HabitTrackerApp.Data.HabitDbContext _context

<!-- MENSAJES DE ALERTA -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@{
    // DATOS DEL USUARIO
    var username = User.Identity?.Name ?? "";
    var user = _context.Users.FirstOrDefault(u => u.Username == username);
    var habits = Model;

    // ESTADÍSTICAS GENERALES
    int totalHabits = habits.Count();
    int totalStreak = habits.Sum(h => h.StreakDays);
    int bestRecord = habits.Any() ? habits.Max(h => h.MaxStreak) : 0;
    int completedToday = habits.Count(h => h.LastCheckDate == DateTime.Today && h.Completed);
    int completionRate = totalHabits > 0 ? (int)((completedToday * 100.0) / totalHabits) : 0;

    // MENSAJE DE BIENVENIDA SEGÚN GÉNERO
    string welcomeMessage = $"Bienvenido, {username} 👋";
    string welcomeClass = "welcome-neutral";

    if (user != null)
    {
        if (user.Gender?.ToLower() == "masculino")
        {
            welcomeMessage = $"Bienvenido, {user.Username} 👋";
            welcomeClass = "welcome-male";
        }
        else if (user.Gender?.ToLower() == "femenino")
        {
            welcomeMessage = $"Bienvenida, {user.Username} 👋";
            welcomeClass = "welcome-female";
        }
    }

    ViewData["Title"] = "HabitTracker Pro";

    // DATOS PARA EL GRÁFICO (ÚLTIMOS 7 DÍAS)
    var last7Days = Enumerable.Range(0, 7)
        .Select(i => DateTime.Today.AddDays(-i))
        .Reverse()
        .ToList();

    var habitIds = habits.Select(h => h.Id).ToList();
    var histories = _context.HabitHistories
        .Where(h => habitIds.Contains(h.HabitId) && h.Date >= DateTime.Today.AddDays(-6))
        .ToList();

    var dailyCompletion = last7Days.Select(date =>
    {
        if (!habits.Any()) return 0;
        int completed = histories.Count(h => h.Date.Date == date.Date && h.Completed);
        int failed = histories.Count(h => h.Date.Date == date.Date && !h.Completed);
        int total = completed + failed;
        return total > 0 ? (int)((completed * 100.0) / total) : 0;
    }).ToList();
}

<!-- BANNER DE PLAN -->
@if (user != null)
{
    if (!user.IsPremium)
    {
        <div class="plan-banner">
            <span>🚀 Estás en versión gratuita <b>(máx 5 hábitos)</b></span>
            <a asp-controller="User" asp-action="Pay" class="premium-btn">💳 Hazte Premium</a>
        </div>
    }
    else
    {
        <div class="plan-banner premium">👑 Eres usuario <b>PREMIUM</b> — sin límites 🔥</div>
    }
}

<!-- TARJETA DE BIENVENIDA -->
<div class="welcome-card @welcomeClass">
    <div class="welcome-content">
        <div class="welcome-avatar">
            @{ var profileImage = User.FindFirst("ProfileImage")?.Value; }
            @if (!string.IsNullOrEmpty(profileImage))
            {
                <img src="@profileImage" alt="avatar" />
            }
            else
            {
                @(username.Length > 0 ? username.Substring(0, 1).ToUpper() : "?")
            }
        </div>
        <div class="welcome-text">
            <h5>@welcomeMessage</h5>
            <small>Disciplina diaria. Resultados extraordinarios.</small>
        </div>
    </div>
    <div class="welcome-right">
        <div class="welcome-stats">
            <div class="welcome-stat">
                <span class="ws-val">@completedToday</span>
                <span class="ws-label">Hoy</span>
            </div>
            <div class="welcome-stat-divider"></div>
            <div class="welcome-stat">
                <span class="ws-val">@totalStreak</span>
                <span class="ws-label">Racha</span>
            </div>
            <div class="welcome-stat-divider"></div>
            <div class="welcome-stat">
                <span class="ws-val">@completionRate%</span>
                <span class="ws-label">Completado</span>
            </div>
        </div>
        <div class="welcome-weather" id="weatherCard" style="display:none;">
            <span class="ww-icon" id="weatherIcon">⛅</span>
            <div class="ww-info">
                <span class="ww-temp" id="weatherTemp">--°C</span>
                <span class="ww-city" id="weatherCity">--</span>
            </div>
        </div>
    </div>
</div>

<!-- FRASE MOTIVACIONAL -->
<div class="quote-card">
    <span class="quote-icon">✨</span>
    <p class="quote-text" id="quoteText"></p>
</div>

<!-- TARJETAS DE ESTADÍSTICAS (KPIs) -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon">📋</div>
        <div class="kpi-value">@totalHabits</div>
        <div class="kpi-label">Hábitos</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon">🔥</div>
        <div class="kpi-value streak">@totalStreak</div>
        <div class="kpi-label">Racha Total</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon">⚡</div>
        <div class="kpi-value today">@completionRate%</div>
        <div class="kpi-label">Completado Hoy</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon">🏆</div>
        <div class="kpi-value record">@bestRecord</div>
        <div class="kpi-label">Mejor Récord</div>
    </div>
</div>

<!-- BOTÓN NUEVO HÁBITO -->
<div class="action-row">
    @if (user != null && (user.IsPremium || Model.Count < 5))
    {
        <a asp-action="Create" class="new-habit-btn">➕ Nuevo hábito</a>
    }
    else
    {
        <a asp-controller="User" asp-action="Pay" class="new-habit-btn locked">🔒 Hazte Premium</a>
    }
</div>

<!-- LISTA DE HÁBITOS -->
<div class="habits-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🌱</div>
            <p>Aún no tienes hábitos creados.</p>
            <small>¡Empieza creando tu primer hábito!</small>
        </div>
    }
    else
    {
        @if (user != null && !user.IsPremium && Model.Count >= 5)
        {
            <div class="limit-alert">
                🚫 Alcanzaste el límite de hábitos.
                <a asp-controller="User" asp-action="Pay">Hazte premium 🔥</a>
            </div>
        }

        <table class="habits-table">
            <thead>
                <tr>
                    <th>HÁBITO</th>
                    <th>ESTADO</th>
                    <th>RACHA</th>
                    <th>RÉCORD</th>
                    <th>CREADO</th>
                    <th class="text-center">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var habit in Model)
                {
                    <tr>
                        <td class="habit-name">@habit.Name</td>
                        <td>
                            @if (habit.LastCheckDate == DateTime.Today && habit.Completed)
                            { <span class="status-badge success">✔ Completado</span> }
                            else if (habit.LastCheckDate == DateTime.Today && !habit.Completed)
                            { <span class="status-badge danger">✖ Fallado</span> }
                            else
                            { <span class="status-badge pending">⏳ Pendiente</span> }
                        </td>
                        <td class="streak-val">@habit.StreakDays 🔥</td>
                        <td class="record-val">@habit.MaxStreak 🏆</td>
                        <td class="date-val">@habit.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td class="text-center">
                            <div class="action-btns">
                                <a href="/Habit/Complete/@habit.Id" class="hab-btn complete" title="Completar">✔</a>
                                <a href="/Habit/Fail/@habit.Id" class="hab-btn fail" title="Fallar">✖</a>
                                <a asp-action="Edit" asp-route-id="@habit.Id" class="hab-btn edit" title="Editar">✏</a>
                                <a asp-action="Delete" asp-route-id="@habit.Id" class="hab-btn delete" 
                                   data-no-loader="true" 
                                   onclick="if(!confirm('¿Eliminar hábito?')) return false;" title="Eliminar">🗑</a>
                            </div>
                        </td>
                    </tr>
                    <tr class="comment-row">
                        <td colspan="6">
                            <form asp-action="AddComment" method="post" class="comment-form">
                                <input type="hidden" name="habitId" value="@habit.Id" />
                                <input type="text" name="content" class="comment-input" placeholder="💬 Escribe un comentario..." />
                            </form>
                            @if (habit.Comments != null && habit.Comments.Any())
                            {
                                foreach (var c in habit.Comments.OrderByDescending(x => x.CreatedAt))
                                {
                                    <div class="comment-item">
                                        <b>@c.User.Username:</b> @c.Content
                                    </div>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- GRÁFICO DE PROGRESO -->
<div class="chart-card">
    <h5 class="chart-title">📈 Progreso últimos 7 días</h5>
    <canvas id="habitChart"></canvas>
</div>

@section Scripts {
<script>
    // DATOS PARA CHART.JS
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(last7Days.Select(d => d.ToString("dd/MM"))));
    const dataValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dailyCompletion));
    
    // DETECTAR MODO OSCURO
    const isDark = document.body.classList.contains('bg-dark');
    const gridColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)';
    const textColor = isDark ? '#94a3b8' : '#6b7280';

    // INICIALIZAR GRÁFICO
    new Chart(document.getElementById('habitChart'), {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                data: dataValues,
                borderWidth: 3,
                tension: 0.4,
                fill: true,
                pointRadius: 5,
                pointHoverRadius: 7,
                pointBackgroundColor: '#6366f1',
                backgroundColor: 'rgba(99,102,241,0.12)',
                borderColor: '#6366f1'
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ctx.parsed.y + '% completado'
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: 100,
                    ticks: { color: textColor, callback: val => val + '%' },
                    grid: { color: gridColor }
                },
                x: {
                    ticks: { color: textColor },
                    grid: { color: gridColor }
                }
            }
        }
    });

    // FRASES MOTIVACIONALES
    const frases = [
        "La disciplina es el puente entre metas y logros. 🚀",
        "Cada día es una nueva oportunidad para mejorar. 💪",
        "Los pequeños hábitos crean grandes cambios. 🌱",
        "El éxito no es un destino, es un hábito diario. 🏆",
        "No necesitas ser perfecto, solo consistente. 🔥",
        "Un hábito a la vez. Un día a la vez. ⚡",
        "La constancia vence al talento cuando el talento no es constante. 🎯",
        "Hoy es el mejor día para empezar. 📅",
        "Tu futuro depende de lo que hagas hoy. 💡",
        "La motivación te arranca, el hábito te mantiene. 🛤️",
        "Pequeñas acciones repetidas crean grandes resultados. ✨",
        "El dolor de la disciplina es menor que el dolor del arrepentimiento. 💎",
        "Sé la mejor versión de ti mismo, cada día. 🌟",
        "Los ganadores hacen lo que los perdedores no quieren hacer. 👑",
        "No cuentes los días, haz que los días cuenten. ⏳",
        "El secreto del éxito es la consistencia del propósito. 🧠",
        "Cae siete veces, levántate ocho. 🥊",
        "No esperes la motivación, crea el hábito. ⚙️",
        "El éxito es la suma de pequeños esfuerzos repetidos cada día. 📈",
        "Trabaja en silencio, deja que tus resultados hagan el ruido. 🔇",
        "Lo que haces hoy puede mejorar todos tus mañanas. ☀️",
        "La única forma de hacer un gran trabajo es amar lo que haces. ❤️",
        "Primero forma el hábito, luego el hábito te forma a ti. 🔄",
        "Si puedes soñarlo, puedes lograrlo. 💭",
        "Cada experto fue una vez un principiante. 🌿",
        "No te rindas, los comienzos siempre son difíciles. 🏔️",
        "El progreso, no la perfección, es el objetivo. 📊",
        "Invierte en ti mismo, es la mejor inversión. 💰",
        "Los hábitos son el interés compuesto del auto-mejoramiento. 📉",
        "Haz de tu vida una obra maestra. 🎨",
        "El coraje no es la ausencia de miedo, es actuar a pesar de él. 🦁",
        "Sueña en grande, actúa en pequeño, empieza ahora. 🎯",
        "El único límite eres tú mismo. 🚧",
        "La grandeza no viene de circunstancias, sino de esfuerzo. 💥",
        "Nunca es tarde para ser lo que podrías haber sido. 🕰️",
        "El futuro pertenece a quienes se preparan hoy. 🗓️",
        "Tu actitud determina tu dirección. 🧭",
        "Cada día que avanzas es un",
                "Cada día que avanzas es un día que te acercas a tu meta. 🏁",
        "La vida es 10% lo que te pasa y 90% cómo reaccionas. ⚖️",
        "Rodéate de personas que enciendan tu fuego, no que lo apaguen. 🔦",
        "El esfuerzo de hoy es el éxito de mañana. 🌅",
        "No busques el momento perfecto, toma el momento y hazlo perfecto. ⏰",
        "Más vale intentarlo y fallar que no intentarlo nunca. 🎲",
        "La disciplina es elegir entre lo que quieres ahora y lo que quieres más tarde. ⚡",
        "Cada mañana traes nuevas fuerzas y nuevos pensamientos. 🌄",
        "La perseverancia es la madre del éxito. 🏅",
        "No te compares con otros, compárate con quien eras ayer. 🪞",
        "El camino al éxito está siempre en construcción. 🔨",
        "Haz hoy lo que otros no harán para tener mañana lo que otros no tendrán. 🌠",
        "La excelencia no es un acto, es un hábito. 👌",
        "Comienza donde estás, usa lo que tienes, haz lo que puedas. 🛠️"
    ];

    let fraseIndex = Math.floor(Math.random() * frases.length);
    const quoteText = document.getElementById("quoteText");

    function mostrarFrase() {
        quoteText.style.opacity = "0";
        quoteText.style.transform = "translateY(6px)";
        setTimeout(() => {
            fraseIndex = (fraseIndex + 1) % frases.length;
            quoteText.textContent = frases[fraseIndex];
            quoteText.style.opacity = "1";
            quoteText.style.transform = "translateY(0)";
        }, 600);
    }

    // Mostrar primera frase
    quoteText.textContent = frases[fraseIndex];
    setTimeout(() => {
        quoteText.style.opacity = "1";
        quoteText.style.transform = "translateY(0)";
    }, 100);

    // Cambiar frase cada 4 segundos
    setInterval(mostrarFrase, 4000);

    // FUNCIONALIDAD DEL CLIMA
    function getWeatherIcon(code) {
        if (code >= 200 && code < 300) return "⛈️";
        if (code >= 300 && code < 400) return "🌦️";
        if (code >= 500 && code < 600) return "🌧️";
        if (code >= 600 && code < 700) return "❄️";
        if (code >= 700 && code < 800) return "🌫️";
        if (code === 800) return "☀️";
        if (code === 801) return "🌤️";
        if (code >= 802) return "⛅";
        return "🌡️";
    }

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function(pos) {
            const lat = pos.coords.latitude;
            const lon = pos.coords.longitude;

            fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&timezone=auto`)
                .then(r => r.json())
                .then(data => {
                    const w = data.current_weather;
                    const temp = Math.round(w.temperature);
                    const code = w.weathercode;

                    document.getElementById("weatherTemp").textContent = temp + "°C";
                    document.getElementById("weatherIcon").textContent = getWeatherIcon(code);
                    document.getElementById("weatherCard").style.display = "flex";

                    // Obtener ciudad
                    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`, {
                        headers: { "Accept-Language": "es" }
                    })
                    .then(r => r.json())
                    .then(geo => {
                        const city = geo.address?.city
                            || geo.address?.town
                            || geo.address?.village
                            || geo.address?.county
                            || "Tu ubicación";
                        document.getElementById("weatherCity").textContent = city;
                    })
                    .catch(() => {
                        document.getElementById("weatherCity").textContent = "Tu ubicación";
                    });
                })
                .catch(() => {});
        }, function() {}, { timeout: 6000 });
    }
</script>
}

<style>
