@model List<HabitTrackerApp.Models.Habit>
@inject HabitTrackerApp.Data.HabitDbContext _context

@if (TempData["Error"] != null) { <div class="hx-alert danger">@TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div class="hx-alert success">@TempData["Success"]</div> }

@{
    var username = User.Identity?.Name ?? "";
    var user = _context.Users.FirstOrDefault(u => u.Username == username);
    var habits = Model;
    int totalHabits = habits.Count();
    int totalStreak = habits.Sum(h => h.StreakDays);
    int bestRecord = habits.Any() ? habits.Max(h => h.MaxStreak) : 0;
    int completedToday = habits.Count(h => h.LastCheckDate == DateTime.Today && h.Completed);
    int completionRate = totalHabits > 0 ? (int)((completedToday * 100.0) / totalHabits) : 0;
    bool isPremium = user?.IsPremium == true;
    bool isGuest = user?.Role == "Guest";
    string welcomeMsg = user?.Gender?.ToLower() == "femenino"
        ? $"Hola, {user.Username} ✨" : $"Hola, {user?.Username ?? username} 👋";
    string greeting = DateTime.Now.Hour < 12 ? "Buenos días" : DateTime.Now.Hour < 18 ? "Buenas tardes" : "Buenas noches";
    ViewData["Title"] = "HabitTracker Pro";
    var last7Days = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(-i)).Reverse().ToList();
    var habitIds = habits.Select(h => h.Id).ToList();
    var histories = _context.HabitHistories
        .Where(h => habitIds.Contains(h.HabitId) && h.Date >= DateTime.Today.AddDays(-6)).ToList();
    var dailyCompletion = last7Days.Select(date => {
        if (!habits.Any()) return 0;
        int c = histories.Count(h => h.Date.Date == date.Date && h.Completed);
        int f = histories.Count(h => h.Date.Date == date.Date && !h.Completed);
        int t = c + f;
        return t > 0 ? (int)((c * 100.0) / t) : 0;
    }).ToList();
    var pendingHabits = habits.Where(h => h.LastCheckDate != DateTime.Today).ToList();
    var completedHabits = habits.Where(h => h.LastCheckDate == DateTime.Today && h.Completed).ToList();
    int avgStreak = totalHabits > 0 ? (int)(totalStreak / totalHabits) : 0;
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
    --card:#ffffff;--card2:#f8faff;
    --border:rgba(0,0,0,0.07);--border2:rgba(0,0,0,0.12);
    --accent:#5b5ef4;--accent2:#3730d9;--ag:rgba(91,94,244,0.3);
    --green:#00c48c;--orange:#ff7043;--gold:#f59e0b;--red:#ef4444;
    --text:#0f172a;--muted:#64748b;--muted2:#94a3b8;
    --r1:22px;--r2:16px;
}
body.bg-dark{
    --card:#0f172a;--card2:#111827;
    --border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.1);
    --text:#f1f5f9;--muted:#64748b;--muted2:#475569;
}
.hx-alert{padding:12px 18px;border-radius:14px;margin-bottom:14px;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px;}
.hx-alert.danger{background:rgba(239,68,68,0.08);color:var(--red);border:1px solid rgba(239,68,68,0.2);}
.hx-alert.success{background:rgba(0,196,140,0.08);color:var(--green);border:1px solid rgba(0,196,140,0.2);}
.hx-page{max-width:1100px;margin:0 auto;font-family:'DM Sans',sans-serif;color:var(--text);padding-bottom:70px;}

/* HERO */
.hx-hero{position:relative;border-radius:26px;overflow:hidden;margin-bottom:16px;padding:24px 26px 22px;}
.hx-hero-bg{position:absolute;inset:0;z-index:0;}
.hx-hero-base{position:absolute;inset:0;background:linear-gradient(135deg,#0a0e1f 0%,#1a1060 40%,#0d1f3c 70%,#060c18 100%);}
.hx-hero-mesh{position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 80% 20%,rgba(91,94,244,0.35) 0%,transparent 55%),radial-gradient(ellipse 50% 50% at 10% 80%,rgba(0,196,140,0.2) 0%,transparent 55%);}
.hx-hero-grid{position:absolute;inset:0;opacity:0.04;background-image:linear-gradient(rgba(255,255,255,1) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,1) 1px,transparent 1px);background-size:40px 40px;}
.hx-orb{position:absolute;border-radius:50%;filter:blur(60px);opacity:0.4;pointer-events:none;}
.hx-orb-1{width:280px;height:280px;top:-80px;right:-60px;background:radial-gradient(circle,#5b5ef4,transparent);animation:o1 8s ease-in-out infinite;}
.hx-orb-2{width:180px;height:180px;bottom:-40px;left:8%;background:radial-gradient(circle,#00c48c,transparent);animation:o2 10s ease-in-out infinite;}
@@keyframes o1{0%,100%{transform:translate(0,0)scale(1);}50%{transform:translate(-20px,18px)scale(1.08);}}
@@keyframes o2{0%,100%{transform:translate(0,0);}50%{transform:translate(18px,-12px);}}
.hx-hero-inner{position:relative;z-index:1;}
.hx-hero-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;}
.hx-hero-id{display:flex;align-items:center;gap:12px;flex:1;min-width:0;}
.hx-av{width:50px;height:50px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--accent),var(--accent2));border:2px solid rgba(255,255,255,0.25);display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-size:19px;font-weight:800;color:white;overflow:hidden;box-shadow:0 0 0 3px rgba(255,255,255,0.08),0 8px 20px rgba(0,0,0,0.35);transition:0.25s;cursor:pointer;}
.hx-av:hover{transform:scale(1.06);}
.hx-av img{width:100%;height:100%;object-fit:cover;}
.hx-hero-txt{min-width:0;flex:1;}
.hx-hero-greeting{font-size:11px;color:rgba(255,255,255,0.4);font-weight:500;margin-bottom:2px;}
.hx-hero-name{font-family:'Syne',sans-serif;font-size:18px;font-weight:800;color:white;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-0.2px;}
.hx-hero-right{display:flex;gap:7px;align-items:center;flex-shrink:0;}
.hx-wpill{display:none;align-items:center;gap:4px;padding:6px 11px;border-radius:20px;font-size:11px;font-weight:600;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.75);}
.hx-ppill{display:inline-flex;align-items:center;gap:5px;padding:6px 13px;border-radius:20px;font-size:11px;font-weight:700;text-decoration:none;transition:0.2s;white-space:nowrap;}
.hx-ppill.free{background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;box-shadow:0 4px 14px var(--ag);}
.hx-ppill.free:hover{transform:translateY(-1px);color:white;}
.hx-ppill.pro{background:rgba(245,158,11,0.15);color:#fcd34d;border:1px solid rgba(245,158,11,0.3);}
.hx-stats{display:grid;grid-template-columns:repeat(4,1fr);background:rgba(0,0,0,0.28);border-radius:16px;border:1px solid rgba(255,255,255,0.07);backdrop-filter:blur(18px);overflow:hidden;}
.hx-stat{padding:13px 10px;text-align:center;position:relative;transition:0.2s;}
.hx-stat:hover{background:rgba(255,255,255,0.04);}
.hx-stat:not(:last-child)::after{content:'';position:absolute;right:0;top:20%;height:60%;width:1px;background:rgba(255,255,255,0.07);}
.hx-stat-val{font-family:'Syne',sans-serif;font-size:19px;font-weight:800;color:white;line-height:1;margin-bottom:4px;display:flex;align-items:center;justify-content:center;gap:3px;}
.hx-stat-lbl{font-size:8px;color:rgba(255,255,255,0.38);text-transform:uppercase;letter-spacing:1px;font-weight:700;}
.hx-stat.ring{position:relative;}
.hx-rsvg{position:absolute;top:7px;right:7px;width:24px;height:24px;transform:rotate(-90deg);}
.hx-rbg{fill:none;stroke:rgba(255,255,255,0.09);stroke-width:3;}
.hx-rfill{fill:none;stroke:var(--green);stroke-width:3;stroke-linecap:round;transition:stroke-dashoffset 1.5s cubic-bezier(0.4,0,0.2,1);}

/* STORIES */
.hx-stories{background:var(--card);border-radius:var(--r1);border:1px solid var(--border);margin-bottom:16px;overflow:hidden;}
.hx-stories-inner{display:flex;overflow-x:auto;padding:14px 12px;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
.hx-stories-inner::-webkit-scrollbar{display:none;}
.hx-si{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;flex-shrink:0;width:70px;padding:0 3px;transition:0.15s;}
.hx-si:hover{transform:scale(1.04);}
.hx-sring{width:58px;height:58px;border-radius:50%;padding:2.5px;position:relative;transition:0.2s;}
.hx-sring.fresh{background:conic-gradient(#f97316,#ec4899,#8b5cf6,#f97316);}
.hx-sring.mine{background:conic-gradient(var(--accent),var(--accent2),var(--accent));}
.hx-sring.seen{background:var(--border2);}
.hx-sinner{width:100%;height:100%;border-radius:50%;background:#e5e7eb;display:flex;align-items:center;justify-content:center;overflow:hidden;border:2px solid var(--card);}
body.bg-dark .hx-sinner{background:#1e293b;border-color:var(--card);}
.hx-sinner img{width:100%;height:100%;object-fit:cover;}
.hx-sletter{width:100%;height:100%;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-size:19px;font-weight:800;}
.hx-sadd{position:absolute;bottom:-1px;right:-1px;width:18px;height:18px;border-radius:50%;background:var(--accent);color:white;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;border:2px solid var(--card);}
.hx-sname{font-size:10px;font-weight:600;color:var(--muted);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:66px;}

.hx-body{display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start;}
.hx-left{display:flex;flex-direction:column;gap:14px;}
.hx-right{display:flex;flex-direction:column;gap:14px;}

.hx-quote{background:var(--card);border-radius:var(--r2);border:1px solid var(--border);padding:13px 16px;display:flex;align-items:center;gap:10px;}
.hx-qi{font-size:15px;flex-shrink:0;}
.hx-qt{font-size:12px;color:var(--muted);font-style:italic;line-height:1.6;flex:1;opacity:0;transform:translateY(5px);transition:opacity 0.5s,transform 0.5s;}

/* ACTIONS */
.hx-actions{display:flex;gap:7px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;}
.hx-actions::-webkit-scrollbar{display:none;}
.hx-btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:24px;font-size:12px;font-weight:700;text-decoration:none;transition:0.2s;flex-shrink:0;font-family:inherit;border:none;cursor:pointer;white-space:nowrap;}
.hx-btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;box-shadow:0 4px 14px var(--ag);}
.hx-btn.primary:hover{transform:translateY(-2px);color:white;}
.hx-btn.ghost{background:var(--card);border:1.5px solid var(--border2);color:var(--muted);}
.hx-btn.ghost:hover{border-color:var(--accent);color:var(--accent);}
.hx-btn.locked{background:var(--card2);border:1.5px solid var(--border);color:var(--muted2);opacity:0.75;cursor:not-allowed;pointer-events:none;}
.hx-btn.locked:hover{opacity:1;border-color:var(--gold);color:var(--gold);}
/* KPI bloqueados */
.hx-kpi.locked-k{opacity:0.55;cursor:default;pointer-events:none;}
.hx-kpi.locked-k:hover{opacity:0.8;transform:translateY(-1px);}

/* KPI */
.hx-kpi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
.hx-kpi{background:var(--card);border-radius:var(--r2);border:1px solid var(--border);padding:16px 14px;display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--text);transition:0.22s;position:relative;overflow:hidden;}
.hx-kpi::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.hx-kpi.kb::after{background:linear-gradient(90deg,#3b82f6,#6366f1);}
.hx-kpi.kg::after{background:linear-gradient(90deg,var(--green),#10b981);}
.hx-kpi.ko::after{background:linear-gradient(90deg,var(--orange),var(--gold));}
.hx-kpi.kd::after{background:linear-gradient(90deg,var(--gold),#fbbf24);}
.hx-kpi:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,0.1);border-color:var(--border2);color:var(--text);}
.hx-kpi.locked-k:hover{transform:none;box-shadow:none;}
.hx-kico{width:42px;height:42px;border-radius:13px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:20px;}
.hx-kpi.kb .hx-kico{background:rgba(59,130,246,0.1);}
.hx-kpi.kg .hx-kico{background:rgba(0,196,140,0.1);}
.hx-kpi.ko .hx-kico{background:rgba(255,112,67,0.1);}
.hx-kpi.kd .hx-kico{background:rgba(245,158,11,0.1);}
.hx-kval{font-family:'Syne',sans-serif;font-size:24px;font-weight:800;line-height:1;margin-bottom:2px;}
.hx-kpi.kb .hx-kval{color:#3b82f6;}
.hx-kpi.kg .hx-kval{color:var(--green);}
.hx-kpi.ko .hx-kval{color:var(--orange);}
.hx-kpi.kd .hx-kval{color:var(--gold);}
.hx-klbl{font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:0.4px;}

/* HABIT CARD */
.hx-hcard{background:var(--card);border-radius:var(--r1);border:1px solid var(--border);overflow:hidden;}
.hx-hcard-hd{display:flex;align-items:center;justify-content:space-between;padding:16px 18px 0;}
.hx-hcard-title{font-family:'Syne',sans-serif;font-size:15px;font-weight:800;color:var(--text);display:flex;align-items:center;gap:7px;}
.hx-hbadge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;background:rgba(91,94,244,0.1);color:var(--accent);border:1px solid rgba(91,94,244,0.2);}
.hx-hadd{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;border:none;background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;font-size:11px;font-weight:700;text-decoration:none;cursor:pointer;transition:0.2s;box-shadow:0 2px 8px var(--ag);}
.hx-hadd:hover{transform:translateY(-1px);color:white;}
.hx-htabs{display:flex;gap:4px;padding:12px 16px 0;overflow-x:auto;scrollbar-width:none;}
.hx-htabs::-webkit-scrollbar{display:none;}
.hx-htab{padding:5px 12px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;border:none;font-family:inherit;transition:0.15s;background:transparent;color:var(--muted);white-space:nowrap;}
.hx-htab.on{background:rgba(91,94,244,0.1);color:var(--accent);}
.hx-htab:hover:not(.on){color:var(--text);}
.hx-hlist{padding:10px 12px 12px;display:flex;flex-direction:column;gap:7px;}
.hx-habit{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:15px;background:var(--card2);border:1.5px solid var(--border);transition:0.18s;position:relative;overflow:hidden;}
.hx-habit::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:15px 0 0 15px;}
.hx-habit.done::before{background:var(--green);}
.hx-habit.failed::before{background:var(--red);}
.hx-habit.pending::before{background:var(--accent);}
.hx-habit:hover{border-color:var(--border2);box-shadow:0 4px 14px rgba(0,0,0,0.06);}
.hx-hico{width:34px;height:34px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:15px;}
.hx-habit.done .hx-hico{background:rgba(0,196,140,0.12);color:var(--green);}
.hx-habit.failed .hx-hico{background:rgba(239,68,68,0.08);color:var(--red);}
.hx-habit.pending .hx-hico{background:rgba(91,94,244,0.08);color:var(--accent);}
.hx-hinfo{flex:1;min-width:0;}
.hx-hname{font-size:13px;font-weight:700;color:var(--text);text-decoration:none;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:3px;}
.hx-hname:hover{color:var(--accent);}
.hx-habit.done .hx-hname{text-decoration:line-through;color:var(--muted);}
.hx-hmeta{display:flex;gap:9px;flex-wrap:wrap;}
.hx-hstreak{font-size:11px;color:var(--orange);font-weight:700;}
.hx-hrec{font-size:10px;color:var(--muted2);font-weight:600;}
.hx-progress-detail{display:flex;align-items:baseline;flex-wrap:wrap;gap:8px;margin-top:4px;}
.hx-time-live{font-family:'Syne',monospace;font-size:13px;font-weight:800;background:rgba(91,94,244,0.12);padding:3px 10px;border-radius:40px;color:var(--accent);letter-spacing:0.3px;}
.hx-percent-live{font-size:13px;font-weight:800;color:var(--green);}
.hx-goal-live{font-size:11px;font-weight:700;background:rgba(0,0,0,0.05);padding:3px 9px;border-radius:30px;color:var(--muted);}
.hx-fail-btn{background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:var(--red);border-radius:40px;padding:4px 12px;font-size:13px;font-weight:700;cursor:pointer;transition:0.2s;display:inline-flex;align-items:center;gap:4px;}
.hx-fail-btn:hover{background:var(--red);color:white;border-color:var(--red);}
.hx-hstatus{font-size:9px;font-weight:800;padding:3px 8px;border-radius:20px;white-space:nowrap;flex-shrink:0;}
.hx-habit.done .hx-hstatus{background:rgba(0,196,140,0.1);color:var(--green);border:1px solid rgba(0,196,140,0.2);}
.hx-habit.failed .hx-hstatus{background:rgba(239,68,68,0.08);color:var(--red);border:1px solid rgba(239,68,68,0.15);}
.hx-habit.pending .hx-hstatus{background:rgba(91,94,244,0.08);color:var(--accent);border:1px solid rgba(91,94,244,0.15);}
.hx-hacts{display:flex;gap:4px;flex-shrink:0;}
.hx-ha{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:12px;text-decoration:none;transition:0.15s;border:1px solid transparent;}
.hx-ha.ok{background:rgba(0,196,140,0.1);color:var(--green);border-color:rgba(0,196,140,0.2);}
.hx-ha.ok:hover{background:var(--green);color:white;}
.hx-ha.no{background:rgba(239,68,68,0.08);color:var(--red);border-color:rgba(239,68,68,0.15);}
.hx-ha.no:hover{background:var(--red);color:white;}
.hx-ha.ed{background:rgba(245,158,11,0.1);color:var(--gold);border-color:rgba(245,158,11,0.2);}
.hx-ha.ed:hover{background:var(--gold);color:white;}
.hx-ha.rm{background:rgba(100,116,139,0.07);color:var(--muted);border-color:rgba(100,116,139,0.12);}
.hx-ha.rm:hover{background:var(--red);color:white;border-color:var(--red);}
.hx-cwrap{padding:0 12px 10px;}
.hx-cform{display:flex;gap:7px;}
.hx-cinput{flex:1;padding:8px 13px;border-radius:20px;border:1.5px solid var(--border);background:var(--card2);font-size:12px;font-family:inherit;outline:none;color:var(--text);transition:0.2s;}
.hx-cinput:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(91,94,244,0.1);}
.hx-cinput::placeholder{color:var(--muted2);}
.hx-citem{font-size:11px;color:var(--muted);padding:3px 0;border-top:1px solid var(--border);margin-top:5px;}
.hx-empty{padding:50px 20px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px;}
.hx-eico{width:70px;height:70px;border-radius:22px;background:rgba(91,94,244,0.07);border:1px solid rgba(91,94,244,0.14);display:flex;align-items:center;justify-content:center;font-size:30px;animation:efloat 3s ease-in-out infinite;}
@@keyframes efloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-7px);}}
.hx-etitle{font-family:'Syne',sans-serif;font-size:17px;font-weight:800;color:var(--text);}
.hx-esub{font-size:12px;color:var(--muted);max-width:230px;line-height:1.6;}
.hx-limit{margin:0 12px 10px;padding:9px 13px;border-radius:11px;background:rgba(239,68,68,0.05);border:1px solid rgba(239,68,68,0.15);font-size:12px;color:#f87171;font-weight:600;display:flex;align-items:center;gap:7px;}
.hx-limit a{color:#fca5a5;font-weight:800;text-decoration:none;}
.hx-prog{background:var(--card);border-radius:var(--r1);border:1px solid var(--border);padding:18px;display:flex;flex-direction:column;gap:13px;}
.hx-ptitle{font-family:'Syne',sans-serif;font-size:13px;font-weight:800;color:var(--text);}
.hx-pitem{display:flex;flex-direction:column;gap:5px;}
.hx-plbl{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);font-weight:600;}
.hx-plbl span:last-child{font-weight:800;color:var(--text);}
.hx-pbar{height:5px;background:var(--border);border-radius:10px;overflow:hidden;}
.hx-pfill{height:100%;border-radius:10px;transition:width 1.4s cubic-bezier(0.4,0,0.2,1);}
.hx-pfill.g{background:linear-gradient(90deg,var(--green),#10b981);}
.hx-pfill.b{background:linear-gradient(90deg,var(--accent),#6366f1);}
.hx-pfill.o{background:linear-gradient(90deg,var(--orange),var(--gold));}
.hx-chart{background:var(--card);border-radius:var(--r1);border:1px solid var(--border);padding:18px;}
.hx-chtitle{font-family:'Syne',sans-serif;font-size:13px;font-weight:800;color:var(--text);margin-bottom:12px;}
.hx-chwrap{position:relative;height:150px;}
.hx-cal{background:var(--card);border-radius:var(--r1);border:1px solid var(--border);padding:18px;}
.hx-caltitle{font-family:'Syne',sans-serif;font-size:13px;font-weight:800;color:var(--text);margin-bottom:12px;}
.hx-calhd{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-bottom:4px;}
.hx-calhd span{text-align:center;font-size:8px;color:var(--muted2);font-weight:700;text-transform:uppercase;}
.hx-calgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;}
.hx-calday{aspect-ratio:1;border-radius:4px;}
.hx-calday.e{background:var(--border);}
.hx-calday.d{background:var(--green);box-shadow:0 0 6px rgba(0,196,140,0.3);}
.hx-calday.p{background:rgba(0,196,140,0.38);}
.hx-calday.f{background:rgba(239,68,68,0.28);}
.hx-tips{background:linear-gradient(135deg,#0d1a3a,#1a1060);border-radius:var(--r1);border:1px solid rgba(91,94,244,0.2);padding:18px;position:relative;overflow:hidden;}
.hx-tips::before{content:'';position:absolute;top:-20px;right:-20px;width:100px;height:100px;background:radial-gradient(circle,rgba(91,94,244,0.2),transparent);border-radius:50%;}
.hx-tipstitle{font-family:'Syne',sans-serif;font-size:13px;font-weight:800;color:white;margin-bottom:10px;position:relative;z-index:1;}
.hx-tip{display:flex;gap:8px;margin-bottom:9px;position:relative;z-index:1;}
.hx-tip:last-child{margin-bottom:0;}
.hx-tipico{font-size:13px;flex-shrink:0;margin-top:1px;}
.hx-tiptxt{font-size:11px;color:rgba(255,255,255,0.55);line-height:1.6;}
.hx-tiptxt strong{color:rgba(255,255,255,0.88);}
.hx-sv{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;}
.hx-svbg{position:absolute;inset:0;background:rgba(0,0,0,0.96);backdrop-filter:blur(20px);}
.hx-svcard{position:relative;width:100%;max-width:420px;height:100vh;max-height:820px;border-radius:24px;overflow:hidden;background:#000;z-index:1;box-shadow:0 40px 100px rgba(0,0,0,0.8);}
.hx-svbars{position:absolute;top:calc(12px + env(safe-area-inset-top,0px));left:10px;right:10px;display:flex;gap:3px;z-index:10;}
.hx-svbar{flex:1;height:3px;background:rgba(255,255,255,0.25);border-radius:10px;overflow:hidden;}
.hx-svbarfill{height:100%;background:white;width:0%;border-radius:10px;}
.hx-svhd{position:absolute;top:calc(24px + env(safe-area-inset-top,0px));left:10px;right:10px;display:flex;align-items:center;justify-content:space-between;z-index:10;}
.hx-svcontent{width:100%;height:100%;position:relative;}
.hx-svnavl{position:absolute;left:0;top:0;width:35%;height:88%;z-index:5;cursor:pointer;}
.hx-svnavr{position:absolute;right:0;top:0;width:35%;height:88%;z-index:5;cursor:pointer;}
@@keyframes heartPop{0%{transform:scale(0)rotate(-15deg);opacity:1;}35%{transform:scale(1.5)rotate(8deg);opacity:1;}65%{transform:scale(0.85)rotate(-4deg);opacity:1;}100%{transform:scale(1.15)rotate(0);opacity:0;}}

/* MODAL HÁBITO (nuevo diseño) */
.habit-modal {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    z-index: 999999; display: flex; align-items: center; justify-content: center;
    font-family: 'DM Sans', sans-serif;
}
.habit-modal-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.75); backdrop-filter: blur(12px);
    animation: fadeIn 0.2s ease;
}
.habit-modal-container {
    position: relative; background: linear-gradient(145deg, #ffffff, #f8fafc);
    width: 90%; max-width: 480px;
    border-radius: 32px;
    display: flex; flex-direction: column;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
    transform: scale(0.95);
    opacity: 0;
    animation: modalPop 0.3s cubic-bezier(0.34,1.2,0.64,1) forwards;
    border: 1px solid rgba(255,255,255,0.2);
}
@@keyframes modalPop {
    to { transform: scale(1); opacity: 1; }
}
body.bg-dark .habit-modal-container {
    background: linear-gradient(145deg, #1e293b, #0f172a);
    border-color: rgba(255,255,255,0.06);
}
.habit-modal-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    background: inherit;
}
body.bg-dark .habit-modal-header { border-bottom-color: rgba(255,255,255,0.05); }
.habit-modal-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800; font-size: 22px;
    background: linear-gradient(135deg, #6366f1, #10b981);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.habit-modal-close {
    background: rgba(0,0,0,0.05);
    border: none;
    font-size: 20px;
    cursor: pointer;
    width: 34px; height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.2s;
    color: #64748b;
}
.habit-modal-close:hover {
    background: rgba(239,68,68,0.1);
    color: #ef4444;
    transform: rotate(90deg);
}
.habit-modal-body {
    padding: 24px;
    background: inherit;
}
.habit-field { margin-bottom: 20px; }
.habit-label {
    display: block; font-size: 13px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.5px;
    color: #475569; margin-bottom: 8px;
}
body.bg-dark .habit-label { color: #94a3b8; }
.habit-input {
    width: 100%; padding: 14px 16px;
    border: 2px solid #e2e8f0;
    border-radius: 20px;
    font-size: 15px;
    outline: none;
    background: white;
    transition: 0.2s;
    font-family: inherit;
}
.habit-input:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
}
body.bg-dark .habit-input {
    background: #1e293b;
    border-color: #334155;
    color: #f1f5f9;
}
.habit-char-count {
    font-size: 12px;
    text-align: right;
    margin-top: 6px;
    color: #94a3b8;
}
.habit-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0 16px;
}
.habit-sugg {
    padding: 8px 16px;
    border-radius: 40px;
    border: 1.5px solid #e2e8f0;
    background: white;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: 0.15s;
}
.habit-sugg:hover {
    border-color: #6366f1;
    background: rgba(99,102,241,0.05);
    transform: scale(1.02);
}
body.bg-dark .habit-sugg {
    background: #1e293b;
    border-color: #334155;
    color: #cbd5e1;
}
body.bg-dark .habit-sugg:hover {
    background: rgba(99,102,241,0.15);
    border-color: #6366f1;
}
.habit-error {
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.2);
    border-radius: 16px;
    padding: 12px;
    color: #ef4444;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    margin-top: 10px;
}
.habit-modal-footer {
    padding: 18px 24px 24px;
    display: flex;
    gap: 12px;
    background: inherit;
    border-top: 1px solid rgba(0,0,0,0.03);
}
.habit-cancel {
    flex: 1;
    padding: 12px;
    border-radius: 40px;
    background: #f1f5f9;
    border: none;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s;
}
.habit-cancel:hover {
    background: #e2e8f0;
}
body.bg-dark .habit-cancel {
    background: #2d3748;
    color: white;
}
.habit-save {
    flex: 1;
    padding: 12px;
    border-radius: 40px;
    border: none;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    transition: 0.2s;
    box-shadow: 0 4px 14px rgba(99,102,241,0.4);
}
.habit-save:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(99,102,241,0.5);
}
body.bg-dark .habit-save {
    background: linear-gradient(135deg, #818cf8, #4f46e5);
}

/* DARK MODE */
body.bg-dark .hx-hcard,body.bg-dark .hx-prog,body.bg-dark .hx-chart,body.bg-dark .hx-cal,body.bg-dark .hx-stories,body.bg-dark .hx-quote{background:#0f172a!important;border-color:rgba(255,255,255,0.06)!important;}
body.bg-dark .hx-habit{background:#111827!important;border-color:rgba(255,255,255,0.05)!important;}
body.bg-dark .hx-kpi{background:#0f172a!important;border-color:rgba(255,255,255,0.06)!important;}
body.bg-dark .hx-cinput{background:#111827!important;border-color:rgba(255,255,255,0.08)!important;}
body.bg-dark .hx-sinner{border-color:#0f172a!important;}
body.bg-dark .hx-sring.seen{background:#334155!important;}
body.bg-dark .hx-calday.e{background:rgba(255,255,255,0.05)!important;}
body.bg-dark .hx-htab{color:#64748b!important;}
body.bg-dark .hx-htab.on{background:rgba(91,94,244,0.15)!important;color:#818cf8!important;}
body.bg-dark .hx-btn.ghost{background:#111827!important;border-color:rgba(255,255,255,0.1)!important;}

