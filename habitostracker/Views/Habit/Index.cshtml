        margin-bottom: 22px;
    }
    @@media (max-width: 768px) {
        .kpi-grid { 
            grid-template-columns: repeat(2, 1fr); 
        }
        .welcome-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
        .welcome-right {
            width: 100%;
            justify-content: space-between;
        }
        .welcome-stats {
            flex: 1;
            gap: 10px;
            padding: 10px 14px;
        }
        .ws-val { 
            font-size: 16px; 
        }
        .ws-label { 
            font-size: 9px; 
        }
        .welcome-weather {
            padding: 10px 12px;
        }
        .ww-temp { 
            font-size: 15px; 
        }
        .ww-icon { 
            font-size: 22px; 
        }
    }
    .kpi-card {
        background: white;
        border-radius: 18px;
        padding: 22px 16px;
        text-align: center;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.04);
        transition: 0.25s;
    }
    .kpi-card:hover { 
        transform: translateY(-3px); 
        box-shadow: 0 8px 24px rgba(0,0,0,0.1); 
