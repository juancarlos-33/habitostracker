</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
    history.pushState(null, null, location.href);
    window.onpopstate = function () { history.go(1); };
});
// ══ STORIES ══
const myUserId = @(int.Parse(User.FindFirst("UserId").Value));
let currentUserStories = [], currentStoryIndex = 0, storyProgressInterval = null;

async function loadFriendStories() {
    try {
        const res = await fetch('/Story/GetFriendsStories');
        const data = await res.json();
        const container = document.getElementById('friendStories');
        container.innerHTML = '';
        data.forEach(group => {
            const pic = group.user.profileImage || group.user.profilePicture || '';
            const item = document.createElement('div');
            item.className = 'story-item';
            item.onclick = () => openStoryViewer(group);
            const wrap = document.createElement('div');
            wrap.className = `story-avatar-wrap ${group.hasUnviewed ? '' : 'viewed'}`;
            wrap.innerHTML = pic
                ? `<img src="${pic}" class="story-avatar-img"/>`
                : `<div class="story-avatar-letter">${group.user.username.charAt(0).toUpperCase()}</div>`;
            const name = document.createElement('div');
            name.className = 'story-name';
            name.textContent = group.user.username;
            item.appendChild(wrap);
            item.appendChild(name);
            container.appendChild(item);
        });
    } catch(e) { console.error(e); }
}

function openStoryViewer(group) {
    currentUserStories = group.stories;
    currentStoryIndex = 0;
    document.getElementById('svAvatar').src = group.user.profileImage || group.user.profilePicture || '';
    document.getElementById('svUsername').textContent = group.user.username;
    document.getElementById('svDelete').style.display = group.user.id === myUserId ? 'block' : 'none';
    document.getElementById('storyViewer').style.display = 'flex';
    document.body.style.overflow = 'hidden';
    buildProgressBars();
    showStory(0);
}

function buildProgressBars() {
    const bars = document.getElementById('storyProgressBars');
    bars.innerHTML = '';
    currentUserStories.forEach((_, i) => {
        const bar = document.createElement('div');
        bar.className = 'story-progress-bar';
        bar.innerHTML = `<div class="story-progress-fill" id="progress-${i}"></div>`;
        bars.appendChild(bar);
    });
}

function showStory(index) {
    if (index >= currentUserStories.length) { closeStoryViewer(); return; }
    if (index < 0) { closeStoryViewer(); return; }
    currentStoryIndex = index;
    const story = currentUserStories[index];

    fetch('/Story/View', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(story.id)});

    document.getElementById('svImg').style.display = 'none';
    document.getElementById('svVideo').style.display = 'none';
    document.getElementById('svText').style.display = 'none';

    if (story.type === 'image') {
        const img = document.getElementById('svImg');
        img.src = story.mediaUrl; img.style.display = 'block';
    } else if (story.type === 'video') {
        const vid = document.getElementById('svVideo');
        vid.src = story.mediaUrl; vid.style.display = 'block'; vid.play();
    } else {
        const txt = document.getElementById('svText');
        txt.textContent = story.textContent;
        txt.style.background = story.bgColor || '#6366f1';
        txt.style.display = 'flex';
    }

 document.getElementById('svTime').textContent = getTimeAgo(new Date(story.createdAt + 'Z'));
    document.getElementById('svViews').textContent = `👁 ${story.views} vistas`;
    document.getElementById('svHighlight').textContent = story.isHighlight ? '★' : '☆';
    document.getElementById('svCaption').textContent = story.caption || '';

    currentUserStories.forEach((_, i) => {
        const fill = document.getElementById('progress-' + i);
        if (fill) fill.style.width = i < index ? '100%' : '0%';
    });
    startProgress(index, story.duration * 1000);
}

function startProgress(index, duration) {
    clearInterval(storyProgressInterval);
    const fill = document.getElementById('progress-' + index);
    if (!fill) return;
    let elapsed = 0;
    storyProgressInterval = setInterval(() => {
        elapsed += 50;
        fill.style.width = (elapsed / duration * 100) + '%';
        if (elapsed >= duration) { clearInterval(storyProgressInterval); showStory(currentStoryIndex + 1); }
    }, 50);
}

function nextStory() { clearInterval(storyProgressInterval); showStory(currentStoryIndex + 1); }
function prevStory() { clearInterval(storyProgressInterval); showStory(currentStoryIndex - 1); }

function closeStoryViewer() {
    clearInterval(storyProgressInterval);
    document.getElementById('storyViewer').style.display = 'none';
    document.body.style.overflow = '';
    const vid = document.getElementById('svVideo');
    vid.pause(); vid.src = '';
}

async function deleteCurrentStory() {
    if (!confirm('¿Eliminar esta historia?')) return;
    const story = currentUserStories[currentStoryIndex];
    await fetch('/Story/Delete', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(story.id)});
    currentUserStories.splice(currentStoryIndex, 1);
    if (!currentUserStories.length) { closeStoryViewer(); return; }
    buildProgressBars();
    showStory(Math.min(currentStoryIndex, currentUserStories.length - 1));
}

async function toggleHighlight() {
    const story = currentUserStories[currentStoryIndex];
    const res = await fetch('/Story/ToggleHighlight', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(story.id)});
    const data = await res.json();
    story.isHighlight = data.isHighlight;
    document.getElementById('svHighlight').textContent = data.isHighlight ? '★' : '☆';
}

function getTimeAgo(date) {
    const diff = Math.floor((Date.now() - date) / 60000);
    if (diff < 1) return 'ahora';
    if (diff < 60) return `hace ${diff} min`;
    if (diff < 1440) return `hace ${Math.floor(diff/60)}h`;
    return `hace ${Math.floor(diff/1440)}d`;
}

document.addEventListener('DOMContentLoaded', loadFriendStories);
</script>