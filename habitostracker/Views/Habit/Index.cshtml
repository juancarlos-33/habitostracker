    <div class="habit-modal-container">
        <div class="habit-modal-header">
            <div class="habit-modal-title" id="habitModalTitle">📝 Nuevo hábito</div>
            <button class="habit-modal-close" onclick="closeHabitModal()">✕</button>
        </div>
        <div class="habit-modal-body">
            <input type="hidden" id="editHabitId" value="0" />
            <div class="habit-field">
                <label class="habit-label">Nombre del hábito *</label>
                <input type="text" id="habitNameModal" class="habit-input" placeholder="Ej: Leer 30 minutos" maxlength="60" />
                <div class="habit-char-count"><span id="modalCharCount">0</span>/60</div>
            </div>
            <div class="habit-suggestions">
                <button type="button" class="habit-sugg" data-name="📚 Leer 30 min">📚 Leer 30 min</button>
                <button type="button" class="habit-sugg" data-name="🏃 Ejercicio">🏃 Ejercicio</button>
                <button type="button" class="habit-sugg" data-name="💧 Tomar agua">💧 Tomar agua</button>
                <button type="button" class="habit-sugg" data-name="🧘 Meditar">🧘 Meditar</button>
                <button type="button" class="habit-sugg" data-name="📝 Journaling">📝 Journaling</button>
                <button type="button" class="habit-sugg" data-name="🛌 Dormir 8h">🛌 Dormir 8h</button>
            </div>
            <div id="habitModalError" class="habit-error" style="display:none;">⚠️ El nombre es obligatorio</div>
        </div>
        <div class="habit-modal-footer">
            <button class="habit-cancel" onclick="closeHabitModal()">Cancelar</button>
            <button class="habit-save" id="saveHabitBtn">💾 Guardar</button>
        </div>
    </div>
</div>

<!-- STORIES -->
@if (!isGuest)
{
    <div class="hx-stories">
        <div class="hx-stories-inner" id="storiesBar">
          <div class="hx-si" onclick="openStoryUpload()">
    <div class="hx-sring mine">
        <div class="hx-sinner">
            @{ var myPic = User.FindFirst("ProfileImage")?.Value; var myUn = User.Identity?.Name ?? "Yo"; }
            @if (!string.IsNullOrEmpty(myPic)) { <img src="@myPic" /> }
            else { <div class="hx-sletter">@myUn.Substring(0,1).ToUpper()</div> }
        </div>
