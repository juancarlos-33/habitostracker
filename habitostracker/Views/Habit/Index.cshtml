@model List<HabitTrackerApp.Models.Habit>
@inject HabitTrackerApp.Data.HabitDbContext _context

@if (TempData["Error"] != null)
{
    <div class="ht-alert danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="ht-alert success">@TempData["Success"]</div>
}

@{
    var username = User.Identity?.Name ?? "";
    var user = _context.Users.FirstOrDefault(u => u.Username == username);
    var habits = Model;

    int totalHabits = habits.Count();
    int totalStreak = habits.Sum(h => h.StreakDays);
    int bestRecord = habits.Any() ? habits.Max(h => h.MaxStreak) : 0;
    int completedToday = habits.Count(h => h.LastCheckDate == DateTime.Today && h.Completed);
    int completionRate = totalHabits > 0 ? (int)((completedToday * 100.0) / totalHabits) : 0;

    string welcomeMsg = user?.Gender?.ToLower() == "femenino"
        ? $"Bienvenida, {user.Username} 👋"
        : $"Bienvenido, {user?.Username ?? username} 👋";

    string welcomeClass = user?.Gender?.ToLower() == "femenino" ? "welcome-female"
        : user?.Gender?.ToLower() == "masculino" ? "welcome-male" : "welcome-neutral";

    ViewData["Title"] = "HabitTracker Pro";

    var last7Days = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(-i)).Reverse().ToList();
    var habitIds = habits.Select(h => h.Id).ToList();
    var histories = _context.HabitHistories
        .Where(h => habitIds.Contains(h.HabitId) && h.Date >= DateTime.Today.AddDays(-6))
        .ToList();
    var dailyCompletion = last7Days.Select(date => {
        if (!habits.Any()) return 0;
        int c = histories.Count(h => h.Date.Date == date.Date && h.Completed);
        int f = histories.Count(h => h.Date.Date == date.Date && !h.Completed);
        int t = c + f;
        return t > 0 ? (int)((c * 100.0) / t) : 0;
    }).ToList();
    bool isGuest = user?.Role == "Guest";
}

<!-- ══ HERO ══ -->
<div class="hero-section @welcomeClass">
    <div class="hero-bg-dots"></div>
    <div class="hero-top">
        <div class="hero-user">
            <div class="hero-avatar">
                @{ var profileImage = User.FindFirst("ProfileImage")?.Value; }
                @if (!string.IsNullOrEmpty(profileImage))
                { <img src="@profileImage" alt="avatar" /> }
                else
                { <span>@(username.Length > 0 ? username.Substring(0,1).ToUpper() : "?")</span> }
            </div>
            <div>
                <div class="hero-greeting">@welcomeMsg</div>
                <div class="hero-sub">Disciplina diaria · Resultados reales</div>
            </div>
        </div>
        @if (user != null)
        {
            if (!user.IsPremium)
            { <a href="/User/Pay" class="hero-plan-pill free">⚡ Hazte premium</a> }
            else
            { <div class="hero-plan-pill premium">👑 Pro</div> }
        }
    </div>
    <div class="hero-stats-row">
        <div class="hero-stat"><div class="hero-stat-val">@completedToday</div><div class="hero-stat-label">Hoy</div></div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat"><div class="hero-stat-val">@totalStreak🔥</div><div class="hero-stat-label">Racha</div></div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat"><div class="hero-stat-val">@completionRate%</div><div class="hero-stat-label">Completado</div></div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat"><div class="hero-stat-val">@bestRecord🏆</div><div class="hero-stat-label">Récord</div></div>
        <div class="hero-weather-inline" id="weatherInline" style="display:none;">
            <div class="hero-stat-sep"></div>
            <div class="hero-stat">
                <div class="hero-stat-val"><span id="wIcon">⛅</span><span id="wTemp">--</span></div>
                <div class="hero-stat-label" id="wCity">--</div>
            </div>
        </div>
    </div>
</div>

<!-- ══ HISTORIAS ══ -->
@if (!isGuest)
{
<div class="stories-bar" id="storiesBar">
    <div class="story-item" onclick="window.location.href='/Story/Create'">
        <div class="story-avatar-wrap my-story">
            @{ var myPic = User.FindFirst("ProfileImage")?.Value; var myUsername = User.Identity?.Name ?? "Yo"; }
            @if (!string.IsNullOrEmpty(myPic))
            { <img src="@myPic" class="story-avatar-img"/> }
            else
            { <div class="story-avatar-letter">@myUsername.Substring(0,1).ToUpper()</div> }
            <div class="story-add-btn">+</div>
        </div>
        <div class="story-name">Tu historia</div>
    </div>
    <div id="friendStories" style="display:contents;"></div>
</div>
}
else
{
<div class="guest-stories-banner">
    <div style="font-size:28px;">📖</div>
    <div style="flex:1;min-width:0;">
        <div style="font-size:14px;font-weight:700;color:white;margin-bottom:2px;">Historias para miembros</div>
        <div style="font-size:12px;color:rgba(255,255,255,0.4);">Crea una cuenta para ver y publicar historias</div>
    </div>
    <a href="/Account/UpgradeAccount" class="guest-stories-cta">Crear cuenta</a>
</div>
}

<!-- ══ VISOR DE HISTORIAS ══ -->
<div id="storyViewer" class="story-viewer" style="display:none;">
    <div class="story-viewer-bg" onclick="closeStoryViewer()"></div>
    <div class="story-viewer-card">
        <div class="story-progress-bars" id="storyProgressBars"></div>
        <div class="story-viewer-header">
            <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;">
                <div style="position:relative;cursor:pointer;flex-shrink:0;" onclick="goToProfile()">
                    <img id="svAvatar" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid white;display:block;" onerror="this.style.display='none';document.getElementById('svAvatarLetter').style.display='flex';"/>
                    <div id="svAvatarLetter" style="display:none;width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;align-items:center;justify-content:center;font-weight:800;font-size:16px;border:2px solid white;flex-shrink:0;"></div>
                </div>
                <div style="min-width:0;flex:1;">
                    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                        <div id="svUsername" style="font-size:13px;font-weight:700;color:white;cursor:pointer;" onclick="goToProfile()"></div>
                        <div id="svVisibilityBadge" style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;display:none;backdrop-filter:blur(4px);"></div>
                    </div>
                    <div id="svTime" style="font-size:11px;color:rgba(255,255,255,0.5);margin-top:1px;"></div>
                </div>
            </div>
            <div style="display:flex;gap:4px;align-items:center;flex-shrink:0;">
                <button id="svHighlight" onclick="toggleHighlight()" data-no-loader style="background:rgba(255,255,255,0.1);border:none;color:white;font-size:18px;cursor:pointer;padding:6px 8px;border-radius:10px;backdrop-filter:blur(4px);">☆</button>
                <button id="svDelete" onclick="deleteCurrentStory()" data-no-loader style="display:none;background:rgba(239,68,68,0.2);border:none;color:white;font-size:16px;cursor:pointer;padding:6px 8px;border-radius:10px;">🗑</button>
                <button onclick="closeStoryViewer()" data-no-loader style="background:rgba(255,255,255,0.1);border:none;color:white;font-size:18px;cursor:pointer;padding:6px 8px;border-radius:10px;">✕</button>
            </div>
        </div>
        <div class="story-viewer-content">
            <img id="svImg" style="display:none;width:100%;height:100%;object-fit:cover;background:#000;"/>
            <video id="svVideo" style="display:none;width:100%;height:100%;object-fit:contain;background:#000;" playsinline controls></video>
            <div id="svText" style="display:none;width:100%;height:100%;align-items:center;justify-content:center;padding:40px;text-align:center;font-size:24px;font-weight:800;color:white;line-height:1.5;word-break:break-word;"></div>
        </div>
        <div class="story-nav-left" onclick="prevStory()"></div>
        <div class="story-nav-right" onclick="nextStory()"></div>
        <div id="svCaption" style="position:absolute;bottom:80px;left:16px;right:16px;z-index:10;font-size:13px;color:white;font-weight:600;text-shadow:0 2px 8px rgba(0,0,0,0.8);text-align:center;pointer-events:none;"></div>
        <div style="position:absolute;bottom:0;left:0;right:0;z-index:10;padding:14px 16px 24px;background:linear-gradient(transparent,rgba(0,0,0,0.8));display:flex;align-items:center;gap:10px;">
            <button id="svLikeBtn" onclick="toggleStoryLike()" data-no-loader style="background:none;border:none;color:white;font-size:32px;cursor:pointer;padding:0;transition:transform 0.2s;flex-shrink:0;line-height:1;">🤍</button>
            <span id="svLikesCount" style="font-size:13px;color:rgba(255,255,255,0.85);font-weight:700;min-width:20px;"></span>
            <div id="svViewsBar" style="display:none;cursor:pointer;flex:1;text-align:center;" onclick="openStoryViews()">
                <span id="svViews" style="font-size:12px;color:rgba(255,255,255,0.85);font-weight:600;background:rgba(0,0,0,0.4);padding:5px 14px;border-radius:20px;backdrop-filter:blur(8px);">👁 0 vistas</span>
            </div>
        </div>
        <div id="svHeartAnim" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:20;opacity:0;">
            <span id="svHeartAnimIcon" style="font-size:100px;filter:drop-shadow(0 0 40px rgba(239,68,68,1));">❤️</span>
        </div>
        <div id="storyViewsModal" style="display:none;position:absolute;bottom:75px;left:12px;right:12px;background:rgba(8,12,24,0.98);border-radius:20px;padding:16px;z-index:30;max-height:260px;overflow-y:auto;backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.07);box-shadow:0 24px 64px rgba(0,0,0,0.7);">
            <div style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.3);margin-bottom:12px;text-transform:uppercase;letter-spacing:1px;">👁 Visto por</div>
            <div id="storyViewsList"></div>
        </div>
    </div>
</div>

<!-- ══ QUOTE ══ -->
<div class="quote-pill">
    <span class="quote-star">✨</span>
    <p class="quote-text" id="quoteText"></p>
</div>

<!-- ══ QUICK ACTIONS ══ -->
<div class="quick-actions">
    @if (user != null && (user.IsPremium || Model.Count < 5))
    { <a href="/Habit/Create" class="qa-btn primary">➕ Nuevo hábito</a> }
    else
    { <a href="/User/Pay" class="qa-btn locked">🔒 Premium</a> }
    <a href="/Habit/History" class="qa-btn secondary">📅 Historial</a>
    <a href="/Habit/Statistics" class="qa-btn secondary">📈 Stats</a>
</div>

<!-- ══ KPI GRID ══ -->
<div class="kpi-row">
    <a href="/Habit/Index" class="kpi-card">
        <div class="kpi-icon-wrap blue"><span>📋</span></div>
        <div class="kpi-info"><div class="kpi-val">@totalHabits</div><div class="kpi-lbl">Hábitos</div></div>
    </a>
    <a href="/Habit/Statistics" class="kpi-card">
        <div class="kpi-icon-wrap green"><span>🔥</span></div>
        <div class="kpi-info"><div class="kpi-val green">@totalStreak</div><div class="kpi-lbl">Racha</div></div>
    </a>
    <a href="/Habit/Calendar" class="kpi-card">
        <div class="kpi-icon-wrap purple"><span>⚡</span></div>
        <div class="kpi-info"><div class="kpi-val purple">@completionRate%</div><div class="kpi-lbl">Hoy</div></div>
    </a>
    <a href="/Habit/Achievements" class="kpi-card">
        <div class="kpi-icon-wrap gold"><span>🏆</span></div>
        <div class="kpi-info"><div class="kpi-val gold">@bestRecord</div><div class="kpi-lbl">Récord</div></div>
    </a>
</div>

<!-- ══ HÁBITOS ══ -->
<div class="habits-section">
    <div class="section-header">
        <div class="section-title">Mis hábitos</div>
        @if (user != null && (user.IsPremium || Model.Count < 5))
        { <a href="/Habit/Create" class="section-add">+ Nuevo</a> }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-habits">
            <div class="empty-emoji">🌱</div>
            <div class="empty-title">Empieza tu primer hábito</div>
            <div class="empty-sub">Pequeños pasos generan grandes cambios</div>
            <a href="/Habit/Create" class="qa-btn primary" style="margin-top:16px;display:inline-flex;">➕ Crear hábito</a>
        </div>
    }
    else
    {
        @if (user != null && !user.IsPremium && Model.Count >= 5)
        { <div class="limit-pill">🚫 Límite alcanzado · <a href="/User/Pay">Hazte Premium 🔥</a></div> }

        <div class="habits-cards-mobile">
            @foreach (var habit in Model)
            {
                bool done = habit.LastCheckDate == DateTime.Today && habit.Completed;
                bool failed = habit.LastCheckDate == DateTime.Today && !habit.Completed;
                string statusClass = done ? "done" : failed ? "failed" : "pending";
                string statusLabel = done ? "✔ Completado" : failed ? "✖ Fallado" : "⏳ Pendiente";
                <div class="habit-card @statusClass">
                    <div class="habit-card-top">
                        <div class="habit-card-info">
                            <a href="/Habit/Detail/@habit.Id" class="habit-card-name">@habit.Name</a>
                            <div class="habit-card-meta">
                                <span class="habit-streak">🔥 @habit.StreakDays días</span>
                                <span class="habit-record">🏆 @habit.MaxStreak máx</span>
                            </div>
                        </div>
                        <span class="habit-status-badge @statusClass">@statusLabel</span>
                    </div>
                    <div class="habit-card-actions">
                        <a href="/Habit/Complete/@habit.Id" class="hca-btn complete">✔ Hecho</a>
                        <a href="/Habit/Fail/@habit.Id" class="hca-btn fail">✖ Fallar</a>
                        <a href="/Habit/Edit/@habit.Id" class="hca-btn edit">✏</a>
                        <a href="/Habit/Delete/@habit.Id" class="hca-btn delete" data-no-loader="true" onclick="if(!confirm('¿Eliminar?')) return false;">🗑</a>
                    </div>
                    <div class="habit-comment-area">
                        <form asp-action="AddComment" method="post" class="habit-comment-form">
                            <input type="hidden" name="habitId" value="@habit.Id" />
                            <input type="text" name="content" class="habit-comment-input" placeholder="💬 Comentario..." />
                        </form>
                        @if (habit.Comments != null && habit.Comments.Any())
                        {
                            foreach (var c in habit.Comments.OrderByDescending(x => x.CreatedAt).Take(2))
                            { <div class="habit-comment-item"><b>@c.User.Username</b> @c.Content</div> }
                        }
                    </div>
                </div>
            }
        </div>

        <div class="habits-table-wrap">
            @if (user != null && !user.IsPremium && Model.Count >= 5)
            { <div class="limit-pill">🚫 Límite alcanzado · <a href="/User/Pay">Hazte Premium 🔥</a></div> }
            <table class="habits-table">
                <thead>
                    <tr><th>HÁBITO</th><th>ESTADO</th><th>RACHA</th><th>RÉCORD</th><th>CREADO</th><th class="text-center">ACCIONES</th></tr>
                </thead>
                <tbody>
                    @foreach (var habit in Model)
                    {
                        <tr>
                            <td class="habit-name">
                                <a href="/Habit/Detail/@habit.Id" style="color:inherit;text-decoration:none;font-weight:600;display:flex;align-items:center;gap:6px;">
                                    @habit.Name
                                    <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:rgba(99,102,241,0.1);color:#6366f1;font-weight:700;">Ver →</span>
                                </a>
                            </td>
                            <td>
                                @if (habit.LastCheckDate == DateTime.Today && habit.Completed)
                                { <span class="status-badge success">✔ Completado</span> }
                                else if (habit.LastCheckDate == DateTime.Today && !habit.Completed)
                                { <span class="status-badge danger">✖ Fallado</span> }
                                else
                                { <span class="status-badge pending">⏳ Pendiente</span> }
                            </td>
                            <td class="streak-val">@habit.StreakDays 🔥</td>
                            <td class="record-val">@habit.MaxStreak 🏆</td>
                            <td class="date-val">@habit.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <div class="action-btns">
                                    <a href="/Habit/Complete/@habit.Id" class="hab-btn complete">✔</a>
                                    <a href="/Habit/Fail/@habit.Id" class="hab-btn fail">✖</a>
                                    <a asp-action="Edit" asp-route-id="@habit.Id" class="hab-btn edit">✏</a>
                                    <a asp-action="Delete" asp-route-id="@habit.Id" class="hab-btn delete" data-no-loader="true" onclick="if(!confirm('¿Eliminar?')) return false;">🗑</a>
                                </div>
                            </td>
                        </tr>
                        <tr class="comment-row">
                            <td colspan="6">
                                <form asp-action="AddComment" method="post" class="comment-form">
                                    <input type="hidden" name="habitId" value="@habit.Id" />
                                    <input type="text" name="content" class="comment-input" placeholder="💬 Comentario..." />
                                </form>
                                @if (habit.Comments != null && habit.Comments.Any())
                                {
                                    foreach (var c in habit.Comments.OrderByDescending(x => x.CreatedAt))
                                    { <div class="comment-item"><b>@c.User.Username:</b> @c.Content</div> }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ══ CHART ══ -->
<div class="chart-section">
    <div class="section-header"><div class="section-title">📈 Progreso últimos 7 días</div></div>
    <div class="chart-wrap"><canvas id="habitChart"></canvas></div>
</div>

@section Scripts {
<script>
const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(last7Days.Select(d => d.ToString("dd/MM"))));
const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dailyCompletion));
const isDark = document.body.classList.contains('bg-dark');
const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.04)';
const textColor = isDark ? '#64748b' : '#9ca3af';

new Chart(document.getElementById('habitChart'), {
    type: 'line',
    data: { labels, datasets: [{ data, borderWidth:3, tension:0.4, fill:true, pointRadius:5, pointHoverRadius:7, pointBackgroundColor:'#6366f1', backgroundColor:'rgba(99,102,241,0.1)', borderColor:'#6366f1' }] },
    options: { responsive:true, plugins:{ legend:{display:false}, tooltip:{callbacks:{label:ctx=>ctx.parsed.y+'% completado'}} }, scales:{ y:{beginAtZero:true,max:100,ticks:{color:textColor,callback:v=>v+'%'},grid:{color:gridColor}}, x:{ticks:{color:textColor},grid:{color:gridColor}} } }
});

document.querySelectorAll('.hab-btn.complete, .hca-btn.complete').forEach(btn => {
    btn.addEventListener('click', function(e) {
        e.preventDefault();
        const href = this.getAttribute('href');
        HabitSounds.complete();
        setTimeout(() => window.location.href = href, 350);
    });
});

const frases = ["La disciplina es el puente entre metas y logros. 🚀","Cada día es una nueva oportunidad para mejorar. 💪","Los pequeños hábitos crean grandes cambios. 🌱","El éxito no es un destino, es un hábito diario. 🏆","No necesitas ser perfecto, solo consistente. 🔥","Un hábito a la vez. Un día a la vez. ⚡","La constancia vence al talento cuando el talento no es constante. 🎯","Tu futuro depende de lo que hagas hoy. 💡","La motivación te arranca, el hábito te mantiene. 🛤️","El dolor de la disciplina es menor que el dolor del arrepentimiento. 💎","Sé la mejor versión de ti mismo, cada día. 🌟","No cuentes los días, haz que los días cuenten. ⏳","Cae siete veces, levántate ocho. 🥊","El éxito es la suma de pequeños esfuerzos repetidos cada día. 📈","La única forma de hacer un gran trabajo es amar lo que haces. ❤️","Primero forma el hábito, luego el hábito te forma a ti. 🔄","El progreso, no la perfección, es el objetivo. 📊","Los hábitos son el interés compuesto del auto-mejoramiento. 📉","La excelencia no es un acto, es un hábito. 👌","Comienza donde estás, usa lo que tienes, haz lo que puedas. 🛠️"];
let fi = Math.floor(Math.random() * frases.length);
const qt = document.getElementById("quoteText");
qt.textContent = frases[fi];
setTimeout(() => { qt.style.opacity="1"; qt.style.transform="translateY(0)"; }, 100);
setInterval(() => {
    qt.style.opacity="0"; qt.style.transform="translateY(6px)";
    setTimeout(() => { fi=(fi+1)%frases.length; qt.textContent=frases[fi]; qt.style.opacity="1"; qt.style.transform="translateY(0)"; }, 500);
}, 4000);

if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
        const {latitude:lat,longitude:lon} = pos.coords;
        fetch('https://api.open-meteo.com/v1/forecast?latitude='+lat+'&longitude='+lon+'&current_weather=true&timezone=auto')
            .then(r=>r.json()).then(d=>{
                const icons={200:"⛈️",300:"🌦️",500:"🌧️",600:"❄️",700:"🌫️",800:"☀️",801:"🌤️"};
                const code=d.current_weather.weathercode;
                const icon=code>=802?"⛅":icons[Object.keys(icons).reverse().find(k=>code>=k)]||"🌡️";
                document.getElementById("wIcon").textContent=icon;
                document.getElementById("wTemp").textContent=Math.round(d.current_weather.temperature)+"°";
                document.getElementById("weatherInline").style.display="flex";
                fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lon,{headers:{"Accept-Language":"es"}})
                    .then(r=>r.json()).then(g=>{document.getElementById("wCity").textContent=g.address?.city||g.address?.town||g.address?.village||"📍";}).catch(()=>{});
            }).catch(()=>{});
    },()=>{},{timeout:6000});
}
</script>
}

<style>
/* ══ ALERTS ══ */
.ht-alert{padding:12px 18px;border-radius:14px;margin-bottom:16px;font-size:14px;font-weight:600;}
.ht-alert.danger{background:rgba(239,68,68,0.1);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);}
.ht-alert.success{background:rgba(34,197,94,0.1);color:#86efac;border:1px solid rgba(34,197,94,0.2);}

/* ══ HERO ══ */
.hero-section{border-radius:24px;padding:24px 22px 20px;margin-bottom:16px;position:relative;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3);}
.hero-bg-dots{position:absolute;inset:0;opacity:0.05;background-image:radial-gradient(circle,white 1px,transparent 1px);background-size:22px 22px;pointer-events:none;}
.welcome-male{background:linear-gradient(135deg,#1e3a8a,#1d4ed8,#2563eb,#3b82f6);}
.welcome-female{background:linear-gradient(135deg,#831843,#9d174d,#ec4899,#f472b6);}
.welcome-neutral{background:linear-gradient(135deg,#312e81,#4338ca,#6366f1,#818cf8);}
.hero-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;gap:10px;}
.hero-user{display:flex;align-items:center;gap:12px;flex:1;min-width:0;}
.hero-avatar{width:50px;height:50px;border-radius:50%;flex-shrink:0;background:rgba(255,255,255,0.2);border:2.5px solid rgba(255,255,255,0.35);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;color:white;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.25);}
.hero-avatar img{width:100%;height:100%;object-fit:cover;}
.hero-greeting{font-size:16px;font-weight:800;color:white;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.hero-sub{font-size:11px;color:rgba(255,255,255,0.55);margin-top:2px;font-weight:500;}
.hero-plan-pill{flex-shrink:0;padding:7px 16px;border-radius:20px;font-size:12px;font-weight:800;text-decoration:none;white-space:nowrap;transition:0.2s;}
.hero-plan-pill.free {
    background: linear-gradient(135deg,#6366f1,#4f46e5);
    color: white;
    border: none;
    box-shadow: 0 4px 14px rgba(99,102,241,0.45);
}
.hero-plan-pill.free:hover { transform:translateY(-1px); box-shadow:0 6px 20px rgba(99,102,241,0.6); color:white; }
.hero-plan-pill.free:hover{background:rgba(255,255,255,0.25);color:white;transform:translateY(-1px);}
.hero-plan-pill.premium{background:linear-gradient(135deg,rgba(234,179,8,0.3),rgba(251,191,36,0.2));color:#fde68a;border:1px solid rgba(234,179,8,0.4);}
.hero-stats-row{display:flex;align-items:center;background:rgba(0,0,0,0.2);border-radius:18px;padding:14px 16px;backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.07);}
.hero-stat{flex:1;text-align:center;}
.hero-stat-val{font-size:18px;font-weight:800;color:white;line-height:1;}
.hero-stat-label{font-size:9px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.8px;margin-top:4px;font-weight:700;}
.hero-stat-sep{width:1px;height:30px;background:rgba(255,255,255,0.12);flex-shrink:0;}
.hero-weather-inline{display:flex;align-items:center;}

/* ══ GUEST STORIES BANNER ══ */
.guest-stories-banner{background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid rgba(99,102,241,0.15);border-radius:18px;padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:14px;}
.guest-stories-cta{padding:8px 18px;border-radius:12px;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;flex-shrink:0;transition:0.2s;box-shadow:0 4px 12px rgba(99,102,241,0.3);}
.guest-stories-cta:hover{transform:translateY(-1px);color:white;}

/* ══ STORIES BAR ══ */
.stories-bar{display:flex;gap:14px;overflow-x:auto;padding:4px 2px 16px;scrollbar-width:none;-webkit-overflow-scrolling:touch;margin-bottom:8px;}
.stories-bar::-webkit-scrollbar{display:none;}
.story-item{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;flex-shrink:0;width:74px;}
.story-avatar-wrap{width:66px;height:66px;border-radius:50%;position:relative;padding:3px;background:linear-gradient(135deg,#f97316,#ec4899,#6366f1);}
.story-avatar-wrap.my-story{background:linear-gradient(135deg,#6366f1,#4f46e5);}
.story-avatar-wrap.viewed{background:#475569;}
.story-avatar-img{width:100%;height:100%;border-radius:50%;object-fit:cover;border:2.5px solid #0f172a;}
.story-avatar-letter{width:100%;height:100%;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c3aed);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:22px;border:2.5px solid #0f172a;}
.story-add-btn{position:absolute;bottom:0;right:0;width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;font-size:14px;font-weight:800;display:flex;align-items:center;justify-content:center;border:2px solid #0f172a;line-height:1;box-shadow:0 2px 8px rgba(0,0,0,0.5);}
.story-name{font-size:11px;font-weight:600;color:#374151;max-width:74px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
body.bg-dark .story-name{color:#94a3b8!important;}
body.bg-dark .story-avatar-wrap.viewed{background:#334155!important;}
body.bg-dark .story-avatar-img,.story-avatar-letter{border-color:#0f172a!important;}

/* ══ STORY VIEWER ══ */
.story-viewer{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;}
.story-viewer-bg{position:absolute;inset:0;background:rgba(0,0,0,0.96);}
.story-viewer-card{position:relative;width:100%;max-width:420px;height:100vh;max-height:800px;border-radius:24px;overflow:hidden;background:#000;z-index:1;box-shadow:0 40px 100px rgba(0,0,0,0.9);}
.story-progress-bars{position:absolute;top:calc(12px + env(safe-area-inset-top,0px));left:10px;right:10px;display:flex;gap:3px;z-index:10;}
.story-progress-bar{flex:1;height:3px;background:rgba(255,255,255,0.2);border-radius:10px;overflow:hidden;}
.story-progress-fill{height:100%;background:white;width:0%;border-radius:10px;transition:none;}
.story-viewer-header{position:absolute;top:calc(24px + env(safe-area-inset-top,0px));left:10px;right:10px;display:flex;align-items:center;justify-content:space-between;z-index:10;}
.story-viewer-content{width:100%;height:100%;position:relative;}
.story-nav-left{position:absolute;left:0;top:0;width:35%;height:88%;z-index:5;cursor:pointer;}
.story-nav-right{position:absolute;right:0;top:0;width:35%;height:88%;z-index:5;cursor:pointer;}
@@keyframes heartPop{0%{transform:scale(0) rotate(-15deg);opacity:1;}35%{transform:scale(1.5) rotate(8deg);opacity:1;}65%{transform:scale(0.85) rotate(-4deg);opacity:1;}100%{transform:scale(1.15) rotate(0);opacity:0;}}
#svLikeBtn{transition:transform 0.15s;}
#svLikeBtn:active{transform:scale(0.8);}

/* ══ QUOTE ══ */
.quote-pill{display:flex;align-items:center;gap:12px;background:linear-gradient(135deg,#0f172a,#1e293b);border:1px solid rgba(99,102,241,0.15);border-radius:18px;padding:14px 20px;margin-bottom:16px;min-height:52px;}
.quote-star{font-size:16px;flex-shrink:0;}
.quote-text{color:rgba(255,255,255,0.8);font-size:13px;font-weight:500;margin:0;opacity:0;transform:translateY(6px);transition:opacity 0.5s,transform 0.5s;line-height:1.6;font-style:italic;}

/* ══ QUICK ACTIONS ══ */
.quick-actions{display:flex;gap:8px;margin-bottom:16px;overflow-x:auto;scrollbar-width:none;}
.quick-actions::-webkit-scrollbar{display:none;}
.qa-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:24px;font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap;transition:0.2s;flex-shrink:0;font-family:inherit;border:none;cursor:pointer;}
.qa-btn.primary{background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;box-shadow:0 4px 16px rgba(99,102,241,0.35);}
.qa-btn.primary:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(99,102,241,0.5);color:white;}
.qa-btn.secondary{background:white;color:#374151;border:1.5px solid #e5e7eb;}
.qa-btn.secondary:hover{background:#f9fafb;color:#111827;}
.qa-btn.locked{background:#1e293b;color:#64748b;border:1.5px solid #334155;}
body.bg-dark .qa-btn.secondary{background:#1e293b!important;color:#94a3b8!important;border-color:#334155!important;}

/* ══ KPI ROW ══ */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px;}
.kpi-card{background:white;border-radius:18px;padding:14px 12px;display:flex;align-items:center;gap:10px;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);transition:0.2s;text-decoration:none;color:inherit;}
.kpi-card:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(0,0,0,0.12);color:inherit;}
.kpi-icon-wrap{width:38px;height:38px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:18px;}
.kpi-icon-wrap.blue{background:rgba(37,99,235,0.1);}
.kpi-icon-wrap.green{background:rgba(22,163,74,0.1);}
.kpi-icon-wrap.purple{background:rgba(99,102,241,0.1);}
.kpi-icon-wrap.gold{background:rgba(217,119,6,0.1);}
.kpi-val{font-size:20px;font-weight:800;color:#111827;line-height:1;}
.kpi-val.green{color:#16a34a;}
.kpi-val.purple{color:#6366f1;}
.kpi-val.gold{color:#d97706;}
.kpi-lbl{font-size:10px;color:#9ca3af;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-top:2px;}
body.bg-dark .kpi-card{background:#1e293b!important;border-color:#2d3748!important;}
body.bg-dark .kpi-val{color:#f1f5f9!important;}
body.bg-dark .kpi-lbl{color:#64748b!important;}

/* ══ SECTION ══ */
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
.section-title{font-size:15px;font-weight:800;color:#111827;}
.section-add{font-size:13px;font-weight:700;color:#6366f1;text-decoration:none;padding:5px 14px;background:rgba(99,102,241,0.08);border-radius:20px;transition:0.2s;}
.section-add:hover{background:rgba(99,102,241,0.15);}
body.bg-dark .section-title{color:#f1f5f9!important;}
body.bg-dark .section-add{background:rgba(99,102,241,0.12)!important;}

/* ══ EMPTY ══ */
.empty-habits{text-align:center;padding:56px 20px;background:white;border-radius:22px;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);}
.empty-emoji{font-size:54px;margin-bottom:14px;}
.empty-title{font-size:18px;font-weight:800;color:#111827;margin-bottom:6px;}
.empty-sub{font-size:13px;color:#9ca3af;line-height:1.6;}
body.bg-dark .empty-habits{background:#1e293b!important;border-color:#2d3748!important;}
body.bg-dark .empty-title{color:#f1f5f9!important;}

/* ══ LIMIT ══ */
.limit-pill{background:rgba(239,68,68,0.1);color:#fca5a5;border:1px solid rgba(239,68,68,0.2);padding:10px 16px;border-radius:12px;margin-bottom:12px;font-size:13px;font-weight:600;}
.limit-pill a{color:#fca5a5;font-weight:800;}

/* ══ HABIT CARDS MÓVIL ══ */
