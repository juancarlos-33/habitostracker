@model List<HabitTrackerApp.Models.Habit>
@inject HabitTrackerApp.Data.HabitDbContext _context

@if (TempData["Error"] != null)
{ <div class="ht-alert danger">@TempData["Error"]</div> }
@if (TempData["Success"] != null)
{ <div class="ht-alert success">@TempData["Success"]</div> }

@{
    var username = User.Identity?.Name ?? "";
    var user = _context.Users.FirstOrDefault(u => u.Username == username);
    var habits = Model;
    int totalHabits = habits.Count();
    int totalStreak = habits.Sum(h => h.StreakDays);
    int bestRecord = habits.Any() ? habits.Max(h => h.MaxStreak) : 0;
    int completedToday = habits.Count(h => h.LastCheckDate == DateTime.Today && h.Completed);
    int completionRate = totalHabits > 0 ? (int)((completedToday * 100.0) / totalHabits) : 0;
    string welcomeMsg = user?.Gender?.ToLower() == "femenino"
        ? $"Hola, {user.Username} ✨" : $"Hola, {user?.Username ?? username} 👋";
    ViewData["Title"] = "HabitTracker Pro";
    var last7Days = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(-i)).Reverse().ToList();
    var habitIds = habits.Select(h => h.Id).ToList();
    var histories = _context.HabitHistories
        .Where(h => habitIds.Contains(h.HabitId) && h.Date >= DateTime.Today.AddDays(-6)).ToList();
    var dailyCompletion = last7Days.Select(date => {
        if (!habits.Any()) return 0;
        int c = histories.Count(h => h.Date.Date == date.Date && h.Completed);
        int f = histories.Count(h => h.Date.Date == date.Date && !h.Completed);
        int t = c + f;
        return t > 0 ? (int)((c * 100.0) / t) : 0;
    }).ToList();
    bool isGuest = user?.Role == "Guest";
    var pendingHabits = habits.Where(h => h.LastCheckDate != DateTime.Today).ToList();
    var completedHabits = habits.Where(h => h.LastCheckDate == DateTime.Today && h.Completed).ToList();
}

<link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Cabinet+Grotesk:wght@400;500;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --ink: #060a12;
    --surface: #f0f2f8;
    --card: #ffffff;
    --card2: #f8faff;
    --border: rgba(0,0,0,0.07);
    --border2: rgba(0,0,0,0.12);
    --accent: #5b5ef4;
    --accent2: #3730d9;
    --accent-glow: rgba(91,94,244,0.3);
    --green: #00c48c;
    --orange: #ff7043;
    --gold: #f59e0b;
    --text: #0f172a;
    --muted: #64748b;
    --muted2: #94a3b8;
    --radius: 22px;
    --radius2: 16px;
}

body.bg-dark {
    --ink: #f1f5f9;
    --surface: #080c18;
    --card: #0f172a;
    --card2: #111827;
    --border: rgba(255,255,255,0.06);
    --border2: rgba(255,255,255,0.1);
    --text: #f1f5f9;
    --muted: #64748b;
    --muted2: #475569;
}

/* ── ALERTS ── */
.ht-alert { padding: 13px 18px; border-radius: 14px; margin-bottom: 16px; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; font-family: 'DM Sans', sans-serif; }
.ht-alert.danger { background: rgba(239,68,68,0.08); color: #ef4444; border: 1px solid rgba(239,68,68,0.2); }
.ht-alert.success { background: rgba(0,196,140,0.08); color: var(--green); border: 1px solid rgba(0,196,140,0.2); }

/* ── MAIN PAGE ── */
.ht-home {
    max-width: 1100px; margin: 0 auto;
    font-family: 'DM Sans', sans-serif; color: var(--text);
    padding-bottom: 60px;
}

/* ══════════════════════════════
   HERO CINEMATIC
══════════════════════════════ */
.ht-hero {
    position: relative; border-radius: 28px; overflow: hidden;
    margin-bottom: 20px; min-height: 260px;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 28px 30px 26px;
}
.ht-hero-bg {
    position: absolute; inset: 0; z-index: 0;
}
.ht-hero-bg-base {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #0a0e1f 0%, #1a1060 40%, #0d1f3c 70%, #060c18 100%);
}
.ht-hero-mesh {
    position: absolute; inset: 0;
    background:
        radial-gradient(ellipse 70% 60% at 80% 20%, rgba(91,94,244,0.35) 0%, transparent 55%),
        radial-gradient(ellipse 50% 50% at 10% 80%, rgba(0,196,140,0.2) 0%, transparent 55%),
        radial-gradient(ellipse 40% 40% at 50% 50%, rgba(255,112,67,0.12) 0%, transparent 60%);
}
.ht-hero-grid {
    position: absolute; inset: 0; opacity: 0.04;
    background-image: linear-gradient(rgba(255,255,255,1) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px);
    background-size: 40px 40px;
}
.ht-hero-noise {
    position: absolute; inset: 0; opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
}
.ht-hero-orbs {
    position: absolute; inset: 0; pointer-events: none;
}
.ht-hero-orb {
    position: absolute; border-radius: 50%;
    filter: blur(60px); opacity: 0.4;
}
.ht-hero-orb-1 {
    width: 300px; height: 300px;
    background: radial-gradient(circle, #5b5ef4, transparent);
    top: -80px; right: -60px;
    animation: orbDrift1 8s ease-in-out infinite;
}
.ht-hero-orb-2 {
    width: 200px; height: 200px;
    background: radial-gradient(circle, #00c48c, transparent);
    bottom: -40px; left: 10%;
    animation: orbDrift2 10s ease-in-out infinite;
}
@@keyframes orbDrift1 { 0%,100%{transform:translate(0,0) scale(1);} 50%{transform:translate(-20px,20px) scale(1.1);} }
@@keyframes orbDrift2 { 0%,100%{transform:translate(0,0) scale(1);} 50%{transform:translate(20px,-15px) scale(0.9);} }

.ht-hero-inner { position: relative; z-index: 1; }
.ht-hero-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 22px; gap: 12px; flex-wrap: wrap;
}
.ht-hero-user { display: flex; align-items: center; gap: 14px; flex: 1; min-width: 0; }
.ht-hero-avatar {
    width: 52px; height: 52px; border-radius: 50%; flex-shrink: 0;
    background: rgba(255,255,255,0.15); border: 2px solid rgba(255,255,255,0.3);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; color: white;
    overflow: hidden; box-shadow: 0 0 0 4px rgba(255,255,255,0.08), 0 8px 24px rgba(0,0,0,0.3);
    transition: 0.3s;
}
.ht-hero-avatar:hover { transform: scale(1.06); box-shadow: 0 0 0 4px rgba(91,94,244,0.4), 0 12px 32px rgba(0,0,0,0.4); }
.ht-hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
.ht-hero-name {
    font-family: 'Syne', sans-serif;
    font-size: 20px; font-weight: 800; color: white; margin-bottom: 3px;
    letter-spacing: -0.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ht-hero-sub { font-size: 12px; color: rgba(255,255,255,0.45); font-weight: 500; }

.ht-hero-badges { display: flex; gap: 8px; align-items: center; flex-shrink: 0; flex-wrap: wrap; }
.ht-plan-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 7px 14px; border-radius: 20px; font-size: 12px; font-weight: 700;
    text-decoration: none; transition: 0.2s; white-space: nowrap;
}
.ht-plan-pill.free {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: white; box-shadow: 0 4px 14px rgba(91,94,244,0.5);
}
.ht-plan-pill.free:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(91,94,244,0.6); color: white; }
.ht-plan-pill.premium {
    background: rgba(245,158,11,0.15); color: #fcd34d;
    border: 1px solid rgba(245,158,11,0.3); backdrop-filter: blur(8px);
}
.ht-weather-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 7px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.8); backdrop-filter: blur(8px);
    display: none;
}

/* STATS STRIP */
.ht-hero-stats {
    display: flex; align-items: stretch; gap: 0;
    background: rgba(0,0,0,0.25); border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(20px); overflow: hidden;
}
.ht-hero-stat {
    flex: 1; padding: 14px 12px; text-align: center; position: relative;
    transition: 0.2s;
}
.ht-hero-stat:hover { background: rgba(255,255,255,0.04); }
.ht-hero-stat:not(:last-child)::after {
    content: ''; position: absolute; right: 0; top: 20%; height: 60%;
    width: 1px; background: rgba(255,255,255,0.08);
}
.ht-hero-stat-val {
    font-family: 'Syne', sans-serif;
    font-size: 20px; font-weight: 800; color: white; line-height: 1; margin-bottom: 4px;
    display: flex; align-items: center; justify-content: center; gap: 3px;
}
.ht-hero-stat-label {
    font-size: 9px; color: rgba(255,255,255,0.4); text-transform: uppercase;
    letter-spacing: 1px; font-weight: 700;
}

/* PROGRESS RING */
.ht-hero-stat.has-ring { position: relative; }
.ht-ring-svg { position: absolute; top: 6px; right: 6px; width: 28px; height: 28px; transform: rotate(-90deg); }
.ht-ring-bg { fill: none; stroke: rgba(255,255,255,0.1); stroke-width: 3; }
.ht-ring-fill { fill: none; stroke: var(--green); stroke-width: 3; stroke-linecap: round; transition: stroke-dashoffset 1.5s cubic-bezier(0.4,0,0.2,1); }

/* ══════════════════════════════
   STORIES
══════════════════════════════ */
.ht-stories-wrap {
    margin-bottom: 20px;
    background: var(--card); border-radius: var(--radius);
    border: 1px solid var(--border); overflow: hidden;
}
.ht-stories-inner {
    display: flex; gap: 0; overflow-x: auto;
    padding: 16px 14px; scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
}
.ht-stories-inner::-webkit-scrollbar { display: none; }
.ht-story-item {
    display: flex; flex-direction: column; align-items: center;
    gap: 7px; cursor: pointer; flex-shrink: 0; width: 72px;
    padding: 0 4px;
}
.ht-story-ring {
    width: 62px; height: 62px; border-radius: 50%; position: relative;
    padding: 3px;
    background: conic-gradient(#f97316, #ec4899, #8b5cf6, #f97316);
    transition: 0.2s;
}
.ht-story-ring.mine { background: conic-gradient(var(--accent), var(--accent2), var(--accent)); }
.ht-story-ring.viewed { background: var(--border2); }
.ht-story-ring:hover { transform: scale(1.06); }
.ht-story-ring-inner {
    width: 100%; height: 100%; border-radius: 50%;
    background: var(--surface); display: flex; align-items: center; justify-content: center;
    overflow: hidden; border: 2.5px solid var(--card);
}
.ht-story-ring-inner img { width: 100%; height: 100%; object-fit: cover; }
.ht-story-letter {
    width: 100%; height: 100%; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: white; display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800;
}
.ht-story-add {
    position: absolute; bottom: 0; right: 0;
    width: 20px; height: 20px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: white; font-size: 13px; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid var(--card); box-shadow: 0 2px 8px rgba(91,94,244,0.4);
}
.ht-story-name {
    font-size: 11px; font-weight: 600; color: var(--muted);
    text-align: center; white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; max-width: 68px;
}

/* ══════════════════════════════
   TWO COLUMN DESKTOP LAYOUT
══════════════════════════════ */
.ht-body {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 18px;
    align-items: start;
}
@@media(max-width:900px) {
    .ht-body { grid-template-columns: 1fr; }
}

/* ── COLUMN LEFT ── */
.ht-col-left { display: flex; flex-direction: column; gap: 16px; }
.ht-col-right { display: flex; flex-direction: column; gap: 16px; }

/* ══════════════════════════════
   QUOTE TICKER
══════════════════════════════ */
.ht-quote {
    background: var(--card); border-radius: var(--radius2);
    border: 1px solid var(--border);
    padding: 14px 18px; display: flex; align-items: center; gap: 12px;
    overflow: hidden; min-height: 52px;
}
.ht-quote-icon { font-size: 16px; flex-shrink: 0; }
.ht-quote-text {
    font-size: 13px; color: var(--muted); font-style: italic;
    line-height: 1.6; margin: 0; flex: 1;
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.5s, transform 0.5s;
}

/* ══════════════════════════════
   KPI GRID — PREMIUM
══════════════════════════════ */
.ht-kpi-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
}
.ht-kpi {
    background: var(--card); border-radius: var(--radius2);
    border: 1px solid var(--border); padding: 18px 16px;
    display: flex; align-items: center; gap: 14px;
    text-decoration: none; color: var(--text); transition: 0.25s;
    position: relative; overflow: hidden;
}
.ht-kpi::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    border-radius: var(--radius2) var(--radius2) 0 0;
}
.ht-kpi.blue::before { background: linear-gradient(90deg, #3b82f6, #6366f1); }
.ht-kpi.green::before { background: linear-gradient(90deg, #00c48c, #10b981); }
.ht-kpi.orange::before { background: linear-gradient(90deg, #ff7043, #f59e0b); }
.ht-kpi.gold::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
.ht-kpi:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.1);
    border-color: var(--border2);
    color: var(--text);
}
.ht-kpi-icon {
    width: 46px; height: 46px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 22px;
}
.ht-kpi.blue .ht-kpi-icon { background: rgba(59,130,246,0.1); }
.ht-kpi.green .ht-kpi-icon { background: rgba(0,196,140,0.1); }
.ht-kpi.orange .ht-kpi-icon { background: rgba(255,112,67,0.1); }
.ht-kpi.gold .ht-kpi-icon { background: rgba(245,158,11,0.1); }
.ht-kpi-val {
    font-family: 'Syne', sans-serif;
    font-size: 26px; font-weight: 800; line-height: 1; margin-bottom: 3px;
}
.ht-kpi.blue .ht-kpi-val { color: #3b82f6; }
.ht-kpi.green .ht-kpi-val { color: var(--green); }
.ht-kpi.orange .ht-kpi-val { color: var(--orange); }
.ht-kpi.gold .ht-kpi-val { color: var(--gold); }
.ht-kpi-lbl { font-size: 11px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }

/* ══════════════════════════════
   QUICK ACTIONS
══════════════════════════════ */
.ht-actions {
    display: flex; gap: 8px; flex-wrap: wrap;
}
.ht-action-btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 18px; border-radius: 24px;
    font-size: 13px; font-weight: 700; text-decoration: none;
    transition: 0.2s; flex-shrink: 0; font-family: inherit;
    border: none; cursor: pointer;
}
.ht-action-btn.primary {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: white; box-shadow: 0 4px 16px var(--accent-glow);
}
.ht-action-btn.primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px var(--accent-glow); color: white; }
.ht-action-btn.ghost {
    background: var(--card); border: 1.5px solid var(--border2); color: var(--muted);
}
.ht-action-btn.ghost:hover { border-color: var(--accent); color: var(--accent); }
.ht-action-btn.locked { background: var(--card2); border: 1.5px solid var(--border); color: var(--muted2); }

/* ══════════════════════════════
   HABIT LIST — REDESIGNED
══════════════════════════════ */
.ht-habits-card {
    background: var(--card); border-radius: var(--radius);
    border: 1px solid var(--border); overflow: hidden;
}
.ht-habits-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 20px 0;
}
.ht-habits-title {
    font-family: 'Syne', sans-serif;
    font-size: 15px; font-weight: 800; color: var(--text);
    display: flex; align-items: center; gap: 8px;
}
.ht-habits-count {
    font-size: 11px; font-weight: 700; padding: 3px 9px;
    border-radius: 20px; background: rgba(91,94,244,0.1); color: var(--accent);
    border: 1px solid rgba(91,94,244,0.2);
}
.ht-habits-add {
    padding: 7px 16px; border-radius: 20px; border: none;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: white; font-size: 12px; font-weight: 700;
    text-decoration: none; cursor: pointer; transition: 0.2s;
    box-shadow: 0 3px 10px var(--accent-glow);
}
.ht-habits-add:hover { transform: translateY(-1px); color: white; }

/* FILTER TABS */
.ht-habits-tabs {
    display: flex; gap: 4px; padding: 14px 20px 0;
}
.ht-habit-tab {
    padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700;
    cursor: pointer; border: none; font-family: inherit; transition: 0.15s;
    background: transparent; color: var(--muted);
}
.ht-habit-tab.active { background: rgba(91,94,244,0.1); color: var(--accent); }
.ht-habit-tab:hover:not(.active) { color: var(--text); }

/* HABIT ITEMS */
.ht-habits-list { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 8px; }

.ht-habit {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 16px; border-radius: 16px;
    background: var(--card2); border: 1.5px solid var(--border);
    transition: 0.2s; position: relative; overflow: hidden;
}
.ht-habit::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px;
    border-radius: 16px 0 0 16px;
}
.ht-habit.done::before { background: var(--green); }
.ht-habit.failed::before { background: #ef4444; }
.ht-habit.pending::before { background: var(--accent); }
.ht-habit:hover { border-color: var(--border2); box-shadow: 0 4px 16px rgba(0,0,0,0.06); }

.ht-habit-check {
    width: 36px; height: 36px; border-radius: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; transition: 0.2s; cursor: pointer;
}
.ht-habit.done .ht-habit-check { background: rgba(0,196,140,0.15); color: var(--green); }
.ht-habit.failed .ht-habit-check { background: rgba(239,68,68,0.1); color: #ef4444; }
.ht-habit.pending .ht-habit-check { background: rgba(91,94,244,0.1); color: var(--accent); }
.ht-habit-check:hover { transform: scale(1.12); }

.ht-habit-info { flex: 1; min-width: 0; }
.ht-habit-name {
    font-size: 14px; font-weight: 700; color: var(--text);
    text-decoration: none; display: block; margin-bottom: 3px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ht-habit-name:hover { color: var(--accent); }
.ht-habit.done .ht-habit-name { text-decoration: line-through; color: var(--muted); }
.ht-habit-meta { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.ht-habit-streak { font-size: 12px; color: var(--orange); font-weight: 700; display: flex; align-items: center; gap: 3px; }
.ht-habit-record { font-size: 11px; color: var(--muted2); font-weight: 600; }

.ht-habit-status {
    font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 20px; white-space: nowrap; flex-shrink: 0;
}
.ht-habit.done .ht-habit-status { background: rgba(0,196,140,0.1); color: var(--green); border: 1px solid rgba(0,196,140,0.2); }
.ht-habit.failed .ht-habit-status { background: rgba(239,68,68,0.08); color: #ef4444; border: 1px solid rgba(239,68,68,0.15); }
.ht-habit.pending .ht-habit-status { background: rgba(91,94,244,0.08); color: var(--accent); border: 1px solid rgba(91,94,244,0.15); }

.ht-habit-actions { display: flex; gap: 5px; flex-shrink: 0; }
.ht-hab-btn {
    width: 32px; height: 32px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; text-decoration: none; transition: 0.15s;
    border: 1px solid transparent;
}
.ht-hab-btn.complete { background: rgba(0,196,140,0.1); color: var(--green); border-color: rgba(0,196,140,0.2); }
.ht-hab-btn.complete:hover { background: var(--green); color: white; }
.ht-hab-btn.fail { background: rgba(239,68,68,0.08); color: #ef4444; border-color: rgba(239,68,68,0.15); }
.ht-hab-btn.fail:hover { background: #ef4444; color: white; }
.ht-hab-btn.edit { background: rgba(245,158,11,0.1); color: var(--gold); border-color: rgba(245,158,11,0.2); }
.ht-hab-btn.edit:hover { background: var(--gold); color: white; }
.ht-hab-btn.del { background: rgba(100,116,139,0.08); color: var(--muted); border-color: rgba(100,116,139,0.15); }
.ht-hab-btn.del:hover { background: #ef4444; color: white; border-color: #ef4444; }

/* COMMENT SECTION */
.ht-habit-comment-wrap { padding: 0 14px 14px; }
.ht-habit-comment-form { display: flex; gap: 8px; }
.ht-habit-comment-input {
    flex: 1; padding: 9px 14px; border-radius: 20px;
    border: 1.5px solid var(--border); background: var(--card2);
    font-size: 13px; font-family: inherit; outline: none; color: var(--text);
    transition: 0.2s;
}
.ht-habit-comment-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(91,94,244,0.1); }
.ht-habit-comment-input::placeholder { color: var(--muted2); }
.ht-habit-comment-item { font-size: 12px; color: var(--muted); padding: 4px 0; border-top: 1px solid var(--border); margin-top: 6px; }

/* EMPTY */
.ht-habits-empty {
    padding: 48px 24px; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
}
.ht-habits-empty-icon {
    width: 72px; height: 72px; border-radius: 22px;
    background: rgba(91,94,244,0.08); border: 1px solid rgba(91,94,244,0.15);
    display: flex; align-items: center; justify-content: center;
    font-size: 32px; animation: emptyFloat 3s ease-in-out infinite;
}
@@keyframes emptyFloat { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-8px);} }
.ht-habits-empty-title { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 800; color: var(--text); }
.ht-habits-empty-sub { font-size: 13px; color: var(--muted); max-width: 240px; line-height: 1.6; }

/* LIMIT PILL */
.ht-limit-pill {
    margin: 0 14px 12px; padding: 10px 14px; border-radius: 12px;
    background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.15);
    font-size: 13px; color: #f87171; font-weight: 600; display: flex; align-items: center; gap: 8px;
}
.ht-limit-pill a { color: #fca5a5; font-weight: 800; text-decoration: none; }

/* ══════════════════════════════
   RIGHT SIDEBAR
══════════════════════════════ */

/* PROGRESS CARD */
.ht-progress-card {
    background: var(--card); border-radius: var(--radius);
    border: 1px solid var(--border); padding: 20px;
    display: flex; flex-direction: column; gap: 14px;
}
.ht-progress-title { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 800; color: var(--text); margin-bottom: 2px; }
.ht-progress-item { display: flex; flex-direction: column; gap: 5px; }
.ht-progress-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); font-weight: 600; }
.ht-progress-label span:last-child { font-weight: 800; color: var(--text); }
.ht-progress-bar { height: 6px; background: var(--border); border-radius: 10px; overflow: hidden; }
.ht-progress-fill { height: 100%; border-radius: 10px; transition: width 1.5s cubic-bezier(0.4,0,0.2,1); }
.ht-progress-fill.green { background: linear-gradient(90deg, var(--green), #10b981); }
.ht-progress-fill.blue { background: linear-gradient(90deg, var(--accent), #3b82f6); }
.ht-progress-fill.orange { background: linear-gradient(90deg, var(--orange), var(--gold)); }

/* CHART CARD */
.ht-chart-card {
    background: var(--card); border-radius: var(--radius);
    border: 1px solid var(--border); padding: 20px;
}
.ht-chart-title { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 800; color: var(--text); margin-bottom: 14px; }
.ht-chart-wrap { position: relative; height: 160px; }

/* STREAK CALENDAR */
.ht-streak-card {
    background: var(--card); border-radius: var(--radius);
    border: 1px solid var(--border); padding: 20px;
}
.ht-streak-title { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 800; color: var(--text); margin-bottom: 14px; }
.ht-streak-grid {
    display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;
}
.ht-streak-day {
    aspect-ratio: 1; border-radius: 5px; transition: 0.15s;
    cursor: default;
}
.ht-streak-day.empty { background: var(--border); }
.ht-streak-day.done { background: var(--green); box-shadow: 0 0 8px rgba(0,196,140,0.3); }
.ht-streak-day.partial { background: rgba(0,196,140,0.4); }
.ht-streak-day.failed { background: rgba(239,68,68,0.3); }
.ht-streak-day-labels {
    display: grid; grid-template-columns: repeat(7, 1fr);
    gap: 4px; margin-bottom: 4px;
}
.ht-streak-day-label { text-align: center; font-size: 9px; color: var(--muted2); font-weight: 700; text-transform: uppercase; }

/* TIPS CARD */
.ht-tips-card {
    background: linear-gradient(135deg, #0d1a3a, #1a1060);
    border-radius: var(--radius); border: 1px solid rgba(91,94,244,0.2);
    padding: 20px; position: relative; overflow: hidden;
}
.ht-tips-card::before {
    content: ''; position: absolute; top: -30px; right: -30px;
    width: 120px; height: 120px;
    background: radial-gradient(circle, rgba(91,94,244,0.25), transparent);
    border-radius: 50%;
}
.ht-tips-title { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 800; color: white; margin-bottom: 12px; position: relative; z-index: 1; }
.ht-tip-item { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 10px; position: relative; z-index: 1; }
.ht-tip-item:last-child { margin-bottom: 0; }
.ht-tip-icon { font-size: 15px; flex-shrink: 0; margin-top: 1px; }
.ht-tip-text { font-size: 12px; color: rgba(255,255,255,0.6); line-height: 1.6; }
.ht-tip-text strong { color: rgba(255,255,255,0.9); }

/* ══════════════════════════════
   STORY VIEWER
══════════════════════════════ */
.ht-story-viewer {
    position: fixed; inset: 0; z-index: 99999;
    display: flex; align-items: center; justify-content: center;
}
.ht-story-viewer-bg {
    position: absolute; inset: 0; background: rgba(0,0,0,0.96);
    backdrop-filter: blur(20px);
}
.ht-story-viewer-card {
    position: relative; width: 100%; max-width: 420px;
    height: 100vh; max-height: 820px; border-radius: 24px;
    overflow: hidden; background: #000; z-index: 1;
    box-shadow: 0 40px 100px rgba(0,0,0,0.8);
}
.ht-story-progress-bars {
    position: absolute; top: calc(12px + env(safe-area-inset-top, 0px));
    left: 10px; right: 10px; display: flex; gap: 3px; z-index: 10;
}
.ht-story-progress-bar { flex: 1; height: 3px; background: rgba(255,255,255,0.25); border-radius: 10px; overflow: hidden; }
.ht-story-progress-fill { height: 100%; background: white; width: 0%; border-radius: 10px; }
.ht-story-header {
    position: absolute; top: calc(24px + env(safe-area-inset-top, 0px));
    left: 10px; right: 10px; display: flex; align-items: center; justify-content: space-between; z-index: 10;
}
.ht-story-content { width: 100%; height: 100%; position: relative; }
.ht-story-nav-left { position: absolute; left: 0; top: 0; width: 35%; height: 88%; z-index: 5; cursor: pointer; }
.ht-story-nav-right { position: absolute; right: 0; top: 0; width: 35%; height: 88%; z-index: 5; cursor: pointer; }
@@keyframes heartPop { 0%{transform:scale(0) rotate(-15deg);opacity:1;} 35%{transform:scale(1.5) rotate(8deg);opacity:1;} 65%{transform:scale(0.85) rotate(-4deg);opacity:1;} 100%{transform:scale(1.15) rotate(0);opacity:0;} }

/* ══════════════════════════════
   RESPONSIVE
══════════════════════════════ */
@@media(max-width:768px) {
    .ht-home { padding: 0 2px 80px; }
    .ht-hero { min-height: auto; padding: 14px 12px 16px; border-radius: 16px; margin-bottom: 12px; }
    .ht-hero-top { margin-bottom: 14px; gap: 10px; flex-wrap: wrap; }
    .ht-hero-user { width: 100%; }
    .ht-hero-name { font-size: 15px; white-space: normal; }
    .ht-hero-avatar { width: 40px; height: 40px; font-size: 16px; }
    .ht-hero-sub { font-size: 11px; }
    .ht-plan-pill { font-size: 11px; padding: 5px 10px; }
    .ht-weather-pill { font-size: 11px; padding: 5px 9px; }
    .ht-hero-stats { border-radius: 12px; }
    .ht-hero-stat { padding: 10px 6px; }
    .ht-hero-stat-val { font-size: 15px; }
    .ht-hero-stat-label { font-size: 8px; letter-spacing: 0.3px; }
    .ht-ring-svg { width: 22px; height: 22px; top: 4px; right: 4px; }
    .ht-stories-wrap { border-radius: 14px; margin-bottom: 12px; }
    .ht-stories-inner { padding: 10px 8px; }
    .ht-story-item { width: 64px; padding: 0 2px; }
    .ht-story-ring { width: 54px; height: 54px; }
    .ht-story-name { font-size: 10px; max-width: 60px; }
    .ht-kpi-grid { gap: 8px; }
    .ht-kpi { padding: 12px 10px; gap: 8px; }
    .ht-kpi-icon { width: 34px; height: 34px; border-radius: 10px; font-size: 16px; }
    .ht-kpi-val { font-size: 20px; }
    .ht-kpi-lbl { font-size: 10px; }
    .ht-habits-card { border-radius: 16px; }
    .ht-habits-header { padding: 14px 14px 0; }
    .ht-habits-tabs { padding: 10px 14px 0; gap: 3px; }
    .ht-habit-tab { padding: 5px 10px; font-size: 11px; }
    .ht-habits-list { padding: 10px 10px 12px; gap: 6px; }
    .ht-habit { padding: 10px 10px; gap: 8px; }
    .ht-habit-check { width: 30px; height: 30px; border-radius: 9px; font-size: 13px; }
    .ht-habit-name { font-size: 13px; }
    .ht-habit-status { display: none; }
    .ht-hab-btn { width: 28px; height: 28px; border-radius: 8px; font-size: 12px; }
    .ht-habit-actions { gap: 4px; }
    .ht-quote { padding: 10px 12px; border-radius: 12px; }
    .ht-quote-text { font-size: 12px; }
    .ht-actions { flex-wrap: nowrap; overflow-x: auto; gap: 6px; }
    .ht-actions::-webkit-scrollbar { display: none; }
    .ht-action-btn { padding: 8px 14px; font-size: 12px; }
    .ht-body { gap: 10px; }
    .ht-progress-card, .ht-streak-card, .ht-tips-card, .ht-chart-card { display: none; }
    .ht-story-viewer-card { border-radius: 0; max-height: 100vh; max-width: 100%; }
}

@@media(min-width:769px) {
    .ht-story-viewer-card { max-height: 820px; }
}

/* DARK MODE EXTRAS */
body.bg-dark .ht-habits-card,
body.bg-dark .ht-progress-card,
body.bg-dark .ht-chart-card,
body.bg-dark .ht-streak-card,
body.bg-dark .ht-stories-wrap,
body.bg-dark .ht-quote { background: #0f172a !important; border-color: rgba(255,255,255,0.06) !important; }
body.bg-dark .ht-habit { background: #111827 !important; border-color: rgba(255,255,255,0.05) !important; }
body.bg-dark .ht-kpi { background: #0f172a !important; border-color: rgba(255,255,255,0.06) !important; }
body.bg-dark .ht-kpi:hover { box-shadow: 0 12px 32px rgba(0,0,0,0.4) !important; }
body.bg-dark .ht-habit-comment-input { background: #111827 !important; border-color: rgba(255,255,255,0.08) !important; }
body.bg-dark .ht-story-ring-inner { border-color: #0f172a !important; }
body.bg-dark .ht-story-ring.viewed { background: #2d3748 !important; }
body.bg-dark .ht-streak-day.empty { background: rgba(255,255,255,0.05) !important; }
body.bg-dark .ht-habits-tabs { background: transparent !important; }
body.bg-dark .ht-habit-tab { color: #64748b !important; }
body.bg-dark .ht-habit-tab.active { background: rgba(91,94,244,0.15) !important; color: #818cf8 !important; }
</style>

<div class="ht-home">

<!-- ════════ HERO ════════ -->
<div class="ht-hero">
    <div class="ht-hero-bg">
        <div class="ht-hero-bg-base"></div>
        <div class="ht-hero-mesh"></div>
        <div class="ht-hero-grid"></div>
        <div class="ht-hero-noise"></div>
        <div class="ht-hero-orbs">
            <div class="ht-hero-orb ht-hero-orb-1"></div>
            <div class="ht-hero-orb ht-hero-orb-2"></div>
        </div>
    </div>
<div class="ht-hero-inner">
        <div class="ht-hero-top">
            <div class="ht-hero-user">
                <div class="ht-hero-avatar">
                    @{ var profileImage = User.FindFirst("ProfileImage")?.Value; }
                    @if (!string.IsNullOrEmpty(profileImage))
                    { <img src="@profileImage" alt="avatar" /> }
                    else
                    { <span>@(username.Length > 0 ? username.Substring(0,1).ToUpper() : "?")</span> }
                </div>
                <div style="min-width:0;">
                    <div class="ht-hero-name">@welcomeMsg</div>
                    <div class="ht-hero-sub">Disciplina diaria · Resultados reales</div>
                </div>
            </div>
            <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;flex-wrap:wrap;">
                <div class="ht-weather-pill" id="weatherPill">
                    <span id="wIcon">⛅</span>
                    <span id="wTemp"></span>
                    <span id="wCity" style="font-size:10px;opacity:0.7;"></span>
                </div>
                @if (user != null && !user.IsPremium)
                { <a href="/User/Pay" class="ht-plan-pill free">⚡ Premium</a> }
                else if (user?.IsPremium == true)
                { <div class="ht-plan-pill premium">👑 Pro</div> }
            </div>
        </div>
        <div class="ht-hero-stats">
            <div class="ht-hero-stat">
                <div class="ht-hero-stat-val">@completedToday/@totalHabits</div>
                <div class="ht-hero-stat-label">Hoy</div>
            </div>
            <div class="ht-hero-stat">
                <div class="ht-hero-stat-val">@totalStreak <span style="font-size:14px;">🔥</span></div>
                <div class="ht-hero-stat-label">Racha total</div>
            </div>
            <div class="ht-hero-stat has-ring">
                <svg class="ht-ring-svg" viewBox="0 0 28 28">
                    <circle class="ht-ring-bg" cx="14" cy="14" r="11"/>
                    <circle class="ht-ring-fill" id="progressRing" cx="14" cy="14" r="11"
                        stroke-dasharray="69.1" stroke-dashoffset="69.1"/>
                </svg>
                <div class="ht-hero-stat-val">@completionRate<span style="font-size:12px;">%</span></div>
                <div class="ht-hero-stat-label">Completado</div>
            </div>
            <div class="ht-hero-stat">
                <div class="ht-hero-stat-val">@bestRecord <span style="font-size:14px;">🏆</span></div>
                <div class="ht-hero-stat-label">Récord</div>
            </div>
        </div>
    </div>
</div>

<!-- ════════ STORIES ════════ -->
@if (!isGuest)
{
    <div class="ht-stories-wrap">
        <div class="ht-stories-inner" id="storiesBar">
            <div class="ht-story-item" onclick="window.location.href='/Story/Create'">
                <div class="ht-story-ring mine">
                    <div class="ht-story-ring-inner">
                        @{ var myPic = User.FindFirst("ProfileImage")?.Value; var myUn = User.Identity?.Name ?? "Yo"; }
                        @if (!string.IsNullOrEmpty(myPic))
                        { <img src="@myPic" /> }
                        else
                        { <div class="ht-story-letter">@myUn.Substring(0,1).ToUpper()</div> }
                    </div>
                    <div class="ht-story-add">+</div>
                </div>
                <div class="ht-story-name">Tu historia</div>
            </div>
            <div id="friendStories" style="display:contents;"></div>
        </div>
    </div>
}

<!-- ════════ BODY ════════ -->
<div class="ht-body">

    <!-- COLUMNA IZQUIERDA -->
    <div class="ht-col-left">

        <!-- QUOTE -->
        <div class="ht-quote">
            <span class="ht-quote-icon">✨</span>
            <p class="ht-quote-text" id="quoteText"></p>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="ht-actions">
            @if (user != null && (user.IsPremium || Model.Count < 5))
            { <a href="/Habit/Create" class="ht-action-btn primary">➕ Nuevo hábito</a> }
            else
            { <a href="/User/Pay" class="ht-action-btn locked">🔒 Premium</a> }
            <a href="/Habit/History" class="ht-action-btn ghost">📅 Historial</a>
            <a href="/Habit/Calendar" class="ht-action-btn ghost">📆 Calendario</a>
            @if (user?.IsPremium == true)
            { <a href="/Habit/Statistics" class="ht-action-btn ghost">📈 Estadísticas</a> }
            <a href="/Habit/Achievements" class="ht-action-btn ghost">🏆 Logros</a>
        </div>

        <!-- KPI GRID -->
        <div class="ht-kpi-grid">
            <a href="/Habit/Index" class="ht-kpi blue">
                <div class="ht-kpi-icon">📋</div>
                <div><div class="ht-kpi-val">@totalHabits</div><div class="ht-kpi-lbl">Hábitos totales</div></div>
            </a>
            <a href="/Habit/Statistics" class="ht-kpi green">
                <div class="ht-kpi-icon">🔥</div>
                <div><div class="ht-kpi-val">@totalStreak</div><div class="ht-kpi-lbl">Racha acumulada</div></div>
            </a>
            <a href="/Habit/Calendar" class="ht-kpi orange">
                <div class="ht-kpi-icon">⚡</div>
                <div><div class="ht-kpi-val">@completionRate%</div><div class="ht-kpi-lbl">Hoy completado</div></div>
            </a>
            <a href="/Habit/Achievements" class="ht-kpi gold">
                <div class="ht-kpi-icon">🏆</div>
                <div><div class="ht-kpi-val">@bestRecord</div><div class="ht-kpi-lbl">Mejor racha</div></div>
            </a>
        </div>

        <!-- HABITS CARD -->
        <div class="ht-habits-card">
            <div class="ht-habits-header">
                <div class="ht-habits-title">
                    Mis hábitos
                    @if (totalHabits > 0)
                    { <span class="ht-habits-count">@totalHabits</span> }
                </div>
                @if (user != null && (user.IsPremium || Model.Count < 5))
                { <a href="/Habit/Create" class="ht-habits-add">+ Nuevo</a> }
            </div>

            @if (totalHabits > 0)
            {
                <div class="ht-habits-tabs">
                    <button class="ht-habit-tab active" onclick="filtrarHabits('todos', this)">Todos (@totalHabits)</button>
                    <button class="ht-habit-tab" onclick="filtrarHabits('pendientes', this)">Pendientes (@pendingHabits.Count)</button>
                    <button class="ht-habit-tab" onclick="filtrarHabits('completados', this)">Completados (@completedHabits.Count)</button>
                </div>
            }

         

            @if (Model.Count == 0)
            {
                <div class="ht-habits-empty">
                    <div class="ht-habits-empty-icon">🌱</div>
                    <div class="ht-habits-empty-title">Empieza hoy</div>
                    <div class="ht-habits-empty-sub">Los grandes cambios nacen de pequeños hábitos diarios.</div>
                    <a href="/Habit/Create" class="ht-action-btn primary" style="margin-top:4px;">➕ Crear mi primer hábito</a>
                </div>
            }
            else
            {
                <div class="ht-habits-list" id="habitsList">
                    @foreach (var habit in Model)
                    {
                        bool done = habit.LastCheckDate == DateTime.Today && habit.Completed;
                        bool failed = habit.LastCheckDate == DateTime.Today && !habit.Completed;
                        string statusClass = done ? "done" : failed ? "failed" : "pending";
                        string statusLabel = done ? "✔ Completado" : failed ? "✖ Fallado" : "⏳ Pendiente";
                        string checkIcon = done ? "✔" : failed ? "✖" : "○";

                        <div class="ht-habit @statusClass" data-status="@statusClass" id="habit-item-@habit.Id">
                            <div class="ht-habit-check" title="Estado">@checkIcon</div>
                            <div class="ht-habit-info">
                                <a href="/Habit/Detail/@habit.Id" class="ht-habit-name">@habit.Name</a>
                                <div class="ht-habit-meta">
                                    <span class="ht-habit-streak">🔥 @habit.StreakDays días</span>
                                    <span class="ht-habit-record">🏆 @habit.MaxStreak máx</span>
                                </div>
                            </div>
                            <span class="ht-habit-status">@statusLabel</span>
                            <div class="ht-habit-actions">
                                <a href="/Habit/Complete/@habit.Id" class="ht-hab-btn complete" title="Completar" onclick="playComplete(event, this)">✔</a>
                                <a href="/Habit/Fail/@habit.Id" class="ht-hab-btn fail" title="Fallar">✖</a>
                                <a href="/Habit/Edit/@habit.Id" class="ht-hab-btn edit" title="Editar">✏</a>
                                <a href="/Habit/Delete/@habit.Id" class="ht-hab-btn del" data-no-loader="true" onclick="if(!confirm('¿Eliminar este hábito?')) return false;" title="Eliminar">🗑</a>
                            </div>
                        </div>
                        <div class="ht-habit-comment-wrap" id="comment-wrap-@habit.Id">
                            <form asp-action="AddComment" method="post" class="ht-habit-comment-form">
                                <input type="hidden" name="habitId" value="@habit.Id" />
                                <input type="text" name="content" class="ht-habit-comment-input" placeholder="💬 Añade un comentario..." />
                            </form>
                            @if (habit.Comments != null && habit.Comments.Any())
                            {
                                @foreach (var c in habit.Comments.OrderByDescending(x => x.CreatedAt).Take(2))
                                { <div class="ht-habit-comment-item"><b>@c.User.Username:</b> @c.Content</div> }
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>

    <!-- COLUMNA DERECHA (solo desktop) -->
    <div class="ht-col-right">

        <!-- PROGRESO HOY -->
        <div class="ht-progress-card">
            <div class="ht-progress-title">📊 Progreso de hoy</div>
            <div class="ht-progress-item">
                <div class="ht-progress-label"><span>Completados</span><span>@completedToday / @totalHabits</span></div>
                <div class="ht-progress-bar"><div class="ht-progress-fill green" id="prog1" style="width:0%"></div></div>
            </div>
            <div class="ht-progress-item">
                <div class="ht-progress-label"><span>Tasa de éxito</span><span>@completionRate%</span></div>
                <div class="ht-progress-bar"><div class="ht-progress-fill blue" id="prog2" style="width:0%"></div></div>
            </div>
            <div class="ht-progress-item">
                <div class="ht-progress-label"><span>Racha promedio</span><span>@(totalHabits > 0 ? (int)(totalStreak / totalHabits) : 0) días</span></div>
                <div class="ht-progress-bar"><div class="ht-progress-fill orange" id="prog3" style="width:0%"></div></div>
            </div>
        </div>

        <!-- CHART -->
        <div class="ht-chart-card">
            <div class="ht-chart-title">📈 Últimos 7 días</div>
            <div class="ht-chart-wrap">
                <canvas id="habitChart"></canvas>
            </div>
        </div>

        <!-- STREAK CALENDAR -->
        <div class="ht-streak-card">
            <div class="ht-streak-title">📅 Actividad reciente</div>
            <div class="ht-streak-day-labels">
                @foreach (var d in new[]{"D","L","M","M","J","V","S"})
                { <div class="ht-streak-day-label">@d</div> }
            </div>
            <div class="ht-streak-grid" id="streakGrid"></div>
        </div>

        <!-- TIPS -->
        <div class="ht-tips-card">
            <div class="ht-tips-title">💡 Consejos de hoy</div>
            <div class="ht-tip-item">
                <span class="ht-tip-icon">🎯</span>
                <span class="ht-tip-text"><strong>Regla de los 2 minutos:</strong> Si un hábito toma menos de 2 minutos, hazlo ahora mismo.</span>
            </div>
            <div class="ht-tip-item">
                <span class="ht-tip-icon">🔗</span>
                <span class="ht-tip-text"><strong>Apilamiento de hábitos:</strong> Encadena un nuevo hábito después de uno ya establecido.</span>
            </div>
            <div class="ht-tip-item">
                <span class="ht-tip-icon">🏆</span>
                <span class="ht-tip-text"><strong>No rompas la cadena:</strong> Cada día que completas un hábito refuerza tu identidad.</span>
            </div>
        </div>

    </div>

</div>

</div><!-- /.ht-home -->

<!-- STORY VIEWER -->
<div id="storyViewer" class="ht-story-viewer" style="display:none;">
    <div class="ht-story-viewer-bg" onclick="closeStoryViewer()"></div>
    <div class="ht-story-viewer-card">
        <div class="ht-story-progress-bars" id="storyProgressBars"></div>
        <div class="ht-story-header">
            <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:0;">
                <div style="position:relative;cursor:pointer;" onclick="goToProfile()">
                    <img id="svAvatar" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:2px solid white;display:block;" onerror="this.style.display='none';document.getElementById('svAvatarLetter').style.display='flex';"/>
                    <div id="svAvatarLetter" style="display:none;width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#5b5ef4,#3730d9);color:white;align-items:center;justify-content:center;font-weight:800;font-size:16px;border:2px solid white;flex-shrink:0;"></div>
                </div>
                <div style="min-width:0;flex:1;">
                    <div style="display:flex;align-items:center;gap:6px;">
                        <div id="svUsername" style="font-size:13px;font-weight:700;color:white;cursor:pointer;" onclick="goToProfile()"></div>
                        <div id="svVisibilityBadge" style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;display:none;backdrop-filter:blur(4px);"></div>
                    </div>
                    <div id="svTime" style="font-size:11px;color:rgba(255,255,255,0.5);margin-top:1px;"></div>
                </div>
            </div>
            <div style="display:flex;gap:4px;align-items:center;flex-shrink:0;">
                <button id="svHighlight" onclick="toggleHighlight()" data-no-loader style="background:rgba(255,255,255,0.1);border:none;color:white;font-size:18px;cursor:pointer;padding:6px 8px;border-radius:10px;">☆</button>
                <button id="svDelete" onclick="deleteCurrentStory()" data-no-loader style="display:none;background:rgba(239,68,68,0.2);border:none;color:white;font-size:16px;cursor:pointer;padding:6px 8px;border-radius:10px;">🗑</button>
                <button onclick="closeStoryViewer()" data-no-loader style="background:rgba(255,255,255,0.1);border:none;color:white;font-size:18px;cursor:pointer;padding:6px 8px;border-radius:10px;">✕</button>
            </div>
        </div>
        <div class="ht-story-content">
            <img id="svImg" style="display:none;width:100%;height:100%;object-fit:cover;background:#000;"/>
            <video id="svVideo" style="display:none;width:100%;height:100%;object-fit:contain;background:#000;" playsinline controls></video>
            <div id="svText" style="display:none;width:100%;height:100%;align-items:center;justify-content:center;padding:40px;text-align:center;font-size:24px;font-weight:800;color:white;line-height:1.5;"></div>
        </div>
        <div class="ht-story-nav-left" onclick="prevStory()"></div>
        <div class="ht-story-nav-right" onclick="nextStory()"></div>
        <div id="svCaption" style="position:absolute;bottom:80px;left:16px;right:16px;z-index:10;font-size:13px;color:white;font-weight:600;text-shadow:0 2px 8px rgba(0,0,0,0.8);text-align:center;pointer-events:none;"></div>
        <div style="position:absolute;bottom:0;left:0;right:0;z-index:10;padding:14px 16px 24px;background:linear-gradient(transparent,rgba(0,0,0,0.8));display:flex;align-items:center;gap:10px;">
            <button id="svLikeBtn" onclick="toggleStoryLike()" data-no-loader style="background:none;border:none;color:white;font-size:32px;cursor:pointer;padding:0;transition:transform 0.2s;flex-shrink:0;line-height:1;">🤍</button>
            <span id="svLikesCount" style="font-size:13px;color:rgba(255,255,255,0.85);font-weight:700;min-width:20px;"></span>
            <div id="svViewsBar" style="display:none;cursor:pointer;flex:1;text-align:center;" onclick="openStoryViews()">
                <span id="svViews" style="font-size:12px;color:rgba(255,255,255,0.85);font-weight:600;background:rgba(0,0,0,0.4);padding:5px 14px;border-radius:20px;backdrop-filter:blur(8px);">👁 0 vistas</span>
            </div>
        </div>
        <div id="svHeartAnim" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:20;opacity:0;">
            <span style="font-size:100px;filter:drop-shadow(0 0 40px rgba(239,68,68,1));" id="svHeartAnimIcon">❤️</span>
        </div>
        <div id="storyViewsModal" style="display:none;position:absolute;bottom:75px;left:12px;right:12px;background:rgba(8,12,24,0.98);border-radius:20px;padding:16px;z-index:30;max-height:260px;overflow-y:auto;backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.07);"></div>
    </div>
</div>

        @section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// ══ DATA ══
const labels7 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(last7Days.Select(d => d.ToString("dd/MM"))));
const data7 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dailyCompletion));
const completionRateVal = @completionRate;
const totalHabitsVal = @totalHabits;
const completedTodayVal = @completedToday;
const totalStreakVal = @totalStreak;
const avgStreak = totalHabitsVal > 0 ? Math.round(totalStreakVal / totalHabitsVal) : 0;
const myUserId = @(int.Parse(User.FindFirst("UserId").Value));

// ══ PROGRESS RING ANIMATION ══
window.addEventListener('load', () => {
    const ring = document.getElementById('progressRing');
    if (ring) {
        const r = 11;
        const circ = 2 * Math.PI * r;
        const offset = circ - (completionRateVal / 100) * circ;
        setTimeout(() => { ring.style.strokeDashoffset = offset; }, 400);
    }

    // Progress bars animation
    setTimeout(() => {
        const p1 = document.getElementById('prog1');
        const p2 = document.getElementById('prog2');
        const p3 = document.getElementById('prog3');
        if (p1) p1.style.width = (totalHabitsVal > 0 ? (completedTodayVal / totalHabitsVal * 100) : 0) + '%';
        if (p2) p2.style.width = completionRateVal + '%';
        if (p3) p3.style.width = Math.min(avgStreak * 5, 100) + '%';
    }, 600);
});

// ══ CHART ══
const isDark = document.body.classList.contains('bg-dark');
const gridColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)';
const textColor = isDark ? '#475569' : '#94a3b8';
new Chart(document.getElementById('habitChart'), {
    type: 'bar',
    data: {
        labels: labels7,
        datasets: [{
            data: data7,
            backgroundColor: data7.map(v => v >= 80 ? 'rgba(0,196,140,0.7)' : v >= 50 ? 'rgba(91,94,244,0.7)' : 'rgba(255,112,67,0.6)'),
            borderRadius: 8, borderSkipped: false,
            hoverBackgroundColor: data7.map(v => v >= 80 ? '#00c48c' : v >= 50 ? '#5b5ef4' : '#ff7043'),
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ctx.parsed.y + '% completado' } } },
        scales: {
            y: { beginAtZero: true, max: 100, ticks: { color: textColor, callback: v => v + '%', font: { size: 10 } }, grid: { color: gridColor } },
            x: { ticks: { color: textColor, font: { size: 10 } }, grid: { display: false } }
        }
    }
});

// ══ STREAK CALENDAR ══
const grid = document.getElementById('streakGrid');
if (grid) {
    const today = new Date();
    for (let i = 27; i >= 0; i--) {
        const d = new Date(today); d.setDate(today.getDate() - i);
        const cell = document.createElement('div');
        cell.className = 'ht-streak-day';
        const dayData = data7.find((_, idx) => {
            const label = labels7[idx];
            const dd = String(d.getDate()).padStart(2,'0');
            const mm = String(d.getMonth()+1).padStart(2,'0');
            return label === dd+'/'+mm;
        });
        if (dayData !== undefined) {
            cell.classList.add(dayData >= 80 ? 'done' : dayData >= 40 ? 'partial' : 'failed');
        } else { cell.classList.add('empty'); }
        cell.title = d.toLocaleDateString('es-CO', { weekday:'short', month:'short', day:'numeric' });
        grid.appendChild(cell);
    }
}

// ══ QUOTE ROTATOR ══
const frases = [
    "La disciplina es el puente entre metas y logros. 🚀",
    "Los pequeños hábitos crean grandes cambios. 🌱",
    "No necesitas ser perfecto, solo consistente. 🔥",
    "Un hábito a la vez. Un día a la vez. ⚡",
    "La constancia vence al talento. 🎯",
    "Tu futuro depende de lo que hagas hoy. 💡",
    "Primero forma el hábito, luego el hábito te forma. 🔄",
    "El progreso, no la perfección, es el objetivo. 📊",
    "Los hábitos son el interés compuesto del auto-mejoramiento. 📈",
    "Sé la mejor versión de ti mismo, cada día. 🌟",
    "Cae siete veces, levántate ocho. 🥊",
    "La excelencia no es un acto, es un hábito. 👌"
];
let fi = Math.floor(Math.random() * frases.length);
const qt = document.getElementById("quoteText");
qt.textContent = frases[fi];
setTimeout(() => { qt.style.opacity = "1"; qt.style.transform = "translateY(0)"; }, 200);
setInterval(() => {
    qt.style.opacity = "0"; qt.style.transform = "translateY(6px)";
    setTimeout(() => {
        fi = (fi + 1) % frases.length;
        qt.textContent = frases[fi];
        qt.style.opacity = "1"; qt.style.transform = "translateY(0)";
    }, 500);
}, 5000);

// ══ WEATHER ══
if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
        const { latitude: lat, longitude: lon } = pos.coords;
        fetch('https://api.open-meteo.com/v1/forecast?latitude='+lat+'&longitude='+lon+'&current_weather=true&timezone=auto')
            .then(r => r.json()).then(d => {
                const code = d.current_weather.weathercode;
                const icon = code >= 80 ? '🌧️' : code >= 61 ? '🌦️' : code >= 51 ? '🌦️' : code >= 45 ? '🌫️' : code >= 3 ? '⛅' : code >= 1 ? '🌤️' : '☀️';
                document.getElementById('wIcon').textContent = icon;
                document.getElementById('wTemp').textContent = Math.round(d.current_weather.temperature) + '°';
                const pill = document.getElementById('weatherPill');
                if (pill) pill.style.display = 'inline-flex';
                fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lon, { headers: { "Accept-Language": "es" } })
                    .then(r => r.json()).then(g => {
                        document.getElementById('wCity').textContent = g.address?.city || g.address?.town || '📍';
                    }).catch(() => {});
            }).catch(() => {});
    }, () => {}, { timeout: 6000 });
}

// ══ FILTER HABITS ══
function filtrarHabits(tipo, btn) {
    document.querySelectorAll('.ht-habit-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.ht-habit').forEach(h => {
        const status = h.getAttribute('data-status');
        let show = true;
        if (tipo === 'pendientes') show = status === 'pending';
        else if (tipo === 'completados') show = status === 'done';
        const id = h.id.replace('habit-item-', '');
        const commentWrap = document.getElementById('comment-wrap-' + id);
        h.style.display = show ? 'flex' : 'none';
        if (commentWrap) commentWrap.style.display = show ? 'block' : 'none';
    });
}

// ══ PLAY COMPLETE SOUND ══
function playComplete(e, btn) {
    e.preventDefault();
    if (typeof HabitSounds !== 'undefined') HabitSounds.complete();
    const href = btn.getAttribute('href');
    setTimeout(() => window.location.href = href, 350);
}

// ══ STORIES ══
let currentUserStories = [], currentStoryIndex = 0, storyProgressInterval = null, currentStoryOwnerId = null, currentStoryUserId = null;

async function loadFriendStories() {
    try {
        const res = await fetch('/Story/GetFriendsStories');
        const data = await res.json();
        const container = document.getElementById('friendStories');
        if (!container) return;
        container.innerHTML = '';
        data.forEach(group => {
            const pic = group.user.profileImage || group.user.profilePicture || '';
            const item = document.createElement('div');
            item.className = 'ht-story-item';
            item.onclick = () => openStoryViewer(group);
            const ring = document.createElement('div');
            ring.className = 'ht-story-ring' + (group.hasUnviewed ? '' : ' viewed');
            const inner = document.createElement('div');
            inner.className = 'ht-story-ring-inner';
            if (pic) {
                inner.innerHTML = `<img src="${pic}" onerror="this.parentElement.innerHTML='<div class=ht-story-letter>${group.user.username.charAt(0).toUpperCase()}</div>'" />`;
            } else {
                inner.innerHTML = `<div class="ht-story-letter">${group.user.username.charAt(0).toUpperCase()}</div>`;
            }
            ring.appendChild(inner);
            const name = document.createElement('div');
            name.className = 'ht-story-name';
            name.textContent = group.user.username;
            item.appendChild(ring); item.appendChild(name);
            container.appendChild(item);
        });
    } catch(e) { console.error(e); }
}

function openStoryViewer(group) {
    currentUserStories = group.stories;
    currentStoryIndex = 0;
    currentStoryOwnerId = group.user.id;
    currentStoryUserId = group.user.id;
    const pic = group.user.profileImage || group.user.profilePicture || '';
    const avatarImg = document.getElementById('svAvatar');
    const avatarLetter = document.getElementById('svAvatarLetter');
    if (pic) { avatarImg.src = pic; avatarImg.style.display = 'block'; avatarLetter.style.display = 'none'; }
    else { avatarImg.style.display = 'none'; avatarLetter.style.display = 'flex'; avatarLetter.textContent = group.user.username.charAt(0).toUpperCase(); }
    document.getElementById('svUsername').textContent = group.user.username;
    document.getElementById('svDelete').style.display = group.user.id === myUserId ? 'block' : 'none';
    document.getElementById('storyViewer').style.display = 'flex';
    document.body.style.overflow = 'hidden';
    buildProgressBars(); showStory(0);
}

function goToProfile() { if (currentStoryUserId) window.location.href = '/User/Profile/' + currentStoryUserId; }

function buildProgressBars() {
    const bars = document.getElementById('storyProgressBars'); bars.innerHTML = '';
    currentUserStories.forEach((_, i) => {
        const bar = document.createElement('div'); bar.className = 'ht-story-progress-bar';
        bar.innerHTML = `<div class="ht-story-progress-fill" id="progress-${i}"></div>`;
        bars.appendChild(bar);
    });
}

function showStory(index) {
    if (index >= currentUserStories.length) { closeStoryViewer(); return; }
    if (index < 0) { closeStoryViewer(); return; }
    currentStoryIndex = index;
    const story = currentUserStories[index];
    fetch('/Story/View', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(story.id) });
    document.getElementById('svImg').style.display = 'none';
    document.getElementById('svVideo').style.display = 'none';
    document.getElementById('svText').style.display = 'none';
    document.getElementById('storyViewsModal').style.display = 'none';
    if (story.type === 'image') { const img = document.getElementById('svImg'); img.src = story.mediaUrl; img.style.display = 'block'; }
    else if (story.type === 'video') { const vid = document.getElementById('svVideo'); vid.src = story.mediaUrl; vid.style.display = 'block'; vid.play(); vid.onended = () => { clearInterval(storyProgressInterval); showStory(currentStoryIndex + 1); }; }
    else { const txt = document.getElementById('svText'); txt.textContent = story.textContent; txt.style.background = story.bgColor || '#5b5ef4'; txt.style.display = 'flex'; }
    document.getElementById('svTime').textContent = getTimeAgo(new Date(story.createdAt + 'Z'));
    document.getElementById('svCaption').textContent = story.caption || '';
    document.getElementById('svHighlight').textContent = story.isHighlight ? '★' : '☆';
    const badge = document.getElementById('svVisibilityBadge');
    const visMap = { private: ['🔒 Privado', 'rgba(100,116,139,0.85)'], friends: ['👥 Amigos', 'rgba(91,94,244,0.85)'], public: ['🌍 Público', 'rgba(0,196,140,0.85)'] };
    if (visMap[story.visibility]) { badge.textContent = visMap[story.visibility][0]; badge.style.background = visMap[story.visibility][1]; badge.style.color = 'white'; badge.style.display = 'inline-block'; } else { badge.style.display = 'none'; }
    const isOwner = currentStoryOwnerId === myUserId;
    const viewsBar = document.getElementById('svViewsBar'); viewsBar.style.display = isOwner ? 'block' : 'none';
    if (isOwner) document.getElementById('svViews').textContent = '👁 ' + (story.views || 0) + ' vistas';
    const likeBtn = document.getElementById('svLikeBtn');
    likeBtn.textContent = story.liked ? '❤️' : '🤍';
    likeBtn.style.filter = story.liked ? 'drop-shadow(0 0 8px rgba(239,68,68,0.9))' : 'none';
    document.getElementById('svLikesCount').textContent = isOwner && story.likes > 0 ? story.likes + ' ❤️' : '';
    currentUserStories.forEach((_, i) => { const fill = document.getElementById('progress-' + i); if (fill) fill.style.width = i < index ? '100%' : '0%'; });
    startProgress(index, story.duration * 1000);
}

function startProgress(index, duration) {
    clearInterval(storyProgressInterval);
    const fill = document.getElementById('progress-' + index); if (!fill) return;
    let elapsed = 0;
    storyProgressInterval = setInterval(() => {
        elapsed += 50; fill.style.width = Math.min((elapsed / duration * 100), 100) + '%';
        if (elapsed >= duration) { clearInterval(storyProgressInterval); showStory(currentStoryIndex + 1); }
    }, 50);
}

function nextStory() { clearInterval(storyProgressInterval); showStory(currentStoryIndex + 1); }
function prevStory() { clearInterval(storyProgressInterval); showStory(currentStoryIndex - 1); }
function closeStoryViewer() {
    clearInterval(storyProgressInterval);
    document.getElementById('storyViewer').style.display = 'none';
    document.body.style.overflow = '';
    const vid = document.getElementById('svVideo'); vid.pause(); vid.src = '';
}

async function toggleStoryLike() {
    const story = currentUserStories[currentStoryIndex];
    const btn = document.getElementById('svLikeBtn');
    const anim = document.getElementById('svHeartAnim');
    const icon = document.getElementById('svHeartAnimIcon');
    anim.style.opacity = '1'; icon.style.animation = 'none'; icon.offsetHeight;
    icon.style.animation = 'heartPop 0.7s ease forwards';
    setTimeout(() => { anim.style.opacity = '0'; }, 800);
    btn.style.transform = 'scale(1.6)'; setTimeout(() => { btn.style.transform = 'scale(1)'; }, 300);
    try {
        const res = await fetch('/Story/ToggleLike', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(story.id) });
        const data = await res.json();
        story.liked = data.liked; story.likes = data.liked ? (story.likes || 0) + 1 : Math.max(0, (story.likes || 0) - 1);
        btn.textContent = data.liked ? '❤️' : '🤍'; btn.style.filter = data.liked ? 'drop-shadow(0 0 8px rgba(239,68,68,0.9))' : 'none';
        const isOwner = currentStoryOwnerId === myUserId;
        document.getElementById('svLikesCount').textContent = isOwner && story.likes > 0 ? story.likes + ' ❤️' : '';
    } catch(e) {}
}

async function toggleHighlight() {
    const story = currentUserStories[currentStoryIndex];
    try { const res = await fetch('/Story/ToggleHighlight', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(story.id) }); const data = await res.json(); story.isHighlight = data.isHighlight; document.getElementById('svHighlight').textContent = data.isHighlight ? '★' : '☆'; } catch(e) {}
}

async function deleteCurrentStory() {
    if (!confirm('¿Eliminar esta historia?')) return;
    const story = currentUserStories[currentStoryIndex];
    try {
        const res = await fetch('/Story/Delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(story.id) });
        if (!res.ok) { alert('Error al eliminar'); return; }
        currentUserStories.splice(currentStoryIndex, 1);
        if (!currentUserStories.length) { closeStoryViewer(); await loadFriendStories(); return; }
        buildProgressBars(); showStory(Math.min(currentStoryIndex, currentUserStories.length - 1));
        await loadFriendStories();
    } catch(e) { console.error(e); }
}

async function openStoryViews() {
    const story = currentUserStories[currentStoryIndex];
    const modal = document.getElementById('storyViewsModal');
    if (modal.style.display === 'block') { modal.style.display = 'none'; return; }
    modal.innerHTML = '<div style="color:rgba(255,255,255,0.35);font-size:12px;text-align:center;padding:14px;">Cargando...</div>';
    modal.style.display = 'block';
    try {
        const res = await fetch('/Story/GetViews?storyId=' + story.id);
        const data = await res.json();
        if (!data.length) { modal.innerHTML = '<div style="color:rgba(255,255,255,0.3);font-size:13px;text-align:center;padding:18px;">Nadie ha visto tu historia aún</div>'; return; }
        modal.innerHTML = '<div style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.3);margin-bottom:12px;text-transform:uppercase;letter-spacing:1px;">👁 Visto por</div>' + data.map(v =>
            `<div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
            ${v.profileImage ? `<img src="${v.profileImage}" style="width:34px;height:34px;border-radius:50%;object-fit:cover;flex-shrink:0;"/>` : `<div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#5b5ef4,#3730d9);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;">${v.username.charAt(0).toUpperCase()}</div>`}
            <div style="flex:1;min-width:0;"><div style="font-size:13px;font-weight:700;color:white;">${v.username}</div><div style="font-size:11px;color:rgba(255,255,255,0.35);margin-top:1px;">${v.viewedAt}</div></div>
            ${v.liked ? '<span style="font-size:18px;flex-shrink:0;filter:drop-shadow(0 0 4px rgba(239,68,68,0.6));">❤️</span>' : ''}</div>`
        ).join('');
    } catch(e) { modal.innerHTML = '<div style="color:#ef4444;font-size:12px;text-align:center;">Error al cargar</div>'; }
}

function getTimeAgo(date) {
    const diff = Math.floor((Date.now() - date) / 60000);
    if (diff < 1) return 'ahora'; if (diff < 60) return 'hace ' + diff + ' min';
    if (diff < 1440) return 'hace ' + Math.floor(diff/60) + 'h'; return 'hace ' + Math.floor(diff/1440) + 'd';
}

document.addEventListener('DOMContentLoaded', function() {
    if (!@(isGuest ? "true" : "false")) loadFriendStories();
    if (document.referrer.includes('/Story/Create')) {
        history.pushState(null, null, location.href);
        window.onpopstate = () => history.go(1);
    }
});
</script>
}