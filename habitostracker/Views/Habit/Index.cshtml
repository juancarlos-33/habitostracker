.hca-btn{display:inline-flex;align-items:center;gap:4px;padding:7px 12px;border-radius:10px;font-size:12px;font-weight:700;text-decoration:none;transition:0.15s;}
.hca-btn.complete{background:#dcfce7;color:#16a34a;}
.hca-btn.complete:hover{background:#16a34a;color:white;}
.hca-btn.fail{background:#fee2e2;color:#dc2626;}
.hca-btn.fail:hover{background:#dc2626;color:white;}
.hca-btn.edit{background:#fef3c7;color:#d97706;}
.hca-btn.edit:hover{background:#d97706;color:white;}
.hca-btn.delete{background:#f3f4f6;color:#6b7280;}
.hca-btn.delete:hover{background:#6b7280;color:white;}
.habit-comment-form{display:flex;gap:6px;}
.habit-comment-input{flex:1;padding:8px 14px;border-radius:24px;border:1.5px solid #e5e7eb;font-size:13px;outline:none;background:#f9fafb;transition:0.2s;font-family:inherit;}
.habit-comment-input:focus{border-color:#6366f1;background:white;box-shadow:0 0 0 3px rgba(99,102,241,0.1);}
.habit-comment-item{font-size:12px;color:#6b7280;padding:4px 0;border-top:1px solid #f3f4f6;margin-top:6px;}
body.bg-dark .habit-card{background:#1e293b!important;border-color:#2d3748!important;}
body.bg-dark .habit-card-name{color:#f1f5f9!important;}
body.bg-dark .habit-streak,body.bg-dark .habit-record{color:#94a3b8!important;}
body.bg-dark .habit-comment-input{background:#0f172a!important;border-color:#334155!important;color:#f1f5f9!important;}
body.bg-dark .habit-comment-item{border-color:#2d3748!important;color:#64748b!important;}
body.bg-dark .hca-btn.edit{background:rgba(217,119,6,0.15)!important;}
body.bg-dark .hca-btn.delete{background:#2d3748!important;color:#94a3b8!important;}

/* ══ CHART ══ */
.habits-section{margin-bottom:20px;}
.chart-section{background:white;border-radius:22px;padding:20px;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);margin-bottom:20px;}
.chart-wrap{position:relative;}
body.bg-dark .chart-section{background:#1e293b!important;border-color:#2d3748!important;}

/* ══ TABLE ══ */
.habits-table{width:100%;border-collapse:collapse;}
.habits-table thead th{font-size:11px;font-weight:700;color:#9ca3af;letter-spacing:0.8px;padding:0 12px 14px;border-bottom:1px solid #f3f4f6;}
.habits-table tbody tr:not(.comment-row):hover{background:#f9fafb;}
