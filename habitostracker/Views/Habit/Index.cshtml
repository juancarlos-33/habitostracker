@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// ==================== DATOS INICIALES ====================
const labels7=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(last7Days.Select(d=>d.ToString("dd/MM"))));
const data7=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(dailyCompletion));
const cRate=@completionRate;
const totH=@totalHabits;
const compT=@completedToday;
const totStr=@totalStreak;
const avgStr=@avgStreak;
const myId=@(int.Parse(User.FindFirst("UserId").Value));

// ── RING + BARS ──
window.addEventListener('load',()=>{
    const ring=document.getElementById('progressRing');
    if(ring){const circ=2*Math.PI*11;setTimeout(()=>{ring.style.strokeDashoffset=circ-(cRate/100)*circ;},400);}
    setTimeout(()=>{
        const p1=document.getElementById('prog1');
        const p2=document.getElementById('prog2');
        const p3=document.getElementById('prog3');
        if(p1)p1.style.width=(totH>0?(compT/totH*100):0)+'%';
        if(p2)p2.style.width=cRate+'%';
        if(p3)p3.style.width=Math.min(avgStr*5,100)+'%';
    },600);
});

// ── CHART ──
const isDark=document.body.classList.contains('bg-dark');
const gc=isDark?'rgba(255,255,255,0.05)':'rgba(0,0,0,0.04)';
const tc=isDark?'#475569':'#94a3b8';
new Chart(document.getElementById('habitChart'),{
    type:'bar',
    data:{labels:labels7,datasets:[{data:data7,
        backgroundColor:data7.map(v=>v>=80?'rgba(0,196,140,0.75)':v>=50?'rgba(91,94,244,0.75)':'rgba(255,112,67,0.65)'),
        borderRadius:7,borderSkipped:false,
        hoverBackgroundColor:data7.map(v=>v>=80?'#00c48c':v>=50?'#5b5ef4':'#ff7043')}]},
    options:{responsive:true,maintainAspectRatio:false,
        plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>c.parsed.y+'% completado'}}},
        scales:{y:{beginAtZero:true,max:100,ticks:{color:tc,callback:v=>v+'%',font:{size:9}},grid:{color:gc}},
                x:{ticks:{color:tc,font:{size:9}},grid:{display:false}}}}
});

// ── CALENDAR ──
const cg=document.getElementById('calGrid');
if(cg){const today=new Date();for(let i=27;i>=0;i--){const d=new Date(today);d.setDate(today.getDate()-i);const cell=document.createElement('div');cell.className='hx-calday';const dd=String(d.getDate()).padStart(2,'0'),mm=String(d.getMonth()+1).padStart(2,'0');const idx=labels7.indexOf(dd+'/'+mm);if(idx>=0){cell.classList.add(data7[idx]>=80?'d':data7[idx]>=40?'p':'f');}else cell.classList.add('e');cell.title=d.toLocaleDateString('es-CO',{weekday:'short',month:'short',day:'numeric'});cg.appendChild(cell);}}

// ── QUOTE ──
const frases=["La disciplina es el puente entre metas y logros. 🚀","Los pequeños hábitos crean grandes cambios. 🌱","No necesitas ser perfecto, solo consistente. 🔥","Un hábito a la vez. Un día a la vez. ⚡","La constancia vence al talento. 🎯","Tu futuro depende de lo que hagas hoy. 💡","Primero forma el hábito, luego el hábito te forma. 🔄","El progreso, no la perfección, es el objetivo. 📊","Los hábitos son el interés compuesto del auto-mejoramiento. 📈","Sé la mejor versión de ti mismo, cada día. 🌟","Cae siete veces, levántate ocho. 🥊","La excelencia no es un acto, es un hábito. 👌"];
let fi=Math.floor(Math.random()*frases.length);
const qt=document.getElementById('quoteText');
qt.textContent=frases[fi];
setTimeout(()=>{qt.style.opacity='1';qt.style.transform='translateY(0)';},300);
setInterval(()=>{qt.style.opacity='0';qt.style.transform='translateY(4px)';setTimeout(()=>{fi=(fi+1)%frases.length;qt.textContent=frases[fi];qt.style.opacity='1';qt.style.transform='translateY(0)';},500);},5000);

// ── WEATHER ──
if(navigator.geolocation){navigator.geolocation.getCurrentPosition(pos=>{const{latitude:lat,longitude:lon}=pos.coords;fetch('https://api.open-meteo.com/v1/forecast?latitude='+lat+'&longitude='+lon+'&current_weather=true&timezone=auto').then(r=>r.json()).then(d=>{const code=d.current_weather.weathercode;const icon=code>=80?'🌧️':code>=61?'🌦️':code>=45?'🌫️':code>=3?'⛅':code>=1?'🌤️':'☀️';document.getElementById('wIcon').textContent=icon;document.getElementById('wTemp').textContent=Math.round(d.current_weather.temperature)+'°';const pill=document.getElementById('weatherPill');if(pill)pill.style.display='inline-flex';fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lon,{headers:{'Accept-Language':'es'}}).then(r=>r.json()).then(g=>{document.getElementById('wCity').textContent=g.address?.city||g.address?.town||'';}).catch(()=>{});}).catch(()=>{});},()=>{},{timeout:6000});}

// ── FILTER ──
function filtH(tipo,btn){document.querySelectorAll('.hx-htab').forEach(t=>t.classList.remove('on'));btn.classList.add('on');document.querySelectorAll('.hx-habit').forEach(h=>{const s=h.getAttribute('data-status');const show=tipo==='todos'||(tipo==='pendientes'&&s==='pending')||(tipo==='completados'&&s==='done');const id=h.id.replace('hb-','');h.style.display=show?'flex':'none';const cw=document.getElementById('cw-'+id);if(cw)cw.style.display=show?'block':'none';});}

// ==================== CONTADOR TIEMPO REAL ====================
const hitos = [
    { seg: 86400, nombre: "1 DÍA" },      // 24h
    { seg: 259200, nombre: "3 DÍAS" },     // 3d
    { seg: 604800, nombre: "1 SEMANA" },   // 7d
    { seg: 864000, nombre: "10 DÍAS" },    // 10d
    { seg: 1209600, nombre: "2 SEMANAS" }, // 14d
    { seg: 2592000, nombre: "1 MES" },     // 30d
    { seg: 7776000, nombre: "3 MESES" },   // 90d
    { seg: 15552000, nombre: "6 MESES" },  // 180d
    { seg: 31536000, nombre: "1 AÑO" }     // 365d
];
// ==================== SUBIR HISTORIA ====================
function openStoryUpload() {
    // Por ahora redirige a la página de crear historia
    // Puedes cambiar esto después por un modal si prefieres
    window.location.href = '/Story/Create';
}

// Opcional: Si quieres un modal bonito en el futuro, avísame y lo creamos
// ==================== SISTEMA DE OBJETIVOS PERSONALIZADOS ====================
let habitObjectives = {}; // Guardará el objetivo elegido por cada hábito (en memoria)

function calcularProgreso(tiempoSeg, habitId = null) {
    let objetivoSeg = 604800; // Por defecto = 7 días

    // Si el usuario ya eligió un objetivo para este hábito
    if (habitId && habitObjectives[habitId]) {
        objetivoSeg = habitObjectives[habitId];
    }

    let porc = Math.min((tiempoSeg / objetivoSeg) * 100, 100);
    
    // Buscar nombre del objetivo actual
    let nombreObjetivo = "Personalizado";
    for (let h of hitos) {
        if (Math.abs(h.seg - objetivoSeg) < 3600) { // tolerancia de 1 hora
            nombreObjetivo = h.nombre;
            break;
        }
    }

    return { 
        porc: Math.floor(porc), 
        nombre: nombreObjetivo,
        objetivoSeg: objetivoSeg 
    };
}
// Abrir selector de objetivo para un hábito
function seleccionarObjetivo(habitId, nombreHabit) {
    const opciones = [
        { seg: 86400,    nombre: "24 Horas" },
        { seg: 259200,   nombre: "3 Días" },
        { seg: 604800,   nombre: "1 Semana" },
        { seg: 1209600,  nombre: "2 Semanas" },
        { seg: 2592000,  nombre: "1 Mes" },
        { seg: 7776000,  nombre: "3 Meses" },
        { seg: 15552000, nombre: "6 Meses" },
        { seg: 31536000, nombre: "1 Año" }
    ];

    let html = `
        <div style="padding:20px;">
            <h3 style="margin-bottom:16px;">🎯 Elige tu objetivo para</h3>
            <strong style="display:block;margin-bottom:16px;">${nombreHabit}</strong>
    `;

    opciones.forEach(op => {
        const dias = Math.round(op.seg / 86400);
        html += `
            <button onclick="aplicarObjetivo(${habitId}, ${op.seg}, '${op.nombre}')" 
                    style="width:100%;padding:14px;margin-bottom:8px;border-radius:16px;border:1px solid #e2e8f0;background:white;font-size:15px;font-weight:600;cursor:pointer;">
                ${op.nombre} <span style="color:#64748b;font-size:13px;">(${dias} días)</span>
            </button>
        `;
    });

    html += `</div>`;

    // Mostrar como modal simple
    const tempModal = document.createElement('div');
    tempModal.style.cssText = `position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:999999;display:flex;align-items:center;justify-content:center;`;
    tempModal.innerHTML = `
        <div style="background:white;border-radius:24px;width:90%;max-width:380px;max-height:85vh;overflow:auto;">
            ${html}
            <div style="padding:16px;text-align:center;">
                <button onclick="this.closest('.modal-temp').remove()" style="padding:10px 24px;border:none;background:#e2e8f0;border-radius:999px;font-weight:700;">Cancelar</button>
            </div>
        </div>
    `;
    tempModal.className = 'modal-temp';
    document.body.appendChild(tempModal);
}

function aplicarObjetivo(habitId, segundos, nombre) {
    habitObjectives[habitId] = segundos;
    document.querySelectorAll('.modal-temp').forEach(m => m.remove());
    
    // Actualizar visualmente
    actualizarTodosLosContadores();
    
    showToast(`Objetivo cambiado a: ${nombre}`);
}
function actualizarTodosLosContadores() {
    const ahora = Date.now() / 1000;
    document.querySelectorAll('.hx-habit').forEach(habitDiv => {
        const startDateStr = habitDiv.getAttribute('data-start-date');
        if (!startDateStr) return;
        const start = new Date(startDateStr).getTime() / 1000;
        if (isNaN(start)) return;
        let diff = ahora - start;
        if (diff < 0) diff = 0;
        const dias = Math.floor(diff / 86400);
        const horas = Math.floor((diff % 86400) / 3600);
        const minutos = Math.floor((diff % 3600) / 60);
        const segundos = Math.floor(diff % 60);
        const timeStr = `${dias}d ${horas.toString().padStart(2,'0')}h ${minutos.toString().padStart(2,'0')}m ${segundos.toString().padStart(2,'0')}s`;
        const habitId = habitDiv.getAttribute('data-habit-id');
        const timeSpan = document.getElementById(`time-${habitId}`);
        if (timeSpan) timeSpan.innerHTML = `⏱️ ${timeStr}`;
        const prog = calcularProgreso(diff);
        const percSpan = document.getElementById(`perc-${habitId}`);
        if (percSpan) percSpan.textContent = `${Math.floor(prog.porc)}%`;
        const goalSpan = document.getElementById(`goal-${habitId}`);
        if (goalSpan) goalSpan.textContent = `Objetivo: ${prog.nombre}`;
    });
}
setInterval(actualizarTodosLosContadores, 1000);
actualizarTodosLosContadores();

// ==================== MODAL HÁBITO ====================
let isEditing = false;
let currentEditId = null;
let escapeHandler = null;

function openCreateModal() {
    isEditing = false;
    currentEditId = null;
    const modal = document.getElementById('habitModal');
    if (!modal) return;
    document.getElementById('habitModalTitle').textContent = '📝 Nuevo hábito';
    document.getElementById('habitNameModal').value = '';
    document.getElementById('editHabitId').value = '0';
    document.getElementById('modalCharCount').textContent = '0';
    document.getElementById('habitModalError').style.display = 'none';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
    document.getElementById('habitNameModal').focus();
    if (escapeHandler) document.removeEventListener('keydown', escapeHandler);
    escapeHandler = (e) => { if (e.key === 'Escape') closeHabitModal(); };
    document.addEventListener('keydown', escapeHandler);
}

function openEditModal(habitId, currentName) {
    isEditing = true;
    currentEditId = habitId;
    const modal = document.getElementById('habitModal');
    if (!modal) return;
    document.getElementById('habitModalTitle').textContent = '✏️ Editar hábito';
    document.getElementById('habitNameModal').value = currentName;
    document.getElementById('editHabitId').value = habitId;
    const len = currentName.length;
    document.getElementById('modalCharCount').textContent = len;
    document.getElementById('habitModalError').style.display = 'none';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
    document.getElementById('habitNameModal').focus();
    if (escapeHandler) document.removeEventListener('keydown', escapeHandler);
    escapeHandler = (e) => { if (e.key === 'Escape') closeHabitModal(); };
    document.addEventListener('keydown', escapeHandler);
}

function closeHabitModal() {
    const modal = document.getElementById('habitModal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
    if (escapeHandler) {
        document.removeEventListener('keydown', escapeHandler);
        escapeHandler = null;
    }
    isEditing = false;
    currentEditId = null;
}

// Eventos del modal
document.getElementById('habitNameModal').addEventListener('input', function() {
    document.getElementById('modalCharCount').textContent = this.value.length;
});
document.querySelectorAll('.habit-sugg').forEach(btn => {
    btn.addEventListener('click', function() {
        document.getElementById('habitNameModal').value = this.getAttribute('data-name');
        document.getElementById('modalCharCount').textContent = this.getAttribute('data-name').length;
    });
});
document.getElementById('saveHabitBtn').addEventListener('click', async function() {
    const name = document.getElementById('habitNameModal').value.trim();
    if (!name) {
        document.getElementById('habitModalError').style.display = 'block';
        return;
    }
    const url = isEditing ? '/Habit/EditAjax' : '/Habit/CreateAjax';
    const data = isEditing ? { id: currentEditId, name: name } : { name: name };
    this.disabled = true;
    this.innerHTML = '⏳ Guardando...';
    try {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
            if (isEditing) {
                const habitDiv = document.querySelector(`.hx-habit[data-habit-id="${currentEditId}"]`);
                if (habitDiv) {
                    const nameLink = habitDiv.querySelector('.hx-hname');
                    if (nameLink) nameLink.textContent = name;
                }
            } else {
                location.reload();
            }
            closeHabitModal();
        } else {
            alert(result.error || 'Error al guardar');
        }
    } catch (err) {
        console.error(err);
        alert('Error de conexión');
    } finally {
        this.disabled = false;
        this.innerHTML = '💾 Guardar';
    }
});

// Reemplazar botones "Editar" y "Nuevo hábito"
function reemplazarBotones() {
    document.querySelectorAll('.hx-ha.ed').forEach(btn => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        if (id && name) {
            btn.onclick = function(e) { e.preventDefault(); openEditModal(parseInt(id), name); return false; };
            btn.removeAttribute('href');
        }
    });
    const newBtns = document.querySelectorAll('#openCreateModalBtn, .hx-hadd, .hx-empty .hx-btn.primary, .hx-btn.primary[onclick*="openCreateModal"]');
    newBtns.forEach(btn => {
        btn.onclick = function(e) { e.preventDefault(); openCreateModal(); return false; };
        btn.removeAttribute('href');
    });
    // también el botón de la historia "Mi historia" que apunta a openCreateModal (ya lo tiene)
}
setTimeout(reemplazarBotones, 100);

// ==================== STORIES ====================
let svStories=[],svIdx=0,svInt=null,svOwner=null,svUser=null;
async function loadStories(){
    try{
        const res=await fetch('/Story/GetFriendsStories');
        const data=await res.json();
        const c=document.getElementById('friendStories');
        if(!c) return;
        c.innerHTML='';
        data.forEach(g=>{
            const pic=g.user.profileImage||g.user.profilePicture||'';
            const item=document.createElement('div');
            item.className='hx-si';
            item.onclick=()=>openSV(g);
            const ring=document.createElement('div');
            ring.className='hx-sring '+(g.hasUnviewed?'fresh':'seen');
            const inner=document.createElement('div');
            inner.className='hx-sinner';
            if(pic){
                inner.innerHTML=`<img src="${pic}" onerror="this.parentElement.innerHTML='<div class=hx-sletter>${g.user.username.charAt(0).toUpperCase()}</div>'" />`;
            }else{
                inner.innerHTML=`<div class="hx-sletter">${g.user.username.charAt(0).toUpperCase()}</div>`;
            }
            ring.appendChild(inner);
            const name=document.createElement('div');
            name.className='hx-sname';
            name.textContent=g.user.username;
            item.appendChild(ring);
            item.appendChild(name);
            c.appendChild(item);
        });
    }catch(e){console.error(e);}
}
function openSV(g){
    svStories=g.stories;
    svIdx=0;
    svOwner=g.user.id;
    svUser=g.user.id;
    const pic=g.user.profileImage||g.user.profilePicture||'';
    const av=document.getElementById('svAv'),avL=document.getElementById('svAvL');
    if(pic){
        av.src=pic;
        av.style.display='block';
        avL.style.display='none';
    }else{
        av.style.display='none';
        avL.style.display='flex';
        avL.textContent=g.user.username.charAt(0).toUpperCase();
    }
    document.getElementById('svUser').textContent=g.user.username;
    document.getElementById('svDel').style.display=g.user.id===myId?'block':'none';
    document.getElementById('storyViewer').style.display='flex';
    document.body.style.overflow='hidden';
    buildBars();
    showS(0);
}
function goProf(){if(svUser)window.location.href='/User/Profile/'+svUser;}
function buildBars(){
    const b=document.getElementById('svBars');
    b.innerHTML='';
    svStories.forEach((_,i)=>{
        const bar=document.createElement('div');
        bar.className='hx-svbar';
        bar.innerHTML=`<div class="hx-svbarfill" id="sbf-${i}"></div>`;
        b.appendChild(bar);
    });
}
function showS(idx){
    if(idx>=svStories.length){closeSV();return;}
    if(idx<0){closeSV();return;}
    svIdx=idx;
    const s=svStories[idx];
    fetch('/Story/View',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(s.id)});
    ['svImg','svVid','svTxt','svVM'].forEach(id=>document.getElementById(id).style.display='none');
    if(s.type==='image'){
        const img=document.getElementById('svImg');
        img.src=s.mediaUrl;
        img.style.display='block';
    }else if(s.type==='video'){
        const v=document.getElementById('svVid');
        v.src=s.mediaUrl;
        v.style.display='block';
        v.play();
        v.onended=()=>{clearInterval(svInt);showS(svIdx+1);};
    }else{
        const t=document.getElementById('svTxt');
        t.textContent=s.textContent;
        t.style.background=s.bgColor||'#5b5ef4';
        t.style.display='flex';
    }
    document.getElementById('svTime').textContent=tAgo(new Date(s.createdAt+'Z'));
    document.getElementById('svCap').textContent=s.caption||'';
    document.getElementById('svHL').textContent=s.isHighlight?'★':'☆';
    const badge=document.getElementById('svVBadge');
    const vm={private:['🔒 Privado','rgba(100,116,139,0.85)'],friends:['👥 Amigos','rgba(91,94,244,0.85)'],public:['🌍 Público','rgba(0,196,140,0.85)']};
    if(vm[s.visibility]){
        badge.textContent=vm[s.visibility][0];
        badge.style.background=vm[s.visibility][1];
        badge.style.color='white';
        badge.style.display='inline-block';
    }else badge.style.display='none';
    const isO=svOwner===myId;
    const vb=document.getElementById('svVBar');
    vb.style.display=isO?'block':'none';
    if(isO)document.getElementById('svViews').textContent='👁 '+(s.views||0)+' vistas';
    const lb=document.getElementById('svLike');
    lb.textContent=s.liked?'❤️':'🤍';
    lb.style.filter=s.liked?'drop-shadow(0 0 8px rgba(239,68,68,0.9))':'none';
    document.getElementById('svLikeCnt').textContent=isO&&s.likes>0?s.likes+' ❤️':'';
    svStories.forEach((_,i)=>{const f=document.getElementById('sbf-'+i);if(f)f.style.width=i<idx?'100%':'0%';});
    startBar(idx,s.duration*1000);
}
function startBar(idx,dur){
    clearInterval(svInt);
    const f=document.getElementById('sbf-'+idx);
    if(!f)return;
    let el=0;
    svInt=setInterval(()=>{
        el+=50;
        f.style.width=Math.min(el/dur*100,100)+'%';
        if(el>=dur){clearInterval(svInt);showS(svIdx+1);}
    },50);
}
function nextS(){clearInterval(svInt);showS(svIdx+1);}
function prevS(){clearInterval(svInt);showS(svIdx-1);}
function closeSV(){
    clearInterval(svInt);
    document.getElementById('storyViewer').style.display='none';
    document.body.style.overflow='';
    const v=document.getElementById('svVid');
    v.pause();v.src='';
}
async function toggleSVLike(){
    const s=svStories[svIdx];
    const btn=document.getElementById('svLike');
    const h=document.getElementById('svHeart');
    const hi=document.getElementById('svHIcon');
    h.style.opacity='1';
    hi.style.animation='none';
    hi.offsetHeight;
    hi.style.animation='heartPop 0.7s ease forwards';
    setTimeout(()=>h.style.opacity='0',800);
    btn.style.transform='scale(1.6)';
    setTimeout(()=>btn.style.transform='scale(1)',300);
    try{
        const res=await fetch('/Story/ToggleLike',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(s.id)});
        const d=await res.json();
        s.liked=d.liked;
        s.likes=d.liked?(s.likes||0)+1:Math.max(0,(s.likes||0)-1);
        btn.textContent=d.liked?'❤️':'🤍';
        btn.style.filter=d.liked?'drop-shadow(0 0 8px rgba(239,68,68,0.9))':'none';
        const isO=svOwner===myId;
        document.getElementById('svLikeCnt').textContent=isO&&s.likes>0?s.likes+' ❤️':'';
    }catch(e){}
}
async function toggleHL(){
    const s=svStories[svIdx];
    try{
        const res=await fetch('/Story/ToggleHighlight',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(s.id)});
        const d=await res.json();
        s.isHighlight=d.isHighlight;
        document.getElementById('svHL').textContent=d.isHighlight?'★':'☆';
    }catch(e){}
}
async function delS(){
    if(!confirm('¿Eliminar esta historia?'))return;
    const s=svStories[svIdx];
    try{
        const res=await fetch('/Story/Delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(s.id)});
        if(!res.ok){alert('Error');return;}
        svStories.splice(svIdx,1);
        if(!svStories.length){closeSV();await loadStories();return;}
        buildBars();
        showS(Math.min(svIdx,svStories.length-1));
        await loadStories();
    }catch(e){console.error(e);}
}
async function openSVViews(){
    const s=svStories[svIdx];
    const m=document.getElementById('svVM');
    if(m.style.display==='block'){m.style.display='none';return;}
    m.innerHTML='<div style="color:rgba(255,255,255,0.3);font-size:11px;text-align:center;padding:14px;">Cargando...</div>';
    m.style.display='block';
    try{
        const res=await fetch('/Story/GetViews?storyId='+s.id);
        const data=await res.json();
        if(!data.length){
            m.innerHTML='<div style="color:rgba(255,255,255,0.3);font-size:12px;text-align:center;padding:16px;">Nadie ha visto tu historia aún</div>';
            return;
        }
        m.innerHTML='<div style="font-size:10px;font-weight:700;color:rgba(255,255,255,0.3);margin-bottom:10px;text-transform:uppercase;letter-spacing:1px;">👁 Visto por</div>'+data.map(v=>`<div style="display:flex;align-items:center;gap:9px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05);">${v.profileImage?`<img src="${v.profileImage}" style="width:32px;height:32px;border-radius:50%;object-fit:cover;flex-shrink:0;"/>`:`<div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#5b5ef4,#3730d9);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;flex-shrink:0;">${v.username.charAt(0).toUpperCase()}</div>`}<div style="flex:1;min-width:0;"><div style="font-size:12px;font-weight:700;color:white;">${v.username}</div><div style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:1px;">${v.viewedAt}</div></div>${v.liked?'<span style="font-size:16px;">❤️</span>':''}</div>`).join('');
    }catch(e){m.innerHTML='<div style="color:#ef4444;font-size:11px;text-align:center;">Error</div>';}
}
function tAgo(d){const diff=Math.floor((Date.now()-d)/60000);if(diff<1)return'ahora';if(diff<60)return'hace '+diff+' min';if(diff<1440)return'hace '+Math.floor(diff/60)+'h';return'hace '+Math.floor(diff/1440)+'d';}

// ── FALL HABIT (sin cambios) ──
async function failHabit(event, habitId, habitName) {
    event.preventDefault();
    if (!confirm(`⚠️ ¿Estás seguro de que has fallado en "${habitName}"?\nEsto reiniciará el contador de tiempo y tu racha actual a 0.`)) return;
    try {
        const res = await fetch(`/Habit/FailHabit/${habitId}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value } });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.message || "Error");
    } catch (err) { alert("Error de conexión"); }
}

function confirmarEliminarHabito(id, nombre) {
    showConfirm({
        icon: '🗑️',
        title: '¿Eliminar hábito?',
        message: `"${nombre}" será eliminado permanentemente junto con todo su historial y rachas.`,
        confirmText: '🗑 Sí, eliminar',
        confirmColor: '#ef4444',
        onConfirm: () => window.location.href = '/Habit/Delete/' + id
    });
}

