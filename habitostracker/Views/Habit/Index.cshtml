    .habits-table-wrap{display:block!important;background:white;border-radius:22px;padding:24px;box-shadow:0 2px 14px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);overflow-x:auto;margin-bottom:20px;}
    .quick-actions .qa-btn.secondary:nth-child(n+2){display:none;}
    body.bg-dark .habits-table-wrap{background:#1e293b!important;border-color:#2d3748!important;}
}
