.hab-btn.complete:hover{background:#16a34a;color:white;}
.hab-btn.fail{background:#fee2e2;color:#dc2626;}
.hab-btn.fail:hover{background:#dc2626;color:white;}
.hab-btn.edit{background:#fef3c7;color:#d97706;}
.hab-btn.edit:hover{background:#d97706;color:white;}
.hab-btn.delete{background:#f3f4f6;color:#6b7280;}
