body.bg-dark .date-val{color:#64748b!important;}
body.bg-dark .comment-input{background:#0f172a!important;border-color:#334155!important;color:#f1f5f9!important;}
body.bg-dark .comment-item{color:#94a3b8!important;}

/* ══ RESPONSIVE ══ */
@@media(max-width:768px){
    .habits-cards-mobile{display:flex;}
    .hero-top { flex-wrap: wrap; }
