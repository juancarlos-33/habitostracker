@model List<HabitTrackerApp.Models.Habit>
@inject HabitTrackerApp.Data.HabitDbContext _context

@if (TempData["Error"] != null)
{
    <div class="ht-alert danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="ht-alert success">@TempData["Success"]</div>
}

@{
    var username = User.Identity?.Name ?? "";
    var user = _context.Users.FirstOrDefault(u => u.Username == username);
    var habits = Model;

    int totalHabits = habits.Count();
    int totalStreak = habits.Sum(h => h.StreakDays);
    int bestRecord = habits.Any() ? habits.Max(h => h.MaxStreak) : 0;
    int completedToday = habits.Count(h => h.LastCheckDate == DateTime.Today && h.Completed);
    int completionRate = totalHabits > 0 ? (int)((completedToday * 100.0) / totalHabits) : 0;

    string welcomeMsg = user?.Gender?.ToLower() == "femenino"
        ? $"Bienvenida, {user.Username} 👋"
        : $"Bienvenido, {user?.Username ?? username} 👋";

    string welcomeClass = user?.Gender?.ToLower() == "femenino" ? "welcome-female"
        : user?.Gender?.ToLower() == "masculino" ? "welcome-male" : "welcome-neutral";

    ViewData["Title"] = "HabitTracker Pro";

    var last7Days = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(-i)).Reverse().ToList();
    var habitIds = habits.Select(h => h.Id).ToList();
    var histories = _context.HabitHistories
        .Where(h => habitIds.Contains(h.HabitId) && h.Date >= DateTime.Today.AddDays(-6))
        .ToList();
    var dailyCompletion = last7Days.Select(date => {
        if (!habits.Any()) return 0;
        int c = histories.Count(h => h.Date.Date == date.Date && h.Completed);
        int f = histories.Count(h => h.Date.Date == date.Date && !h.Completed);
        int t = c + f;
        return t > 0 ? (int)((c * 100.0) / t) : 0;
    }).ToList();
}

<!-- ══ HERO SECTION ══ -->
<div class="hero-section @welcomeClass">
    <div class="hero-bg-dots"></div>
    <div class="hero-top">
        <div class="hero-user">
            <div class="hero-avatar">
                @{ var profileImage = User.FindFirst("ProfileImage")?.Value; }
                @if (!string.IsNullOrEmpty(profileImage))
                { <img src="@profileImage" alt="avatar" /> }
                else
                { <span>@(username.Length > 0 ? username.Substring(0,1).ToUpper() : "?")</span> }
            </div>
            <div class="hero-user-info">
                <div class="hero-greeting">@welcomeMsg</div>
                <div class="hero-sub">Disciplina diaria · Resultados reales</div>
            </div>
        </div>
        @if (user != null)
        {
            if (!user.IsPremium)
            {
                <a href="/User/Pay" class="hero-plan-pill free">⚡ Hazte premium</a>
            }
            else
            {
                <div class="hero-plan-pill premium">👑 Pro</div>
            }
        }
    </div>

    <div class="hero-stats-row">
        <div class="hero-stat">
            <div class="hero-stat-val">@completedToday</div>
            <div class="hero-stat-label">Hoy</div>
        </div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat">
            <div class="hero-stat-val">@totalStreak🔥</div>
            <div class="hero-stat-label">Racha</div>
        </div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat">
            <div class="hero-stat-val">@completionRate%</div>
            <div class="hero-stat-label">Completado</div>
        </div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat">
            <div class="hero-stat-val">@bestRecord🏆</div>
            <div class="hero-stat-label">Récord</div>
        </div>
        <div class="hero-weather-inline" id="weatherInline" style="display:none;">
            <div class="hero-stat-sep"></div>
            <div class="hero-stat">
                <div class="hero-stat-val"><span id="wIcon">⛅</span><span id="wTemp">--</span></div>
                <div class="hero-stat-label" id="wCity">--</div>
            </div>
        </div>
    </div>
</div>

<!-- ══ HISTORIAS ══ -->
<div class="stories-bar" id="storiesBar">
    <div class="story-item" onclick="window.location.href='/Story/Create'">
        <div class="story-avatar-wrap my-story">
            @{ var myPic = User.FindFirst("ProfileImage")?.Value; var myUsername = User.Identity?.Name ?? "Yo"; }
            @if (!string.IsNullOrEmpty(myPic))
            { <img src="@myPic" class="story-avatar-img"/> }
            else
            { <div class="story-avatar-letter">@myUsername.Substring(0,1).ToUpper()</div> }
            <div class="story-add-btn">+</div>
        </div>
        <div class="story-name">Tu historia</div>
    </div>
    <div id="friendStories"></div>
</div>

<!-- VISOR DE HISTORIAS -->
<div id="storyViewer" class="story-viewer" style="display:none;">
    <div class="story-viewer-bg" onclick="closeStoryViewer()"></div>
    <div class="story-viewer-card">
        <div class="story-progress-bars" id="storyProgressBars"></div>
        <div class="story-viewer-header">
            <div style="display:flex;align-items:center;gap:10px;">
                <img id="svAvatar" style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid white;"/>
                <div>
                    <div id="svUsername" style="font-size:13px;font-weight:700;color:white;"></div>
                    <div id="svTime" style="font-size:11px;color:rgba(255,255,255,0.6);"></div>
                </div>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
                <button id="svHighlight" onclick="toggleHighlight()" style="background:none;border:none;color:white;font-size:20px;cursor:pointer;">☆</button>
                <button id="svDelete" onclick="deleteCurrentStory()" style="background:none;border:none;color:white;font-size:18px;cursor:pointer;display:none;">🗑</button>
                <button onclick="closeStoryViewer()" style="background:none;border:none;color:white;font-size:22px;cursor:pointer;">✕</button>
            </div>
        </div>
        <div class="story-viewer-content" id="svContent">
            <img id="svImg" style="display:none;width:100%;height:100%;object-fit:cover;"/>
            <video id="svVideo" style="display:none;width:100%;height:100%;object-fit:cover;" playsinline muted></video>
            <div id="svText" style="display:none;width:100%;height:100%;align-items:center;justify-content:center;padding:32px;text-align:center;font-size:22px;font-weight:800;color:white;line-height:1.4;word-break:break-word;"></div>
        </div>
        <div class="story-nav-left" onclick="prevStory()"></div>
        <div class="story-nav-right" onclick="nextStory()"></div>
        <div id="svCaption" style="position:absolute;bottom:44px;left:16px;right:16px;z-index:10;font-size:13px;color:white;font-weight:600;text-shadow:0 1px 4px rgba(0,0,0,0.5);text-align:center;"></div>
        <div class="story-views-bar">
            <span id="svViews">👁 0 vistas</span>
        </div>
    </div>
</div>

<!-- ══ QUOTE ══ -->
<div class="quote-pill">
    <span class="quote-star">✨</span>
    <p class="quote-text" id="quoteText"></p>
</div>

<!-- ══ QUICK ACTIONS (móvil) ══ -->
<div class="quick-actions">
    @if (user != null && (user.IsPremium || Model.Count < 5))
    {
        <a href="/Habit/Create" class="qa-btn primary">➕ Nuevo hábito</a>
    }
    else
    {
        <a href="/User/Pay" class="qa-btn locked">🔒 Premium</a>
    }
    <a href="/Habit/History" class="qa-btn secondary">📅 Historial</a>
    <a href="/Habit/Statistics" class="qa-btn secondary">📈 Stats</a>
</div>

<!-- ══ KPI GRID ══ -->
<div class="kpi-row">
    <a href="/Habit/Index" class="kpi-card">
        <div class="kpi-icon-wrap blue"><span>📋</span></div>
        <div class="kpi-info">
            <div class="kpi-val">@totalHabits</div>
            <div class="kpi-lbl">Hábitos</div>
        </div>
    </a>
    <a href="/Habit/Statistics" class="kpi-card">
        <div class="kpi-icon-wrap green"><span>🔥</span></div>
        <div class="kpi-info">
            <div class="kpi-val green">@totalStreak</div>
            <div class="kpi-lbl">Racha</div>
        </div>
    </a>
    <a href="/Habit/Calendar" class="kpi-card">
        <div class="kpi-icon-wrap purple"><span>⚡</span></div>
        <div class="kpi-info">
            <div class="kpi-val purple">@completionRate%</div>
            <div class="kpi-lbl">Hoy</div>
        </div>
    </a>
    <a href="/Habit/Achievements" class="kpi-card">
        <div class="kpi-icon-wrap gold"><span>🏆</span></div>
        <div class="kpi-info">
            <div class="kpi-val gold">@bestRecord</div>
            <div class="kpi-lbl">Récord</div>
        </div>
    </a>
</div>

<!-- ══ HÁBITOS ══ -->
<div class="habits-section">
    <div class="section-header">
        <div class="section-title">Mis hábitos</div>
        @if (user != null && (user.IsPremium || Model.Count < 5))
        {
            <a href="/Habit/Create" class="section-add">+ Nuevo</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-habits">
            <div class="empty-emoji">🌱</div>
            <div class="empty-title">Empieza tu primer hábito</div>
            <div class="empty-sub">Pequeños pasos generan grandes cambios</div>
            <a href="/Habit/Create" class="qa-btn primary" style="margin-top:16px;display:inline-flex;">➕ Crear hábito</a>
        </div>
    }
    else
    {
        @if (user != null && !user.IsPremium && Model.Count >= 5)
        {
            <div class="limit-pill">
                🚫 Límite alcanzado · <a href="/User/Pay">Hazte Premium 🔥</a>
            </div>
        }

        <!-- MÓVIL: cards verticales -->
        <div class="habits-cards-mobile">
            @foreach (var habit in Model)
            {
                bool done = habit.LastCheckDate == DateTime.Today && habit.Completed;
                bool failed = habit.LastCheckDate == DateTime.Today && !habit.Completed;
                string statusClass = done ? "done" : failed ? "failed" : "pending";
                string statusLabel = done ? "✔ Completado" : failed ? "✖ Fallado" : "⏳ Pendiente";

                <div class="habit-card @statusClass">
                    <div class="habit-card-top">
                        <div class="habit-card-info">
                            <a href="/Habit/Detail/@habit.Id" class="habit-card-name">@habit.Name</a>
                            <div class="habit-card-meta">
                                <span class="habit-streak">🔥 @habit.StreakDays días</span>
                                <span class="habit-record">🏆 @habit.MaxStreak máx</span>
                            </div>
                        </div>
                        <span class="habit-status-badge @statusClass">@statusLabel</span>
                    </div>
                    <div class="habit-card-actions">
                        <a href="/Habit/Complete/@habit.Id" class="hca-btn complete" title="Completar">✔ Hecho</a>
                        <a href="/Habit/Fail/@habit.Id" class="hca-btn fail" title="Fallar">✖ Fallar</a>
                        <a href="/Habit/Edit/@habit.Id" class="hca-btn edit" title="Editar">✏</a>
                        <a href="/Habit/Delete/@habit.Id" class="hca-btn delete" data-no-loader="true"
                           onclick="if(!confirm('¿Eliminar?')) return false;" title="Eliminar">🗑</a>
                    </div>
                    <div class="habit-comment-area">
                        <form asp-action="AddComment" method="post" class="habit-comment-form">
                            <input type="hidden" name="habitId" value="@habit.Id" />
                            <input type="text" name="content" class="habit-comment-input" placeholder="💬 Comentario..." />
                        </form>
                        @if (habit.Comments != null && habit.Comments.Any())
                        {
                            foreach (var c in habit.Comments.OrderByDescending(x => x.CreatedAt).Take(2))
                            {
                                <div class="habit-comment-item">
                                    <b>@c.User.Username</b> @c.Content
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <!-- PC: tabla clásica -->
        <div class="habits-table-wrap">
            @if (user != null && !user.IsPremium && Model.Count >= 5)
            {
                <div class="limit-pill">🚫 Límite alcanzado · <a href="/User/Pay">Hazte Premium 🔥</a></div>
            }
            <table class="habits-table">
                <thead>
                    <tr>
                        <th>HÁBITO</th><th>ESTADO</th><th>RACHA</th><th>RÉCORD</th><th>CREADO</th><th class="text-center">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var habit in Model)
                    {
                        <tr>
                            <td class="habit-name">
                                <a href="/Habit/Detail/@habit.Id" style="color:inherit;text-decoration:none;font-weight:600;display:flex;align-items:center;gap:6px;">
                                    @habit.Name
                                    <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:rgba(99,102,241,0.1);color:#6366f1;font-weight:700;">Ver →</span>
                                </a>
                            </td>
                            <td>
                                @if (habit.LastCheckDate == DateTime.Today && habit.Completed)
                                { <span class="status-badge success">✔ Completado</span> }
                                else if (habit.LastCheckDate == DateTime.Today && !habit.Completed)
                                { <span class="status-badge danger">✖ Fallado</span> }
                                else
                                { <span class="status-badge pending">⏳ Pendiente</span> }
                            </td>
                            <td class="streak-val">@habit.StreakDays 🔥</td>
                            <td class="record-val">@habit.MaxStreak 🏆</td>
                            <td class="date-val">@habit.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <div class="action-btns">
                                    <a href="/Habit/Complete/@habit.Id" class="hab-btn complete">✔</a>
                                    <a href="/Habit/Fail/@habit.Id" class="hab-btn fail">✖</a>
                                    <a asp-action="Edit" asp-route-id="@habit.Id" class="hab-btn edit">✏</a>
                                    <a asp-action="Delete" asp-route-id="@habit.Id" class="hab-btn delete" data-no-loader="true" onclick="if(!confirm('¿Eliminar?')) return false;">🗑</a>
                                </div>
                            </td>
                        </tr>
                        <tr class="comment-row">
                            <td colspan="6">
                                <form asp-action="AddComment" method="post" class="comment-form">
                                    <input type="hidden" name="habitId" value="@habit.Id" />
                                    <input type="text" name="content" class="comment-input" placeholder="💬 Comentario..." />
                                </form>
                                @if (habit.Comments != null && habit.Comments.Any())
                                {
                                    foreach (var c in habit.Comments.OrderByDescending(x => x.CreatedAt))
                                    { <div class="comment-item"><b>@c.User.Username:</b> @c.Content</div> }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ══ CHART ══ -->
<div class="chart-section">
    <div class="section-header">
        <div class="section-title">📈 Progreso últimos 7 días</div>
    </div>
    <div class="chart-wrap">
        <canvas id="habitChart"></canvas>
    </div>
</div>

@section Scripts {
<script>
const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(last7Days.Select(d => d.ToString("dd/MM"))));
const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dailyCompletion));
const isDark = document.body.classList.contains('bg-dark');
const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.04)';
const textColor = isDark ? '#64748b' : '#9ca3af';

new Chart(document.getElementById('habitChart'), {
    type: 'line',
    data: {
        labels,
        datasets: [{
            data,
            borderWidth: 3, tension: 0.4, fill: true,
            pointRadius: 5, pointHoverRadius: 7,
            pointBackgroundColor: '#6366f1',
            backgroundColor: 'rgba(99,102,241,0.1)',
            borderColor: '#6366f1'
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ctx.parsed.y + '% completado' } } },
        scales: {
            y: { beginAtZero: true, max: 100, ticks: { color: textColor, callback: v => v + '%' }, grid: { color: gridColor } },
            x: { ticks: { color: textColor }, grid: { color: gridColor } }
        }
    }
});
// ══ SONIDO AL COMPLETAR HÁBITO ══
document.querySelectorAll('.hab-btn.complete, .hca-btn.complete').forEach(btn => {
    btn.addEventListener('click', function(e) {
        e.preventDefault();
        const href = this.getAttribute('href');
        HabitSounds.complete();
        setTimeout(() => window.location.href = href, 350);
    });
});

// FRASES
const frases = ["La disciplina es el puente entre metas y logros. 🚀","Cada día es una nueva oportunidad para mejorar. 💪","Los pequeños hábitos crean grandes cambios. 🌱","El éxito no es un destino, es un hábito diario. 🏆","No necesitas ser perfecto, solo consistente. 🔥","Un hábito a la vez. Un día a la vez. ⚡","La constancia vence al talento cuando el talento no es constante. 🎯","Tu futuro depende de lo que hagas hoy. 💡","La motivación te arranca, el hábito te mantiene. 🛤️","El dolor de la disciplina es menor que el dolor del arrepentimiento. 💎","Sé la mejor versión de ti mismo, cada día. 🌟","No cuentes los días, haz que los días cuenten. ⏳","Cae siete veces, levántate ocho. 🥊","El éxito es la suma de pequeños esfuerzos repetidos cada día. 📈","La única forma de hacer un gran trabajo es amar lo que haces. ❤️","Primero forma el hábito, luego el hábito te forma a ti. 🔄","El progreso, no la perfección, es el objetivo. 📊","Los hábitos son el interés compuesto del auto-mejoramiento. 📉","La excelencia no es un acto, es un hábito. 👌","Comienza donde estás, usa lo que tienes, haz lo que puedas. 🛠️"];
let fi = Math.floor(Math.random() * frases.length);
const qt = document.getElementById("quoteText");
qt.textContent = frases[fi];
setTimeout(() => { qt.style.opacity = "1"; qt.style.transform = "translateY(0)"; }, 100);
setInterval(() => {
    qt.style.opacity = "0"; qt.style.transform = "translateY(6px)";
    setTimeout(() => { fi = (fi+1)%frases.length; qt.textContent = frases[fi]; qt.style.opacity = "1"; qt.style.transform = "translateY(0)"; }, 500);
}, 4000);

// CLIMA
if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
        const {latitude: lat, longitude: lon} = pos.coords;
        fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&timezone=auto`)
            .then(r => r.json()).then(d => {
                const icons = {200:"⛈️",300:"🌦️",500:"🌧️",600:"❄️",700:"🌫️",800:"☀️",801:"🌤️"};
                const code = d.current_weather.weathercode;
                const icon = code >= 802 ? "⛅" : icons[Object.keys(icons).reverse().find(k => code >= k)] || "🌡️";
                document.getElementById("wIcon").textContent = icon;
                document.getElementById("wTemp").textContent = Math.round(d.current_weather.temperature) + "°";
                document.getElementById("weatherInline").style.display = "flex";
                fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`, {headers:{"Accept-Language":"es"}})
                    .then(r => r.json()).then(g => {
                        document.getElementById("wCity").textContent = g.address?.city || g.address?.town || g.address?.village || "📍";
                    }).catch(()=>{});
            }).catch(()=>{});
    }, ()=>{}, {timeout:6000});
}
</script>
}

<style>
/* ══ RESET BASE ══ */
.ht-alert { padding: 12px 18px; border-radius: 14px; margin-bottom: 16px; font-size: 14px; font-weight: 600; }
.ht-alert.danger { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }
.ht-alert.success { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }

/* ══ HERO ══ */
.hero-section {
    border-radius: 24px; padding: 22px 20px 18px;
    margin-bottom: 14px; position: relative; overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,0.2);
}
.hero-bg-dots {
    position: absolute; inset: 0; opacity: 0.06;
    background-image: radial-gradient(circle, white 1px, transparent 1px);
    background-size: 20px 20px; pointer-events: none;
}
.welcome-male { background: linear-gradient(135deg, #1d4ed8, #2563eb, #3b82f6); }
.welcome-female { background: linear-gradient(135deg, #9d174d, #ec4899, #f472b6); }
.welcome-neutral { background: linear-gradient(135deg, #4338ca, #6366f1, #818cf8); }

.hero-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; gap: 10px; }
.hero-user { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; }
.hero-avatar {
    width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0;
    background: rgba(255,255,255,0.25); border: 2.5px solid rgba(255,255,255,0.4);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; font-weight: 800; color: white; overflow: hidden;
    box-shadow: 0 4px 14px rgba(0,0,0,0.2);
}
.hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
.hero-greeting { font-size: 16px; font-weight: 800; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hero-sub { font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 2px; }

.hero-plan-pill {
    flex-shrink: 0; padding: 5px 12px; border-radius: 20px;
    font-size: 11px; font-weight: 800; text-decoration: none;
    white-space: nowrap;
}
.hero-plan-pill.free {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white;
    border: none;
    box-shadow: 0 4px 12px rgba(99,102,241,0.4);
    font-size: 12px;
    padding: 7px 14px;
}
.hero-plan-pill.free:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(99,102,241,0.5);
    color: white;
}
.hero-plan-pill.premium {
    background: linear-gradient(135deg, rgba(234,179,8,0.25), rgba(251,191,36,0.15));
    color: #fde68a;
    border: 1px solid rgba(234,179,8,0.4);
    font-size: 12px;
    padding: 7px 14px;
    box-shadow: 0 4px 12px rgba(234,179,8,0.2);
}

.hero-stats-row {
    display: flex; align-items: center; gap: 0;
    background: rgba(0,0,0,0.15); border-radius: 16px;
    padding: 12px 16px; backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.08);
}
.hero-stat { flex: 1; text-align: center; }
