.habit-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px;}
.habit-card-name{font-size:15px;font-weight:800;color:#111827;text-decoration:none;display:block;margin-bottom:4px;}
.habit-card-name:hover{color:#6366f1;}
.habit-card-meta{display:flex;gap:10px;}
.habit-streak,.habit-record{font-size:12px;font-weight:700;color:#6b7280;}
.habit-status-badge{flex-shrink:0;font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;white-space:nowrap;}
.habit-status-badge.done{background:#dcfce7;color:#16a34a;}
.habit-status-badge.failed{background:#fee2e2;color:#dc2626;}
.habit-status-badge.pending{background:#ede9fe;color:#6366f1;}
