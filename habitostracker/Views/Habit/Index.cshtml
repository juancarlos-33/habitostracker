.habits-table-wrap{display:block;}
.habit-card{background:white;border-radius:18px;padding:16px;box-shadow:0 2px 12px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.05);border-left:4px solid #e5e7eb;transition:0.2s;}
.habit-card.done{border-left-color:#22c55e;}
.habit-card.failed{border-left-color:#ef4444;}
