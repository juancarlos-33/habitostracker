/* ===== CORRECCIÓN DEFINITIVA para móvil (Racha, Mejor racha, Estadísticas, Exportar, Logros) ===== */
@@media (max-width: 768px) {
    /* KPI: Racha acumulada y Mejor racha */
    .hx-kpi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }
    .hx-kpi {
        padding: 12px 6px;
        flex-direction: column;
        text-align: center;
        gap: 6px;
    }
    .hx-kico {
        width: 32px;
        height: 32px;
        font-size: 16px;
        margin: 0 auto;
    }
    .hx-kval {
        font-size: 16px;
        line-height: 1.2;
        white-space: normal;
        word-break: break-word;
    }
    .hx-klbl {
        font-size: 9px !important;
        white-space: normal !important;
        word-break: break-word !important;
        line-height: 1.3;
        display: inline-block;
        max-width: 100%;
    }
    /* Ajuste específico para textos largos como "Racha acumulada" */
    .hx-kpi.kg .hx-klbl,
    .hx-kpi.kd .hx-klbl {
        font-size: 8.5px !important;
        letter-spacing: -0.2px;
    }

    /* ACCIONES: Estadísticas, Exportar, Logros */
    .hx-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        justify-content: center;
    }
    .hx-btn, .hx-btn.locked {
        flex: 0 0 auto;
        min-width: 70px;
        max-width: calc(33% - 6px);
        padding: 6px 8px;
        font-size: 11px;
        white-space: normal !important;
        word-break: break-word;
        text-align: center;
        line-height: 1.3;
        box-sizing: border-box;
    }
    /* Para los elementos bloqueados (Estadísticas y Exportar) */
    .hx-btn.locked {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        gap: 4px;
        background: rgba(100, 116, 139, 0.1);
        border-color: rgba(100, 116, 139, 0.3);
        color: #94a3b8;
        cursor: not-allowed;
        pointer-events: none;
    }
    /* Logros (enlace ghost) */
    .hx-btn.ghost {
        padding: 6px 8px;
        font-size: 11px;
    }
}
</style>

<div class="hx-page">

<!-- HERO -->
<div class="hx-hero">
    <div class="hx-hero-bg">
        <div class="hx-hero-base"></div>
        <div class="hx-hero-mesh"></div>
        <div class="hx-hero-grid"></div>
        <div class="hx-orb hx-orb-1"></div>
        <div class="hx-orb hx-orb-2"></div>
    </div>
    <div class="hx-hero-inner">
        <div class="hx-hero-top">
            <div class="hx-hero-id">
                <div class="hx-av" onclick="window.location.href='/Account/Profile'">
                    @{ var profileImage = User.FindFirst("ProfileImage")?.Value; }
                    @if (!string.IsNullOrEmpty(profileImage)) { <img src="@profileImage" alt="av" /> }
                    else { <span>@(username.Length > 0 ? username.Substring(0,1).ToUpper() : "?")</span> }
                </div>
                <div class="hx-hero-txt">
                    <div class="hx-hero-greeting">@greeting</div>
                    <div class="hx-hero-name">@welcomeMsg</div>
                </div>
            </div>
            <div class="hx-hero-right">
                <div class="hx-wpill" id="weatherPill">
                    <span id="wIcon">⛅</span>
                    <span id="wTemp"></span>
                    <span id="wCity" style="font-size:9px;opacity:0.6;margin-left:2px;"></span>
                </div>
                @if (isPremium)
                { <div class="hx-ppill pro">👑 Pro</div> }
                else
                { <a href="/User/Pay" class="hx-ppill free">⚡ Premium</a> }
            </div>
        </div>
        <div class="hx-stats">
            <div class="hx-stat">
                <div class="hx-stat-val">@completedToday<span style="font-size:10px;opacity:0.45;font-weight:500;">/@totalHabits</span></div>
                <div class="hx-stat-lbl">Hoy</div>
            </div>
            <div class="hx-stat">
                <div class="hx-stat-val">@totalStreak<span style="font-size:13px;">🔥</span></div>
                <div class="hx-stat-lbl">Racha</div>
            </div>
            <div class="hx-stat ring">
                <svg class="hx-rsvg" viewBox="0 0 28 28">
                    <circle class="hx-rbg" cx="14" cy="14" r="11"/>
                    <circle class="hx-rfill" id="progressRing" cx="14" cy="14" r="11" stroke-dasharray="69.1" stroke-dashoffset="69.1"/>
                </svg>
                <div class="hx-stat-val">@completionRate<span style="font-size:10px;">%</span></div>
                <div class="hx-stat-lbl">Tasa</div>
            </div>
            <div class="hx-stat">
                <div class="hx-stat-val">@bestRecord<span style="font-size:13px;">🏆</span></div>
                <div class="hx-stat-lbl">Récord</div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL HÁBITO (se renderiza aquí) -->
<div id="habitModal" class="habit-modal" style="display:none;">
