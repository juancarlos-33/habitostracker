<script>
document.addEventListener("DOMContentLoaded", function () {
    if (document.referrer.includes('/Story/Create')) {
        history.pushState(null, null, location.href);
        window.onpopstate = function () { history.go(1); };
    }
});

const myUserId = @(int.Parse(User.FindFirst("UserId").Value));
let currentUserStories = [], currentStoryIndex = 0, storyProgressInterval = null, currentStoryOwnerId = null, currentStoryUserId = null;

async function loadFriendStories() {
    try {
        const res = await fetch('/Story/GetFriendsStories');
        const data = await res.json();
        const container = document.getElementById('friendStories');
        if (!container) return;
        container.innerHTML = '';
        data.forEach(group => {
            const pic = group.user.profileImage || group.user.profilePicture || '';
            const item = document.createElement('div');
            item.className = 'story-item';
            item.onclick = () => openStoryViewer(group);
            const wrap = document.createElement('div');
            wrap.className = 'story-avatar-wrap' + (group.hasUnviewed ? '' : ' viewed');
            wrap.innerHTML = pic
                ? '<img src="' + pic + '" class="story-avatar-img" onerror="this.parentElement.innerHTML=\'<div class=story-avatar-letter>'+group.user.username.charAt(0).toUpperCase()+'</div>\'"/>'
                : '<div class="story-avatar-letter">' + group.user.username.charAt(0).toUpperCase() + '</div>';
            const name = document.createElement('div');
            name.className = 'story-name';
            name.textContent = group.user.username;
            item.appendChild(wrap);
            item.appendChild(name);
            container.appendChild(item);
        });
    } catch(e) { console.error(e); }
}

function openStoryViewer(group) {
    currentUserStories = group.stories;
    currentStoryIndex = 0;
    currentStoryOwnerId = group.user.id;
    currentStoryUserId = group.user.id;

    const pic = group.user.profileImage || group.user.profilePicture || '';
    const avatarImg = document.getElementById('svAvatar');
    const avatarLetter = document.getElementById('svAvatarLetter');
    if (pic) {
        avatarImg.src = pic;
        avatarImg.style.display = 'block';
        avatarLetter.style.display = 'none';
    } else {
        avatarImg.style.display = 'none';
        avatarLetter.style.display = 'flex';
        avatarLetter.textContent = group.user.username.charAt(0).toUpperCase();
    }

    document.getElementById('svUsername').textContent = group.user.username;
    document.getElementById('svDelete').style.display = group.user.id === myUserId ? 'block' : 'none';
    document.getElementById('storyViewer').style.display = 'flex';
    document.body.style.overflow = 'hidden';
    buildProgressBars();
    showStory(0);
}

function goToProfile() {
    if (currentStoryUserId) window.location.href = '/User/Profile/' + currentStoryUserId;
}

function buildProgressBars() {
    const bars = document.getElementById('storyProgressBars');
    bars.innerHTML = '';
    currentUserStories.forEach((_, i) => {
        const bar = document.createElement('div');
        bar.className = 'story-progress-bar';
        bar.innerHTML = '<div class="story-progress-fill" id="progress-' + i + '"></div>';
        bars.appendChild(bar);
    });
}

function showStory(index) {
    if (index >= currentUserStories.length) { closeStoryViewer(); return; }
    if (index < 0) { closeStoryViewer(); return; }
    currentStoryIndex = index;
    const story = currentUserStories[index];

    fetch('/Story/View', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(story.id)});

    document.getElementById('svImg').style.display = 'none';
    document.getElementById('svVideo').style.display = 'none';
    document.getElementById('svText').style.display = 'none';
    document.getElementById('storyViewsModal').style.display = 'none';

    if (story.type === 'image') {
        const img = document.getElementById('svImg');
        img.src = story.mediaUrl;
        img.style.display = 'block';
    } else if (story.type === 'video') {
        const vid = document.getElementById('svVideo');
        vid.src = story.mediaUrl;
        vid.style.display = 'block';
        vid.play();
        vid.onended = () => { clearInterval(storyProgressInterval); showStory(currentStoryIndex + 1); };
    } else {
        const txt = document.getElementById('svText');
        txt.textContent = story.textContent;
        txt.style.background = story.bgColor || '#6366f1';
        txt.style.display = 'flex';
    }

    document.getElementById('svTime').textContent = getTimeAgo(new Date(story.createdAt + 'Z'));
    document.getElementById('svCaption').textContent = story.caption || '';
    document.getElementById('svHighlight').textContent = story.isHighlight ? '★' : '☆';

    const badge = document.getElementById('svVisibilityBadge');
    const visMap = {
        private: ['🔒 Privado', 'rgba(100,116,139,0.85)'],
        friends: ['👥 Amigos',  'rgba(99,102,241,0.85)'],
        public:  ['🌍 Público', 'rgba(34,197,94,0.85)']
    };
    if (visMap[story.visibility]) {
        badge.textContent = visMap[story.visibility][0];
        badge.style.background = visMap[story.visibility][1];
        badge.style.color = 'white';
        badge.style.display = 'inline-block';
    } else { badge.style.display = 'none'; }

    const isOwner = currentStoryOwnerId === myUserId;
    const viewsBar = document.getElementById('svViewsBar');
    viewsBar.style.display = isOwner ? 'block' : 'none';
    if (isOwner) document.getElementById('svViews').textContent = '👁 ' + (story.views || 0) + ' vistas';

    const likeBtn = document.getElementById('svLikeBtn');
    likeBtn.textContent = story.liked ? '❤️' : '🤍';
    likeBtn.style.filter = story.liked ? 'drop-shadow(0 0 8px rgba(239,68,68,0.9))' : 'none';
    document.getElementById('svLikesCount').textContent = story.likes > 0 ? story.likes + ' ❤️' : '';

    currentUserStories.forEach((_, i) => {
        const fill = document.getElementById('progress-' + i);
        if (fill) fill.style.width = i < index ? '100%' : '0%';
    });
    startProgress(index, story.duration * 1000);
}

function startProgress(index, duration) {
    clearInterval(storyProgressInterval);
    const fill = document.getElementById('progress-' + index);
    if (!fill) return;
    let elapsed = 0;
    storyProgressInterval = setInterval(() => {
        elapsed += 50;
        fill.style.width = Math.min((elapsed / duration * 100), 100) + '%';
        if (elapsed >= duration) { clearInterval(storyProgressInterval); showStory(currentStoryIndex + 1); }
    }, 50);
}

function nextStory() { clearInterval(storyProgressInterval); showStory(currentStoryIndex + 1); }
function prevStory() { clearInterval(storyProgressInterval); showStory(currentStoryIndex - 1); }

function closeStoryViewer() {
    clearInterval(storyProgressInterval);
    document.getElementById('storyViewer').style.display = 'none';
    document.body.style.overflow = '';
    const vid = document.getElementById('svVideo');
    vid.pause(); vid.src = '';
}

async function toggleStoryLike() {
    const story = currentUserStories[currentStoryIndex];
    const btn = document.getElementById('svLikeBtn');
    const anim = document.getElementById('svHeartAnim');
    const icon = document.getElementById('svHeartAnimIcon');

    anim.style.opacity = '1';
    icon.style.animation = 'none';
    icon.offsetHeight;
    icon.style.animation = 'heartPop 0.7s ease forwards';
    setTimeout(() => { anim.style.opacity = '0'; }, 800);

    btn.style.transform = 'scale(1.6)';
    setTimeout(() => btn.style.transform = 'scale(1)', 300);

    try {
        const res = await fetch('/Story/ToggleLike', {
            method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(story.id)
        });
        const data = await res.json();
        story.liked = data.liked;
        story.likes = data.liked ? (story.likes || 0) + 1 : Math.max(0, (story.likes || 0) - 1);
        btn.textContent = data.liked ? '❤️' : '🤍';
        btn.style.filter = data.liked ? 'drop-shadow(0 0 8px rgba(239,68,68,0.9))' : 'none';
        document.getElementById('svLikesCount').textContent = story.likes > 0 ? story.likes + ' ❤️' : '';
    } catch(e) { console.error(e); }
}

async function toggleHighlight() {
    const story = currentUserStories[currentStoryIndex];
    try {
        const res = await fetch('/Story/ToggleHighlight', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(story.id)});
        const data = await res.json();
        story.isHighlight = data.isHighlight;
        document.getElementById('svHighlight').textContent = data.isHighlight ? '★' : '☆';
    } catch(e) {}
}

async function deleteCurrentStory() {
    if (!confirm('¿Eliminar esta historia?')) return;
    const story = currentUserStories[currentStoryIndex];
    try {
        const res = await fetch('/Story/Delete', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(story.id)});
        if (!res.ok) { alert('Error al eliminar'); return; }
        currentUserStories.splice(currentStoryIndex, 1);
        if (!currentUserStories.length) { closeStoryViewer(); await loadFriendStories(); return; }
        buildProgressBars();
        showStory(Math.min(currentStoryIndex, currentUserStories.length - 1));
        await loadFriendStories();
    } catch(e) { console.error(e); }
}

async function openStoryViews() {
    const story = currentUserStories[currentStoryIndex];
    const modal = document.getElementById('storyViewsModal');
    const list = document.getElementById('storyViewsList');
    if (modal.style.display === 'block') { modal.style.display = 'none'; return; }
    list.innerHTML = '<div style="color:rgba(255,255,255,0.35);font-size:12px;text-align:center;padding:14px;">Cargando...</div>';
    modal.style.display = 'block';
    try {
        const res = await fetch('/Story/GetViews?storyId=' + story.id);
        const data = await res.json();
        if (!data.length) {
            list.innerHTML = '<div style="color:rgba(255,255,255,0.3);font-size:13px;text-align:center;padding:18px;">Nadie ha visto tu historia aún</div>';
            return;
        }
        list.innerHTML = data.map(v =>
            '<div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,0.05);">' +
            (v.profileImage
                ? '<img src="' + v.profileImage + '" style="width:34px;height:34px;border-radius:50%;object-fit:cover;flex-shrink:0;"/>'
                : '<div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;">' + v.username.charAt(0).toUpperCase() + '</div>'
            ) +
            '<div style="flex:1;min-width:0;">' +
            '<div style="font-size:13px;font-weight:700;color:white;">' + v.username + '</div>' +
            '<div style="font-size:11px;color:rgba(255,255,255,0.35);margin-top:1px;">' + v.viewedAt + '</div>' +
            '</div>' +
            (v.liked ? '<span style="font-size:18px;flex-shrink:0;filter:drop-shadow(0 0 4px rgba(239,68,68,0.6));">❤️</span>' : '') +
            '</div>'
        ).join('');
    } catch(e) {
        list.innerHTML = '<div style="color:#ef4444;font-size:12px;text-align:center;">Error al cargar</div>';
    }
}

function getTimeAgo(date) {
    const diff = Math.floor((Date.now() - date) / 60000);
    if (diff < 1) return 'ahora';
    if (diff < 60) return 'hace ' + diff + ' min';
    if (diff < 1440) return 'hace ' + Math.floor(diff/60) + 'h';
    return 'hace ' + Math.floor(diff/1440) + 'd';
}

document.addEventListener('DOMContentLoaded', function() {
    if (!@(isGuest ? "true" : "false")) loadFriendStories();
});
</script>