@model List<HabitTrackerApp.Models.HabitHistory>

@{
    ViewData["Title"] = "Historial";
}

<div class="hist-page">

    <div class="hist-header">
        <div class="hist-icon">📅</div>
        <div>
            <h2 class="hist-title">Historial de Hábitos</h2>
            <p class="hist-subtitle">Revisa tu progreso día a día</p>
        </div>
    </div>

    <div class="hist-filter-card">
        <form method="get" class="hist-filter-form">
            <div class="hist-filter-group">
                <label class="hist-filter-label">Seleccionar fecha</label>
                <input type="date" name="date" class="hist-date-input"
                       value="@(ViewBag.SelectedDate != null ? ((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="hist-filter-btns">
                <button type="submit" class="hist-btn-primary">🔍 Filtrar</button>
                <a asp-action="History" class="hist-btn-secondary">Limpiar</a>
            </div>
        </form>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="hist-empty">
            <div class="hist-empty-icon">😶</div>
            <p class="hist-empty-text">No hay registros para este día.</p>
        </div>
    }
    else
    {
        <div class="hist-table-card">
            <table class="hist-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Hábito</th>
                        <th class="hist-th-center">Resultado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="hist-date-main">@item.Date.ToString("dd MMM, yyyy")</div>
                                <div class="hist-date-day">@item.Date.ToString("dddd")</div>
                            </td>
                            <td class="hist-habit-name">@item.HabitName</td>
                            <td class="hist-th-center">
                                @if (item.Completed)
                                {
                                    <span class="hist-pill hist-pill-ok">✔ Completado</span>
                                }
                                else
                                {
                                    <span class="hist-pill hist-pill-fail">✕ Fallado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

      <div class="hist-footer">
    <span class="hist-count">@Model.Count registro@(Model.Count != 1 ? "s" : "")</span>
    <button class="hist-btn-secondary hist-no-print" onclick="window.print()">🖨 Imprimir</button>
</div>
    }
</div>

<style>
.hist-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 16px 40px;
}

.hist-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
}

.hist-icon {
    width: 52px; height: 52px;
    border-radius: 16px;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; flex-shrink: 0;
}

.hist-title {
    font-size: 22px;
    font-weight: 800;
    color: #111827;
    margin: 0 0 2px;
}

@@media print {
    .hist-no-print {
        display: none !important;
    }
}

.hist-subtitle {
    font-size: 13px;
    color: #9ca3af;
    margin: 0;
}

.hist-filter-card {
    background: white;
    border-radius: 18px;
    padding: 20px 24px;
    margin-bottom: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.05);
}

.hist-filter-form {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    flex-wrap: wrap;
}

.hist-filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 180px;
}

.hist-filter-label {
    font-size: 11px;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.hist-date-input {
    padding: 10px 14px;
    border-radius: 12px;
    border: 1.5px solid #e5e7eb;
    background: #f9fafb;
    color: #111827;
    font-size: 14px;
    outline: none;
    transition: 0.2s;
}

.hist-date-input:focus {
    border-color: #6366f1;
    background: white;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
}

.hist-filter-btns {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
}

.hist-btn-primary {
    padding: 10px 20px;
    border-radius: 12px;
    border: none;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
    color: white;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.hist-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(37,99,235,0.3); }

.hist-btn-secondary {
    padding: 10px 18px;
    border-radius: 12px;
    border: 1.5px solid #e5e7eb;
    background: white;
    color: #374151;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.hist-btn-secondary:hover { background: #f9fafb; }

.hist-empty {
    background: white;
    border-radius: 18px;
    padding: 60px 20px;
    text-align: center;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.05);
}

.hist-empty-icon { font-size: 48px; margin-bottom: 14px; }
.hist-empty-text { font-size: 15px; color: #9ca3af; margin: 0; }

.hist-table-card {
    background: white;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.05);
    margin-bottom: 16px;
}

@@media print {
    /* Ocultar navegación y elementos innecesarios */
    nav, header, footer, .hist-filter-card, .hist-footer button {
        display: none !important;
    }

    body {
        background: white !important;
        color: black !important;
        font-size: 12px;
    }

    .hist-page {
        padding: 0 !important;
        margin: 0 !important;
    }

    .hist-header {
        margin-bottom: 16px;
    }

    .hist-title {
        font-size: 18px;
        color: black !important;
    }

    .hist-subtitle {
        font-size: 12px;
        color: #444 !important;
    }

    .hist-table-card {
        box-shadow: none !important;
        border: 1px solid #ccc;
        border-radius: 0 !important;
    }

    .hist-table {
        width: 100%;
        border-collapse: collapse;
    }

    .hist-table th,
    .hist-table td {
        border: 1px solid #ccc;
        padding: 8px 12px;
        text-align: left;
        color: black !important;
    }

    .hist-table thead {
        background-color: #f0f0f0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .hist-pill {
        border: 1px solid #ccc;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .hist-pill-ok {
        background-color: #d4edda !important;
        color: #155724 !important;
    }

    .hist-pill-fail {
        background-color: #f8d7da !important;
        color: #721c24 !important;
    }

    .hist-date-day {
        font-size: 10px;
        color: #666 !important;
    }

    .hist-count {
        display: block;
        margin-top: 12px;
        font-size: 11px;
        color: #444;
    }
}

.hist-table {
    width: 100%;
    border-collapse: collapse;
}

.hist-table thead th {
    padding: 14px 20px;
    font-size: 11px;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid #f3f4f6;
    background: #fafafa;
}

.hist-th-center { text-align: center; }

.hist-table tbody tr {
    border-bottom: 1px solid #f3f4f6;
    transition: background 0.15s;
}

.hist-table tbody tr:last-child { border-bottom: none; }
.hist-table tbody tr:hover { background: #fafafa; }

.hist-table td {
    padding: 14px 20px;
    vertical-align: middle;
}

.hist-date-main { font-weight: 700; font-size: 14px; color: #111827; }
.hist-date-day { font-size: 12px; color: #9ca3af; text-transform: capitalize; margin-top: 2px; }
.hist-habit-name { font-size: 15px; font-weight: 600; color: #111827; }

.hist-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 14px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
}

.hist-pill-ok {
    background: rgba(34,197,94,0.12);
    color: #16a34a;
    border: 1px solid rgba(34,197,94,0.25);
}

.hist-pill-fail {
    background: rgba(239,68,68,0.1);
    color: #dc2626;
    border: 1px solid rgba(239,68,68,0.2);
}

.hist-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hist-count {
    font-size: 13px;
    color: #9ca3af;
    font-weight: 500;
}

/* DARK MODE */
body.bg-dark .hist-title { color: #f1f5f9 !important; }
body.bg-dark .hist-filter-card,
body.bg-dark .hist-empty,
body.bg-dark .hist-table-card { background: #1e1e2e !important; border-color: #2d2d3d !important; box-shadow: none !important; }

body.bg-dark .hist-filter-card { background: #1e293b !important; }
body.bg-dark .hist-date-input { background: #0f172a !important; border-color: #334155 !important; color: #f1f5f9 !important; color-scheme: dark; }
body.bg-dark .hist-date-input { background: #0f172a !important; border-color: #334155 !important; color: #f1f5f9 !important; }
body.bg-dark .hist-btn-secondary { background: #1e293b !important; border-color: #334155 !important; color: #f1f5f9 !important; }
body.bg-dark .hist-btn-secondary:hover { background: #334155 !important; }
body.bg-dark .hist-table thead th { background: #16213e !important; color: #64748b !important; border-color: #2d2d3d !important; }
body.bg-dark .hist-table tbody tr { border-color: #2d2d3d !important; }
body.bg-dark .hist-table tbody tr:hover { background: #2d2d3d !important; }
body.bg-dark .hist-date-main,
body.bg-dark .hist-habit-name { color: #f1f5f9 !important; }
body.bg-dark .hist-filter-label { color: #64748b !important; }
body.bg-dark .hist-empty-text { color: #64748b !important; }
body.bg-dark .hist-count { color: #64748b !important; }
</style>