@model List<HabitTrackerApp.Models.HabitHistory>

@{
    ViewData["Title"] = "Historial Diario";
}

<style>
    /* VARIABLES DINÁMICAS: Se adaptan al fondo */
    :root {
        --history-card-bg: #ffffff;
        --history-text-main: #212529;
        --history-text-muted: #6c757d;
        --history-border: rgba(0,0,0,0.08);
        --history-filter-bg: #f8f9fa;
    }

    /* Si el body tiene una clase de modo oscuro o detecta fondo oscuro */
    [data-bs-theme="dark"], .dark-mode, body.dark {
        --history-card-bg: #1e2125; /* Un gris muy oscuro, no negro puro */
        --history-text-main: #f8f9fa;
        --history-text-muted: #adb5bd;
        --history-border: rgba(255,255,255,0.1);
        --history-filter-bg: #2b3035;
    }

    .history-container {
        color: var(--history-text-main);
    }

    .filter-section {
        background: var(--history-filter-bg);
        border: 1px solid var(--history-border);
        padding: 24px;
        border-radius: 16px;
        transition: all 0.3s ease;
    }

    .main-card {
        background: var(--history-card-bg);
        border: 1px solid var(--history-border);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    /* Estilo de la tabla adaptable */
    .table {
        color: var(--history-text-main) !important;
        margin-bottom: 0;
    }

        .table thead th {
            background: var(--history-filter-bg);
            color: var(--history-text-muted);
            border-bottom: 1px solid var(--history-border);
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            padding: 15px 20px;
        }

        .table td {
            padding: 18px 20px;
            border-bottom: 1px solid var(--history-border);
            background: transparent !important;
        }

    /* Badges Modernos con Neumorfismo sutil */
    .badge-pill-custom {
        padding: 6px 14px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .status-completed {
        background: rgba(25, 135, 84, 0.15);
        color: #4cd137;
        border: 1px solid rgba(76, 209, 55, 0.3);
    }

    .status-failed {
        background: rgba(220, 53, 69, 0.15);
        color: #ff7675;
        border: 1px solid rgba(255, 118, 117, 0.3);
    }

    .habit-name {
        font-size: 1.05rem;
        letter-spacing: -0.3px;
    }

    /* Animación al pasar el mouse */
    .table tbody tr:hover {
        background-color: rgba(120, 120, 120, 0.05) !important;
    }
</style>

<div class="container py-5 history-container">
    <div class="row mb-5">
        <div class="col-lg-8">
            <h1 class="display-6 fw-bold mb-2">📅 Historial de Hábitos</h1>
            <p class="opacity-75 fs-5">Tu constancia es la clave del éxito. Aquí tienes tu progreso detallado.</p>
        </div>
    </div>

    <div class="filter-section mb-5">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-uppercase opacity-75">Seleccionar Fecha</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-calendar-event"></i></span>
                    <input type="date"
                           name="date"
                           class="form-control bg-transparent border-start-0 text-reset"
                           style="color-scheme: dark;"
                           value="@(ViewBag.SelectedDate != null ? ((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd") : "")" />
                </div>
            </div>

            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary px-4 rounded-3 fw-bold">
                    <i class="bi bi-filter me-2"></i>Aplicar Filtro
                </button>
                <a asp-action="History" class="btn btn-link text-decoration-none text-muted fw-medium">
                    Limpiar Filtros
                </a>
            </div>
        </form>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="main-card py-5 text-center">
            <div class="py-4">
                <div class="mb-3">
                    <i class="bi bi-search-heart text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                </div>
                <h4 class="fw-bold">No hay registros hoy</h4>
                <p class="text-muted">Parece que no hay actividad registrada para esta fecha.</p>
            </div>
        </div>
    }
    else
    {
        <div class="main-card shadow-lg">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Día y Fecha</th>
                            <th>Nombre del Hábito</th>
                            <th class="text-center">Estado de Cumplimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3 d-none d-sm-block">
                                            <i class="bi bi-calendar3"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@item.Date.ToString("dd MMM, yyyy")</div>
                                            <div class="small text-muted text-uppercase" style="font-size: 0.65rem;">@item.Date.ToString("dddd")</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="habit-name fw-semibold">@item.HabitName</span>
                                </td>

                                <td class="text-center">
                                    @if (item.Completed)
                                    {
                                        <div class="badge-pill-custom status-completed">
                                            <i class="bi bi-check2-circle"></i> Completado
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="badge-pill-custom status-failed">
                                            <i class="bi bi-exclamation-triangle"></i> Fallado
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="d-flex justify-content-between align-items-center mt-4 px-2">
            <span class="small text-muted">Total de registros: <strong>@Model.Count</strong></span>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Imprimir Reporte
            </button>
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">