@model List<HabitTrackerApp.Models.HabitHistory>

@{
    ViewData["Title"] = "Historial Diario";
}

<style>
    .history-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: none;
    }

    .table thead th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
        color: #6c757d;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .badge-soft-success {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }

    .badge-soft-danger {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }

    .filter-section {
        background: #ffffff;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }
</style>

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">📅 Historial de Hábitos</h2>
            <p class="text-muted">Consulta tu progreso y consistencia en el tiempo.</p>
        </div>
    </div>

    <div class="filter-section mb-4">
        <form method="get">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold small text-uppercase">Filtrar por fecha</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar3"></i></span>
                        <input type="date"
                               name="date"
                               class="form-control border-start-0 ps-0"
                               value="@(ViewBag.SelectedDate != null ? ((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd") : "")" />
                    </div>
                </div>

                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-search me-2"></i>Filtrar
                    </button>
                    <a asp-action="History" class="btn btn-light border px-4">
                        Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 py-5">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-clipboard-x text-muted" style="font-size: 3rem;"></i>
                </div>
                <h5 class="text-dark">Sin registros</h5>
                <p class="text-muted mx-auto" style="max-width: 300px;">
                    No encontramos actividad para la fecha seleccionada. ¡Intenta con otro día!
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Fecha</th>
                            <th>Hábito</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">
                                    <div class="d-flex flex-column">
                                        <span class="fw-medium text-dark">@item.Date.ToString("dd MMM, yyyy")</span>
                                        <small class="text-uppercase" style="font-size: 0.7rem;">@item.Date.ToString("dddd")</small>
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark fs-6">@item.HabitName</span>
                                </td>

                                <td class="text-center">
                                    @if (item.Completed)
                                    {
                                        <span class="badge rounded-pill badge-soft-success px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i> Completado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill badge-soft-danger px-3 py-2">
                                            <i class="bi bi-x-circle-fill me-1"></i> Fallado
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="mt-3 text-end">
            <small class="text-muted">Mostrando @Model.Count registro(s)</small>
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">