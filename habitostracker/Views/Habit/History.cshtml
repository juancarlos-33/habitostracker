@model List<HabitTrackerApp.Models.HabitHistory>

@{
    ViewData["Title"] = "Historial Diario";
}

<style>
    /* VARIABLES REFORZADAS PARA MODO OSCURO */
    :root {
        --hist-bg-card: #ffffff;
        --hist-bg-filter: #f8f9fa;
        --hist-text: #212529;
        --hist-text-muted: #6c757d;
        --hist-border: rgba(0,0,0,0.1);
    }

    /* Forzamos el modo oscuro basado en lo que veo en tu captura */
    [data-bs-theme="dark"], .dark-mode, body {
        --hist-bg-card: #212529; /* Color similar al de tu barra de navegación */
        --hist-bg-filter: #2c3034;
        --hist-text: #f8f9fa;
        --hist-text-muted: #adb5bd;
        --hist-border: rgba(255,255,255,0.1);
    }

    .history-main-container {
        color: var(--hist-text);
    }

    /* Filtros con fondo condicional */
    .filter-box {
        background-color: var(--hist-bg-filter) !important;
        border: 1px solid var(--hist-border);
        border-radius: 12px;
        padding: 20px;
    }

    /* La tarjeta de la tabla */
    .table-card {
        background-color: var(--hist-bg-card) !important;
        border: 1px solid var(--hist-border);
        border-radius: 12px;
        overflow: hidden;
    }

    .table {
        color: var(--hist-text) !important;
        margin-bottom: 0;
    }

        .table thead th {
            background-color: rgba(0,0,0,0.05);
            color: var(--hist-text-muted);
            border-bottom: 1px solid var(--hist-border);
            font-size: 0.75rem;
            text-transform: uppercase;
            padding: 15px;
        }

        /* Evitar que el fondo blanco de Bootstrap se filtre */
        .table td {
            background-color: transparent !important;
            border-bottom: 1px solid var(--hist-border);
            padding: 15px;
        }

    /* Badges con mejor contraste para modo oscuro */
    .status-badge {
        padding: 6px 12px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .status-ok {
        background: rgba(40, 167, 69, 0.2);
        color: #4ade80; /* Verde más brillante para lectura en oscuro */
        border: 1px solid rgba(40, 167, 69, 0.3);
    }

    .status-ko {
        background: rgba(220, 53, 69, 0.2);
        color: #ff8787; /* Rojo más suave */
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    /* Estilo para el input date en modo oscuro */
    input[type="date"] {
        color-scheme: dark;
        background-color: rgba(255,255,255,0.05) !important;
        color: var(--hist-text) !important;
        border: 1px solid var(--hist-border) !important;
    }
</style>

<div class="container py-4 history-main-container">
    <div class="mb-4">
        <h2 class="fw-bold"><i class="bi bi-journal-text me-2"></i>Historial de Hábitos</h2>
        <p class="text-muted">Visualiza tu progreso diario y mantén tu racha.</p>
    </div>

    <div class="filter-box mb-4 shadow-sm">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-uppercase opacity-75">Filtrar por fecha</label>
                <input type="date" name="date" class="form-control"
                       value="@(ViewBag.SelectedDate != null ? ((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="bi bi-funnel me-1"></i> Aplicar Filtro
                </button>
                <a asp-action="History" class="btn btn-outline-secondary ms-2">Limpiar</a>
            </div>
        </form>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="table-card p-5 text-center">
            <i class="bi bi-calendar-x text-muted mb-3" style="font-size: 3rem;"></i>
            <h5 class="text-muted">No se encontraron registros para esta fecha</h5>
        </div>
    }
    else
    {
        <div class="table-card shadow">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Día y Fecha</th>
                            <th>Hábito</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="p-2 rounded bg-primary bg-opacity-10 me-3">
                                            <i class="bi bi-calendar3 text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@item.Date.ToString("dd MMM, yyyy")</div>
                                            <div class="small text-muted text-uppercase" style="font-size: 0.6rem;">@item.Date.ToString("dddd")</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-semibold">@item.HabitName</td>
                                <td class="text-center">
                                    @if (item.Completed)
                                    {
                                        <div class="status-badge status-ok">
                                            <i class="bi bi-check-circle-fill"></i> Completado
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="status-badge status-ko">
                                            <i class="bi bi-x-circle-fill"></i> Fallado
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="mt-3 d-flex justify-content-between align-items-center opacity-75">
            <small>Total: @Model.Count registros</small>
            <button class="btn btn-sm btn-dark border-secondary rounded-pill px-3" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Imprimir
            </button>
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">