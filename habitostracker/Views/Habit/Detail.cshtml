@model HabitTrackerApp.Models.Habit

@{
    ViewData["Title"] = Model.Name;
    var currentUserId = (int)ViewBag.CurrentUserId;
    var completionRate = (int)ViewBag.CompletionRate7;
    var progresses = ViewBag.Progresses as List<HabitTrackerApp.Models.HabitProgress> ?? new();
    var allHistory = ViewBag.AllHistory as List<HabitTrackerApp.Models.HabitHistory> ?? new();
    var labels = ViewBag.Labels as string ?? "[]";
    var completed = ViewBag.Completed as string ?? "[]";
    var failed = ViewBag.Failed as string ?? "[]";
    var culture = new System.Globalization.CultureInfo("es-ES");
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.detail-page { max-width: 720px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; padding-bottom: 60px; }

/* HERO */
.detail-hero {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border-radius: 24px; padding: 28px 32px; margin-bottom: 16px;
    position: relative; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.06);
}
.detail-hero::before {
    content:""; position:absolute; top:-50px; right:-50px;
    width:200px; height:200px;
    background: radial-gradient(circle, rgba(99,102,241,0.2), transparent 70%);
    border-radius:50%;
}
.detail-hero-top {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 14px; position: relative; z-index:1;
    margin-bottom: 20px;
}
.detail-back {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 12px;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.7); font-size: 13px; font-weight: 600;
    text-decoration: none; transition: 0.2s;
}
.detail-back:hover { background: rgba(255,255,255,0.14); color: white; }
.detail-habit-name {
    font-size: 24px; font-weight: 800; color: white;
    position: relative; z-index:1; margin: 0 0 6px;
}
.detail-habit-meta { font-size: 13px; color: rgba(255,255,255,0.4); position: relative; z-index:1; }

/* STATS ROW */
.detail-stats {
    display: flex; gap: 0; position: relative; z-index:1;
    background: rgba(255,255,255,0.05); border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.06); overflow: hidden;
    width: fit-content; margin-top: 18px;
}
.detail-stat { padding: 14px 28px; text-align: center; position: relative; }
.detail-stat:not(:last-child)::after {
    content:""; position:absolute; right:0; top:20%; height:60%;
    width:1px; background: rgba(255,255,255,0.08);
}
.detail-stat-num { font-size: 22px; font-weight: 800; color: white; display: block; }
.detail-stat-label { font-size: 11px; color: rgba(255,255,255,0.4); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }

/* CARDS */
.detail-card {
    background: white; border-radius: 22px; padding: 24px;
    margin-bottom: 14px; border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.detail-card-title {
    font-size: 14px; font-weight: 800; color: #111827;
    margin-bottom: 18px; display: flex; align-items: center; gap: 8px;
}
.detail-card-badge {
    font-size: 11px; font-weight: 700; padding: 3px 10px;
    border-radius: 20px; background: #ede9fe; color: #6366f1; margin-left: auto;
}

/* GRÁFICA */
.detail-chart-wrap { position: relative; height: 200px; }

/* ACCIONES */
.detail-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.detail-action-btn {
    flex: 1; min-width: 120px; padding: 13px;
    border-radius: 14px; border: none; font-size: 14px; font-weight: 700;
    cursor: pointer; font-family: inherit; transition: 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    text-decoration: none;
}
.detail-action-btn.complete {
    background: linear-gradient(135deg, #22c55e, #16a34a); color: white;
    box-shadow: 0 4px 14px rgba(34,197,94,0.35);
}
.detail-action-btn.complete:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(34,197,94,0.45); }
.detail-action-btn.fail {
    background: #fef2f2; color: #dc2626; border: 1.5px solid #fecaca;
}
.detail-action-btn.fail:hover { background: #fee2e2; }
.detail-action-btn.share {
    background: linear-gradient(135deg, #6366f1, #4f46e5); color: white;
    box-shadow: 0 4px 14px rgba(99,102,241,0.35);
}
.detail-action-btn.share:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(99,102,241,0.45); }
.detail-action-btn.edit {
    background: #fef9c3; color: #d97706; border: 1.5px solid #fde68a;
    flex: 0; padding: 13px 18px;
}

/* PROGRESS RING */
.detail-ring-wrap {
    display: flex; align-items: center; gap: 24px; margin-bottom: 18px;
}
.detail-ring { position: relative; width: 100px; height: 100px; flex-shrink: 0; }
.detail-ring svg { transform: rotate(-90deg); }
.detail-ring-bg { fill: none; stroke: #f1f5f9; stroke-width: 8; }
.detail-ring-fill { fill: none; stroke: #6366f1; stroke-width: 8; stroke-linecap: round; transition: stroke-dashoffset 1s ease; }
.detail-ring-text {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
}
.detail-ring-pct { font-size: 20px; font-weight: 800; color: #111827; line-height: 1; }
.detail-ring-sub { font-size: 10px; color: #9ca3af; font-weight: 600; text-transform: uppercase; }
.detail-ring-info { flex: 1; }
.detail-ring-info-title { font-size: 16px; font-weight: 800; color: #111827; margin-bottom: 6px; }
.detail-ring-info-sub { font-size: 13px; color: #6b7280; line-height: 1.6; }

/* HISTORIAL MINI */
.detail-history-grid {
    display: flex; flex-wrap: wrap; gap: 6px;
}
.detail-history-dot {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700; cursor: default;
    position: relative;
}
.detail-history-dot.ok { background: #dcfce7; color: #16a34a; }
.detail-history-dot.fail { background: #fee2e2; color: #dc2626; }
.detail-history-dot.none { background: #f3f4f6; color: #9ca3af; }
.detail-history-dot.today { outline: 2.5px solid #6366f1; outline-offset: 2px; }

/* COMPARTIR MODAL */
.share-modal {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.65); z-index: 99999;
    align-items: center; justify-content: center;
    backdrop-filter: blur(8px);
}
.share-card {
    background: #0f172a; border-radius: 28px; padding: 32px 28px;
    max-width: 420px; width: 90%;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 40px 80px rgba(0,0,0,0.6);
}
.share-preview {
    background: linear-gradient(135deg, #6366f1, #2563eb);
    border-radius: 18px; padding: 22px; margin-bottom: 20px;
    text-align: center; position: relative; overflow: hidden;
}
.share-preview::before {
    content:""; position:absolute; top:-30px; right:-30px;
    width:120px; height:120px;
    background: radial-gradient(circle, rgba(255,255,255,0.15), transparent 70%);
    border-radius:50%;
}
.share-preview-habit { font-size: 13px; color: rgba(255,255,255,0.6); font-weight: 600; margin-bottom: 6px; }
.share-preview-streak { font-size: 36px; font-weight: 800; color: white; margin-bottom: 4px; line-height: 1; }
.share-preview-label { font-size: 12px; color: rgba(255,255,255,0.6); font-weight: 600; margin-bottom: 14px; }
.share-preview-bar-wrap { height: 6px; background: rgba(255,255,255,0.2); border-radius: 10px; overflow: hidden; margin-bottom: 6px; }
.share-preview-bar { height: 100%; background: white; border-radius: 10px; transition: 0.8s; }
.share-preview-rate { font-size: 11px; color: rgba(255,255,255,0.7); font-weight: 600; }
.share-title { font-size: 18px; font-weight: 800; color: white; margin: 0 0 4px; }
.share-sub { font-size: 13px; color: rgba(255,255,255,0.4); margin: 0 0 16px; }
.share-textarea {
    width: 100%; padding: 12px 16px; border-radius: 14px;
    border: 1.5px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05); color: white;
    font-size: 14px; font-family: inherit; outline: none;
    resize: none; transition: 0.2s; box-sizing: border-box; margin-bottom: 6px;
}
.share-textarea:focus { border-color: #6366f1; background: rgba(99,102,241,0.06); }
.share-textarea::placeholder { color: rgba(255,255,255,0.25); }
.share-chars { font-size: 11px; color: rgba(255,255,255,0.3); text-align: right; margin-bottom: 16px; }
.share-btns { display: flex; gap: 10px; }
.share-cancel {
    flex: 1; padding: 12px; border-radius: 13px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.5);
    font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
}
.share-confirm {
    flex: 1; padding: 12px; border-radius: 13px; border: none;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    color: white; font-size: 13px; font-weight: 700;
    cursor: pointer; font-family: inherit; transition: 0.2s;
}
.share-confirm:hover { transform: translateY(-1px); }
.share-confirm:disabled { background: #334155; cursor: not-allowed; transform: none; }

/* PROGRESO CARDS */
.progress-card {
    background: #f9fafb; border-radius: 18px; padding: 18px 20px;
    margin-bottom: 12px; border: 1px solid rgba(0,0,0,0.04);
    transition: 0.2s;
}
.progress-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
.progress-card-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.progress-card-avatar {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 14px; font-weight: 800; overflow: hidden;
}
.progress-card-avatar img { width: 100%; height: 100%; object-fit: cover; }
.progress-card-user { font-size: 14px; font-weight: 700; color: #111827; }
.progress-card-time { font-size: 11px; color: #9ca3af; margin-top: 1px; }
.progress-card-stats {
    display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap;
}
.progress-stat-chip {
    padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700;
}
.progress-stat-chip.streak { background: rgba(34,197,94,0.1); color: #16a34a; }
.progress-stat-chip.rate { background: rgba(99,102,241,0.1); color: #6366f1; }
.progress-card-msg { font-size: 14px; color: #374151; line-height: 1.6; margin-bottom: 12px; }
.progress-reactions { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
.reaction-btn {
    padding: 6px 12px; border-radius: 20px; border: 1.5px solid #e5e7eb;
    background: white; font-size: 13px; cursor: pointer; transition: 0.15s;
    font-family: inherit; display: flex; align-items: center; gap: 4px;
    font-weight: 600;
}
.reaction-btn:hover { border-color: #6366f1; background: rgba(99,102,241,0.04); }
.reaction-btn.mine { border-color: #6366f1; background: rgba(99,102,241,0.08); color: #6366f1; }
.reaction-count { font-size: 12px; color: #6b7280; }

/* COMENTARIOS */
.progress-comments { margin-top: 10px; }
.comment-item-new {
    display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px;
}
.comment-avatar-small {
    width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 11px; font-weight: 800; overflow: hidden;
}
.comment-avatar-small img { width: 100%; height: 100%; object-fit: cover; }
.comment-bubble {
    background: white; border-radius: 14px 14px 14px 4px;
    padding: 8px 12px; font-size: 13px; color: #374151; flex: 1;
    border: 1px solid #f1f5f9;
}
.comment-bubble strong { color: #111827; font-size: 12px; display: block; margin-bottom: 2px; }
.comment-input-wrap { display: flex; gap: 8px; margin-top: 10px; }
.comment-input-new {
    flex: 1; padding: 9px 14px; border-radius: 24px;
    border: 1.5px solid #e5e7eb; font-size: 13px; font-family: inherit;
    outline: none; transition: 0.2s; background: white; color: #111827;
}
.comment-input-new:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
.comment-send-btn {
    width: 36px; height: 36px; border-radius: 50%; border: none;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; cursor: pointer; transition: 0.2s; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 14px;
}
.comment-send-btn:hover { transform: scale(1.08); }

/* EMPTY */
.detail-empty {
    text-align: center; padding: 40px 20px; color: #9ca3af;
}
.detail-empty-icon { font-size: 40px; margin-bottom: 10px; }

/* TOAST */
.detail-toast {
    position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);
    background: #1e293b; color: white; padding: 10px 20px;
    border-radius: 20px; font-size: 13px; font-weight: 600;
    z-index: 99999; box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    font-family: 'Plus Jakarta Sans', sans-serif;
    animation: toastIn 0.3s ease;
}
@@keyframes toastIn { from{opacity:0;transform:translateX(-50%) translateY(10px);} to{opacity:1;transform:translateX(-50%) translateY(0);} }

/* DARK */
body.bg-dark .detail-card { background: #1e293b !important; border-color: #2d3748 !important; }
body.bg-dark .detail-card-title { color: #f1f5f9 !important; }
body.bg-dark .detail-ring-pct { color: #f1f5f9 !important; }
body.bg-dark .detail-ring-info-title { color: #f1f5f9 !important; }
body.bg-dark .detail-ring-bg { stroke: #2d3748 !important; }
body.bg-dark .detail-history-dot.none { background: #2d3748 !important; }
body.bg-dark .progress-card { background: #2d3748 !important; border-color: #334155 !important; }
body.bg-dark .progress-card-user { color: #f1f5f9 !important; }
body.bg-dark .progress-card-msg { color: #cbd5e1 !important; }
body.bg-dark .comment-bubble { background: #334155 !important; border-color: #3d4d60 !important; color: #cbd5e1 !important; }
body.bg-dark .comment-bubble strong { color: #f1f5f9 !important; }
body.bg-dark .comment-input-new { background: #2d3748 !important; border-color: #3d4d60 !important; color: #f1f5f9 !important; }
body.bg-dark .reaction-btn { background: #2d3748 !important; border-color: #3d4d60 !important; }

@@media (max-width: 640px) {
    .detail-stats { width: 100%; }
    .detail-stat { flex: 1; padding: 12px 14px; }
    .detail-stat-num { font-size: 18px; }
    .detail-ring-wrap { flex-direction: column; align-items: flex-start; }
}
</style>

<!-- MODAL COMPARTIR -->
<div class="share-modal" id="shareModal">
    <div class="share-card">
        <div class="share-preview" id="sharePreview">
            <div class="share-preview-habit">@Model.Name</div>
            <div class="share-preview-streak">@Model.StreakDays</div>
            <div class="share-preview-label">días de racha 🔥</div>
            <div class="share-preview-bar-wrap">
                <div class="share-preview-bar" id="shareBar" style="width:@completionRate%"></div>
            </div>
            <div class="share-preview-rate">@completionRate% completado esta semana</div>
        </div>
        <div class="share-title">🚀 Compartir progreso</div>
        <div class="share-sub">Cuéntale a la comunidad cómo vas</div>
        <textarea class="share-textarea" id="shareText" rows="3"
                  placeholder="¡Llevo @Model.StreakDays días seguidos! Este hábito está cambiando mi vida..."
                  maxlength="300" oninput="updateShareChars()"></textarea>
        <div class="share-chars"><span id="shareCharsCount">0</span>/300</div>
        <div class="share-btns">
            <button class="share-cancel" onclick="closeShare()">Cancelar</button>
            <button class="share-confirm" id="shareConfirm" onclick="confirmarShare()" disabled>
                🚀 Compartir
            </button>
        </div>
    </div>
</div>

<div class="detail-page">

    <!-- HERO -->
    <div class="detail-hero">
        <div class="detail-hero-top">
            <a href="/Habit/Index" class="detail-back">← Mis hábitos</a>
            @{
                var statusLabel = Model.LastCheckDate == DateTime.Today && Model.Completed ? "✔ Completado hoy" :
                                  Model.LastCheckDate == DateTime.Today && !Model.Completed ? "✖ Fallado hoy" : "⏳ Pendiente";
                var statusColor = Model.LastCheckDate == DateTime.Today && Model.Completed ? "#22c55e" :
                                  Model.LastCheckDate == DateTime.Today && !Model.Completed ? "#ef4444" : "#f59e0b";
            }
            <span style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;background:rgba(255,255,255,0.08);color:@statusColor;">
                @statusLabel
            </span>
        </div>
        <div class="detail-habit-name">@Model.Name</div>
        <div class="detail-habit-meta">Creado el @Model.CreatedDate.ToString("dd MMM yyyy", culture)</div>

        <div class="detail-stats">
            <div class="detail-stat">
                <span class="detail-stat-num">@Model.StreakDays 🔥</span>
                <span class="detail-stat-label">Racha</span>
            </div>
            <div class="detail-stat">
                <span class="detail-stat-num">@Model.MaxStreak 🏆</span>
                <span class="detail-stat-label">Récord</span>
            </div>
            <div class="detail-stat">
                <span class="detail-stat-num">@completionRate%</span>
                <span class="detail-stat-label">Esta semana</span>
            </div>
        </div>
    </div>

    <!-- ACCIONES -->
    <div class="detail-card">
        <div class="detail-card-title">⚡ Acciones rápidas</div>
        <div class="detail-actions">
            <a href="/Habit/Complete/@Model.Id" class="detail-action-btn complete">✔ Completar hoy</a>
            <a href="/Habit/Fail/@Model.Id" class="detail-action-btn fail">✖ Marcar fallido</a>
            <button class="detail-action-btn share" onclick="openShare()">🚀 Compartir progreso</button>
            <a href="/Habit/Edit/@Model.Id" class="detail-action-btn edit">✏️</a>
        </div>
    </div>

    <!-- PROGRESO VISUAL -->
    <div class="detail-card">
        <div class="detail-card-title">
            🎯 Progreso esta semana
            <span class="detail-card-badge">Últimos 7 días</span>
        </div>
        <div class="detail-ring-wrap">
            <div class="detail-ring">
                <svg width="100" height="100" viewBox="0 0 100 100">
                    <circle class="detail-ring-bg" cx="50" cy="50" r="40"/>
                    <circle class="detail-ring-fill" cx="50" cy="50" r="40"
                            id="ringFill"
                            stroke-dasharray="251.2"
                            stroke-dashoffset="@(251.2 - (251.2 * completionRate / 100))" />
                </svg>
                <div class="detail-ring-text">
                    <span class="detail-ring-pct">@completionRate%</span>
                    <span class="detail-ring-sub">semana</span>
                </div>
            </div>
            <div class="detail-ring-info">
                <div class="detail-ring-info-title">
                    @if (completionRate >= 80) { <text>🔥 ¡Excelente semana!</text> }
                    else if (completionRate >= 50) { <text>💪 Vas por buen camino</text> }
                    else if (completionRate > 0) { <text>📈 Sigue intentándolo</text> }
                    else { <text>🌱 Empieza hoy</text> }
                </div>
                <div class="detail-ring-info-sub">
                    Racha actual de <strong>@Model.StreakDays días</strong>.<br>
                    Tu mejor racha fue de <strong>@Model.MaxStreak días</strong>.
                </div>
            </div>
        </div>

        <!-- GRÁFICA -->
        <div class="detail-chart-wrap">
            <canvas id="detailChart"></canvas>
        </div>
    </div>

    <!-- HISTORIAL 30 DÍAS -->
    <div class="detail-card">
        <div class="detail-card-title">
            📅 Últimos 30 días
            <span class="detail-card-badge">@allHistory.Count registros</span>
        </div>
        <div class="detail-history-grid">
            @{
                var last30 = Enumerable.Range(0, 30).Select(i => DateTime.Today.AddDays(-29 + i)).ToList();
            }
            @foreach (var day in last30)
            {
                var h = allHistory.FirstOrDefault(x => x.Date.Date == day.Date);
                var isToday = day.Date == DateTime.Today;
                string dotClass = h == null ? "none" : (h.Completed ? "ok" : "fail");
                string emoji = h == null ? day.Day.ToString() : (h.Completed ? "✔" : "✖");
                <div class="detail-history-dot @dotClass @(isToday ? "today" : "")"
                     title="@day.ToString("dd MMM", culture)">
                    @emoji
                </div>
            }
        </div>
        <div style="display:flex;gap:16px;margin-top:12px;flex-wrap:wrap;">
            <span style="font-size:12px;font-weight:600;color:#16a34a;display:flex;align-items:center;gap:4px;">
                <span style="width:12px;height:12px;border-radius:3px;background:#dcfce7;display:inline-block;"></span> Completado
            </span>
            <span style="font-size:12px;font-weight:600;color:#dc2626;display:flex;align-items:center;gap:4px;">
                <span style="width:12px;height:12px;border-radius:3px;background:#fee2e2;display:inline-block;"></span> Fallado
            </span>
            <span style="font-size:12px;font-weight:600;color:#9ca3af;display:flex;align-items:center;gap:4px;">
                <span style="width:12px;height:12px;border-radius:3px;background:#f3f4f6;display:inline-block;"></span> Sin registro
            </span>
        </div>
    </div>

    <!-- PROGRESOS COMPARTIDOS -->
    <div class="detail-card">
        <div class="detail-card-title">
            🌍 Progreso compartido
            <span class="detail-card-badge">@progresses.Count</span>
        </div>

        <div id="progressFeed">
            @if (!progresses.Any())
            {
                <div class="detail-empty" id="emptyProgress">
                    <div class="detail-empty-icon">🚀</div>
                    <div style="font-weight:700;color:#374151;margin-bottom:4px;">Sin publicaciones aún</div>
                    <div style="font-size:13px;">¡Comparte tu progreso y motiva a otros!</div>
                </div>
            }

            @foreach (var p in progresses)
            {
                var pImg = p.User?.ProfileImage ?? p.User?.ProfilePicture ?? "";
                var pLetter = (p.User?.Username ?? "?").Substring(0, 1).ToUpper();
                var timeAgo = (DateTime.UtcNow - p.SharedAt).TotalMinutes < 60
                    ? $"Hace {(int)(DateTime.UtcNow - p.SharedAt).TotalMinutes} min"
                    : p.SharedAt.ToLocalTime().ToString("dd MMM · HH:mm");

                <div class="progress-card" id="progress-@p.Id">
                    <div class="progress-card-header">
                        <div class="progress-card-avatar">
                            @if (!string.IsNullOrEmpty(pImg)) { <img src="@pImg" /> }
                            else { @pLetter }
                        </div>
                        <div>
                            <div class="progress-card-user">@p.User?.Username</div>
                            <div class="progress-card-time">@timeAgo</div>
                        </div>
                    </div>
                    <div class="progress-card-stats">
                        <span class="progress-stat-chip streak">🔥 @p.StreakDays días de racha</span>
                        <span class="progress-stat-chip rate">📊 @p.CompletionRate% esta semana</span>
                    </div>
                    <div class="progress-card-msg">@p.Message</div>

                    <!-- REACCIONES -->
                    <div class="progress-reactions" id="reactions-@p.Id">
                        @{
                            var reactionGroups = p.Reactions.GroupBy(r => r.Emoji).ToDictionary(g => g.Key, g => g.Count());
                            var myReaction = p.Reactions.FirstOrDefault(r => r.UserId == currentUserId)?.Emoji;
                        }
                        @foreach (var emoji in new[] { "🔥", "💪", "❤️", "👏", "🎯" })
                        {
                            var count = reactionGroups.ContainsKey(emoji) ? reactionGroups[emoji] : 0;
                            <button class="reaction-btn @(myReaction == emoji ? "mine" : "")"
                                    onclick="reaccionar(@p.Id, '@emoji', this)">
                                @emoji @if (count > 0) { <span class="reaction-count">@count</span> }
                            </button>
                        }
                    </div>

                    <!-- COMENTARIOS -->
                    <div class="progress-comments" id="comments-@p.Id">
                        @foreach (var c in p.Comments.OrderBy(c => c.CreatedAt))
                        {
                            var cImg = c.User?.ProfileImage ?? c.User?.ProfilePicture ?? "";
                            var cLetter = (c.User?.Username ?? "?").Substring(0, 1).ToUpper();
                            <div class="comment-item-new">
                                <div class="comment-avatar-small">
                                    @if (!string.IsNullOrEmpty(cImg)) { <img src="@cImg" /> }
                                    else { @cLetter }
                                </div>
                                <div class="comment-bubble">
                                    <strong>@c.User?.Username</strong>
                                    @c.Content
                                </div>
                            </div>
                        }
                    </div>
                    <div class="comment-input-wrap">
                        <input type="text" class="comment-input-new" placeholder="Escribe un comentario..."
                               id="commentInput-@p.Id"
                               onkeydown="if(event.key==='Enter') comentar(@p.Id, this)" />
                        <button class="comment-send-btn" onclick="comentar(@p.Id, document.getElementById('commentInput-@p.Id'))">➤</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const habitId = @Model.Id;
const habitName = "@Model.Name";
const habitStreak = @Model.StreakDays;
const habitRate = @completionRate;

// ── GRÁFICA INDIVIDUAL ───────────────────
const labels = @Html.Raw(labels);
const completedData = @Html.Raw(completed);
const failedData = @Html.Raw(failed);

const isDark = document.body.classList.contains('bg-dark');
const gridColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)';
const textColor = isDark ? '#94a3b8' : '#6b7280';

new Chart(document.getElementById('detailChart'), {
    type: 'bar',
    data: {
        labels: labels,
        datasets: [
            {
                label: 'Completado',
                data: completedData,
                backgroundColor: 'rgba(34,197,94,0.8)',
                borderRadius: 8,
                borderSkipped: false,
            },
            {
                label: 'Fallado',
                data: failedData,
                backgroundColor: 'rgba(239,68,68,0.6)',
                borderRadius: 8,
                borderSkipped: false,
            }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                labels: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 12 } }
            },
            tooltip: {
                callbacks: {
                    label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y + ' veces'
                }
            }
        },
        scales: {
            y: {
                beginAtZero: true,
                ticks: { color: textColor, stepSize: 1 },
                grid: { color: gridColor }
            },
            x: {
                ticks: { color: textColor },
                grid: { color: gridColor }
            }
        }
    }
});

// ── RING ANIMATION ───────────────────────
window.addEventListener("load", () => {
    const ring = document.getElementById("ringFill");
    if (ring) {
        const target = 251.2 - (251.2 * habitRate / 100);
        ring.style.strokeDashoffset = target;
    }
});

// ── MODAL COMPARTIR ──────────────────────
function openShare() {
    document.getElementById("shareModal").style.display = "flex";
    document.getElementById("shareText").focus();
}
function closeShare() {
    document.getElementById("shareModal").style.display = "none";
}
function updateShareChars() {
    const len = document.getElementById("shareText").value.length;
    document.getElementById("shareCharsCount").textContent = len;
    document.getElementById("shareConfirm").disabled = len === 0;
}

async function confirmarShare() {
    const msg = document.getElementById("shareText").value.trim();
    if (!msg) return;
    const btn = document.getElementById("shareConfirm");
    btn.disabled = true; btn.textContent = "⏳ Compartiendo...";

    try {
        const res = await fetch("/Habit/ShareProgress", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: `habitId=${habitId}&message=${encodeURIComponent(msg)}`
        });
        const data = await res.json();

        if (data.success) {
            closeShare();
            document.getElementById("shareText").value = "";
            document.getElementById("shareCharsCount").textContent = "0";

            // agregar card al feed
            const empty = document.getElementById("emptyProgress");
            if (empty) empty.remove();

            const avatarHTML = data.avatar
                ? `<img src="${data.avatar}" style="width:100%;height:100%;object-fit:cover;" />`
                : data.username.charAt(0).toUpperCase();

            const card = document.createElement("div");
            card.className = "progress-card";
            card.id = "progress-" + data.id;
            card.innerHTML = `
                <div class="progress-card-header">
                    <div class="progress-card-avatar">${avatarHTML}</div>
                    <div>
                        <div class="progress-card-user">${data.username}</div>
                        <div class="progress-card-time">ahora</div>
                    </div>
                </div>
                <div class="progress-card-stats">
                    <span class="progress-stat-chip streak">🔥 ${data.streak} días de racha</span>
                    <span class="progress-stat-chip rate">📊 ${data.rate}% esta semana</span>
                </div>
                <div class="progress-card-msg">${escapeHtml(data.message)}</div>
                <div class="progress-reactions" id="reactions-${data.id}">
                    ${['🔥','💪','❤️','👏','🎯'].map(e => `<button class="reaction-btn" onclick="reaccionar(${data.id},'${e}',this)">${e}</button>`).join('')}
                </div>
                <div class="progress-comments" id="comments-${data.id}"></div>
                <div class="comment-input-wrap">
                    <input type="text" class="comment-input-new" placeholder="Escribe un comentario..."
                           id="commentInput-${data.id}"
                           onkeydown="if(event.key==='Enter') comentar(${data.id}, this)" />
                    <button class="comment-send-btn" onclick="comentar(${data.id}, document.getElementById('commentInput-${data.id}'))">➤</button>
                </div>`;

            const feed = document.getElementById("progressFeed");
            feed.insertBefore(card, feed.firstChild);
            showToast("🚀 ¡Progreso compartido!");
        }
    } catch (err) {
        showToast("❌ Error al compartir");
    }

    btn.disabled = false; btn.textContent = "🚀 Compartir";
}

document.getElementById("shareModal").addEventListener("click", function(e) {
    if (e.target === this) closeShare();
});

// ── REACCIONES ───────────────────────────
async function reaccionar(progressId, emoji, btn) {
    try {
        const res = await fetch("/Habit/ReactProgress", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ progressId, emoji })
        });
        const data = await res.json();
        if (!data.success) return;

        // actualizar botones de reacción
        const container = document.getElementById("reactions-" + progressId);
        if (!container) return;
        container.querySelectorAll(".reaction-btn").forEach(b => {
            const btnEmoji = b.textContent.trim().charAt(0);
            const found = data.counts.find(c => c.emoji === btnEmoji);
            const count = found ? found.count : 0;
            b.innerHTML = btnEmoji + (count > 0 ? ` <span class="reaction-count">${count}</span>` : "");
            b.classList.toggle("mine", b === btn && !btn.classList.contains("mine"));
        });
    } catch (err) { console.error(err); }
}

// ── COMENTARIOS ──────────────────────────
async function comentar(progressId, input) {
    const content = input.value.trim();
    if (!content) return;
    input.value = "";

    try {
        const res = await fetch("/Habit/CommentProgress", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ progressId, content })
        });
        const data = await res.json();
        if (!data.success) return;

        const avatarHTML = data.avatar
            ? `<img src="${data.avatar}" style="width:100%;height:100%;object-fit:cover;" />`
            : data.username.charAt(0).toUpperCase();

        const commentEl = document.createElement("div");
        commentEl.className = "comment-item-new";
        commentEl.innerHTML = `
            <div class="comment-avatar-small">${avatarHTML}</div>
            <div class="comment-bubble">
                <strong>${data.username}</strong>
                ${escapeHtml(data.content)}
            </div>`;

        document.getElementById("comments-" + progressId).appendChild(commentEl);
    } catch (err) { console.error(err); }
}

function escapeHtml(text) {
    return String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;")
                       .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

function showToast(msg) {
    const t = document.createElement("div");
    t.className = "detail-toast";
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
}
</script>
}