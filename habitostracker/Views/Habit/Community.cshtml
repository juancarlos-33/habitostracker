@model List<HabitTrackerApp.Models.HabitProgress>

@{
    ViewData["Title"] = "Comunidad";
    var currentUserId = (int)ViewBag.CurrentUserId;
    var culture = new System.Globalization.CultureInfo("es-ES");
    var filteredModel = Model.Where(p => p.User?.Role != "Guest").ToList();
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.comm-page { max-width: 640px; margin: 0 auto; font-family: 'Plus Jakarta Sans', sans-serif; padding-bottom: 40px; }

.comm-card {
    background: #1e293b;
    border-radius: 18px;
    margin-bottom: 12px;
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
    transition: 0.2s;
}
body:not(.bg-dark) .comm-card { background: white; border-color: rgba(0,0,0,0.06); box-shadow: 0 2px 12px rgba(0,0,0,0.05); }
.comm-card:hover { transform: translateY(-1px); }

.comm-card-header { display: flex; align-items: center; gap: 10px; padding: 14px 16px 0; }
.comm-avatar {
    width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 16px; font-weight: 800; overflow: hidden;
    text-decoration: none; transition: 0.2s;
}
.comm-avatar img { width: 100%; height: 100%; object-fit: cover; }
.comm-user-info { flex: 1; min-width: 0; }
.comm-username { font-size: 14px; font-weight: 700; color: #111827; text-decoration: none; display: block; }
body.bg-dark .comm-username { color: #f1f5f9; }
.comm-username:hover { color: #6366f1; }
.comm-meta { font-size: 12px; color: #9ca3af; margin-top: 1px; }
.comm-habit-tag {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 11px; font-weight: 700; padding: 2px 8px;
    border-radius: 20px; background: rgba(99,102,241,0.12);
    color: #6366f1; text-decoration: none; margin-left: 6px;
}

.comm-body { padding: 12px 16px; }
.comm-stats { display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap; }
.comm-stat-chip { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; }
.comm-stat-chip.streak { background: rgba(34,197,94,0.12); color: #16a34a; }
.comm-stat-chip.rate { background: rgba(99,102,241,0.1); color: #6366f1; }
body.bg-dark .comm-stat-chip.streak { background: rgba(34,197,94,0.15); }
body.bg-dark .comm-stat-chip.rate { background: rgba(99,102,241,0.15); }

.comm-msg {
    font-size: 14px; color: #374151; line-height: 1.65; margin-bottom: 12px;
}
body.bg-dark .comm-msg { color: #cbd5e1; }

.comm-bar-wrap { height: 4px; background: rgba(0,0,0,0.06); border-radius: 10px; margin-bottom: 14px; overflow: hidden; }
body.bg-dark .comm-bar-wrap { background: rgba(255,255,255,0.08); }
.comm-bar { height: 100%; border-radius: 10px; background: linear-gradient(90deg, #6366f1, #2563eb); }

.comm-footer { padding: 0 16px 14px; }

/* REACCIONES estilo Facebook */
.comm-reactions-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-top: 1px solid rgba(0,0,0,0.06); border-bottom: 1px solid rgba(0,0,0,0.06); margin-bottom: 10px; }
body.bg-dark .comm-reactions-row { border-color: rgba(255,255,255,0.06); }

.comm-react-counts { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #9ca3af; }
.comm-react-emojis { display: flex; }
.comm-react-emoji-pill { font-size: 15px; width: 24px; height: 24px; border-radius: 50%; background: #f3f4f6; display: flex; align-items: center; justify-content: center; margin-left: -4px; border: 2px solid white; }
body.bg-dark .comm-react-emoji-pill { background: #2d3748; border-color: #1e293b; }

.comm-actions { display: flex; gap: 4px; }
.comm-action-btn {
    flex: 1; padding: 7px 0; border-radius: 10px; border: none;
    background: transparent; font-size: 13px; font-weight: 600;
    cursor: pointer; transition: 0.15s; font-family: inherit;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    color: #6b7280;
}
body.bg-dark .comm-action-btn { color: #64748b; }
.comm-action-btn:hover { background: rgba(0,0,0,0.04); color: #374151; }
body.bg-dark .comm-action-btn:hover { background: rgba(255,255,255,0.06); color: #94a3b8; }
.comm-action-btn.reacted { color: #6366f1; }

/* EMOJI PICKER */
.comm-emoji-picker {
    display: none; position: absolute; bottom: calc(100% + 8px); left: 0;
    background: white; border-radius: 40px; padding: 8px 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15); border: 1px solid rgba(0,0,0,0.06);
    display: none; flex-direction: row; gap: 6px; z-index: 100;
    animation: pickerIn 0.15s ease;
}
body.bg-dark .comm-emoji-picker { background: #1e293b; border-color: rgba(255,255,255,0.1); box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
@@keyframes pickerIn { from{opacity:0;transform:scale(0.8) translateY(8px);} to{opacity:1;transform:scale(1) translateY(0);} }
.comm-emoji-option {
    width: 36px; height: 36px; border-radius: 50%; border: none; background: transparent;
    font-size: 20px; cursor: pointer; transition: 0.15s; display: flex; align-items: center; justify-content: center;
}
.comm-emoji-option:hover { background: rgba(99,102,241,0.1); transform: scale(1.3); }
.comm-react-wrap { position: relative; flex: 1; display: flex; }

/* COMENTARIOS */
.comm-comments { margin-bottom: 10px; }
.comm-comment-item { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px; }
.comm-comment-avatar {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 11px; font-weight: 800; overflow: hidden;
}
.comm-comment-avatar img { width: 100%; height: 100%; object-fit: cover; }
.comm-comment-bubble {
    background: #f3f4f6; border-radius: 16px 16px 16px 4px;
    padding: 8px 12px; font-size: 13px; color: #374151; flex: 1;
}
body.bg-dark .comm-comment-bubble { background: #2d3748; color: #cbd5e1; }
.comm-comment-bubble strong { color: #111827; font-size: 12px; display: block; margin-bottom: 2px; }
body.bg-dark .comm-comment-bubble strong { color: #f1f5f9; }

.comm-comment-input-wrap { display: flex; gap: 8px; align-items: center; }
.comm-my-avatar {
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 12px; font-weight: 800; overflow: hidden;
}
.comm-my-avatar img { width: 100%; height: 100%; object-fit: cover; }
.comm-comment-input {
    flex: 1; padding: 8px 16px; border-radius: 24px;
    border: 1.5px solid #e5e7eb; font-size: 13px; font-family: inherit;
    outline: none; transition: 0.2s; background: #f9fafb; color: #111827;
}
body.bg-dark .comm-comment-input { background: #2d3748; border-color: #3d4d60; color: #f1f5f9; }
.comm-comment-input:focus { border-color: #6366f1; background: white; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
body.bg-dark .comm-comment-input:focus { background: #334155; }
.comm-comment-input::placeholder { color: #9ca3af; }
.comm-comment-send {
    width: 34px; height: 34px; border-radius: 50%; border: none;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; cursor: pointer; transition: 0.2s; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 13px;
}
.comm-comment-send:hover { transform: scale(1.08); }

.comm-empty {
    text-align: center; padding: 70px 20px;
    background: white; border-radius: 22px;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
body.bg-dark .comm-empty { background: #1e293b; border-color: #2d3748; }
.comm-empty-icon { font-size: 60px; margin-bottom: 16px; }
.comm-empty-title { font-size: 18px; font-weight: 800; color: #111827; margin: 0 0 8px; }
body.bg-dark .comm-empty-title { color: #f1f5f9; }
.comm-empty-sub { font-size: 13px; color: #9ca3af; line-height: 1.6; margin: 0 0 20px; }
.comm-empty-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 24px; border-radius: 14px; border: none;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; font-size: 14px; font-weight: 700;
    text-decoration: none; transition: 0.2s;
    box-shadow: 0 6px 18px rgba(99,102,241,0.35);
}
.comm-empty-btn:hover { transform: translateY(-2px); color: white; }

.comm-toast {
    position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);
    background: #1e293b; color: white; padding: 10px 20px;
    border-radius: 20px; font-size: 13px; font-weight: 600;
    z-index: 99999; box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    font-family: 'Plus Jakarta Sans', sans-serif;
    animation: toastIn 0.3s ease;
}
@@keyframes toastIn { from{opacity:0;transform:translateX(-50%) translateY(10px);} to{opacity:1;transform:translateX(-50%) translateY(0);} }

@@media (max-width: 640px) {
    .comm-card { border-radius: 14px; }
}
</style>

<div class="comm-page">

@{
    var myProfileImg = User.FindFirst("ProfileImage")?.Value ?? "";
    var myUsernameLetter = (User.Identity?.Name ?? "?").Substring(0, 1).ToUpper();
}

@if (!filteredModel.Any())
{
    <div class="comm-empty">
        <div class="comm-empty-icon">🌱</div>
        <div class="comm-empty-title">La comunidad está esperando</div>
        <div class="comm-empty-sub">Sé el primero en compartir tu progreso.<br>Entra a un hábito y toca "🚀 Compartir progreso".</div>
        <a href="/Habit/Index" class="comm-empty-btn">🎯 Ver mis hábitos</a>
    </div>
}
else
{
    @foreach (var p in filteredModel)
    {
        var pImg = p.User?.ProfileImage ?? p.User?.ProfilePicture ?? "";
        var pLetter = (p.User?.Username ?? "?").Substring(0, 1).ToUpper();
        var diffMin = (int)(DateTime.UtcNow - p.SharedAt).TotalMinutes;
        var diffH = (int)(DateTime.UtcNow - p.SharedAt).TotalHours;
        var diffD = (int)(DateTime.UtcNow - p.SharedAt).TotalDays;
        string timeAgo = diffMin < 1 ? "ahora" :
                         diffMin < 60 ? $"hace {diffMin} min" :
                         diffH < 24 ? $"hace {diffH}h" :
                         diffD == 1 ? "ayer" :
                         p.SharedAt.ToLocalTime().ToString("dd MMM", culture);

        var reactionGroups = p.Reactions.GroupBy(r => r.Emoji).ToDictionary(g => g.Key, g => g.Count());
        var myReaction = p.Reactions.FirstOrDefault(r => r.UserId == currentUserId)?.Emoji;
        var totalReactions = p.Reactions.Count;
        var topEmojis = reactionGroups.OrderByDescending(x => x.Value).Take(3).Select(x => x.Key).ToList();

        <div class="comm-card" id="comm-progress-@p.Id">
            <!-- HEADER -->
            <div class="comm-card-header">
                <a href="/User/Profile/@p.UserId" class="comm-avatar">
                    @if (!string.IsNullOrEmpty(pImg)) { <img src="@pImg" /> }
                    else { @pLetter }
                </a>
                <div class="comm-user-info">
                    <a href="/User/Profile/@p.UserId" class="comm-username">@p.User?.Username</a>
                    <div class="comm-meta">
                        @timeAgo
                       <span class="comm-habit-tag">🎯 @p.Habit?.Name</span>
                    </div>
                </div>
            </div>

            <!-- BODY -->
            <div class="comm-body">
                <div class="comm-stats">
                    <span class="comm-stat-chip streak">🔥 @p.StreakDays días de racha</span>
                    <span class="comm-stat-chip rate">📊 @p.CompletionRate% esta semana</span>
                </div>
                <div class="comm-msg">@p.Message</div>
                <div class="comm-bar-wrap">
                    <div class="comm-bar" style="width:@p.CompletionRate%"></div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="comm-footer">
                <!-- CONTEO REACCIONES -->
                @if (totalReactions > 0)
                {
                    <div class="comm-reactions-row">
                        <div class="comm-react-counts">
                            <div class="comm-react-emojis">
                                @foreach (var e in topEmojis)
                                {
                                    <div class="comm-react-emoji-pill">@e</div>
                                }
                            </div>
                            <span id="comm-react-total-@p.Id">@totalReactions</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="comm-reactions-row" id="comm-react-row-@p.Id" style="display:none;">
                        <div class="comm-react-counts">
                            <div class="comm-react-emojis" id="comm-top-emojis-@p.Id"></div>
                            <span id="comm-react-total-@p.Id">0</span>
                        </div>
                    </div>
                }

                <!-- BOTONES ACCIÓN -->
                <div class="comm-actions">
                    <div class="comm-react-wrap" id="comm-react-wrap-@p.Id">
                        <button class="comm-action-btn @(myReaction != null ? "reacted" : "")"
                                id="comm-like-btn-@p.Id"
                                onclick="togglePicker(@p.Id, this)">
                            @(myReaction ?? "👍") @(myReaction != null ? "Reaccioné" : "Me gusta")
                        </button>
                        <div class="comm-emoji-picker" id="comm-picker-@p.Id" style="display:none;">
                            @foreach (var emoji in new[] { "🔥", "💪", "❤️", "👏", "🎯" })
                            {
                                <button class="comm-emoji-option" onclick="reaccionar(@p.Id, '@emoji')">@emoji</button>
                            }
                        </div>
                    </div>
                    <button class="comm-action-btn" onclick="focusComment(@p.Id)">
                        💬 Comentar
                    </button>
                </div>

                <div style="height:10px;"></div>

                <!-- COMENTARIOS -->
                <div class="comm-comments" id="comm-comments-@p.Id">
                    @foreach (var c in p.Comments.OrderBy(c => c.CreatedAt))
                    {
                        var cImg = c.User?.ProfileImage ?? c.User?.ProfilePicture ?? "";
                        var cLetter = (c.User?.Username ?? "?").Substring(0, 1).ToUpper();
                        <div class="comm-comment-item">
                            <div class="comm-comment-avatar">
                                @if (!string.IsNullOrEmpty(cImg)) { <img src="@cImg" /> }
                                else { @cLetter }
                            </div>
                            <div class="comm-comment-bubble">
                                <strong>@c.User?.Username</strong>
                                @c.Content
                            </div>
                        </div>
                    }
                </div>

                @if (!User.IsInRole("Guest"))
                {
                    <div class="comm-comment-input-wrap">
                        <div class="comm-my-avatar">
                            @if (!string.IsNullOrEmpty(myProfileImg))
                            { <img src="@myProfileImg" /> }
                            else { @myUsernameLetter }
                        </div>
                        <input type="text" class="comm-comment-input"
                               placeholder="Escribe un comentario..."
                               id="commInput-@p.Id"
                               onkeydown="if(event.key==='Enter') comentar(@p.Id, this)" />
                        <button class="comm-comment-send"
                                onclick="comentar(@p.Id, document.getElementById('commInput-@p.Id'))">➤</button>
                    </div>
                }
                else
                {
                    <div style="padding:10px;background:rgba(99,102,241,0.06);border-radius:12px;font-size:13px;color:#6366f1;font-weight:600;text-align:center;">
                        <a href="/Account/UpgradeAccount" style="color:#6366f1;text-decoration:none;">🔐 Inicia sesión para comentar</a>
                    </div>
                }
            </div>
        </div>
    }
}
</div>

<script>
const isGuest = @User.IsInRole("Guest").ToString().ToLower();
let activePicker = null;

function escapeHtml(text) {
    return String(text).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

function togglePicker(progressId, btn) {
    if (isGuest) { window.location.href = "/Account/UpgradeAccount"; return; }
    const picker = document.getElementById('comm-picker-' + progressId);
    const isOpen = picker.style.display === 'flex';
    if (activePicker && activePicker !== picker) activePicker.style.display = 'none';
    picker.style.display = isOpen ? 'none' : 'flex';
    activePicker = isOpen ? null : picker;
}

document.addEventListener('click', function(e) {
    if (activePicker && !e.target.closest('.comm-react-wrap')) {
        activePicker.style.display = 'none';
        activePicker = null;
    }
});

async function reaccionar(progressId, emoji) {
    if (isGuest) { window.location.href = "/Account/UpgradeAccount"; return; }

    const picker = document.getElementById('comm-picker-' + progressId);
    if (picker) picker.style.display = 'none';
    activePicker = null;

    try {
        const res = await fetch("/Habit/ReactProgress", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ progressId, emoji })
        });
        const data = await res.json();
        if (!data.success) return;

        const btn = document.getElementById('comm-like-btn-' + progressId);
        const total = data.counts.reduce((s, c) => s + c.count, 0);
        const myReact = data.myReaction;

        // Actualizar botón
        if (myReact) {
            btn.innerHTML = myReact + ' Reaccioné';
            btn.classList.add('reacted');
        } else {
            btn.innerHTML = '👍 Me gusta';
            btn.classList.remove('reacted');
        }

        // Actualizar total
        const totalEl = document.getElementById('comm-react-total-' + progressId);
        const row = document.getElementById('comm-react-row-' + progressId);
        if (totalEl) totalEl.textContent = total;
        if (row) row.style.display = total > 0 ? 'flex' : 'none';

        // Actualizar top emojis
        const topEl = document.getElementById('comm-top-emojis-' + progressId);
        if (topEl) {
            const top3 = data.counts.sort((a,b) => b.count - a.count).slice(0,3);
            topEl.innerHTML = top3.map(c => '<div class="comm-react-emoji-pill">' + c.emoji + '</div>').join('');
        }

    } catch(e) { console.error(e); }
}

async function comentar(progressId, input) {
    if (isGuest) { window.location.href = "/Account/UpgradeAccount"; return; }
    const content = input.value.trim();
    if (!content) return;
    input.value = "";
    input.disabled = true;

    try {
        const res = await fetch("/Habit/CommentProgress", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ progressId, content })
        });
        const data = await res.json();
        if (!data.success) { input.disabled = false; return; }

        const avatarHTML = data.avatar && data.avatar.trim()
            ? '<img src="' + data.avatar + '" style="width:100%;height:100%;object-fit:cover;" />'
            : data.username.charAt(0).toUpperCase();

        const el = document.createElement("div");
        el.className = "comm-comment-item";
        el.innerHTML =
            '<div class="comm-comment-avatar">' + avatarHTML + '</div>' +
            '<div class="comm-comment-bubble"><strong>' + escapeHtml(data.username) + '</strong>' + escapeHtml(data.content) + '</div>';

        document.getElementById("comm-comments-" + progressId).appendChild(el);
        el.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } catch(e) { console.error(e); }

    input.disabled = false;
    input.focus();
}

function focusComment(progressId) {
    const input = document.getElementById('commInput-' + progressId);
    if (input) { input.focus(); input.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
}
</script>